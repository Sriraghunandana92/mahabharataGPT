{
  "adhyaya_id": "P12_U02_A158",
  "book": 12,
  "parva_name": "शान्तिपर्व",
  "upaparva_name": "आपद्धर्मपर्व",
  "adhyaya_name": "अष्टपञ्चाशदधिकशततमोऽध्यायः",
  "chapter": 158,
  "verse_count": 35,
  "verses": [
    {
      "verse": 1,
      "sanskrit": "युधिष्ठिर उवाच।\n              पापस्य यदधिष्ठानं यतः पापं प्रवर्तते । एतदिच्छाम्यहं श्रोतुं तत्त्वेन भरतर्षभ ॥१॥",
      "english": "Narada said When the changes of happiness and sorrow appear or disappear, they cannot be prevented by either wisdom or policy or exertion.",
      "bhavadeepa": null,
      "chapter": 158,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "आपद्धर्मपर्व",
      "adhyaya_name": "अष्टपञ्चाशदधिकशततमोऽध्यायः",
      "combined_translation": "1-1"
    },
    {
      "verse": 2,
      "sanskrit": "भीष्म उवाच।\n              पापस्य यदधिष्ठानं तच्छृणुष्व नराधिप । एको लोभो महाग्राहो लोभात्पापं प्रवर्तते ॥२॥",
      "english": "Without suffering himself to deviate from his true nature, one should try his best for protecting his own Self. He who makes such care and exertion, has never to to perish. Considering Self as something dear, one should always try to rescue himself from decrepitude death, and disease.",
      "bhavadeepa": null,
      "chapter": 158,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "आपद्धर्मपर्व",
      "adhyaya_name": "अष्टपञ्चाशदधिकशततमोऽध्यायः",
      "combined_translation": "2-2"
    },
    {
      "verse": 3,
      "sanskrit": "अतः पापमधर्मश्च तथा दुःखमनुत्तमम् । निकृत्या मूलमेतद्धि येन पापकृतो जनाः ॥३॥",
      "english": "Metal and physical ailments afflict the body, like keen-pointed arrows discharged from the bow by a strong bowman.",
      "bhavadeepa": null,
      "chapter": 158,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "आपद्धर्मपर्व",
      "adhyaya_name": "अष्टपञ्चाशदधिकशततमोऽध्यायः",
      "combined_translation": "3-3"
    },
    {
      "verse": 4,
      "sanskrit": "लोभात्क्रोधः प्रभवति लोभात्कामः प्रवर्तते । लोभान्मोहश्च माया च मानस्तम्भः परासुता ॥४॥",
      "english": "The body of a person who is tortured by thirst, who is moved by agony, who is perfectly helpless, and that is desirous of prolonging his life, is dragged towards destruction.",
      "bhavadeepa": null,
      "chapter": 158,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "आपद्धर्मपर्व",
      "adhyaya_name": "अष्टपञ्चाशदधिकशततमोऽध्यायः",
      "combined_translation": "4-5"
    },
    {
      "verse": 5,
      "sanskrit": "अक्षमा ह्रीपरित्यागः श्रीनाशो धर्मसंक्षयः । अभिध्याऽप्रख्यता चैव सर्वं लोभात्प्रवर्तते ॥५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 158,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "आपद्धर्मपर्व",
      "adhyaya_name": "अष्टपञ्चाशदधिकशततमोऽध्यायः",
      "english_ref": 4,
      "combined_translation": "4-5"
    },
    {
      "verse": 6,
      "sanskrit": "अत्यागश्चातितर्षश्च विकर्मसु च याः क्रियाः । कुलविद्यामदश्चैव रूपैश्वर्यमदस्तथा ॥६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 158,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "आपद्धर्मपर्व",
      "adhyaya_name": "अष्टपञ्चाशदधिकशततमोऽध्यायः",
      "english_ref": 5,
      "combined_translation": "5-10"
    },
    {
      "verse": 7,
      "sanskrit": "सर्वभूतेष्वभिद्रोहः सर्वभूतेष्वसत्कृतिः । सर्वभूतेष्वविश्वासः सर्वभूतेष्वनार्जवम् ॥७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 158,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "आपद्धर्मपर्व",
      "adhyaya_name": "अष्टपञ्चाशदधिकशततमोऽध्यायः",
      "english_ref": 5,
      "combined_translation": "5-10"
    },
    {
      "verse": 8,
      "sanskrit": "हरणं परवित्तानां परदाराभिमर्शनम् । वाग्वेगो मनसो वेगो निन्दावेगस्तथैव च ॥८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 158,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "आपद्धर्मपर्व",
      "adhyaya_name": "अष्टपञ्चाशदधिकशततमोऽध्यायः",
      "english_ref": 5,
      "combined_translation": "5-10"
    },
    {
      "verse": 9,
      "sanskrit": "उपस्थोदरयोर्वेगो मृत्युवेगश्च दारुणः । ईर्ष्यावेगश्च बलवान् मिथ्यावेगश्च दुर्जयः ॥९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 158,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "आपद्धर्मपर्व",
      "adhyaya_name": "अष्टपञ्चाशदधिकशततमोऽध्यायः",
      "english_ref": 5,
      "combined_translation": "5-10"
    },
    {
      "verse": 10,
      "sanskrit": "रसवेगश्च दुर्वार्यः श्रोत्रवेगश्च दुःसहः । कुत्सा विकत्था मात्सर्यं पापं दुष्करकारिता ॥१०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 158,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "आपद्धर्मपर्व",
      "adhyaya_name": "अष्टपञ्चाशदधिकशततमोऽध्यायः",
      "english_ref": 5,
      "combined_translation": "5-10"
    },
    {
      "verse": 11,
      "sanskrit": "साहसानां च सर्वेषामकार्याणां क्रियास्तथा । जातौ बाल्ये च कौमारे यौवने चापि मानवाः ॥११॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 158,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "आपद्धर्मपर्व",
      "adhyaya_name": "अष्टपञ्चाशदधिकशततमोऽध्यायः",
      "english_ref": 6,
      "combined_translation": "6-11"
    },
    {
      "verse": 12,
      "sanskrit": "न संत्यजन्त्यात्मकर्म यो न जीर्यति जीर्यतः । यो न पूरयितुं शक्यो लोभः प्राप्त्या कुरूद्वह ॥१२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 158,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "आपद्धर्मपर्व",
      "adhyaya_name": "अष्टपञ्चाशदधिकशततमोऽध्यायः",
      "english_ref": 7,
      "combined_translation": "7-12"
    },
    {
      "verse": 13,
      "sanskrit": "नित्यं गम्भीरतोयाभिरापगाभिरिवोदधिः । न प्रहृष्यति यो लोभैः कामैर्यश्च न तृप्यति ॥१३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 158,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "आपद्धर्मपर्व",
      "adhyaya_name": "अष्टपञ्चाशदधिकशततमोऽध्यायः",
      "english_ref": 8,
      "combined_translation": "8-14"
    },
    {
      "verse": 14,
      "sanskrit": "यों न देवैर्न गन्धर्वैर्नासुरैर्न महोरगैः । ज्ञायते नृप तत्त्वेन सर्वैर्भूतगणैस्तथा ॥१४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 158,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "आपद्धर्मपर्व",
      "adhyaya_name": "अष्टपञ्चाशदधिकशततमोऽध्यायः",
      "english_ref": 8,
      "combined_translation": "8-14"
    },
    {
      "verse": 15,
      "sanskrit": "स लोभः सह मोहेन विजेतव्यो जितात्मना । दम्भो द्रोहश्च निन्दा च पैशुन्यं मत्सरस्तथा ॥१५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 158,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "आपद्धर्मपर्व",
      "adhyaya_name": "अष्टपञ्चाशदधिकशततमोऽध्यायः",
      "english_ref": 9,
      "combined_translation": "9-15"
    },
    {
      "verse": 16,
      "sanskrit": "भवन्त्येतानि कौरव्य लुब्धानामकृतात्मनाम् । सुमहान्त्यपि शास्त्राणि धारयन्ति बहुश्रुताः ॥१६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 158,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "आपद्धर्मपर्व",
      "adhyaya_name": "अष्टपञ्चाशदधिकशततमोऽध्यायः",
      "english_ref": 10,
      "combined_translation": "10-16"
    },
    {
      "verse": 17,
      "sanskrit": "छेत्तारः संशयानां च क्लिश्यन्तीहाल्पबुद्धयः । द्वेषक्रोधप्रसक्ताश्च शिष्टाचारबहिष्कृताः ॥१७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 158,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "आपद्धर्मपर्व",
      "adhyaya_name": "अष्टपञ्चाशदधिकशततमोऽध्यायः"
    },
    {
      "verse": 18,
      "sanskrit": "अन्तःक्रूरा वाङ्मधुराः कूपाश्छन्नास्तृणैरिव । धर्मवैतंसिकाः क्षुद्रा मुष्णन्ति ध्वजिनो जगत् ॥१८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 158,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "आपद्धर्मपर्व",
      "adhyaya_name": "अष्टपञ्चाशदधिकशततमोऽध्यायः",
      "english_ref": 11,
      "combined_translation": "11-18"
    },
    {
      "verse": 19,
      "sanskrit": "कुर्वते च बहून्मार्गांस्तान् हेतुबलमाश्रिताः । सतां मार्गान् विलुम्पन्ति लोभाज्ञानेष्ववस्थिताः ॥१९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 158,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "आपद्धर्मपर्व",
      "adhyaya_name": "अष्टपञ्चाशदधिकशततमोऽध्यायः",
      "english_ref": 12,
      "combined_translation": "12-19"
    },
    {
      "verse": 20,
      "sanskrit": "धर्मस्य ह्रियमाणस्य लोभग्रस्तैर्दुरात्मभिः । या या विक्रियते संस्था ततः साऽपि प्रपद्यते ॥२०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 158,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "आपद्धर्मपर्व",
      "adhyaya_name": "अष्टपञ्चाशदधिकशततमोऽध्यायः",
      "english_ref": 13,
      "combined_translation": "13-20"
    },
    {
      "verse": 21,
      "sanskrit": "दर्पः क्रोधो मदः स्वप्नो हर्षः शोकोऽतिमानिता । एव एव हि कौरव्य दृश्यन्ते लुब्धबुद्धिषु ॥२१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 158,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "आपद्धर्मपर्व",
      "adhyaya_name": "अष्टपञ्चाशदधिकशततमोऽध्यायः",
      "english_ref": 14,
      "combined_translation": "14-21"
    },
    {
      "verse": 22,
      "sanskrit": "एतानशिष्टान्बुध्यस्व नित्यं लोभसमन्वितान् । शिष्टांस्तु परिपृच्छेथा यान्वक्ष्यामि शुचिव्रतान् ॥२२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 158,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "आपद्धर्मपर्व",
      "adhyaya_name": "अष्टपञ्चाशदधिकशततमोऽध्यायः",
      "english_ref": 15,
      "combined_translation": "15-22"
    },
    {
      "verse": 23,
      "sanskrit": "येष्वावृत्तिभयं नास्ति परलोकभयं न च । नामिषेषु प्रसंगोऽस्ति न प्रियेष्वप्रियेषु च ॥२३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 158,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "आपद्धर्मपर्व",
      "adhyaya_name": "अष्टपञ्चाशदधिकशततमोऽध्यायः",
      "english_ref": 16,
      "combined_translation": "16-26"
    },
    {
      "verse": 24,
      "sanskrit": "शिष्टाचारः प्रियो येषु दमो येषु प्रतिष्ठितः । सुखं दुःखं समं येषां सत्यं येषां परायणम् ॥२४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 158,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "आपद्धर्मपर्व",
      "adhyaya_name": "अष्टपञ्चाशदधिकशततमोऽध्यायः",
      "english_ref": 16,
      "combined_translation": "16-26"
    },
    {
      "verse": 25,
      "sanskrit": "दातारो न ग्रहीतारो दयावन्तस्तथैव च । पितृदेवातिथेयाश्च नित्योद्युक्तास्तथैव च ॥२५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 158,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "आपद्धर्मपर्व",
      "adhyaya_name": "अष्टपञ्चाशदधिकशततमोऽध्यायः",
      "english_ref": 16,
      "combined_translation": "16-26"
    },
    {
      "verse": 26,
      "sanskrit": "सर्वोपकारिणो वीराः सर्वधर्मानुपालकाः । सर्वभूतहिताश्चैव सर्वदेयाश्च भारत ॥२६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 158,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "आपद्धर्मपर्व",
      "adhyaya_name": "अष्टपञ्चाशदधिकशततमोऽध्यायः",
      "english_ref": 16,
      "combined_translation": "16-26"
    },
    {
      "verse": 27,
      "sanskrit": "न ते चालयितुं शक्या धर्मव्यापारकारिणः । न तेषां भिद्यते वृत्तं यत्पुरा साधुभिः कृतम् ॥२७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 158,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "आपद्धर्मपर्व",
      "adhyaya_name": "अष्टपञ्चाशदधिकशततमोऽध्यायः",
      "english_ref": 17,
      "combined_translation": "17-27"
    },
    {
      "verse": 28,
      "sanskrit": "न त्रासिनो न चपला न रौद्राः सत्पथे स्थिताः । ते सेव्याः साधुभिर्नित्यं येष्वहिंसा प्रतिष्ठिता ॥२८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 158,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "आपद्धर्मपर्व",
      "adhyaya_name": "अष्टपञ्चाशदधिकशततमोऽध्यायः",
      "english_ref": 18,
      "combined_translation": "18-28"
    },
    {
      "verse": 29,
