      "combined_translation": "1-2"
    },
    {
      "verse": 2,
      "sanskrit": "किमीदृशं नृशंसेन मया कृतमबुद्धिना । भविष्यति हि मे नित्यं पातकं कृतजीविनः । स विनिन्दंस्तथाऽऽत्मानं पुनः पुनरुवाच ह ॥२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 147,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "आपद्धर्मपर्व",
      "adhyaya_name": "सप्तचत्वारिंशदधिकशततमोऽध्यायः",
      "english_ref": 1,
      "combined_translation": "1-2"
    },
    {
      "verse": 3,
      "sanskrit": "अविश्वास्यः सुदुर्बुद्धिः सदा निकृतिनिश्चयः । शुभं कर्म परित्यज्य सोऽहं शकुनिलुब्धकः ॥३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 147,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "आपद्धर्मपर्व",
      "adhyaya_name": "सप्तचत्वारिंशदधिकशततमोऽध्यायः",
      "english_ref": 2,
      "combined_translation": "2-3"
    },
    {
      "verse": 4,
      "sanskrit": "नृशंसस्य ममाद्यायं प्रत्यादेशो न संशयः । दत्तः स्वमांसं दहता कपोतेन महात्मना ॥४॥",
      "english": null,
      "bhavadeepa": null,
