{
  "adhyaya_id": "P12_U03_A240",
  "book": 12,
  "parva_name": "शान्तिपर्व",
  "upaparva_name": "मोक्षधर्मपर्व",
  "adhyaya_name": "चत्वारिंशदधिकद्विशततमोऽध्यायः",
  "chapter": 240,
  "verse_count": 36,
  "verses": [
    {
      "verse": 1,
      "sanskrit": "व्यास उवाच । पृच्छतस्तव सत्पुत्र यथावदिह सत्त्वतः । सांख्यज्ञानेन संयुक्तं यदेतत्कीर्तितं मया ॥१॥",
      "english": "Vyasa said O excellent son, accosted by you. I have told you truly what the answer to your question should be according to the doctrine of Knowledge as explained in the Sankhya system.",
      "bhavadeepa": null,
      "chapter": 240,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "मोक्षधर्मपर्व",
      "adhyaya_name": "चत्वारिंशदधिकद्विशततमोऽध्यायः",
      "combined_translation": "1-1"
    },
    {
      "verse": 2,
      "sanskrit": "योगकृत्यं तु ते कृत्स्नं वर्तयिष्यामि तच्छृणु । एकत्वं बुद्धिमनसोरिन्द्रियाणां च सर्वशः ॥२॥",
      "english": "Listen now to me as I explain to you all that should be done according to the Yoga doctrine. The unison of intellect and Mind, and all the Senses, and the all-prevading Soul is said to be the highest kind of knowledge. That Knowledge should be gained by one who is of a tranquil mind, who has governed his senses, who is capable of seeing the Soul, who takes pleasure in (such) meditation, who is gifted with intelligence and purity in acts. One should try to gain this knowledge by abandoning those five obstacles of Yoga which are known to the wise, namely, desire, anger, cupidity, fear, and sleep. Anger is conquered by tranquility of disposition. Desire is defeated by giving up all purposes.",
      "bhavadeepa": null,
      "chapter": 240,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "मोक्षधर्मपर्व",
      "adhyaya_name": "चत्वारिंशदधिकद्विशततमोऽध्यायः",
      "combined_translation": "2-14"
    },
    {
      "verse": 3,
      "sanskrit": "आत्मनो व्यापिनस्तात ज्ञानमेतदनुत्तमम् । तदेतदुपशान्तेन दान्तेनाध्यात्मशीलिना ॥३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 240,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "मोक्षधर्मपर्व",
      "adhyaya_name": "चत्वारिंशदधिकद्विशततमोऽध्यायः",
      "english_ref": 2,
      "combined_translation": "2-14"
    },
    {
      "verse": 4,
      "sanskrit": "आत्मारामेण बुद्धेन बोद्धव्यं शुचिकर्मणा । योगदोषान्समुच्छिद्य पञ्च यान्कवयो विदुः ॥४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 240,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "मोक्षधर्मपर्व",
      "adhyaya_name": "चत्वारिंशदधिकद्विशततमोऽध्यायः",
      "english_ref": 2,
      "combined_translation": "2-14"
    },
    {
      "verse": 5,
      "sanskrit": "कामं क्रोधं च लोभं च भयं स्वप्नं च पञ्चमम् । क्रोधं शमेन जयति कामं संकल्पवर्जनात् ॥५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 240,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "मोक्षधर्मपर्व",
      "adhyaya_name": "चत्वारिंशदधिकद्विशततमोऽध्यायः",
      "english_ref": 2,
      "combined_translation": "2-14"
    },
    {
      "verse": 6,
      "sanskrit": "सत्त्वसंसेवनाद्धीरो निद्रामुच्छेत्तुमर्हति । धृत्या शिश्नोदरं रक्षेत्पाणिपादं च चक्षुषा ॥६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 240,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "मोक्षधर्मपर्व",
      "adhyaya_name": "चत्वारिंशदधिकद्विशततमोऽध्यायः",
      "english_ref": 3,
      "combined_translation": "3-6"
    },
    {
      "verse": 7,
      "sanskrit": "चक्षुःश्रोत्रे च मनसा मनोवाचं च कर्मणा । अप्रमादाद्भयं जह्याद्दम्भं प्राज्ञोपसेवनात् ॥७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 240,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "मोक्षधर्मपर्व",
      "adhyaya_name": "चत्वारिंशदधिकद्विशततमोऽध्यायः",
      "english_ref": 4,
      "combined_translation": "4-7"
    },
    {
      "verse": 8,
      "sanskrit": "एवमेतान् योगदोषान् जयेन्नित्यमतन्द्रितः । अग्नींश्च ब्राह्मणांश्चार्चेद्देवताः प्रणमेत च ॥८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 240,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "मोक्षधर्मपर्व",
      "adhyaya_name": "चत्वारिंशदधिकद्विशततमोऽध्यायः",
      "english_ref": 5,
      "combined_translation": "5-8"
    },
    {
      "verse": 9,
      "sanskrit": "वर्जयेदुशतीं वाचं हिंसायुक्तां मनोनुदाम् । ब्रह्म तेजोमयं शुक्रं यस्य सर्वमिदं रसः ॥९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 240,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "मोक्षधर्मपर्व",
      "adhyaya_name": "चत्वारिंशदधिकद्विशततमोऽध्यायः",
      "english_ref": 6,
      "combined_translation": "6-9"
    },
    {
      "verse": 10,
      "sanskrit": "एतस्य भूतं भव्यस्य दृष्टं स्थावरजङ्गमम् । ध्यानमध्ययनं दानं सत्यं ह्रीरार्जवं क्षमा ॥१०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 240,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "मोक्षधर्मपर्व",
      "adhyaya_name": "चत्वारिंशदधिकद्विशततमोऽध्यायः",
      "english_ref": 8,
      "combined_translation": "8-11"
    },
    {
      "verse": 11,
      "sanskrit": "शौचमाचारसंशुद्धिरिन्द्रियाणां च निग्रहः । एतैर्विवर्धते तेजः पाप्मानं चापकर्षति ॥११॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 240,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "मोक्षधर्मपर्व",
      "adhyaya_name": "चत्वारिंशदधिकद्विशततमोऽध्यायः",
      "english_ref": 8,
      "combined_translation": "8-11"
    },
    {
      "verse": 12,
      "sanskrit": "सिद्ध्यन्ति चास्य सर्वार्था विज्ञानं च प्रवर्तते । समः सर्वेषु भूतेषु लब्धालब्धेन वर्तयन् ॥१२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 240,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "मोक्षधर्मपर्व",
      "adhyaya_name": "चत्वारिंशदधिकद्विशततमोऽध्यायः",
      "english_ref": 9,
      "combined_translation": "9-12"
    },
    {
      "verse": 13,
      "sanskrit": "धूतपाप्मा तु तेजस्वी लघ्वाहारो जितेन्द्रियः । कामक्रोधौ वशे कृत्वा निनीषेद्ब्रह्मणः पदम् ॥१३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 240,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "मोक्षधर्मपर्व",
      "adhyaya_name": "चत्वारिंशदधिकद्विशततमोऽध्यायः",
      "english_ref": 8,
      "combined_translation": "8-13"
    },
    {
      "verse": 14,
      "sanskrit": "मनसश्चेन्द्रियाणां च कृत्वैकाम्यं समाहितः । पूर्वरात्रापरार्धं च धारयेन्मन आत्मनि ॥१४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 240,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "मोक्षधर्मपर्व",
      "adhyaya_name": "चत्वारिंशदधिकद्विशततमोऽध्यायः",
      "english_ref": 11,
      "combined_translation": "11-14"
    },
    {
      "verse": 15,
      "sanskrit": "जन्तोः पञ्चेन्द्रियस्यास्य यदेकं छिद्रमिन्द्रियम् । ततोऽस्य स्रवते प्रज्ञा दृतेः पादादिवोदकम् ॥१५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 240,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "मोक्षधर्मपर्व",
      "adhyaya_name": "चत्वारिंशदधिकद्विशततमोऽध्यायः",
      "english_ref": 12,
      "combined_translation": "12-15"
    },
    {
      "verse": 16,
      "sanskrit": "मनस्तु पूर्वमादद्यात् कुमीनमिव मत्स्यहा । ततः श्रोत्रं ततश्चक्षुर्जिह्वां घ्राणं च योगवित् ॥१६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 240,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "मोक्षधर्मपर्व",
      "adhyaya_name": "चत्वारिंशदधिकद्विशततमोऽध्यायः",
      "english_ref": 13,
      "combined_translation": "13-16"
    },
    {
      "verse": 17,
      "sanskrit": "तत एतानि संयम्य मनसि स्थापयेद्यतिः । तथैवापोह्य संकल्पान्मनो ह्यात्मनि धारयेत् ॥१७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 240,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "मोक्षधर्मपर्व",
      "adhyaya_name": "चत्वारिंशदधिकद्विशततमोऽध्यायः",
      "english_ref": 14,
      "combined_translation": "14-17"
    },
    {
      "verse": 18,
      "sanskrit": "पञ्चेन्द्रियाणि सन्धाय मनसि स्थापयेद्यतिः । यदैतान्यवतिष्ठन्ति मनःषष्ठान्यथात्मनि ॥१८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 240,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "मोक्षधर्मपर्व",
      "adhyaya_name": "चत्वारिंशदधिकद्विशततमोऽध्यायः",
      "english_ref": 15,
      "combined_translation": "15-19"
    },
    {
      "verse": 19,
      "sanskrit": "प्रसीदन्ति च संस्थाय तदा ब्रह्म प्रकाशते । विधूम इव दीप्तार्चिरादित्य इव दीप्तिमान् ॥१९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 240,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "मोक्षधर्मपर्व",
      "adhyaya_name": "चत्वारिंशदधिकद्विशततमोऽध्यायः",
      "english_ref": 15,
      "combined_translation": "15-19"
    },
    {
      "verse": 20,
      "sanskrit": "वैद्युतोऽग्निरिवाकाशे दृश्यतेऽऽत्मा तथाऽऽत्मनि । सर्वस्तत्र स सर्वत्र व्यापकत्वाच्च दृश्यते ॥२०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 240,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "मोक्षधर्मपर्व",
      "adhyaya_name": "चत्वारिंशदधिकद्विशततमोऽध्यायः",
      "english_ref": 16,
      "combined_translation": "16-20"
    },
    {
      "verse": 21,
      "sanskrit": "तं पश्यन्ति महात्मानो ब्राह्मणा ये मनीषिणः । धृतिमन्तो महाप्राज्ञाः सर्वभूतहिते रताः ॥२१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 240,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "मोक्षधर्मपर्व",
      "adhyaya_name": "चत्वारिंशदधिकद्विशततमोऽध्यायः",
      "english_ref": 17,
      "combined_translation": "17-21"
    },
    {
      "verse": 22,
      "sanskrit": "एवं परिमितं कालमाचरन्संशितव्रतः । आसीनो हि रहस्येको गच्छेदक्षरसात्मताम् ॥२२॥",
      "english": "Practising austere vows, the Yogin, who acts thus for six months seated by himself on a lonely spot, becomes at one with the Indestructible.",
      "bhavadeepa": null,
      "chapter": 240,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "मोक्षधर्मपर्व",
      "adhyaya_name": "चत्वारिंशदधिकद्विशततमोऽध्यायः"
    },
    {
      "verse": 23,
      "sanskrit": "प्रमोहो भ्रम आवर्तो प्राणं श्रवणदर्शने । अद्भुतानि रसस्पर्शे शीतोष्णे मारुताकृतिः ॥२३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 240,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "मोक्षधर्मपर्व",
      "adhyaya_name": "चत्वारिंशदधिकद्विशततमोऽध्यायः",
      "english_ref": 20,
      "combined_translation": "20-24"
    },
    {
      "verse": 24,
      "sanskrit": "प्रतिभामुपसर्गांश्चाप्युपसंगृह्य योगतः । तांस्तत्त्वविदनादृत्य आत्मन्येव निवर्तयेत् ॥२४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 240,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "मोक्षधर्मपर्व",
      "adhyaya_name": "चत्वारिंशदधिकद्विशततमोऽध्यायः",
      "english_ref": 20,
      "combined_translation": "20-24"
    },
    {
      "verse": 25,
      "sanskrit": "कुर्यात्परिचयं योगे त्रैकाल्ये नियतो मुनिः । गिरिशृङ्गे तथा चैत्ये वृक्षाग्रेषु च योजयेत् ॥२५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 240,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "मोक्षधर्मपर्व",
      "adhyaya_name": "चत्वारिंशदधिकद्विशततमोऽध्यायः",
      "english_ref": 21,
      "combined_translation": "21-25"
    },
    {
      "verse": 26,
      "sanskrit": "संनियम्येन्द्रियग्रामं कोष्ठे भाण्डमना इव । एकाग्रं चिन्तयेन्नित्यं योगान्नोद्वेजयेन्मनः ॥२६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 240,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "मोक्षधर्मपर्व",
      "adhyaya_name": "चत्वारिंशदधिकद्विशततमोऽध्यायः",
      "english_ref": 22,
      "combined_translation": "22-26"
    },
    {
      "verse": 27,
      "sanskrit": "येनोपायेन शक्येत संनियन्तुं चलं मनः । तं च युक्तो निषेवेत न चैव विचलेत्ततः ॥२७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 240,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "मोक्षधर्मपर्व",
      "adhyaya_name": "चत्वारिंशदधिकद्विशततमोऽध्यायः",
      "english_ref": 23,
      "combined_translation": "23-27"
    },
    {
      "verse": 28,
      "sanskrit": "शून्या गिरिगुहाश्चैव देवतायतनानि च । शून्यागाराणि चैकाग्रो निवासार्थमुपक्रमेत् ॥२८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 240,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "मोक्षधर्मपर्व",
