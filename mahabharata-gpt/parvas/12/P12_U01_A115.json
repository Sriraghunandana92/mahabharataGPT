{
  "adhyaya_id": "P12_U01_A115",
  "book": 12,
  "parva_name": "शान्तिपर्व",
  "upaparva_name": "राजधर्मानुशासनपर्व",
  "adhyaya_name": "पञ्चदशाधिकशततमोऽध्यायः",
  "chapter": 115,
  "verse_count": 23,
  "verses": [
    {
      "verse": 1,
      "sanskrit": "युधिष्ठिर उवाच।\n              पितामह महाप्राज्ञ संशयो मे महानयम्। संछेत्तव्यस्त्वया राजन्भवान्कुलकरो हि नः॥१॥",
      "english": "Yudhishthira said How, O grandfather, should a king like us act in this world, keeping in view the great object of acquisition? What attributes, again, should he always possess so that he may be liberated from attachments.",
      "bhavadeepa": null,
      "chapter": 115,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "पञ्चदशाधिकशततमोऽध्यायः",
      "combined_translation": "1-1"
    },
    {
      "verse": 2,
      "sanskrit": "पुरुषाणामयं तात दुर्वृत्तानां दुरात्मनाम्। कथितो वाक्यसंचारस्ततो विज्ञापयामि ते॥२॥",
      "english": "Bhishma said-I shall in this connection recite to you the old narrative that was uttered by Arishtanemi to Sagara who had sought his advice.",
      "bhavadeepa": null,
      "chapter": 115,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "पञ्चदशाधिकशततमोऽध्यायः",
      "combined_translation": "2-2"
    },
    {
      "verse": 3,
      "sanskrit": "यद्धितं राज्यतन्त्रस्य कुलस्य च सुखोदयम्। आयत्यां च तदात्वे च क्षेमवृद्धिकरं च यत्॥३॥",
      "english": "Sagara said What is that good, O Brahmana, by doing which one may enjoy happiness here? How, indeed, may one avoid grief and agitation? I wish to know all this.",
      "bhavadeepa": null,
      "chapter": 115,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "पञ्चदशाधिकशततमोऽध्यायः",
      "combined_translation": "3-4"
    },
    {
      "verse": 4,
      "sanskrit": "पुत्रपौत्राभिरामं च राष्ट्रवृद्धिकरं च यत्। अन्नपाने शरीरे च हितं यत्तद्ब्रवीहि मे॥४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 115,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "पञ्चदशाधिकशततमोऽध्यायः",
      "english_ref": 3,
      "combined_translation": "3-4"
    },
    {
      "verse": 5,
      "sanskrit": "अभिषिक्तो हि यो राजा राष्ट्रस्थो मित्रसंवृतः। ससुहृत्समुपेतो वा स कथं रञ्जयेत्प्रजाः॥५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 115,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "पञ्चदशाधिकशततमोऽध्यायः",
      "english_ref": 4,
      "combined_translation": "4-5"
    },
    {
      "verse": 6,
      "sanskrit": "यो ह्यसत्प्रग्रहरतिः स्नेहरागबलात्कृतः। इन्द्रियाणामनीशत्वादसज्जनबुभूषकः॥६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 115,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "पञ्चदशाधिकशततमोऽध्यायः",
      "english_ref": 5,
      "combined_translation": "5-7"
    },
    {
      "verse": 7,
      "sanskrit": "तस्य भृत्या विगुणतां यान्ति सर्वे कुलोद्गताः। न च भृत्यफलैरर्थैः स राजा सम्प्रयुज्यते॥७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 115,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "पञ्चदशाधिकशततमोऽध्यायः",
      "english_ref": 5,
      "combined_translation": "5-7"
    },
    {
      "verse": 8,
      "sanskrit": "एतन्मे संशयस्यास्य राजधर्मान्सुदुर्विदान्। बृहस्पतिसमो बुद्ध्या भवान्शंसितुमर्हति॥८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 115,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "पञ्चदशाधिकशततमोऽध्यायः",
      "english_ref": 6,
      "combined_translation": "6-8"
    },
    {
      "verse": 9,
      "sanskrit": "शंसिता पुरुषव्याघ्र त्वन्नः कुलहिते रतः। क्षत्ता चैको महाप्राज्ञो यो नः शंसति सर्वदा॥९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 115,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "पञ्चदशाधिकशततमोऽध्यायः",
      "english_ref": 7,
      "combined_translation": "7-9"
    },
    {
      "verse": 10,
      "sanskrit": "त्वत्तः कुलहितं वाक्यं श्रुत्वा राज्यहितोदयम्। अमृतस्याव्ययस्येव तृप्तः स्वप्स्याम्यहं सुखम्॥१०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 115,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "पञ्चदशाधिकशततमोऽध्यायः",
      "english_ref": 8,
      "combined_translation": "8-10"
    },
    {
      "verse": 11,
      "sanskrit": "कीदृशाः संनिकर्षस्था भृत्याः सर्वगुणान्विताः। कीदृशैः किं कुलीनैर्वा सह यात्रा विधीयते॥११॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 115,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "पञ्चदशाधिकशततमोऽध्यायः",
      "english_ref": 9,
      "combined_translation": "9-11"
    },
    {
      "verse": 12,
      "sanskrit": "न ह्येको भृत्यरहितो राजा भवति रक्षिता। राज्यं चेदं जनः सर्वस्तत्कुलीनोऽभिकाङ्क्षति॥१२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 115,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "पञ्चदशाधिकशततमोऽध्यायः",
      "english_ref": 10,
      "combined_translation": "10-12"
    },
    {
      "verse": 13,
      "sanskrit": "भीष्म उवाच।\n              न च प्रशास्तुं राज्यं हि शक्यमेकेन भारत। असहायवता तात नैवार्थाः केचिदप्युत॥१३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 115,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "पञ्चदशाधिकशततमोऽध्यायः"
    },
    {
      "verse": 14,
      "sanskrit": "लब्धुं लब्धा ह्यपि सदा रक्षितुं भरतर्षभ। यस्य भृत्यजनः सर्वो ज्ञानविज्ञानकोविदः॥१४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 115,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "पञ्चदशाधिकशततमोऽध्यायः",
      "english_ref": 11,
      "combined_translation": "11-14"
    },
    {
      "verse": 15,
      "sanskrit": "हितैषी कुलजः स्निग्धः स राज्यफलमश्नुते॥१५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 115,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "पञ्चदशाधिकशततमोऽध्यायः",
      "english_ref": 12,
      "combined_translation": "12-15"
    },
    {
      "verse": 16,
      "sanskrit": "मन्त्रिणो यस्य कुलजा असंहार्याः सहोषिताः। नृपतेर्मतिदाः सन्तः सम्बन्धज्ञानकोविदाः॥१६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 115,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "पञ्चदशाधिकशततमोऽध्यायः",
      "english_ref": 13,
      "combined_translation": "13-17"
    },
    {
      "verse": 17,
      "sanskrit": "अनागतविधातारः कालज्ञानविशारदाः। अतिक्रान्तमशोचन्तः स राज्यफलमश्नुते॥१७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 115,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "पञ्चदशाधिकशततमोऽध्यायः",
      "english_ref": 13,
      "combined_translation": "13-17"
    },
    {
      "verse": 18,
      "sanskrit": "समदुःखसुखा यस्य सहायाः प्रियकारिणः। अर्थचिन्तापराः सत्याः स राज्यफलमश्नुते॥१८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 115,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "पञ्चदशाधिकशततमोऽध्यायः",
      "english_ref": 14,
      "combined_translation": "14-18"
    },
    {
      "verse": 19,
      "sanskrit": "यस्य नार्तो जनपदः संनिकर्षगतः सदा। अक्षुद्रः सत्पथालम्बी स राजा राज्यभाग्भवेत्॥१९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 115,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "पञ्चदशाधिकशततमोऽध्यायः",
      "english_ref": 15,
      "combined_translation": "15-19"
    },
    {
      "verse": 20,
      "sanskrit": "कोशाख्यपटलं यस्य कोशवृद्धिकरैर्नरैः। आप्तैस्तुष्टैश्च सततं चीयते स नृपोत्तमः॥२०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 115,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "पञ्चदशाधिकशततमोऽध्यायः",
      "english_ref": 16,
      "combined_translation": "16-20"
    },
    {
      "verse": 21,
      "sanskrit": "कोष्ठागारमसंहार्यैराप्तैः संचयतत्परैः। पात्रभूतैरलुब्धैश्च पाल्यमानं गुणी भवेत्॥२१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 115,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "पञ्चदशाधिकशततमोऽध्यायः",
      "english_ref": 17,
      "combined_translation": "17-21"
    },
    {
      "verse": 22,
      "sanskrit": "व्यवहारश्च नगरे यस्य कर्मफलोदयः। दृश्यते शंखलिखितः स्वधर्मफलभाङ्नृपः॥२२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 115,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "पञ्चदशाधिकशततमोऽध्यायः",
      "english_ref": 18,
      "combined_translation": "18-22"
    },
    {
      "verse": 23,
      "sanskrit": "संगृहीतमनुष्यश्च यो राजा राजधर्मवित्। षड्वर्गं प्रतिगृह्णाति स धर्मफलमश्नुते॥२३॥",
