  "verses": [
    {
      "verse": 1,
      "sanskrit": "वैशम्पायन उवाच।\n              ततः स च हृषीकेशः स च राजा युधिष्ठिरः । कृपादयश्च ते सर्वे चत्वारः पाण्डवाश्च ते ॥१॥",
      "english": "Yudhisthira said The three twice-born classes, who perform sacrifices and other rites, some times eat the remnants, consisting of meat and wine, of sacrifices in honour of the gods, from motives of obtaining children and heaven. What, O grandfather, is the nature of this act?",
      "bhavadeepa": "अभ्यनन्दतेति सन्धिरार्षः ॥१०८॥",
      "chapter": 48,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "अष्टचत्वारिंशत्तमोऽध्यायः",
      "combined_translation": "1-2"
    },
    {
      "verse": 2,
      "sanskrit": "रथैस्तैर्नगरप्रख्यैः पताका-ध्वजशोभितैः । ययुराशु कुरुक्षेत्रं वाजिभिः शीघ्रगामिभिः ॥२॥",
      "english": null,
      "bhavadeepa": "ततः स चेति ॥१॥",
      "chapter": 48,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "अष्टचत्वारिंशत्तमोऽध्यायः",
      "english_ref": 1,
      "combined_translation": "1-2"
    },
    {
      "verse": 3,
      "sanskrit": "तेऽवतीर्य कुरुक्षेत्रं केशमज्जास्थिसङ्कुलम् । देहन्यासः कृतो यत्र क्षत्रियैस्तैर्महात्मभिः ॥३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 48,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "अष्टचत्वारिंशत्तमोऽध्यायः",
      "english_ref": 2,
      "combined_translation": "2-3"
    },
    {
      "verse": 4,
      "sanskrit": "गजाश्वदेहास्थिचयैः पर्वतैरिव सञ्चितम् । नरशीर्षकपालैश्च शङ्खैरिव च सर्वशः ॥४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 48,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "अष्टचत्वारिंशत्तमोऽध्यायः",
      "english_ref": 3,
      "combined_translation": "3-4"
    },
    {
      "verse": 5,
      "sanskrit": "चितासहस्रप्रचितं वर्मशस्त्रसमाकुलम् । आपानभूमिं कालस्य तथा भुक्तोज्झितामिव ॥५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 48,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "अष्टचत्वारिंशत्तमोऽध्यायः",
      "english_ref": 4,
      "combined_translation": "4-5"
    },
    {
      "verse": 6,
      "sanskrit": "भूतसङ्घानुचरितं रक्षोगणनिषेवितम् । पश्यन्तस्ते कुरुक्षेत्रं ययुराशु महारथाः ॥६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 48,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "अष्टचत्वारिंशत्तमोऽध्यायः",
      "english_ref": 5,
      "combined_translation": "5-6"
    },
    {
      "verse": 7,
      "sanskrit": "गच्छन्नेव महाबाहुः स वै यादवनन्दनः । युधिष्ठिराय प्रोवाच जामदग्न्यस्य विक्रमम् ॥७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 48,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "अष्टचत्वारिंशत्तमोऽध्यायः",
      "english_ref": 6,
      "combined_translation": "6-7"
    },
    {
      "verse": 8,
      "sanskrit": "अमी रामहृदाः पञ्च दृश्यन्ते पार्थ दूरतः । तेषु सन्तर्पयामास पितॄन् क्षत्रियशोणितैः ॥८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 48,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "अष्टचत्वारिंशत्तमोऽध्यायः",
      "english_ref": 7,
      "combined_translation": "7-8"
    },
    {
      "verse": 9,
      "sanskrit": "त्रिःसप्तकृत्वो वसुधां कृत्वा निःक्षत्रियां प्रभुः । इहेदानीं ततो रामः कर्मणो विरराम ह ॥९॥",
      "english": null,
      "bhavadeepa": "सन्तर्पयामास राम इत्यर्थात् । एतेन शत्रुकुलवधजा ग्लानिस्ते माभूदिति दर्शितम् ॥८॥",
      "chapter": 48,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "अष्टचत्वारिंशत्तमोऽध्यायः",
      "english_ref": 8,
      "combined_translation": "8-9"
    },
    {
      "verse": 10,
      "sanskrit": "युधिष्ठिर उवाच।\n              त्रि:सप्तकृत्वः पृथिवी कृता निःक्षत्रिया पुरा । रामेणेति तथाऽऽत्थ त्वमत्र मे संशयो महान् ॥१०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 48,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "अष्टचत्वारिंशत्तमोऽध्यायः",
      "english_ref": 9,
      "combined_translation": "9-10"
    },
    {
      "verse": 11,
      "sanskrit": "क्षत्रबीजं यथा दग्धं रामेण यदुपुङ्गव । कथं भूयः समुत्पत्तिः क्षत्रस्यामितविक्रम ॥११॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 48,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "अष्टचत्वारिंशत्तमोऽध्यायः",
      "english_ref": 10,
      "combined_translation": "10-11"
    },
    {
      "verse": 12,
      "sanskrit": "महात्मना भगवता रामेण यदुपुङ्गव । कथमुत्सादितं क्षत्रं कथं वृद्धिमुपागतम् ॥१२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 48,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
