      "english_ref": 11,
      "combined_translation": "11-12"
    },
    {
      "verse": 13,
      "sanskrit": "महता रथयुद्धेन कोटिशः क्षत्रिया हताः । तथाऽभूच्च मही कीर्णा क्षत्रियैर्वदतां वर ॥१३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 48,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "अष्टचत्वारिंशत्तमोऽध्यायः",
      "english_ref": 12,
      "combined_translation": "12-13"
    },
    {
      "verse": 14,
      "sanskrit": "किमर्थं भार्गवेणेदं क्षत्रमुत्सादितं पुरा । रामेण यदुशार्दूल कुरुक्षेत्रे महात्मना ॥१४॥",
      "english": null,
      "bhavadeepa": null,
