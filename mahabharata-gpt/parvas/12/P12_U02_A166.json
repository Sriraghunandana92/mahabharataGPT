{
  "adhyaya_id": "P12_U02_A166",
  "book": 12,
  "parva_name": "शान्तिपर्व",
  "upaparva_name": "आपद्धर्मपर्व",
  "adhyaya_name": "षट्षष्ट्यधिकशततमोऽध्यायः",
  "chapter": 166,
  "verse_count": 89,
  "verses": [
    {
      "verse": 1,
      "sanskrit": "वैशम्पायन उवाच।\n              कथान्तरमथासाद्य खड्गयुद्धविशारदः । नकुलः शरतल्पस्थमिदमाह पितामहम् ॥१॥",
      "english": "Bhishma said Thus sung with names that were not known to others, the Divine Narayana having the universe for his form appeared before the ascetic Narada.",
      "bhavadeepa": null,
      "chapter": 166,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "आपद्धर्मपर्व",
      "adhyaya_name": "षट्षष्ट्यधिकशततमोऽध्यायः",
      "combined_translation": "1-1"
    },
    {
      "verse": 2,
      "sanskrit": "नकुल उवाच। धनुः प्रहरणं श्रेष्ठमतीवात्र पितामह । मतस्तु मम धर्मज्ञ खड्ग एव सुसंशितः ॥२॥",
      "english": "His form was some what purer than the moon and differed from the moon in some particulars. He somewhat resembled a burning fire in complexion. The powerful Lord was somewhat of the form of Vishti,",
      "bhavadeepa": null,
      "chapter": 166,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "आपद्धर्मपर्व",
      "adhyaya_name": "षट्षष्ट्यधिकशततमोऽध्यायः",
      "combined_translation": "2-3"
    },
    {
      "verse": 3,
      "sanskrit": "विशीर्णे कार्मुके राजन् प्रक्षीणेषु च वाजिषु । खड्गेन शक्यते युद्धे साध्वात्मा परिरक्षितुम् ॥३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 166,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "आपद्धर्मपर्व",
      "adhyaya_name": "षट्षष्ट्यधिकशततमोऽध्यायः",
      "english_ref": 2,
      "combined_translation": "2-3"
    },
    {
      "verse": 4,
      "sanskrit": "शरासनधरांश्चैव गदाशक्तिधरांस्तथा । एकः खड्गधरो वीरः समर्थः प्रतिबाधितुम् ॥४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 166,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "आपद्धर्मपर्व",
      "adhyaya_name": "षट्षष्ट्यधिकशततमोऽध्यायः",
      "english_ref": 3,
      "combined_translation": "3-4"
    },
    {
      "verse": 5,
      "sanskrit": "अत्र मे संशयश्चैव कौतूहलमतीव च । किं स्वित्प्रहरणं श्रेष्ठं सर्वयुद्धषु पार्थिव ॥५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 166,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "आपद्धर्मपर्व",
      "adhyaya_name": "षट्षष्ट्यधिकशततमोऽध्यायः",
      "english_ref": 4,
      "combined_translation": "4-5"
    },
    {
      "verse": 6,
      "sanskrit": "कथं चोत्पादितः खड्गः कस्मै चार्थाय केन च । पूर्वाचार्यं च खड्गस्य प्रब्रूहि प्रपितामह ॥६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 166,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "आपद्धर्मपर्व",
      "adhyaya_name": "षट्षष्ट्यधिकशततमोऽध्यायः",
      "english_ref": 5,
      "combined_translation": "5-6"
    },
    {
      "verse": 7,
      "sanskrit": "वैशम्पायन उवाच।\n              तस्य तद्वचनं श्रुत्वा माद्रीपुत्रस्य धीमतः । स तु कौशल संयुक्तं सूक्ष्मचित्रार्थसम्मतम् ॥७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 166,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "आपद्धर्मपर्व",
      "adhyaya_name": "षट्षष्ट्यधिकशततमोऽध्यायः",
      "english_ref": 6,
      "combined_translation": "6-9"
    },
    {
      "verse": 8,
      "sanskrit": "ततस्तस्योत्तरं वाक्यं स्वरवर्णोपपादितम् । शिक्षया चोपपन्नाय द्रोणशिष्याय भारत ॥८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 166,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "आपद्धर्मपर्व",
      "adhyaya_name": "षट्षष्ट्यधिकशततमोऽध्यायः",
      "english_ref": 6,
      "combined_translation": "6-9"
    },
    {
      "verse": 9,
      "sanskrit": "उवाच स तु धर्मज्ञो धनुर्वेदस्य पारगः । शरतल्पगतो भीष्मो नकुलाय महात्मने ॥९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 166,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "आपद्धर्मपर्व",
      "adhyaya_name": "षट्षष्ट्यधिकशततमोऽध्यायः",
      "english_ref": 6,
      "combined_translation": "6-9"
    },
    {
      "verse": 10,
      "sanskrit": "भीष्म उवाच।\n              तत्त्वं शृणुष्व माद्रेय यदेतत्परिपृच्छसि । प्रबोधितोऽस्मि भवता धातुमानिव पर्वतः ॥१०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 166,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "आपद्धर्मपर्व",
      "adhyaya_name": "षट्षष्ट्यधिकशततमोऽध्यायः",
      "english_ref": 7,
      "combined_translation": "7-10"
    },
    {
      "verse": 11,
      "sanskrit": "सलिलैकार्णवं तात पुरा सर्वमभूदिदम् । निष्प्रकम्पमनाकाशमनिर्देश्यमहीतलम् ॥११॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 166,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "आपद्धर्मपर्व",
      "adhyaya_name": "षट्षष्ट्यधिकशततमोऽध्यायः",
      "english_ref": 8,
      "combined_translation": "8-11"
    },
    {
      "verse": 12,
      "sanskrit": "तमसाऽऽवृतमस्पर्शमतिगम्भीरदर्शनम् । निःशब्दं चाप्रमेयं च तत्र जज्ञे पितामहः ॥१२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 166,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "आपद्धर्मपर्व",
      "adhyaya_name": "षट्षष्ट्यधिकशततमोऽध्यायः",
      "english_ref": 9,
      "combined_translation": "9-12"
    },
    {
      "verse": 13,
      "sanskrit": "सोऽसृजद्वातमग्निं च भास्करं चापि वीर्यवान् । आकाशमसृजच्चोर्ध्वमधो भूमिं च नैर्ऋतीम् ॥१३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 166,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "आपद्धर्मपर्व",
      "adhyaya_name": "षट्षष्ट्यधिकशततमोऽध्यायः",
      "english_ref": 10,
      "combined_translation": "10-14"
    },
    {
      "verse": 14,
      "sanskrit": "नभः सचन्द्रतारं च नक्षत्राणि ग्रहांस्तथा । संवत्सरानृतून्मासान्पक्षानथ लवान् क्षणान् ॥१४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 166,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "आपद्धर्मपर्व",
      "adhyaya_name": "षट्षष्ट्यधिकशततमोऽध्यायः",
      "english_ref": 10,
      "combined_translation": "10-14"
    },
    {
      "verse": 15,
      "sanskrit": "ततः शरीरं लोकस्थं स्थापयित्वा पितामहः । जनयामास भगवान् पुत्रानुत्तमतेजसः ॥१५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 166,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "आपद्धर्मपर्व",
      "adhyaya_name": "षट्षष्ट्यधिकशततमोऽध्यायः",
      "english_ref": 11,
      "combined_translation": "11-15"
    },
    {
      "verse": 16,
      "sanskrit": "मरीचिमृषिमत्रिं च पुलस्त्यं पुलहं ऋतुम् । वसिष्ठाङ्गिरसौ चोभौ रुद्रं च प्रभुमीश्वरम् ॥१६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 166,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "आपद्धर्मपर्व",
      "adhyaya_name": "षट्षष्ट्यधिकशततमोऽध्यायः",
      "english_ref": 12,
      "combined_translation": "12-17"
    },
    {
      "verse": 17,
      "sanskrit": "प्राचेतसस्तथा दक्षः कन्याषष्टिमजीजनत् । ता वै ब्रह्मर्षयः सर्वाः प्रजार्थं प्रतिपेदिरे ॥१७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 166,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "आपद्धर्मपर्व",
      "adhyaya_name": "षट्षष्ट्यधिकशततमोऽध्यायः",
      "english_ref": 12,
      "combined_translation": "12-17"
    },
    {
      "verse": 18,
      "sanskrit": "ताभ्यो विश्वानि भूतानि देवाः पितृगणास्तथा । गन्धर्वाप्सरसश्चैव रक्षांसि विविधानि च ॥१८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 166,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "आपद्धर्मपर्व",
      "adhyaya_name": "षट्षष्ट्यधिकशततमोऽध्यायः",
      "english_ref": 13,
      "combined_translation": "13-20"
    },
    {
      "verse": 19,
      "sanskrit": "पतत्रिमृगमीनाश्च प्लवङ्गाश्च महोरगाः । तथा पक्षिगणाः सर्वे जलस्थलविचारिणः ॥१९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 166,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "आपद्धर्मपर्व",
      "adhyaya_name": "षट्षष्ट्यधिकशततमोऽध्यायः",
      "english_ref": 13,
      "combined_translation": "13-20"
    },
    {
      "verse": 20,
      "sanskrit": "उद्भिदः स्वेदजाश्चैव साण्डजाश्च जरायुजाः । जज्ञे तात जगत्सर्वं तथा स्थावरजङ्गमम् ॥२०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 166,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "आपद्धर्मपर्व",
      "adhyaya_name": "षट्षष्ट्यधिकशततमोऽध्यायः",
      "english_ref": 13,
      "combined_translation": "13-20"
    },
    {
      "verse": 21,
      "sanskrit": "भूतसर्गमिमं कृत्वा सर्वलोकपितामहः । शाश्वतं वेदपठितं धर्मं प्रयुयुजे ततः ॥२१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 166,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "आपद्धर्मपर्व",
      "adhyaya_name": "षट्षष्ट्यधिकशततमोऽध्यायः",
      "english_ref": 14,
      "combined_translation": "14-21"
    },
    {
      "verse": 22,
      "sanskrit": "तस्मिन् धर्मे स्थिता देवाः सहाचार्यपुरोहिताः । आदित्या वसवो रुद्राः ससाध्या मरुदतश्विनः ॥२२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 166,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "आपद्धर्मपर्व",
      "adhyaya_name": "षट्षष्ट्यधिकशततमोऽध्यायः",
      "english_ref": 15,
      "combined_translation": "15-25"
    },
    {
      "verse": 23,
      "sanskrit": "भृग्वत्र्यङ्गिरसः सिद्धाः काश्यपाश्च तपोधनाः । वसिष्ठगौतमागस्त्यास्तथा नारदपर्वतौ ॥२३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 166,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "आपद्धर्मपर्व",
      "adhyaya_name": "षट्षष्ट्यधिकशततमोऽध्यायः",
      "english_ref": 15,
      "combined_translation": "15-25"
    },
    {
      "verse": 24,
      "sanskrit": "ऋषयो वालखिल्याश्च प्रभासाः सिकतास्तथा । घृतपाः सोमवायव्या वैश्वानरमरीचिपाः ॥२४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 166,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "आपद्धर्मपर्व",
      "adhyaya_name": "षट्षष्ट्यधिकशततमोऽध्यायः",
      "english_ref": 15,
      "combined_translation": "15-25"
    },
    {
      "verse": 25,
      "sanskrit": "अकृष्टाश्चैव हंसाश्च ऋषयो वाऽग्नियोनयः । वानप्रस्थाः पृश्नयश्च स्थिता ब्रह्मानुशासने ॥२५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 166,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "आपद्धर्मपर्व",
      "adhyaya_name": "षट्षष्ट्यधिकशततमोऽध्यायः",
      "english_ref": 15,
      "combined_translation": "15-25"
    },
    {
      "verse": 26,
      "sanskrit": "दानवेन्द्रास्त्वतिक्रम्य तत्पितामहशासनम् । धर्मस्यापचयं चक्रुः क्रोधलोभसमन्विताः ॥२६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 166,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "आपद्धर्मपर्व",
      "adhyaya_name": "षट्षष्ट्यधिकशततमोऽध्यायः",
      "english_ref": 16,
      "combined_translation": "16-26"
    },
    {
      "verse": 27,
      "sanskrit": "हिरण्यकशिपुश्चैव हिरण्याक्षो विरोचनः । शम्बरो विप्रचित्तिश्च विराधो नमुचिर्बलिः ॥२७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 166,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "आपद्धर्मपर्व",
      "adhyaya_name": "षट्षष्ट्यधिकशततमोऽध्यायः",
      "english_ref": 17,
      "combined_translation": "17-27"
    },
    {
      "verse": 28,
      "sanskrit": "एते चान्ये च बहवः सगणा दैत्यदानवाः । धर्मसेतुमतिक्रम्य रेमिरे धर्मनिश्चयाः ॥२८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 166,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "आपद्धर्मपर्व",
      "adhyaya_name": "षट्षष्ट्यधिकशततमोऽध्यायः",
      "english_ref": 18,
      "combined_translation": "18-28"
    },
    {
      "verse": 29,
      "sanskrit": "सर्वे तुल्याभिजातीया यथा देवास्तथा वयम् । इत्येवं धर्ममास्थाय स्पर्धमानाः सुरर्षिभिः ॥२९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 166,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "आपद्धर्मपर्व",
      "adhyaya_name": "षट्षष्ट्यधिकशततमोऽध्यायः",
      "english_ref": 19,
      "combined_translation": "19-29"
    },
    {
