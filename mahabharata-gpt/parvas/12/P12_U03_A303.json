{
  "adhyaya_id": "P12_U03_A303",
  "book": 12,
  "parva_name": "शान्तिपर्व",
  "upaparva_name": "मोक्षधर्मपर्व",
  "adhyaya_name": "त्र्यधिकत्रिशतततमोऽध्यायः",
  "chapter": 303,
  "verse_count": 54,
  "verses": [
    {
      "verse": 1,
      "sanskrit": "वसिष्ठ उवाच । एवमप्रतिबुद्धत्वादवुद्धमनुवर्तते। देहाद्देहसहस्राणि तथा समभिपद्यते॥१॥",
      "english": "Vasistha said Thus on account of his forgetfulness the Soul follows Ignorance and acquires thousands of bodies one after another.",
      "bhavadeepa": null,
      "chapter": 303,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "मोक्षधर्मपर्व",
      "adhyaya_name": "त्र्यधिकत्रिशतततमोऽध्यायः",
      "combined_translation": "1-1"
    },
    {
      "verse": 2,
      "sanskrit": "तिर्यग्योनिसहस्रेषु कदाचिद्देवतास्वपि। उपपद्यति संयोगाद्गुणैः सह गुणक्षयात्॥२॥",
      "english": "He attains to thousands of births among the intermediate orders and sometimes among the very gods on account his union with qualities.",
      "bhavadeepa": null,
      "chapter": 303,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "मोक्षधर्मपर्व",
      "adhyaya_name": "त्र्यधिकत्रिशतततमोऽध्यायः",
      "combined_translation": "2-4"
    },
    {
      "verse": 3,
      "sanskrit": "मानुषत्वाद्दिवं याति दिवो मानुष्यमेव च। मानुष्यान्निरयस्थानमानन्त्यं प्रतिपद्यते॥३॥",
      "english": "From the status of humanity he goes to heaven and from heaven he returns to humanity, and from humanity he sinks into hell for many long years.",
      "bhavadeepa": null,
      "chapter": 303,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "मोक्षधर्मपर्व",
      "adhyaya_name": "त्र्यधिकत्रिशतततमोऽध्यायः",
      "combined_translation": "3-6"
    },
    {
      "verse": 4,
      "sanskrit": "कोशकारो यथाऽऽत्मानं कीट: समवरुन्धति। सूत्रतन्तुगुणैर्नित्यं तथायमगुणो गुणैः॥४॥",
      "english": "As the worm that make the cocoon does itself completely on all sides by means of the threads it weaves itself, so the Soul, though in reality above all qualities, invests himself on all sides with qualities.",
      "bhavadeepa": null,
      "chapter": 303,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "मोक्षधर्मपर्व",
      "adhyaya_name": "त्र्यधिकत्रिशतततमोऽध्यायः",
      "combined_translation": "4-7"
    },
    {
      "verse": 5,
      "sanskrit": "द्वन्द्वमेति च निर्द्वन्द्वस्तासु तास्विह योनिषु। शीर्षरोगेऽक्षिरोगे च दन्तशूले गलग्रहे॥५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 303,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "मोक्षधर्मपर्व",
      "adhyaya_name": "त्र्यधिकत्रिशतततमोऽध्यायः",
      "english_ref": 3,
      "combined_translation": "3-5"
    },
    {
      "verse": 6,
      "sanskrit": "जलोदरे तृषारोगे ज्वरगण्डे विषूचके। श्वित्रकुष्ठेऽग्निदग्धे च सिध्मापस्मारयोरपि॥६॥",
      "english": "Though above both happiness and misery, it is thus that he subjects himself to happiness and misery. It is thus also that, though above all discases, the Soul considers himself to be afflicted by headache, opthalmia, toothache, affections of the throat, abdominal dropsy, burning thirst, enlargement of glands, cholera, vitiligo, leprosy, burns, asthma, phthisis, epilepsy, and various other diseases from which embodied creatures suffer.",
      "bhavadeepa": null,
      "chapter": 303,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "मोक्षधर्मपर्व",
      "adhyaya_name": "त्र्यधिकत्रिशतततमोऽध्यायः",
      "combined_translation": "6-8"
    },
    {
      "verse": 7,
      "sanskrit": "यानि चान्यानि द्वन्द्वानि प्राकृतानि शरीरिषु। उत्पद्यन्ते विचित्राणि तान्येषोऽप्यभिमन्यते॥७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 303,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "मोक्षधर्मपर्व",
      "adhyaya_name": "त्र्यधिकत्रिशतततमोऽध्यायः",
      "english_ref": 6,
      "combined_translation": "6-8"
    },
    {
      "verse": 8,
      "sanskrit": "तिर्यग्योनिसहस्रेषु कदाचिद्देवतास्वपि। अभिमन्यत्यभीमानात्तथैव सुकृतान्यपि॥८॥",
      "english": "Considering himself, through error, as born among thousands of creatures in the intermediate orders of being, the sometimes among the gods, he suffer misery and enjoys the fruits of his good deeds.",
      "bhavadeepa": null,
      "chapter": 303,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "मोक्षधर्मपर्व",
      "adhyaya_name": "त्र्यधिकत्रिशतततमोऽध्यायः",
      "combined_translation": "8-9"
    },
    {
      "verse": 9,
      "sanskrit": "शुक्लवासाश्च दुर्वासाः शायी नित्यमधस्तथा। मण्डूकशायी च तथा वीरासनगतस्तथा॥९॥",
      "english": "Invested with Ignorance he considers himself as dressed sometimes in white cloth and sometimes in full dress of four pieces, or as lying on floors or with hands and feet contracted like those of frogs, or as seated upright in the position of meditation, or as clad in rags or as lying or sitting under the canopy of heaven or within palaces bult of bricks and stone or on rugged stones or on ashes or bare stones or on the naked earth or on beds or on battle-fields or in water or in mire or on wooden planks or on various sorts of beds; or, moved by desire of fruit, he considers himself as clad in a piece of cloth made of grass or as totally naked or as dressed in silk or in skin of the black antelope or in cloth made of flax or in sheep-skin or in tiger-skin or in lion-skin or in hemp fabric, or in barks of birch or in cloths made of the produce of prickly plants, or in vestures made of threads woven by worms or of tattered rags or in various other sorts of cloth too numerous to mention. The soul considers himself also as wearing various sorts of ornaments and gems, or as eating various sorts of food.",
      "bhavadeepa": null,
      "chapter": 303,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "मोक्षधर्मपर्व",
      "adhyaya_name": "त्र्यधिकत्रिशतततमोऽध्यायः",
      "combined_translation": "9-15"
    },
    {
      "verse": 10,
      "sanskrit": "चीरधारणमाकाशे शयनं स्थानमेव च। इष्टकाप्रस्तरे चैव कण्टकप्रस्तरे तथा॥१०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 303,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "मोक्षधर्मपर्व",
      "adhyaya_name": "त्र्यधिकत्रिशतततमोऽध्यायः",
      "english_ref": 9,
      "combined_translation": "9-15"
    },
    {
      "verse": 11,
      "sanskrit": "भस्मप्रस्तरशायी च भूमिशय्या तलेषु च। वीरस्थानाम्बुपङ्के च शयनं फलकेषु च॥११॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 303,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "मोक्षधर्मपर्व",
      "adhyaya_name": "त्र्यधिकत्रिशतततमोऽध्यायः",
      "english_ref": 9,
      "combined_translation": "9-15"
    },
    {
      "verse": 12,
      "sanskrit": "विविधासु च शय्यासु फलगृद्व्यान्वितस्तथा। मुञ्जमेखलनग्नत्वं क्षौमकृष्णाजिनानि च॥१२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 303,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "मोक्षधर्मपर्व",
      "adhyaya_name": "त्र्यधिकत्रिशतततमोऽध्यायः",
      "english_ref": 9,
      "combined_translation": "9-15"
    },
    {
      "verse": 13,
      "sanskrit": "शाणीवालपरीधानो व्याघ्रचर्मपरिच्छदः। सिंहचर्मपरीधानः पट्टवासास्तथैव च॥१३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 303,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "मोक्षधर्मपर्व",
      "adhyaya_name": "त्र्यधिकत्रिशतततमोऽध्यायः",
      "english_ref": 9,
      "combined_translation": "9-15"
    },
    {
      "verse": 14,
      "sanskrit": "फलकं परिधानश्च तथा कण्टकवस्त्रधृक्। कीटकावसनश्चैव चीरवासास्तथैव च॥१४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 303,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "मोक्षधर्मपर्व",
      "adhyaya_name": "त्र्यधिकत्रिशतततमोऽध्यायः",
      "english_ref": 9,
      "combined_translation": "9-15"
    },
    {
      "verse": 15,
      "sanskrit": "वस्त्राणि चान्यानि बहून्यभिमन्यत्यबुद्धिमान्। भोजनानि विचित्राणि रत्नानि विविधानि च॥१५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 303,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "मोक्षधर्मपर्व",
      "adhyaya_name": "त्र्यधिकत्रिशतततमोऽध्यायः",
      "english_ref": 9,
      "combined_translation": "9-15"
    },
    {
      "verse": 16,
      "sanskrit": "एकरात्रान्तराशित्वमेककालिकभोजनम्। चतुर्थाष्टमकालश्च षष्ठकालिक एव च॥१६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 303,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "मोक्षधर्मपर्व",
      "adhyaya_name": "त्र्यधिकत्रिशतततमोऽध्यायः",
      "english_ref": 11,
      "combined_translation": "11-20"
    },
    {
      "verse": 17,
      "sanskrit": "षड्रात्रभोजनश्चैव तथैवाष्टाहभोजनः। सप्तरात्रदशाहारो द्वादशाहिकभोजनः॥१७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 303,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "मोक्षधर्मपर्व",
      "adhyaya_name": "त्र्यधिकत्रिशतततमोऽध्यायः",
      "english_ref": 11,
      "combined_translation": "11-20"
    },
    {
      "verse": 18,
      "sanskrit": "मासोपवासी मूलाशी फलाहारस्तथैव च। वायुभक्षोम्बुपिण्याकदधिगोमयभोजनः॥१८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 303,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "मोक्षधर्मपर्व",
      "adhyaya_name": "त्र्यधिकत्रिशतततमोऽध्यायः",
      "english_ref": 11,
      "combined_translation": "11-20"
    },
    {
      "verse": 19,
      "sanskrit": "गोमूत्रभोजनश्चैव शाकपुष्पाद एव च। शैवालभोजनश्चैव तथा चाऽऽमेन वर्तयन्॥१९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 303,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "मोक्षधर्मपर्व",
      "adhyaya_name": "त्र्यधिकत्रिशतततमोऽध्यायः",
      "english_ref": 11,
      "combined_translation": "11-20"
    },
    {
      "verse": 20,
      "sanskrit": "वर्तयन् शीर्णपर्णैश्च प्रकीर्णफलभोजनः। विविधानि च कृच्छ्राणि सेवते सिद्धिकांक्षया॥२०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 303,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "मोक्षधर्मपर्व",
      "adhyaya_name": "त्र्यधिकत्रिशतततमोऽध्यायः",
      "english_ref": 11,
      "combined_translation": "11-20"
    },
    {
      "verse": 21,
      "sanskrit": "चान्द्रायणानि विधिवल्लिङ्गानि विविधानि च। चातुराश्रम्यपन्थानमाश्रयत्यपथानपि॥२१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 303,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "मोक्षधर्मपर्व",
      "adhyaya_name": "त्र्यधिकत्रिशतततमोऽध्यायः",
      "english_ref": 12,
      "combined_translation": "12-25"
    },
    {
      "verse": 22,
      "sanskrit": "उपाश्रमानप्यपरान्पाषण्डान्विविधानपि। विविक्ताश्च शिलाच्छायास्तथा प्रस्रवणानि च॥२२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 303,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "मोक्षधर्मपर्व",
      "adhyaya_name": "त्र्यधिकत्रिशतततमोऽध्यायः",
      "english_ref": 12,
      "combined_translation": "12-25"
    },
    {
      "verse": 23,
      "sanskrit": "पुलिनानि विविक्तानि विविक्तानि वनानि च। देवस्थानानि पुण्यानि विविक्तानि सरांसि च॥२३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 303,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "मोक्षधर्मपर्व",
      "adhyaya_name": "त्र्यधिकत्रिशतततमोऽध्यायः",
      "english_ref": 12,
      "combined_translation": "12-25"
    },
    {
      "verse": 24,
      "sanskrit": "विविक्ताश्चापि शैलानां गुहा गृहनिभोपमाः। विविक्तानि च जप्यानि व्रतानि विविधानि च॥२४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 303,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "मोक्षधर्मपर्व",
      "adhyaya_name": "त्र्यधिकत्रिशतततमोऽध्यायः",
      "english_ref": 21,
      "combined_translation": "21-24"
    },
    {
      "verse": 25,
      "sanskrit": "नियमान्विविधांश्चापि विविधानि तपांसि च। यज्ञांश्च विविधाकारान्विधींश्च विविधांस्तथा॥२५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 303,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "मोक्षधर्मपर्व",
      "adhyaya_name": "त्र्यधिकत्रिशतततमोऽध्यायः",
      "english_ref": 12,
      "combined_translation": "12-25"
    },
    {
      "verse": 26,
      "sanskrit": "वणिक्पथं द्विजं क्षत्रं वैश्यशूद्रांस्तथैव च। दानं च विविधाकारं दीनान्धकृपणादिषु॥२६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 303,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "मोक्षधर्मपर्व",
      "adhyaya_name": "त्र्यधिकत्रिशतततमोऽध्यायः",
      "english_ref": 13,
      "combined_translation": "13-26"
    },
    {
      "verse": 27,
      "sanskrit": "अभिमन्यत्यसम्बोधात्तथैव त्रिविधान् गुणान्। सत्त्वं रजस्तमश्चैव धर्मार्थै काम एव च॥२७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 303,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "मोक्षधर्मपर्व",
      "adhyaya_name": "त्र्यधिकत्रिशतततमोऽध्यायः",
      "english_ref": 14,
      "combined_translation": "14-27"
    },
    {
      "verse": 28,
      "sanskrit": "प्रकृत्यात्मानमेवात्मा एवं प्रविभजत्युत। स्वधाकारवषट्कारौ स्वाहाकारनमस्क्रियाः॥२८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 303,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "मोक्षधर्मपर्व",
      "adhyaya_name": "त्र्यधिकत्रिशतततमोऽध्यायः",
      "english_ref": 15,
      "combined_translation": "15-29"
    },
    {
      "verse": 29,
      "sanskrit": "याजनाध्यापनं दानं तथैवाहुः प्रतिग्रहम्। यजनाध्ययने चैव यच्चान्यदपि किञ्चन॥२९॥",
      "english": null,
      "bhavadeepa": null,
