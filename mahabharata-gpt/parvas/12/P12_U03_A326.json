{
  "adhyaya_id": "P12_U03_A326",
  "book": 12,
  "parva_name": "शान्तिपर्व",
  "upaparva_name": "मोक्षधर्मपर्व",
  "adhyaya_name": "षड्विंशत्यधिकत्रिशततमोऽध्यायः",
  "chapter": 326,
  "verse_count": 51,
  "verses": [
    {
      "verse": 1,
      "sanskrit": "भीष्म उवाच।\n              ततः स राजा जनको मन्त्रिभिः सह भारत। पुरः पुरोहितं कृत्वा सर्वाण्यन्तःपुराणि च॥१॥",
      "english": "Bhishma said The next morning, king Janaka, O Bharata, accompanied by his minister and the whole household, came to Shuka, preceded by his priest.",
      "bhavadeepa": null,
      "chapter": 326,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "मोक्षधर्मपर्व",
      "adhyaya_name": "षड्विंशत्यधिकत्रिशततमोऽध्यायः",
      "combined_translation": "1-1"
    },
    {
      "verse": 2,
      "sanskrit": "आसनं च पुरस्कृत्य रत्नानि विविधानि च। शिरसा चार्घमादाय गुरुपुत्रं समभ्यगात्॥२॥",
      "english": "Bringing with him rich seats and various sorts of jewels and gems, and bearing the ingredients of the Arghya on his own head, the king approached the son of his reverend preceptor.",
      "bhavadeepa": null,
      "chapter": 326,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "मोक्षधर्मपर्व",
      "adhyaya_name": "षड्विंशत्यधिकत्रिशततमोऽध्यायः",
      "combined_translation": "2-2"
    },
    {
      "verse": 3,
      "sanskrit": "स तदाऽऽसनमादाय बहुरत्नविभूषितम्। स्पर्द्ध्यास्तरणसंस्तीर्णं सर्वतोभद्रमृद्धिमत्॥३॥",
      "english": "The king, taking with his own hands, from the hands of his priest, that seat adorned with many gems, covered with an excellent sheet, beautiful in all its parts and dearly costly, presented it with great respect to his preceptor's son Shuka.",
      "bhavadeepa": null,
      "chapter": 326,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "मोक्षधर्मपर्व",
      "adhyaya_name": "षड्विंशत्यधिकत्रिशततमोऽध्यायः",
      "combined_translation": "3-4"
    },
    {
      "verse": 4,
      "sanskrit": "पुरोधसा संगृहीतं हस्तेनालभ्य पार्थिवः। प्रददौ गुरुपुत्राय शुकाय परमार्चितम्॥४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 326,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "मोक्षधर्मपर्व",
      "adhyaya_name": "षड्विंशत्यधिकत्रिशततमोऽध्यायः",
      "english_ref": 3,
      "combined_translation": "3-4"
    },
    {
      "verse": 5,
      "sanskrit": "तत्रोपविष्टं तं कार्ष्णिं शास्त्रतः प्रत्यपूजयत्। पाद्यं निवेद्य प्रथममर्घ्यं गां च न्यवेदयत्॥५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 326,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "मोक्षधर्मपर्व",
      "adhyaya_name": "षड्विंशत्यधिकत्रिशततमोऽध्यायः",
      "english_ref": 4,
      "combined_translation": "4-5"
    },
    {
      "verse": 6,
      "sanskrit": "स च तां मन्त्रवत्पूजां प्रत्यगृह्णाद्यथाविधि। प्रतिगुह्य तु तां पूजां जनकाद्द्विजसत्तमः॥६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 326,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "मोक्षधर्मपर्व",
      "adhyaya_name": "षड्विंशत्यधिकत्रिशततमोऽध्यायः",
      "english_ref": 5,
      "combined_translation": "5-7"
    },
    {
      "verse": 7,
      "sanskrit": "गां चैव समनुज्ञाय राजानमनुमान्य च। पर्यपृच्छन्महातेजा राज्ञः कुशलमव्ययम्॥७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 326,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "मोक्षधर्मपर्व",
      "adhyaya_name": "षड्विंशत्यधिकत्रिशततमोऽध्यायः",
      "english_ref": 5,
      "combined_translation": "5-7"
    },
    {
      "verse": 8,
      "sanskrit": "अनामयं च राजेन्द्र शुकः सानुचरस्य ह। अनशिष्टस्तु तेनासौ निषसाद सहानुगः॥८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 326,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "मोक्षधर्मपर्व",
      "adhyaya_name": "षड्विंशत्यधिकत्रिशततमोऽध्यायः",
      "english_ref": 6,
      "combined_translation": "6-8"
    },
    {
      "verse": 9,
      "sanskrit": "उदारसत्त्वाभिजनो भूमौ राजा कृताञ्जलिः। कुशलं चाव्ययं चैव पृष्ट्वा वैयासकिं नृपः। किमागमनमित्येवं पर्यपृच्छत पार्थिवः॥९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 326,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "मोक्षधर्मपर्व",
      "adhyaya_name": "षड्विंशत्यधिकत्रिशततमोऽध्यायः",
      "english_ref": 7,
      "combined_translation": "7-9"
    },
    {
      "verse": 10,
      "sanskrit": "शुक उवाच । पित्राऽहमुक्तो भद्रं ते मोक्षधर्मार्थकोविदः। विदेहराजो याज्यो मे जनको नाम विश्रुतः॥१०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 326,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "मोक्षधर्मपर्व",
      "adhyaya_name": "षड्विंशत्यधिकत्रिशततमोऽध्यायः",
      "english_ref": 8,
      "combined_translation": "8-10"
    },
    {
      "verse": 11,
      "sanskrit": "तत्र गच्छस्व वै तूर्णं यदि ते हृदि संशयः। प्रवृत्तौ वा निवृत्तौ वा स ते च्छेत्स्यति संशयम्॥११॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 326,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "मोक्षधर्मपर्व",
      "adhyaya_name": "षड्विंशत्यधिकत्रिशततमोऽध्यायः",
      "english_ref": 9,
      "combined_translation": "9-11"
    },
    {
      "verse": 12,
      "sanskrit": "सोऽहं पितुर्नियोगात्त्वामुपप्रष्टुमिहागतः। तन्मे धर्मभृतां श्रेष्ठ यथावद्वक्तुर्महसि॥१२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 326,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "मोक्षधर्मपर्व",
      "adhyaya_name": "षड्विंशत्यधिकत्रिशततमोऽध्यायः",
      "english_ref": 10,
      "combined_translation": "10-12"
    },
    {
      "verse": 13,
      "sanskrit": "किं कार्यं ब्राह्मणेनेह मोक्षार्थश्च किमात्मकः। कथं च मोक्षः प्राप्तव्यो ज्ञानेन तपसाऽथवा॥१३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 326,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "मोक्षधर्मपर्व",
      "adhyaya_name": "षड्विंशत्यधिकत्रिशततमोऽध्यायः",
      "english_ref": 11,
      "combined_translation": "11-13"
    },
    {
      "verse": 14,
      "sanskrit": "जनक उवाच । यत्कार्यं ब्राह्मणेनेह जन्मप्रभृति तच्छृणु। कृतोपनयनस्तात भवेद्वेदपरायणः॥१४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 326,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "मोक्षधर्मपर्व",
      "adhyaya_name": "षड्विंशत्यधिकत्रिशततमोऽध्यायः",
      "english_ref": 12,
      "combined_translation": "12-14"
    },
    {
      "verse": 15,
      "sanskrit": "तपसा गुरुवृत्त्या च ब्रह्मचर्येण वा विभो। देवतानां पितॄणां चाप्यनृणो ह्यनसूयकः॥१५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 326,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "मोक्षधर्मपर्व",
      "adhyaya_name": "षड्विंशत्यधिकत्रिशततमोऽध्यायः",
      "english_ref": 13,
      "combined_translation": "13-15"
    },
    {
      "verse": 16,
      "sanskrit": "वेदानधीत्य नियतो दक्षिणामपवर्ज्य च। अभ्यनुज्ञामथ प्राप्य समावर्तेत वै द्विजः॥१६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 326,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "मोक्षधर्मपर्व",
      "adhyaya_name": "षड्विंशत्यधिकत्रिशततमोऽध्यायः",
      "english_ref": 14,
      "combined_translation": "14-16"
    },
    {
      "verse": 17,
      "sanskrit": "समावृत्तश्च गार्हस्थ्ये स्वदारनिरतो वसेत्। अनसूयुर्यथान्यायमाहिताग्निस्तथैव च॥१७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 326,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "मोक्षधर्मपर्व",
      "adhyaya_name": "षड्विंशत्यधिकत्रिशततमोऽध्यायः",
      "english_ref": 15,
      "combined_translation": "15-17"
    },
    {
      "verse": 18,
      "sanskrit": "उत्पाद्य पुत्रपौत्रं तु वन्याश्रमपदे वसेत्। तानेवाग्नीन्यथाशास्त्रमर्चयन्नतिथिप्रियः॥१८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 326,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "मोक्षधर्मपर्व",
      "adhyaya_name": "षड्विंशत्यधिकत्रिशततमोऽध्यायः",
      "english_ref": 16,
      "combined_translation": "16-18"
    },
    {
      "verse": 19,
      "sanskrit": "स वनेऽग्नीन्यथान्यायमात्मन्यारोप्य धर्मवित्। निर्द्वन्द्वो वीतरागात्मा ब्रह्माश्रमपदे वसेत्॥१९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 326,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "मोक्षधर्मपर्व",
      "adhyaya_name": "षड्विंशत्यधिकत्रिशततमोऽध्यायः",
      "english_ref": 17,
      "combined_translation": "17-19"
    },
    {
      "verse": 20,
      "sanskrit": "शुक उवाच । उत्पन्ने ज्ञानविज्ञाने निर्द्वन्द्वे हृदि शाश्वते। किमवश्यं निवस्तव्यमाश्रमेषु भवेत्त्रिषु॥२०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 326,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "मोक्षधर्मपर्व",
      "adhyaya_name": "षड्विंशत्यधिकत्रिशततमोऽध्यायः",
      "english_ref": 18,
      "combined_translation": "18-20"
    },
    {
      "verse": 21,
      "sanskrit": "एतद्भवन्तं पृच्छामि तद्भवान्वक्तुमर्हति। यथा वेदार्थतत्त्वेन ब्रूहि मे त्वं जनाधिप॥२१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 326,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "मोक्षधर्मपर्व",
      "adhyaya_name": "षड्विंशत्यधिकत्रिशततमोऽध्यायः",
      "english_ref": 19,
      "combined_translation": "19-21"
    },
    {
      "verse": 22,
      "sanskrit": "जनक उवाच । न विना ज्ञानविज्ञाने मोक्षस्याधिगमो भवेत्। न विना गुरुसम्बन्धं ज्ञानस्याधिगमः स्मृतः॥२२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 326,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "मोक्षधर्मपर्व",
      "adhyaya_name": "षड्विंशत्यधिकत्रिशततमोऽध्यायः",
      "english_ref": 20,
      "combined_translation": "20-22"
    },
    {
      "verse": 23,
      "sanskrit": "गुरुः प्लावयिता तस्य ज्ञानं प्लव इहोच्यते। विज्ञाय कृतकृत्यस्तु तीर्णस्तदुभयं त्यजेत्॥२३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 326,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "मोक्षधर्मपर्व",
      "adhyaya_name": "षड्विंशत्यधिकत्रिशततमोऽध्यायः",
      "english_ref": 21,
      "combined_translation": "21-23"
    },
    {
      "verse": 24,
      "sanskrit": "अनुच्छेदाय लोकानामनुच्छेदाय कर्मणाम्। पूर्वैराचरितो धर्मश्चातुराश्रम्यसंकटः॥२४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 326,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "मोक्षधर्मपर्व",
      "adhyaya_name": "षड्विंशत्यधिकत्रिशततमोऽध्यायः",
      "english_ref": 22,
      "combined_translation": "22-24"
    },
    {
      "verse": 25,
      "sanskrit": "अनेन क्रमयोगेन बहुजातिषु कर्मणाम्। हित्वा शुभाशुभं कर्म मोक्षो नामेह लभ्यते॥२५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 326,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "मोक्षधर्मपर्व",
      "adhyaya_name": "षड्विंशत्यधिकत्रिशततमोऽध्यायः",
      "english_ref": 23,
      "combined_translation": "23-25"
    },
    {
      "verse": 26,
      "sanskrit": "भावितैः करणैश्चायं बहुसंसारयोनिषु। आसादयति शुद्धात्मा मोक्षं वै प्रथमाश्रमे॥२६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 326,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "मोक्षधर्मपर्व",
      "adhyaya_name": "षड्विंशत्यधिकत्रिशततमोऽध्यायः",
      "english_ref": 24,
      "combined_translation": "24-26"
    },
    {
      "verse": 27,
      "sanskrit": "तमासाद्य तु मुक्तस्य दृष्टार्थस्य विपश्चितः। त्रिष्वाश्रमेषु को न्वर्थो भवेत्परमभीप्सतः॥२७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 326,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "मोक्षधर्मपर्व",
      "adhyaya_name": "षड्विंशत्यधिकत्रिशततमोऽध्यायः",
      "english_ref": 25,
      "combined_translation": "25-27"
    },
    {
      "verse": 28,
      "sanskrit": "राजसांस्तामसांश्चैव नित्यं दोषान्विवर्जयेत्। सात्त्विकं मार्गमास्थाय पश्येदात्मानमात्मना॥२८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 326,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "मोक्षधर्मपर्व",
      "adhyaya_name": "षड्विंशत्यधिकत्रिशततमोऽध्यायः",
      "english_ref": 26,
      "combined_translation": "26-28"
    },
    {
      "verse": 29,
      "sanskrit": "सर्वभूतेषु चात्मानं सर्वभूतानि चात्मनि। संपश्यन्नोपलिप्येत जले वारिचरो यथा॥२९॥",
