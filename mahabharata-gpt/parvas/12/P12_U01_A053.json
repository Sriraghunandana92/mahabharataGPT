{
  "adhyaya_id": "P12_U01_A053",
  "book": 12,
  "parva_name": "शान्तिपर्व",
  "upaparva_name": "राजधर्मानुशासनपर्व",
  "adhyaya_name": "त्रिपञ्चाशत्तमोऽध्यायः",
  "chapter": 53,
  "verse_count": 26,
  "verses": [
    {
      "verse": 1,
      "sanskrit": "वैशम्पायन उवाच।\n              ततः शयनमाविश्य प्रसुप्तो मधुसूदनः। याममात्रार्धशेषायां यामिन्यां प्रत्यबुद्ध्यत॥१॥",
      "english": "Bhishma said Regarding it is also cited the old discourse between him of a hundred sacrifices and the Asura Namuchi,OYudhisthira.",
      "bhavadeepa": null,
      "chapter": 53,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "त्रिपञ्चाशत्तमोऽध्यायः",
      "combined_translation": "1-2"
    },
    {
      "verse": 2,
      "sanskrit": "स ध्यानपथमाविश्य सर्वज्ञानानि माधवः। अवलोक्य ततः पश्चाद्दध्यौ ब्रह्म सनातनम्॥२॥",
      "english": null,
      "bhavadeepa": "तत इति ॥१॥",
      "chapter": 53,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "त्रिपञ्चाशत्तमोऽध्यायः",
      "english_ref": 1,
      "combined_translation": "1-2"
    },
    {
      "verse": 3,
      "sanskrit": "ततः स्तुतिपुराणज्ञा रक्तकण्ठाः सुशिक्षिताः। अस्तुवन्विश्वकर्माणं वासुदेवं प्रजापतिम्॥३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 53,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "त्रिपञ्चाशत्तमोऽध्यायः",
      "english_ref": 2,
      "combined_translation": "2-3"
    },
    {
      "verse": 4,
      "sanskrit": "पठन्ति पाणिस्वनिकास्तथा गायन्ति गायनाः। शङ्खानथ मृदङ्गांश्च प्रवाद्यन्ति सहस्रशः॥४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 53,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "त्रिपञ्चाशत्तमोऽध्यायः",
      "english_ref": 3,
      "combined_translation": "3-4"
    },
    {
      "verse": 5,
      "sanskrit": "वीणापणववेणूनां स्वनश्चातिमनोरमः। सहास इव विस्तीर्णः शुश्रुवे तस्य वेश्मनः॥५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 53,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "त्रिपञ्चाशत्तमोऽध्यायः",
      "english_ref": 4,
      "combined_translation": "4-5"
    },
    {
      "verse": 6,
      "sanskrit": "ततो युधिष्ठिरस्यापि राज्ञो मङ्गलसंहिताः। उच्चेरुर्मधुरा वाचो गीतवादित्रनि:स्वनाः॥६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 53,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "त्रिपञ्चाशत्तमोऽध्यायः",
      "english_ref": 5,
      "combined_translation": "5-6"
    },
    {
      "verse": 7,
      "sanskrit": "तत उत्थाय दाशार्हः स्नातः प्राञ्जलिरच्युतः। जप्त्वा गुह्यं महाबाहुरग्नीनाश्रित्य तस्थिवान्॥७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 53,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "त्रिपञ्चाशत्तमोऽध्यायः",
      "english_ref": 6,
      "combined_translation": "6-7"
    },
    {
      "verse": 8,
      "sanskrit": "ततः सहस्रं विप्राणां चतुर्वेदविदां तथा। गवां सहस्रेणैकैकं वाचयामास माधवः॥८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 53,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "त्रिपञ्चाशत्तमोऽध्यायः",
      "english_ref": 7,
      "combined_translation": "7-8"
    },
    {
      "verse": 9,
      "sanskrit": "मङ्गलालम्भनं कृत्वा आत्मानमवलोक्य च। आदर्श विमले कृष्णस्ततः सात्यकिमब्रवीत्॥९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 53,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "त्रिपञ्चाशत्तमोऽध्यायः",
      "english_ref": 8,
      "combined_translation": "8-10"
    },
    {
      "verse": 10,
      "sanskrit": "गच्छ शैनेय जानीहि गत्वा राजनिवेशनम्। अपि सज्जो महातेजा भीष्मं द्रष्टुं युधिष्ठिरः॥१०॥",
      "english": null,
      "bhavadeepa": "मङ्गलानां गवादीनामालम्भनं स्पर्शम् ॥९॥",
      "chapter": 53,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "त्रिपञ्चाशत्तमोऽध्यायः",
      "english_ref": 8,
      "combined_translation": "8-10"
    },
    {
      "verse": 11,
      "sanskrit": "ततः कृष्णस्य वचनात्सात्यकिस्त्वरितो ययौ। उपगम्य च राजानं युधिष्ठिरमभाषत॥११॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 53,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "त्रिपञ्चाशत्तमोऽध्यायः",
      "english_ref": 9,
      "combined_translation": "9-12"
    },
    {
      "verse": 12,
      "sanskrit": "युक्तो रथवरो राजन्वासुदेवस्य धीमतः। समीपमापगेयस्य प्रयास्यति जनार्दनः॥१२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 53,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "त्रिपञ्चाशत्तमोऽध्यायः",
      "english_ref": 9,
      "combined_translation": "9-12"
    },
    {
      "verse": 13,
      "sanskrit": "भवत्प्रतीक्षः कृष्णोऽसौ धर्मराज महाद्युते। यदत्रानन्तरं कृत्यं तद्भवान्कर्तुमर्हति॥१३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 53,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "त्रिपञ्चाशत्तमोऽध्यायः",
      "english_ref": 10,
      "combined_translation": "10-13"
    },
    {
      "verse": 14,
      "sanskrit": "एवमुक्तः प्रत्युवाच धर्मपुत्रो युधिष्ठिरः।\n              युधिष्ठिर उवाच।\n              युज्यतां मे रथवरः फाल्गुनाप्रतिमद्युते॥१४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 53,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "त्रिपञ्चाशत्तमोऽध्यायः",
      "english_ref": 11,
      "combined_translation": "11-14"
    },
    {
      "verse": 15,
      "sanskrit": "न सैनिकैश्च यातव्यं यास्यामो वयमेव हि। न च पीडयितव्यो मे भीष्मो धर्मभृतां वरः॥१५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 53,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "त्रिपञ्चाशत्तमोऽध्यायः",
      "english_ref": 12,
      "combined_translation": "12-15"
    },
    {
      "verse": 16,
      "sanskrit": "अतः पुरःसराश्चापि निवर्तन्तु धनंजय। अद्यप्रभृति गाङ्गेयः परं गुह्यं प्रवक्ष्यति॥१६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 53,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "त्रिपञ्चाशत्तमोऽध्यायः",
      "english_ref": 13,
      "combined_translation": "13-16"
    },
    {
      "verse": 17,
      "sanskrit": "अतो नेच्छामि कौन्तेय पृथग्जनसमागमम्।\n              वैशम्पायन उवाच।\n              स तद्वाक्यमथाज्ञाय कुन्तीपुत्रो धनंजयः॥१७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 53,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "त्रिपञ्चाशत्तमोऽध्यायः"
    },
    {
      "verse": 18,
      "sanskrit": "युक्तं रथवरं तस्मा आचचक्षे नरर्षभः। ततो युधिष्ठिरो राजा यमौ भीमार्जुनावपि॥१८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 53,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "त्रिपञ्चाशत्तमोऽध्यायः",
      "english_ref": 14,
      "combined_translation": "14-18"
    },
    {
      "verse": 19,
      "sanskrit": "भूतानीव समस्तानि ययुः कृष्णनिवेशनम्। आगच्छत्स्वथ कृष्णोऽपि पाण्डवेषु महात्मसु॥१९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 53,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "त्रिपञ्चाशत्तमोऽध्यायः",
      "english_ref": 15,
      "combined_translation": "15-19"
    },
    {
      "verse": 20,
      "sanskrit": "शैनेयसहितो धीमान् रथमेवान्वपद्यत। रथस्थाः संविदं कृत्वा सुखां पृष्ट्वा च शर्वरीम्॥२०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 53,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "त्रिपञ्चाशत्तमोऽध्यायः",
      "english_ref": 16,
      "combined_translation": "16-20"
    },
    {
      "verse": 21,
      "sanskrit": "दारुकश्चोदयामास वासुदेवस्य वाजिनः॥२१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 53,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "त्रिपञ्चाशत्तमोऽध्यायः"
    },
    {
      "verse": 22,
      "sanskrit": "ते हया वासुदेवस्य दारुकेण प्रचोदिताः। गां खुरागैस्तथा राजन् लिखन्तः प्रययुस्तद॥२२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 53,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "त्रिपञ्चाशत्तमोऽध्यायः",
      "english_ref": 18,
      "combined_translation": "18-22"
    },
    {
      "verse": 23,
      "sanskrit": "ते ग्रसन्त इवाकाशं वेगवन्तो महाबलाः। क्षेत्रं धर्मस्य कृत्स्नस्य कुरुक्षेत्रमवातरन्॥२३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 53,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "त्रिपञ्चाशत्तमोऽध्यायः",
      "english_ref": 19,
      "combined_translation": "19-24"
    },
    {
      "verse": 24,
      "sanskrit": "ततो ययुर्यत्र भीष्मः शरतल्पगतः प्रभुः। आस्ते महर्षिभिः सार्धं ब्रह्मा देवगणैर्यथा॥२४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 53,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "त्रिपञ्चाशत्तमोऽध्यायः",
      "english_ref": 19,
      "combined_translation": "19-24"
    },
    {
      "verse": 25,
      "sanskrit": "ततोऽवतीर्य गोविन्दो रथात्स च युधिष्ठिरः। भीमो गाण्डीवधन्वा च यमौ सात्यकिरेव च॥२५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 53,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "त्रिपञ्चाशत्तमोऽध्यायः",
      "english_ref": 20,
      "combined_translation": "20-26"
    },
    {
      "verse": 26,
      "sanskrit": "ऋषीनभ्यर्चयामासुः करानुद्यम्य दक्षिणान्। स तैः परिवृतो राजा नक्षत्रैरिव चन्द्रमाः। अभ्याजगाम गाङ्गेयं ब्रह्माणमिव वासवः॥२६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 53,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
