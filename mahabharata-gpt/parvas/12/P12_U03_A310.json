  "adhyaya_name": "दशाधिकत्रिशततमोऽध्यायः",
  "chapter": 310,
  "verse_count": 26,
  "verses": [
    {
      "verse": 1,
      "sanskrit": "युधिष्ठिर उवाच।\n              धर्माधर्मविमुक्तं यद्विमुक्तं सर्वसंशयात्। जन्ममृत्युविमुक्तं च विमुक्तं पुण्यपापयोः॥१॥",
      "english": "You should, O grandfather, describe to me what is freed from duty and its reverse, what is freed from every doubt, what is above birth and death, as also virtue and sin, what is auspiciousness, what is eternal fearlessness, what is Eternal and Indestructible, and Immutable, what is always Pure, and what is ever free from exertion.",
      "bhavadeepa": null,
      "chapter": 310,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "मोक्षधर्मपर्व",
      "adhyaya_name": "दशाधिकत्रिशततमोऽध्यायः",
      "combined_translation": "1-2"
    },
    {
      "verse": 2,
      "sanskrit": "यच्छिवं नित्यमभयं नित्यमक्षरमव्ययम्। शुचि नित्यमनायासं तद्भवान्वक्तुमर्हति॥२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 310,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "मोक्षधर्मपर्व",
      "adhyaya_name": "दशाधिकत्रिशततमोऽध्यायः",
      "english_ref": 1,
      "combined_translation": "1-2"
    },
    {
      "verse": 3,
      "sanskrit": "भीष्म उवाच।\n              अत्र ते वर्तयिष्यामि इतिहासं पुरातनम्। याज्ञवल्क्यस्य संवादं जनकस्य च भारत॥३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 310,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "मोक्षधर्मपर्व",
      "adhyaya_name": "दशाधिकत्रिशततमोऽध्यायः",
      "english_ref": 2,
      "combined_translation": "2-3"
    },
    {
      "verse": 4,
      "sanskrit": "याज्ञवल्क्यमृषिश्रेष्ठं दैवरातिर्महायशाः। पप्रच्छ जनको राजा प्रश्नं प्रश्नविदां वरम्॥४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 310,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "मोक्षधर्मपर्व",
      "adhyaya_name": "दशाधिकत्रिशततमोऽध्यायः",
      "english_ref": 2,
      "combined_translation": "2-4"
    },
    {
      "verse": 5,
      "sanskrit": "जनक उवाच । कतीन्द्रियाणि विप्रर्षे कति प्रकृतयः स्मृताः। किमव्यक्तं परं ब्रह्म तस्माच्च परतस्तु किम्॥५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 310,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "मोक्षधर्मपर्व",
      "adhyaya_name": "दशाधिकत्रिशततमोऽध्यायः",
      "english_ref": 3,
      "combined_translation": "3-6"
    },
    {
      "verse": 6,
      "sanskrit": "प्रभवं चाप्ययं चैव कालसंख्यां तथैव च। वक्तुमर्हसि विप्रेन्द्र त्वदनुग्रहकाङ्क्षिणः॥६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 310,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "मोक्षधर्मपर्व",
      "adhyaya_name": "दशाधिकत्रिशततमोऽध्यायः",
      "english_ref": 3,
      "combined_translation": "3-6"
    },
    {
      "verse": 7,
      "sanskrit": "अज्ञानात्परिपृच्छामि त्वं हि ज्ञानमयो निधिः। तदहं श्रोतुमिच्छामि सर्वमेतदसंशयम्॥७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 310,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "मोक्षधर्मपर्व",
      "adhyaya_name": "दशाधिकत्रिशततमोऽध्यायः",
      "english_ref": 4,
      "combined_translation": "4-7"
    },
    {
      "verse": 8,
      "sanskrit": "याज्ञवल्क्य उवाच । श्रूयतामवनीपाल यदेतदनुपृच्छसि। योगानां परमं ज्ञानं सांख्यानां च विशेषतः॥८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 310,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "मोक्षधर्मपर्व",
      "adhyaya_name": "दशाधिकत्रिशततमोऽध्यायः",
      "english_ref": 5,
      "combined_translation": "5-8"
    },
    {
      "verse": 9,
      "sanskrit": "न तवाविदितं किञ्चिन्मां तु जिज्ञासते भवान्। पृष्टेन चापि वक्तव्यमेष धर्मः सनातनः॥९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 310,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "मोक्षधर्मपर्व",
      "adhyaya_name": "दशाधिकत्रिशततमोऽध्यायः",
      "english_ref": 6,
      "combined_translation": "6-9"
    },
    {
      "verse": 10,
      "sanskrit": "अष्टौ प्रकृतयः प्रोक्ता विकाराश्चापि षोडश। तत्र तु प्रकृतीरष्टौ प्राहुरध्यात्मचिन्तकाः॥१०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 310,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "मोक्षधर्मपर्व",
      "adhyaya_name": "दशाधिकत्रिशततमोऽध्यायः",
      "english_ref": 7,
      "combined_translation": "7-10"
    },
    {
      "verse": 11,
      "sanskrit": "अव्यक्तं च महान्तं च तथाऽहङ्कार एव च। पृथिवी वायुराकाशमापो ज्योतिश्च पञ्चमम्॥११॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 310,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "मोक्षधर्मपर्व",
      "adhyaya_name": "दशाधिकत्रिशततमोऽध्यायः",
      "english_ref": 8,
      "combined_translation": "8-13"
    },
    {
      "verse": 12,
      "sanskrit": "एताः प्रकृतयस्त्वष्टौ विकारानपि मे शृणु। श्रोत्रं त्वक्चैव चक्षुश्च जिह्वा घ्राणं च पञ्चमम्॥१२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 310,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "मोक्षधर्मपर्व",
      "adhyaya_name": "दशाधिकत्रिशततमोऽध्यायः",
      "english_ref": 8,
      "combined_translation": "8-13"
    },
    {
      "verse": 13,
      "sanskrit": "शब्दः स्पर्शश्च रूपं च रसो गन्धस्तथैव च। वाक्च हस्तौ च पादौ च पायुर्मेढ्रं तथैव च॥१३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 310,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "मोक्षधर्मपर्व",
      "adhyaya_name": "दशाधिकत्रिशततमोऽध्यायः",
      "english_ref": 8,
      "combined_translation": "8-13"
    },
    {
      "verse": 14,
      "sanskrit": "एते विशेषा राजेन्द्र महाभूतेषु पञ्चसु। बुद्धीन्द्रियाण्यथैतानि सविशेषाणि मैथिल॥१४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 310,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "मोक्षधर्मपर्व",
      "adhyaya_name": "दशाधिकत्रिशततमोऽध्यायः",
      "english_ref": 9,
      "combined_translation": "9-14"
    },
    {
      "verse": 15,
      "sanskrit": "मनः षोडशकं प्राहुरध्यात्मगतिचिन्तकाः। त्वं चैवान्ये च विद्वांसस्तत्त्वबुद्धिविशारदाः॥१५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 310,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "मोक्षधर्मपर्व",
      "adhyaya_name": "दशाधिकत्रिशततमोऽध्यायः",
      "english_ref": 10,
      "combined_translation": "10-15"
    },
    {
      "verse": 16,
      "sanskrit": "अव्यक्ताश्च महानात्मा समुत्पद्यति पार्थिव। प्रथमं सर्गमित्येतदाहुः प्राधानिकं बुधाः॥१६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 310,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "मोक्षधर्मपर्व",
      "adhyaya_name": "दशाधिकत्रिशततमोऽध्यायः",
      "english_ref": 11,
      "combined_translation": "11-16"
    },
    {
      "verse": 17,
      "sanskrit": "महतश्चाप्यहङ्कार उत्पन्नो हि नराधिप। द्वितीयं सर्गमित्याहुरेतद्बुद्ध्यात्मकं स्मृतम्॥१७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 310,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "मोक्षधर्मपर्व",
      "adhyaya_name": "दशाधिकत्रिशततमोऽध्यायः",
      "english_ref": 12,
      "combined_translation": "12-17"
    },
    {
      "verse": 18,
      "sanskrit": "अहङ्काराच्च संभूतं मनो भूतगुणात्मकम्। तृतीयः सर्ग इत्येष आहङ्कारिक उच्यते॥१८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 310,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "मोक्षधर्मपर्व",
      "adhyaya_name": "दशाधिकत्रिशततमोऽध्यायः",
      "english_ref": 13,
      "combined_translation": "13-18"
    },
    {
      "verse": 19,
      "sanskrit": "मनसस्तु समुद्भूता महाभूता नराधिप। चतुर्थं सर्गमित्येतन्मानसं विद्धि मे मतम्॥१९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 310,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "मोक्षधर्मपर्व",
