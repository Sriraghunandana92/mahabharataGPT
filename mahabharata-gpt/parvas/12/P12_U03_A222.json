{
  "adhyaya_id": "P12_U03_A222",
  "book": 12,
  "parva_name": "शान्तिपर्व",
  "upaparva_name": "मोक्षधर्मपर्व",
  "adhyaya_name": "द्वाविंशत्यधिकद्विशततमोऽध्यायः",
  "chapter": 222,
  "verse_count": 37,
  "verses": [
    {
      "verse": 1,
      "sanskrit": "युधिष्ठिर उवाच।\n              यदिदं कर्म लोकेऽस्मिन् शुभं वा यदि वा शुभम् । पुरुषं योजयत्येव फलयोगेन भारता ॥१॥",
      "english": "Yudhisthira said In this world, O Bharata, good and bad acts attach themselves to man for the purpose of producing fruits for enjoyment or endurance.",
      "bhavadeepa": null,
      "chapter": 222,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "मोक्षधर्मपर्व",
      "adhyaya_name": "द्वाविंशत्यधिकद्विशततमोऽध्यायः",
      "combined_translation": "1-1"
    },
    {
      "verse": 2,
      "sanskrit": "कर्ताऽस्ति तस्य पुरुष उताहो नेति संशयः । एतदिच्छामि तत्त्वेन त्वत्तः श्रोतुं पितामह ॥२॥",
      "english": "Is man, however, to be regarded as their doer or is he not to be considered so? My mind is full of doubts regarding this question. I wish to hear this fully from you, O grandfather.",
      "bhavadeepa": null,
      "chapter": 222,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "मोक्षधर्मपर्व",
      "adhyaya_name": "द्वाविंशत्यधिकद्विशततमोऽध्यायः",
      "combined_translation": "2-2"
    },
    {
      "verse": 3,
      "sanskrit": "भीष्म उवाच।\n              अत्राप्युदाहरन्तीममितिहासं पुरातनम् । प्रह्लादस्य च संवादमिन्द्रस्य च युधिष्ठिर ॥३॥",
      "english": "Bhishma said Regarding it, О Yudhisthira, is cited the old discourse between Prahlada and Indra.",
      "bhavadeepa": null,
      "chapter": 222,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "मोक्षधर्मपर्व",
      "adhyaya_name": "द्वाविंशत्यधिकद्विशततमोऽध्यायः",
      "combined_translation": "3-3"
    },
    {
      "verse": 4,
      "sanskrit": "असक्तं धूतपाप्मानं कुले जातं बहुश्रुतम् । अस्तब्धमनहङ्कारं सत्त्वस्थं समये रतम् ॥४॥",
      "english": "The king of the Daityas, viz., Prahlada, was unattached to all worldly objects. His sins had been dissipated. Of respectable parentage, he was endued with great learning. Free from stupefaction and pride, ever pervaded by the quality of goodness, and devoted to various vows, he considered praise and censure in the same light. Endued with self-control he was then passing his time in an empty room. Conversant with the origin and the destruction of all created objects mobile and immobile, he was never angry with things that displeased him and never rejoiced at the acquisition of agreeable objects. He considered equally gold and a clod of earth.",
      "bhavadeepa": null,
      "chapter": 222,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "मोक्षधर्मपर्व",
      "adhyaya_name": "द्वाविंशत्यधिकद्विशततमोऽध्यायः",
      "combined_translation": "4-6"
    },
    {
      "verse": 5,
      "sanskrit": "तुल्यनिन्दास्तुतिं दान्तं शून्यागारनिवासिनम् । चराचराणां भूतानां विदितप्रभवाप्ययम् ॥५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 222,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "मोक्षधर्मपर्व",
      "adhyaya_name": "द्वाविंशत्यधिकद्विशततमोऽध्यायः",
      "english_ref": 4,
      "combined_translation": "4-6"
    },
    {
      "verse": 6,
      "sanskrit": "अक्रुध्यन्तमहष्यन्तमप्रियेषु प्रियेषु च । काञ्चने वाऽथ लोष्ठे वा उभयोः समदर्शनम् ॥६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 222,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "मोक्षधर्मपर्व",
      "adhyaya_name": "द्वाविंशत्यधिकद्विशततमोऽध्यायः",
      "english_ref": 4,
      "combined_translation": "4-6"
    },
    {
      "verse": 7,
      "sanskrit": "आत्मनि श्रेयसि ज्ञाने धीरं निश्चितनिश्चितम् । परावरज्ञं भूतानां सर्वज्ञं समदर्शनम् ॥७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 222,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "मोक्षधर्मपर्व",
      "adhyaya_name": "द्वाविंशत्यधिकद्विशततमोऽध्यायः",
      "english_ref": 5,
      "combined_translation": "5-7"
    },
    {
      "verse": 8,
      "sanskrit": "शक्रः प्रह्लादमासीनमेकान्ते संयतेन्द्रियम् । बुभुत्समानस्तत्प्रज्ञामभिगम्येदमब्रवीत् ॥८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 222,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "मोक्षधर्मपर्व",
      "adhyaya_name": "द्वाविंशत्यधिकद्विशततमोऽध्यायः",
      "english_ref": 6,
      "combined_translation": "6-8"
    },
    {
      "verse": 9,
      "sanskrit": "यैः कश्चित्सम्मतो लोके गुणैः स्यात्पुरुषो नृषु । भवत्यनपगान् सर्वांस्तान्गुणान् लक्षयामहे ॥९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 222,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "मोक्षधर्मपर्व",
      "adhyaya_name": "द्वाविंशत्यधिकद्विशततमोऽध्यायः",
      "english_ref": 7,
      "combined_translation": "7-9"
    },
    {
      "verse": 10,
      "sanskrit": "अथ ते लक्ष्यते बुद्धिः समा बालजनैरिह । आत्मानं मन्यमानः सन् श्रेयेः किमिह मन्यसे ॥१०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 222,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "मोक्षधर्मपर्व",
      "adhyaya_name": "द्वाविंशत्यधिकद्विशततमोऽध्यायः",
      "english_ref": 8,
      "combined_translation": "8-10"
    },
    {
      "verse": 11,
      "sanskrit": "बद्धः पाशैश्च्युतः स्थानाद्द्विषतां वशमागतः । श्रिया विहीनः प्रह्लाद शोचितव्ये न शोचसि ॥११॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 222,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "मोक्षधर्मपर्व",
      "adhyaya_name": "द्वाविंशत्यधिकद्विशततमोऽध्यायः",
      "english_ref": 9,
      "combined_translation": "9-11"
    },
    {
      "verse": 12,
      "sanskrit": "प्रज्ञालाभात्तु दैतेय उताहो धृतिमत्तया । प्रह्लाद सुस्थरूपोऽसि पश्यन् व्यसनमात्मनः ॥१२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 222,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "मोक्षधर्मपर्व",
      "adhyaya_name": "द्वाविंशत्यधिकद्विशततमोऽध्यायः",
      "english_ref": 10,
      "combined_translation": "10-12"
    },
    {
      "verse": 13,
      "sanskrit": "इति संचोदितस्तेन धीरो निश्चितनिश्चयः । उवाच श्लक्ष्णया वाचा स्वां प्रज्ञामनुवर्णयन् ॥१३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 222,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "मोक्षधर्मपर्व",
      "adhyaya_name": "द्वाविंशत्यधिकद्विशततमोऽध्यायः",
      "english_ref": 11,
      "combined_translation": "11-13"
    },
    {
      "verse": 14,
      "sanskrit": "प्रह्लाद उवाच । प्रवृत्तिं च निवृत्तिं च भूतानां यो न बुद्ध्यते । तस्य स्तम्भो भवेद्बाल्यान्नास्ति स्तम्भोऽनुपश्यतः ॥१४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 222,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "मोक्षधर्मपर्व",
      "adhyaya_name": "द्वाविंशत्यधिकद्विशततमोऽध्यायः",
      "english_ref": 12,
      "combined_translation": "12-14"
    },
    {
      "verse": 15,
      "sanskrit": "स्वभावात्सम्प्रवर्तन्ते निवर्तन्ते तथैव च । सर्वे भावास्तथाभावाः पुरुषार्थो न विद्यते ॥१५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 222,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "मोक्षधर्मपर्व",
      "adhyaya_name": "द्वाविंशत्यधिकद्विशततमोऽध्यायः",
      "english_ref": 13,
      "combined_translation": "13-16"
    },
    {
      "verse": 16,
      "sanskrit": "पुरुषार्थस्य चाभावे नास्ति कश्चिच्च कारकः । स्वयं न कुर्वतस्तस्य जातु मानो भवेदिह ॥१६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 222,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "मोक्षधर्मपर्व",
      "adhyaya_name": "द्वाविंशत्यधिकद्विशततमोऽध्यायः",
      "english_ref": 13,
      "combined_translation": "13-16"
    },
    {
      "verse": 17,
      "sanskrit": "यस्तु कर्तारमात्मानं मन्यते साध्वसाधु वा । तस्य दोषवती प्रज्ञा अतत्त्वज्ञेति मे मतिः ॥१७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 222,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "मोक्षधर्मपर्व",
      "adhyaya_name": "द्वाविंशत्यधिकद्विशततमोऽध्यायः",
      "english_ref": 14,
      "combined_translation": "14-17"
    },
    {
      "verse": 18,
      "sanskrit": "यदि स्यात्पुरुषः कर्ता शक्रात्मश्रेयसे ध्रुवम् । आरम्भास्तस्य सिद्ध्येयुर्न तु जातु पराभवेत् ॥१८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 222,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "मोक्षधर्मपर्व",
      "adhyaya_name": "द्वाविंशत्यधिकद्विशततमोऽध्यायः",
      "english_ref": 15,
      "combined_translation": "15-19"
    },
    {
      "verse": 19,
      "sanskrit": "अनिष्टस्य हि निर्वृत्तिरनिवृत्तिः प्रियस्य च । लक्ष्यते यतमानानां पुरुषार्थस्ततः कुतः ॥१९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 222,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "मोक्षधर्मपर्व",
      "adhyaya_name": "द्वाविंशत्यधिकद्विशततमोऽध्यायः",
      "english_ref": 15,
      "combined_translation": "15-19"
    },
    {
      "verse": 20,
      "sanskrit": "अनिष्टस्याभिनिर्वृत्तिमिष्टसंवृत्तिमेव च । अप्रयत्नेन पश्यामः केषाञ्चित्तत्स्वभावतः ॥२०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 222,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "मोक्षधर्मपर्व",
      "adhyaya_name": "द्वाविंशत्यधिकद्विशततमोऽध्यायः",
      "english_ref": 16,
      "combined_translation": "16-20"
    },
    {
      "verse": 21,
      "sanskrit": "प्रतिरूपतराः केचिद्दृश्यन्ते बुद्धिमत्तराः । विरूपेभ्योऽल्पबुद्धिभ्यो लिप्समाना धनागमम् ॥२१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 222,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "मोक्षधर्मपर्व",
      "adhyaya_name": "द्वाविंशत्यधिकद्विशततमोऽध्यायः",
      "english_ref": 17,
      "combined_translation": "17-21"
    },
    {
      "verse": 22,
      "sanskrit": "स्वभावप्रेरिताः सर्वे निविशन्ते गुणा यदा । शुभाशुभास्तदा तत्र कस्य किं मानकारणम् ॥२२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 222,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "मोक्षधर्मपर्व",
      "adhyaya_name": "द्वाविंशत्यधिकद्विशततमोऽध्यायः",
      "english_ref": 19,
      "combined_translation": "19-22"
    },
    {
      "verse": 23,
      "sanskrit": "स्वभावादेव तत्सर्वमिति मे निश्चिता मतिः । आत्मप्रतिष्ठा प्रज्ञा वा मम नास्ति ततोऽन्यथा ॥२३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 222,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "मोक्षधर्मपर्व",
      "adhyaya_name": "द्वाविंशत्यधिकद्विशततमोऽध्यायः",
      "english_ref": 20,
      "combined_translation": "20-23"
    },
    {
      "verse": 24,
      "sanskrit": "कर्मजं त्विह मन्यन्ते फलयोगं शुभाशुभम् । कर्मणां विषयं कृत्स्नमहं वक्ष्यामि तच्छृणु ॥२४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 222,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "मोक्षधर्मपर्व",
      "adhyaya_name": "द्वाविंशत्यधिकद्विशततमोऽध्यायः",
      "english_ref": 21,
      "combined_translation": "21-24"
    },
    {
      "verse": 25,
      "sanskrit": "यथा वेदयते कश्चिदोदनं वायसो ह्यदन् । एवं सर्वाणि कर्माणि स्वभावस्यैव लक्षणम् ॥२५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 222,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "मोक्षधर्मपर्व",
      "adhyaya_name": "द्वाविंशत्यधिकद्विशततमोऽध्यायः",
      "english_ref": 22,
      "combined_translation": "22-25"
    },
    {
      "verse": 26,
      "sanskrit": "विकारानेव यो वेद न वेद प्रकृतिं पराम् । तस्य स्तम्भौ भवेद्बाल्यान्नास्ति स्तम्भोऽनुपश्यतः ॥२६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 222,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "मोक्षधर्मपर्व",
      "adhyaya_name": "द्वाविंशत्यधिकद्विशततमोऽध्यायः",
      "english_ref": 23,
      "combined_translation": "23-26"
    },
    {
      "verse": 27,
      "sanskrit": "स्वभावभाविनो भावान् सर्वानेवेह निश्चयात् । बुद्ध्यमानस्य दर्पो वा मानो वा किं करिष्यति ॥२७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 222,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "मोक्षधर्मपर्व",
      "adhyaya_name": "द्वाविंशत्यधिकद्विशततमोऽध्यायः",
      "english_ref": 24,
      "combined_translation": "24-27"
    },
    {
      "verse": 28,
      "sanskrit": "वेद धर्मविधिं कृत्स्नं भूतानां चाप्यनित्यताम् । तस्माच्छक न शोचामि सर्वं ह्येवेदमन्तवत् ॥२८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 222,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "मोक्षधर्मपर्व",
      "adhyaya_name": "द्वाविंशत्यधिकद्विशततमोऽध्यायः",
      "english_ref": 25,
      "combined_translation": "25-28"
    },
