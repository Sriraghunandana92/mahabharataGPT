  "verse_count": 14,
  "verses": [
    {
      "verse": 1,
      "sanskrit": "नारद उवाचः। आविष्कृतबलं कर्णं श्रुत्वा राजा स मागधः । आह्वयद्द्वैरथेनाजौ जरासन्धो महीपतिः ॥१॥",
      "english": "\"Regarding it is also cited the old story of the verses sung by Janaka, the king of the Videhas, who had so qualified himself as to obtain tranquillity of the soul.",
      "bhavadeepa": null,
      "chapter": 5,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "पञ्चमोध्यायः",
      "combined_translation": "1-2"
    },
    {
      "verse": 2,
      "sanskrit": "तयोः समभवद्युद्धं दिव्यास्त्रविदुषोर्द्वयोः । युधि नानाप्रहरणैरन्योन्यमभिवर्षतोः ॥२॥",
      "english": null,
      "bhavadeepa": "आविष्कृतेति ॥१॥",
      "chapter": 5,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "पञ्चमोध्यायः",
      "english_ref": 1,
      "combined_translation": "1-2"
    },
    {
      "verse": 3,
      "sanskrit": "क्षीणबाणौ विधनुषौ भग्नखड्गौ महीं गतौ । बाहुभिः समसज्जेतामुभावपि बलान्वितौ ॥३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 5,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "पञ्चमोध्यायः",
      "english_ref": 2,
      "combined_translation": "2-3"
    },
    {
      "verse": 4,
      "sanskrit": "बाहुकण्टकयुद्धेन तस्य कर्णोऽथ युध्यतः । बिभेद सन्धिं देहस्य जरया श्लेषितस्य हि ॥४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 5,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "पञ्चमोध्यायः",
      "english_ref": 3,
      "combined_translation": "3-4"
    },
    {
      "verse": 5,
      "sanskrit": "स विकारं शरीरस्य दृष्ट्वा नृपतिरात्मनः । प्रीतोऽस्मीत्यब्रवीत्कर्णं वैरमुत्सृज्य दूरतः ॥५॥",
      "english": null,
      "bhavadeepa": "बाहुकण्टकयुद्धेन बाहुकण्टकं केतकपत्रं तद्वद्यत्र बलिना दुर्बलस्य शरीरं पाट्यते तद्बाहुकण्टकं नाम युद्धम् । यथोक्तम्- ‘एकां जङ्घां पदाऽऽक्रम्य परामुद्यम्य पाट्यते ।  केतकीपत्रवच्छत्रुर्युद्धं तद्बाहुकण्टकम्’ इति ॥ जरासन्धस्य संबन्धी यो देहस्तस्य सन्धिं बिभेद ॥४॥",
      "chapter": 5,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "पञ्चमोध्यायः",
      "english_ref": 4,
      "combined_translation": "4-5"
    },
    {
      "verse": 7,
      "sanskrit": "प्रीत्या ददौ स कर्णाय मालिनीं नगरीमथ । अंगेषु नरशार्दूल स राजाऽऽसीत्सपत्नजित् । पालयामास चम्पां च कर्णः परबलार्दनः । दुर्योधनस्यानुमते तवापि विदितं तथा ॥७॥",
      "english": null,
      "bhavadeepa": "विकारं पाटनरूपम् ॥५॥",
      "chapter": 5,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "पञ्चमोध्यायः",
      "english_ref": 6,
      "combined_translation": "6-7"
    },
    {
      "verse": 8,
      "sanskrit": "एवं शस्त्रप्रतापेन प्रथितः सोऽभवत्क्षितौ । त्वद्धितार्थं सुरेन्द्रेण भिक्षितो वर्मकुण्डले ॥८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 5,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "पञ्चमोध्यायः",
      "english_ref": 7,
      "combined_translation": "7-9"
    },
    {
      "verse": 9,
      "sanskrit": "स दिव्ये सहजे प्रादात्कुण्डले परमार्जिते । सहजं कवचं चापि मोहितो देवमायया ॥९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 5,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "पञ्चमोध्यायः",
      "english_ref": 7,
      "combined_translation": "7-9"
    },
    {
      "verse": 10,
      "sanskrit": "विमुक्तः कुण्डलाभ्यां च सहजेन च वर्मणा । निहतो विजयेनाजौ वासुदेवस्य पश्यतः ॥१०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 5,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "पञ्चमोध्यायः",
      "english_ref": 8,
      "combined_translation": "8-10"
    },
    {
      "verse": 11,
      "sanskrit": "ब्राह्मणस्याभिशापेन रामस्य च महात्मनः । कुन्त्याश्च वरदानेन मायया च शतक्रतोः ॥११॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 5,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "पञ्चमोध्यायः",
      "english_ref": 9,
      "combined_translation": "9-14"
    },
    {
      "verse": 12,
      "sanskrit": "भीष्मावमानात्संख्यायां रथस्यार्धानुकीर्तनात् । शल्यात्तेजोवधाच्चापि वासुदेवनयेन च ॥१२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 5,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "पञ्चमोध्यायः",
      "english_ref": 9,
      "combined_translation": "9-14"
    },
    {
      "verse": 13,
      "sanskrit": "रुद्रस्य देवराजस्य यमस्य वरुणस्य च । कुवेरद्रोणयोश्चैव कृपस्य च महात्मनः ॥१३॥",
      "english": null,
      "bhavadeepa": "रथस्यार्घानुकीर्तनात् शल्याच्च तेजोवधादिति संबन्धः ॥१२॥",
      "chapter": 5,
      "parva_name": "शान्तिपर्व",
