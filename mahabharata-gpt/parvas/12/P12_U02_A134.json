  "chapter": 134,
  "verse_count": 17,
  "verses": [
    {
      "verse": 1,
      "sanskrit": "भीष्म उवाच।\n              अत्र धर्मानुवचनं कीर्तयन्ति पुराविदः । प्रत्यक्षावेव धर्मार्थौ क्षत्रियस्य विजानतः ॥१॥",
      "english": "I have thus described you the Sankhya Philosophy. Listen now to me as I tell you what is Vidya (Knowledge) and what is Avidya (Nescience), one after the other.",
      "bhavadeepa": null,
      "chapter": 134,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "आपद्धर्मपर्व",
      "adhyaya_name": "चतुस्त्रिंशदधिकशततमोऽध्यायः",
      "combined_translation": "1-1"
    },
    {
      "verse": 2,
      "sanskrit": "तत्र न व्यवधातव्यं परोक्षा धर्मयापना । अधर्मो धर्म इत्येतद्यथा वृकपदं तथा ॥२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 134,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "आपद्धर्मपर्व",
      "adhyaya_name": "चतुस्त्रिंशदधिकशततमोऽध्यायः"
    },
    {
      "verse": 3,
      "sanskrit": "धर्माधर्मफले जातु ददर्शेह न कश्चन । बुभूषेद्बलमेवैतत्सर्वं बलवतो वशे ॥३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 134,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "आपद्धर्मपर्व",
      "adhyaya_name": "चतुस्त्रिंशदधिकशततमोऽध्यायः",
      "english_ref": 2,
      "combined_translation": "2-3"
    },
    {
      "verse": 4,
      "sanskrit": "श्रियो बलममात्यांश्च बलवानिह विन्दति । यो ह्यनाढ्यः स पतितस्तदुच्छिष्टं यदल्पकम् ॥४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 134,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "आपद्धर्मपर्व",
      "adhyaya_name": "चतुस्त्रिंशदधिकशततमोऽध्यायः",
      "english_ref": 3,
      "combined_translation": "3-4"
    },
    {
      "verse": 5,
      "sanskrit": "बह्वपथ्यं बलवति न किंचित्क्रियते भयात् । उभौ सत्याधिकारस्थौ त्रायेते महतो भयात् ॥५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 134,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "आपद्धर्मपर्व",
      "adhyaya_name": "चतुस्त्रिंशदधिकशततमोऽध्यायः",
      "english_ref": 4,
      "combined_translation": "4-5"
    },
    {
      "verse": 6,
      "sanskrit": "अतिधर्माद्बलं मन्ये बलाद्धर्मः प्रवर्तते । बले प्रतिष्ठितो धर्मो धरण्यामिव जङ्गमम् ॥६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 134,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "आपद्धर्मपर्व",
      "adhyaya_name": "चतुस्त्रिंशदधिकशततमोऽध्यायः",
      "english_ref": 5,
      "combined_translation": "5-6"
    },
    {
      "verse": 7,
      "sanskrit": "धूमो वायोरिव वशे बलं धर्मोऽनुवर्तते । अनीश्वरो बले धर्मो द्रुमे वल्लीव संश्रिता ॥७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 134,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "आपद्धर्मपर्व",
      "adhyaya_name": "चतुस्त्रिंशदधिकशततमोऽध्यायः",
      "english_ref": 6,
      "combined_translation": "6-7"
    },
    {
      "verse": 8,
      "sanskrit": "वशे बलवतां धर्मः सुखं भोगवतामिव । नास्त्यसाध्यं बलवतां सर्वं बलवतां शुचि ॥८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 134,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "आपद्धर्मपर्व",
