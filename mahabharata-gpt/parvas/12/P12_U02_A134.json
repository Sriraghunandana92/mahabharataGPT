      "english_ref": 7,
      "combined_translation": "7-8"
    },
    {
      "verse": 9,
      "sanskrit": "दुराचारः क्षीणबलः परित्राणं न गच्छति । अथ तस्मादुद्विजते सर्वो लोको वृकादिव ॥९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 134,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "आपद्धर्मपर्व",
