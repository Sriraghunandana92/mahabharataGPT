      "english_ref": 8,
      "combined_translation": "8-9"
    },
    {
      "verse": 10,
      "sanskrit": "अपध्वस्तो ह्यवमतो दुःखं जीवति जीवितम् । जीवितं यदपक्रुष्टं यथैव मरणं तथा ॥१०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 134,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "आपद्धर्मपर्व",
