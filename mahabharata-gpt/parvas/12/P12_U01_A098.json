{
  "adhyaya_id": "P12_U01_A098",
  "book": 12,
  "parva_name": "शान्तिपर्व",
  "upaparva_name": "राजधर्मानुशासनपर्व",
  "adhyaya_name": "अष्टनवतितमोऽध्यायः",
  "chapter": 98,
  "verse_count": 51,
  "verses": [
    {
      "verse": 1,
      "sanskrit": "युधिष्ठिर उवाच।\n              के लोका युध्यमानानां शूराणामनिवर्तिनाम्। भवन्ति निधनं प्राप्य तन्मे ब्रूहि पितामह॥१॥",
      "english": "Yudhisthira said The Vedas, O Bharata, describe Religion, Profit, and Pleasure. Tell me, however, O grand-father, the attainment of which is considered as superior.",
      "bhavadeepa": null,
      "chapter": 98,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "अष्टनवतितमोऽध्यायः",
      "combined_translation": "1-1"
    },
    {
      "verse": 2,
      "sanskrit": "भीष्म उवाच।\n              अत्राप्युदाहरन्तीममितिहासं पुरातनम्। अम्बरीषस्य संवादमिन्द्रस्य च युधिष्ठिर॥२॥",
      "english": "Bhishma said About it I shall recite to you the ancient discourse of the benefit which Kundadhara in days of yore had conferred upon one who was devoted to him.",
      "bhavadeepa": null,
      "chapter": 98,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "अष्टनवतितमोऽध्यायः",
      "combined_translation": "2-3"
    },
    {
      "verse": 3,
      "sanskrit": "अम्बरीषो हि नाभागिः स्वर्गं गत्वा सुदुर्लभम्। ददर्श सुरलोकस्थं शक्रेण सचिवं सह॥३॥",
      "english": "Once on a time a Brahmana shorn of riches tried to win virtue, actuated by the desire of fruit. He continually thought of riches for employing it in the celebration of sacrifices. For gaining his end he engaged in the practice of the austerest penances.",
      "bhavadeepa": null,
      "chapter": 98,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "अष्टनवतितमोऽध्यायः",
      "combined_translation": "3-3"
    },
    {
      "verse": 4,
      "sanskrit": "सर्वतेजोमयं दिव्यं विमानवरमास्थितम्। उपर्युपरि गच्छन्तं स्वं वै सेनापतिं प्रभुम्॥४॥",
      "english": "Determined to achieve his object, he began to adore the gods with great devotion. But he failed to acquire riches by such adoration of the gods.",
      "bhavadeepa": null,
      "chapter": 98,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "अष्टनवतितमोऽध्यायः",
      "combined_translation": "4-4"
    },
    {
      "verse": 5,
      "sanskrit": "स दृष्ट्वोपरि गच्छन्तं सेनापतिमुदारधीः। ऋद्धिं दृष्ट्वा सुदेवस्य विस्मितः प्राह वासवम्॥५॥",
      "english": "He thereupon began to think aside, What is that god, hitherto not worshipped by men, who may be forthwith favourably disposed towards me?",
      "bhavadeepa": null,
      "chapter": 98,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "अष्टनवतितमोऽध्यायः",
      "combined_translation": "5-5"
    },
    {
      "verse": 6,
      "sanskrit": "अम्बरीष उवाच। सागरान्तां महीं कृत्स्नामनुशास्य यथाविधि। चातुर्वर्ण्ये यथाशास्त्रं प्रवृत्तो धर्मकाम्यया॥६॥",
      "english": "While thinking thus with a cool mind, he saw stationed before him that retainer of the gods, viz., the Cloud called Kundadhara.",
      "bhavadeepa": null,
      "chapter": 98,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "अष्टनवतितमोऽध्यायः",
      "combined_translation": "6-9"
    },
    {
      "verse": 7,
      "sanskrit": "ब्रह्मचर्येण घोरेण गुर्वाचारेण सेवया। वेदानधीत्य धर्मेण राजशास्त्रं च केवलम्॥७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 98,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "अष्टनवतितमोऽध्यायः",
      "english_ref": 6,
      "combined_translation": "6-9"
    },
    {
      "verse": 8,
      "sanskrit": "अतिथीनन्नपानेन पितॄंश्च स्वधया तथा। ऋषीन्स्वाध्यायदीक्षाभिर्देवान्यज्ञैरनुत्तमैः॥८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 98,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "अष्टनवतितमोऽध्यायः",
      "english_ref": 6,
      "combined_translation": "6-9"
    },
    {
      "verse": 9,
      "sanskrit": "क्षत्रधर्मे स्थितो भूत्वा यथाशास्त्रं यथाविधि। उदीक्षमाणः पृतनां जयामि युधि वासव॥९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 98,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "अष्टनवतितमोऽध्यायः",
      "english_ref": 6,
      "combined_translation": "6-9"
    },
    {
      "verse": 10,
      "sanskrit": "देवराज सुदेवोऽयं मम सेनापतिः पुरा। आसीद्योधः प्रशान्तात्मा सोऽयं कस्मादतीव माम्॥१०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 98,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "अष्टनवतितमोऽध्यायः",
      "english_ref": 7,
      "combined_translation": "7-10"
    },
    {
      "verse": 11,
      "sanskrit": "अनेन क्रतुभिर्मुख्यैर्नेष्टं नापि द्विजातयः। तर्पिता विधिवच्छक्र सोऽयं कस्मादतीव माम्॥११॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 98,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "अष्टनवतितमोऽध्यायः",
      "english_ref": 8,
      "combined_translation": "8-11"
    },
    {
      "verse": 12,
      "sanskrit": "इन्द्र उवाच। एतस्य विततस्तात सुदेवस्य बभूव ह। संग्रामयज्ञः सुमहान्यश्चान्यो युद्ध्यते नरः॥१२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 98,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "अष्टनवतितमोऽध्यायः",
      "english_ref": 9,
      "combined_translation": "9-12"
    },
    {
      "verse": 13,
      "sanskrit": "सन्नद्धो दीक्षितः सर्वो योधः प्राप्य चमूमुखम्। युद्धयज्ञाधिकारस्थो भवतीति विनिश्चयः॥१३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 98,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "अष्टनवतितमोऽध्यायः",
      "english_ref": 10,
      "combined_translation": "10-13"
    },
    {
      "verse": 14,
      "sanskrit": "अम्बरीष उवाच। कानि यज्ञे हवींष्यस्मिन् किमाज्यं का च दक्षिणा। ऋत्विजश्चात्र के प्रोक्तास्तन्मे ब्रूहि शतक्रतो॥१४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 98,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "अष्टनवतितमोऽध्यायः",
      "english_ref": 11,
      "combined_translation": "11-14"
    },
    {
      "verse": 15,
      "sanskrit": "इन्द्र उवाच। ऋत्विजः कुञ्जरास्तत्र वाजिनोऽध्वर्यवस्तथा। हवींषि परमांसानि रुधिरं त्वाज्यमुच्यते॥१५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 98,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "अष्टनवतितमोऽध्यायः",
      "english_ref": 12,
      "combined_translation": "12-15"
    },
    {
      "verse": 16,
      "sanskrit": "शृगाल-गृध्र-काकोला: सदस्यास्तत्र पत्रिणः। आज्यशेषं पिबन्त्येते हविः प्राश्नन्ति चाध्वरे॥१६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 98,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "अष्टनवतितमोऽध्यायः",
      "english_ref": 13,
      "combined_translation": "13-16"
    },
    {
      "verse": 17,
      "sanskrit": "प्रास तोमरसंघाताः खड्ग-शक्ति-परश्वधाः। ज्वलन्तो निशिताः पीताः स्रुचस्तस्याथ सत्रिणः॥१७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 98,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "अष्टनवतितमोऽध्यायः",
      "english_ref": 14,
      "combined_translation": "14-17"
    },
    {
      "verse": 18,
      "sanskrit": "चापवेगायतस्तीक्ष्णः परकायावभेदनः। ऋजुः सुनिशितः पीतः सायकश्च स्रुवो महान्॥१८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 98,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "अष्टनवतितमोऽध्यायः",
      "english_ref": 15,
      "combined_translation": "15-18"
    },
    {
      "verse": 19,
      "sanskrit": "द्वीपीचर्मावनद्धश्च नागदन्तकृतत्सरुः। हस्तिहस्तहरः खड्गः स्फिग्भवेत्तस्य संयुगे॥१९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 98,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "अष्टनवतितमोऽध्यायः",
      "english_ref": 16,
      "combined_translation": "16-19"
    },
    {
      "verse": 20,
      "sanskrit": "ज्वलितैर्निशितैः प्रासशक्त्यृष्टिसपरश्वधैः। शैक्यायसमयैस्तीक्ष्णैरभिघातो भवेद्वसु॥२०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 98,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "अष्टनवतितमोऽध्यायः",
      "english_ref": 17,
      "combined_translation": "17-20"
    },
    {
      "verse": 21,
      "sanskrit": "संख्यासमयविस्तीर्णमभिजातोद्भवं बहु। आवेगाद्यच्च रुधिरं संग्रामे स्रवते भुवि॥२१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 98,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "अष्टनवतितमोऽध्यायः",
      "english_ref": 18,
      "combined_translation": "18-21"
    },
    {
      "verse": 22,
      "sanskrit": "साऽस्य पूर्णाहुतिर्होमे समृद्धा सर्वकामधुक्। छिन्धि भिन्धीति यः शब्दः श्रूयते वाहिनीमुखे॥२२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 98,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "अष्टनवतितमोऽध्यायः"
    },
    {
      "verse": 23,
      "sanskrit": "सामानि सामगास्तस्य गायन्ति यमसादने। हविर्धानं तु तस्याहुः परेषां वाहिनीमुखम्॥२३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 98,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "अष्टनवतितमोऽध्यायः",
      "english_ref": 19,
      "combined_translation": "19-23"
    },
    {
      "verse": 24,
      "sanskrit": "कुञ्जराणां हयानां च वर्मिणां च समुच्चयः। अग्निः श्येनचितो नाम स च यज्ञे विधीयते॥२४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 98,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "अष्टनवतितमोऽध्यायः",
      "english_ref": 20,
      "combined_translation": "20-24"
    },
    {
      "verse": 25,
      "sanskrit": "उत्तिष्ठते कबन्धोऽत्र सहस्रे निहते तु यः। स यूपस्तस्य शूरस्य खादिरोऽष्टास्त्रिरुच्यते॥२५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 98,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "अष्टनवतितमोऽध्यायः",
      "english_ref": 21,
      "combined_translation": "21-25"
    },
    {
      "verse": 26,
      "sanskrit": "इडोपहूताः क्रोशन्ति कुञ्जरास्त्वंकुशेरिताः। व्याघुष्टतलनादेव वषट्कारेण पार्थिव॥२६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 98,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "अष्टनवतितमोऽध्यायः"
    },
    {
      "verse": 27,
      "sanskrit": "उद्गाता तत्र संग्रामे त्रिसामा दुन्दुभिर्नृप। ब्रह्मस्वे ह्रियमाणे तु त्यक्त्वा युद्धे प्रियां तनुम्॥२७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 98,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "अष्टनवतितमोऽध्यायः",
      "english_ref": 23,
      "combined_translation": "23-27"
    },
    {
      "verse": 28,
      "sanskrit": "आत्मानं यूपमुत्सृज्य स यज्ञोऽनन्तदक्षिणः। भर्तुरर्थे च यः शूरो विक्रमेद्वाहिनीमुखे॥२८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 98,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "अष्टनवतितमोऽध्यायः",
      "english_ref": 25,
      "combined_translation": "25-28"
    },
    {
      "verse": 29,
      "sanskrit": "न भयाद्विनिवर्तेत तस्य लोका यथा मम। नीलचर्मावृतैः खड्गैर्बाहुभिः परिघोपमैः॥२९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 98,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "अष्टनवतितमोऽध्यायः"
    },
    {
      "verse": 30,
