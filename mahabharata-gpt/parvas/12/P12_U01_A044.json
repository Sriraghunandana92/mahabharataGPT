  "verses": [
    {
      "verse": 1,
      "sanskrit": "वैशम्पायन उवाच।\n              ततो विसर्जयामास सर्वाः प्रकृतयो नृपः । विविशुश्चाभ्यनुज्ञाता यथास्वानि गृहाणि ते ॥१॥",
      "english": "Bhishma said 'He does not know Brahma who does not know the four topics, namely, dreams, dreamless sleep, immanent, and transcendent Brahma, as also what is Manifest (viz., the body), and what is Unmanifest (the intelligence-soul), which the great Rishi (Narayana) has described as Tattvam (pure principle).",
      "bhavadeepa": null,
      "chapter": 44,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "चतुश्चत्वारिंशत्तमोऽध्यायः",
      "combined_translation": "1-1"
    },
    {
      "verse": 2,
      "sanskrit": "ततो युधिष्ठिरो राजा भीमं भीमपराक्रमम् । सान्त्वयन्नब्रवीच्छ्रीमानर्जुनं यमजौ तथा ॥२॥",
      "english": "That which is manifest is subject to death. That which is unmanifest transcends, death. The Rishi Narayana has described the religion of inclination.",
      "bhavadeepa": "तत इति । विस्पष्टार्थः ॥१॥",
      "chapter": 44,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "चतुश्चत्वारिंशत्तमोऽध्यायः",
      "combined_translation": "2-3"
    },
    {
      "verse": 3,
      "sanskrit": "शत्रुभिर्विविधैः शस्त्रैः क्षतदेहा महारणे । श्रान्ता भवन्तः सुभृशं तापिताः शोकमन्युभिः ॥३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 44,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "चतुश्चत्वारिंशत्तमोऽध्यायः",
      "english_ref": 2,
      "combined_translation": "2-3"
    },
    {
      "verse": 4,
      "sanskrit": "अरण्ये दुःखवसतीर्मत्कृते भरतर्षभाः । भवद्भिरनुभूता हि यथा कुपुरुषैस्तथा ॥४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 44,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "चतुश्चत्वारिंशत्तमोऽध्यायः",
      "english_ref": 3,
      "combined_translation": "3-4"
    },
    {
      "verse": 5,
      "sanskrit": "यथासुखं यथाजोषं जयोऽयमनुभूयताम् । विश्रान्ताल्लंब्यविज्ञानान् श्वः समेताऽस्मि वः पुनः ॥५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 44,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
