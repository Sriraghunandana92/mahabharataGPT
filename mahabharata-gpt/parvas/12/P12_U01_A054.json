{
  "adhyaya_id": "P12_U01_A054",
  "book": 12,
  "parva_name": "शान्तिपर्व",
  "upaparva_name": "राजधर्मानुशासनपर्व",
  "adhyaya_name": "चतुःपञ्चाशत्तमोऽध्यायः",
  "chapter": 54,
  "verse_count": 39,
  "verses": [
    {
      "verse": 1,
      "sanskrit": "जनमेजय उवाच।\n              धर्मात्मनि महावीर्ये सत्यसन्धे जितात्मनि। देवव्रते महाभागे शरतल्पगतेऽच्युते॥१॥",
      "english": "Yudhisthira said What, indeed, is good for a man who is sunk in dire distress, consequent on the loss of friends or kingdom, O king.",
      "bhavadeepa": null,
      "chapter": 54,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "चतुःपञ्चाशत्तमोऽध्यायः",
      "combined_translation": "1-3"
    },
    {
      "verse": 2,
      "sanskrit": "शयाने वीरशयने भीष्मे शान्तनुनन्दने। गाङ्गेये पुरुषव्याघ्र पाण्डवैः पर्युपासिते॥२॥",
      "english": null,
      "bhavadeepa": "धर्मात्मनीति ॥१॥",
      "chapter": 54,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "चतुःपञ्चाशत्तमोऽध्यायः",
      "english_ref": 1,
      "combined_translation": "1-3"
    },
    {
      "verse": 3,
      "sanskrit": "काः कथाः समवर्तन्त तस्मिन् वीरसमागमे। हतेषु सर्वसैन्येषु तन्मे शंस महामुने॥३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 54,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "चतुःपञ्चाशत्तमोऽध्यायः",
      "english_ref": 1,
      "combined_translation": "1-3"
    },
    {
      "verse": 4,
      "sanskrit": "वैशम्पायन उवाच।\n              शरतल्पगते भीष्मे कौरवाणां धुरन्धरे। आजग्मुर्ऋषयः सिद्धा नारदप्रमुखा नृप॥४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 54,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "चतुःपञ्चाशत्तमोऽध्यायः",
      "english_ref": 2,
      "combined_translation": "2-4"
    },
    {
      "verse": 5,
      "sanskrit": "हतशिष्टाश्च राजानो युधिष्ठिरपुरोगमाः। धृतराष्ट्रश्च कृष्णश्च भीमार्जुनयमास्तथा॥५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 54,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "चतुःपञ्चाशत्तमोऽध्यायः",
      "english_ref": 3,
      "combined_translation": "3-5"
    },
    {
      "verse": 6,
      "sanskrit": "तेऽभिगम्य महात्मानो भरतानां पितामहम्। अन्वशोचन्त गाङ्गेयमादित्यं पतितं यथा॥६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 54,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "चतुःपञ्चाशत्तमोऽध्यायः",
      "english_ref": 5,
      "combined_translation": "5-6"
    },
    {
      "verse": 7,
      "sanskrit": "मुहूर्तमिव च ध्यात्वा नारदो देवदर्शनः। उवाच पाण्डवान् सर्वान् हतशिष्टांश्च पार्थिवान्॥७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 54,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "चतुःपञ्चाशत्तमोऽध्यायः",
      "english_ref": 6,
      "combined_translation": "6-8"
    },
    {
      "verse": 8,
      "sanskrit": "प्राप्तकालं समाचक्षे भीष्मोऽयमनुयुज्यताम्। अस्तमेति हि गाङ्गेयो भानुमानिव भारत॥८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 54,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "चतुःपञ्चाशत्तमोऽध्यायः",
      "english_ref": 6,
      "combined_translation": "6-8"
    },
    {
      "verse": 9,
      "sanskrit": "अयं प्राणानुत्सिसृक्षुस्तं सर्वेऽभ्यनुपृच्छत। कृत्स्नात् विविधान्धर्मांश्चातुर्वर्ण्यस्य वेत्त्ययम्॥९॥",
      "english": null,
      "bhavadeepa": "समाचक्षे ब्रवीमि अनुयुज्यतां पृच्छताम् ॥८॥",
      "chapter": 54,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "चतुःपञ्चाशत्तमोऽध्यायः",
      "english_ref": 7,
      "combined_translation": "7-9"
    },
    {
      "verse": 10,
      "sanskrit": "एष वृद्धः परान्लोकान्सम्प्राप्नोति तनुं त्यजन्। तं शीघ्रमनुयुजीध्वं संशयान् मनसि स्थितान्॥१०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 54,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "चतुःपञ्चाशत्तमोऽध्यायः",
      "english_ref": 8,
      "combined_translation": "8-10"
    },
    {
      "verse": 11,
      "sanskrit": "वैशम्पायन उवाच।\n              एवमुक्ते नारदेन भीष्ममीयुर्नराधिपः। प्रष्टुं चाशक्नुवन्तस्ते वीक्षां चक्रुः परस्परम्॥११॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 54,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "चतुःपञ्चाशत्तमोऽध्यायः",
      "english_ref": 9,
      "combined_translation": "9-11"
    },
    {
      "verse": 12,
      "sanskrit": "अथोवाच हृषीकेशं पाण्डुपुत्रो युधिष्ठिरः। नान्यस्तु देवकीपुत्राच्छक्तः प्रष्टुं पितामहम्॥१२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 54,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "चतुःपञ्चाशत्तमोऽध्यायः",
      "english_ref": 10,
      "combined_translation": "10-12"
    },
    {
      "verse": 13,
      "sanskrit": "प्रव्याहर यदुश्रेष्ठ त्वमग्रे मधुसूदन। त्वं हि नस्तात सर्वेषां सर्वधर्मविदुत्तमः॥१३॥",
      "english": null,
      "bhavadeepa": "ततः उवाचेति छेदः ॥१२॥",
      "chapter": 54,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "चतुःपञ्चाशत्तमोऽध्यायः",
      "english_ref": 11,
      "combined_translation": "11-13"
    },
    {
      "verse": 14,
      "sanskrit": "एवमुक्तः पाण्डवेन भगवान् केशवस्तदा। अभिगम्य दुराधर्षं प्रव्याहारयदच्युतः॥१४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 54,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "चतुःपञ्चाशत्तमोऽध्यायः",
      "english_ref": 12,
      "combined_translation": "12-14"
    },
    {
      "verse": 15,
      "sanskrit": "वासुदेव उवाच। कच्चित्सुखेन रजनी व्युष्टा ते राजसत्तम। विस्पष्टलक्षणा बुद्धिः कच्चिच्चोपस्थिता तव॥१५॥",
      "english": null,
      "bhavadeepa": "प्रव्याहारयत् अवाचयत् ॥१४॥",
      "chapter": 54,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "चतुःपञ्चाशत्तमोऽध्यायः",
      "english_ref": 13,
      "combined_translation": "13-15"
    },
    {
      "verse": 16,
      "sanskrit": "कच्चिज्ज्ञानानि सर्वाणि प्रतिभान्ति च तेऽनघ। न ग्लायते च हृदयं न च ते व्याकुलं मनः॥१६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 54,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "चतुःपञ्चाशत्तमोऽध्यायः",
      "english_ref": 14,
      "combined_translation": "14-16"
    },
    {
      "verse": 17,
      "sanskrit": "भीष्म उवाच।\n              दाहो मोहः श्रमश्चैव क्लमो ग्लानिस्तथा रुजा। तव प्रसादाद्वार्ष्णेय सद्यः प्रतिगतानि मे॥१७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 54,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "चतुःपञ्चाशत्तमोऽध्यायः",
      "english_ref": 15,
      "combined_translation": "15-17"
    },
    {
      "verse": 18,
      "sanskrit": "यच्च भूतं भविष्यच्च भवच्च परमद्युते। तत्सर्वमनुपश्यामि पाणौ फलमिवार्पितम्॥१८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 54,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "चतुःपञ्चाशत्तमोऽध्यायः",
      "english_ref": 16,
      "combined_translation": "16-18"
    },
    {
      "verse": 19,
      "sanskrit": "वेदोक्ताश्चैव ये धर्मा वेदान्ताधिगताश्च ये। तान्सर्वान्सम्प्रपश्यामि वरदानात्तवाच्युत॥१९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 54,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "चतुःपञ्चाशत्तमोऽध्यायः",
      "english_ref": 17,
      "combined_translation": "17-19"
    },
    {
      "verse": 20,
      "sanskrit": "शिष्टैश्च धर्मो यः प्रोक्तः स च मे हृदि वर्तते। देशजातिकुलानां च धर्मज्ञोऽस्मि जनार्दन॥२०॥",
      "english": null,
      "bhavadeepa": "वेदोक्ताः अग्निहोत्रादयः वेदान्ताधिगताः शमदमसंन्यासादयः ॥१९॥",
      "chapter": 54,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "चतुःपञ्चाशत्तमोऽध्यायः",
      "english_ref": 18,
      "combined_translation": "18-20"
    },
    {
      "verse": 21,
      "sanskrit": "चतुर्ष्वाश्रमधर्मेषु योऽर्थः स च हृदि स्थितः। राजधर्मांश्च सकलानवगच्छामि केशव॥२१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 54,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "चतुःपञ्चाशत्तमोऽध्यायः",
      "english_ref": 19,
      "combined_translation": "19-21"
    },
    {
      "verse": 22,
      "sanskrit": "यच्च यत्र च वक्तव्यं तद्वक्ष्यामि जनार्दन। तव प्रसादाद्धि शुभा मनो मे बुद्धिराविशत्॥२२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 54,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "चतुःपञ्चाशत्तमोऽध्यायः",
      "english_ref": 20,
      "combined_translation": "20-22"
    },
    {
      "verse": 23,
      "sanskrit": "युवेवास्मि समावृत्तस्त्वदनुध्यानबृंहितः। वक्तुं श्रेयः समर्थोऽस्मि त्वत्प्रसादाज्जनार्दन॥२३॥",
      "english": null,
      "bhavadeepa": "मे मम मनः कर्म बुद्धिराविशत् ॥२२॥",
      "chapter": 54,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "चतुःपञ्चाशत्तमोऽध्यायः",
      "english_ref": 21,
      "combined_translation": "21-23"
    },
    {
      "verse": 24,
      "sanskrit": "स्वयं किमर्थं तु भवाश्रेयो न प्राह पाण्डवम्। किं ते विवक्षितं चात्र तदाशु वद माधव॥२४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 54,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "चतुःपञ्चाशत्तमोऽध्यायः",
      "english_ref": 22,
      "combined_translation": "22-24"
    },
    {
      "verse": 25,
      "sanskrit": "वासुदेव उवाच। यशसः श्रेयसंश्चैव मूलं मां विद्धि कौरव। मत्तः सर्वेऽभिनिर्वृत्ता भावाः सदसदात्मकाः॥२५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 54,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "चतुःपञ्चाशत्तमोऽध्यायः",
      "english_ref": 23,
      "combined_translation": "23-25"
    },
    {
      "verse": 26,
      "sanskrit": "शीतांशुश्चन्द्र इत्युक्ते लोके को विस्पयिष्यति। तथैव यशसा पूर्णे मयि को विस्मयिष्यति॥२६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 54,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "चतुःपञ्चाशत्तमोऽध्यायः",
      "english_ref": 24,
      "combined_translation": "24-26"
    },
    {
      "verse": 27,
      "sanskrit": "आधेयं तु मया भूयो यशस्तव महाद्युते। ततो मे विपुला बुद्धिस्त्वयि भीष्म समर्पिता॥२७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 54,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "चतुःपञ्चाशत्तमोऽध्यायः",
      "english_ref": 25,
      "combined_translation": "25-27"
    },
    {
      "verse": 28,
      "sanskrit": "याबद्धि पृथिवीपाल पृथ्वीयं स्थास्यति ध्रुवा। तावत्तवाक्षया कीर्तिर्लोकाननुचरिष्यति॥२८॥",
      "english": null,
      "bhavadeepa": "मे मया ॥२७॥",
      "chapter": 54,
