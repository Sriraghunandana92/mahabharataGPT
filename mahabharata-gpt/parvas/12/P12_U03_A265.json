      "english_ref": 8,
      "combined_translation": "8-9"
    },
    {
      "verse": 10,
      "sanskrit": "मानान्मोहाच्च लोभाच्च लौल्यमेतत्प्रकल्पितम् । विष्णुमेवाभिजानन्ति सर्वयज्ञेषु ब्राह्मणाः ॥१०॥",
      "english": null,
