      "english_ref": 5,
      "combined_translation": "5-6"
    },
    {
      "verse": 7,
      "sanskrit": "उपोष्य संशितो भूत्वा हित्वा वेदकृताः श्रुतीः । आचार इत्यनाचारः कृपणाः फलहेतवः ॥७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 265,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "मोक्षधर्मपर्व",
      "adhyaya_name": "पञ्चषष्ट्यधिकद्विशततमोऽध्यायः",
      "english_ref": 6,
      "combined_translation": "6-7"
    },
    {
      "verse": 8,
      "sanskrit": "यदि यज्ञांश्च वृक्षांश्च यूपांश्चोद्दिश्य मानवाः । वृथा मांसं न खादन्ति नैष धर्मः प्रशस्यते ॥८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 265,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "मोक्षधर्मपर्व",
      "adhyaya_name": "पञ्चषष्ट्यधिकद्विशततमोऽध्यायः",
      "english_ref": 7,
      "combined_translation": "7-8"
    },
    {
      "verse": 9,
      "sanskrit": "सुरा मत्स्या मधु मासंमासवं कृसरौदनम् । धूर्तैः प्रवर्तितं ह्येतन्नैतद्वेदेषु कल्पितम् ॥९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 265,
