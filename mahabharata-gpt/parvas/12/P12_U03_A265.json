      "english_ref": 9,
      "combined_translation": "9-10"
    },
    {
      "verse": 11,
      "sanskrit": "पायसैः सुमनोभिश्च तस्यापि यजनं स्मृतम् । यज्ञियाश्चैव ये वृक्षा वेदेषु परिकल्पिताः ॥११॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 265,
