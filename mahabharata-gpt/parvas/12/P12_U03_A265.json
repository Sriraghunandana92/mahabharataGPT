      "english_ref": 10,
      "combined_translation": "10-12"
    },
    {
      "verse": 12,
      "sanskrit": "यच्चापि किंचित्कर्तव्यमन्यच्चोक्षैः सुसंस्कृतम् । महत्सत्त्वैः शुद्धभावैः सर्वं देवार्हमेव तत् ॥१२॥",
      "english": null,
