  "verses": [
    {
      "verse": 1,
      "sanskrit": "भीष्म उवाच।\n              अत्राप्युदाहरन्तीममितिहासं पुरातनम् । प्रजारनामनुकम्पार्थं गीतं राज्ञा विचख्नुना ॥१॥",
      "english": "Bhishma said Regarding it is cited an old discourse of what was recited by king Vicharakhu through pity for all creatures.",
      "bhavadeepa": null,
      "chapter": 265,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "मोक्षधर्मपर्व",
      "adhyaya_name": "पञ्चषष्ट्यधिकद्विशततमोऽध्यायः",
      "combined_translation": "1-1"
    },
    {
      "verse": 2,
      "sanskrit": "छिन्नस्थूणं वृषं दृष्ट्वा विलापं च गवां भृशम् । गोग्रहे यज्ञवाटस्य प्रेक्षमाणः स पार्थिवः ॥२॥",
      "english": "Seeing the mangled body of a bull, and hearing the highly painful groans of the kine in a cow-killing sacrifice, and observing the cruel Brahmanas collected there for assisting at the ceremonies, that king said these words:Prosperity to all the kine in the world!-When the slaughter had begun, these",
      "bhavadeepa": null,
      "chapter": 265,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "मोक्षधर्मपर्व",
      "adhyaya_name": "पञ्चषष्ट्यधिकद्विशततमोऽध्यायः",
      "combined_translation": "2-3"
    },
    {
      "verse": 3,
      "sanskrit": "स्वस्ति गोभ्योऽस्तु लोकेषु ततो निर्वचनं कृतम् । हिंसायां हि प्रवृत्तायामाशीरेषा तु कल्पिता ॥३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 265,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "मोक्षधर्मपर्व",
      "adhyaya_name": "पञ्चषष्ट्यधिकद्विशततमोऽध्यायः",
      "english_ref": 2,
      "combined_translation": "2-3"
    },
    {
      "verse": 4,
      "sanskrit": "अव्यवस्थितमर्यादैर्विमूढैर्नास्तिकैनरैः । संशयात्मभिरव्यक्तैर्हिंसा समनुवर्णिता ॥४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 265,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "मोक्षधर्मपर्व",
      "adhyaya_name": "पञ्चषष्ट्यधिकद्विशततमोऽध्यायः",
      "english_ref": 3,
      "combined_translation": "3-4"
    },
    {
      "verse": 5,
      "sanskrit": "सर्वकर्मस्वहिंसा हि धर्मात्मा मनुरब्रवीत् । कामकाराद्विहिंसन्ति बहिर्वेद्यां पशून्नराः ॥५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 265,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "मोक्षधर्मपर्व",
      "adhyaya_name": "पञ्चषष्ट्यधिकद्विशततमोऽध्यायः",
      "english_ref": 4,
      "combined_translation": "4-5"
    },
    {
      "verse": 6,
      "sanskrit": "तस्मात्प्रमाणतः कार्यो धर्मः सूक्ष्मो विजानता । अहिंसा सर्वभूतेभ्यो धर्मेभ्यो ज्यायसी मता ॥६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 265,
