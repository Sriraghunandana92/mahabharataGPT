      "combined_translation": "15-20"
    },
    {
      "verse": 21,
      "sanskrit": "जम्बूद्वीपो महाराज नानाजनपदैर्युतः । त्वया पुरुषशार्दूल दण्डेन मृदितः प्रभो ॥२१॥",
      "english": null,
