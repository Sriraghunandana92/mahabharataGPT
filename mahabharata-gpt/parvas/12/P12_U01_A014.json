{
  "adhyaya_id": "P12_U01_A014",
  "book": 12,
  "parva_name": "शान्तिपर्व",
  "upaparva_name": "राजधर्मानुशासनपर्व",
  "adhyaya_name": "चतुर्दशोध्यायः",
  "chapter": 14,
  "verse_count": 39,
  "verses": [
    {
      "verse": 1,
      "sanskrit": "वैशम्पायन उवाच।\n              अव्याहरति कौन्तेये धर्मराजे युधिष्ठिरे । भ्रातॄणां ब्रुवतां तांस्तान् विविधान् वेद‌निश्चयान् ॥१॥",
      "english": "Bhrigu said The living creature, or what is given, or our other acts, are never destroyed. The death of a creature is only a change of form. The body alone is dissolved.",
      "bhavadeepa": "भक्त्यैव भाषितं न तु ज्ञानगर्वेण ॥१३॥",
      "chapter": 14,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "चतुर्दशोध्यायः",
      "combined_translation": "1-1"
    },
    {
      "verse": 2,
      "sanskrit": "महाभिजनसम्पन्ना श्रीमत्यायतलोचना । अभ्यभाषत राजेन्द्र द्रौपदी योषितां वरा ॥२॥",
      "english": "The living creature, though it depends upon the body, is not destroyed when the body is destroyed. It is not seen after the destroyed. It is not seen after the destruction of the physical body just as fire is not visible after the consumption of the fuel with which it was lighted.",
      "bhavadeepa": "अव्याहरति । वक्तव्याभावान्न तु क्रोधान्मौर्ख्याद्वा ॥१॥",
      "chapter": 14,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "चतुर्दशोध्यायः",
      "combined_translation": "2-3"
    },
    {
      "verse": 3,
      "sanskrit": "आसीनमृषभं राज्ञां भ्रातृभिः परिवारितम् । सिंह-शार्दूलसदृशैर्वारणैरिव यूथपम् ॥३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 14,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "चतुर्दशोध्यायः",
      "english_ref": 2,
      "combined_translation": "2-3"
    },
    {
      "verse": 4,
      "sanskrit": "अभिमानवती नित्यं विशेषेण युधिष्ठिरे । लालिता सततं राज्ञा धर्मज्ञा धर्मदर्शिनी ॥४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 14,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "चतुर्दशोध्यायः",
      "english_ref": 3,
      "combined_translation": "3-5"
    },
    {
      "verse": 5,
      "sanskrit": "आमन्त्र्य विपुलश्रोणी साम्ना परमवल्गुना । भर्तारमभिसम्प्रेक्ष्य ततो वचनमब्रवीत् ॥५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 14,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "चतुर्दशोध्यायः",
      "english_ref": 3,
      "combined_translation": "3-5"
    },
    {
      "verse": 6,
      "sanskrit": "द्रौपद्युवाच । इमे ते भ्रातरः पार्थ शुष्यन्ते स्तोकका इव । वावाश्यमानास्तिष्ठन्ति न चैनानभिनन्दसे ॥६॥",
      "english": null,
      "bhavadeepa": "साम्ना-सान्त्ववादेन । वल्गुना- रमणीयेन ॥५॥",
      "chapter": 14,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "चतुर्दशोध्यायः",
      "english_ref": 4,
      "combined_translation": "4-6"
    },
    {
      "verse": 7,
      "sanskrit": "नन्दयैतान्महाराज मत्तानिव महाद्विपान् । उपपन्नेन वाक्येन सततं दुःखभागिनः ॥७॥",
      "english": null,
      "bhavadeepa": "स्तोककाश्चातकाः । वावाश्यमानाः- पुनः पुनः क्रन्दन्तः ॥६॥",
      "chapter": 14,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "चतुर्दशोध्यायः",
      "english_ref": 5,
      "combined_translation": "5-7"
    },
    {
      "verse": 8,
      "sanskrit": "कथं द्वैतवने राजन् पूर्वमुक्त्वा तथा वचः । भ्रातॄनेतान् स्म सहितान् शीतवातातपार्दितान् ॥८॥",
      "english": null,
      "bhavadeepa": "उपपन्नेन युक्तियुक्तेन ॥७॥",
      "chapter": 14,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "चतुर्दशोध्यायः",
      "english_ref": 6,
      "combined_translation": "6-9"
    },
    {
      "verse": 9,
      "sanskrit": "वयं दुर्योधनं हत्वा मुधे भोक्ष्याम मेदिनीम् । सम्पूर्णां सर्वकामानामाहवे विजयैषिणः ॥९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 14,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "चतुर्दशोध्यायः",
      "english_ref": 6,
      "combined_translation": "6-9"
    },
    {
      "verse": 10,
      "sanskrit": "विरथांश्च रथान् कृत्वा निहत्य च महागजान् । संस्तीर्य च रथैर्भूमिं ससादिभिररिन्दमाः ॥१०॥",
      "english": null,
      "bhavadeepa": "सर्वकामानां सर्वैरर्थैः ॥९॥",
      "chapter": 14,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "चतुर्दशोध्यायः",
      "english_ref": 7,
      "combined_translation": "7-11"
    },
    {
      "verse": 11,
      "sanskrit": "यजतां विविधैर्यज्ञैः समृद्धैराप्तद‌क्षिणैः । वनवासकृतं दुःखं भविष्यति सुखाय वः ॥११॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 14,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "चतुर्दशोध्यायः",
      "english_ref": 7,
      "combined_translation": "7-11"
    },
    {
      "verse": 12,
      "sanskrit": "इत्येतानेवमुक्त्वा त्वं स्वयं धर्मभृतां वर । कथमद्य पुनर्वीर विनिहंसि मनांसि नः ॥१२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 14,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "चतुर्दशोध्यायः",
      "english_ref": 8,
      "combined_translation": "8-12"
    },
    {
      "verse": 13,
      "sanskrit": "न क्लीबो वसुधां भुङ्क्ते न क्लीबो धनमश्नुते । न क्लीबस्य गृहे पुत्रा मत्स्याः पङ्क इवासते ॥१३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 14,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "चतुर्दशोध्यायः",
      "english_ref": 9,
      "combined_translation": "9-13"
    },
    {
      "verse": 14,
      "sanskrit": "नादण्डः क्षत्रियो भाति नादण्डो भूमिमश्नुते । नादण्डस्य प्रजा राज्ञः सुखं विन्दन्ति भारत ॥१४॥",
      "english": null,
      "bhavadeepa": "क्लीबः- अधीरः ॥१३॥",
      "chapter": 14,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "चतुर्दशोध्यायः",
      "english_ref": 10,
      "combined_translation": "10-14"
    },
    {
      "verse": 15,
      "sanskrit": "मित्रता सर्वभूतेषु दानमध्ययनं तपः । ब्राह्मणस्यैव धर्मः स्यान्न राज्ञो राजसत्तम ॥१५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 14,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "चतुर्दशोध्यायः",
      "english_ref": 11,
      "combined_translation": "11-15"
    },
    {
      "verse": 16,
      "sanskrit": "असतां प्रतिषेधश्च सतां च परिपालनम् । एष राज्ञां परो धर्मः समरे चापलायनम् ॥१६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 14,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "चतुर्दशोध्यायः",
      "english_ref": 12,
      "combined_translation": "12-16"
    },
    {
      "verse": 17,
      "sanskrit": "यस्मिन् क्षमा च क्रोधश्च दानादाने भयामये । निग्रहानुग्रहौ चोभौ स वै धर्मविदुच्यते ॥१७॥",
      "english": null,
      "bhavadeepa": "प्रतिषेधो-दण्डः राज्यान्निर्वासनं वा ॥१६॥",
