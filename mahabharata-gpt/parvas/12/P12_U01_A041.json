      "english_ref": 10,
      "combined_translation": "10-12"
    },
    {
      "verse": 13,
      "sanskrit": "परचक्रोपरोधे च दुष्टानां चावमर्दने । युधिष्ठिरो महाराज फाल्गुनं व्यादिदेश ह ॥१३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 41,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
