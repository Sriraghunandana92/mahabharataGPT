      "english_ref": 11,
      "combined_translation": "11-13"
    },
    {
      "verse": 14,
      "sanskrit": "द्विजानां देवकार्येषु कार्येष्वन्येषु चैव ह । धौम्यं पुरोधसां श्रेष्ठं नित्यमेव समादिशत् ॥१४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 41,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "एकचत्वारिंशत्तमोऽध्यायः",
      "english_ref": 12,
      "combined_translation": "12-14"
    },
    {
      "verse": 15,
      "sanskrit": "सहदेवं समीपस्थं नित्यमेव समादिशत् । तेन गोप्यो हि नृपतिः सर्वावस्थो विशाम्पते ॥१५॥",
      "english": null,
      "bhavadeepa": null,
