      "english_ref": 13,
      "combined_translation": "13-15"
    },
    {
      "verse": 16,
      "sanskrit": "यान्यानमन्यद्योग्यांश्च येषु येष्विह कर्मसु । तांस्तांस्तेष्वेव युयुजे प्रीयमाणो महीपतिः ॥१६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 41,
