  "adhyaya_name": "एकचत्वारिंशत्तमोऽध्यायः",
  "chapter": 41,
  "verse_count": 19,
  "verses": [
    {
      "verse": 1,
      "sanskrit": "वैशम्पायन उवाच।\n              प्रकृतीनां च तद्वाक्यं देशकालोपबृंहितम् । श्रुत्वा युधिष्ठिरो राजा सोत्तरं प्रत्यभाषत ॥१॥",
      "english": "'I shall now describe to you the means of conquering the senses as seen with the eye of the scriptures. A person, O king, will attain to the highest and by shaping his conduct accordingly.",
      "bhavadeepa": null,
      "chapter": 41,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "एकचत्वारिंशत्तमोऽध्यायः",
      "combined_translation": "1-2"
    },
    {
      "verse": 2,
      "sanskrit": "धन्याः पाण्डुसुता नूनं येषां ब्राह्मणपुङ्गवाः । तथ्यान्वाऽप्यथवाऽतथ्यान् गुणानाहुः समागताः ॥२॥",
      "english": null,
      "bhavadeepa": "प्रकृतीनामिति । तद्वाक्यं दिष्ट्या जयसीत्यादि अन्तरं पश्चात् ॥१॥",
      "chapter": 41,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "एकचत्वारिंशत्तमोऽध्यायः",
      "english_ref": 1,
      "combined_translation": "1-2"
    },
    {
      "verse": 3,
      "sanskrit": "अनुग्राह्या वयं नूनं भवतामिति मे मतिः । यदेवं गुणसम्पन्नानस्मान्ब्रूथ विमत्सराः ॥३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 41,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "एकचत्वारिंशत्तमोऽध्यायः",
      "english_ref": 2,
      "combined_translation": "2-3"
    },
    {
      "verse": 4,
      "sanskrit": "धृतराष्ट्रो महाराजः पिता मे दैवतं परम् । शासनेऽस्य प्रिये चैव स्थेयं मत्प्रियकाङ्क्षिभिः ॥४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 41,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "एकचत्वारिंशत्तमोऽध्यायः",
      "english_ref": 3,
      "combined_translation": "3-4"
    },
    {
      "verse": 5,
      "sanskrit": "एतदर्थं हि जीवामि कृत्वा ज्ञातिवधं महत् । अस्य शुश्रूषणं कार्यं मया नित्यमतन्द्रिणा ॥५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 41,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "एकचत्वारिंशत्तमोऽध्यायः",
      "english_ref": 4,
      "combined_translation": "4-5"
    },
    {
      "verse": 6,
      "sanskrit": "यदि चाहमनुग्राह्यो भवतां सुहृदां तथा । धृतराष्ट्रे यथापूर्वं वृत्तिं वर्तितुमर्हथ ॥६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 41,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "एकचत्वारिंशत्तमोऽध्यायः",
      "english_ref": 5,
      "combined_translation": "5-6"
    },
    {
      "verse": 7,
      "sanskrit": "एष नाथो हि जगतो भवतां च मया सह । अस्यैव पृथिवी कृत्स्ना पाण्डवाः सर्व एव च ॥७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 41,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "एकचत्वारिंशत्तमोऽध्यायः",
      "english_ref": 6,
      "combined_translation": "6-7"
    },
    {
      "verse": 8,
      "sanskrit": "एतन्मनसि कर्तव्यं भविद्भर्वचनं मम । अनुज्ञाप्याथ तान् राजा यथेष्टं गम्यतामिति ॥८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 41,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "एकचत्वारिंशत्तमोऽध्यायः",
      "english_ref": 7,
      "combined_translation": "7-8"
    },
    {
      "verse": 9,
      "sanskrit": "पौरजानपदान्सर्वान्विसृज्य कुरुनन्दनः । यौवराज्येन कौन्तेयं भीमसेनमयोजयत् ॥९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 41,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "एकचत्वारिंशत्तमोऽध्यायः",
      "english_ref": 8,
      "combined_translation": "8-9"
    },
    {
      "verse": 10,
      "sanskrit": "मन्त्रे च निश्चये चैव षाड्गुण्यस्य च चिन्तने । विदुरं बुद्धिसम्पन्नं प्रीतिमान्स समादिशत् ॥१०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 41,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "एकचत्वारिंशत्तमोऽध्यायः",
      "english_ref": 9,
      "combined_translation": "9-10"
    },
    {
      "verse": 11,
      "sanskrit": "कृताकृतपरिज्ञाने तथाऽऽयव्ययचिन्तने । सञ्जयं योजयामास वृद्धं सर्वगुणैर्युतम् ॥११॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 41,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "एकचत्वारिंशत्तमोऽध्यायः",
      "english_ref": 10,
      "combined_translation": "10-12"
    },
    {
      "verse": 12,
      "sanskrit": "बलस्य परिमाणे च भक्तवेतनयोस्तथा । नकुलं व्यादिशद्राजा कर्मणां चान्ववेक्षणे ॥१२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 41,
