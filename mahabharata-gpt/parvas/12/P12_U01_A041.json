    },
    {
      "verse": 18,
      "sanskrit": "उत्थायोत्थाय तत्कार्यमस्य राज्ञः पितुर्मम । सर्वं भवद्भिः कर्तव्यमप्रमत्तैर्यथायथम् ॥१८॥",
      "english": null,
      "bhavadeepa": null,
