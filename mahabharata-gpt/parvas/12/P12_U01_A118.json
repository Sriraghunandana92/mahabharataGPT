{
  "adhyaya_id": "P12_U01_A118",
  "book": 12,
  "parva_name": "शान्तिपर्व",
  "upaparva_name": "राजधर्मानुशासनपर्व",
  "adhyaya_name": "अष्टदशाधिकशततमोऽध्यायः",
  "chapter": 118,
  "verse_count": 28,
  "verses": [
    {
      "verse": 1,
      "sanskrit": "भीष्म उवाच।\n              स श्वा प्रकृतिमापन्नः परं दैन्यमुपागतः। ऋषिणा हुंकृतः पापस्तपोवनबहिष्कृतः॥१॥",
      "english": "Parashara said That man, who, having got this car, viz., his body endued with mind, goes on, restraining with the reins of knowledge the horses of the objects of the senses, should certainly be considered as an intelligent one.",
      "bhavadeepa": null,
      "chapter": 118,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "अष्टदशाधिकशततमोऽध्यायः",
      "combined_translation": "1-1"
    },
    {
      "verse": 2,
      "sanskrit": "एवं राज्ञा मतिमता विदित्वा सत्यशौचताम्। आर्जवं, प्रकृतिं, सत्यं, श्रुतं, वृत्तं, कुलं, दमम्॥२॥",
      "english": "The homage by a person whose mind depends on itself and who has renounced the means of livelihood, is worthy of high praise, that homage, namely, O twice born one, from one who has succeeded in getting over acts, but not acquired from the mutual discussion of men in the same state of progress.",
      "bhavadeepa": null,
      "chapter": 118,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "अष्टदशाधिकशततमोऽध्यायः",
      "combined_translation": "2-3"
    },
    {
      "verse": 3,
      "sanskrit": "अनुक्रोशं, बलं, वीर्यं प्रभावं प्रश्रयं, क्षमाम्। भृत्या ये यत्र योग्याः स्युस्तत्र स्थाप्याः सुरक्षिताः॥३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 118,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "अष्टदशाधिकशततमोऽध्यायः",
      "english_ref": 2,
      "combined_translation": "2-3"
    },
    {
      "verse": 4,
      "sanskrit": "नापरीक्ष्य महीपालः सचिवं कर्तुमर्हति। अकुलीननराकीर्णो न राजा सुखमेधते॥४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 118,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "अष्टदशाधिकशततमोऽध्यायः",
      "english_ref": 3,
      "combined_translation": "3-4"
    },
    {
      "verse": 5,
      "sanskrit": "कुलजः प्राकृतो राज्ञा स्वकुलीनतया सदा। न पापे कुरुते बुद्धिं भिद्यमानोऽप्यनागसि॥५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 118,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "अष्टदशाधिकशततमोऽध्यायः",
      "english_ref": 4,
      "combined_translation": "4-5"
    },
    {
      "verse": 6,
      "sanskrit": "अकुलीनस्तु पुरुषः प्राकृतः साधुसंश्रयात्। दुर्लभैश्वर्यतां प्राप्तो निन्दितः शत्रुतां व्रजेत्॥६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 118,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "अष्टदशाधिकशततमोऽध्यायः",
      "english_ref": 5,
      "combined_translation": "5-6"
    },
    {
      "verse": 7,
      "sanskrit": "कुलीनं शिक्षितं प्राज्ञं ज्ञानविज्ञानपारगम्। सर्वशास्त्रार्थतत्त्वज्ञं सहिष्णुं देशजं तथा॥७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 118,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "अष्टदशाधिकशततमोऽध्यायः",
      "english_ref": 6,
      "combined_translation": "6-14"
    },
    {
      "verse": 8,
      "sanskrit": "कृतज्ञं बलवन्तं च क्षान्तं दान्तं जितेन्द्रियम्। अलुब्धं लब्धसंतुष्टं स्वामिमित्रबुभूषकम्॥८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 118,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "अष्टदशाधिकशततमोऽध्यायः",
      "english_ref": 6,
      "combined_translation": "6-14"
    },
    {
      "verse": 9,
      "sanskrit": "सचिवं देशकालज्ञं सत्त्वसंग्रहणे रतम्। सततं युक्तमनसं हितैषिणमतन्द्रितम्॥९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 118,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "अष्टदशाधिकशततमोऽध्यायः",
      "english_ref": 6,
      "combined_translation": "6-14"
    },
    {
      "verse": 10,
      "sanskrit": "युक्तचारं स्वविषये सन्धिविग्रहकोविदम्। राज्ञस्त्रिवर्गवेत्तारं पौरजानपदप्रियम्॥१०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 118,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "अष्टदशाधिकशततमोऽध्यायः",
      "english_ref": 6,
      "combined_translation": "6-14"
    },
    {
      "verse": 11,
      "sanskrit": "खातकव्यूहतत्त्वज्ञं बलहर्षणकोविदम्। इङ्गिताकारतत्त्वज्ञं यात्राज्ञानविशारदम्॥११॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 118,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "अष्टदशाधिकशततमोऽध्यायः",
      "english_ref": 6,
      "combined_translation": "6-14"
    },
    {
      "verse": 12,
      "sanskrit": "हस्तिशिक्षासु तत्त्वज्ञमहंकारविवर्जितम्। प्रगल्भं दक्षिणं दान्तं बलिनं युक्तकारिणम्॥१२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 118,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "अष्टदशाधिकशततमोऽध्यायः",
      "english_ref": 6,
      "combined_translation": "6-14"
    },
    {
      "verse": 13,
      "sanskrit": "चौक्षं चौक्षजनाकीर्णं सुमुखं सुखदर्शनम्। नायकं नीतिकुशलं गुणचेष्टासमन्वितम्॥१३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 118,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "अष्टदशाधिकशततमोऽध्यायः",
      "english_ref": 6,
      "combined_translation": "6-14"
    },
    {
      "verse": 14,
      "sanskrit": "अस्तब्धं प्रसृतं श्लक्ष्णं मृदुवादिनमेव च। धीरं शूरं महर्धिं च देशकालोपपादकम्॥१४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 118,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "अष्टदशाधिकशततमोऽध्यायः",
      "english_ref": 6,
      "combined_translation": "6-14"
    },
    {
      "verse": 15,
      "sanskrit": "सचिवं यः प्रकुरुते न चैनमवमन्यते। तस्य विस्तीर्यते राज्यं ज्योत्स्ना ग्रहपतेरिव॥१५॥",
      "english": "Hence, one should never commit sinful deeds which have for their fruit only sorrow.",
      "bhavadeepa": null,
      "chapter": 118,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "अष्टदशाधिकशततमोऽध्यायः"
    },
    {
      "verse": 16,
      "sanskrit": "एतैरेव गुणैर्युक्तो राजा शास्त्रविशारदः। एष्टव्यो धर्मपरमः प्रजापालनतत्परः॥१६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 118,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "अष्टदशाधिकशततमोऽध्यायः",
      "english_ref": 7,
      "combined_translation": "7-16"
    },
    {
      "verse": 17,
      "sanskrit": "धीरो मार्षी शुचिस्तीक्ष्णः काले पुरुषकारवित्। शुश्रूषुः श्रुतवान् श्रोता ऊहापोहविशारदः॥१७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 118,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "अष्टदशाधिकशततमोऽध्यायः",
      "english_ref": 8,
      "combined_translation": "8-20"
    },
    {
      "verse": 18,
      "sanskrit": "मेधावी धारणायुक्तो यथान्यायोपपादकः। दान्तः सदा प्रियाभाषी क्षमावांश्च विपर्यये॥१८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 118,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "अष्टदशाधिकशततमोऽध्यायः",
      "english_ref": 8,
      "combined_translation": "8-20"
    },
    {
      "verse": 19,
      "sanskrit": "दानाच्छेदे स्वयंकारी श्रद्धालुः सुखदर्शनः। आर्तहस्तप्रदो नित्यममात्यो हि हिते रतः॥१९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 118,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "अष्टदशाधिकशततमोऽध्यायः",
      "english_ref": 8,
      "combined_translation": "8-20"
    },
    {
      "verse": 20,
      "sanskrit": "नाहंवादी न निर्द्वन्द्वो न यत्किंचनकारकः। कृते कर्मण्यमात्यानां कर्ता भक्तजनप्रियः॥२०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 118,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "अष्टदशाधिकशततमोऽध्यायः",
      "english_ref": 8,
      "combined_translation": "8-20"
    },
    {
      "verse": 21,
      "sanskrit": "संगृहीतजनो स्तब्धः प्रसन्नवदनः सदा। सदा भृत्यजनापेक्षी न क्रोधी सुमहामनाः॥२१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 118,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "अष्टदशाधिकशततमोऽध्यायः",
      "english_ref": 9,
      "combined_translation": "9-21"
    },
    {
      "verse": 22,
      "sanskrit": "युक्तदण्डो न निर्दण्डो धर्मकार्यानुशासनः। चारनेत्रः प्रजावेक्षी धर्मार्थकुशलः सदा॥२२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 118,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "अष्टदशाधिकशततमोऽध्यायः",
      "english_ref": 10,
      "combined_translation": "10-23"
    },
    {
      "verse": 23,
      "sanskrit": "राजा गुणशताकीर्ण एष्टव्यस्तादृशो भवेत्। योधाश्चैव मनुष्येन्द्र सर्वे गुणगणैर्वृताः॥२३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 118,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "अष्टदशाधिकशततमोऽध्यायः",
      "english_ref": 10,
      "combined_translation": "10-23"
    },
    {
      "verse": 24,
      "sanskrit": "अन्वेष्टव्याः सुपुरुषाः सहाया राज्यधारणे। न विमानयितव्यास्ते राज्ञा वृद्धिमभीप्सता॥२४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 118,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "अष्टदशाधिकशततमोऽध्यायः",
      "english_ref": 11,
      "combined_translation": "11-26"
    },
    {
      "verse": 25,
      "sanskrit": "योधाः समरशौटीराः कृतज्ञाः शस्त्रकोविदाः। धर्मशास्त्रसमायुक्ताः पदातिजनसंवृताः॥२५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 118,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "अष्टदशाधिकशततमोऽध्यायः",
      "english_ref": 11,
      "combined_translation": "11-26"
    },
    {
      "verse": 26,
      "sanskrit": "अभया गजपृष्ठस्था रथचर्याविशारदाः। इष्वस्त्रकुशला यस्य तस्येयं नृपतेर्मही॥२६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 118,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "अष्टदशाधिकशततमोऽध्यायः",
      "english_ref": 11,
      "combined_translation": "11-26"
    },
    {
      "verse": 27,
      "sanskrit": "सर्वसंग्रहणे युक्तो नृपो भवति यः सदा। उत्थानशीलो मित्राढ्यः स राजा राजसत्तमः॥२७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 118,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "अष्टदशाधिकशततमोऽध्यायः",
      "english_ref": 12,
      "combined_translation": "12-27"
    },
    {
      "verse": 28,
      "sanskrit": "शक्या चाश्वसहस्रेण वीरारोहेण भारत। संगृहीतमनुष्येण कृत्स्ना जेतुं वसुन्धरा॥२८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 118,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "अष्टदशाधिकशततमोऽध्यायः",
      "english_ref": 13,
      "combined_translation": "13-28"
    }
  ]
}