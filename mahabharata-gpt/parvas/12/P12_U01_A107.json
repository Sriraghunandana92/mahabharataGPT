  "adhyaya_name": "सप्ताधिकशततमोऽध्यायः",
  "chapter": 107,
  "verse_count": 32,
  "verses": [
    {
      "verse": 2,
      "sanskrit": "युधिष्ठिर उवाच।\n              ब्राह्मणक्षत्रियविशां शूद्राणां च परन्तप। धर्मवृत्तं च वित्तं च वृत्त्युपायाः फलानि च॥२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 107,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "सप्ताधिकशततमोऽध्यायः",
      "english_ref": 1,
      "combined_translation": "1-2"
    },
    {
      "verse": 2,
      "sanskrit": "राज्ञां वित्तं च कोशं च कोशसंचयनं जयः। अमात्यगुणवृत्तिश्च प्रकृतीनां च वर्धनम्॥२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 107,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "सप्ताधिकशततमोऽध्यायः",
      "english_ref": 1,
      "combined_translation": "1-2"
    },
    {
      "verse": 3,
      "sanskrit": "षाड्गुण्यगुणकल्पश्च सेनावृत्तिस्तथैव च। परिज्ञानं च दुष्टस्य लक्षणं च सतामपि॥३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 107,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "सप्ताधिकशततमोऽध्यायः",
      "english_ref": 2,
      "combined_translation": "2-5"
    },
    {
      "verse": 4,
      "sanskrit": "समहीनाधिकानां च यथावल्लक्षणं च यत्। मध्यमस्य च तुष्ट्यर्थं यथा स्थेयं विवर्धता॥४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 107,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "सप्ताधिकशततमोऽध्यायः",
      "english_ref": 2,
      "combined_translation": "2-5"
    },
    {
      "verse": 5,
      "sanskrit": "क्षीणग्रहणवृत्तिश्च यथाधर्मं प्रकीर्तितम्। लघुना देशरूपेण ग्रन्थयोगेन भारत॥५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 107,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "सप्ताधिकशततमोऽध्यायः",
      "english_ref": 2,
      "combined_translation": "2-5"
    },
    {
      "verse": 6,
      "sanskrit": "विजिगीषोस्तथा वृत्तमुक्तं चैव तथैव ते। गणानां वृत्तिमिच्छामि श्रोतुं मतिमतां वर॥६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 107,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "सप्ताधिकशततमोऽध्यायः",
      "english_ref": 3,
      "combined_translation": "3-6"
    },
    {
      "verse": 7,
      "sanskrit": "यथा गणाः प्रवर्धन्ते न भिद्यन्ते च भारत। अरींश्च विजिगीषन्ते सुहृदः प्राप्नुवन्ति च॥७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 107,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "सप्ताधिकशततमोऽध्यायः",
      "english_ref": 4,
      "combined_translation": "4-7"
    },
    {
      "verse": 8,
      "sanskrit": "भेदमूलो विनाशो हि गणानामुपलक्षये। मन्त्रसंवरणं दुःखं बहूनामिति मे मतिः॥८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 107,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "सप्ताधिकशततमोऽध्यायः",
      "english_ref": 5,
      "combined_translation": "5-8"
    },
    {
      "verse": 9,
      "sanskrit": "एतदिच्छाम्यहं श्रोतुं निखिलेन परन्तप। यथा च ते न भिद्येरंस्तच्च मे वद पार्थिव॥९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 107,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "सप्ताधिकशततमोऽध्यायः",
      "english_ref": 6,
      "combined_translation": "6-9"
    },
    {
      "verse": 10,
      "sanskrit": "भीष्म उवाच।\n              गणानां च कुलानां च राज्ञां भरतसत्तम। वैरसंदीपनावेतौ लोभामर्षौ नराधिप ॥१०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 107,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "सप्ताधिकशततमोऽध्यायः",
      "english_ref": 7,
      "combined_translation": "7-10"
    },
    {
      "verse": 11,
      "sanskrit": "लोभमेको हि वृणुते ततोऽमर्षमनन्तरम्। तौ क्षयव्ययसंयुक्तावन्योन्यं च विनाशिनौ॥११॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 107,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "सप्ताधिकशततमोऽध्यायः",
      "english_ref": 8,
      "combined_translation": "8-11"
    },
    {
      "verse": 12,
      "sanskrit": "चारमन्त्रबलादानैः सामदानविभेदनैः। क्षयव्ययभयोपायैः प्रकर्षन्तीतरेतरम्॥१२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 107,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "सप्ताधिकशततमोऽध्यायः",
      "english_ref": 9,
      "combined_translation": "9-12"
    },
    {
      "verse": 13,
      "sanskrit": "तत्रादानेन भिद्यन्ते गणाः संघातवृत्तयः। भिन्ना विमनसः सर्वे गच्छन्त्यरिवशं भयात्॥१३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 107,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "सप्ताधिकशततमोऽध्यायः",
      "english_ref": 10,
      "combined_translation": "10-13"
    },
    {
      "verse": 14,
      "sanskrit": "भेदे गणा विनेश्युर्हि भिन्नास्तु सुजयाः परैः। तस्मात्संघातयोगेन प्रयतेरन् गणाः सदा॥१४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 107,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "सप्ताधिकशततमोऽध्यायः",
      "english_ref": 11,
      "combined_translation": "11-14"
    },
    {
      "verse": 15,
      "sanskrit": "अर्थाश्चैवाधिगम्यन्ते संघातबलपौरुषैः। बाह्याश्च मैत्रीं कुर्वन्ति तेषु संघातवृत्तिषु॥१५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 107,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "सप्ताधिकशततमोऽध्यायः",
      "english_ref": 13,
      "combined_translation": "13-15"
    },
    {
      "verse": 16,
      "sanskrit": "ज्ञानवृद्धाः प्रशंसन्ति शुश्रूषन्तः परस्परम्। विनिवृत्ताभिसन्धानाः सुखमेधन्ति सर्वशः॥१६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 107,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "सप्ताधिकशततमोऽध्यायः",
      "english_ref": 14,
      "combined_translation": "14-16"
    },
    {
      "verse": 17,
      "sanskrit": "धर्मिष्ठान्व्यवहारांश्च स्थापयन्तश्च शास्त्रतः। यथावत्प्रतिपश्यन्तो विवर्धन्ते गणोत्तमाः॥१७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 107,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "सप्ताधिकशततमोऽध्यायः",
      "english_ref": 15,
      "combined_translation": "15-17"
    },
    {
      "verse": 18,
      "sanskrit": "पुत्रान्भ्रातॄन्निगृह्णन्तो विनयन्तश्च तान्सदा। विनीतांश्च प्रगृह्णन्तो विवर्धन्ते गणोत्तमाः॥१८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 107,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "सप्ताधिकशततमोऽध्यायः",
      "english_ref": 16,
      "combined_translation": "16-18"
    },
    {
      "verse": 19,
      "sanskrit": "चारमन्त्रविधानेषु कोशसंनिचयेषु च। नित्ययुक्ता महाबाहो वर्धन्ते सर्वतो गणाः॥१९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 107,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "सप्ताधिकशततमोऽध्यायः",
      "english_ref": 17,
      "combined_translation": "17-19"
    },
    {
      "verse": 20,
      "sanskrit": "प्राज्ञाञ्शूरान्महोत्साहान्कर्मसु स्थिरपौरुषान्। मानयन्तः सदा युक्ता विवर्धन्ते गणा नृप॥२०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 107,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "सप्ताधिकशततमोऽध्यायः",
      "english_ref": 18,
      "combined_translation": "18-20"
    },
    {
      "verse": 21,
      "sanskrit": "द्रव्यवन्तश्च शूराश्च शस्त्रज्ञाः शास्त्रपारगाः। कृच्छ्रास्वापत्सु सम्मूढान् गणाः संतारयन्ति ते॥२१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 107,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "सप्ताधिकशततमोऽध्यायः",
      "english_ref": 19,
      "combined_translation": "19-21"
    },
    {
      "verse": 22,
      "sanskrit": "क्रोधो भेदो भयं दण्डः कर्षणं निग्रहो वधः। नयत्यरिवशं सद्यो गणान्भरतसत्तम॥२२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 107,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "सप्ताधिकशततमोऽध्यायः",
      "english_ref": 20,
      "combined_translation": "20-22"
    },
    {
      "verse": 23,
      "sanskrit": "तस्मान्मानयितव्यास्ते गणमुख्याः प्रधानतः । लोकयात्रा समायत्ता भूयसी तेषु पार्थिव॥२३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 107,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "सप्ताधिकशततमोऽध्यायः",
      "english_ref": 21,
      "combined_translation": "21-23"
    },
    {
      "verse": 24,
      "sanskrit": "मन्त्रगुप्तिः प्रधानेषु चारश्चामित्रकर्षण। न गणाः कृत्स्नशो मन्त्रं श्रोतुमर्हन्ति भारत॥२४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 107,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "सप्ताधिकशततमोऽध्यायः",
      "english_ref": 22,
      "combined_translation": "22-24"
    },
    {
      "verse": 25,
      "sanskrit": "गणमुख्यैस्तु सम्भूय कार्यं गणहितं मिथः। पृथग्गणस्य भिन्नस्य विततस्य ततोऽन्यथा॥२५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 107,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "सप्ताधिकशततमोऽध्यायः",
      "english_ref": 23,
      "combined_translation": "23-25"
    },
    {
      "verse": 26,
      "sanskrit": "अर्थाः प्रत्यवसीदन्ति तथाऽनर्था भवन्ति च। तेषामन्योन्यभिन्नानां स्वशक्तिमनुतिष्ठताम्॥२६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 107,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "सप्ताधिकशततमोऽध्यायः",
      "english_ref": 24,
      "combined_translation": "24-26"
    },
    {
      "verse": 27,
      "sanskrit": "निग्रहः पण्डितैः कार्यः क्षिप्रमेव प्रधानतः। कुलेषु कलहा जाताः कुलवृद्धैरुपेक्षिताः॥२७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 107,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "सप्ताधिकशततमोऽध्यायः"
    },
    {
      "verse": 28,
      "sanskrit": "गोत्रस्य नाशं कुर्वन्ति गणभेदस्य कारकम्। आभ्यन्तरं भयं रक्ष्यमसारं बाह्यतो भयम्॥२८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 107,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "सप्ताधिकशततमोऽध्यायः",
      "english_ref": 25,
      "combined_translation": "25-28"
    },
    {
      "verse": 29,
      "sanskrit": "आभ्यन्तरं भयं राजन् सद्यो मूलानि कृन्तति। अकस्मात्क्रोधमोहाभ्यां लोभाद्वापि स्वभावजात्॥२९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 107,
      "parva_name": "शान्तिपर्व",
      "upaparva_name": "राजधर्मानुशासनपर्व",
      "adhyaya_name": "सप्ताधिकशततमोऽध्यायः",
      "english_ref": 26,
      "combined_translation": "26-29"
    },
    {
      "verse": 30,
      "sanskrit": "अन्योन्यं नाभिभाषन्ते तत्पराभवलक्षणम्। जात्या च सदृशाः सर्वे कुलेन सदृशास्तथा॥३०॥",
      "english": null,
      "bhavadeepa": null,
