{
  "adhyaya_id": "P16_U01_A001",
  "book": 16,
  "parva_name": "मौसलपर्व",
  "upaparva_name": "महाप्रस्थानिकपर्व",
  "adhyaya_name": "प्रथमोऽध्यायः",
  "chapter": 1,
  "verse_count": 31,
  "verses": [
    {
      "verse": 1,
      "sanskrit": "वैशम्पायन उवाच।\n              षट्त्रिंशे त्वथ सम्प्राप्ते वर्षे कौरवनन्दनः। ददर्श विपरीतानि निमित्तानि युधिष्ठिरः॥१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 1,
      "parva_name": "मौसलपर्व",
      "upaparva_name": "महाप्रस्थानिकपर्व",
      "adhyaya_name": "प्रथमोऽध्यायः"
    },
    {
      "verse": 2,
      "sanskrit": "ववुर्वाताश्च निर्घाता रूक्षाः शर्करवर्षिणः। अपसव्यानि शकुना मण्डलानि प्रचक्रिरे॥२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 1,
      "parva_name": "मौसलपर्व",
      "upaparva_name": "महाप्रस्थानिकपर्व",
      "adhyaya_name": "प्रथमोऽध्यायः"
    },
    {
      "verse": 3,
      "sanskrit": "प्रत्यगूहुर्महानद्यो दिशो नीहारसंवृताः। उल्काश्चाङ्गारवर्षिण्यः प्रापतन्गगनाद्भुवि॥३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 1,
      "parva_name": "मौसलपर्व",
      "upaparva_name": "महाप्रस्थानिकपर्व",
      "adhyaya_name": "प्रथमोऽध्यायः"
    },
    {
      "verse": 4,
      "sanskrit": "आदित्यो रजसा राजन् समवच्छन्नमण्डलः। विरश्मिरुदये नित्यं कबन्धैः समदृश्यत॥४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 1,
      "parva_name": "मौसलपर्व",
      "upaparva_name": "महाप्रस्थानिकपर्व",
      "adhyaya_name": "प्रथमोऽध्यायः"
    },
    {
      "verse": 5,
      "sanskrit": "परिवेषाश्च दृश्यन्ते दारुणाश्चन्द्रसूर्ययोः। त्रिवर्णाः श्यामरूक्षान्तास्तथा भस्मारुणप्रभाः॥५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 1,
      "parva_name": "मौसलपर्व",
      "upaparva_name": "महाप्रस्थानिकपर्व",
      "adhyaya_name": "प्रथमोऽध्यायः"
    },
    {
      "verse": 6,
      "sanskrit": "एते चान्ये च बहव उत्पाता भयशंसिनः। दृश्यन्ते बहवो राजन् ह्रदयोद्वेगकारकाः॥६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 1,
      "parva_name": "मौसलपर्व",
      "upaparva_name": "महाप्रस्थानिकपर्व",
      "adhyaya_name": "प्रथमोऽध्यायः"
    },
    {
      "verse": 7,
      "sanskrit": "कस्यचित्त्वथ कालस्य कुरुराजो युधिष्ठिरः। शुश्राव वृष्णिचक्रस्य मौसले कदनं कृतम्॥७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 1,
      "parva_name": "मौसलपर्व",
      "upaparva_name": "महाप्रस्थानिकपर्व",
      "adhyaya_name": "प्रथमोऽध्यायः"
    },
    {
      "verse": 8,
      "sanskrit": "विमुक्तं वासुदेवं च श्रुत्वा रामं च पाण्डवः। समानीयाब्रवीद्भ्रातॄन्किं करिष्याम इत्युत॥८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 1,
      "parva_name": "मौसलपर्व",
      "upaparva_name": "महाप्रस्थानिकपर्व",
      "adhyaya_name": "प्रथमोऽध्यायः"
    },
    {
      "verse": 9,
      "sanskrit": "परस्परं समासाद्य ब्रह्मदण्डबलात्कृतान्। वृष्णीन्विनष्टांस्ते श्रुत्वा व्यथिताः पाण्डवाभवन्॥९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 1,
      "parva_name": "मौसलपर्व",
      "upaparva_name": "महाप्रस्थानिकपर्व",
      "adhyaya_name": "प्रथमोऽध्यायः"
    },
    {
      "verse": 10,
      "sanskrit": "निधनं वासुदेवस्य समुद्रस्येव शोषणम्। वीरा न श्रद्दधुस्तस्य विनाशं शार्ङ्गधन्वनः॥१०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 1,
      "parva_name": "मौसलपर्व",
      "upaparva_name": "महाप्रस्थानिकपर्व",
      "adhyaya_name": "प्रथमोऽध्यायः"
    },
    {
      "verse": 11,
      "sanskrit": "मौसलं ते समाश्रित्य दुःखशोकसमन्विताः। विषण्णा हतसङ्कल्पाः पाण्डवाः समुपाविशन्॥११॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 1,
      "parva_name": "मौसलपर्व",
      "upaparva_name": "महाप्रस्थानिकपर्व",
      "adhyaya_name": "प्रथमोऽध्यायः"
    },
    {
      "verse": 12,
      "sanskrit": "जनमेजय उवाच।\n              कथं विनष्टा भगवन्नन्धका वृष्णिभिः सह। पश्यतो वासुदेवस्य भोजाश्चैव महारथाः॥१२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 1,
      "parva_name": "मौसलपर्व",
      "upaparva_name": "महाप्रस्थानिकपर्व",
      "adhyaya_name": "प्रथमोऽध्यायः"
    },
    {
      "verse": 13,
      "sanskrit": "वैशम्पायन उवाच।\n              षट्त्रिंशेऽथ ततो वर्षे वृष्णीनामनयो महान्। अन्योन्यं मुसलैस्ते तु निजघ्नुः कालचोदिताः॥१३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 1,
      "parva_name": "मौसलपर्व",
      "upaparva_name": "महाप्रस्थानिकपर्व",
      "adhyaya_name": "प्रथमोऽध्यायः"
    },
    {
      "verse": 14,
      "sanskrit": "जनमेजय उवाच।\n              केनानुशप्तास्ते वीराः क्षयं वृष्ण्यन्धका गताः। भोजाश्च द्विजवर्य त्वं विस्तरेण वदस्व मे॥१४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 1,
      "parva_name": "मौसलपर्व",
      "upaparva_name": "महाप्रस्थानिकपर्व",
      "adhyaya_name": "प्रथमोऽध्यायः"
    },
    {
      "verse": 15,
      "sanskrit": "वैशम्पायन उवाच।\n              विश्वामित्रं च कण्वं च नारदं च तपोधनम्। सारणप्रमुखा वीरा ददृशुर्द्वारकां गतान्॥१५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 1,
      "parva_name": "मौसलपर्व",
      "upaparva_name": "महाप्रस्थानिकपर्व",
      "adhyaya_name": "प्रथमोऽध्यायः"
    },
    {
      "verse": 16,
      "sanskrit": "ते तान्साम्बं पुरस्कृत्य भूषयित्वा स्त्रियं यथा। अब्रुवन्नुपसं गम्य दैवदण्डनिपीडिताः॥१६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 1,
      "parva_name": "मौसलपर्व",
      "upaparva_name": "महाप्रस्थानिकपर्व",
      "adhyaya_name": "प्रथमोऽध्यायः"
    },
    {
      "verse": 17,
      "sanskrit": "इयं स्त्री पुत्रकामस्य बभ्रोरमिततेजसः। ऋषयः साधु जानीत किमियं जनयिष्यति॥१७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 1,
      "parva_name": "मौसलपर्व",
      "upaparva_name": "महाप्रस्थानिकपर्व",
      "adhyaya_name": "प्रथमोऽध्यायः"
    },
    {
      "verse": 18,
      "sanskrit": "इत्युक्तास्तेतदाराजन्विप्रलम्भप्रधर्षिताः। प्रत्युब्रुवंस्तान्मुनयो यत्तच्छृणु नराधिप॥१८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 1,
      "parva_name": "मौसलपर्व",
      "upaparva_name": "महाप्रस्थानिकपर्व",
      "adhyaya_name": "प्रथमोऽध्यायः"
    },
    {
      "verse": 19,
      "sanskrit": "वृष्ण्यन्धकविनाशाय मुसलं घोरमायसम्। वासुदेवस्य दायादः साम्बोऽयं जनयिष्यति॥१९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 1,
      "parva_name": "मौसलपर्व",
      "upaparva_name": "महाप्रस्थानिकपर्व",
      "adhyaya_name": "प्रथमोऽध्यायः"
    },
    {
      "verse": 20,
      "sanskrit": "येन यूयं सुदुर्वृत्ता नृशंसा जातमन्यवः। उच्छेत्तारः कुलं कृत्स्नमृते रामजनार्दनौ॥२०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 1,
      "parva_name": "मौसलपर्व",
      "upaparva_name": "महाप्रस्थानिकपर्व",
      "adhyaya_name": "प्रथमोऽध्यायः"
    },
    {
      "verse": 21,
      "sanskrit": "समुद्रं यास्यति श्रीमांस्त्यक्त्वा देहं हलायुधः। जरा कृष्णं महात्मानं शयानं भुवि भेत्स्यति॥२१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 1,
      "parva_name": "मौसलपर्व",
      "upaparva_name": "महाप्रस्थानिकपर्व",
      "adhyaya_name": "प्रथमोऽध्यायः"
    },
    {
      "verse": 22,
      "sanskrit": "इत्यब्रुवन्त ते राजन्प्रलब्धास्तैर्दुरात्मभिः। मुनयः क्रोधरक्ताक्षाः समीक्ष्याथ परस्परम्॥२२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 1,
      "parva_name": "मौसलपर्व",
      "upaparva_name": "महाप्रस्थानिकपर्व",
      "adhyaya_name": "प्रथमोऽध्यायः"
    },
    {
      "verse": 23,
      "sanskrit": "तथोक्त्वा मुनयस्ते तु ततः केशवमभ्ययुः। अथाब्रवीत्तदा वृष्णीन् श्रुत्वैवं मधुसूदनः॥२३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 1,
      "parva_name": "मौसलपर्व",
      "upaparva_name": "महाप्रस्थानिकपर्व",
      "adhyaya_name": "प्रथमोऽध्यायः"
    },
    {
      "verse": 24,
      "sanskrit": "अन्तज्ञो मतिमांस्तस्य भवितव्यं तथेति तान्। एवमुक्त्वा हृषीकेशः प्रविवेश पुरन्तदा॥२४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 1,
      "parva_name": "मौसलपर्व",
      "upaparva_name": "महाप्रस्थानिकपर्व",
      "adhyaya_name": "प्रथमोऽध्यायः"
    },
    {
      "verse": 25,
      "sanskrit": "कृतान्तमन्यथा नैच्छत्कर्तुं स जगतः प्रभुः। श्वोभूतेऽथ ततः साम्बो मुसलं तदसूत वै॥२५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 1,
      "parva_name": "मौसलपर्व",
      "upaparva_name": "महाप्रस्थानिकपर्व",
      "adhyaya_name": "प्रथमोऽध्यायः"
    },
    {
      "verse": 26,
      "sanskrit": "येन वृष्ण्यन्धककुले पुरुषा भस्मसात्कृताः। वृष्ण्यन्धकविनाशाय किङ्करप्रतिमं महत्॥२६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 1,
      "parva_name": "मौसलपर्व",
      "upaparva_name": "महाप्रस्थानिकपर्व",
      "adhyaya_name": "प्रथमोऽध्यायः"
    },
    {
      "verse": 27,
      "sanskrit": "असूत शापजं घोरं तच्च राज्ञे न्यवेदयन्। विषण्णरूपस्तद्राजा सूक्ष्मं चूर्णमकारयत्॥२७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 1,
      "parva_name": "मौसलपर्व",
      "upaparva_name": "महाप्रस्थानिकपर्व",
      "adhyaya_name": "प्रथमोऽध्यायः"
    },
    {
      "verse": 28,
      "sanskrit": "तच्चूर्णं सागरे चापि प्राक्षिपन्पुरुषा नृप। अघोषयंश्च नगरे वचनादाहुकस्य ते॥२८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 1,
      "parva_name": "मौसलपर्व",
      "upaparva_name": "महाप्रस्थानिकपर्व",
      "adhyaya_name": "प्रथमोऽध्यायः"
    },
    {
      "verse": 29,
      "sanskrit": "जनार्दनस्य रामस्य बभ्रोश्चैव महात्मनः। अद्यप्रभृति सर्वेषु वृष्ण्यन्धककुलेष्विह॥२९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 1,
      "parva_name": "मौसलपर्व",
      "upaparva_name": "महाप्रस्थानिकपर्व",
      "adhyaya_name": "प्रथमोऽध्यायः"
    },
    {
      "verse": 30,
      "sanskrit": "सुरासवो न कर्तव्यः सर्वैर्नगरवासिभिः। यश्च नो विदितङ्कुर्यात्पेयं कश्चिन्नरः क्वचित्॥३०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 1,
      "parva_name": "मौसलपर्व",
      "upaparva_name": "महाप्रस्थानिकपर्व",
      "adhyaya_name": "प्रथमोऽध्यायः"
    },
    {
      "verse": 31,
      "sanskrit": "जीवन्स शूलमारोहेत्स्वयं कृत्वा सबान्धवः। ततो राजभयात्सर्वे नियमं चक्रिरे तदा। नराः शासनमाज्ञाय रामस्याक्लिष्टकर्मणः॥३१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 1,
      "parva_name": "मौसलपर्व",
      "upaparva_name": "महाप्रस्थानिकपर्व",
      "adhyaya_name": "प्रथमोऽध्यायः"
    }
  ]
}