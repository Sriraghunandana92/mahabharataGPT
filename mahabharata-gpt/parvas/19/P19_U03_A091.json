  "chapter": 274,
  "verse_count": 18,
  "verses": [
    {
      "verse": 1,
      "sanskrit": "वैशम्पायन उवाच।\n              एतस्मिन्नेव काले तु पौण्ड्रो नृपवरोत्तमः। बलवान्सत्त्वसम्पन्नो योद्धा विपुलविक्रमः॥१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 274,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पौण्ड्रकवृत्तान्तारम्भः",
      "combined_translation": "1-39"
    },
    {
      "verse": 2,
      "sanskrit": "वृष्णिशत्रुस्तदा राजा कृष्णद्वेषी बलात्तदा। नृपान्सर्वान्समाहूय प्रोवाच नृपसंसदि॥२॥",
      "english": null,
      "bhavadeepa": "बाणयुद्धे यदुक्तं हरिहराद्वैतं तदेव कैलासयात्रायां हरेः शिवाराधकत्वेन शिवस्य विष्णुस्तावकत्वेन च दृढीकृतम्। तेन शास्तृशास्ययोर्जीवेशयोरविकृतब्रह्मभावः। कृत्स्नस्य शास्त्रस्यार्थ उक्तः। अथावरकृत्यशेषं व्याचष्टरे- एतस्मिन्नेव काले इत्यादिना॥१॥",
      "chapter": 274,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पौण्ड्रकवृत्तान्तारम्भः",
      "combined_translation": "2-2"
    },
    {
      "verse": 3,
      "sanskrit": "जिता च पृथिवी सर्वा जिताश्च नृपसत्तमाः। वृष्णयस्ते बलोन्मत्ताः कृष्णमाश्रित्य गर्विताः॥३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 274,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पौण्ड्रकवृत्तान्तारम्भः",
      "combined_translation": "3-3"
    },
    {
      "verse": 4,
      "sanskrit": "दास्यन्ति मे करं सर्वे न हि ते कृष्णसंश्रयात्। स तु कृष्णश्चक्रबलान्मामवज्ञाय तिष्ठति॥४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 274,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पौण्ड्रकवृत्तान्तारम्भः",
      "combined_translation": "4-4"
    },
    {
      "verse": 5,
      "sanskrit": "अहं चक्रीति गर्वोऽभूत्तस्य गोपस्य सर्वदा। शङ्खी चक्री गदी शार्ङ्गी शरी तूणी सहायवान्॥५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 274,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पौण्ड्रकवृत्तान्तारम्भः",
      "combined_translation": "5-5"
    },
    {
      "verse": 6,
      "sanskrit": "एवमादिर्महागर्वस्तस्य सम्प्रति वर्तते। लोके च मम यान्नाम वासुदेवेति विश्रुतम्॥६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 274,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पौण्ड्रकवृत्तान्तारम्भः",
      "combined_translation": "6-6"
    },
    {
      "verse": 7,
      "sanskrit": "अगृह्णान्मम तन्नाम गोपो मदबलान्वितः। तस्य चक्रस्य यच्चक्रं ममापि निशितं महत्॥७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 274,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पौण्ड्रकवृत्तान्तारम्भः",
      "combined_translation": "7-7"
    },
    {
      "verse": 8,
      "sanskrit": "गर्वहन्तृ सदा तस्य नाम्ना चापि सुदर्शनम्। सहस्रारं महाघोरं तस्य चक्रस्य नाशनम्॥८॥",
      "english": null,
      "bhavadeepa": "चक्रस्य नाशकमिति शेषः॥७॥",
      "chapter": 274,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पौण्ड्रकवृत्तान्तारम्भः",
      "combined_translation": "8-8"
    },
    {
      "verse": 9,
      "sanskrit": "अनेकमहतं चक्रं गोपजस्य नृपोत्तमाः। ममाप्येतद्धनुर्दिव्यं शार्ङ्गं नाम महारवम्॥९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 274,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पौण्ड्रकवृत्तान्तारम्भः",
      "combined_translation": "9-9"
    },
    {
      "verse": 10,
      "sanskrit": "गदा कौमोदकी नाम ममेयं बृहती दृढा। कालायससहस्रस्य भारेण सुकृता मया॥१०॥",
      "english": null,
      "bhavadeepa": "अनेकं बहुविग्रहम् अहतम् अप्रतिहृतं तादृशं ममापीति भावः॥९॥",
      "chapter": 274,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पौण्ड्रकवृत्तान्तारम्भः",
      "combined_translation": "10-10"
    },
    {
      "verse": 11,
      "sanskrit": "खड्गो नन्दकनामासौ ममायं विपुलो दृढः। अन्तकस्यान्तको घोरस्तस्य खड्गस्य नशकः॥११॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 274,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पौण्ड्रकवृत्तान्तारम्भः",
      "combined_translation": "11-11"
    },
    {
      "verse": 12,
      "sanskrit": "तत्रायं च गादी खड्गी शङ्खी चक्री तनुत्रवान्। युधि जेता च कृष्णस्य नात्र कार्या विचारणा॥१२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 274,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पौण्ड्रकवृत्तान्तारम्भः",
      "combined_translation": "12-12"
    },
    {
      "verse": 13,
      "sanskrit": "मां च ब्रूत नृपाश्चैव गदिनं चक्रिणं तथा। शङ्खिनं शार्ङ्गिणं वीरं ब्रूत नित्यं नृपोत्तमाः॥१३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 274,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पौण्ड्रकवृत्तान्तारम्भः",
      "combined_translation": "13-13"
    },
    {
      "verse": 14,
      "sanskrit": "वासुदेवेति मां ब्रूत न तु गोपं यदूत्तमम्। एकोऽहं वासुदेवो हि हत्वा तं गोपदारकम्॥१४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 274,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पौण्ड्रकवृत्तान्तारम्भः",
      "combined_translation": "14-14"
    },
    {
      "verse": 15,
      "sanskrit": "सख्युर्मम बलाद्धन्ता नरकस्य महात्मनः। मां तथा यदि न ब्रूत दण्ड्या भारशतैः शतम्॥१५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 274,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पौण्ड्रकवृत्तान्तारम्भः",
      "combined_translation": "15-15"
    },
    {
      "verse": 16,
      "sanskrit": "सुवर्णस्य च निष्कस्य धान्यस्य बहुशस्तदा। तथा ब्रुवति राजेन्द्रे मनसा दुस्सहं यथा॥१६॥",
      "english": null,
      "bhavadeepa": "“भारः स्याद्विंशतिस्तुलाः” तेषां भाराणां शतैः शतम् अयुतमित्यर्थः॥१५॥",
      "chapter": 274,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पौण्ड्रकवृत्तान्तारम्भः",
      "combined_translation": "16-16"
    },
    {
      "verse": 17,
      "sanskrit": "केचिल्लज्जासमायुक्ता आसंस्ते बलवत्तराः। रसज्ञा बलवीर्यस्य राजानस्ते सदा नृप॥१७॥",
      "english": null,
      "bhavadeepa": null,
