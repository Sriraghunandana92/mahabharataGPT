{
  "adhyaya_id": "P19_U03_A101",
  "book": 19,
  "parva_name": "हरिवंशः",
  "upaparva_name": "भविष्यपर्व",
  "adhyaya_name": "पौण्ड्रकवधः",
  "chapter": 284,
  "verse_count": 25,
  "verses": [
    {
      "verse": 1,
      "sanskrit": "वैशम्पायन उवाच।\n              ततः शरं समदाय वासुदेवः प्रतापवान्। पौण्ड्रं जघान सहसा निशितेन शरेण ह॥१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 284,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पौण्ड्रकवधः"
    },
    {
      "verse": 2,
      "sanskrit": "पौण्ड्रोऽथ वासुदेवस्तु शरैर्दशभिराशुगैः। वासुदेवं जघानाशु वार्ष्णेयं वृष्णिनन्दनम्॥२॥",
      "english": null,
      "bhavadeepa": "तत इति॥१॥",
      "chapter": 284,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पौण्ड्रकवधः",
      "combined_translation": "2-2"
    },
    {
      "verse": 3,
      "sanskrit": "दारुकं पञ्चविंशत्या हयान्दशभिरेव च। सप्तत्या वासुदेवं तु यादवं वासुदेवकः॥३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 284,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पौण्ड्रकवधः"
    },
    {
      "verse": 4,
      "sanskrit": "ततः प्रहस्य सुचिरं केशवः केशिसूदनः। धृष्टोऽसाविति मनसा सम्पूज्य यदुनन्दनः॥४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 284,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पौण्ड्रकवधः"
    },
    {
      "verse": 5,
      "sanskrit": "आकृष्य शार्ङ्गं बलवान्सन्धाय रिपुसूदनः। नाराचेन सुतीक्ष्णेन ध्वजं चिच्छेद केशवः॥५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 284,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पौण्ड्रकवधः"
    },
    {
      "verse": 6,
      "sanskrit": "सारथेश्च शिरः कायादाहृत्य यदुनन्दनः। अश्वांश्च चतुरो हत्वा चतुर्भिः सायकोत्तमैः॥६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 284,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पौण्ड्रकवधः"
    },
    {
      "verse": 7,
      "sanskrit": "रथं राज्ञः समाहत्य तदोभौ पार्ष्णिसारथी। चक्रं च तिलशः कृत्वा हसन्किञ्चिदिव स्थितः॥७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 284,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पौण्ड्रकवधः"
    },
    {
      "verse": 8,
      "sanskrit": "पौण्ड्रको वासुदेवस्तु रथादुत्प्लुत्य सत्वरः। आदाय निशितं खड्गं प्राहिणोत्केशवाय सः॥८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 284,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पौण्ड्रकवधः"
    },
    {
      "verse": 9,
      "sanskrit": "स खड्गं शतधा कृत्वा तूष्णीमासीच्च केशवः। ततः परं महाघोरं परिघं कालसम्मितम्॥९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 284,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पौण्ड्रकवधः"
    },
    {
      "verse": 10,
      "sanskrit": "गृहीत्वा वासुदेवाय वासुदेवं प्रतापवान्। प्राहिणोद्वृष्णिवीराय सर्वक्षत्रस्य पश्यतः॥१०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 284,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पौण्ड्रकवधः"
    },
    {
      "verse": 11,
      "sanskrit": "तद्द्विधं जगतां नाथश्चकार यदुनन्दनः। ततश्चक्रं महाघोरं सहस्रारं महाप्रभम्॥११॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 284,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पौण्ड्रकवधः"
    },
    {
      "verse": 12,
      "sanskrit": "त्रिंशद्भारसमायुक्तमायसास्यममित्रहा। आदायाथ महाराज केशवं वाक्यमब्रवीत्॥१२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 284,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पौण्ड्रकवधः"
    },
    {
      "verse": 13,
      "sanskrit": "पश्येदं निशितं घोरं तव चक्रविनाशनम्। अनेन तव गोविन्द दर्पं दर्पवतां वर॥१३॥",
      "english": null,
      "bhavadeepa": "आयसास्यम् आयसं लोहमयं तच्च तत् आस्यं क्षेप्यं तत् आयसास्यम्॥१२॥",
      "chapter": 284,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पौण्ड्रकवधः"
    },
    {
      "verse": 14,
      "sanskrit": "अपनेष्यामि वार्ष्णेय सर्वक्षत्रस्य पश्यतः। त्वामुद्दिश्य महाघोरं कृतमन्यद्दुरासदम्॥१४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 284,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पौण्ड्रकवधः"
    },
    {
      "verse": 15,
      "sanskrit": "यदि शक्तो हरे कृष्ण दारयेदं महास्पदम्। इत्युक्त्वा तच्छतगुणं भ्रामयित्वा महाबलः॥१५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 284,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पौण्ड्रकवधः"
    },
    {
      "verse": 16,
      "sanskrit": "चिक्षेपाथ महावीर्यः पौण्ड्रको नृपसत्तमः। अवप्लुत्य ततो देशात्तदुत्सृज्य महाबलः॥१६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 284,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पौण्ड्रकवधः"
    },
    {
      "verse": 17,
      "sanskrit": "सिंहनादं महाघोरं व्यनदद्वीर्यवांस्तदा। ततो विस्मयमापन्नो भगवान्देवकीसुतः॥१७॥",
      "english": null,
      "bhavadeepa": "अवप्लुत्य चक्रं वञ्चितवान् इत्यर्थः॥१६॥",
      "chapter": 284,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पौण्ड्रकवधः"
    },
    {
      "verse": 18,
      "sanskrit": "अहो वीर्यमहो धैर्यमस्य पौण्ड्रस्य दुःसहम्। इति मत्वा जगन्नाथ उत्थितश्च रथोत्तमात्॥१८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 284,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पौण्ड्रकवधः"
    },
    {
      "verse": 19,
      "sanskrit": "ततः शिलां समादाय प्रेषयामास केशवम्। तां शिलां प्रेषयामास तस्मै यदुकुलोद्वहः॥१९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 284,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पौण्ड्रकवधः"
    },
    {
      "verse": 20,
      "sanskrit": "पौण्ड्रेण सुचिरं कालं विक्रीड्य भगवान्हरिः। ततश्चक्रं समादाय निशितं रक्तभोजनम्॥२०॥",
      "english": null,
      "bhavadeepa": "तां प्रेषयामास निवर्तयामासेत्यर्थः॥१९॥",
      "chapter": 284,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पौण्ड्रकवधः"
    },
    {
      "verse": 21,
      "sanskrit": "दैत्यमांसप्रदिग्धाङ्गं नारीगर्भविमोचनम्। शातकुम्भमयं घोरं दैत्यदानवनाशनम्॥२१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 284,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पौण्ड्रकवधः"
    },
    {
      "verse": 22,
      "sanskrit": "सहस्रारं शतारं तदद्भुतं दैत्यभीषणम्। ऐश्वर्यवर्म परमं नित्यं सुरगणार्चितम्॥२२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 284,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पौण्ड्रकवधः"
    },
    {
      "verse": 23,
      "sanskrit": "विष्णुः कृष्णस्तथा शार्ङ्गी नित्ययुक्तः सदा हरिः। जघान तेन गोविन्दः पौण्ड्रकं नृपसत्तमम्॥२३॥",
      "english": null,
      "bhavadeepa": "सहस्रारं शतारमिति कार्यभेदात् रूपभेदः॥२२॥",
      "chapter": 284,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पौण्ड्रकवधः"
    },
    {
      "verse": 24,
      "sanskrit": "तस्य देहं विदार्याशु चक्रं पिशितभोजनम्। कृष्णस्याथ करं भूयः प्राप सर्वेश्वरस्य ह॥२४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 284,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पौण्ड्रकवधः"
    },
    {
      "verse": 25,
      "sanskrit": "ततः स पौण्ड्रको राजा गतासुः प्रापतद्भुवि। निहत्य भगवान्विष्णुर्दुर्विज्ञेयगतिः प्रभुः। प्रतिपेदे सुधर्मां तु यादवैः पूजितो हरिः॥२५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 284,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पौण्ड्रकवधः"
    }
  ]
}