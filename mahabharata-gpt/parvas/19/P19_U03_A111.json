{
  "adhyaya_id": "P19_U03_A111",
  "book": 19,
  "parva_name": "हरिवंशः",
  "upaparva_name": "भविष्यपर्व",
  "adhyaya_name": "श्रीकृष्णं प्रति दुर्वाससो वाक्यम्",
  "chapter": 294,
  "verse_count": 70,
  "verses": [
    {
      "verse": 1,
      "sanskrit": "वैशम्पायन उवाच।\n              अथ सर्वेश्वरो विष्णुः पद्मकिञ्जल्कलोचनः। श्यामः पीताम्बरः श्रीमान्प्रलम्बाम्बरभूषणः॥१॥",
      "english": null,
      "bhavadeepa": "एकरूपं मुख्यविग्रहं श्रीकृष्णम्॥१७॥",
      "chapter": 294,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णं प्रति दुर्वाससो वाक्यम्",
      "combined_translation": "1-18"
    },
    {
      "verse": 2,
      "sanskrit": "किरीटी श्रीपतिः कृष्णो नीलकुञ्चितमूर्धजः। अव्यक्तः शाश्वतो देवः सकलो निष्कलः शिवः॥२॥",
      "english": null,
      "bhavadeepa": "अथेति। पद्मकिञ्जल्कलोचनः किञ्जल्कपदं तद्वत्वात्पत्रेऽत्र ज्ञेयं तेन पद्मपत्रनेत्र इत्यर्थः॥१॥",
      "chapter": 294,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णं प्रति दुर्वाससो वाक्यम्",
      "combined_translation": "2-2"
    },
    {
      "verse": 3,
      "sanskrit": "क्रीडाविहारोपगतः कदाचिदभवद्धरिः। कुमारैरपरैः सार्धं सात्यकिप्रमुखैर्नृप॥३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 294,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णं प्रति दुर्वाससो वाक्यम्",
      "combined_translation": "3-3"
    },
    {
      "verse": 4,
      "sanskrit": "गोलक्रीडां सुधर्माया मध्ये यादवसत्तमः। चकार प्रियकृत्कृष्णो युयुधानेन केशवः॥४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 294,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णं प्रति दुर्वाससो वाक्यम्",
      "combined_translation": "4-4"
    },
    {
      "verse": 5,
      "sanskrit": "ममायं प्रथमो गोलस्तव पश्चाद्भविष्यति। इति ब्रुवंस्तदा विष्णुः सात्यकिं कमलेक्षणः॥५॥",
      "english": null,
      "bhavadeepa": "गोलक्रीडां गोलाकारैरक्षरैर्द्यूतक्रीडाम्॥४॥",
      "chapter": 294,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णं प्रति दुर्वाससो वाक्यम्",
      "combined_translation": "5-5"
    },
    {
      "verse": 6,
      "sanskrit": "पार्श्वस्था यादवास्तस्य वसुदेवपुरोगमाः। उद्धवप्रमुखा राजन्नासेदुः क्वचिदत्र वै॥६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 294,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णं प्रति दुर्वाससो वाक्यम्",
      "combined_translation": "6-6"
    },
    {
      "verse": 7,
      "sanskrit": "अन्यव्यापाररहितो भूतात्मा भूतभावनः। विजहार यथा रामः सुग्रीवेण पुरा नृप॥७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 294,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णं प्रति दुर्वाससो वाक्यम्",
      "combined_translation": "7-7"
    },
    {
      "verse": 8,
      "sanskrit": "मध्यन्दिने महाविष्णुः शैनेयेन सहाच्युतः। विक्रीड्य सुचिरं कृष्ण उपारंसीत्स यादवः॥८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 294,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णं प्रति दुर्वाससो वाक्यम्",
      "combined_translation": "8-8"
    },
    {
      "verse": 9,
      "sanskrit": "द्वास्थेन वारिताः पूर्वं द्वार्येव च समास्थिताः। इदमन्तरमित्येव विविशुस्तां सभां नृप॥९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 294,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णं प्रति दुर्वाससो वाक्यम्",
      "combined_translation": "9-9"
    },
    {
      "verse": 10,
      "sanskrit": "यतयो दीर्घतपसः पुरस्कृत्य तपोधनम्। दुर्वाससं सुमनसो ददृशुर्यादवेश्वरम्॥१०॥",
      "english": null,
      "bhavadeepa": "विशिशुस्तापसा इति शेषः॥९॥",
      "chapter": 294,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णं प्रति दुर्वाससो वाक्यम्",
      "combined_translation": "10-10"
    },
    {
      "verse": 11,
      "sanskrit": "गोलक्रीडासमासक्तं करसंस्थितगोलकम्। पद्मपत्रविशालाक्षं विष्णुं तं सात्यकिं हरिम्॥११॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 294,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णं प्रति दुर्वाससो वाक्यम्",
      "combined_translation": "11-11"
    },
    {
      "verse": 12,
      "sanskrit": "एकेनाक्ष्णा ह्लादयन्तं परेणान्येन गोलकम्। यतयश्च महाराज प्रत्यदृश्यन्त तत्पुरः॥१२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 294,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णं प्रति दुर्वाससो वाक्यम्",
      "combined_translation": "12-12"
    },
    {
      "verse": 13,
      "sanskrit": "वृष्णिपः पुण्डरीकाक्षः सात्यकिर्बलभद्रकः। वसुदेवस्तथाक्रूर उग्रसेनस्तथा नृप॥१३॥",
      "english": null,
      "bhavadeepa": "ह्लादयन्तं मुनीन्। गोलकं पश्यन्तम्॥१२॥",
      "chapter": 294,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णं प्रति दुर्वाससो वाक्यम्",
      "combined_translation": "13-13"
    },
    {
      "verse": 14,
      "sanskrit": "अन्ये च यादवाः सर्वे सम्भ्रमं प्रतिपेदिरे। इदं किमिदमित्येवं व्याशङ्कमनसोऽभवन्॥१४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 294,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णं प्रति दुर्वाससो वाक्यम्",
      "combined_translation": "14-14"
    },
    {
      "verse": 15,
      "sanskrit": "पृष्ठतोऽप्यनुगच्छन्ति दिधक्षन्तं जगत्त्रयम्। अर्धकौपीनवसनं स्मरन्तं कमपि द्विजम्॥१५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 294,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णं प्रति दुर्वाससो वाक्यम्",
      "combined_translation": "15-15"
    },
    {
      "verse": 16,
      "sanskrit": "अन्तस्तापसमायुक्तं छिन्नदण्डधरं यतिम्। अन्तर्ज्वलन्तं रोषेण हंसासादितकल्मषम्॥१६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 294,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णं प्रति दुर्वाससो वाक्यम्",
      "combined_translation": "16-16"
    },
    {
      "verse": 17,
      "sanskrit": "नेत्रोत्थितमहावह्निं प्रेक्षन्तं यादवेश्वरम्। दुर्वाससं ते ददृशुर्भीता यादवसत्तमाः॥१७॥",
      "english": null,
      "bhavadeepa": "हंसेन राज्ञा आसादितकल्मषं प्रापितदुःखम्॥१६॥",
      "chapter": 294,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णं प्रति दुर्वाससो वाक्यम्",
      "combined_translation": "17-17"
    },
    {
      "verse": 18,
      "sanskrit": "किं करिष्यत्यसौ क्रुद्धः किं वा वक्ष्यति नः प्रभुः। इति प्राञ्जलयः सर्वे यादवाः प्रतिपेदिरे॥१८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 294,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णं प्रति दुर्वाससो वाक्यम्",
      "combined_translation": "18-18"
    },
    {
      "verse": 19,
      "sanskrit": "इदमासनमित्येवं किञ्चिदूचुश्च वृष्णयः। ततः कृष्णो हृषीकेषः किञ्चिदुत्प्लुत्य तत्पुरः॥१९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 294,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णं प्रति दुर्वाससो वाक्यम्",
      "english_ref": 1,
      "combined_translation": "1-19"
    },
    {
      "verse": 20,
      "sanskrit": "इदमासनमित्येवं स्थीयतामिह निर्वृतः। अहमद्य स्थितो विप्र किं करोऽस्मीति चाब्रवीत्॥२०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 294,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णं प्रति दुर्वाससो वाक्यम्"
    },
    {
      "verse": 21,
      "sanskrit": "ततः किञ्चिदिवासीन आसने यतिविग्रहः। आसने संस्थिते तस्मिन्यतयो वीतमत्सराः॥२१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 294,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णं प्रति दुर्वाससो वाक्यम्"
    },
    {
      "verse": 22,
      "sanskrit": "आसनानि यथायोगं भेजिरे निर्वृताः किल। अर्घ्यादिसमुदाचारं चक्रे कृष्णः किरीटभृत्॥२२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 294,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णं प्रति दुर्वाससो वाक्यम्"
    },
    {
      "verse": 23,
      "sanskrit": "आह भूयो हृषीकेशो यातिं दुर्वाससं प्रभुम्। किमर्थं ब्रूहि विप्रेन्द्र अस्मिन्प्रत्यागमो हि वः॥२३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 294,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णं प्रति दुर्वाससो वाक्यम्"
    },
    {
      "verse": 24,
      "sanskrit": "दृष्टं वा ह्यथवा किञ्चित्कारणं चास्ति वो महत्। संन्यासिनो द्विजश्रेष्ठा यूयं विगतकल्मषाः॥२४॥",
      "english": null,
      "bhavadeepa": "अस्मिन् स्थाने॥२३॥",
      "chapter": 294,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णं प्रति दुर्वाससो वाक्यम्"
    },
    {
      "verse": 25,
      "sanskrit": "निःस्पृहाश्च सदा यूयमस्मत्तो द्विजपुङ्गवाः। प्रार्थ्यं नाम न चैवास्ति स्पृहा नैवास्ति वो यतः॥२५॥",
      "english": null,
      "bhavadeepa": "किञ्चिद्दृष्टं वा द्वयम् उभयत्र यथाक्रमं योज्यम्॥२४॥",
      "chapter": 294,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णं प्रति दुर्वाससो वाक्यम्"
    },
    {
      "verse": 26,
      "sanskrit": "स्पृहाप्रेरितकर्माणः क्षत्रियान्यान्ति सुव्रताः। निरूप्यमाणमस्माभिर्विप्र किञ्चिन्न दृश्यते॥२६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 294,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णं प्रति दुर्वाससो वाक्यम्"
    },
    {
      "verse": 27,
      "sanskrit": "न जाने कारणं ब्रह्मन्युष्मदागमनं प्रति। एतावता चानुमेयं किञ्चित्कारणमस्ति वै॥२७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 294,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णं प्रति दुर्वाससो वाक्यम्"
    },
    {
      "verse": 28,
      "sanskrit": "तद्ब्रूहि यदि विद्येत त्वत्तो ज्ञास्यामहे वयम्। इत्युक्तवति देवेशे चक्रपाणौ जनार्दने॥२८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 294,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णं प्रति दुर्वाससो वाक्यम्"
    },
    {
      "verse": 29,
      "sanskrit": "तस्यापि राजन्विप्रस्य भूयः कोपो महानभूत्। तस्मादभ्यधिकः पूर्वात्कोपः सञ्जायते महान्॥२९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 294,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णं प्रति दुर्वाससो वाक्यम्"
    },
    {
      "verse": 30,
      "sanskrit": "दिधक्षन्निव लोकांस्त्रीन्भक्षयन्निव पश्यतः। रोषरक्तेक्षणः क्रुद्धो हसन्निव दहन्निव॥३०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 294,
