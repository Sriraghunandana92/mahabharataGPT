  "adhyaya_name": "घण्टाकर्णस्य विष्णुसाक्षात्कारलाभः",
  "chapter": 264,
  "verse_count": 21,
  "verses": [
    {
      "verse": 1,
      "sanskrit": "वैशम्पायन उवाच।\n              ततः स भगवान्विष्णुः पिशाचं दृष्टवांस्तदा। चिन्तयन्तं स्वमात्मानं शुद्धिबुद्धिसमन्वितम्॥१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 264,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "घण्टाकर्णस्य विष्णुसाक्षात्कारलाभः"
    },
    {
      "verse": 2,
      "sanskrit": "आत्मन्यवस्थितं साक्षात्पठन्तं प्रणवं सकृत्। प्रार्थयन्तं स्वमात्मानमेकान्ते नियतं हरिः॥२॥",
      "english": null,
      "bhavadeepa": "तत इति॥१॥",
      "chapter": 264,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "घण्टाकर्णस्य विष्णुसाक्षात्कारलाभः",
      "combined_translation": "2-2"
    },
    {
      "verse": 3,
      "sanskrit": "अचिन्तयज्जगन्नाथः कारणं पुण्यसञ्चये। ध्यात्वा तु सुचिरं विष्णुः कारणं पुण्यकर्मणः॥३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 264,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "घण्टाकर्णस्य विष्णुसाक्षात्कारलाभः"
    },
    {
      "verse": 4,
      "sanskrit": "धनदस्योपदेशेन पठन्सुबहुशः क्षितौ। वासुदेवेति कृष्णेति माधवेति च मां सदा॥४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 264,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "घण्टाकर्णस्य विष्णुसाक्षात्कारलाभः",
      "combined_translation": "4-4"
    },
    {
      "verse": 5,
      "sanskrit": "जनार्दन हरे विष्णो भूतभावनभावन। नराकार जगन्नाथ नारायण परायण॥५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 264,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "घण्टाकर्णस्य विष्णुसाक्षात्कारलाभः",
      "combined_translation": "5-5"
    },
    {
      "verse": 6,
      "sanskrit": "इति मां नामभिर्नित्यं पठत्येव दिवानिशम्। स्वपञ्जाग्रांस्तथा तिष्ठन्भुञ्जन्गच्छंस्तथा वदन्॥६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 264,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "घण्टाकर्णस्य विष्णुसाक्षात्कारलाभः",
      "combined_translation": "6-6"
    },
    {
      "verse": 7,
      "sanskrit": "भक्षयन्मांसपिटकं पिबञ्च्छोणितमेव वा। बाधमानं च सुचिरं हत्वा चापि मृगान्बहून्॥७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 264,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "घण्टाकर्णस्य विष्णुसाक्षात्कारलाभः",
      "combined_translation": "7-7"
    },
    {
      "verse": 8,
      "sanskrit": "हनने भोजने चैष जाग्रत्स्वप्ने तथैव च। सर्वेष्वपि च कार्येषु कर्ताहमिति मन्यते॥८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 264,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "घण्टाकर्णस्य विष्णुसाक्षात्कारलाभः",
      "combined_translation": "8-8"
    },
    {
      "verse": 9,
      "sanskrit": "एतस्य कर्मणः पाक एष घोरस्य कर्मणः। निश्चित्यैवं जगन्नाथः प्रीतस्तस्य बभूव ह॥९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 264,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "घण्टाकर्णस्य विष्णुसाक्षात्कारलाभः",
      "combined_translation": "9-9"
    },
    {
      "verse": 10,
      "sanskrit": "अदर्शयत्स्वमात्मानमनन्यस्य जगत्पतिः। शुद्धेऽन्तःकरणे तस्य पिशाचस्यापि भूमिप॥१०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 264,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "घण्टाकर्णस्य विष्णुसाक्षात्कारलाभः"
    },
    {
      "verse": 11,
      "sanskrit": "स च घोरः पिशाचोऽपि ददर्शात्मनि केशवम्। पीतकौशेयवसनं पद्माक्षं श्यामलं हरिम्॥११॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 264,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "घण्टाकर्णस्य विष्णुसाक्षात्कारलाभः",
      "combined_translation": "11-11"
    },
    {
      "verse": 12,
      "sanskrit": "शङ्खिनं चक्रिणं विष्णुं स्रग्विणं गदिनं विभुम्। किरीटिनं कौस्तुभिनं श्रीवत्साच्छादितोरसम्॥१२॥",
      "english": null,
      "bhavadeepa": "आत्मनि हृदयपङ्कजे॥११॥",
      "chapter": 264,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "घण्टाकर्णस्य विष्णुसाक्षात्कारलाभः",
      "combined_translation": "12-12"
    },
    {
      "verse": 13,
      "sanskrit": "नीलमेघनिभं कान्तं गरुडस्थं प्रभञ्जनम्। चतुर्भुजं शुभगिरं निश्चलं सर्वगं शिवम्॥१३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 264,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "घण्टाकर्णस्य विष्णुसाक्षात्कारलाभः",
      "combined_translation": "13-13"
    },
    {
      "verse": 14,
      "sanskrit": "अनादिनिधनं नित्यं मायाविनममायिनम्। सत्ययुक्तं सदा शुद्धं बुद्धिगम्यं सदामलम्॥१४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 264,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "घण्टाकर्णस्य विष्णुसाक्षात्कारलाभः",
      "combined_translation": "14-14"
    },
    {
      "verse": 15,
      "sanskrit": "मनस्येवं जगन्नाथं दृष्ट्वा विष्णुमनेकधा। अनुन्मील्यैव नयने कृतार्थोऽस्मीत्यमन्यत॥१५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 264,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "घण्टाकर्णस्य विष्णुसाक्षात्कारलाभः",
      "combined_translation": "15-15"
    },
    {
      "verse": 16,
      "sanskrit": "अथ दृष्टो हरिर्विष्णुः साक्षात्सर्वत्रगः शुभः। प्रसन्नो हि हरिर्मह्यं तेनाहं दृष्टवान्हरिम्॥१६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 264,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "घण्टाकर्णस्य विष्णुसाक्षात्कारलाभः",
      "combined_translation": "16-16"
    },
    {
      "verse": 17,
      "sanskrit": "सिद्धं मे जन्मनः कृत्यं किमतः कृत्यमस्ति मे। ग्रन्थयो मम निर्भिन्ना वश्यान्येवेन्द्रियाणि मे॥१७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 264,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "घण्टाकर्णस्य विष्णुसाक्षात्कारलाभः",
      "combined_translation": "17-17"
    },
    {
      "verse": 18,
      "sanskrit": "प्रायेण जितमित्येव मनो मन्ये स्मृते हरौ। ईषणा च निरस्ता मे प्रसन्नोऽहं तथाभवम्॥१८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 264,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "घण्टाकर्णस्य विष्णुसाक्षात्कारलाभः",
      "combined_translation": "18-18"
    },
    {
      "verse": 19,
      "sanskrit": "एतेभ्योऽपि पिशाचेभ्यो निर्मुक्तः साम्प्रतं तथा। योऽसौ ममानुजः साक्षात्स च भक्तस्तथा हरौ॥१९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 264,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "घण्टाकर्णस्य विष्णुसाक्षात्कारलाभः",
      "combined_translation": "19-19"
    },
    {
      "verse": 20,
      "sanskrit": "कालेन चैव निर्मुक्तो विष्णोः सायुज्यमाप्नुयात्। इत्येवं चिन्तयित्वा स आन्त्रपाशं विभिद्य च॥२०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 264,
      "parva_name": "हरिवंशः",
