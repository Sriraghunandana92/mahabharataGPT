{
  "adhyaya_id": "P19_U03_A121",
  "book": 19,
  "parva_name": "हरिवंशः",
  "upaparva_name": "भविष्यपर्व",
  "adhyaya_name": "उभयसैन्ययोः पुष्करतीर्थप्रवेशः",
  "chapter": 304,
  "verse_count": 27,
  "verses": [
    {
      "verse": 1,
      "sanskrit": "वैशम्पायन उवाच।\n              अथ तौ हंसडिम्भकौ जग्मतुः पुष्करं प्रति। प्रगृहीतमहाचापौ सरथौ सध्वजौ नृप॥१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 304,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "उभयसैन्ययोः पुष्करतीर्थप्रवेशः",
      "combined_translation": "1-20"
    },
    {
      "verse": 2,
      "sanskrit": "पुरःसरमहाभूतौ संहरन्ताविवोल्बणौ। प्रकुर्वन्तौ सिंहरवं भस्मना परिलेपितौ॥२॥",
      "english": null,
      "bhavadeepa": "अथेति॥१॥",
      "chapter": 304,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "उभयसैन्ययोः पुष्करतीर्थप्रवेशः",
      "combined_translation": "2-2"
    },
    {
      "verse": 3,
      "sanskrit": "त्रिपुण्ड्रकललाटान्तौ रुद्राक्षपरिशोभितौ। अन्यौ द्वाविव रुद्रौ तौ लोकसंहारकारकौ॥३॥",
      "english": null,
      "bhavadeepa": "पुरःसरौ च तौ महाभूतौ चेति विग्रहः॥२॥",
      "chapter": 304,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "उभयसैन्ययोः पुष्करतीर्थप्रवेशः",
      "combined_translation": "3-3"
    },
    {
      "verse": 4,
      "sanskrit": "ततोऽनुजग्मुः शतशः सैन्यानि नृपसत्तम। अक्षौहिण्यो दशैवासंस्तयोरथ समागताः॥४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 304,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "उभयसैन्ययोः पुष्करतीर्थप्रवेशः",
      "combined_translation": "4-4"
    },
    {
      "verse": 5,
      "sanskrit": "विचक्रस्तु महाराज दानवो नगसन्निभः। तयोरेव सखा पूर्वमासीच्च बलशालिनोः॥५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 304,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "उभयसैन्ययोः पुष्करतीर्थप्रवेशः",
      "combined_translation": "5-5"
    },
    {
      "verse": 6,
      "sanskrit": "शक्रो यस्य पुरःसरः स्थातुं शक्तो न वज्रभृत्। यो हि वीरो महाराज देवदैत्यसमागमे॥६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 304,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "उभयसैन्ययोः पुष्करतीर्थप्रवेशः",
      "combined_translation": "6-6"
    },
    {
      "verse": 7,
      "sanskrit": "देवान्निघ्नंस्तथा राजन्देवेन्द्रमजयन्महान्। अकरोच्च पुरा युद्धं विष्णुना प्रभविष्णुना॥७॥",
      "english": null,
      "bhavadeepa": "पुरसरः पुरोगामी। विसर्गलोपः पूर्वपदे आर्षः॥६॥",
      "chapter": 304,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "उभयसैन्ययोः पुष्करतीर्थप्रवेशः",
      "combined_translation": "7-7"
    },
    {
      "verse": 8,
      "sanskrit": "यो हि द्वारवतीं प्राप्य बबाधे यदुपुङ्गवान् । स तदानीं महाराज श्रुत्वा युद्धमुपस्थितम्॥८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 304,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "उभयसैन्ययोः पुष्करतीर्थप्रवेशः",
      "combined_translation": "8-8"
    },
    {
      "verse": 9,
      "sanskrit": "अनेकशतसाहस्रैर्दानवैः परिघायुधैः। वृतः समभवद्दैत्यो वृष्णिद्वेषान्नृपोत्तम॥९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 304,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "उभयसैन्ययोः पुष्करतीर्थप्रवेशः",
      "combined_translation": "9-9"
    },
    {
      "verse": 10,
      "sanskrit": "हंसस्य डिम्भकस्याथ साहाय्यं कर्तुमुद्यतः। विचक्रस्याथ दैत्यस्य हिडिम्बो राक्षसेश्वरः॥१०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 304,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "उभयसैन्ययोः पुष्करतीर्थप्रवेशः"
    },
    {
      "verse": 11,
      "sanskrit": "अतिव मित्रतां यातो दद्यात्प्राणांश्च संयति। राक्षसैरपरैः सार्धं शिलाशूलासिपाणिभिः॥११॥",
      "english": null,
      "bhavadeepa": "यो हि पुरा वृतः समभवत्स एव विचक्रः तस्य विचक्रस्य वृतस्य मित्रतां यातो हिडिम्बो नाम राक्षसेश्वर इति योजना॥१०॥",
      "chapter": 304,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "उभयसैन्ययोः पुष्करतीर्थप्रवेशः",
      "combined_translation": "11-11"
    },
    {
      "verse": 12,
      "sanskrit": "ययौ तस्य सहायार्थं हिडिम्बः पुरुषादपः। अष्टाशीति सहस्राणि राक्षसास्तस्य चाभवन्॥१२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 304,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "उभयसैन्ययोः पुष्करतीर्थप्रवेशः",
      "combined_translation": "12-12"
    },
    {
      "verse": 13,
      "sanskrit": "अनुयाता महाराज शिलापरिघबाहवः। तयोस्तत्र महासैन्यं गच्छतोः केशवं प्रति॥१३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 304,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "उभयसैन्ययोः पुष्करतीर्थप्रवेशः",
      "combined_translation": "13-13"
    },
    {
      "verse": 14,
      "sanskrit": "मिश्रितं दैत्यसङ्घैश्च राक्षसैश्च समन्ततः। अत्यद्भुतं महारौद्रं त्रैलोक्यभयदायकम्॥१४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 304,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "उभयसैन्ययोः पुष्करतीर्थप्रवेशः",
      "combined_translation": "14-14"
    },
    {
      "verse": 15,
      "sanskrit": "दैत्येन सहितौ तौ हि जग्मतुः पुष्करं प्रति। तावेतौ हंसडिम्भकौ हन्तुं केशवमञ्जसा॥१५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 304,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "उभयसैन्ययोः पुष्करतीर्थप्रवेशः",
      "combined_translation": "15-15"
    },
    {
      "verse": 16,
      "sanskrit": "ततः श्रुत्वा जरासन्धो विग्रहं यदुभिः सह। नाकरोन्नृपसाहाय्यं पापं मे भवितेति ह॥१६॥",
      "english": null,
      "bhavadeepa": "दैत्येन विचक्रेण तेन हिडिम्बेन॥१५॥",
      "chapter": 304,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "उभयसैन्ययोः पुष्करतीर्थप्रवेशः",
      "combined_translation": "16-16"
    },
    {
      "verse": 17,
      "sanskrit": "गच्छतोः समितिं राजन्हंसस्य डिम्भकस्य च। अतित्वरितविक्रान्तास्ते ययुः पुष्करं प्रति॥१७॥",
      "english": null,
      "bhavadeepa": "नृपसाहाय्यं हंसडिम्भकयोः सहाय्यं विग्रहमपि ताभ्यां सह च शापः परासक्तः परेण हन्तव्य इति शास्त्रातिक्रमजो दोषः॥१६॥",
      "chapter": 304,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "उभयसैन्ययोः पुष्करतीर्थप्रवेशः",
      "combined_translation": "17-17"
    },
    {
      "verse": 18,
      "sanskrit": "सिंहनादं विमुञ्चन्तः कथयन्तः परस्परम्। अहमेव नृपा युद्धं करोमि प्रथमं हरेः॥१८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 304,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "उभयसैन्ययोः पुष्करतीर्थप्रवेशः",
      "combined_translation": "18-18"
    },
    {
      "verse": 19,
      "sanskrit": "इत्यब्रुवन्नृपा राजञ्छतशः केशवं प्रति। सम्प्राप्तास्ते नृपश्रेष्ठाः पुष्करं पुण्यवर्धनम्॥१९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 304,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "उभयसैन्ययोः पुष्करतीर्थप्रवेशः",
      "combined_translation": "19-19"
    },
    {
      "verse": 20,
      "sanskrit": "मुनिजुष्टं तपोवृद्धैर्ऋषिभिश्च निषेवितम्। अत्यन्तभद्रं लोकेषु पुष्करं प्रथमं नृप॥२०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 304,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "उभयसैन्ययोः पुष्करतीर्थप्रवेशः",
      "combined_translation": "20-20"
    },
    {
      "verse": 21,
      "sanskrit": "पुष्करं पुण्डरिकाक्षो द्वावेव जगतीपते। दर्शनात्स्पर्शनाच्चैव किल्बिषच्छेदिनौ नृप॥२१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 304,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "उभयसैन्ययोः पुष्करतीर्थप्रवेशः",
      "combined_translation": "21-21"
    },
    {
      "verse": 22,
      "sanskrit": "पुष्करं पुण्डरिकाक्षौ द्वावेव नृपसत्तम। सेव्यमानौ मुनिश्रेष्ठैरमरौघैर्महात्मभिः॥२२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 304,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "उभयसैन्ययोः पुष्करतीर्थप्रवेशः",
      "combined_translation": "22-22"
    },
    {
      "verse": 23,
      "sanskrit": "द्वावेव हि नृपश्रेष्ठ सर्वपापप्रणाशकौ। तावुभौ यत्र सहितौ तत्र ते संस्थिता नृपाः॥२३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 304,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "उभयसैन्ययोः पुष्करतीर्थप्रवेशः",
      "combined_translation": "23-23"
    },
    {
      "verse": 24,
      "sanskrit": "दृष्टवन्तौ हरिं विष्णुं विष्टरश्रवसं परम्। पुष्करं पुण्यनिलयं तीर्थं ब्रह्मनिषेवितम्॥२४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 304,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "उभयसैन्ययोः पुष्करतीर्थप्रवेशः",
      "combined_translation": "24-24"
    },
    {
      "verse": 25,
      "sanskrit": "ताभ्यां कुरु नमस्कारं मनसा नृपसत्तम। अहो निःशेषमभवत्तत्र भूयो न संशयः॥२५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 304,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "उभयसैन्ययोः पुष्करतीर्थप्रवेशः",
      "combined_translation": "25-25"
    },
    {
      "verse": 26,
      "sanskrit": "सैन्यं तत्र च सम्प्राप्तं दैत्यरक्षःसमाकुलम्। अनेकभेरीपणवझर्झरीडिण्डिमाकुलम्॥२६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 304,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "उभयसैन्ययोः पुष्करतीर्थप्रवेशः",
      "combined_translation": "26-26"
    },
    {
      "verse": 27,
      "sanskrit": "नानापणवसंमिश्रं रक्षोनादविनादितम्। प्रविश्य सरसस्तीरं पुष्करस्य विशाम्पते। दर्शयामास देवेशं युद्धाय समुपस्थितम्॥२७॥",
      "english": null,
      "bhavadeepa": "“ताभ्यां कुरु नमस्कारम्” इति वैशम्पायनदिव्यदृष्ट्या तमप्यर्थं वर्तमानवत्पश्यन् जनमेजयं प्रेरयति। जनमेजये तादृशं शब्दजन्यपरोक्षं ज्ञानं सम्भावयन् कथामेवानुसन्धत्ते- सैन्यमिति। सैन्यं कर्तृ। देवेशं दर्शयामास। अयं कृष्णोऽयं कृष्ण इत्यन्योन्यं दर्शयामासेत्यर्थः। द्वयोः सम्बन्धः॥२६॥",
      "chapter": 304,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "उभयसैन्ययोः पुष्करतीर्थप्रवेशः",
      "combined_translation": "27-27"
    }
  ]
}