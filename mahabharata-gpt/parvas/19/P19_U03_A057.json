{
  "adhyaya_id": "P19_U03_A057",
  "book": 19,
  "parva_name": "हरिवंशः",
  "upaparva_name": "भविष्यपर्व",
  "adhyaya_name": "देवासुरयुद्धे वृत्रासुरोत्कर्षवर्णनम्",
  "chapter": 240,
  "verse_count": 69,
  "verses": [
    {
      "verse": 1,
      "sanskrit": "वैशम्पायन उवाच।\n              ततः सर्वाणि सैन्यानि देवराजस्य शासनात्। अभ्यद्रवन्त दितिजान्नदन्तो भैरवान् रवान्॥१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 240,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे वृत्रासुरोत्कर्षवर्णनम्"
    },
    {
      "verse": 2,
      "sanskrit": "तं बलौघमपर्यन्तं देवानां सुदुरासदम्। रथनागाश्वकलिलं शङ्खदुन्दुभिनिःस्वनम्॥२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 240,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे वृत्रासुरोत्कर्षवर्णनम्"
    },
    {
      "verse": 3,
      "sanskrit": "आपतन्तं सुदुष्पारं रजसा सर्वतो वृतम्। सैन्यसागरमक्षोभ्यं वेलेव मकरालयम्॥३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 240,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे वृत्रासुरोत्कर्षवर्णनम्",
      "combined_translation": "3-3"
    },
    {
      "verse": 4,
      "sanskrit": "तदाश्चर्यमपश्यन्त अश्रद्धेयमिवाद्भुतम्। उदीर्णां पृतनां सर्वां साश्वां सरथकुञ्जराम्॥४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 240,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे वृत्रासुरोत्कर्षवर्णनम्",
      "combined_translation": "4-4"
    },
    {
      "verse": 5,
      "sanskrit": "आचार्यः समरेऽतिष्ठत्कुजम्भस्तरसा बली। सैन्यार्णवं देवतानां गिरिर्मेरुरिवाचलः॥५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 240,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे वृत्रासुरोत्कर्षवर्णनम्",
      "combined_translation": "5-5"
    },
    {
      "verse": 6,
      "sanskrit": "अनीकिनं कुजम्भस्तु गदया स न्यवारयत्। सा तथा वारिता सेना विह्वलाभून्निरुद्यमा॥६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 240,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे वृत्रासुरोत्कर्षवर्णनम्",
      "combined_translation": "6-6"
    },
    {
      "verse": 7,
      "sanskrit": "तस्मिंस्तथा वर्तमाने सम्प्रहारे सुदारुणे। असिलोमा तु बलवान्दानवो दानवाधिपः॥७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 240,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे वृत्रासुरोत्कर्षवर्णनम्",
      "combined_translation": "7-7"
    },
    {
      "verse": 8,
      "sanskrit": "देवसैन्यस्य सर्वस्य धूमकेतुरिवोत्थितः। तमांस्यर्क इवापोह्यत्सुरसैन्यानि संयुगे॥८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 240,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे वृत्रासुरोत्कर्षवर्णनम्",
      "combined_translation": "8-8"
    },
    {
      "verse": 9,
      "sanskrit": "सहस्ररश्मिप्रतिमो दानवस्य रथोत्तमः। शरैर्मेघ इवावर्षद्देवानीकं प्रतापवान्॥९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 240,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे वृत्रासुरोत्कर्षवर्णनम्",
      "combined_translation": "9-9"
    },
    {
      "verse": 10,
      "sanskrit": "शरौघरश्मिभिर्दीप्तैः प्रतप्तो घोरविक्रमः। रौद्रः क्रूरो दुराधर्षो दुरापो ध्वजिनीमुखे॥१०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 240,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे वृत्रासुरोत्कर्षवर्णनम्",
      "combined_translation": "10-10"
    },
    {
      "verse": 11,
      "sanskrit": "युध्यते दैवतैः सार्धं ग्रसमान इव प्रभुः। उग्रेषुरुग्रवदनः समारुह्य महागजम्॥११॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 240,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे वृत्रासुरोत्कर्षवर्णनम्",
      "combined_translation": "11-11"
    },
    {
      "verse": 12,
      "sanskrit": "सुराणामुत्तमाङ्गानि प्रचिनोति महाबलः। ग्रसन्दैवतसैन्यानि शरदंष्ट्रः प्रताप्वान्॥१२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 240,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे वृत्रासुरोत्कर्षवर्णनम्",
      "combined_translation": "12-12"
    },
    {
      "verse": 13,
      "sanskrit": "असिजिह्वश्चक्रहस्तश्चापव्यात्ताननोऽसुरः। परश्वधनखः श्रीमान्मृदङ्गापूरितध्वनिः॥१३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 240,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे वृत्रासुरोत्कर्षवर्णनम्",
      "combined_translation": "13-13"
    },
    {
      "verse": 14,
      "sanskrit": "तिष्ठते दानवश्रेष्ठः संयुगे व्याघ्रवद्बली। मौर्वीघोषः स्तनयितुः पृषत्कः प्रथितो महान्॥१४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 240,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे वृत्रासुरोत्कर्षवर्णनम्",
      "combined_translation": "14-14"
    },
    {
      "verse": 15,
      "sanskrit": "धनुर्विद्युद्गणश्चापो महामेघ इवापरः। इष्वस्त्रसागरो घोरो बाहुग्राहो दुरासदः॥१५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 240,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे वृत्रासुरोत्कर्षवर्णनम्",
      "combined_translation": "15-15"
    },
    {
      "verse": 16,
      "sanskrit": "कार्मुकोर्मितरङ्गौघैर्बाणावर्तमहाह्रदः। गदासिमकरो रौद्रो ज्यावेलः शिक्षयोद्धतः॥१६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 240,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे वृत्रासुरोत्कर्षवर्णनम्",
      "combined_translation": "16-16"
    },
    {
      "verse": 17,
      "sanskrit": "पदातिमीनः सुमहान्गर्जितोत्क्रुष्टघोषवान्। हयान्गजान्पदातींश्च रथांश्च सहसा बहून्॥१७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 240,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे वृत्रासुरोत्कर्षवर्णनम्",
      "combined_translation": "17-17"
    },
    {
      "verse": 18,
      "sanskrit": "न्यमज्जयत समरे परवीरान्महारथान्। आप्लावयत्स देवौघान्दारुणो दानवेश्वरः॥१८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 240,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे वृत्रासुरोत्कर्षवर्णनम्",
      "combined_translation": "18-18"
    },
    {
      "verse": 19,
      "sanskrit": "प्रावर्तत युधि श्रीमान्युधि श्रेष्ठो युधिष्ठिरः। अपश्यंस्त्रिदशाः सर्वे शुद्धजाम्बूनदप्रभम्॥१९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 240,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे वृत्रासुरोत्कर्षवर्णनम्",
      "combined_translation": "19-19"
    },
    {
      "verse": 20,
      "sanskrit": "सन्नद्धं तत्र युध्यन्तं ज्वलन्तमिव पावकम्। मध्यन्दिनगतं सूर्यं ज्वलन्तमिव तेजसा॥२०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 240,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे वृत्रासुरोत्कर्षवर्णनम्",
      "combined_translation": "20-20"
    },
    {
      "verse": 21,
      "sanskrit": "न शेकुः सर्वभूतानि दानवं प्रसमीक्षितुम्। यथा प्ररूढं घर्मान्ते दहेत्कक्षं हुताशनः॥२१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 240,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे वृत्रासुरोत्कर्षवर्णनम्",
      "combined_translation": "21-21"
    },
    {
      "verse": 22,
      "sanskrit": "तथासुरवरो दैत्यो दहति स्म सुतेजसा। देवानां दानवानां च बलं मर्दति दारुणम्॥२२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 240,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे वृत्रासुरोत्कर्षवर्णनम्",
      "combined_translation": "22-22"
    },
    {
      "verse": 23,
      "sanskrit": "विरूढमभवत्सर्वमाकुलं च समन्ततः। शूराश्च ते बलोदग्रा हस्त्यश्वरथधूर्गताः॥२३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 240,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे वृत्रासुरोत्कर्षवर्णनम्",
      "combined_translation": "23-23"
    },
    {
      "verse": 24,
      "sanskrit": "आर्यां बुद्धिं समास्थाय न त्यजन्ति महारणम्। तदुत्पिञ्जलकं युद्धमभवद्रोमहर्षणम्॥२४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 240,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे वृत्रासुरोत्कर्षवर्णनम्",
      "combined_translation": "24-24"
    },
    {
      "verse": 25,
      "sanskrit": "देवदानवयोः सङ्ख्ये रुधिरस्रावकर्दमम्। न दिशः प्रत्यजानन्त भयग्राहनिपीडिताः॥२५॥",
      "english": null,
      "bhavadeepa": "उत्पुञ्जलकम् आकुलत्वम्॥२४॥",
      "chapter": 240,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे वृत्रासुरोत्कर्षवर्णनम्",
      "combined_translation": "25-25"
    },
    {
      "verse": 26,
      "sanskrit": "शस्त्रपातांश्च विविधान्दानवानां महारणे। अन्योन्यं मूढचित्तास्ते निजघ्नुर्व्याकुलीकृताः॥२६॥",
      "english": null,
      "bhavadeepa": "देवदानवयोः देवदानवजात्योः॥२५॥",
      "chapter": 240,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे वृत्रासुरोत्कर्षवर्णनम्",
      "combined_translation": "26-26"
    },
    {
      "verse": 27,
      "sanskrit": "स्वान्परान्नाभिजानन्ति विमूढाः शस्त्रपाणयः। शिरोरुहेषु सङ्गृह्य कच्चिच्छूरस्य संयुगे॥२७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 240,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे वृत्रासुरोत्कर्षवर्णनम्",
      "combined_translation": "27-27"
    },
    {
      "verse": 28,
      "sanskrit": "बाहुभिर्मुष्टिभिश्चैव वज्रकल्पैः सुदारुणैः। प्रहरन्ति रणे वीरा आत्तशस्त्राः परस्परम्॥२८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 240,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे वृत्रासुरोत्कर्षवर्णनम्",
      "combined_translation": "28-28"
    },
    {
      "verse": 29,
      "sanskrit": "योधप्राणहरे रौद्रे स्वर्गद्वारेऽनपावृते। सङ्कुले तुमुले युद्धे वर्तमाने महाभये॥२९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 240,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे वृत्रासुरोत्कर्षवर्णनम्",
      "combined_translation": "29-29"
    },
    {
      "verse": 30,
      "sanskrit": "हयो हयं गजो नागं वीरो वीरं महाहवे। अभ्यद्रवञ्जिघांसन्तो ह्यसमञ्जसमाहवे। असुराश्च सुराश्चैव विक्रमाढ्या महारथाः॥३०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 240,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे वृत्रासुरोत्कर्षवर्णनम्",
      "combined_translation": "30-30"
    },
    {
      "verse": 31,
      "sanskrit": "जुहुवुः समरे प्राणान्निजघ्नुरितरेतरम्। मुक्तकेशा विकवचा विरथांश्छिन्नकार्मुकाः॥३१॥",
