  "parva_name": "हरिवंशः",
  "upaparva_name": "भविष्यपर्व",
  "adhyaya_name": "बलेर्विजये श्रियः स्वयमागमनकथनम्",
  "chapter": 248,
  "verse_count": 18,
  "verses": [
    {
      "verse": 1,
      "sanskrit": "वैशम्पायन उवाच।\n              निष्प्रयत्नेषु देवेषु त्रैलोक्ये दैत्यपालिते। जये बलेर्बलवतो मयशम्बरयोस्तथा॥१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 248,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "बलेर्विजये श्रियः स्वयमागमनकथनम्",
      "combined_translation": "1-33"
    },
    {
      "verse": 2,
      "sanskrit": "सुधासु दिक्षु सर्वासु प्रवृत्ते धर्मकर्मणि। अपवृत्ते चन्द्रमसि अयनस्थे दिवाकरे॥२॥",
      "english": null,
      "bhavadeepa": "निष्प्रयत्नेष्विति॥१॥",
      "chapter": 248,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "बलेर्विजये श्रियः स्वयमागमनकथनम्",
      "combined_translation": "2-2"
    },
    {
      "verse": 3,
      "sanskrit": "प्रह्रादशम्बरमयैरनुह्रादेन चैव हि। दिक्षु सर्वासु गुप्तासु गगने दैत्यपालिते॥३॥",
      "english": null,
      "bhavadeepa": "सुधासु अमृतमयीषु अपवृत्ते उद्धरिते॥२॥",
      "chapter": 248,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "बलेर्विजये श्रियः स्वयमागमनकथनम्",
      "combined_translation": "3-3"
    },
    {
      "verse": 4,
      "sanskrit": "दैत्येषु मखशोभाश्च स्वर्गार्थं दर्शयत्सु च। प्रकृतिस्थे तदा लोके वर्तमाने च सत्पथे॥४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 248,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "बलेर्विजये श्रियः स्वयमागमनकथनम्",
      "combined_translation": "4-4"
    },
    {
      "verse": 5,
      "sanskrit": "अभावे सर्वपापानां भावे चैव तथा स्थिते। भावे तपसि सिद्धानां सर्वत्राश्रमरक्षिषु॥५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 248,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "बलेर्विजये श्रियः स्वयमागमनकथनम्",
      "combined_translation": "5-5"
    },
    {
      "verse": 6,
      "sanskrit": "चतुष्पादे स्थिते धर्मे अधर्मे पादविग्रहे। प्रजापालनयुक्तेषु भ्राजमानेषु राजसु॥६॥",
      "english": null,
      "bhavadeepa": "अभावे पापानां भावानां भावे पुण्यानामित्यर्थः॥५॥",
      "chapter": 248,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "बलेर्विजये श्रियः स्वयमागमनकथनम्",
      "combined_translation": "6-6"
    },
    {
      "verse": 7,
      "sanskrit": "स्वधर्मसम्प्रयुक्तेषु सर्वाश्रमनिवासिषु। अभिषिक्तोऽसुरैः सर्वैर्दैत्यराजो बलिस्तदा॥७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 248,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "बलेर्विजये श्रियः स्वयमागमनकथनम्",
      "combined_translation": "7-7"
    },
    {
      "verse": 8,
      "sanskrit": "हृष्टेष्वसुरसङ्घेषु नदत्सु मुदितेषु च। अथाभ्युपगता लक्ष्मीर्बालिं पद्मासने स्थिता॥८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 248,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "बलेर्विजये श्रियः स्वयमागमनकथनम्",
      "combined_translation": "8-8"
    },
    {
      "verse": 9,
      "sanskrit": "पद्मोद्यतकरा देवी वरदा सुरमोहिनी।\n              श्रीरुवाच।\n              बले बलवतां श्रेष्ठ महाराज महाद्युते॥९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 248,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "बलेर्विजये श्रियः स्वयमागमनकथनम्",
      "combined_translation": "9-9"
    },
    {
      "verse": 10,
      "sanskrit": "प्रीतास्मि तव भद्रं ते देवतानां पराजये। यस्त्वया युधि विक्रम्य देवराजः पराजितः॥१०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 248,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "बलेर्विजये श्रियः स्वयमागमनकथनम्",
      "combined_translation": "10-10"
    },
    {
      "verse": 11,
      "sanskrit": "दृष्ट्वा ते परमं सत्त्वं ततोऽहं स्वयमागता। नाश्चर्यं दानवश्रेष्ठ हिरण्यकशिपोः कुले॥११॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 248,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "बलेर्विजये श्रियः स्वयमागमनकथनम्",
      "combined_translation": "11-11"
    },
    {
      "verse": 12,
      "sanskrit": "प्रसूतस्यासुरेन्द्रस्य तव कर्मेदमीदृशम्। विशेषतस्त्वया राजन्दैत्येन्द्रः प्रपितामहः॥१२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 248,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "बलेर्विजये श्रियः स्वयमागमनकथनम्",
      "combined_translation": "12-12"
    },
    {
      "verse": 13,
      "sanskrit": "येन भुक्तं हि निखिलं त्रैलोक्यमिदमव्ययम्। विशेषतस्तव विभो सर्वे धर्मपथे स्थिताः॥१३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 248,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "बलेर्विजये श्रियः स्वयमागमनकथनम्",
      "combined_translation": "13-13"
    },
    {
      "verse": 14,
      "sanskrit": "तेन त्रैलोक्यमुख्येन भोक्ष्यस्यमितविक्रम। एवमुक्त्वा हि सा देवी लक्ष्मीर्दैत्यपतिं बलिम्॥१४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 248,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "बलेर्विजये श्रियः स्वयमागमनकथनम्",
      "combined_translation": "14-14"
    },
    {
      "verse": 15,
      "sanskrit": "प्रविष्ठा वरदा सौम्या सर्वभूतमनोरमा। शिष्टाश्च देव्यः प्रवरा ह्रीः कीर्तिर्द्युतिरेव च॥१५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 248,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "बलेर्विजये श्रियः स्वयमागमनकथनम्",
      "combined_translation": "15-15"
    },
    {
      "verse": 16,
      "sanskrit": "प्रभा धृतिः क्षमा भूतिर्नीतिर्विद्या दया स्मृतिः। कृतिर्लज्जा तथा मेधा लक्ष्मीरीहा गतिस्तथा॥१६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 248,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "बलेर्विजये श्रियः स्वयमागमनकथनम्",
      "combined_translation": "16-16"
    },
    {
      "verse": 17,
      "sanskrit": "श्रुतिः प्रीतिरिला कीर्तिः शान्तिः पुष्टिः क्रियास्तथा। सर्वाश्चाप्सरसो दिव्या नृत्यगीतविशारदाः॥१७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 248,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "बलेर्विजये श्रियः स्वयमागमनकथनम्",
      "combined_translation": "17-17"
    },
    {
      "verse": 18,
      "sanskrit": "पतिं प्राप्ताः सुदैतेयं त्रैलोक्ये सचराचरे। प्राप्तमैश्वर्यममितं बलिना ब्रह्मवादिना॥१८॥",
      "english": null,
      "bhavadeepa": "इला श्रौतक्रिया पूर्तादिका॥१७॥",
      "chapter": 248,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "बलेर्विजये श्रियः स्वयमागमनकथनम्",
