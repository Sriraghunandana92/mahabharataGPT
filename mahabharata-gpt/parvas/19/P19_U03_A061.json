{
  "adhyaya_id": "P19_U03_A061",
  "book": 19,
  "parva_name": "हरिवंशः",
  "upaparva_name": "भविष्यपर्व",
  "adhyaya_name": "देवासुरयुद्धे विप्रचित्तिवरुणयोर्युद्धम्",
  "chapter": 244,
  "verse_count": 44,
  "verses": [
    {
      "verse": 1,
      "sanskrit": "वैशम्पायन उवाच।\n              विप्रचित्तिस्तु वरुणं दैत्यानामादिरव्ययम्। जघानेषुगणैः क्रुद्धो दीप्तैरिव महोरगः॥१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 244,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे विप्रचित्तिवरुणयोर्युद्धम्"
    },
    {
      "verse": 2,
      "sanskrit": "स दह्यमानो दैत्येन दीप्तः शरगभस्तिभिः। नाभ्यजानत कर्तव्यं सङ्ग्रामे स जलेश्वरः॥२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 244,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे विप्रचित्तिवरुणयोर्युद्धम्",
      "combined_translation": "2-2"
    },
    {
      "verse": 3,
      "sanskrit": "सर्वलोकेश्वरस्येव परमेष्ठी प्रजापतिः। न शक्नोत्यग्रतः स्थातुं विप्रचित्तेर्जलाधिपः॥३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 244,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे विप्रचित्तिवरुणयोर्युद्धम्",
      "combined_translation": "3-3"
    },
    {
      "verse": 4,
      "sanskrit": "वज्रो नाम महाव्यूहो निर्भयः सर्वतोमुखः। तं व्यूह्य प्रत्ययुध्यन्त दानवा देववाहिनीम्॥४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 244,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे विप्रचित्तिवरुणयोर्युद्धम्",
      "combined_translation": "4-4"
    },
    {
      "verse": 5,
      "sanskrit": "वह्निज्वालासमं तत्र रविमण्डलसन्निभम्। मुखमाभाति दैत्यस्य विप्रचित्तेर्महात्मनः॥५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 244,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे विप्रचित्तिवरुणयोर्युद्धम्",
      "combined_translation": "5-5"
    },
    {
      "verse": 6,
      "sanskrit": "वरुणस्तु महातेजा विप्रचित्तिं महासुरम्। प्रदहन्निव तेजोभिर्जिगीषुः प्रत्यवेक्षत॥६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 244,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे विप्रचित्तिवरुणयोर्युद्धम्",
      "combined_translation": "6-6"
    },
    {
      "verse": 7,
      "sanskrit": "स्रग्दाममालाभरणः केयूराङ्गदभूषणः। जग्राह परिघं दैत्यः कैलासशिखरोपमम्॥७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 244,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे विप्रचित्तिवरुणयोर्युद्धम्",
      "combined_translation": "7-7"
    },
    {
      "verse": 8,
      "sanskrit": "पिनद्धं काञ्चनैः पट्टैर्हेममालिनमायसम्। यमदण्डोपमं घोरं दैत्यानां भयनाशनम्॥८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 244,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे विप्रचित्तिवरुणयोर्युद्धम्",
      "combined_translation": "8-8"
    },
    {
      "verse": 9,
      "sanskrit": "भ्रामयामास सङ्क्रुद्धो महाशक्रध्वजोपमम्। विननाद विवृत्तास्यो विप्रचित्तिर्महासुरः॥९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 244,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे विप्रचित्तिवरुणयोर्युद्धम्",
      "combined_translation": "9-9"
    },
    {
      "verse": 10,
      "sanskrit": "स कण्ठस्थेन निष्केण भुजस्थैरपि चाङ्गदैः। कुण्डलाभ्यां विचित्राभ्यां भ्राजते काञ्चनस्रजा॥१०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 244,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे विप्रचित्तिवरुणयोर्युद्धम्",
      "combined_translation": "10-10"
    },
    {
      "verse": 11,
      "sanskrit": "दानवो भूषणैर्भाति परिघेणायसेन च। यथेन्द्रधनुषा मेघः सविद्युत्स्तनयित्नुमान्॥११॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 244,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे विप्रचित्तिवरुणयोर्युद्धम्",
      "combined_translation": "11-11"
    },
    {
      "verse": 12,
      "sanskrit": "प्रस्फुरत्परिघास्त्रेण वातस्कन्धान्महास्वनः। जज्वाल च सधूमार्चिः साङ्कर्षण इवानलः॥१२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 244,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे विप्रचित्तिवरुणयोर्युद्धम्",
      "combined_translation": "12-12"
    },
    {
      "verse": 13,
      "sanskrit": "विद्याधरगणैः सार्धं गन्धर्वनगरैरपि। सह चैवामरावत्या सिद्धलोकैस्तथा सह॥१३॥",
      "english": null,
      "bhavadeepa": "वातस्कन्धान् वातमयान् स्कन्धावारान् परिधीनित्यर्थः॥१२॥",
      "chapter": 244,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे विप्रचित्तिवरुणयोर्युद्धम्",
      "combined_translation": "13-13"
    },
    {
      "verse": 14,
      "sanskrit": "ग्रहनक्षत्ररचितं सार्कचन्द्रविभूषितम्। दैत्येन्द्रपरिघोद्धूतं भ्रमतीव नभस्तलम्॥१४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 244,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे विप्रचित्तिवरुणयोर्युद्धम्",
      "combined_translation": "14-14"
    },
    {
      "verse": 15,
      "sanskrit": "दुरासदः सुसञ्जज्ञे परिघाभरणक्षमः। सुरेन्धनोऽसुरेन्द्राग्निर्युगान्ताग्निरिवोत्थितः॥१५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 244,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे विप्रचित्तिवरुणयोर्युद्धम्",
      "combined_translation": "15-15"
    },
    {
      "verse": 16,
      "sanskrit": "त्रिदशा वरुणश्चैव न शेकुः स्पन्दितुं भयात्। तत्रासीन्निर्भयस्त्वेकः कौशिको वासवः प्रभुः। भास्करप्रतिमं घोरं परिघं रौद्रदर्शनम्॥१६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 244,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे विप्रचित्तिवरुणयोर्युद्धम्",
      "combined_translation": "16-16"
    },
    {
      "verse": 17,
      "sanskrit": "पातयामास सेनायां जलेशस्य स दानवः। पतता तेन सङ्ग्रामे जलेशस्य महात्मनः॥१७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 244,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे विप्रचित्तिवरुणयोर्युद्धम्",
      "combined_translation": "17-17"
    },
    {
      "verse": 18,
      "sanskrit": "भूतानां शतसाहस्रं परिघेण समाहतम्। तेषां गात्राणि चासाद्य व्यशीर्यन्त सहस्रशः॥१८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 244,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे विप्रचित्तिवरुणयोर्युद्धम्",
      "combined_translation": "18-18"
    },
    {
      "verse": 19,
      "sanskrit": "विशीर्यमाणं विबभावुल्काशतमिवाम्बरे। भूयश्चैनं तदाऽऽभ्राम्य वरुणाय न्यपातयत्॥१९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 244,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे विप्रचित्तिवरुणयोर्युद्धम्",
      "combined_translation": "19-19"
    },
    {
      "verse": 20,
      "sanskrit": "पात्यमाने तदा तस्मिञ्छरीरे वारुणे तदा। स भिन्नः परिघो घोरो देवगात्रे व्यशीर्यत॥२०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 244,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे विप्रचित्तिवरुणयोर्युद्धम्",
      "combined_translation": "20-20"
    },
    {
      "verse": 21,
      "sanskrit": "शीर्यमाणस्य चूर्णानि खद्योता इव चाम्बरे। स तु तेन प्रहारेण न चचाल जलाधिपः॥२१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 244,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे विप्रचित्तिवरुणयोर्युद्धम्",
      "combined_translation": "21-21"
    },
    {
      "verse": 22,
      "sanskrit": "परिघेण हतः सङ्ख्ये यथा वज्रहतोऽचलः। स्वसैन्येष्वपि भग्नेषु भिन्नदेहेषु चाहवे॥२२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 244,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे विप्रचित्तिवरुणयोर्युद्धम्",
      "combined_translation": "22-22"
    },
    {
      "verse": 23,
      "sanskrit": "मुहूर्तमभवत्क्षोभ्यमपाम्पतिरमर्षणः। सोऽमर्षं च समापन्नो वरुणोऽमितविक्रमः॥२३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 244,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे विप्रचित्तिवरुणयोर्युद्धम्",
      "combined_translation": "23-23"
    },
    {
      "verse": 24,
      "sanskrit": "सर्वसंहारमकरोत्स्वपक्षस्यारिमर्दनः। स सागरैश्चतुर्भिश्च वृतो दीप्तैश्च पन्नगैः॥२४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 244,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे विप्रचित्तिवरुणयोर्युद्धम्",
      "combined_translation": "24-24"
    },
    {
      "verse": 25,
      "sanskrit": "शङ्खमुक्तामणिचितो बिभ्रत्तोयमयं वपुः। पाण्डुरोद्धूतवसनो नानारत्नविभूषितः॥२५॥",
      "english": null,
      "bhavadeepa": "सर्वसंहारं सर्वेषामेकीकरणम्॥२४॥",
      "chapter": 244,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे विप्रचित्तिवरुणयोर्युद्धम्",
      "combined_translation": "25-25"
    },
    {
      "verse": 26,
      "sanskrit": "वरुणः पाशधृक्छ्रीमान्कूर्ममीनसमाकुलः। वरुणस्तु तदा क्रुद्धस्तान्निरीक्ष्य स्वसैनिकान्॥२६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 244,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे विप्रचित्तिवरुणयोर्युद्धम्",
      "combined_translation": "26-26"
    },
    {
      "verse": 27,
      "sanskrit": "उवाच दृष्ट्वा युध्यध्वं दानवानां जिघांसया। अहमेनं हनिष्यामि भयं मुक्त्वा तु युध्यत॥२७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 244,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे विप्रचित्तिवरुणयोर्युद्धम्",
      "combined_translation": "27-27"
    },
    {
      "verse": 28,
      "sanskrit": "ततस्ते पन्नगाः सर्वे महार्णवजलाश्रयाः। जघ्नुर्दैत्यान्रणमुखे नदन्तो जयगृद्धिनः॥२८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 244,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे विप्रचित्तिवरुणयोर्युद्धम्",
      "combined_translation": "28-28"
    },
    {
      "verse": 29,
      "sanskrit": "ते तु नालीकनाराचैर्गदाभिर्मुसलैर्तथा। अभ्यघ्नन्दानवान्हृष्टा मुदिता वरुणानुगाः॥२९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 244,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे विप्रचित्तिवरुणयोर्युद्धम्",
      "combined_translation": "29-29"
    },
    {
      "verse": 30,
      "sanskrit": "विप्रचित्तिस्तु सङ्क्रुद्धो महाबलपराक्रमः। पन्नगानां शरीराणि व्यधमद्युद्धदुर्मदः॥३०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 244,
