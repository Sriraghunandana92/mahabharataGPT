      "bhavadeepa": null,
      "chapter": 273,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पुनरपि शिवकृता विष्णुस्तुतिः",
      "combined_translation": "28-28"
    },
    {
      "verse": 29,
      "sanskrit": "इति स्तुत्वा जगन्नथमुवाच मुनिसत्तमान्। इदं स्तोत्रमधीयाना नित्यं व्रजत केशवम्॥२९॥",
      "english": null,
      "bhavadeepa": "कृष्णाय नामतः कृष्णाय वर्णतः॥२८॥",
