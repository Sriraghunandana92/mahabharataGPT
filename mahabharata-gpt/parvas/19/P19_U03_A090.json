      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पुनरपि शिवकृता विष्णुस्तुतिः",
      "combined_translation": "29-29"
    },
    {
      "verse": 30,
      "sanskrit": "शरण्यं सर्वभूतानां तत्र श्रेयो विधास्यति। ये चेमं धारयिष्यन्ति स्तवं पापविमोचनम्॥३०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 273,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पुनरपि शिवकृता विष्णुस्तुतिः",
      "combined_translation": "30-30"
    },
    {
      "verse": 31,
      "sanskrit": "तेषां प्रीतः प्रसन्नात्मा पठतां शृण्वतां हरिः। श्रेयो दास्यति धर्मात्मा नात्र कार्या विचारणा॥३१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 273,
      "parva_name": "हरिवंशः",
