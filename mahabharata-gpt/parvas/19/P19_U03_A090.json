{
  "adhyaya_id": "P19_U03_A090",
  "book": 19,
  "parva_name": "हरिवंशः",
  "upaparva_name": "भविष्यपर्व",
  "adhyaya_name": "पुनरपि शिवकृता विष्णुस्तुतिः",
  "chapter": 273,
  "verse_count": 38,
  "verses": [
    {
      "verse": 1,
      "sanskrit": "वैशम्पायन उवाच।\n              ततः स भगवान्रुद्रः सर्वान्विस्मापयन्निव। स्तुत्या प्रचक्रमे स्तोतुं विष्णुं विश्वेश्वरं हरिम्। अर्थ्याभिस्तु तदा वाग्भिर्मुनीनां शृण्वतां तथा॥१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 273,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पुनरपि शिवकृता विष्णुस्तुतिः",
      "combined_translation": "1-21"
    },
    {
      "verse": 2,
      "sanskrit": "महेश्वर उवाच।\n              नमो भगवते तुभ्यं वासुदेवाय धीमते। यस्य भासा जगत्सर्वं भासते नित्यमच्युत॥२॥",
      "english": null,
      "bhavadeepa": "ततः स इति॥१॥",
      "chapter": 273,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पुनरपि शिवकृता विष्णुस्तुतिः",
      "combined_translation": "2-2"
    },
    {
      "verse": 3,
      "sanskrit": "नमो भगवते देव नित्यं सूर्यात्मने नमः। यः शीतयति शीतांशुर्लोकान्सर्वानिमान्विभुः॥३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 273,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पुनरपि शिवकृता विष्णुस्तुतिः",
      "combined_translation": "3-3"
    },
    {
      "verse": 4,
      "sanskrit": "नमस्ते विष्णवे देव नित्यं सोमात्मने नमः। यः प्रजाः प्रीणयत्येको विश्वात्मा भूतभावनः॥४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 273,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पुनरपि शिवकृता विष्णुस्तुतिः",
      "combined_translation": "4-4"
    },
    {
      "verse": 5,
      "sanskrit": "नमः सर्वात्मने देव नमो वागात्मने हरे। यो दधार करेणासौ कुशचीरादि यत्सदा॥५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 273,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पुनरपि शिवकृता विष्णुस्तुतिः",
      "combined_translation": "5-5"
    },
    {
      "verse": 6,
      "sanskrit": "दधार वेदान्सर्वांश्च तुभ्यं ब्रह्मात्मने नमः। सर्वान्संहरते यस्तु संहारे विश्वदृक्सदा॥६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 273,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पुनरपि शिवकृता विष्णुस्तुतिः",
      "combined_translation": "6-6"
    },
    {
      "verse": 7,
      "sanskrit": "क्रोधात्मासि विरूपोऽसि तुभ्यं रुद्रात्मने नमः। सृष्टौ स्रष्टा समस्तानां प्राणिनां प्राणदायिने॥७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 273,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पुनरपि शिवकृता विष्णुस्तुतिः",
      "combined_translation": "7-7"
    },
    {
      "verse": 8,
      "sanskrit": "अजाय विष्णवे तुभ्यं स्रष्ट्रे विश्वसृजे नमः। आदौ प्रकृतिमूलाय भूतानां प्रभवाय च॥८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 273,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पुनरपि शिवकृता विष्णुस्तुतिः",
      "combined_translation": "8-8"
    },
    {
      "verse": 9,
      "sanskrit": "नमस्ते देवदेवेश प्रधानाय नमो नमः। पृथिव्यां गन्धरूपेण संस्थितः प्राणिनां हरे॥९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 273,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पुनरपि शिवकृता विष्णुस्तुतिः",
      "combined_translation": "9-9"
    },
    {
      "verse": 10,
      "sanskrit": "दृढाय दृढरूपाय तुभ्यं गन्धात्मने नमः। अपां रसाय सर्वत्र प्राणिनां सुखहेतवे॥१०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 273,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पुनरपि शिवकृता विष्णुस्तुतिः",
      "combined_translation": "10-10"
    },
    {
      "verse": 11,
      "sanskrit": "नमस्ते विश्वरूपाय रसाय च नमो नमः। तेजसा भास्करो यस्तु घृणो जन्तुहितः सदा॥११॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 273,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पुनरपि शिवकृता विष्णुस्तुतिः",
      "combined_translation": "11-11"
    },
    {
      "verse": 12,
      "sanskrit": "तस्मै देव जगन्नाथ नमो भास्कररूपिणे। वायोः स्पर्शगुणो यत्र शीतोष्णसुखदुःखदः॥१२॥",
      "english": null,
      "bhavadeepa": "घृणः घृणयो रश्मयस्तद्वान् सूर्यः। घृणिरिति पाठः स्वच्छः॥११॥",
      "chapter": 273,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पुनरपि शिवकृता विष्णुस्तुतिः",
      "combined_translation": "12-12"
    },
    {
      "verse": 13,
      "sanskrit": "नमस्ते वायुरूपाय नमः स्पर्शात्मने हरे। आकाशेऽवस्थितः शब्दः सर्वश्रोत्रनिवेशनः॥१३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 273,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पुनरपि शिवकृता विष्णुस्तुतिः",
      "combined_translation": "13-13"
    },
    {
      "verse": 14,
      "sanskrit": "नमस्ते भगवन्विष्णो तुभ्यं सर्वात्मने नमः। यो दधार जगत्सर्वं मायामानुषदेहवान्॥१४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 273,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पुनरपि शिवकृता विष्णुस्तुतिः",
      "combined_translation": "14-14"
    },
    {
      "verse": 15,
      "sanskrit": "नमस्तुभ्यं जगन्नाथ मायिनेऽमायदायिने। नम आद्याय बीजाय निर्गुणाय गुणात्मने॥१५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 273,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पुनरपि शिवकृता विष्णुस्तुतिः",
      "combined_translation": "15-15"
    },
    {
      "verse": 16,
      "sanskrit": "अचिन्त्याय सुचिन्त्याय तस्मै चिन्त्यात्मने नमः। हराय हरिरूपाय ब्रह्मणे ब्रह्मदायिने॥१६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 273,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पुनरपि शिवकृता विष्णुस्तुतिः",
      "combined_translation": "16-16"
    },
    {
      "verse": 17,
      "sanskrit": "नमो ब्रह्मविदे तुभ्यं ब्रह्मब्रह्मात्मने नमः। नमः सहस्रशिरसे सहस्रकिरणाय च॥१७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 273,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पुनरपि शिवकृता विष्णुस्तुतिः",
      "combined_translation": "17-17"
    },
    {
      "verse": 18,
      "sanskrit": "नमः सहस्रवक्त्राय सहस्रनयनाय च। विश्वाय विश्वरूपाय विश्वकर्त्रे नमो नमः॥१८॥",
      "english": null,
      "bhavadeepa": "ब्रह्मब्रह्मात्मने वेदयज्ञस्वरूपाय॥१७॥",
      "chapter": 273,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पुनरपि शिवकृता विष्णुस्तुतिः",
      "combined_translation": "18-18"
    },
    {
      "verse": 19,
      "sanskrit": "विश्ववक्त्रे नमो नित्यं भूतावास नमो नमः। इन्द्रियायेन्द्ररूपाय विषयाय सदा हरे॥१९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 273,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पुनरपि शिवकृता विष्णुस्तुतिः",
      "combined_translation": "19-19"
    },
    {
      "verse": 20,
      "sanskrit": "नमोऽश्वशिरसे तुभ्यं वेदाभरणरूपिणे। अग्नयेऽग्निपते तुभ्यं ज्योतिषां पतये नमः॥२०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 273,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पुनरपि शिवकृता विष्णुस्तुतिः",
      "combined_translation": "20-20"
    },
    {
      "verse": 21,
      "sanskrit": "सूर्याय सूर्यपुत्राय तेजसां पतये नमः। नमः सोमाय सौम्याय नमः शीतात्मने हरे॥२१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 273,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पुनरपि शिवकृता विष्णुस्तुतिः",
      "combined_translation": "21-21"
    },
    {
      "verse": 22,
      "sanskrit": "नमो वषट्कृते तुभ्यं स्वाहास्वधास्वरूपिणे। नमो यज्ञाय इज्याय हविषे हव्यसंस्कृते। नमः स्रुवाय पात्राय यज्ञाङ्गाय पराय च॥२२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 273,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पुनरपि शिवकृता विष्णुस्तुतिः",
      "combined_translation": "22-22"
    },
    {
      "verse": 23,
      "sanskrit": "नमः प्रणवदेहाय क्षरायाप्यक्षराय च। वेदाय वेदरूपाय शस्त्रिणे शस्त्ररूपिणे॥२३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 273,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पुनरपि शिवकृता विष्णुस्तुतिः",
      "combined_translation": "23-23"
    },
    {
      "verse": 24,
      "sanskrit": "गदिने खड्गिने तुभ्यं शङ्खिने चक्रिणे नमः। शूलिने चर्मिणे नित्यं वरदाय नमो नमः॥२४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 273,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पुनरपि शिवकृता विष्णुस्तुतिः",
      "combined_translation": "24-24"
    },
    {
      "verse": 25,
      "sanskrit": "बुद्धिप्रियाय बुद्धाय प्रबुद्धाय सुखाय च। हरये विष्णवे तुभ्यं नमः सर्वात्मने गुरो॥२५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 273,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पुनरपि शिवकृता विष्णुस्तुतिः",
      "combined_translation": "25-25"
    },
    {
      "verse": 26,
      "sanskrit": "नमस्ते सर्वलोकेश सर्वकर्त्रे नमो नमः। नमः स्वभावशुद्धाय नमस्ते यज्ञसूकर॥२६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 273,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पुनरपि शिवकृता विष्णुस्तुतिः",
      "combined_translation": "26-26"
    },
    {
      "verse": 27,
      "sanskrit": "नमो विष्णो नमो विष्णो नमो विष्णो नमो हरे। नमस्ते वासुदेवाय वासुदेवाय धीमते॥२७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 273,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पुनरपि शिवकृता विष्णुस्तुतिः",
      "combined_translation": "27-27"
    },
    {
      "verse": 28,
      "sanskrit": "नमः कृष्णाय कृष्णाय सर्वावास नमो नमः। नमो भूयो नमस्तेऽस्तु पाहि लोकाञ्जनार्दन॥२८॥",
