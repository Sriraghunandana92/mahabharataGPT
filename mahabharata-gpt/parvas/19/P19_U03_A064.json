{
  "adhyaya_id": "P19_U03_A064",
  "book": 19,
  "parva_name": "हरिवंशः",
  "upaparva_name": "भविष्यपर्व",
  "adhyaya_name": "बलिवासवयोर्युद्धं वासवस्य पराजयश्च",
  "chapter": 247,
  "verse_count": 32,
  "verses": [
    {
      "verse": 1,
      "sanskrit": "वैशम्पायन उवाच।\n              बलिना तु सुराः सर्वे वर्जयित्वा सुराधिपम्। रणे शरशतैर्भिन्नाः ससैन्या वै पराजिताः॥१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 247,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "बलिवासवयोर्युद्धं वासवस्य पराजयश्च",
      "combined_translation": "1-17"
    },
    {
      "verse": 2,
      "sanskrit": "विमुखा याति दैत्येन्द्रैर्वध्यमाना महाचमूः। जितास्तु बलिना देवाः शक्रमाहुर्महाबलम्॥२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 247,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "बलिवासवयोर्युद्धं वासवस्य पराजयश्च",
      "combined_translation": "2-2"
    },
    {
      "verse": 3,
      "sanskrit": "देवा ऊचुः।\n              भवानिन्द्रश्च धाता च लोकानां प्रभुरव्ययः। त्वमप्रतिमकर्मा च तथैवानुपमद्युतिः॥३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 247,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "बलिवासवयोर्युद्धं वासवस्य पराजयश्च",
      "combined_translation": "3-3"
    },
    {
      "verse": 4,
      "sanskrit": "विद्रुतानीह सैन्यानि सहास्माभिः सुरेश्वर। रथचक्रध्वजाक्षाणि विभिन्नानि महासुरैः॥४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 247,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "बलिवासवयोर्युद्धं वासवस्य पराजयश्च",
      "combined_translation": "4-4"
    },
    {
      "verse": 5,
      "sanskrit": "रथहस्त्यश्वयोधाश्च पदाताश्च सहस्रशः। भिन्नच्छिन्नाश्च शतशो गदामुशलपट्टिशैः॥५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 247,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "बलिवासवयोर्युद्धं वासवस्य पराजयश्च",
      "combined_translation": "5-5"
    },
    {
      "verse": 6,
      "sanskrit": "महाभैरवरूपं हि दैत्येन्द्रेण कृतं रणे। किमुपेक्षसि दैत्येन्द्रैर्हन्यमानां महाचमूम्॥६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 247,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "बलिवासवयोर्युद्धं वासवस्य पराजयश्च",
      "combined_translation": "6-6"
    },
    {
      "verse": 7,
      "sanskrit": "त्रायस्व त्रिदशश्रेष्ठ शरण्यः शरणागतान्। श्रुत्वा तु वचनं तेषां देवानाममराधिपः॥७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 247,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "बलिवासवयोर्युद्धं वासवस्य पराजयश्च",
      "combined_translation": "7-7"
    },
    {
      "verse": 8,
      "sanskrit": "संवर्ताग्निसमक्रुद्धः सर्वान्दहति दानवान्। दिवाकरकराकारं किरीटं धारयन्प्रभुः॥८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 247,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "बलिवासवयोर्युद्धं वासवस्य पराजयश्च",
      "combined_translation": "8-8"
    },
    {
      "verse": 9,
      "sanskrit": "वैडूर्यवर्णसङ्काशो नानारत्नचिताङ्गदः। मयूररोमा रक्ताक्षः शतबाहुः सहस्रदृक्॥९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 247,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "बलिवासवयोर्युद्धं वासवस्य पराजयश्च",
      "combined_translation": "9-9"
    },
    {
      "verse": 10,
      "sanskrit": "हरिरेको हरिश्मश्रुर्नानाकेतुर्महाबलः। वज्रप्रहरणः श्रीमान्योगी शतशिरोधरः॥१०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 247,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "बलिवासवयोर्युद्धं वासवस्य पराजयश्च",
      "combined_translation": "10-10"
    },
    {
      "verse": 11,
      "sanskrit": "सधनुर्बद्धसन्नाहः शतादित्यसमप्रभः। देवगन्धर्वयक्षौघैरनुयातः सहस्रशः॥११॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 247,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "बलिवासवयोर्युद्धं वासवस्य पराजयश्च",
      "combined_translation": "11-11"
    },
    {
      "verse": 12,
      "sanskrit": "सामगैश्च जपैश्चापि स्तूयमानो महर्षिभिः। शतपर्वं महारौद्रं स्फोटनं सर्वतोमुखम्॥१२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 247,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "बलिवासवयोर्युद्धं वासवस्य पराजयश्च",
      "combined_translation": "12-12"
    },
    {
      "verse": 13,
      "sanskrit": "प्रगृह्य रुचिरं वज्रं दीप्तं रौद्राट्टहासिनम्। दैत्यानयोधयत्सर्वान्महेन्द्रः पाकशासनः॥१३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 247,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "बलिवासवयोर्युद्धं वासवस्य पराजयश्च",
      "combined_translation": "13-14"
    },
    {
      "verse": 14,
      "sanskrit": "अधृष्यः सर्वभूतानामदित्या दयितः सुतः। ततः प्रवृत्तः सङ्ग्रामो बलिवासवयोस्तदा॥१४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 247,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "बलिवासवयोर्युद्धं वासवस्य पराजयश्च",
      "english_ref": 13,
      "combined_translation": "13-14"
    },
    {
      "verse": 15,
      "sanskrit": "उभाभ्यां देवदैत्याभ्यामचिरान्महदद्भुतः। अतिवीर्यबलोदग्रस्तुमुलो लोमहर्षणः॥१५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 247,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "बलिवासवयोर्युद्धं वासवस्य पराजयश्च",
      "combined_translation": "15-15"
    },
    {
      "verse": 16,
      "sanskrit": "प्रह्रादेन स्तुतिशतैः कर्मभिर्जयसम्मतैः। प्रबोधितो दैत्यपतिरग्निरिद्ध इवाबभौ॥१६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 247,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "बलिवासवयोर्युद्धं वासवस्य पराजयश्च",
      "combined_translation": "16-16"
    },
    {
      "verse": 17,
      "sanskrit": "सुरासुरेन्द्रयोर्दृष्ट्वा सङ्ग्रामं लोमहर्षणम्। देवानां दानवानां च भूयो युद्धमभूत्तदा॥१७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 247,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "बलिवासवयोर्युद्धं वासवस्य पराजयश्च"
    },
    {
      "verse": 18,
      "sanskrit": "ततोऽविध्यन्महेन्द्रस्तं बलिमस्त्रैर्महाबलम्। तान्यस्त्राणि महाबाहुश्चिच्छेद शतधा रणे॥१८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 247,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "बलिवासवयोर्युद्धं वासवस्य पराजयश्च",
      "combined_translation": "18-18"
    },
    {
      "verse": 19,
      "sanskrit": "ततः क्रुद्धः पुनस्तत्र निजघ्ने दानवं महत्। आग्नेयमथ शत्रुघ्नं चिक्षेपेन्द्रो महाबलः। तं दृष्ट्वा खे समागच्छत्प्रलयानलसन्निभम्॥१९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 247,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "बलिवासवयोर्युद्धं वासवस्य पराजयश्च",
      "combined_translation": "19-19"
    },
    {
      "verse": 20,
      "sanskrit": "पातयामास तच्चैन्द्रं वारुणास्त्रेण धीमता। सङ्क्रुद्धो मघवा वज्रमगृह्णात्पर्वतोपमम्॥२०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 247,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "बलिवासवयोर्युद्धं वासवस्य पराजयश्च",
      "combined_translation": "20-20"
    },
    {
      "verse": 21,
      "sanskrit": "हन्तुकामो रणश्लाघी बलिं दैत्याधिपं रणे। ततः शुश्राव देवेन्द्रः कौशिको हरिवाहनः॥२१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 247,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "बलिवासवयोर्युद्धं वासवस्य पराजयश्च",
      "combined_translation": "21-21"
    },
    {
      "verse": 22,
      "sanskrit": "अशरीरां शुभां वाणीं तस्मिन्महति वैशसे। निवर्तस्व महाबाहो सुराणां नन्दिवर्धन॥२२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 247,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "बलिवासवयोर्युद्धं वासवस्य पराजयश्च",
      "combined_translation": "22-22"
    },
    {
      "verse": 23,
      "sanskrit": "पुरन्दर सुरश्रेष्ठ न जेष्यसि रणे बलिम्। तपसात्युत्तमो दैत्यो वरदानेन चाधिकः॥२३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 247,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "बलिवासवयोर्युद्धं वासवस्य पराजयश्च",
      "combined_translation": "23-23"
    },
    {
      "verse": 24,
      "sanskrit": "स्वयम्भूपरितोषाच्च सत्यधर्माच्च वासव। नैष शक्यस्त्वया जेतुं त्रिदशैर्वा सुरेश्वर॥२४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 247,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "बलिवासवयोर्युद्धं वासवस्य पराजयश्च",
      "combined_translation": "24-24"
    },
    {
      "verse": 25,
      "sanskrit": "यो ह्यस्य जेता भगवांस्तं शृणुश्व समाहितः। ब्रह्मणः स हि सर्वस्वं देवानां चैव सा गतिः॥२५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 247,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "बलिवासवयोर्युद्धं वासवस्य पराजयश्च",
      "combined_translation": "25-25"
    },
    {
      "verse": 26,
      "sanskrit": "परं रहस्यं धर्मस्य परस्य च परा गतिः। परात्परतरः श्रीमान्परावरगतिः प्रभुः॥२६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 247,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "बलिवासवयोर्युद्धं वासवस्य पराजयश्च",
      "combined_translation": "26-26"
    },
    {
      "verse": 27,
      "sanskrit": "सहस्रशीर्षा पुरुषः सहस्राक्षः सहस्रपात्। शङ्खचक्रगदापाणिः पीतवासाः सुरारिहा॥२७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 247,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "बलिवासवयोर्युद्धं वासवस्य पराजयश्च",
      "combined_translation": "27-27"
    },
    {
      "verse": 28,
      "sanskrit": "जेताजेयो जयः श्रीमान्सोऽस्य जेता भविष्यति। श्रुत्वा दिव्यां तु मधुरां वाणीं तामशरीरिणीम्॥२८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 247,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "बलिवासवयोर्युद्धं वासवस्य पराजयश्च",
      "combined_translation": "28-28"
    },
    {
      "verse": 29,
      "sanskrit": "अपयातो रणाच्छक्रः सार्धं सर्वैः सुरोत्तमैः। अपयाते तु देवेन्द्रे कौशिके हरिवाहने॥२९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 247,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "बलिवासवयोर्युद्धं वासवस्य पराजयश्च",
      "combined_translation": "29-29"
    },
    {
      "verse": 30,
      "sanskrit": "सिंहनादो महानासीद्दानवानां महामृधे। ततः किलकिलाशब्दः क्ष्वेडितास्फोटितस्वनः॥३०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 247,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "बलिवासवयोर्युद्धं वासवस्य पराजयश्च",
      "combined_translation": "30-30"
    },
    {
      "verse": 31,
      "sanskrit": "शङ्खानां निनदश्चात्र योधानां वल्गितस्वनः। वादित्राणां च निर्घोषस्तुमुलश्चाभवत्तदा॥३१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 247,
