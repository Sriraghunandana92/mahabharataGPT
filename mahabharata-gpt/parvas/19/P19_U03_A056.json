{
  "adhyaya_id": "P19_U03_A056",
  "book": 19,
  "parva_name": "हरिवंशः",
  "upaparva_name": "भविष्यपर्व",
  "adhyaya_name": "देवासुरयुद्धे कुजम्बोत्कर्षवर्णनम्",
  "chapter": 239,
  "verse_count": 65,
  "verses": [
    {
      "verse": 1,
      "sanskrit": "वैशम्पायन उवाच।\n              तस्मिन्महाहवे रौद्रे तुमुले लोमहर्षणे। ववर्षुः शरवर्षाणि संरब्धा देवदानवाः॥१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 239,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे कुजम्बोत्कर्षवर्णनम्"
    },
    {
      "verse": 2,
      "sanskrit": "व्याक्रोशन्त गजास्तत्र शरघातप्रपीडिताः। अश्वाश्च पर्यधावन्त हतारोहा दिशो दश॥२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 239,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे कुजम्बोत्कर्षवर्णनम्",
      "combined_translation": "2-2"
    },
    {
      "verse": 3,
      "sanskrit": "उत्पत्य निपतन्त्यन्ये शरवर्षप्रपीडिताः। देवानां दानवानां च गजाश्वरथिनां रणे॥३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 239,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे कुजम्बोत्कर्षवर्णनम्",
      "combined_translation": "3-3"
    },
    {
      "verse": 4,
      "sanskrit": "समरे तत्र शूराणामन्योन्यमभिधावताम्। धनुषां तलशब्देन न प्राज्ञायत किञ्चन॥४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 239,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे कुजम्बोत्कर्षवर्णनम्",
      "combined_translation": "4-4"
    },
    {
      "verse": 5,
      "sanskrit": "शरशक्तिगदाभिस्ते खड्गैश्चामिततेजसः। निजघ्नुर्महतीं सेनामन्योन्यस्य परन्तप॥५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 239,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे कुजम्बोत्कर्षवर्णनम्",
      "combined_translation": "5-5"
    },
    {
      "verse": 6,
      "sanskrit": "बाहूनामुत्तमाङ्गानां कार्मुकाणां च संयुगे। राशयस्तत्र दृश्यन्ते देवदैत्यसमागमे॥६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 239,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे कुजम्बोत्कर्षवर्णनम्",
      "combined_translation": "6-6"
    },
    {
      "verse": 7,
      "sanskrit": "अश्वानां कुञ्जराणां च रथानां च वरूथिनाम्। नान्तं समभिगच्छन्ति निहतानां सुरासुरैः॥७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 239,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे कुजम्बोत्कर्षवर्णनम्",
      "combined_translation": "7-7"
    },
    {
      "verse": 8,
      "sanskrit": "गदाभिरसिभिः प्रासैर्भल्लैः सन्नतपर्वभिः। योधास्तत्राभ्यहन्यन्त हस्त्यश्वं चामितं बहु॥८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 239,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे कुजम्बोत्कर्षवर्णनम्",
      "combined_translation": "8-8"
    },
    {
      "verse": 9,
      "sanskrit": "प्रावर्तत नदी घोरा शोणितौघा तरङ्गिणी। तदा मध्ये तु सैन्यानां केशशैवलशाड्वला॥९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 239,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे कुजम्बोत्कर्षवर्णनम्",
      "combined_translation": "9-9"
    },
    {
      "verse": 10,
      "sanskrit": "हाहाकारो महाशब्दो योधानामभवत्तदा। दानवैर्हन्यमानानां त्रिदशानां महारणे॥१०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 239,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे कुजम्बोत्कर्षवर्णनम्",
      "combined_translation": "10-10"
    },
    {
      "verse": 11,
      "sanskrit": "वैशम्पायन उवाच\n              तेषां तदभवद्युद्धं देवानामसुरैः सह। विभीषणं महारौद्रं विकृतं भीमदर्शनम्॥११॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 239,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे कुजम्बोत्कर्षवर्णनम्",
      "combined_translation": "11-11"
    },
    {
      "verse": 12,
      "sanskrit": "विरोचनस्तु तत्रैव विष्वक्सेनं महाहवे। जघान रुधिराभाक्षं साध्यं परमधन्विनम्॥१२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 239,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे कुजम्बोत्कर्षवर्णनम्",
      "combined_translation": "12-12"
    },
    {
      "verse": 13,
      "sanskrit": "तमायान्तमभिप्रेक्ष्य विष्वक्सेनः सुरैर्वृतः। अमेयात्मा सुरश्रेष्ठः प्रत्यविध्यत्स्तनान्तरे॥१३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 239,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे कुजम्बोत्कर्षवर्णनम्",
      "combined_translation": "13-13"
    },
    {
      "verse": 14,
      "sanskrit": "साध्यस्य बाणाभिहतस्तोत्रार्पित इव द्विपः। विरोचनः प्रजज्वाल क्रोधेनाग्निरिवाध्वरे॥१४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 239,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे कुजम्बोत्कर्षवर्णनम्",
      "combined_translation": "14-14"
    },
    {
      "verse": 15,
      "sanskrit": "स कार्मुकविनिर्मुक्तैः शरैर्दानवसत्तमः। विष्वक्सेनं बिभेदाजौ दीप्तैः सप्तभिराशुगैः॥१५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 239,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे कुजम्बोत्कर्षवर्णनम्",
      "combined_translation": "15-15"
    },
    {
      "verse": 16,
      "sanskrit": "सोऽतिविद्धो बलवता दानवेन सुरोत्तमः। मूर्च्छामभिजगामाशु ध्वजं चाप्याश्रयत्प्रभुः॥१६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 239,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे कुजम्बोत्कर्षवर्णनम्",
      "combined_translation": "16-16"
    },
    {
      "verse": 17,
      "sanskrit": "ततः स पुनराश्वस्य साध्यो युद्धे मनो दधे। विस्फार्य च महाचापं दैत्यमध्ये व्यवस्थितः॥१७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 239,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे कुजम्बोत्कर्षवर्णनम्",
      "combined_translation": "17-17"
    },
    {
      "verse": 18,
      "sanskrit": "विरोचनस्तु बलवानभ्ययुध्यत सर्वशः। क्षोभयन्सुरसैन्यानि समन्तान्निशितैः शरैः॥१८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 239,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे कुजम्बोत्कर्षवर्णनम्",
      "combined_translation": "18-18"
    },
    {
      "verse": 19,
      "sanskrit": "ततस्तस्यासुरेन्द्रस्य युद्ध्यमानस्य संयुगे। श्रूयते तुमुलः शब्दो जीमूतस्येव गर्जतः॥१९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 239,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे कुजम्बोत्कर्षवर्णनम्",
      "combined_translation": "19-19"
    },
    {
      "verse": 20,
      "sanskrit": "जगर्ज च महाघोषो विनिघ्नन्देववाहिनीम्। चण्डवेगाश्मवर्षी च सविद्युत्स्तनयित्नुमान्॥२०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 239,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे कुजम्बोत्कर्षवर्णनम्",
      "combined_translation": "20-20"
    },
    {
      "verse": 21,
      "sanskrit": "दिशो विद्रावयामास शरवर्षेण दानवः। सर्वसैन्यानि देवानामुद्यतास्त्रो महाहवे॥२१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 239,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे कुजम्बोत्कर्षवर्णनम्",
      "combined_translation": "21-21"
    },
    {
      "verse": 22,
      "sanskrit": "ते प्राद्रवन्त वित्रस्ता रथेभ्यो रथिनस्तदा। सादिनश्चाश्वपृष्ठेभ्यो भूमौ चापि पदातयः॥२२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 239,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे कुजम्बोत्कर्षवर्णनम्",
      "combined_translation": "22-22"
    },
    {
      "verse": 23,
      "sanskrit": "श्रुत्वा कार्मुकनिर्घोषं विस्फूर्जितमिवाशनेः। सर्वसैन्यानि भीतानि निव्यलीयन्त संयुगे॥२३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 239,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे कुजम्बोत्कर्षवर्णनम्",
      "combined_translation": "23-23"
    },
    {
      "verse": 24,
      "sanskrit": "विरोचनभयत्रस्ता रथेभ्यो रथिनस्तदा। पदातीनां ययुः सङ्घा यत्र देवः सचीपतिः॥२४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 239,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे कुजम्बोत्कर्षवर्णनम्",
      "combined_translation": "24-24"
    },
    {
      "verse": 25,
      "sanskrit": "विष्वक्सेनस्य साध्यस्य सर्वतः सुमहाबलः। पादे रक्षःसहस्राणि निजघान चतुर्दश॥२५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 239,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे कुजम्बोत्कर्षवर्णनम्",
      "combined_translation": "25-25"
    },
    {
      "verse": 26,
      "sanskrit": "अश्ववृन्देषु नागेषु रथानीकेषु चाभिभूः। पदातीनां च सङ्घेषु विनिघ्नन्प्रत्यदृश्यत॥२६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 239,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे कुजम्बोत्कर्षवर्णनम्",
      "combined_translation": "26-26"
    },
    {
      "verse": 27,
      "sanskrit": "वितत्य श्येनवत्पक्षौ सर्वतः स वरूथिनीम्। भित्त्वा छित्त्वा महाबाहुः शिरांस्याजौ ह्यकृन्तत॥२७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 239,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे कुजम्बोत्कर्षवर्णनम्",
      "combined_translation": "27-27"
    },
    {
      "verse": 28,
      "sanskrit": "सादिनश्च पदाताश्च हतशेषा रथास्तथा। विष्वक्सेनेन सहिता विरोचनमथाद्रवन्॥२८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 239,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे कुजम्बोत्कर्षवर्णनम्",
      "combined_translation": "28-28"
    },
    {
      "verse": 29,
      "sanskrit": "तेऽसिचर्मगदाशक्तिपरिघप्रासतोमरैः। तमेकमभ्यधावन्तं सिंहनादं प्रचक्रिरे॥२९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 239,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे कुजम्बोत्कर्षवर्णनम्",
      "combined_translation": "29-29"
    },
    {
      "verse": 30,
      "sanskrit": "ततः सोऽसिं समुद्यम्य जवमास्थाय दानवः। चकर्त रथिनामाजौ शिरांसि च धनूंषि च॥३०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 239,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे कुजम्बोत्कर्षवर्णनम्",
      "combined_translation": "30-30"
    },
    {
      "verse": 31,
      "sanskrit": "रथनागाश्ववृन्देषु बलवानरिसूदनः। विरोचनश्चरन्मार्गान्प्रकारानेकविंशतिम्॥३१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 239,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे कुजम्बोत्कर्षवर्णनम्",
      "combined_translation": "31-31"
    },
    {
      "verse": 32,
