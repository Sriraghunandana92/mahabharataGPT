{
  "adhyaya_id": "P19_U03_A077",
  "book": 19,
  "parva_name": "हरिवंशः",
  "upaparva_name": "भविष्यपर्व",
  "adhyaya_name": "श्रीकृष्णस्य बदरिकाश्रमे आतिथ्यस्वीकारः",
  "chapter": 260,
  "verse_count": 20,
  "verses": [
    {
      "verse": 1,
      "sanskrit": "वैशम्पायन उवाच।\n              ततो मुनिगणा दृष्ट्वा देवदेवमुपस्थितम्। समाप्य चाग्निहोत्राणि सम्पूज्यातिथिसत्तमान्॥१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 260,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णस्य बदरिकाश्रमे आतिथ्यस्वीकारः"
    },
    {
      "verse": 2,
      "sanskrit": "मुनयो दीर्घतपसः समाधौ कृतनिश्चयाः। जटिनो मुण्डिनः केचिच्छिराधमनिसन्तताः॥२॥",
      "english": null,
      "bhavadeepa": "तत इति॥१॥",
      "chapter": 260,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णस्य बदरिकाश्रमे आतिथ्यस्वीकारः",
      "combined_translation": "2-2"
    },
    {
      "verse": 3,
      "sanskrit": "निर्मज्जा नीरसाः केचिद्वेताला इव केचन। अश्मकुट्टाशनपराः पर्णभक्षास्तथा परे॥३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 260,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णस्य बदरिकाश्रमे आतिथ्यस्वीकारः",
      "combined_translation": "3-3"
    },
    {
      "verse": 4,
      "sanskrit": "वेदविद्याव्रतस्नाता निराहारा महातपाः। स्मरन्तः सर्वदा विष्णुं तद्भक्तास्तत्परायणाः॥४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 260,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णस्य बदरिकाश्रमे आतिथ्यस्वीकारः",
      "combined_translation": "4-4"
    },
    {
      "verse": 5,
      "sanskrit": "आसन्नमुक्तयः केचित्केचिद्ध्यानैकतत्पराः। ध्यानेन मनसा विष्णुं दृष्टवन्तस्तपोधनाः॥५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 260,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णस्य बदरिकाश्रमे आतिथ्यस्वीकारः",
      "combined_translation": "5-5"
    },
    {
      "verse": 6,
      "sanskrit": "संवत्सराशिनः केचित्त्केचिज्जलविचारिणः। शक्रस्य भयदातारः श्रुतिस्मृतिपरायणाः॥६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 260,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णस्य बदरिकाश्रमे आतिथ्यस्वीकारः",
      "combined_translation": "6-6"
    },
    {
      "verse": 7,
      "sanskrit": "वसिष्ठो वामदेवश्च रैभ्यो धूम्रस्तथैव च। जाबालिः काश्यपः कण्वो भरद्वाजोऽथ गौतमः॥७॥",
      "english": null,
      "bhavadeepa": "जलविचारिणः जलवासपराः जलमात्राहारा वा॥६॥",
      "chapter": 260,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णस्य बदरिकाश्रमे आतिथ्यस्वीकारः",
      "combined_translation": "7-7"
    },
    {
      "verse": 8,
      "sanskrit": "अत्रिरश्वशिरा भद्रः शङ्खः शङ्खनिधिः कुणिः। पाराशर्यः पवित्राक्षो याज्ञवल्क्यो महामनाः॥८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 260,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णस्य बदरिकाश्रमे आतिथ्यस्वीकारः",
      "combined_translation": "8-8"
    },
    {
      "verse": 9,
      "sanskrit": "कक्षीवानङ्गिराश्चैव मुनिर्दीप्ततपास्तथा। असितो देवलस्तात वाल्मीकिश्च महातपाः॥९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 260,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णस्य बदरिकाश्रमे आतिथ्यस्वीकारः",
      "combined_translation": "9-9"
    },
    {
      "verse": 10,
      "sanskrit": "एते चान्ये च मुनयो द्रष्टुमीश्वरमव्ययम्। आदायार्घ्यं यथायोगमुटजात्स्वात्समाययुः॥१०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 260,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णस्य बदरिकाश्रमे आतिथ्यस्वीकारः",
      "combined_translation": "10-10"
    },
    {
      "verse": 11,
      "sanskrit": "ते च गत्वा हरिं कृष्णं विष्णुमीशं जनार्दनम्। भक्तिनम्रास्तदा देवं प्रणेमुर्भक्तवत्सलम्॥११॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 260,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णस्य बदरिकाश्रमे आतिथ्यस्वीकारः",
      "combined_translation": "11-11"
    },
    {
      "verse": 12,
      "sanskrit": "नमोऽस्तु कृष्ण कृष्णेति देवदेवेति केशवम्। प्रणवात्मञ्जगन्नाथ नताः स्म शिरसा हरे॥१२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 260,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णस्य बदरिकाश्रमे आतिथ्यस्वीकारः",
      "combined_translation": "12-12"
    },
    {
      "verse": 13,
      "sanskrit": "कृष्ण विष्णो हृषीकेश केशवेति च सर्वदा। प्रणामप्रवणा विप्राः प्राहुरित्थं जगत्पतिम्॥१३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 260,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णस्य बदरिकाश्रमे आतिथ्यस्वीकारः",
      "combined_translation": "13-13"
    },
    {
      "verse": 14,
      "sanskrit": "इदमर्घ्यमिदं पाद्यमिदं विष्टरमेव च। कृतार्थाः सर्वदा देव प्रसन्नो नो जगत्पतिः॥१४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 260,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णस्य बदरिकाश्रमे आतिथ्यस्वीकारः",
      "combined_translation": "14-14"
    },
    {
      "verse": 15,
      "sanskrit": "किं कुर्मः किं नु नः कृत्यं कश्चिद्रोषः प्रभो हरे। इति प्राञ्जलयः सर्वे प्राहुर्देवस्य पश्यतः॥१५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 260,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णस्य बदरिकाश्रमे आतिथ्यस्वीकारः",
      "combined_translation": "15-15"
    },
    {
      "verse": 16,
      "sanskrit": "कृष्णोऽपि तद्यथायोगमुपयुज्य सहामरैः। कृतं सर्वं मुनिवरा वर्धतां तप उत्तमम्॥१६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 260,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णस्य बदरिकाश्रमे आतिथ्यस्वीकारः",
      "combined_translation": "16-16"
    },
    {
      "verse": 17,
      "sanskrit": "इति ब्रुवन्पुराणात्मा प्रीतस्तेन गरुत्मता। आसनं लम्भयामास रात्रौ देवो जनार्दनः॥१७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 260,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णस्य बदरिकाश्रमे आतिथ्यस्वीकारः",
      "combined_translation": "17-17"
    },
    {
      "verse": 18,
      "sanskrit": "कुशलं पृष्टवान्भूया मुनीनां भावितात्मनाम्। अग्निहोत्रेषु तपसि तथा भृत्येषु सर्वतः॥१८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 260,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णस्य बदरिकाश्रमे आतिथ्यस्वीकारः",
      "combined_translation": "18-18"
    },
    {
      "verse": 19,
      "sanskrit": "एवमादि जगन्नाथः पृष्टवानीश्वरस्तदा। सर्वत्र कुशलं तेऽत्र ब्रूयुः कृष्णस्य सर्वतः॥१९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 260,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णस्य बदरिकाश्रमे आतिथ्यस्वीकारः",
      "combined_translation": "19-19"
    },
    {
      "verse": 20,
      "sanskrit": "आतित्थ्यं चक्रिरे ते तु नीवारैः फलमूलकैः। देवानामथ सर्वेषां विष्णोः कृष्णस्य यत्नतः। आतिथ्यमुपयुञ्जानस्ततः प्रीतोऽभवद्धरिः॥२०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 260,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
