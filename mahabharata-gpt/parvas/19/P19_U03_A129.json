  "verses": [
    {
      "verse": 1,
      "sanskrit": "वैशम्पायन उवाच।\n              श्रुत्वा निहतमत्युग्रं भ्रातरं वीर्यशालिनम्। बलदेव परित्यज्य युध्यमानं महारणे॥१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 312,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "डिम्भकस्यात्मत्यागः",
      "combined_translation": "1-14"
    },
    {
      "verse": 2,
      "sanskrit": "डिम्भको वीर्यसम्पन्नो यमुनामनुजग्मिवान्। तमन्वधावद्वेगेन बलभद्रो हलायुधः॥२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 312,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "डिम्भकस्यात्मत्यागः"
    },
    {
      "verse": 3,
      "sanskrit": "हंसो हि यत्र पतितस्तत्रासौ निपपात ह। यमुनायां महाराज विलोड्य जलसञ्चयम्॥३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 312,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "डिम्भकस्यात्मत्यागः"
    },
    {
      "verse": 4,
      "sanskrit": "अथ क्रुद्धः स डिम्भको भ्रामयित्वा जलं बहु। उन्मज्योन्मज्य सहसा निमज्य च पुनः पुनः॥४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 312,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "डिम्भकस्यात्मत्यागः"
    },
    {
      "verse": 5,
      "sanskrit": "न ददर्श तदा राजन्भ्रातरं वीर्यशालिनम्। उन्मज्याथ महाबाहुर्वासुदेवं विलोक्य च॥५॥",
      "english": null,
      "bhavadeepa": "श्रुत्वेति। तथेति पादपूरणार्थः॥४॥",
      "chapter": 312,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "डिम्भकस्यात्मत्यागः"
    },
    {
      "verse": 6,
      "sanskrit": "उवाच वचनं राजन्डिम्भको वीर्यवत्तमः। अरे गोपकदायाद क्वासौ हंस इति स्थितः॥६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 312,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "डिम्भकस्यात्मत्यागः"
    },
    {
      "verse": 7,
      "sanskrit": "वासुदेवोऽपि धर्मात्मा यमुनां पृच्छ राजक। इत्यब्रवीत्प्रसन्नात्मा वासुदेवः प्रतापवान्॥७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 312,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "डिम्भकस्यात्मत्यागः"
    },
    {
      "verse": 8,
      "sanskrit": "तच्छ्रुत्वा यमुनां भूयः प्रविश्य डिम्भकः किल। बहुप्रकारमुद्वीक्ष्य भ्रातरं भ्रातृवत्सलः॥८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 312,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "डिम्भकस्यात्मत्यागः"
    },
    {
      "verse": 9,
      "sanskrit": "विललाप ततो राजा डिम्भको भ्रान्तमानसः। क्व नु गच्छसि राजेन्द्र विहायैनमबान्धवम्॥९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 312,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "डिम्भकस्यात्मत्यागः"
    },
    {
      "verse": 10,
      "sanskrit": "कुतो भ्रातरितो गच्छेः परित्यज्यैव मामिह। विलप्येवं नृपश्रेष्ठ डिम्भको भ्रातृवत्सलः॥१०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 312,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "डिम्भकस्यात्मत्यागः"
    },
    {
      "verse": 11,
      "sanskrit": "आत्मत्यागे मनः कुर्वन्यमुनाया महाह्रदे। निमज्योन्मज्य सहसा मरणे कृतनिश्चयः॥११॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 312,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "डिम्भकस्यात्मत्यागः"
    },
    {
      "verse": 12,
      "sanskrit": "हस्तेन जिह्वामाकृष्य भूयो भूयो विलप्य च। ततः समूलामाकृष्य जिह्वां साहसकृत्स्वयम्॥१२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 312,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "डिम्भकस्यात्मत्यागः"
    },
    {
      "verse": 13,
      "sanskrit": "ममारान्तर्जले राजन्डिम्भको नरकाय वै। एवं तु निहते हंसे डिम्भके वीर्यशालिनि॥१३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 312,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "डिम्भकस्यात्मत्यागः"
    },
    {
      "verse": 14,
      "sanskrit": "आगमत्पुण्डरीकाक्षो भूतान्विस्मापयन्निव। ततः प्रीतः प्रसन्नात्मा वासुदेवः प्रतापवान्॥१४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 312,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "डिम्भकस्यात्मत्यागः"
    },
    {
      "verse": 15,
      "sanskrit": "गोवर्धनेऽथ विश्रम्य बलभद्रसहायवान्। किञ्चित्कालं महाराज पूर्वभुक्तमुवास ह॥१५॥",
