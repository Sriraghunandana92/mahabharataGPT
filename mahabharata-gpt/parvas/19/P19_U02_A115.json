      "combined_translation": "15-15"
    },
    {
      "verse": 16,
      "sanskrit": "भ्रष्टराज्याश्च शोकार्ताः पाण्डवाः परिरक्षिताः। दाहितं च वनं घोरं पुरुहूतस्य खाण्डवम्॥१६॥",
      "english": null,
      "bhavadeepa": null,
