  "verse_count": 23,
  "verses": [
    {
      "verse": 1,
      "sanskrit": "जनमेजय उवाच।\n              भूय एवं द्विजश्रेष्ठा यदुसिंहस्य धीमतः। कर्माण्यपरिमेयाणि श्रोतुमिच्छामि तत्त्वतः॥१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 170,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "वासुदेवपराक्रमवर्णनम्-११५",
      "combined_translation": "1-28"
    },
    {
      "verse": 2,
      "sanskrit": "श्रूयन्ते विविधानि स्म अद्भुतानि महाद्युतेः। असङ्ख्येयानि दिव्यानि प्रकृतान्यपि सर्वशः॥२॥",
      "english": null,
      "bhavadeepa": "भूय एवेति॥१॥",
      "chapter": 170,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "वासुदेवपराक्रमवर्णनम्-११५",
      "combined_translation": "2-2"
    },
    {
      "verse": 3,
      "sanskrit": "यान्यहं विविधान्यस्य श्रुत्वा प्रीये महामुने। प्रब्रूयाः सर्वशस्तात तानि मे शृण्वतोऽनघ॥३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 170,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "वासुदेवपराक्रमवर्णनम्-११५",
      "combined_translation": "3-3"
    },
    {
      "verse": 4,
      "sanskrit": "वैशम्पायन उवाच।\n              बहून्याश्चर्यभूतानि केशवस्य महात्मनः। कथितानि महाबाहो नान्तं शक्यं हि कर्मणाम्॥४॥",
      "english": null,
      "bhavadeepa": "तातेति वात्सल्योत्पादनाय सम्बोधयति॥३॥",
      "chapter": 170,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "वासुदेवपराक्रमवर्णनम्-११५",
      "combined_translation": "4-4"
    },
    {
      "verse": 5,
      "sanskrit": "गन्तुं हि भरतश्रेष्ठ विस्तरेण समन्ततः। आवश्यं हि मया वाच्यं लेशमात्रेण भारत॥५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 170,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "वासुदेवपराक्रमवर्णनम्-११५",
      "combined_translation": "5-5"
    },
    {
      "verse": 6,
      "sanskrit": "विष्णोरमितवीर्यस्य प्रथितोदारकर्मणः। आनुपूर्व्या प्रवक्ष्यामि शृणुष्वैकमना नृप॥६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 170,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "वासुदेवपराक्रमवर्णनम्-११५",
      "combined_translation": "6-6"
    },
    {
      "verse": 7,
      "sanskrit": "द्वारवत्यां निवसता यदुसिंहेन धीमता। राष्ट्राणि नृपमुख्यानां क्षोभितानि महात्मनाम्॥७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 170,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "वासुदेवपराक्रमवर्णनम्-११५",
      "combined_translation": "7-7"
    },
    {
      "verse": 8,
      "sanskrit": "यदूनामन्तरप्रेप्सुर्विचक्रो दानवो हतः। पुरं प्राग्ज्योतिषं गत्वा पुनस्तेन महात्मना॥८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 170,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "वासुदेवपराक्रमवर्णनम्-११५",
      "combined_translation": "8-8"
    },
    {
      "verse": 9,
      "sanskrit": "समुद्रमध्ये दुष्टात्मा नरको दानवो हतः। वासवं च रणे जित्वा पारिजातो हृतो बलात्॥९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 170,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "वासुदेवपराक्रमवर्णनम्-११५",
      "combined_translation": "9-9"
    },
    {
      "verse": 10,
      "sanskrit": "वरुणश्चैव भगवान्निर्जितो लोहिते ह्रदे। दन्तवक्त्रश्च कारूषो निहतो दक्षिणापथे॥१०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 170,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "वासुदेवपराक्रमवर्णनम्-११५",
      "combined_translation": "10-10"
    },
    {
      "verse": 11,
      "sanskrit": "शिशुपालश्च सम्पूर्णे किल्बिषैकशते हतः। गत्वा च शोणितपुरं शङ्करेणाभिरक्षितः॥११॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 170,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "वासुदेवपराक्रमवर्णनम्-११५",
      "combined_translation": "11-11"
    },
    {
      "verse": 12,
      "sanskrit": "बलेः सुतो महावीर्यो बाणो बाहुसहस्रभृत्। महामृधे महाराज जित्वा जीवन्विसर्जितः॥१२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 170,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "वासुदेवपराक्रमवर्णनम्-११५",
      "combined_translation": "12-12"
    },
    {
      "verse": 13,
      "sanskrit": "निर्जितः पावकश्चैव गिरिमध्ये महात्मना। शाल्वश्च विजितः सङ्ख्ये सौभश्च विनिपातितः॥१३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 170,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
