      "combined_translation": "16-16"
    },
    {
      "verse": 17,
      "sanskrit": "गाण्डीवं चाग्निना दत्तमर्जुनायोपपादितम्। दौत्यं च तत्कृतं घोरे विग्रहे जनमेजय॥१७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 170,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "वासुदेवपराक्रमवर्णनम्-११५",
      "combined_translation": "17-17"
