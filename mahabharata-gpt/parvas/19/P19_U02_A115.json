      "combined_translation": "13-13"
    },
    {
      "verse": 14,
      "sanskrit": "विक्षोभ्य सागरं चैव पाञ्चजन्यो वशीकृतः। हयग्रीवश्च निहतो नृपाश्चान्ये महाबलाः॥१४॥",
      "english": null,
      "bhavadeepa": "गिरिमध्ये मेरुमध्ये॥१३॥",
