    {
      "verse": 15,
      "sanskrit": "जरासन्धस्य निधने मोक्षिताः सर्वपार्थिवाः। रथेन जित्वा नृपतीन्गान्धारतनया हृता॥१५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 170,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
