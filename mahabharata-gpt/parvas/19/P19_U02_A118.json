{
  "adhyaya_id": "P19_U02_A118",
  "book": 19,
  "parva_name": "हरिवंशः",
  "upaparva_name": "विष्णुपर्व",
  "adhyaya_name": "उषायाः स्वप्नदर्शनमनिरुद्धानयनार्थं चित्रलेखाया द्वारकागमनं च-११८",
  "chapter": 173,
  "verse_count": 98,
  "verses": [
    {
      "verse": 1,
      "sanskrit": "वैशम्पायन उवाच।\n              तत्रस्थाः परमा नार्यश्चित्रेण परमाद्भुताः। ततो हर्म्ये शयानां तु वैशाखे मासि भामिनीम्॥१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 173,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "उषायाः स्वप्नदर्शनमनिरुद्धानयनार्थं चित्रलेखाया द्वारकागमनं च-११८"
    },
    {
      "verse": 2,
      "sanskrit": "द्वादश्यां शुक्लपक्षस्य सखीगणवृतां तदा। यथोक्तः पुरुषः स्वप्ने रमयामास तां शुभाम्। विचेष्टमाना रुदती देव्या वचनचोदिता॥२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 173,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "उषायाः स्वप्नदर्शनमनिरुद्धानयनार्थं चित्रलेखाया द्वारकागमनं च-११८",
      "combined_translation": "2-2"
    },
    {
      "verse": 3,
      "sanskrit": "सा स्वप्ने रमिता तेन स्त्रीभावं चापि लम्भिता। शोणिताक्ता प्ररुदती सहसैवोत्थिता निशि॥३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 173,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "उषायाः स्वप्नदर्शनमनिरुद्धानयनार्थं चित्रलेखाया द्वारकागमनं च-११८",
      "combined_translation": "3-3"
    },
    {
      "verse": 4,
      "sanskrit": "तां तथा रुदतीं दृष्ट्वा सखी भयसमन्विता। चित्रलेखा वचः स्निग्धमुवाच परमाद्भुतम्॥४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 173,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "उषायाः स्वप्नदर्शनमनिरुद्धानयनार्थं चित्रलेखाया द्वारकागमनं च-११८",
      "combined_translation": "4-4"
    },
    {
      "verse": 5,
      "sanskrit": "उषे मा भैः किमेवं त्वं रुदती परितप्यसे। बलेः सुतसुता च त्वं प्रख्याता किं भयान्विता॥५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 173,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "उषायाः स्वप्नदर्शनमनिरुद्धानयनार्थं चित्रलेखाया द्वारकागमनं च-११८",
      "combined_translation": "5-5"
    },
    {
      "verse": 6,
      "sanskrit": "न भयं विद्यते लोके तव सुभ्रु विशेषतः। अभयं तव वामोरु पिता देवान्तको रणे॥६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 173,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "उषायाः स्वप्नदर्शनमनिरुद्धानयनार्थं चित्रलेखाया द्वारकागमनं च-११८",
      "combined_translation": "6-6"
    },
    {
      "verse": 7,
      "sanskrit": "उत्तिष्ठोत्तिष्ठ भद्रं ते विषादं मा कृथाः शुभे। नैवंविधेषु वासेषु भयमस्ति वरानने॥७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 173,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "उषायाः स्वप्नदर्शनमनिरुद्धानयनार्थं चित्रलेखाया द्वारकागमनं च-११८",
      "combined_translation": "7-34"
    },
    {
      "verse": 8,
      "sanskrit": "असकृद्देवसहितः शचीभर्ता सुरेश्वरः। अप्राप्त एव नगरं पित्रा ते मृदितो रणे॥८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 173,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "उषायाः स्वप्नदर्शनमनिरुद्धानयनार्थं चित्रलेखाया द्वारकागमनं च-११८",
      "combined_translation": "8-8"
    },
    {
      "verse": 9,
      "sanskrit": "अयं देवसमूहस्य भयदश्च पिता तव। महासुरवरः श्रीमान्बलेः पुत्रो महाबलः॥९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 173,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "उषायाः स्वप्नदर्शनमनिरुद्धानयनार्थं चित्रलेखाया द्वारकागमनं च-११८",
      "combined_translation": "9-9"
    },
    {
      "verse": 10,
      "sanskrit": "एवं साभिहिता सख्या बाणपुत्री यशस्विनी। स्वप्ने रूपं यथा दृष्टं न्यवेदयदनिन्दिता॥१०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 173,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "उषायाः स्वप्नदर्शनमनिरुद्धानयनार्थं चित्रलेखाया द्वारकागमनं च-११८",
      "combined_translation": "10-10"
    },
    {
      "verse": 11,
      "sanskrit": "उषोवाच\n              एवं सन्धर्षिता साध्वी कथं जीवितुमुत्सहे॥११॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 173,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "उषायाः स्वप्नदर्शनमनिरुद्धानयनार्थं चित्रलेखाया द्वारकागमनं च-११८",
      "combined_translation": "11-11"
    },
    {
      "verse": 12,
      "sanskrit": "पितरं किं नु वक्ष्यामि देवशत्रुमरिन्दमम्। एवं सन्दूषणकरी वंशस्यास्य महौजसः॥१२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 173,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "उषायाः स्वप्नदर्शनमनिरुद्धानयनार्थं चित्रलेखाया द्वारकागमनं च-११८",
      "combined_translation": "12-12"
    },
    {
      "verse": 13,
      "sanskrit": "श्रेयो हि मरणं मह्यं न मे श्रेयोऽद्य जीवितम्। ईप्सितो वा यथा कोऽपि पुरुशोऽधिगतो हि मे॥१३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 173,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "उषायाः स्वप्नदर्शनमनिरुद्धानयनार्थं चित्रलेखाया द्वारकागमनं च-११८",
      "combined_translation": "13-13"
    },
    {
      "verse": 14,
      "sanskrit": "जाग्रतीव यथा चाहमवस्थैवं कृता मम। निशायां जाग्रतीवाहं नीता केन दशामिमाम्। कथमेवं कृता नाम कन्या जीवितुमुत्सहे॥१४॥",
      "english": null,
      "bhavadeepa": "तत्रेति। मह्यं मम॥१३॥",
      "chapter": 173,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "उषायाः स्वप्नदर्शनमनिरुद्धानयनार्थं चित्रलेखाया द्वारकागमनं च-११८",
      "combined_translation": "14-14"
    },
    {
      "verse": 15,
      "sanskrit": "कुलोपक्रोशनकरी कुलाङ्गारी निराश्रया। जीवितुं न स्पृहेन्नारी साध्वीनामग्रतः स्थिता॥१५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 173,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "उषायाः स्वप्नदर्शनमनिरुद्धानयनार्थं चित्रलेखाया द्वारकागमनं च-११८",
      "combined_translation": "15-15"
    },
    {
      "verse": 16,
      "sanskrit": "इत्येवं बाष्पपूर्णाक्षी सखीजनवृता तदा। विललाप चिरं कालमुषा कमललोचना॥१६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 173,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "उषायाः स्वप्नदर्शनमनिरुद्धानयनार्थं चित्रलेखाया द्वारकागमनं च-११८",
      "combined_translation": "16-16"
    },
    {
      "verse": 17,
      "sanskrit": "अनाथवत्तां रुदतीं सख्यः सर्वा विचेतसः। ऊचुरश्रुपरीताक्षीमुषां सर्वाः समागताः॥१७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 173,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "उषायाः स्वप्नदर्शनमनिरुद्धानयनार्थं चित्रलेखाया द्वारकागमनं च-११८",
      "combined_translation": "17-17"
    },
    {
      "verse": 18,
      "sanskrit": "दुष्टेन मनसा देवि शुभं वा यदि वाशुभम्। क्रियते न च ते सुभ्रु किञ्चिद्दुष्टं मनः शुभे॥१८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 173,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "उषायाः स्वप्नदर्शनमनिरुद्धानयनार्थं चित्रलेखाया द्वारकागमनं च-११८",
      "combined_translation": "18-18"
    },
    {
      "verse": 19,
      "sanskrit": "प्रसभं देवसंयोगाद्यदि भुक्तासि भामिनि। स्वप्नयोगेन कल्याणि व्रतलोपो न विद्यते॥१९॥",
      "english": null,
      "bhavadeepa": "दुष्टेन कामवता मनसा यत् विक्रियते तदेव अशुभं वा पापं पुण्यं वा न त्वनिच्छाप्राप्तमित्यर्थः॥१८॥",
      "chapter": 173,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "उषायाः स्वप्नदर्शनमनिरुद्धानयनार्थं चित्रलेखाया द्वारकागमनं च-११८",
      "combined_translation": "19-19"
    },
    {
      "verse": 20,
      "sanskrit": "व्यभिचारेण ते देवि नास्ति कश्चिद्व्यतिक्रमः। न च स्वप्नकृतो दोषो मर्त्यलोकेऽस्ति सुन्दरि॥२०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 173,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "उषायाः स्वप्नदर्शनमनिरुद्धानयनार्थं चित्रलेखाया द्वारकागमनं च-११८",
      "combined_translation": "20-20"
    },
    {
      "verse": 21,
      "sanskrit": "एवं विप्रर्षयो देवि धर्मज्ञाः कथयन्ति वै। मनसा चैव वाचा च कर्मणा च विशेषतः। दुष्टा या त्रिभिरेतैस्तु पापा सा प्रोच्यते बुधैः॥२१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 173,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "उषायाः स्वप्नदर्शनमनिरुद्धानयनार्थं चित्रलेखाया द्वारकागमनं च-११८",
      "combined_translation": "21-21"
    },
    {
      "verse": 22,
      "sanskrit": "न च ते दृश्यते भीरु मनः प्रचलितं सदा। कथं त्वं दोषसन्दुष्टा नियता ब्रह्मचारिणी॥२२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 173,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "उषायाः स्वप्नदर्शनमनिरुद्धानयनार्थं चित्रलेखाया द्वारकागमनं च-११८",
      "combined_translation": "22-22"
    },
    {
      "verse": 23,
      "sanskrit": "यदि सुप्ता सती साध्वी शुद्धभावा मनस्विनी। इमामवस्थां प्राप्ता त्वं नैव धर्मो विलुप्यते॥२३॥",
      "english": null,
      "bhavadeepa": "प्रचलितं कामवेगवशीकृतं कथं त्वं दोषसन्दुष्टा न कथमपीत्यर्थः॥२२॥",
      "chapter": 173,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "उषायाः स्वप्नदर्शनमनिरुद्धानयनार्थं चित्रलेखाया द्वारकागमनं च-११८",
      "combined_translation": "23-23"
    },
    {
      "verse": 24,
      "sanskrit": "यस्या दुष्टं मनः पूर्वं कर्मणा चोपपादितम्। तामाहुरसतीं नाम सती त्वमसि भामिनि॥२४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 173,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "उषायाः स्वप्नदर्शनमनिरुद्धानयनार्थं चित्रलेखाया द्वारकागमनं च-११८",
      "combined_translation": "24-24"
    },
    {
      "verse": 25,
      "sanskrit": "कुलजा रूपसम्पन्ना नियता ब्रह्मचारिणी। इमामवस्थां नीतासि कालो हि दुरतिक्रमः॥२५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 173,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "उषायाः स्वप्नदर्शनमनिरुद्धानयनार्थं चित्रलेखाया द्वारकागमनं च-११८",
      "combined_translation": "25-25"
    },
    {
      "verse": 26,
      "sanskrit": "इत्येवमुक्तां रुदतीं बाष्पेणावृतलोचनाम्। कुम्भाण्डदुहिता वाक्यं परमं त्विदमब्रवीत्॥२६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 173,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "उषायाः स्वप्नदर्शनमनिरुद्धानयनार्थं चित्रलेखाया द्वारकागमनं च-११८",
      "combined_translation": "26-26"
    },
    {
      "verse": 27,
      "sanskrit": "त्यज शोकं विशालाक्षि अपापा त्वं वरानने। श्रुतं मे यदिदं वाक्यं याथातथ्येन तच्छृणु॥२७॥",
