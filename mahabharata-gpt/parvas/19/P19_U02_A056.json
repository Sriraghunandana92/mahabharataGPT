      "combined_translation": "28-28"
    },
    {
      "verse": 29,
      "sanskrit": "विहारभूमिस्तत्रैव तस्य राज्ञः सुनिर्मिता। नाम्ना द्वारवती नाम स्वायताष्टापदोपमा॥२९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 111,
      "parva_name": "हरिवंशः",
