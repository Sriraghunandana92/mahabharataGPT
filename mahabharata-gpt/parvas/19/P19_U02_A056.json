  "chapter": 111,
  "verse_count": 35,
  "verses": [
    {
      "verse": 1,
      "sanskrit": "वैशम्पायन उवाच।\n              कस्यचित्त्वथ कालस्य सभ्यांस्तान्यदुसंसदि। बभाषे पुण्डरीकाक्षो हेतुमद्वाक्यमुत्तमम्॥१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 111,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कालयवनस्याभियोगो द्वारवतीप्रयाणं च-०५६",
      "combined_translation": "1-126"
    },
    {
      "verse": 2,
      "sanskrit": "यादवानामियं भूमिर्मथुरा राष्ट्रमालिनी। वयं चैवेह सम्भूता व्रजे च परिवर्द्धिताः॥२॥",
      "english": null,
      "bhavadeepa": "षट्पञ्चाशत्तमेऽध्याये द्वारावतीविवक्षया। हेतुमद्वच आभाष्य मथुराचलनं हरेः॥१॥ कस्यचिदिति॥१॥",
      "chapter": 111,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कालयवनस्याभियोगो द्वारवतीप्रयाणं च-०५६",
      "combined_translation": "2-2"
    },
    {
      "verse": 3,
      "sanskrit": "तदिदानीं गतं दुःखं शत्रवश्च पराजिताः। नृपेषु जनितं वैरं जरासन्धेन विग्रहः॥३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 111,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कालयवनस्याभियोगो द्वारवतीप्रयाणं च-०५६",
      "combined_translation": "3-3"
    },
    {
      "verse": 4,
      "sanskrit": "वाहनानि च नः सन्ति पादातं चाप्यनन्तकम्। रत्नानि च विचित्राणि मित्राणि च बहूनि च॥४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 111,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कालयवनस्याभियोगो द्वारवतीप्रयाणं च-०५६",
      "combined_translation": "4-4"
    },
    {
      "verse": 5,
      "sanskrit": "इयं च माथुरी भूमिरल्पा गम्या परस्य तु। वृद्धिश्चैव परास्माकं बलतो मित्रतस्तथा॥५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 111,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कालयवनस्याभियोगो द्वारवतीप्रयाणं च-०५६",
      "combined_translation": "5-5"
    },
    {
      "verse": 6,
      "sanskrit": "कुमारकोट्यो याश्चेमाः पदातीनां गणाश्च ये। एषामपीह वसतां संमर्दमुपलक्षये॥६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 111,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कालयवनस्याभियोगो द्वारवतीप्रयाणं च-०५६",
      "combined_translation": "6-6"
    },
    {
      "verse": 7,
      "sanskrit": "अत्र नो रोचते मह्यं निवासो यदुपुङ्गवाः। पुरीं निवेशयिष्यामि मम तत्क्षन्तुमर्हथ॥७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 111,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कालयवनस्याभियोगो द्वारवतीप्रयाणं च-०५६",
      "combined_translation": "7-7"
    },
    {
      "verse": 8,
      "sanskrit": "एतद्यदनुरूपं वो ममाभिप्रायजं वचः। भवाय भवतां काले यदुक्तं यदुसंसदि॥८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 111,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कालयवनस्याभियोगो द्वारवतीप्रयाणं च-०५६",
      "combined_translation": "8-8"
    },
    {
      "verse": 9,
      "sanskrit": "तमूचुर्यादवाः सर्वे हृष्टेन मनसा तदा। साध्यतां यदभिप्रेतं जनस्यास्य भवाय वै॥९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 111,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कालयवनस्याभियोगो द्वारवतीप्रयाणं च-०५६",
      "combined_translation": "9-9"
    },
    {
      "verse": 10,
      "sanskrit": "ततः संमन्त्रयामासुर्वृष्णयो मन्त्रमुत्तमम्। अवध्योऽसौ कृतोऽस्माकं  सुमहच्च रिपोर्बलम्॥१०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 111,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कालयवनस्याभियोगो द्वारवतीप्रयाणं च-०५६",
      "combined_translation": "10-10"
    },
    {
      "verse": 11,
      "sanskrit": "कृतः सैन्यक्षयश्चापि महानिह नराधिपैः। बहुलानि च सैन्यानि हन्तुं वर्षशतैरपि। न शक्ष्यामो ह्यतस्तेषामपयानेऽभवन्मतिः॥११॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 111,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कालयवनस्याभियोगो द्वारवतीप्रयाणं च-०५६",
      "combined_translation": "11-11"
    },
    {
      "verse": 12,
      "sanskrit": "तस्मिंश्चैवान्तरे राजा स कालयवनस्तदा। सैन्येन तद्विधेनैव मथुरामभ्युपागमत्॥१२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 111,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कालयवनस्याभियोगो द्वारवतीप्रयाणं च-०५६",
      "combined_translation": "12-12"
    },
    {
      "verse": 13,
      "sanskrit": "ततो जरासन्धबलं दुर्निवार्यमभूत्तदा। ते कालयवनं चैव श्रुत्वेदं प्रतिपेदिरे॥१३॥",
      "english": null,
      "bhavadeepa": "राजा जरासन्धः सकालयवनः कालयवनेन सहितः॥१२॥",
      "chapter": 111,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कालयवनस्याभियोगो द्वारवतीप्रयाणं च-०५६",
      "combined_translation": "13-13"
    },
    {
      "verse": 14,
      "sanskrit": "केशवः पुनरेवाह यादवान्सत्यसङ्गरः। अद्यैव दिवसः पुण्यो निर्यामः स्वबलानुगाः॥१४॥",
      "english": null,
      "bhavadeepa": "इदम् अवध्योऽसावित्यादिपूर्वोक्तम् अपयानं प्रतिपेदिरे शरणीचक्रुः॥१३॥",
      "chapter": 111,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कालयवनस्याभियोगो द्वारवतीप्रयाणं च-०५६",
      "combined_translation": "14-14"
    },
    {
      "verse": 15,
      "sanskrit": "ततो निश्चक्रमुः सर्वे यादवाः कृष्णशासनात्। ओघा इव समुद्रस्य बलौघप्रतिनादिताः॥१५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 111,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कालयवनस्याभियोगो द्वारवतीप्रयाणं च-०५६",
      "combined_translation": "15-15"
    },
    {
      "verse": 16,
      "sanskrit": "सङ्गृह्य ते कलत्राणि वसुदेवपुरोगमाः। सुसन्नद्धैर्गजैर्मत्तै रथैरश्वैश्च दंशितैः॥१६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 111,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कालयवनस्याभियोगो द्वारवतीप्रयाणं च-०५६",
      "combined_translation": "16-16"
    },
    {
      "verse": 17,
      "sanskrit": "आहत्य दुन्दुभीन्सर्वे स्वजनज्ञातिबान्धवाः। निर्ययुर्यादवाः सर्वे मथुरामपहाय वै॥१७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 111,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कालयवनस्याभियोगो द्वारवतीप्रयाणं च-०५६",
      "combined_translation": "17-17"
    },
    {
      "verse": 18,
      "sanskrit": "स्यन्दनैः काञ्चनापीडैर्मत्तैश्च वरवारणैः। सूतैः प्लुतैश्च तुरगैः कशापार्ष्णिप्रणोदितैः॥१८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 111,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कालयवनस्याभियोगो द्वारवतीप्रयाणं च-०५६",
      "combined_translation": "18-18"
    },
    {
      "verse": 19,
      "sanskrit": "स्वानि स्वानि बलाग्राणि शोभयन्तः प्रकर्षिणः। प्रत्यङ्मुखा ययुर्हृष्टा वृष्णयो भरतर्षभ॥१९॥",
      "english": null,
      "bhavadeepa": "सूतैः प्लुतैः आज्ञामात्रादुत्पतद्भिः॥१८॥",
      "chapter": 111,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कालयवनस्याभियोगो द्वारवतीप्रयाणं च-०५६",
      "combined_translation": "19-19"
    },
    {
      "verse": 20,
      "sanskrit": "ततो मुख्यतमाः सर्वे यादवा रणकोविदाः। अनीकाग्राणि कर्षन्तो वासुदेवपुरोगमाः॥२०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 111,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कालयवनस्याभियोगो द्वारवतीप्रयाणं च-०५६",
      "combined_translation": "20-20"
    },
    {
      "verse": 21,
      "sanskrit": "ते स्म नानालताचित्रं नालिकेरवनायुतम्। कीर्णं नागबलैः कान्तं केतकीखण्डमण्डितम्॥२१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 111,
      "parva_name": "हरिवंशः",
