      "combined_translation": "21-21"
    },
    {
      "verse": 22,
      "sanskrit": "तालपुन्नागबकुलद्राक्षावनघनं क्वचित्। अनूपं सिन्धुराजस्य प्रपेतुर्यदुपुङ्गवाः॥२२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 111,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कालयवनस्याभियोगो द्वारवतीप्रयाणं च-०५६",
      "combined_translation": "22-22"
    },
    {
      "verse": 23,
      "sanskrit": "ते तत्र रमणीयेषु विषयेषु सुखप्रियाः। मुमुदुर्यादवाः सर्वे देवाः स्वर्गगता इव॥२३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 111,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कालयवनस्याभियोगो द्वारवतीप्रयाणं च-०५६",
      "combined_translation": "23-23"
    },
    {
      "verse": 24,
      "sanskrit": "पुरवास्तु विचिन्वन्स कृष्णस्तु परवीरहा। ददर्श विपुलं देशं सागरेणोपशोभितम्॥२४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 111,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कालयवनस्याभियोगो द्वारवतीप्रयाणं च-०५६",
      "combined_translation": "24-24"
    },
    {
      "verse": 25,
      "sanskrit": "वाहनानां हितं चैव सिकताताम्रमृत्तिकम्। पुरलक्षणसम्पन्नं कृतास्पदमिव श्रिया॥२५॥",
      "english": null,
      "bhavadeepa": "वास्तु स्थानम्॥२४॥",
      "chapter": 111,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कालयवनस्याभियोगो द्वारवतीप्रयाणं च-०५६",
      "combined_translation": "25-25"
    },
    {
      "verse": 26,
      "sanskrit": "सागरानिलसंवीतं सागराम्बुनिषेवितम्। विषयं सिन्धुराजस्य शोभितं पुरलक्षणैः॥२६॥",
      "english": null,
      "bhavadeepa": "सिकतायुक्ता ताम्रमृत्तिका यस्मिन्॥२५॥",
      "chapter": 111,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कालयवनस्याभियोगो द्वारवतीप्रयाणं च-०५६",
      "combined_translation": "26-26"
    },
    {
      "verse": 27,
      "sanskrit": "तत्र रैवतको नाम पर्वतो नातिदूरतः। मन्दरोदारशिखरः सर्वतोऽभिविराजते॥२७॥",
