  "adhyaya_name": "श्रीकृष्णस्य पुष्करं प्रति गमनम्",
  "chapter": 303,
  "verse_count": 19,
  "verses": [
    {
      "verse": 1,
      "sanskrit": "वैशम्पायन उवाच।\n              प्रविश्य स पुरं विष्णोः सात्यकिः शिनिपुङ्गवः। आचचक्षेऽथ कृष्णाय यथा वृत्तं तयोस्तथा॥१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 303,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णस्य पुष्करं प्रति गमनम्",
      "combined_translation": "1-22"
    },
    {
      "verse": 2,
      "sanskrit": "ततः प्रभाते विमले केशवः केशिसूदनः। बलाध्यक्षानुवाचेदं चक्रपाणिर्गदाधरः॥२॥",
      "english": null,
      "bhavadeepa": "प्रविश्येति॥१॥",
      "chapter": 303,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णस्य पुष्करं प्रति गमनम्",
      "combined_translation": "2-2"
    },
    {
      "verse": 3,
      "sanskrit": "सन्नह्यतां बलं सर्वं रथकुञ्जरवाजिमत्। अनेकभेरीपणवं प्रासासिपरिघाकुलम्॥३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 303,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णस्य पुष्करं प्रति गमनम्",
      "combined_translation": "3-3"
    },
    {
      "verse": 4,
      "sanskrit": "सध्वजं सपताकं च सालङ्कारपरिच्छदम्। ते तथेति प्रतिज्ञाय सर्वं चक्रुरधीनगाः॥४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 303,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णस्य पुष्करं प्रति गमनम्",
      "combined_translation": "4-4"
    },
    {
      "verse": 5,
      "sanskrit": "आदाय सुदृढं चापं रथमारुह्य दंशिताः। अग्रतो जग्मुरत्यर्थं सेनायाः पुरुषोत्तमाः॥५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 303,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णस्य पुष्करं प्रति गमनम्",
      "combined_translation": "5-5"
    },
    {
      "verse": 6,
      "sanskrit": "सात्यकिश्च तथा राजन्प्रगृहीतशरासनः। बभौ क्रोधसमायुक्तो जगामाग्रे महाबलः॥६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 303,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णस्य पुष्करं प्रति गमनम्",
      "combined_translation": "6-6"
    },
    {
      "verse": 7,
      "sanskrit": "अन्ये च यादवाः शूराः प्रगृहीतमहायुधाः। सिंहनादं प्रकुर्वन्तो जग्मुरत्यर्थमुत्तमाः॥७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 303,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णस्य पुष्करं प्रति गमनम्",
      "combined_translation": "7-7"
    },
    {
      "verse": 8,
      "sanskrit": "हरिस्तु रथमारुह्य संस्कृतं दारुकेन ह। शार्ङ्गभारसहं घोरं गृहीत्वा सशरं धनुः॥८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 303,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णस्य पुष्करं प्रति गमनम्",
      "combined_translation": "8-8"
    },
    {
      "verse": 9,
      "sanskrit": "चक्रपाणिस्तदा शङ्खी गदाशरवरासिमान्। बद्धगोधाङ्गुलित्राणः पीतवासा जनार्दनः॥९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 303,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णस्य पुष्करं प्रति गमनम्",
      "combined_translation": "9-9"
    },
    {
      "verse": 10,
      "sanskrit": "पद्ममालावृतोरस्को नवजीमूतसन्निभः। ययौ रथगतो विप्रैः स्तूयमानो मुदान्वितैः॥१०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 303,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णस्य पुष्करं प्रति गमनम्",
      "combined_translation": "10-10"
    },
    {
      "verse": 11,
      "sanskrit": "सूतैर्मागधपुत्रैश्च गीयमानस्ततस्ततः। आनीय सेनां सकलां ययौ काष्ठामथोत्तराम्॥११॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 303,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णस्य पुष्करं प्रति गमनम्",
      "combined_translation": "11-11"
    },
    {
      "verse": 12,
      "sanskrit": "पाञ्चजन्यं मुखे न्यस्य सर्वप्राणेन केशवः। दध्मौ महारवं कुर्वञ्छत्रूणाम् भयवर्धनम्॥१२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 303,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णस्य पुष्करं प्रति गमनम्",
      "combined_translation": "12-12"
    },
    {
      "verse": 13,
      "sanskrit": "आध्मातस्तेन हरिणा स चक्रे शङ्खराड्ध्रुवम्। रवः स रोदसि राजन् पूरयामास सर्वतः॥१३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 303,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णस्य पुष्करं प्रति गमनम्",
      "combined_translation": "13-13"
    },
    {
      "verse": 14,
      "sanskrit": "तस्मिञ्छङ्खे तथाऽऽध्माते दध्मुः शङ्खान्सहस्रशः। भेर्यश्चापि समाध्मात मृदङ्गा बहवो नृप॥१४॥",
      "english": null,
      "bhavadeepa": "स शङ्खजः॥१३॥",
      "chapter": 303,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णस्य पुष्करं प्रति गमनम्",
      "combined_translation": "14-14"
    },
    {
      "verse": 15,
      "sanskrit": "नेदुरत्यर्थमतुलं धर्मान्ते जलदा यथा। अथाययुर्महाराज पुष्करं पुण्यवर्धनम्॥१५॥",
      "english": null,
      "bhavadeepa": "दध्मुः ध्मातवन्तः॥१४॥",
      "chapter": 303,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णस्य पुष्करं प्रति गमनम्",
      "combined_translation": "15-15"
    },
    {
      "verse": 16,
      "sanskrit": "सरसस्तस्य राजेन्द्र पुष्करस्य नृपोत्तमाः। प्रतीक्ष्य हंसडिम्भकौ युद्धाय समवस्थिताः॥१६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 303,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णस्य पुष्करं प्रति गमनम्",
      "combined_translation": "16-16"
    },
    {
      "verse": 17,
      "sanskrit": "निवेशं कारयामासुर्यादवाः सर्व एव हि। स्वं स्वं ययुः सुखं राजन्प्रगृहीतकुटीमठम्॥१७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 303,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णस्य पुष्करं प्रति गमनम्",
      "combined_translation": "17-17"
    },
    {
      "verse": 18,
      "sanskrit": "भगवानपि गोविन्दः सरो दृष्ट्वा सुशोभनम्। उपस्पृश्य जले तस्मिन्पर्णम्य यतिपुङ्गवान्॥१८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 303,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णस्य पुष्करं प्रति गमनम्",
      "combined_translation": "18-18"
    },
    {
      "verse": 19,
      "sanskrit": "तयोरागमनं लिप्सुरास्ते तीरे यथासुखम्। शृण्वन्वेदध्वनिं विष्णुर्ब्राह्मणानां समन्ततः॥१९॥",
