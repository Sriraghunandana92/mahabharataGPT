{
  "adhyaya_id": "P19_U03_A119",
  "book": 19,
  "parva_name": "हरिवंशः",
  "upaparva_name": "भविष्यपर्व",
  "adhyaya_name": "सात्यकिप्रतिप्रयाणम्",
  "chapter": 302,
  "verse_count": 21,
  "verses": [
    {
      "verse": 1,
      "sanskrit": "वैशम्पायन उवाच।\n              ततः क्रुद्धो महाराज हंसो डिम्भक एव च। इदं वै प्रोचतुर्वाक्यं रोषव्याकुलितेक्षणौ॥१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 302,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "सात्यकिप्रतिप्रयाणम्",
      "combined_translation": "1-49"
    },
    {
      "verse": 2,
      "sanskrit": "दिधक्षन्तौ दिशाः सर्वाः सर्वान्वीक्ष्य नृपोत्तमान्। करेण निष्पीड्य करं स्मरन्तौ तद्वचो महत्॥२॥",
      "english": null,
      "bhavadeepa": "ततः क्रुद्ध इति॥१॥",
      "chapter": 302,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "सात्यकिप्रतिप्रयाणम्",
      "combined_translation": "2-2"
    },
    {
      "verse": 3,
      "sanskrit": "क्व नु क्व वा नन्दसूनुः क्व वा रामो बलोत्कटः। इति ब्रुवाणौ साक्षेपौ सात्यकिं सत्यसङ्गरम्॥३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 302,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "सात्यकिप्रतिप्रयाणम्",
      "combined_translation": "3-3"
    },
    {
      "verse": 4,
      "sanskrit": "अरे यादवदायाद किं ब्रूषे नः पुरोगतः। इतो निर्गच्छ मन्दात्मन्दूतस्त्वमसि साम्प्रतम्॥४॥",
      "english": null,
      "bhavadeepa": "क्व नु द्वौ कौ भ्रान्तत्वं सूचयतः। नन्दसूनुरिति। गोपत्वव्यञ्जकम्॥३॥",
      "chapter": 302,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "सात्यकिप्रतिप्रयाणम्",
      "combined_translation": "4-4"
    },
    {
      "verse": 5,
      "sanskrit": "अन्यथा वध्य एव त्वं प्रलपन्परुषं वचः। सत्यं निर्लज्ज एवासि यद्ब्रूया ईदृशं वचः॥५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 302,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "सात्यकिप्रतिप्रयाणम्",
      "combined_translation": "5-5"
    },
    {
      "verse": 6,
      "sanskrit": "आवामिदं जगत्सर्वं शासितुं संयतौ नृपौ। को नाम मानुषे लोके करदो नैव जीवति॥६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 302,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "सात्यकिप्रतिप्रयाणम्",
      "combined_translation": "6-6"
    },
    {
      "verse": 7,
      "sanskrit": "हत्वा गोपालकान्सर्वान्बद्ध्वा यादवकान्बहून्। गृह्णीमः करसर्वस्कं ततो गच्छ नराधम॥७॥",
      "english": null,
      "bhavadeepa": "कः करदो नैव जीवति अपि तु सर्वः सरदो जीवति। वृष्णयस्त्वकरदत्वान्न जीविष्यन्तीत्यर्थः॥६॥",
      "chapter": 302,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "सात्यकिप्रतिप्रयाणम्",
      "combined_translation": "7-7"
    },
    {
      "verse": 8,
      "sanskrit": "अवध्यो दूततां प्राप्तो बह्वबद्धं प्रभाषसे। ईश्वरो नौ वरं दाता ह्यस्त्राणामपि च प्रभुः॥८॥",
      "english": null,
      "bhavadeepa": "एतदेवाह- हत्वेति॥७॥",
      "chapter": 302,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "सात्यकिप्रतिप्रयाणम्",
      "combined_translation": "8-8"
    },
    {
      "verse": 9,
      "sanskrit": "रक्षितारौ महाभूतौ सङ्ग्रामं गच्छतोश्च नौ। पितरं याजयिष्यावो जित्वा गोपालकं रणे॥९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 302,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "सात्यकिप्रतिप्रयाणम्",
      "combined_translation": "9-9"
    },
    {
      "verse": 10,
      "sanskrit": "एते प्रोक्ता भृशं युद्धे कातराः सर्वे एव ते। हत्वा तान्सबलान्युद्धे पुनर्जेष्यामि केशवम्॥१०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 302,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "सात्यकिप्रतिप्रयाणम्",
      "combined_translation": "10-10"
    },
    {
      "verse": 11,
      "sanskrit": "संहर्तव्या महासेना प्रगृहीतशरासना। गृहीतप्रासमुशला गृहीतकवचा सदा॥११॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 302,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "सात्यकिप्रतिप्रयाणम्",
      "combined_translation": "11-11"
    },
    {
      "verse": 12,
      "sanskrit": "आरूढरथसाहस्रा गदापरिघसङ्कुला। सुप्रभूतेन्धनवती प्रभूतबलसाधना॥१२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 302,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "सात्यकिप्रतिप्रयाणम्",
      "combined_translation": "12-12"
    },
    {
      "verse": 13,
      "sanskrit": "चाल्पतां वाहिनी घोरा बलाध्यक्षा समन्ततः। अवध्य एव गच्छ त्वं न ते मरणतो भयम्॥१३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 302,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "सात्यकिप्रतिप्रयाणम्",
      "combined_translation": "13-13"
    },
    {
      "verse": 14,
      "sanskrit": "सङ्ग्रामः पुष्करेऽस्माकं श्वः परश्वोऽपि वा नृप। ततो ज्ञास्यामहे वीर्यं केशवस्य बलस्य च। ये त्वयोक्ता नृपाः सङ्ख्ये तेषामपि च यद्बलम्॥१४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 302,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "सात्यकिप्रतिप्रयाणम्",
      "combined_translation": "14-14"
    },
    {
      "verse": 15,
      "sanskrit": "सात्यकिरुवाच\n              हंसागच्छामि वां हन्तुं श्वः परश्वोऽपि वा नृप। अद्यैव हि मया वध्यौ न चेद्दुतो भवाम्यहम्॥१५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 302,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "सात्यकिप्रतिप्रयाणम्",
      "combined_translation": "15-15"
    },
    {
      "verse": 16,
      "sanskrit": "नहि श्वो वा परश्वो वा युवां कटुकभाषिणौ। दौत्ये हि दुःखमतुलं वहाम्येव सदा नृणाम्॥१६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 302,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "सात्यकिप्रतिप्रयाणम्",
      "combined_translation": "16-16"
    },
    {
      "verse": 17,
      "sanskrit": "अन्यथाहं युवां हत्वा ततो यास्यामि निर्वृतिम्। स्ववीर्यं बाहुदर्पं च दर्शयन्वां नृपाधमौ॥१७॥",
      "english": null,
      "bhavadeepa": "न हि जीविष्यथेति शेषः॥१६॥",
      "chapter": 302,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "सात्यकिप्रतिप्रयाणम्",
      "combined_translation": "17-17"
    },
    {
      "verse": 18,
      "sanskrit": "शङ्खचक्रगदापाणिः शार्ङ्गधन्वा किरीटभृत्। नीलकुञ्चितकेशाढ्यो लम्बबहुः श्रिया वृतः॥१८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 302,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "सात्यकिप्रतिप्रयाणम्",
      "combined_translation": "18-18"
    },
    {
      "verse": 19,
      "sanskrit": "स सर्वलोकप्रभवो निश्वरूपः सरूपवान्। दैत्यदानवहन्तासौ योगिध्येयः पुरातनः॥१९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 302,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "सात्यकिप्रतिप्रयाणम्",
      "combined_translation": "19-19"
    },
    {
      "verse": 20,
      "sanskrit": "पद्मकिञ्जल्कनयनः श्यामलः सिंहविक्रमः। सृष्टिस्थितिलयेष्वेकः कर्ता त्रिजगतो गुरुः॥२०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 302,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "सात्यकिप्रतिप्रयाणम्"
    },
    {
      "verse": 21,
      "sanskrit": "शरेण निशितेनाजौ दर्पं वां व्यपनेष्यति। इत्युक्त्वा रथमारुह्य प्रययौ सात्यकिः किल॥२१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 302,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
