{
  "adhyaya_id": "P19_U02_A066",
  "book": 19,
  "parva_name": "हरिवंशः",
  "upaparva_name": "विष्णुपर्व",
  "adhyaya_name": "श्रीकृष्णेन भामाक्रोधकारणप्रश्नः-०६६",
  "chapter": 121,
  "verse_count": 55,
  "verses": [
    {
      "verse": 1,
      "sanskrit": "वैशम्पायन उवाच।\n              उपविष्टं मुनिं ज्ञात्वा रुक्मिण्या सह केशवः। निश्चक्रामाप्रमेयात्मा व्यपदेशेन सर्ववित्॥१॥",
      "english": null,
      "bhavadeepa": "कुशेशयं मुखकमलम्॥५५॥",
      "chapter": 121,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "श्रीकृष्णेन भामाक्रोधकारणप्रश्नः-०६६"
    },
    {
      "verse": 2,
      "sanskrit": "जगाम त्वरितश्चैव सत्यभामागृहं महत्। रम्ये रैवतकोद्देशे निर्मितं विश्वकर्मणा॥२॥",
      "english": null,
      "bhavadeepa": "एतस्मिन् षट्षष्टितमे गत्वा भामागृहे हरिः। तस्यै ह्यपृच्छद्रोषस्य कारणं चेति वर्ण्यते॥१॥ उपविष्टमिति॥ व्यपदेशेन व्याजान्तरेण सर्ववित् सत्यभामाभाववित्॥१॥",
      "chapter": 121,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "श्रीकृष्णेन भामाक्रोधकारणप्रश्नः-०६६",
      "combined_translation": "2-2"
    },
    {
      "verse": 3,
      "sanskrit": "अभिमानवतीमिष्टां प्राणैरपि गरीयसीम्। जानन्सात्राजितीं विष्णुर्विवेश शनकैरिव॥३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 121,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "श्रीकृष्णेन भामाक्रोधकारणप्रश्नः-०६६",
      "combined_translation": "3-3"
    },
    {
      "verse": 4,
      "sanskrit": "रुषितामिव तां देवीं स्नेहात्सङ्कल्पयन्निव। भीतभीतः स शनकैर्विवेश मधुसूदनः॥४॥",
      "english": null,
      "bhavadeepa": "विवेश आससाद॥३॥",
      "chapter": 121,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "श्रीकृष्णेन भामाक्रोधकारणप्रश्नः-०६६",
      "combined_translation": "4-4"
    },
    {
      "verse": 5,
      "sanskrit": "सेवकं द्वारदेशे तु तिष्ठेत्युक्त्वा विवेश ह। नारदस्योपचारार्थं प्रद्युम्नं विनियुज्य सः॥५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 121,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "श्रीकृष्णेन भामाक्रोधकारणप्रश्नः-०६६",
      "combined_translation": "5-5"
    },
    {
      "verse": 6,
      "sanskrit": "स ददर्श प्रियां दूरात्क्रोधागारगतां तदा। प्रेक्ष्यामिव स्थितां कोपान्निःश्वसन्तीं मुहुर्मुहुः॥६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 121,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "श्रीकृष्णेन भामाक्रोधकारणप्रश्नः-०६६",
      "combined_translation": "6-6"
    },
    {
      "verse": 7,
      "sanskrit": "करजाग्रावलीढं तु पङ्कजं मुखपङ्कजे। संश्लेषयित्वा निःश्वस्य विहसन्तीं पुनः पुनः॥७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 121,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "श्रीकृष्णेन भामाक्रोधकारणप्रश्नः-०६६",
      "combined_translation": "7-7"
    },
    {
      "verse": 8,
      "sanskrit": "किञ्चिदाकुलिताग्रेण चरणेन वसुन्धराम्। कृत्वा पृष्ठेऽथ वदनं विहरन्तीं पुनः पुनः॥८॥",
      "english": null,
      "bhavadeepa": "पङ्कजं क्रीडाकमलं विहसन्तीं सपत्नी मत्तोऽपि सौभाग्याधिक्यं प्राप्तवतीत्याश्चर्येणेति भावः॥७॥",
      "chapter": 121,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "श्रीकृष्णेन भामाक्रोधकारणप्रश्नः-०६६",
      "combined_translation": "8-8"
    },
    {
      "verse": 9,
      "sanskrit": "करपद्मे पुनः सव्ये मुखपद्मं निवेश्य च। वनितां चारुसर्वाङ्गीं ध्यायन्तीं कमलेक्षणाम्॥९॥",
      "english": null,
      "bhavadeepa": "वसुन्धरां लिखन्तीमिति शेषः। पृष्ठे इति तिर्यक्त्वस्योपलक्षणम्॥८॥",
      "chapter": 121,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "श्रीकृष्णेन भामाक्रोधकारणप्रश्नः-०६६",
      "combined_translation": "9-9"
    },
    {
      "verse": 10,
      "sanskrit": "सरसं चन्दनं गृह्य प्रेष्याहस्तादनिन्दिताम्। प्रह्रादयित्वा हृदयं क्षिपन्तीं निर्दयं पुनः॥१०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 121,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "श्रीकृष्णेन भामाक्रोधकारणप्रश्नः-०६६",
      "combined_translation": "10-10"
    },
    {
      "verse": 11,
      "sanskrit": "पुनरुत्थाय शयनात्पतन्तीं च पुनः पुनः। तास्ताश्चेष्टाः प्रियायाश्च तथान्या ददृशे हरिः॥११॥",
      "english": null,
      "bhavadeepa": "प्रह्लादयित्वा चन्दनस्तुत्या प्रेष्यां स्तुत्वाऽपि विक्षिपन्तीं निन्दन्तीं तेन भ्रान्तत्वमस्याः व्यक्तम्॥१०॥",
      "chapter": 121,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "श्रीकृष्णेन भामाक्रोधकारणप्रश्नः-०६६",
      "combined_translation": "11-11"
    },
    {
      "verse": 12,
      "sanskrit": "अवगुण्ठ्य यदा वक्त्रमुपधाने न्यवेशयत्। इदमन्तरमित्येवं तदा गत्वा जनार्दनः॥१२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 121,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "श्रीकृष्णेन भामाक्रोधकारणप्रश्नः-०६६",
      "combined_translation": "12-12"
    },
    {
      "verse": 13,
      "sanskrit": "प्रेष्याजनं स संज्ञाय अनाख्येयोऽस्मि संज्ञया। स शङ्कितप्रचारश्च वारितोऽन्वगमत्स ताम्॥१३॥",
      "english": null,
      "bhavadeepa": "अवगुण्ठ्य वस्त्रेणावृत्य उपधाने उच्छीर्षके अन्तरमवकाशम्॥१२॥",
      "chapter": 121,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "श्रीकृष्णेन भामाक्रोधकारणप्रश्नः-०६६",
      "combined_translation": "13-13"
    },
    {
      "verse": 14,
      "sanskrit": "ग्रहाय व्यजनं चैव स्थित्वा स परिपार्श्वतः। शनैरिवासृजद्वातं जहास शनकैरिव॥१४॥",
      "english": null,
      "bhavadeepa": "संज्ञाय सङ्केत्य तां सोऽन्वगमत्॥१३॥",
      "chapter": 121,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "श्रीकृष्णेन भामाक्रोधकारणप्रश्नः-०६६",
      "combined_translation": "14-14"
    },
    {
      "verse": 15,
      "sanskrit": "स पारिजातपुष्पस्य संसर्गादनुवासितः। बभार भगवान्गन्धं दिव्यं मानुषदुर्लभम्॥१५॥",
      "english": null,
      "bhavadeepa": "ग्रहाय गृहीत्वा॥१४॥",
      "chapter": 121,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "श्रीकृष्णेन भामाक्रोधकारणप्रश्नः-०६६",
      "combined_translation": "15-15"
    },
    {
      "verse": 16,
      "sanskrit": "अत्यद्भुतं सुगन्धं च जिघ्रित्वा विस्मयान्विता। अपावृणोन्मुखं सत्या किमेतदिति चाब्रवीत्॥१६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 121,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "श्रीकृष्णेन भामाक्रोधकारणप्रश्नः-०६६",
      "combined_translation": "16-16"
    },
    {
      "verse": 17,
      "sanskrit": "सोत्थिता पृष्ठतो देवमपश्यन्ती शुचिस्मिता। पर्यपृच्छदथो प्रेष्या गन्धस्य प्रभवे तदा॥१७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 121,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "श्रीकृष्णेन भामाक्रोधकारणप्रश्नः-०६६",
      "combined_translation": "17-17"
    },
    {
      "verse": 18,
      "sanskrit": "ताः पृष्टास्त्वप्रभाषन्त्यो जानुभ्यां धरणीं गताः। अधोमुख्यस्ततस्तस्थुः कृताञ्जलिपुटास्तदा॥१८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 121,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "श्रीकृष्णेन भामाक्रोधकारणप्रश्नः-०६६",
      "combined_translation": "18-18"
    },
    {
      "verse": 19,
      "sanskrit": "तदपूर्वमदृष्ट्वैव गन्धं मुञ्चति मेदिनी। कथमेकतरस्तस्या गन्धोऽयमिति तत्खलु॥१९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 121,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "श्रीकृष्णेन भामाक्रोधकारणप्रश्नः-०६६",
      "combined_translation": "19-19"
    },
    {
      "verse": 20,
      "sanskrit": "किं त्विदं स्यादिति च सा विवेक्षन्ती समन्ततः। ददृशे केशवं देवी सहसा लोकभावनम्॥२०॥",
      "english": null,
      "bhavadeepa": "गन्धाश्रयमदृष्ट्वा मेदिन्येव गन्धं मुञ्चतीति तर्कयति कथमिति। एकतरोऽतिशयिततरः॥१९॥",
      "chapter": 121,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "श्रीकृष्णेन भामाक्रोधकारणप्रश्नः-०६६",
      "combined_translation": "20-20"
    },
    {
      "verse": 21,
      "sanskrit": "युज्यतीति ततोवाच सहसास्राविलेक्षणा। अवतिक्तेव रोषेण बभूव प्रणयान्विता॥२१॥",
      "english": null,
      "bhavadeepa": "विवेक्षन्ती व्यवेक्षमाणा। भागुरिमतेनाकारलोपः अनुदात्तेत्त्वलक्षणस्यात्मनेपदस्यानित्यत्वात्परस्मैपदम्॥२०॥",
      "chapter": 121,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "श्रीकृष्णेन भामाक्रोधकारणप्रश्नः-०६६",
      "combined_translation": "21-21"
    },
    {
      "verse": 22,
      "sanskrit": "सा प्रस्फुरितचार्वोष्ठी निःश्वस्याधोमुखी तदा। मुहूर्तमसितापाङ्गी तस्थावन्यमुखी शुभा॥२२॥",
      "english": null,
      "bhavadeepa": "युज्यतीति उवाच सद्योऽस्राविलक्षणाभूत् न तु अन्यत् वक्तुमशकत्॥२१॥",
      "chapter": 121,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "श्रीकृष्णेन भामाक्रोधकारणप्रश्नः-०६६",
      "combined_translation": "22-22"
    },
    {
      "verse": 23,
      "sanskrit": "निबध्य भ्रुकुटिं वामां सम्यग्विक्षिप्य लोचने। निवेश्य वदनं हस्ते शोभसीत्यब्रवीद्धरिम्॥२३॥",
      "english": null,
      "bhavadeepa": "अन्यमुखी कृष्णमनवक्षमाणा॥२२॥",
      "chapter": 121,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "श्रीकृष्णेन भामाक्रोधकारणप्रश्नः-०६६",
      "combined_translation": "23-23"
    },
    {
      "verse": 24,
      "sanskrit": "तस्याः सुस्राव नेत्राभ्यां वारि प्रणयकोपजम्। कुशेशयपलाशाभ्यामवश्यायजलं यथा॥२४॥",
      "english": null,
      "bhavadeepa": "शोभसीत्युपलम्भार्थं न तु रञ्जनार्थम्॥२३॥",
      "chapter": 121,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "श्रीकृष्णेन भामाक्रोधकारणप्रश्नः-०६६",
      "combined_translation": "24-24"
    },
    {
      "verse": 25,
      "sanskrit": "समुत्पत्य जलं तत्र पतितं वदनाम्बुजात्। प्रतिजग्राह पद्माक्षः कराभ्यामतिसत्वरः॥२५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 121,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "श्रीकृष्णेन भामाक्रोधकारणप्रश्नः-०६६",
      "combined_translation": "25-25"
    },
    {
      "verse": 26,
      "sanskrit": "अथोरसि पतत्तोयं स्रीवत्साङ्कोऽम्बुजेक्षणः। प्रियानयनजं देवः परिमृज्येदमब्रवीत्॥२६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 121,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "श्रीकृष्णेन भामाक्रोधकारणप्रश्नः-०६६",
      "combined_translation": "26-26"
    },
    {
      "verse": 27,
