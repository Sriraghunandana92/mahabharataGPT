  "chapter": 270,
  "verse_count": 38,
  "verses": [
    {
      "verse": 1,
      "sanskrit": "वैशम्पायन उवाच।\n              एवं बहुविधैर्भूतैः पिशाचैरुरगैः सह। आगत्य भगवान्रुद्रः शङ्करो वृशवाहनः॥१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 270,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीविष्णुकृता शिवस्तुतिः",
      "combined_translation": "1-19"
    },
    {
      "verse": 2,
      "sanskrit": "ददर्श विष्णुं देवेशं तपन्तं तप उत्तमम्। जुह्वानमग्निं विधिवद्द्रव्यैर्मेध्यैर्जगत्पतिम्॥२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 270,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीविष्णुकृता शिवस्तुतिः",
      "combined_translation": "2-2"
    },
    {
      "verse": 3,
      "sanskrit": "गरुडाहृतकाष्ठं तु जटिलं चीरवाससम्। चक्रेणानीतकुसुमं खड्गाणीतकुशं तथा॥३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 270,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीविष्णुकृता शिवस्तुतिः",
      "combined_translation": "3-3"
    },
    {
      "verse": 4,
      "sanskrit": "गदाकृतसमाचारं देवदेवं जनार्दनम्। इन्द्राद्यैर्देवसङ्घैश्च वृतं मुनिगणैः सह॥४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 270,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीविष्णुकृता शिवस्तुतिः",
      "combined_translation": "4-4"
    },
    {
      "verse": 5,
      "sanskrit": "अचिन्त्यं सर्वभूतानां ध्यायन्तं किमपि प्रभुम्। अवरुह्य वृषाच्छर्वो भगवान्भूतभावनः॥५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 270,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीविष्णुकृता शिवस्तुतिः",
      "combined_translation": "5-5"
    },
    {
      "verse": 6,
      "sanskrit": "ततः प्रीतः प्रसन्नात्मा ललाटाक्ष उमापतिः। ततो भूतपिशाचाश्च राक्षसा गुह्यकास्तथा॥६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 270,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीविष्णुकृता शिवस्तुतिः",
      "combined_translation": "6-6"
    },
    {
      "verse": 7,
      "sanskrit": "मुनयो विप्रवर्याश्च जयशब्दं प्रचक्रिरे। जय देव जगन्नाथ जय रुद्र जनार्दन॥७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 270,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीविष्णुकृता शिवस्तुतिः",
      "combined_translation": "7-7"
    },
    {
      "verse": 8,
      "sanskrit": "जय विष्णो हृषीकेश नारायण परायण। जय रुद्र पुराणात्मञ्जय देव हरेश्वर॥८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 270,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीविष्णुकृता शिवस्तुतिः",
      "combined_translation": "8-8"
    },
    {
      "verse": 9,
      "sanskrit": "आदिदेव जगन्नाथ जय शङ्कर भावन। जय कौस्तुभदीप्ताङ्ग जय भस्मविराजित॥९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 270,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीविष्णुकृता शिवस्तुतिः",
      "combined_translation": "9-9"
    },
    {
      "verse": 10,
      "sanskrit": "जय चक्रगदापाणे जय शूलिंस्त्रिलोचन। जय मौक्तिकदीप्ताङ्ग जय नागविभूषण॥१०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 270,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीविष्णुकृता शिवस्तुतिः",
      "combined_translation": "10-10"
    },
    {
      "verse": 11,
      "sanskrit": "इति ते मुनयः सर्वे प्रणामं चक्रिरे हरिम्। तत उत्थाय भगवान्दृष्ट्वा देवमवस्थितम्॥११॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 270,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीविष्णुकृता शिवस्तुतिः",
      "combined_translation": "11-11"
    },
    {
      "verse": 12,
      "sanskrit": "वृषद्वजं विरूपाक्षं शङ्करं नीललोहितम्। ततो हृष्टमना विष्णुस्तुष्टाव हरमीश्वरम्॥१२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 270,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीविष्णुकृता शिवस्तुतिः",
      "combined_translation": "12-12"
    },
    {
      "verse": 13,
      "sanskrit": "श्रीभगवानुवाच।\n              नमस्ते शितिकण्ठाय नीलग्रीवाय वेधसे। नमस्ते शोचिषे अस्तु नमस्ते उपवासिने॥१३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 270,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीविष्णुकृता शिवस्तुतिः",
      "combined_translation": "13-13"
    },
    {
      "verse": 14,
      "sanskrit": "नमस्ते मीढुषे अस्तु नमस्ते गदिने हर। नमस्ते विश्वतनवे वृषाय वृषरूपिणे॥१४॥",
      "english": null,
      "bhavadeepa": "एवमिति। शितिकण्ठाय शितिर्विषमेव कृष्णवर्णत्वात् कण्ठे यस्य तस्मै। अत एव नीलकण्ठाय। शोचिषे दीप्तिमते॥१३॥",
      "chapter": 270,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीविष्णुकृता शिवस्तुतिः",
      "combined_translation": "14-14"
    },
    {
      "verse": 15,
      "sanskrit": "अमूर्ताय च देवाय नमस्तेऽस्तु पिनाकिने। नमः कुब्जाय कूपाय शिवाय शिवरूपिणे॥१५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 270,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीविष्णुकृता शिवस्तुतिः"
    },
    {
      "verse": 16,
      "sanskrit": "नमस्तुष्टाय तुण्डाय नमस्तुटितुटाय च। नमः शिवाय शान्ताय गिरिशाय च ते नमः॥१६॥",
      "english": null,
      "bhavadeepa": "कूपाय कूपवासिने॥१५॥",
      "chapter": 270,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीविष्णुकृता शिवस्तुतिः",
      "combined_translation": "16-16"
    },
    {
      "verse": 17,
      "sanskrit": "नमो हराय हिप्राय नमो हरिहराय च। नमोऽघोराय घोराय घोरघोरप्रियाय च॥१७॥",
      "english": null,
      "bhavadeepa": "तुण्डाय मुखाय सर्वभक्षकायेत्यर्थः। तुष्टाय तुष्टिमते। तुटितुटाय हिंस्राय॥१६॥",
      "chapter": 270,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीविष्णुकृता शिवस्तुतिः",
      "combined_translation": "17-17"
    },
    {
      "verse": 18,
      "sanskrit": "नमोऽघण्टाय घण्टाय नमो घटिघटाय च। नमः शिवाय शान्ताय गिरिशाय च ते नमः॥१८॥",
      "english": null,
      "bhavadeepa": "हिप्राय हीनोति प्रापयति चेति हिप्रः। रेचकः पूरकश्च तदुभयरूपाय॥१७॥",
      "chapter": 270,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीविष्णुकृता शिवस्तुतिः",
      "combined_translation": "18-18"
    },
    {
      "verse": 19,
      "sanskrit": "नमो विरूपरूपाय पुराय पुरहारिणे। नम आद्याय बीजाय शुचयेऽष्टस्वरूपिणे॥१९॥",
      "english": null,
      "bhavadeepa": "अघण्टाय घण्टाय घण्टावते घटिघटाय घटयतां स्रष्टॄणामपि स्रष्ट्रे॥१८॥",
      "chapter": 270,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीविष्णुकृता शिवस्तुतिः",
      "combined_translation": "19-19"
    },
    {
      "verse": 20,
      "sanskrit": "नमः पिनाकहस्ताय नमः शूलासिधारिणे। नमः खट्वाङ्गहस्ताय नमस्ते कृत्तिवाससे॥२०॥",
      "english": null,
      "bhavadeepa": "पुराय क्षेत्ररूपाय। अष्टौ पृथिव्यादीनि स्वरूपाणि यस्य तस्मै अष्टस्वरूपिणे ॥१९॥",
      "chapter": 270,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीविष्णुकृता शिवस्तुतिः",
      "combined_translation": "20-20"
    },
    {
      "verse": 21,
      "sanskrit": "नमस्ते देवदेवाय नम आकाशमूर्तये। हराय हरिरूपाय नमस्ते तिग्मतेजसे॥२१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 270,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीविष्णुकृता शिवस्तुतिः",
      "combined_translation": "21-21"
    },
    {
      "verse": 22,
      "sanskrit": "भक्तप्रियाय भक्ताय भक्तानां वरदायिने। नमोऽभ्रमूर्तये देव जगन्मूर्तिधराय च॥२२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 270,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीविष्णुकृता शिवस्तुतिः",
      "combined_translation": "22-22"
    },
    {
      "verse": 23,
      "sanskrit": "नमश्चन्द्राय देवाय सूर्याय च नमो नमः। नमः प्रधानदेवाय भूतानां पतये नमः॥२३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 270,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीविष्णुकृता शिवस्तुतिः",
      "combined_translation": "23-23"
    },
    {
      "verse": 24,
      "sanskrit": "करालाय च मुण्डाय विकृताय कपर्दिने। अजाय च नमस्तुभ्यं भूतभावनभावन॥२४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 270,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीविष्णुकृता शिवस्तुतिः",
      "combined_translation": "24-24"
    },
    {
      "verse": 25,
      "sanskrit": "नमोऽस्तु हरिकेशाय पिङ्गलाय नमो नमः। नमस्तेऽभीषुहस्ताय भीरुभीरुहराय च॥२५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 270,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीविष्णुकृता शिवस्तुतिः",
      "combined_translation": "25-25"
    },
    {
      "verse": 26,
      "sanskrit": "हराय भीतिरूपाय घोराणां भीतिदायिने। नमो दक्षमखघ्नाय भगनेत्रापहारिणे॥२६॥",
      "english": null,
      "bhavadeepa": "हरिकेशाय हरयो रश्मयः इन्द्रियाणि वा केशा इव स्वरूपान्तर्गता बहिर्भूताश्च यस्येति हरिकेशः। यं परमेश्वरस्य सितकृष्णकेशौ रामकृष्णावित्युक्तः कृष्णावतारः केशो यस्यावतारिणो महेश्वरस्येति वा हरिकेशस्तस्मै। अभीषुहस्ताय अर्जुनसारथये। भीरुभीरुश्चासौ हरश्च तस्मै भीरुभीरुहराय अतिभीतायातिसंहर्त्रे इत्यर्थः॥२५॥",
      "chapter": 270,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीविष्णुकृता शिवस्तुतिः",
      "combined_translation": "26-26"
    },
    {
      "verse": 27,
      "sanskrit": "उमापते नमस्तुभ्यं कैलासनिलयाय च। आदिदेवाय देवाय भवाय भवरूपिणे॥२७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 270,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीविष्णुकृता शिवस्तुतिः",
      "combined_translation": "27-27"
    },
    {
      "verse": 28,
      "sanskrit": "नमः कपालहस्ताय नमोऽजमथनाय च। त्र्यम्बकाय नमस्तुभ्यं त्र्यक्षाय च शिवाय च॥२८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 270,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीविष्णुकृता शिवस्तुतिः",
      "combined_translation": "28-28"
    },
    {
      "verse": 29,
      "sanskrit": "वरदाय वरेण्याय नमस्ते चन्द्रशेखर। नम इध्माय हविषे ध्रुवाय च कृशाय च॥२९॥",
      "english": null,
      "bhavadeepa": "अजमथनाय ब्रह्मशिरोर्हत्रे॥२८॥",
      "chapter": 270,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीविष्णुकृता शिवस्तुतिः",
      "combined_translation": "29-29"
    },
    {
      "verse": 30,
      "sanskrit": "नमस्ते शक्तियुक्ताय नागपाशप्रियाय च। विरूपाय सुरूपाय मद्यपानप्रियाय च॥३०॥",
      "english": null,
