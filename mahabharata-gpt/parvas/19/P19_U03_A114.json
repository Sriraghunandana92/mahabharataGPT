{
  "adhyaya_id": "P19_U03_A114",
  "book": 19,
  "parva_name": "हरिवंशः",
  "upaparva_name": "भविष्यपर्व",
  "adhyaya_name": "जनार्दनाख्यदूतस्य द्वारवतीप्रयाणम्",
  "chapter": 297,
  "verse_count": 42,
  "verses": [
    {
      "verse": 1,
      "sanskrit": "वैशम्पायन उवाच।\n              ततः प्रायाद्धरिं विष्णुं ब्राह्मणो ब्रह्मवित्तमः। हयेनैकेन राजेन्द्र त्वरितं स ययौ नृप॥१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 297,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "जनार्दनाख्यदूतस्य द्वारवतीप्रयाणम्",
      "combined_translation": "1-29"
    },
    {
      "verse": 2,
      "sanskrit": "यथा निदाघसमये सूर्यांशुपरिपीडितः। पान्थो याति जलं दृष्ट्वा त्वरितं तत्पिपासया॥२॥",
      "english": null,
      "bhavadeepa": "तत इति॥१॥",
      "chapter": 297,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "जनार्दनाख्यदूतस्य द्वारवतीप्रयाणम्",
      "combined_translation": "2-2"
    },
    {
      "verse": 3,
      "sanskrit": "धावत्येव तथा विप्रो हरिं द्रष्टुं जनार्दनः। गच्छन्स चिन्तयामास चोदयन्हयमुत्तमम्॥३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 297,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "जनार्दनाख्यदूतस्य द्वारवतीप्रयाणम्",
      "combined_translation": "3-3"
    },
    {
      "verse": 4,
      "sanskrit": "हंस एव विप्रो मह्यं कुर्यात्प्रियहितं मम। तथाहि प्रेषितस्तेन हरिं पश्याम्यहं प्रभुम्॥४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 297,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "जनार्दनाख्यदूतस्य द्वारवतीप्रयाणम्",
      "combined_translation": "4-4"
    },
    {
      "verse": 5,
      "sanskrit": "अहमेव सदा धन्यो मत्तो ह्यभ्यधिको न हि। यतो द्रक्ष्याम्यहं विष्णुं वसन्तं द्वारकापुरे॥५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 297,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "जनार्दनाख्यदूतस्य द्वारवतीप्रयाणम्",
      "combined_translation": "5-5"
    },
    {
      "verse": 6,
      "sanskrit": "सा हि मे जननी धन्या हरिं दृष्ट्वा पुनर्गतम्। कृतार्थं सर्वदा देवी द्रक्ष्यत्येषा मनस्विनी॥६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 297,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "जनार्दनाख्यदूतस्य द्वारवतीप्रयाणम्",
      "combined_translation": "6-6"
    },
    {
      "verse": 7,
      "sanskrit": "मुखमुन्निद्रहेमाब्जकिञ्जल्कसदृशप्रभम्। द्रक्ष्यामि देवदेवस्य चक्रिणः शार्ङ्गधन्वनः॥७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 297,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "जनार्दनाख्यदूतस्य द्वारवतीप्रयाणम्",
      "combined_translation": "7-7"
    },
    {
      "verse": 8,
      "sanskrit": "वपुर्द्रक्ष्याम्यहं विष्णोर्नीलोत्पलदलच्छविः। शाङ्खचक्रगदाशार्ङ्गवनमालाविभूषितम्॥८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 297,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "जनार्दनाख्यदूतस्य द्वारवतीप्रयाणम्",
      "combined_translation": "8-8"
    },
    {
      "verse": 9,
      "sanskrit": "नेत्रे ते देवदेवस्य पद्मकिञ्जल्कसप्रभे। पश्याम्यहमदीनात्मा नष्टदुःखोऽस्मि निर्वृतः॥९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 297,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "जनार्दनाख्यदूतस्य द्वारवतीप्रयाणम्",
      "combined_translation": "9-9"
    },
    {
      "verse": 10,
      "sanskrit": "अपि द्रक्ष्यति योगात्मा सौम्येनैव स्वचक्षुषा। अपि वा मत्प्रियं ब्रूयात्स्वस्ति चेति च वा वदेत्॥१०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 297,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "जनार्दनाख्यदूतस्य द्वारवतीप्रयाणम्",
      "combined_translation": "10-10"
    },
    {
      "verse": 11,
      "sanskrit": "द्रक्ष्यामि चक्रिणो वर्ष्म ततस्त्रैलोक्यसन्निभम्। पादाब्जं चक्रिणो द्रष्टुं त्वरत्येव च मे मनः॥११॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 297,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "जनार्दनाख्यदूतस्य द्वारवतीप्रयाणम्",
      "combined_translation": "11-11"
    },
    {
      "verse": 12,
      "sanskrit": "वक्षःस्थलं सदा विष्णोः स्फुरद्रत्नप्रभायुतम्। पश्यन्निव च गच्छामि स्मरंश्चानिशमीश्वरम्॥१२॥",
      "english": null,
      "bhavadeepa": "वर्ष्म वपु॥११॥",
      "chapter": 297,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "जनार्दनाख्यदूतस्य द्वारवतीप्रयाणम्",
      "combined_translation": "12-12"
    },
    {
      "verse": 13,
      "sanskrit": "पीतकौशेयवसनं लम्बहारविभूषितम्। ईषत्स्मिताधरं विष्णुं पश्यामि च पुनः पुनः॥१३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 297,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "जनार्दनाख्यदूतस्य द्वारवतीप्रयाणम्",
      "combined_translation": "13-13"
    },
    {
      "verse": 14,
      "sanskrit": "स्मरतश्च हरे रूपं रोहमर्षोऽयमीदृशः। गच्छतश्च पुरो भाति शाङ्खचक्रगदासिमान्॥१४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 297,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "जनार्दनाख्यदूतस्य द्वारवतीप्रयाणम्",
      "combined_translation": "14-14"
    },
    {
      "verse": 15,
      "sanskrit": "यातीव च पुरे भाति मह्यं देवो जगद्गुरुः। एषोऽयमिति मे वक्तुं जिह्वा प्रस्फुरतीव तम्॥१५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 297,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "जनार्दनाख्यदूतस्य द्वारवतीप्रयाणम्"
    },
    {
      "verse": 16,
      "sanskrit": "इदं दुःखतरं मन्ये करं देहीति मद्वचः। इदं तत्साहसं मन्ये तद्वचस्तस्य भूपतेः॥१६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 297,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "जनार्दनाख्यदूतस्य द्वारवतीप्रयाणम्",
      "combined_translation": "16-16"
    },
    {
      "verse": 17,
      "sanskrit": "हंसस्य करदो विष्णुस्तदाज्ञापरिचारकः। तस्य सर्वं पुरो गत्वा वक्ताहं किल निर्दयः॥१७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 297,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "जनार्दनाख्यदूतस्य द्वारवतीप्रयाणम्",
      "combined_translation": "17-17"
    },
    {
      "verse": 18,
      "sanskrit": "मूढानामग्रणीरस्मि निर्लज्जश्च तथा वदन्। करं देहि हरे विष्णो हंसस्य यदुपुङ्गवः॥१८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 297,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "जनार्दनाख्यदूतस्य द्वारवतीप्रयाणम्",
      "combined_translation": "18-18"
    },
    {
      "verse": 19,
      "sanskrit": "लवणानि बहून्याशु दातव्हानि करात्मना। इति वक्तुं न मे युक्तं पुरतस्तस्य शार्ङ्गिणः॥१९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 297,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "जनार्दनाख्यदूतस्य द्वारवतीप्रयाणम्",
      "combined_translation": "19-19"
    },
    {
      "verse": 20,
      "sanskrit": "तथापि मित्रभावात्तु वक्तव्यं घोरमीदृशम्। कष्टो ह्ययं मित्रभावो मनुष्याणां कृतात्मनाम्॥२०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 297,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "जनार्दनाख्यदूतस्य द्वारवतीप्रयाणम्",
      "combined_translation": "20-20"
    },
    {
      "verse": 21,
      "sanskrit": "अथवा सर्वविद्विष्णुः सर्वस्य हृदि संस्थितम्। जानात्येव सदा भावं प्राणिनां शोभने रतः॥२१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 297,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "जनार्दनाख्यदूतस्य द्वारवतीप्रयाणम्",
      "combined_translation": "21-21"
    },
    {
      "verse": 22,
      "sanskrit": "तथा सति न मे दोषो मित्रभावो यतो ह्ययम्। सर्वथा रक्षतां विष्णुर्घोरं वक्तुं यतस्य मे॥२२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 297,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "जनार्दनाख्यदूतस्य द्वारवतीप्रयाणम्",
      "combined_translation": "22-22"
    },
    {
      "verse": 23,
      "sanskrit": "द्रक्ष्याम्यहं जगन्नाथं नीलकुञ्चितमूर्धजम्। कम्बुग्रीवधरं विष्णुं श्रीवत्साच्छादितोरसम्॥२३॥",
      "english": null,
      "bhavadeepa": "यतस्य मे यतन्तं माम्॥२२॥",
      "chapter": 297,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "जनार्दनाख्यदूतस्य द्वारवतीप्रयाणम्",
      "combined_translation": "23-23"
    },
    {
      "verse": 24,
      "sanskrit": "स्फुरत्पद्ममहाबाहुं रत्नच्छायाविराजितम्। द्रक्ष्यामि केशवं विष्णुं चक्रिणं यादवेश्वरम्॥२४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 297,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "जनार्दनाख्यदूतस्य द्वारवतीप्रयाणम्",
      "combined_translation": "24-24"
    },
    {
      "verse": 25,
      "sanskrit": "अचिन्त्यविभवं देवं भूतभव्यभवत्प्रभुम्। आत्मेच्छया जगद्रक्षं द्रक्ष्यामि जलशायिनम्॥२५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 297,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "जनार्दनाख्यदूतस्य द्वारवतीप्रयाणम्",
      "combined_translation": "25-25"
    },
    {
      "verse": 26,
      "sanskrit": "कृतार्थः सर्वथा चाहं भवामि विगतज्वरः। अद्य मे सफलं जन्म साक्षाद्दृष्टवतो हरिम्॥२६॥",
      "english": null,
      "bhavadeepa": "जगति रक्षा यस्मात्तं जगद्रक्षम्॥२५॥",
      "chapter": 297,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "जनार्दनाख्यदूतस्य द्वारवतीप्रयाणम्",
      "combined_translation": "26-26"
    },
    {
      "verse": 27,
      "sanskrit": "अद्य मे सफला यज्ञाः साक्षात्कृतवतो हरिम्। नेत्रे मे सफले विष्णुं पश्यतश्च जगन्मयम्॥२७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 297,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "जनार्दनाख्यदूतस्य द्वारवतीप्रयाणम्",
      "combined_translation": "27-27"
    },
    {
      "verse": 28,
      "sanskrit": "प्रीतिमानस्तु मे विष्णुर्वक्तुर्घोरस्य कर्मणः। उन्मिषन्नेत्रयुग्मेन द्रक्ष्यामि सकृदीश्वरम्॥२८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 297,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "जनार्दनाख्यदूतस्य द्वारवतीप्रयाणम्",
      "english_ref": 1,
      "combined_translation": "1-28"
    },
    {
      "verse": 29,
      "sanskrit": "आमूलमसकृद्विष्णुं पश्यामि च पुनः पुनः। पिबामि नेत्रयुग्मेन वपुः कृष्णस्य केवलम्॥२९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 297,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "जनार्दनाख्यदूतस्य द्वारवतीप्रयाणम्"
    },
    {
      "verse": 30,
      "sanskrit": "धारयिष्याम्यहं पांसुं तत्पादप्रभवं शिवम्। ततः कृतार्थतां यास्ये स्वर्गमार्गो हि तद्रजः॥३०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 297,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "जनार्दनाख्यदूतस्य द्वारवतीप्रयाणम्"
    },
