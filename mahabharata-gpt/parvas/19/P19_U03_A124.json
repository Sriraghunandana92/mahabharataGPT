{
  "adhyaya_id": "P19_U03_A124",
  "book": 19,
  "parva_name": "हरिवंशः",
  "upaparva_name": "भविष्यपर्व",
  "adhyaya_name": "हंसबलभद्रयोर्युद्धम्",
  "chapter": 307,
  "verse_count": 22,
  "verses": [
    {
      "verse": 1,
      "sanskrit": "वैशम्पायन उवाच।\n              बलदेवस्तु धर्मात्मा धनुरादाय सत्वरम्। जघान हंसं दशभिर्बाणैर्बाणभृतां वरः॥१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 307,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हंसबलभद्रयोर्युद्धम्",
      "combined_translation": "1-23"
    },
    {
      "verse": 2,
      "sanskrit": "तं प्रत्यविध्यन्नाराचैर्हंसः पञ्चभिराशुगैः। तानन्तरे हली छित्त्वा नाराचैर्दशभिः पुनः॥२॥",
      "english": null,
      "bhavadeepa": "बलदेव इति॥१॥",
      "chapter": 307,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हंसबलभद्रयोर्युद्धम्",
      "combined_translation": "2-2"
    },
    {
      "verse": 3,
      "sanskrit": "नाराचेनाशु विव्याध ललाटे हंसमोजसा। दृढं पतन्स नाराचस्तस्य संज्ञां समाददे। रथोपस्थे चिरं स्थित्वा तूणाद्बाणं समाददे॥३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 307,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हंसबलभद्रयोर्युद्धम्",
      "combined_translation": "3-3"
    },
    {
      "verse": 4,
      "sanskrit": "लब्ध्वा हंसः स संज्ञां तु विद्ध्वा तेन यदूत्तमम्। सिंहवद्व्यनद्धंसो देवान्विस्मापयन्रणे॥४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 307,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हंसबलभद्रयोर्युद्धम्",
      "combined_translation": "4-4"
    },
    {
      "verse": 5,
      "sanskrit": "ततः क्रुद्धो हली विद्धस्तेन बाणेन माधवः। वमञ्छोणितमत्युष्णं विश्वसंश्च रणाजिरे॥५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 307,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हंसबलभद्रयोर्युद्धम्",
      "combined_translation": "5-5"
    },
    {
      "verse": 6,
      "sanskrit": "लोहिताविष्टगात्रस्तु कुङ्कुमार्द्र इवाभवत्। नाराचैः शतसाहस्रैरर्दयामास माधवः॥६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 307,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हंसबलभद्रयोर्युद्धम्",
      "combined_translation": "6-6"
    },
    {
      "verse": 7,
      "sanskrit": "हंसं हंसगतिं वीरं नीलवासा हलयुधः। ते मुक्ता निशिता घोरा नाराचाश्च सुवाजिनः॥७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 307,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हंसबलभद्रयोर्युद्धम्",
      "combined_translation": "7-7"
    },
    {
      "verse": 8,
      "sanskrit": "रथे ध्वजे तथा चापे चक्रे तूणीद्वये नृप। पतिताः सर्वतो राजन्व्यथां चैव तथा ददुः॥८॥",
      "english": null,
      "bhavadeepa": "सुवाजिनः सुपक्षाः॥७॥",
      "chapter": 307,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हंसबलभद्रयोर्युद्धम्",
      "combined_translation": "8-8"
    },
    {
      "verse": 9,
      "sanskrit": "ततः क्रुद्धो महाराज हंसो वीर्यमदान्वितः। शरेण हलिनं विद्ध्वा ध्वजं चिच्छेद कालवित्॥९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 307,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हंसबलभद्रयोर्युद्धम्",
      "combined_translation": "9-9"
    },
    {
      "verse": 10,
      "sanskrit": "शरैश्चतुर्भिरश्वांश्च सूतं प्रेताधिपं ददौ। ततः क्रुद्धो हली तस्मै गदां गृह्य महारणे॥१०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 307,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हंसबलभद्रयोर्युद्धम्",
      "combined_translation": "10-10"
    },
    {
      "verse": 11,
      "sanskrit": "आपपात महाबाहुर्हंसं शेष इव श्वसन्। तथा रथं ध्वजं चक्रमश्वान्सूतं हलायुधः। बभञ्ज तिलशः सर्वं ननाद च पुनः पुनः॥११॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 307,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हंसबलभद्रयोर्युद्धम्",
      "combined_translation": "11-11"
    },
    {
      "verse": 12,
      "sanskrit": "भूयश्च गदया हंसं चिक्षेप च बली किल। सोऽपि हंसो गदां गृह्य रथात्तस्मादवापतत्॥१२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 307,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हंसबलभद्रयोर्युद्धम्",
      "combined_translation": "12-12"
    },
    {
      "verse": 13,
      "sanskrit": "ततस्तौ हंसहलिनौ युयुधाते महारणे। महारथौ महाबाहू लोके प्रथिततेजसौ॥१३॥",
      "english": null,
      "bhavadeepa": "हंसं चिक्षेप प्रजहार। बली बलरामः॥१२॥",
      "chapter": 307,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हंसबलभद्रयोर्युद्धम्",
      "combined_translation": "13-13"
    },
    {
      "verse": 14,
      "sanskrit": "अत्यद्भुतं सुविक्रान्तौ परस्परवधैषिणौ। कृतश्रमौ महायुद्धे हंसविक्रान्तगामिनौ॥१४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 307,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हंसबलभद्रयोर्युद्धम्",
      "combined_translation": "14-14"
    },
    {
      "verse": 15,
      "sanskrit": "यथा देवासुरे युद्धे शक्रवृत्रौ पुराम्बरे। उभौ संसक्तसर्वाङ्गौ शोणितेन महारणे॥१५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 307,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हंसबलभद्रयोर्युद्धम्",
      "combined_translation": "15-15"
    },
    {
      "verse": 16,
      "sanskrit": "अत्यन्तखेदिनौ युद्धे परस्परबलेन ह। ततश्च दक्षिणं मार्गं बलभद्रोऽन्वगच्छत॥१६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 307,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हंसबलभद्रयोर्युद्धम्",
      "combined_translation": "16-16"
    },
    {
      "verse": 17,
      "sanskrit": "सव्यं तु हंसो राजेन्द्रो व्यगृह्णात्स्वयमेव हि। पोथयाञ्चक्रतुर्युद्धे गदाभ्यां गजविक्रमौ॥१७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 307,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हंसबलभद्रयोर्युद्धम्",
      "combined_translation": "17-17"
    },
    {
      "verse": 18,
      "sanskrit": "यथाप्राणं महाबाहू जघ्नतुर्मरणाय तौ। अतिप्रवृद्धं सङ्ग्रामं देवासुररणोपमम्॥१८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 307,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हंसबलभद्रयोर्युद्धम्",
      "combined_translation": "18-18"
    },
    {
      "verse": 19,
      "sanskrit": "विदधाते महारङ्गे पश्यतां त्रिदिवौकसाम्। देवाश्च मुनयश्चैव विस्मयं परिजग्मिरे॥१९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 307,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हंसबलभद्रयोर्युद्धम्",
      "combined_translation": "19-19"
    },
    {
      "verse": 20,
      "sanskrit": "अहो खल्वीदृशं युद्धं दृष्टं पूर्वं न च श्रुतम्। इत्यूचुर्विस्मयवशाद्देवगन्धर्वकिन्नराः॥२०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 307,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हंसबलभद्रयोर्युद्धम्",
      "combined_translation": "20-20"
    },
    {
      "verse": 21,
      "sanskrit": "परस्परकृतोत्साहौ चक्रतुर्युद्धमुत्तमम्। अथ हंसो महारङ्गे दक्षिणं दक्षिणोत्तमः॥२१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 307,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हंसबलभद्रयोर्युद्धम्"
    },
    {
      "verse": 22,
      "sanskrit": "व्यचरन्मार्गमत्यर्थं सव्यं तु बलवान् बलः। निकुञ्च्य जानुनी पूर्वं चक्रतुर्गदया भृशम्। रणे रणविदां श्रेष्ठौ पश्यतां त्रिदिवौकसाम्॥२२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 307,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हंसबलभद्रयोर्युद्धम्",
      "combined_translation": "22-22"
    }
  ]
}