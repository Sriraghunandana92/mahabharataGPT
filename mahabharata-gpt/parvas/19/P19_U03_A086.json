  "adhyaya_name": "श्रीकृष्णसमीपे शिवागमनम्",
  "chapter": 269,
  "verse_count": 18,
  "verses": [
    {
      "verse": 1,
      "sanskrit": "वैशम्पायन उवाच।\n              तस्याग्रे समपद्यन्त भूतसङ्घाः सहस्रशः। घण्टाकर्णो विरूपाक्षः कुण्डधारः कुमुद्वहः॥१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 269,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णसमीपे शिवागमनम्",
      "combined_translation": "1-23"
    },
    {
      "verse": 2,
      "sanskrit": "दीर्घरोमा दीर्घभुजो दीर्घबाहुर्निरञ्जनः। उरुनेत्रः शतमुखः शतग्रीवः शतोदरः॥२॥",
      "english": null,
      "bhavadeepa": "तस्याग्र इति॥१॥",
      "chapter": 269,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णसमीपे शिवागमनम्",
      "combined_translation": "2-2"
    },
    {
      "verse": 3,
      "sanskrit": "कुण्डोदरो महाग्रीवः स्थूलजिह्वो द्विबाहुकः। पार्श्ववक्त्रः सिंहमुख उन्नतांसो महाहनुः॥३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 269,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णसमीपे शिवागमनम्",
      "combined_translation": "3-3"
    },
    {
      "verse": 4,
      "sanskrit": "त्रिबाहुः पञ्चबाहुश्च व्याघ्रवक्त्रः सिताननः। एते चान्ये च बहवो दीर्घास्या दीर्घलोचनाः॥४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 269,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णसमीपे शिवागमनम्",
      "combined_translation": "4-4"
    },
    {
      "verse": 5,
      "sanskrit": "नृत्यन्तः प्रहसन्तश्च स्फोटयन्तः परस्परम्। तथान्ये घोररूपाश्च तथान्ये विकृताननाः॥५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 269,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णसमीपे शिवागमनम्",
      "combined_translation": "5-5"
    },
    {
      "verse": 6,
      "sanskrit": "प्रेतभक्षाः प्रेतवाहा मांसशोणितभोजनाः। शवानि सुबहून्याशु भक्षयन्तस्ततस्ततः॥६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 269,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णसमीपे शिवागमनम्",
      "combined_translation": "6-6"
    },
    {
      "verse": 7,
      "sanskrit": "पिबन्तो रुधिरं घोरं खण्डयन्तः शवान्बहून्। कराला वितता दीर्घा धमनिस्नायुसन्तताः॥७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 269,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णसमीपे शिवागमनम्",
      "combined_translation": "7-7"
    },
    {
      "verse": 8,
      "sanskrit": "नानाविधाः सुवीराश्च शूलाग्रप्रोतमानुषाः। शिलामालावृताः केचिदान्त्रपाशावपाशिताः॥८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 269,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णसमीपे शिवागमनम्",
      "combined_translation": "8-8"
    },
    {
      "verse": 9,
      "sanskrit": "डिण्डिमैरट्टहासैश्च नादयन्तो वसुन्धराम्। कपालिनो भैरवाश्च जटिला मुण्डिनस्तथा॥९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 269,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णसमीपे शिवागमनम्",
      "combined_translation": "9-9"
    },
    {
      "verse": 10,
      "sanskrit": "एवं बहुविधा घोराः पिशाचा विकृताननाः। तथान्ये मुनिवीराश्च ध्यायन्तः परमेश्वरम्॥१०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 269,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णसमीपे शिवागमनम्",
      "combined_translation": "10-10"
    },
    {
      "verse": 11,
      "sanskrit": "पठन्तो देववाक्यानि साङ्गानि विविधानि च। कुण्डिकास्थकराः केचित्केचित्कुशविचारिणः॥११॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 269,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णसमीपे शिवागमनम्",
      "combined_translation": "11-11"
    },
    {
      "verse": 12,
      "sanskrit": "कौपीनवसनाः केचित्केचित्कार्पाससंवृताः। स्तुवन्तः शङ्करं भक्त्या स्तोत्रैर्माहेश्वरैस्तथा॥१२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 269,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णसमीपे शिवागमनम्",
      "combined_translation": "12-12"
    },
    {
      "verse": 13,
      "sanskrit": "एकत्र ते मुनिगणा अपरत्र गणास्तथा। अन्यत्र सिद्धगन्धर्वाः प्रियाभिः सह सङ्गताः॥१३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 269,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णसमीपे शिवागमनम्",
      "combined_translation": "13-13"
    },
    {
      "verse": 14,
      "sanskrit": "नृत्यन्ति नृत्यकुशला गायन्ति स्म च कन्यकाः। विद्याधरास्तथान्यत्र स्तुवन्तः शङ्करं शिवम्॥१४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 269,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
