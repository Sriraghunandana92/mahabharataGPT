{
  "adhyaya_id": "P19_U03_A082",
  "book": 19,
  "parva_name": "हरिवंशः",
  "upaparva_name": "भविष्यपर्व",
  "adhyaya_name": "घण्टाकर्णकृतो विष्णुस्तवः",
  "chapter": 265,
  "verse_count": 43,
  "verses": [
    {
      "verse": 1,
      "sanskrit": "वैशम्पायन उवाच।\n              पिशिताशो जगन्नाथं ददर्शाथ जगद्गुरुम्। समाधौ च यथादृष्टं भूमौ चापि तथा हरिम्॥१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 265,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "घण्टाकर्णकृतो विष्णुस्तवः",
      "combined_translation": "1-22"
    },
    {
      "verse": 2,
      "sanskrit": "अयं विष्णुरयं विष्णुरित्यूचे पिशिताशनः। समाधौ च यथा दृष्टः सोऽयमत्रापि दृश्यते। इत्युक्त्वा च पुनर्ब्रूते नृत्यन्निव हसन्निव॥२॥",
      "english": null,
      "bhavadeepa": "पिशिताशेति॥१॥",
      "chapter": 265,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "घण्टाकर्णकृतो विष्णुस्तवः",
      "combined_translation": "2-2"
    },
    {
      "verse": 3,
      "sanskrit": "अयं स चक्री शरशार्ङधन्वा गादी रथी सध्वजतूणपाणिः। सहस्रमूर्धा सकलामरेशो जगत्प्रसूतिर्जगतां निवासः॥३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 265,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "घण्टाकर्णकृतो विष्णुस्तवः",
      "combined_translation": "3-3"
    },
    {
      "verse": 4,
      "sanskrit": "विष्णुर्जिष्णुर्जगन्नाथः पुराणः पुरुशोत्तमः। विश्वात्मा विश्वकर्ता यः सोऽयमेष सनातनः॥४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 265,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "घण्टाकर्णकृतो विष्णुस्तवः",
      "combined_translation": "4-4"
    },
    {
      "verse": 5,
      "sanskrit": "अस्यैव देवस्य हरेः स्तनान्तरे विराजते कौस्तुभरत्नदीपः। यस्य प्रसादाज्जगदेतदादौ विराजते चन्द्रमसेव रात्रिः॥५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 265,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "घण्टाकर्णकृतो विष्णुस्तवः",
      "combined_translation": "5-5"
    },
    {
      "verse": 6,
      "sanskrit": "योऽसौ पृथ्वीं दधाराशु दंष्ट्रया जलसञ्चयात्। योऽयमेव हरिः साक्षद्वाराहं वपुरास्थितः॥६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 265,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "घण्टाकर्णकृतो विष्णुस्तवः",
      "combined_translation": "6-6"
    },
    {
      "verse": 7,
      "sanskrit": "बद्ध्वा तथा दानवमुग्रपौरुषं ददौ च शक्राय ततोऽनुराज्यम्। बलिं बलादेष हरिः स वामनः स्तुतश्च भक्त्या मुनिभिः पुरातनैः॥७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 265,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "घण्टाकर्णकृतो विष्णुस्तवः",
      "combined_translation": "7-7"
    },
    {
      "verse": 8,
      "sanskrit": "दंष्ट्राकरालः सुमहान्हत्वा यो दानवान्रणे। निःशोकमखिलं लोकं चकारासौ जनार्दनः॥८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 265,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "घण्टाकर्णकृतो विष्णुस्तवः",
      "combined_translation": "8-8"
    },
    {
      "verse": 9,
      "sanskrit": "आदौ दधारैकभुजेन मन्दरं निर्जित्य सर्वानसुरान्महार्णवे। ददौ च शक्राय सुधामयं महान्स एष साक्षादिह मामवस्थितः॥९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 265,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "घण्टाकर्णकृतो विष्णुस्तवः",
      "combined_translation": "9-9"
    },
    {
      "verse": 10,
      "sanskrit": "यः शेते जलधौ नागे देव्या लक्ष्म्या सुखावहे। हत्वा तौ दानवौ घोरौ मधुकैटभसंज्ञितौ॥१०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 265,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "घण्टाकर्णकृतो विष्णुस्तवः",
      "combined_translation": "10-10"
    },
    {
      "verse": 11,
      "sanskrit": "यमाहुराद्यं विबुधा जगत्पतिं सर्वस्य धातारमजं जनित्रम्। अणोरणीयांसमतिप्रमाणं स्थूलात्स्थविष्ठं हरिमेव विष्णुम्॥११॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 265,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "घण्टाकर्णकृतो विष्णुस्तवः",
      "combined_translation": "11-11"
    },
    {
      "verse": 12,
      "sanskrit": "यत्र स्थितमिदं सर्वं प्राप्ते लोकस्य नाशने। आदौ यस्मात्समुत्पन्नं सोऽयं विष्णुरितिस्थितः॥१२॥",
      "english": null,
      "bhavadeepa": "जनित्रं जनयितारम्॥११॥",
      "chapter": 265,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "घण्टाकर्णकृतो विष्णुस्तवः",
      "combined_translation": "12-12"
    },
    {
      "verse": 13,
      "sanskrit": "यस्येच्छया सर्वमिदं प्रवृत्तं प्रवर्तते चापि जनार्दनस्य। अयं स विष्णुः पुरुषोत्तमः शिवः प्रवर्तते मामिह यादवेश्वरः॥१३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 265,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "घण्टाकर्णकृतो विष्णुस्तवः",
      "combined_translation": "13-13"
    },
    {
      "verse": 14,
      "sanskrit": "भृगोर्वंशे समुत्पन्नो जामदग्न्य इति श्रुतः। शिष्यत्वं समवाप्यैव मृगव्याधस्य यः स्थितः॥१४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 265,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "घण्टाकर्णकृतो विष्णुस्तवः",
      "combined_translation": "14-14"
    },
    {
      "verse": 15,
      "sanskrit": "जघान वीर्याद्बलिनं महारणे कुठारशस्त्रेण गिरीशशिष्यः। सहस्रबाहुं कृतवीर्यसम्भवं हयैर्गजैश्चैव रथैश्च निर्गतम्॥१५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 265,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "घण्टाकर्णकृतो विष्णुस्तवः",
      "combined_translation": "15-15"
    },
    {
      "verse": 16,
      "sanskrit": "कुरुक्षेत्रं समासाद्य यश्चकार पितृक्रियाम्। निःक्षत्रियमिमं लोकं कृतवानेकविंशतिः॥१६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 265,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "घण्टाकर्णकृतो विष्णुस्तवः",
      "combined_translation": "16-16"
    },
    {
      "verse": 17,
      "sanskrit": "रघोरथ कुले जातो रामो नाम जनार्दनः। सीतया च श्रिया युक्तो लक्ष्मणानुचरः कृती॥१७॥",
      "english": null,
      "bhavadeepa": "पितृक्रियां पितृतर्पणं रुधिरेणेति शेषः॥१६॥",
      "chapter": 265,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "घण्टाकर्णकृतो विष्णुस्तवः",
      "combined_translation": "17-17"
    },
    {
      "verse": 18,
      "sanskrit": "कृत्वा च सेतुं जलधौ जनार्दनो हत्वा च रक्षःपतिमाशुगैः शरैः। दत्त्वा च राज्यं स विभिषणाय दशाश्वमेधैरयजच्च योऽसौ॥१८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 265,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "घण्टाकर्णकृतो विष्णुस्तवः",
      "combined_translation": "18-18"
    },
    {
      "verse": 19,
      "sanskrit": "वसुदेवकुले जातो वासुदेवेति शब्दितः। गोकुले क्रीडते योऽसौ सङ्कर्षणसहायवान्॥१९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 265,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "घण्टाकर्णकृतो विष्णुस्तवः",
      "combined_translation": "19-19"
    },
    {
      "verse": 20,
      "sanskrit": "उत्तानशायी शिषुरूपधारी पीत्वा स्तनं पूतनिकाप्रदत्तम्। व्यसुं चकाराशु जनार्दनस्तदा दनोः सुतां तामवसत्सुखं हरिः॥२०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 265,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "घण्टाकर्णकृतो विष्णुस्तवः",
      "combined_translation": "20-20"
    },
    {
      "verse": 21,
      "sanskrit": "पयःपानं तथा कुर्वन्भक्षयन्दधिपिण्डकम्। दाम्ना बद्धोदरो विष्णुर्मात्रा रुषितया दृढम्॥२१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 265,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "घण्टाकर्णकृतो विष्णुस्तवः",
      "combined_translation": "21-21"
    },
    {
      "verse": 22,
      "sanskrit": "ततश्च दाम्ना सुदृढेन बद्धो जघान योऽसौ यमलार्जुनौ च। क्रीडन्हरिर्गोकुलवासवासी गोपीभिरास्वाद्य मुखं स्तनं च॥२२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 265,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "घण्टाकर्णकृतो विष्णुस्तवः",
      "combined_translation": "22-22"
    },
    {
      "verse": 23,
      "sanskrit": "वृन्दावने वसन्विष्णुर्गोपैर्गोकुलवासिभिः। तत्र हत्वा हयं राजान्विरराजांशुमानिव॥२३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 265,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "घण्टाकर्णकृतो विष्णुस्तवः",
      "combined_translation": "23-23"
    },
    {
      "verse": 24,
      "sanskrit": "यः क्रीडते नागफणौ जनार्दनो निषेव्यमाणः सह गोपदारकैः। महाह्रदे नागपतिं जगत्पतिर्ममर्द वीर्यातिशयं प्रदर्शयन्॥२४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 265,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "घण्टाकर्णकृतो विष्णुस्तवः",
      "combined_translation": "24-24"
    },
    {
      "verse": 25,
      "sanskrit": "यो धेनुकं तालवने तत्फलैः सममच्छिनत्। हत्वा दानवमुग्रं तं गोपान्विस्मापयत्यसौ॥२५॥",
      "english": null,
      "bhavadeepa": "फणावाक्रम्येति शेषः। “फणा द्वयो” इत्यमरः। पुंसि द्विवचनमिदम्॥२४॥",
      "chapter": 265,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "घण्टाकर्णकृतो विष्णुस्तवः",
      "combined_translation": "25-25"
    },
    {
      "verse": 26,
      "sanskrit": "दधार यो गोधरमुग्रपौरुषान्महामतिर्मेघसमागमे सति। विडम्बयञ्छक्रबलं प्रमोदयन् गोपांश्च गोपीश्च स गोकुलं हरिः॥२६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 265,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "घण्टाकर्णकृतो विष्णुस्तवः",
      "combined_translation": "26-26"
    },
    {
      "verse": 27,
      "sanskrit": "गोपीनां स्तनमध्ये तु क्रीडते काममीश्वरः। योऽसौ पिबंस्तदधरं मायामानुषदेहवान्॥२७॥",
      "english": null,
      "bhavadeepa": "गोधरं शैलम्॥२६॥",
      "chapter": 265,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "घण्टाकर्णकृतो विष्णुस्तवः",
      "combined_translation": "27-27"
    },
    {
      "verse": 28,
      "sanskrit": "गोपीभिरास्वाद्य मुखं विविक्ते शेते स्म रत्रौ सुखमेव केशवः। स्तनान्तरेष्वेव तदा च तासां कामीव कान्ताधरपल्लवं पिबन्॥२८॥",
      "english": null,
      "bhavadeepa": "स्तनमध्ये हृदये॥२७॥",
      "chapter": 265,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "घण्टाकर्णकृतो विष्णुस्तवः",
      "combined_translation": "28-28"
    },
    {
      "verse": 29,
      "sanskrit": "अक्रूरेण समाहूतस्तेन गच्छन्हि यामुने। जले यो ह्यर्चितस्तेन नागलोके स एव हि॥२९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 265,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
