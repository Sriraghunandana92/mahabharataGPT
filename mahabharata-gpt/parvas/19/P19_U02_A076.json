  "adhyaya_name": "द्युतरोः पुनः स्वस्थाने नयनम्-०७६",
  "chapter": 131,
  "verse_count": 35,
  "verses": [
    {
      "verse": 1,
      "sanskrit": "वैशम्पायन उवाच।\n              अथ कृष्णस्य कौरव्य ध्यातमात्रस्तपोधनः। आजगाम मुनिश्रेष्ठो नारदो वदतां वरः॥१॥",
      "english": null,
      "bhavadeepa": "व्रतकस्य व्रते प्रदेयस्य दानस्य॥६९॥",
      "chapter": 131,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "द्युतरोः पुनः स्वस्थाने नयनम्-०७६"
    },
    {
      "verse": 2,
      "sanskrit": "सम्पूजयित्वा विधिवद्वासुदेवो विशाम्पते। प्रतिग्रहार्थं विधिवच्छ्रीमान्भक्त्या न्यमन्त्रयत्॥२॥",
      "english": null,
      "bhavadeepa": "षट्सप्ततितमेऽध्यायेऽमुष्मिन्पुण्यकसिद्धये। नारदाय प्रदायाथ द्युतरुं चानयद्दिवम्॥ अथेति॥१॥",
      "chapter": 131,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "द्युतरोः पुनः स्वस्थाने नयनम्-०७६",
      "combined_translation": "2-2"
    },
    {
      "verse": 3,
      "sanskrit": "ततः काले च सम्प्राप्ते स्नातं देवो महामुनिम्। सम्पूज्य माल्यैर्गन्धैश्च भोजयामास भारत॥३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 131,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "द्युतरोः पुनः स्वस्थाने नयनम्-०७६",
      "combined_translation": "3-3"
    },
    {
      "verse": 4,
      "sanskrit": "सार्वकामिकमन्नाद्यं सर्वभूतकृदन्वयः। सत्यया प्रियया सार्धं प्रहृष्टेनान्तरात्मना॥४॥",
      "english": null,
      "bhavadeepa": "काले दानोचिते॥३॥",
      "chapter": 131,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "द्युतरोः पुनः स्वस्थाने नयनम्-०७६",
      "combined_translation": "4-4"
    },
    {
      "verse": 5,
      "sanskrit": "पुष्पदामावसज्याथ कण्टे कृष्णस्य भाविनी। बबन्ध कृष्णं सुभगा पारिजाते वनस्पतौ॥५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 131,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "द्युतरोः पुनः स्वस्थाने नयनम्-०७६",
      "combined_translation": "5-5"
    },
    {
      "verse": 6,
      "sanskrit": "अद्भिर्ददौ नारदाय ततोऽनुज्ञाप्य केशवम्। देवी धेनुसहस्रं च काञ्चनस्य च पर्वतम्॥६॥",
      "english": null,
      "bhavadeepa": "भाविनी सद्भाववती॥५॥",
      "chapter": 131,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "द्युतरोः पुनः स्वस्थाने नयनम्-०७६",
      "combined_translation": "6-6"
    },
    {
      "verse": 7,
      "sanskrit": "हिरण्यरूप्यमिश्रं च मणिरत्नप्रभस्य च। तिलमिश्रस्य च तथा धन्यैरन्यैर्युतस्य च॥७॥",
      "english": null,
      "bhavadeepa": "देवी केशवमनुज्ञाप्य अद्भिर्नारदाय ददावित्यन्वयः॥६॥",
      "chapter": 131,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "द्युतरोः पुनः स्वस्थाने नयनम्-०७६",
      "combined_translation": "7-7"
    },
    {
      "verse": 8,
      "sanskrit": "प्रतिगृह्य तु तत्सर्वं नारदो मुनिसत्तमः। स सम्प्रहृष्ठो भुक्त्वाथ भूयः केशवमब्रवीत्॥८॥",
      "english": null,
      "bhavadeepa": "काञ्चनस्येति विशेष्यं षष्ठ्यन्तानां मणीनां रत्नानां च प्रभा यस्मिंस्तस्य॥७॥",
      "chapter": 131,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "द्युतरोः पुनः स्वस्थाने नयनम्-०७६",
      "combined_translation": "8-8"
    },
    {
      "verse": 9,
      "sanskrit": "भोः केशव मदीयस्त्वमद्भिर्दत्तोऽसि सत्यया। स त्वं मामनुगच्छस्व कुरु यद्यद्ब्रवीम्यहम्॥९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 131,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "द्युतरोः पुनः स्वस्थाने नयनम्-०७६",
      "combined_translation": "9-9"
    },
    {
      "verse": 10,
      "sanskrit": "प्रथमः पक्ष इत्येवमब्रवीन्मधुसूदनः। व्रजन्तमनुवव्राज नारदं च जनार्दनः॥१०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 131,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "द्युतरोः पुनः स्वस्थाने नयनम्-०७६",
      "combined_translation": "10-10"
    },
    {
      "verse": 11,
      "sanskrit": "परिहासं बहुविधं कृत्वा मुनिवरस्तदा। तिष्ठस्व गच्छामीत्युक्त्वा परिहासविचक्षणः॥११॥",
      "english": null,
      "bhavadeepa": "प्रथमो मुख्यः पक्षो यद्दासेन स्वामिकार्यं कर्तव्यमित्यर्थः॥१०॥",
      "chapter": 131,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "द्युतरोः पुनः स्वस्थाने नयनम्-०७६",
      "combined_translation": "11-11"
    },
    {
      "verse": 12,
      "sanskrit": "अपनीय ततः कण्ठात्पुष्पदामैनमब्रवीत्। कपिलां गां सवत्सां भो निष्क्रयार्थं प्रयच्छ मे॥१२॥",
      "english": null,
      "bhavadeepa": "परिहासं पादुकानयनाद्याज्ञापनैः॥११॥",
      "chapter": 131,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "द्युतरोः पुनः स्वस्थाने नयनम्-०७६",
      "combined_translation": "12-12"
    },
    {
      "verse": 13,
      "sanskrit": "कृष्णाजिनं तिलैः पूर्णं प्रयच्छ च सकाञ्चनम्। एषोऽत्र निष्क्रयः कृष्ण विहितो वृषकेतुना॥१३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 131,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "द्युतरोः पुनः स्वस्थाने नयनम्-०७६",
      "combined_translation": "13-13"
    },
    {
      "verse": 14,
      "sanskrit": "तथेत्युक्त्वा हृषीकेशस्तथा चक्रे जनाधिप। स उवाच मुनिश्रेष्ठं हसित्वा मधुसूदनः॥१४॥",
      "english": null,
      "bhavadeepa": "वृषकेतुना रुद्रेण॥१३॥",
      "chapter": 131,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "द्युतरोः पुनः स्वस्थाने नयनम्-०७६",
      "combined_translation": "14-14"
    },
    {
      "verse": 15,
      "sanskrit": "वरं वरय धर्मज्ञ यस्ते नारद काङ्क्षितः। तत्ते दातास्मि धर्मज्ञ परा प्रीतिर्हि मे त्वयि॥१५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 131,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "द्युतरोः पुनः स्वस्थाने नयनम्-०७६",
      "combined_translation": "15-15"
    },
    {
      "verse": 16,
      "sanskrit": "नारद उवाच।\n              नित्यमेवास्तु मे प्रीतो भवान्विष्णो सनातन। त्वत्प्रसादात्तु सालोक्यं व्रजेयं ते महामते॥१६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 131,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "द्युतरोः पुनः स्वस्थाने नयनम्-०७६",
      "combined_translation": "16-16"
    },
    {
      "verse": 17,
      "sanskrit": "अयोनिजो भवेयं ते नारायण सतां गते। भवेयं ब्राह्मणश्चैव पुनर्जात्यन्तरेष्वपि॥१७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 131,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "द्युतरोः पुनः स्वस्थाने नयनम्-०७६",
      "combined_translation": "17-17"
    },
    {
      "verse": 18,
      "sanskrit": "एवमस्त्विति तं देवो विष्णुः प्रोवाच भारत। तुतोष च ततो धीमान्नारदो मुनिसत्तमः॥१८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 131,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "द्युतरोः पुनः स्वस्थाने नयनम्-०७६",
      "combined_translation": "18-18"
    },
    {
      "verse": 19,
      "sanskrit": "षोडशस्त्रीसहस्राणि विष्णोरतुलतेजसः। निमन्त्रितानि कौरव्य सत्यया हरिकान्तया॥१९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 131,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "द्युतरोः पुनः स्वस्थाने नयनम्-०७६",
      "combined_translation": "19-19"
    },
    {
      "verse": 20,
      "sanskrit": "तासां ददौ सन्नियोगमेकैकं हरिवल्लभा। शच्या यो वासुदेवस्य पुरा दत्तो नराधिप॥२०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 131,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "द्युतरोः पुनः स्वस्थाने नयनम्-०७६",
      "combined_translation": "20-20"
    },
    {
      "verse": 21,
      "sanskrit": "पारिजातो वसंस्तत्र ततः प्रववृते तदा। आज्ञया वासुदेवस्य नारदेन महात्मना॥२१॥",
      "english": null,
      "bhavadeepa": "सन्नियोगं दिव्यवस्त्राभरणादिकम् इन्द्राणीप्रेषितं विभज्य ददौ॥२०॥",
      "chapter": 131,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "द्युतरोः पुनः स्वस्थाने नयनम्-०७६",
      "combined_translation": "21-21"
    },
    {
      "verse": 22,
      "sanskrit": "निमन्त्रिता गणाः सर्वे केशवेन महात्मना। विभूतिं पारिजातस्य ददृशुः कुरुनन्दन॥२२॥",
      "english": null,
      "bhavadeepa": "प्रववृते स गुणान्ख्यापयामास॥२१॥",
      "chapter": 131,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "द्युतरोः पुनः स्वस्थाने नयनम्-०७६",
      "combined_translation": "22-22"
    },
    {
      "verse": 23,
      "sanskrit": "पाण्डवांश्चानयामास सहैव पृथया हरिः। द्रौपद्या च महातेजास्तथैव च सुभद्रया॥२३॥",
      "english": null,
      "bhavadeepa": "गणाः सुहृत्सम्बन्धिसमूहाः॥२२॥",
      "chapter": 131,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "द्युतरोः पुनः स्वस्थाने नयनम्-०७६",
      "combined_translation": "23-23"
    },
    {
      "verse": 24,
      "sanskrit": "श्रुतश्रवां च ससुतां भीष्मकं ससुतं तदा। अन्यानपि च कौरव्य मित्रसम्बन्धिबान्धवान्॥२४॥",
      "english": null,
      "bhavadeepa": "तानेवाह- पाण्डवानिति॥२३॥",
      "chapter": 131,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "द्युतरोः पुनः स्वस्थाने नयनम्-०७६",
      "combined_translation": "24-24"
    },
    {
      "verse": 25,
      "sanskrit": "रेमे च सह पार्थेन फाल्गुनेन जनार्दनः। सान्तःपुरो महातेजाः परमर्द्ध्यावसन्नृप॥२५॥",
      "english": null,
      "bhavadeepa": "श्रुतश्रवा पितृष्वसा शिशुपालमाता॥२४॥",
      "chapter": 131,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "द्युतरोः पुनः स्वस्थाने नयनम्-०७६",
      "combined_translation": "25-25"
    },
    {
      "verse": 26,
      "sanskrit": "संवत्सरे ततो याते केशिहामरसत्तमः। पारिजातं पुनः स्वर्गमानयत्सर्वभावनः॥२६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 131,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "द्युतरोः पुनः स्वस्थाने नयनम्-०७६",
      "combined_translation": "26-26"
    },
    {
      "verse": 27,
      "sanskrit": "तत्रादितिं कश्यपं च दृष्ट्वा स्वजननीं प्रभुः। शक्रेण सहितो धीमानप्रमेयपराक्रमः॥२७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 131,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "द्युतरोः पुनः स्वस्थाने नयनम्-०७६",
      "combined_translation": "27-27"
    },
    {
      "verse": 28,
      "sanskrit": "तमुवाचादितिर्माता प्रणतं मधुसूदनम्। सौभ्रात्रमस्तु वामेवं नित्यं चामरसत्तम॥२८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 131,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "द्युतरोः पुनः स्वस्थाने नयनम्-०७६",
      "combined_translation": "28-28"
    },
    {
      "verse": 29,
      "sanskrit": "मनोरथं मम त्वं च पूरयस्व जनार्दन। तथेत्येवाब्रवीत्कृष्णस्ततो मातरमात्मवान्॥२९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 131,
