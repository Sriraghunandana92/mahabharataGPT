  "chapter": 168,
  "verse_count": 32,
  "verses": [
    {
      "verse": 1,
      "sanskrit": "अर्जुन उवाच।\n              ततः पर्वतजालानि सरितश्च वनानि च। अपश्यं समतिक्रम्य सागरं वरुणालयम्॥१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 168,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "मृतब्राह्मणपुत्रस्य पुनः प्रत्यानयनम्-११३"
    },
    {
      "verse": 2,
      "sanskrit": "ततोऽर्घमुदधिः साक्षादुपनीय जनार्दनम्। स प्राञ्जलिः समुत्थाय किं करोमीति चाब्रवीत्॥२॥",
      "english": null,
      "bhavadeepa": "तत इति॥१॥",
      "chapter": 168,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "मृतब्राह्मणपुत्रस्य पुनः प्रत्यानयनम्-११३",
      "combined_translation": "2-2"
    },
    {
      "verse": 3,
      "sanskrit": "प्रतिगृह्य स तां पूजां तमुवाच जनार्दनः। रथपन्थानमिच्छामि त्वया दत्तं नदीपते॥३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 168,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "मृतब्राह्मणपुत्रस्य पुनः प्रत्यानयनम्-११३",
      "combined_translation": "3-22"
    },
    {
      "verse": 4,
      "sanskrit": "अथाब्रवीत्समुद्रस्तु प्राञ्जलिर्गरुडध्वजम्। प्रसीद भगवन्नैवमन्योऽप्येवं गमिष्यति॥४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 168,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "मृतब्राह्मणपुत्रस्य पुनः प्रत्यानयनम्-११३",
      "combined_translation": "4-4"
    },
    {
      "verse": 5,
      "sanskrit": "त्वयैव स्थापितं पूर्वमगाधोऽस्मि जनार्दन। त्वया प्रवर्तते मार्गे यास्यामि गमनायताम्॥५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 168,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "मृतब्राह्मणपुत्रस्य पुनः प्रत्यानयनम्-११३",
      "combined_translation": "5-5"
    },
    {
      "verse": 6,
      "sanskrit": "अन्येऽप्येवं गमिष्यन्ति राजानो दर्पमोहिताः। एवं सञ्चिन्त्य गोविन्द यत्क्षमं तत्समाचर॥६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 168,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "मृतब्राह्मणपुत्रस्य पुनः प्रत्यानयनम्-११३",
      "combined_translation": "6-6"
    },
    {
      "verse": 7,
      "sanskrit": "वासुदेव उवाच।\n              ब्राह्मणर्थं मदर्थं च कुरु सागर मद्वचः। मदृते न पुमान्कश्चिदन्यस्त्वां धर्षयिष्यति॥७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 168,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "मृतब्राह्मणपुत्रस्य पुनः प्रत्यानयनम्-११३",
      "combined_translation": "7-7"
    },
    {
      "verse": 8,
      "sanskrit": "अथाब्रवीत्समुद्रस्तु पुनरेव जनार्दनम्। अभिशापभयाद्भीतो बाडमेवं भविष्यति॥८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 168,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "मृतब्राह्मणपुत्रस्य पुनः प्रत्यानयनम्-११३",
      "combined_translation": "8-8"
    },
    {
      "verse": 9,
      "sanskrit": "शोषयाम्येष मार्गं ते येन त्वं कृष्ण यास्यसि। रथेन सह सूतेन सध्वजेन तु केशव॥९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 168,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "मृतब्राह्मणपुत्रस्य पुनः प्रत्यानयनम्-११३",
      "combined_translation": "9-9"
    },
    {
      "verse": 10,
      "sanskrit": "वासुदेव उवाच।\n              मया दत्तो वरः पूर्वं न शोषं यास्यसीति ह। मानुषास्ते न जानीयुर्विविधान्रत्नसञ्चयान्॥१०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 168,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "मृतब्राह्मणपुत्रस्य पुनः प्रत्यानयनम्-११३",
      "combined_translation": "10-10"
    },
    {
      "verse": 11,
      "sanskrit": "जलं स्तम्भय साधो त्वं ततो यास्याम्यहं रथी। न च कश्चित्प्रमाणं ते रत्नानां वेत्स्यते नरः॥११॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 168,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "मृतब्राह्मणपुत्रस्य पुनः प्रत्यानयनम्-११३",
      "combined_translation": "11-11"
    },
    {
      "verse": 12,
      "sanskrit": "सागरेण तथेत्युक्ते प्रस्थिताः स्म जलेन वै। स्तम्भितेन पथा भूमौ मणिवर्णेन भास्वता॥१२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 168,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "मृतब्राह्मणपुत्रस्य पुनः प्रत्यानयनम्-११३",
      "combined_translation": "12-12"
    },
    {
      "verse": 13,
      "sanskrit": "ततोऽर्णवं समुत्तीर्य कुरूनप्युत्तरान्वयम्। क्षणेन समतिक्रान्ता गन्धमादनमेव च॥१३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 168,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "मृतब्राह्मणपुत्रस्य पुनः प्रत्यानयनम्-११३",
      "combined_translation": "13-13"
    },
    {
      "verse": 14,
      "sanskrit": "ततस्तु पर्वताः सप्त केशवं समुपस्थिताः। जयन्तो वैजयन्तश्च नीलो रजतपर्वतः॥१४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 168,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "मृतब्राह्मणपुत्रस्य पुनः प्रत्यानयनम्-११३",
      "combined_translation": "14-14"
    },
    {
      "verse": 15,
      "sanskrit": "महामेरुः सकैलास इन्द्रकूटश्च नामतः। बिभ्राणा वर्णरूपाणि विविधान्यद्भुतानि च॥१५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 168,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "मृतब्राह्मणपुत्रस्य पुनः प्रत्यानयनम्-११३",
      "combined_translation": "15-15"
    },
    {
      "verse": 16,
      "sanskrit": "उपस्थाय च गोविन्दं किं कुर्मेत्यब्रुवंस्तदा। तांश्चैव प्रतिजग्राह विधिवन्मधुसूदनः॥१६॥",
      "english": null,
      "bhavadeepa": "वर्णरूपाणि वर्षवन्ति रूपाणि॥१५॥",
      "chapter": 168,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "मृतब्राह्मणपुत्रस्य पुनः प्रत्यानयनम्-११३",
      "combined_translation": "16-16"
    },
    {
      "verse": 17,
      "sanskrit": "तानुवाच हृषीकेशः प्रणामावनतान्स्थितान्। विवरं गच्छतो मेऽद्य रथमार्गः प्रदीयताम्॥१७॥",
      "english": null,
      "bhavadeepa": "प्रतिजग्राह कुशलप्रश्नादिना मानयामास॥१६॥",
      "chapter": 168,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "मृतब्राह्मणपुत्रस्य पुनः प्रत्यानयनम्-११३",
      "combined_translation": "17-17"
    },
    {
      "verse": 18,
      "sanskrit": "ते कृष्णस्य वचः श्रुत्वा प्रतिगृह्य च पर्वताः। प्रददुः कामतो मार्गं गच्छतो भरतर्षभ॥१८॥",
      "english": null,
      "bhavadeepa": "विवरं गूढस्थानम्॥१७॥",
      "chapter": 168,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "मृतब्राह्मणपुत्रस्य पुनः प्रत्यानयनम्-११३",
      "combined_translation": "18-18"
    },
    {
      "verse": 19,
      "sanskrit": "तत्रैवान्तर्हिताः सर्वे तदाश्चर्यतरं मम। असक्तं च रथो याति मेघजालेष्विवांशुमान्॥१९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 168,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "मृतब्राह्मणपुत्रस्य पुनः प्रत्यानयनम्-११३",
      "combined_translation": "19-19"
    },
    {
      "verse": 20,
      "sanskrit": "सप्तद्वीपान्ससिन्धूंश्च सप्त सप्त गिरीनथ। लोकालोकं तथातीत्य विवेश सुमहत्तमः॥२०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 168,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "मृतब्राह्मणपुत्रस्य पुनः प्रत्यानयनम्-११३",
      "combined_translation": "20-20"
    },
    {
      "verse": 21,
      "sanskrit": "ततः कदाचिद्दुःखेन रथमूहुस्तुरङ्गमाः। पङ्कभूतं हि तिमिरं स्पर्शाद्विज्ञायते नृप॥२१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 168,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "मृतब्राह्मणपुत्रस्य पुनः प्रत्यानयनम्-११३",
      "combined_translation": "21-21"
    },
    {
      "verse": 22,
      "sanskrit": "अथ पर्वतभूतं तत्तिमिरं समपद्यत। तदासाद्य महाराज निष्प्रयत्ना हयाः स्थिताः॥२२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 168,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "मृतब्राह्मणपुत्रस्य पुनः प्रत्यानयनम्-११३",
      "combined_translation": "22-22"
    },
    {
      "verse": 23,
      "sanskrit": "ततश्चक्रेण गोविन्दः पाटयित्वा तमस्तदा। आकाशं दर्शयामास रथपन्थानमुत्तमम्॥२३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 168,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "मृतब्राह्मणपुत्रस्य पुनः प्रत्यानयनम्-११३",
      "combined_translation": "23-23"
    },
    {
      "verse": 24,
      "sanskrit": "निष्क्रम्य तमसस्तस्मादाकाशे दर्शिते तदा। भविष्यामीति संज्ञा मे भयं च विगतं मम॥२४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 168,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "मृतब्राह्मणपुत्रस्य पुनः प्रत्यानयनम्-११३",
      "combined_translation": "24-24"
    },
    {
      "verse": 25,
      "sanskrit": "ततस्तेजः प्रज्वलितमपश्यं तत्तदाम्बरे। सर्वलोकं समाविश्य स्थितं पुरुषविग्रहम्॥२५॥",
      "english": null,
      "bhavadeepa": "भविष्यामि जीविष्यामीति संज्ञा ज्ञानमभूत् ततः प्राङ्मृतोऽहमित्येव बुद्धिरासीदिति भावः॥२४॥",
      "chapter": 168,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "मृतब्राह्मणपुत्रस्य पुनः प्रत्यानयनम्-११३",
      "combined_translation": "25-25"
    },
    {
      "verse": 26,
      "sanskrit": "तं प्रविष्टो हृषीकेशो दीप्तं तेजोनिधिं तदा। रथ एव स्थितश्चाहं स च ब्राह्मणसत्तमः॥२६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 168,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "मृतब्राह्मणपुत्रस्य पुनः प्रत्यानयनम्-११३",
      "combined_translation": "26-26"
    },
    {
      "verse": 27,
      "sanskrit": "स मुहूर्तात्ततः कृष्णो निश्चक्राम तदा प्रभुः। चतुरो बालकान्गृह्य ब्राह्मणस्यात्मजांस्तदा॥२७॥",
      "english": null,
      "bhavadeepa": "तं प्रसिद्धम् ईश्वरम्॥२६॥",
      "chapter": 168,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "मृतब्राह्मणपुत्रस्य पुनः प्रत्यानयनम्-११३",
      "combined_translation": "27-27"
    },
    {
      "verse": 28,
      "sanskrit": "प्रददौ ब्राह्मणायाथ पुत्रान्सर्वाञ्जनार्दनः। त्रयः पूर्वं हृता ये च सद्यो जातश्च बालकः॥२८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 168,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "मृतब्राह्मणपुत्रस्य पुनः प्रत्यानयनम्-११३",
      "combined_translation": "28-28"
    },
    {
      "verse": 29,
      "sanskrit": "प्रहृष्टो ब्राह्मणस्तत्र पुत्रान्दृष्ट्वा पुनः प्रभो। अहं च परमप्रीतो विस्मितश्चाभवं तदा॥२९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 168,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
