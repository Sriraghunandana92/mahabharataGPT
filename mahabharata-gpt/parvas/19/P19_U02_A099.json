  "verse_count": 28,
  "verses": [
    {
      "verse": 1,
      "sanskrit": "वैशम्पायन उवाच।\n              एवमालोकयानः स द्वारकां वृषभेक्षणः। अपश्यत्स्वगृहं कृष्णः प्रासादशतशोभितम्॥१॥",
      "english": null,
      "bhavadeepa": "भौमेन विश्वकर्मणा॥७६॥",
      "chapter": 154,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कृष्णस्य द्वारकाप्रवेशः-०९९"
    },
    {
      "verse": 2,
      "sanskrit": "मणिस्तम्भसहस्राणामयुतैर्विवृतं शतैः। तोरणैर्ज्वलनप्रख्यैर्मणिविद्रुमराजतैः॥२॥",
      "english": null,
      "bhavadeepa": "एवमिति॥१॥",
      "chapter": 154,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कृष्णस्य द्वारकाप्रवेशः-०९९",
      "combined_translation": "2-2"
    },
    {
      "verse": 3,
      "sanskrit": "तत्र तत्र प्रभासद्भिश्चित्रकाञ्चनवेदिकैः। प्रासादस्तत्र सुमहान्कृष्णोपस्थानिकोऽभवत्॥३॥",
      "english": null,
      "bhavadeepa": "विवृतं स्पष्टीकृतं स्तम्भप्रभयैव ग्रस्तान्धकारमित्यर्थः॥२॥",
      "chapter": 154,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कृष्णस्य द्वारकाप्रवेशः-०९९",
      "combined_translation": "3-3"
    },
    {
      "verse": 4,
      "sanskrit": "स्फाटिकस्तम्भविवृतो विस्तीर्णः सर्वकाञ्चनः। पद्माकुलजलोपेता रक्तसौगन्धिकोत्पलाः॥४॥",
      "english": null,
      "bhavadeepa": "काञ्चनवेदिकैस्तोरणैः॥३॥",
      "chapter": 154,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कृष्णस्य द्वारकाप्रवेशः-०९९",
      "combined_translation": "4-67"
    },
    {
      "verse": 5,
      "sanskrit": "मणिहेमनिभाश्चित्रा रत्नसोपानभूषिताः। मत्तबर्हिणजुष्टाश्च कोकिलैश्च सदामदैः॥५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 154,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कृष्णस्य द्वारकाप्रवेशः-०९९",
      "combined_translation": "5-73"
    },
    {
      "verse": 6,
      "sanskrit": "बभूवुः परमोपेता वाप्यश्च विकचोत्पलाः। विश्वकर्मकृतः शैलः प्राकारस्तस्य वेश्मनः॥६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 154,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कृष्णस्य द्वारकाप्रवेशः-०९९",
      "combined_translation": "6-6"
    },
    {
      "verse": 7,
      "sanskrit": "व्यक्तकिष्कुशतोत्सेधः परिखापरिवेष्टितः। तद्गृहं वृष्णिसिंहस्य निर्मितं विश्वकर्मणा॥७॥",
      "english": null,
      "bhavadeepa": "परमोपेता अनुज्ञया युक्ताः सङ्कल्पितरूपधारिण्य इत्यर्थः “परमं स्यादनुज्ञायाम्\" इति मेदिनी। शैलः शिलामयः॥६॥",
      "chapter": 154,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कृष्णस्य द्वारकाप्रवेशः-०९९",
      "combined_translation": "7-7"
    },
    {
      "verse": 8,
      "sanskrit": "महेन्द्रसदृशं वेश्म समन्तादर्धयोजनम्। तत्रस्थं पाण्डुरं शौरिर्मूर्ध्नि तिष्ठन्गरुत्मतः॥८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 154,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कृष्णस्य द्वारकाप्रवेशः-०९९",
      "combined_translation": "8-8"
    },
    {
      "verse": 9,
      "sanskrit": "प्रीतः शङ्खमुपाध्मासीद्द्विषतां रोमहर्षणम्। तस्य शङ्खस्य शब्देन सागरश्चुक्षुभे भृशम्। ररास च नभः कृत्स्नं तच्चित्रमभवत्तदा॥९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 154,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कृष्णस्य द्वारकाप्रवेशः-०९९",
      "combined_translation": "9-9"
    },
    {
      "verse": 10,
      "sanskrit": "पाञ्चजन्यस्य निर्घोषं संश्रुत्य कुकुरान्धकाः। विशोकाः समपद्यन्त गरुडस्य च दर्शनात्॥१०॥",
      "english": null,
      "bhavadeepa": "ररास प्रतिशब्दं चकार॥९॥",
      "chapter": 154,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कृष्णस्य द्वारकाप्रवेशः-०९९",
      "combined_translation": "10-10"
    },
    {
      "verse": 11,
      "sanskrit": "शङ्खचक्रगदापाणिं गरुडस्योपरि स्थितम्। दृष्ट्वा जहृषिरे पौरा भास्करोपमतेजसम्॥११॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 154,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कृष्णस्य द्वारकाप्रवेशः-०९९",
      "combined_translation": "11-11"
    },
    {
      "verse": 12,
      "sanskrit": "ततस्तूर्यप्रणादश्च भेरीणां च महास्वनाः। जज्ञिरे सिंहनादाश्च सर्वेषां पुरवासिनाम्॥१२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 154,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कृष्णस्य द्वारकाप्रवेशः-०९९",
      "combined_translation": "12-12"
    },
    {
      "verse": 13,
      "sanskrit": "ततस्ते सर्वदाशार्हाः सर्वे च कुकुरान्धकाः। प्रीयमाणाः समाजग्मुरालोक्य मधुसूदनम्॥१३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 154,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कृष्णस्य द्वारकाप्रवेशः-०९९",
      "combined_translation": "13-13"
    },
    {
      "verse": 14,
      "sanskrit": "वासुदेवं पुरस्कृत्य शङ्खतूर्यरवैः सह। उग्रसेनो ययौ राजा वसुदेवनिवेशनम्॥१४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 154,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कृष्णस्य द्वारकाप्रवेशः-०९९",
      "combined_translation": "14-14"
    },
    {
      "verse": 15,
      "sanskrit": "आनन्दिनी पर्यचरत्स्वेषु वेश्मसु देवकी। रोहिणी च यशोदा च आहुकस्य च याः स्त्रियः॥१५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 154,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कृष्णस्य द्वारकाप्रवेशः-०९९",
      "combined_translation": "15-15"
    },
    {
      "verse": 16,
      "sanskrit": "ततः कृष्णः सुपर्णेन स्वं निवेशनमभ्यगात्। चचार च यथोद्देशमीश्वरानुचरो हरिः॥१६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 154,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कृष्णस्य द्वारकाप्रवेशः-०९९",
      "english_ref": 1,
      "combined_translation": "1-16"
    },
    {
      "verse": 17,
      "sanskrit": "अवतीर्य गृहद्वारि कृष्णस्तु यदुनन्दनः। यथार्हं पूजयामास यादवान्यादवर्षभः॥१७॥",
      "english": null,
      "bhavadeepa": "ईश्वराः इन्द्रादयः अनुचराः यस्य ईश्वरानुचरः॥१६॥",
      "chapter": 154,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कृष्णस्य द्वारकाप्रवेशः-०९९"
    },
    {
      "verse": 18,
      "sanskrit": "रामाहुकगदाक्रूरप्रद्युम्नादिभिरर्चितः। प्रविवेश गृहं शौरिरादाय मणिपर्वतम्॥१८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 154,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कृष्णस्य द्वारकाप्रवेशः-०९९"
    },
    {
      "verse": 19,
      "sanskrit": "तं च शक्रस्य दयितं पारिजातं महाद्रुमम्। प्रवेशयामास गृहं प्रद्युम्नो रुक्मिणीसुतः॥१९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 154,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कृष्णस्य द्वारकाप्रवेशः-०९९"
    },
    {
      "verse": 20,
      "sanskrit": "तेऽन्योन्यं ददृशुर्वीरा देहबन्धानमानुषान्। पारिजातप्रभावेण ततो मुमुदिरे जनाः॥२०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 154,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कृष्णस्य द्वारकाप्रवेशः-०९९"
    },
    {
      "verse": 21,
      "sanskrit": "तैः स्तूयमानो गोविन्दः प्रहृष्टैर्यादवर्षभैः। प्रविवेश गृहं श्रीमान्विहितं विश्वकर्मणा॥२१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 154,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कृष्णस्य द्वारकाप्रवेशः-०९९"
    },
    {
      "verse": 22,
      "sanskrit": "ततोऽन्तःपुरमध्ये तं सशृङ्गमणिपर्वतम्। न्यवेशयदमेयात्मा वृष्णिभिः सहितोऽच्युतः॥२२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 154,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कृष्णस्य द्वारकाप्रवेशः-०९९"
    },
    {
      "verse": 23,
      "sanskrit": "तं च दिव्यं द्रुमश्रेष्ठं पारिजातममित्रजित्। अर्च्यमर्चितमव्यग्रमिष्टे देशे न्यवेशयत्॥२३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 154,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कृष्णस्य द्वारकाप्रवेशः-०९९"
    },
    {
      "verse": 24,
      "sanskrit": "अनुज्ञाप्य ततो ज्ञातीन्केशवः परवीरहा। ताः स्त्रियः पूजयामास संहृता नरकेण याः॥२४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 154,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कृष्णस्य द्वारकाप्रवेशः-०९९"
    },
    {
      "verse": 25,
      "sanskrit": "वस्त्रैराभरणैर्दिव्यैर्दासीभिर्धनसञ्चयैः। हारैश्चन्द्रांशुसङ्काशैर्मणिभिश्च महाप्रभैः॥२५॥",
      "english": null,
      "bhavadeepa": "संहृताः दूषणं विना आनीताः॥२४॥",
      "chapter": 154,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कृष्णस्य द्वारकाप्रवेशः-०९९"
    },
    {
      "verse": 26,
      "sanskrit": "पूर्वमभ्यर्चिताश्चैव वसुदेवेन ताः स्त्रियः। देवक्या सह रोहिण्या रेवत्या चाहुकेन च॥२६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 154,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कृष्णस्य द्वारकाप्रवेशः-०९९"
    },
    {
      "verse": 27,
      "sanskrit": "सत्यभामोत्तमा स्त्रीणां सौभाग्येनाभवत्तदा। कुटुम्बस्येश्वरी त्वासीद्रुक्मिणी भीष्मकात्मजा॥२७॥",
      "english": null,
      "bhavadeepa": null,
