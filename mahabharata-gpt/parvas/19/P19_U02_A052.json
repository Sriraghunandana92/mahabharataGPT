{
  "adhyaya_id": "P19_U02_A052",
  "book": 19,
  "parva_name": "हरिवंशः",
  "upaparva_name": "विष्णुपर्व",
  "adhyaya_name": "कालयवनं प्रति शालवगमनम्-०५२",
  "chapter": 107,
  "verse_count": 51,
  "verses": [
    {
      "verse": 1,
      "sanskrit": "वैशम्पायन उवाच।\n              ततः प्रयाते वसुदेवपुत्रे नराधिपा भूषणभूषिताङ्गाः। सभां समाजग्मुर्सुरेन्द्रकल्पाः प्रबोधनार्थं गमनोत्सवास्ते॥१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 107,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कालयवनं प्रति शालवगमनम्-०५२",
      "combined_translation": "1-72"
    },
    {
      "verse": 2,
      "sanskrit": "सभागतान्सोमरविप्रकाशान् सुखोपविष्टान्रुचिरासनेषु। समीक्ष्य राजा सुनयार्थवादी जगाद वाक्यं नरराजसिंहः॥२॥",
      "english": null,
      "bhavadeepa": "द्विपञ्चाशत्तमेऽध्याये मागधादिप्रचोदितः। शाल्वोऽगाद्यवनेन्द्रं तं कृष्णमानापनुत्तये॥१॥ ततः सभां भीष्मकस्य समाजग्मुर्विसर्गलोप आर्षः॥१॥",
      "chapter": 107,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कालयवनं प्रति शालवगमनम्-०५२",
      "combined_translation": "2-2"
    },
    {
      "verse": 3,
      "sanskrit": "स्वयंवरकृतं दोषं विदित्वा वो नराधिपाः। क्षन्तव्यो मम वृद्धस्य दुर्दग्धस्य फलोदयम्॥३॥",
      "english": null,
      "bhavadeepa": "राजा भीष्मकः॥२॥",
      "chapter": 107,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कालयवनं प्रति शालवगमनम्-०५२",
      "combined_translation": "3-3"
    },
    {
      "verse": 4,
      "sanskrit": "वैशम्पायन उवाच।\n              एवमाभाष्य तान्सर्वान्सत्कृत्य च यथाविधि। ततो विसर्जयामास नृपांस्तान्मध्यदेशजान्॥४॥",
      "english": null,
      "bhavadeepa": "स्वयंवरे कृष्णविरोधाख्यो दोषो विश्वक्षयकरो भविष्यतीति मत्वा स्वयंवरार्थमाहूतान् नृपान् सान्त्वयति। स्वयमिति शेषः॥३॥",
      "chapter": 107,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कालयवनं प्रति शालवगमनम्-०५२",
      "combined_translation": "4-4"
    },
    {
      "verse": 5,
      "sanskrit": "पूर्वपश्चिमजांश्चैव उत्तरापथिकानपि। तेऽपि सर्वे महेष्वासाः प्रहृष्टमनसो नराः॥५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 107,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कालयवनं प्रति शालवगमनम्-०५२",
      "combined_translation": "5-5"
    },
    {
      "verse": 6,
      "sanskrit": "यथार्हेण च सम्पूज्य जग्मुस्ते नरपुङ्गवाः। जरासन्धः सुनीथश्च दन्तवक्त्रश्च वीर्यवान्॥६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 107,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कालयवनं प्रति शालवगमनम्-०५२",
      "combined_translation": "6-6"
    },
    {
      "verse": 7,
      "sanskrit": "शाल्वः सौभपतिश्चैव महाकूर्मश्च पार्थिवः। क्रथकैशिकमुख्याश्च नृपाः प्रवरवंशजाः॥७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 107,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कालयवनं प्रति शालवगमनम्-०५२",
      "combined_translation": "7-7"
    },
    {
      "verse": 8,
      "sanskrit": "वैणुदारिश्च राजर्षिः काश्मीराधिपतिस्तथा। एते चान्ये च बहवो दक्षिणापथिका नृपाः॥८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 107,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कालयवनं प्रति शालवगमनम्-०५२",
      "combined_translation": "8-8"
    },
    {
      "verse": 9,
      "sanskrit": "श्रोतुकामा रहो वाक्यं स्थिता वै भीष्मकान्तिके। तान्वै समीक्ष्य राजेन्द्रः स राजा भीष्मको बली॥९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 107,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कालयवनं प्रति शालवगमनम्-०५२",
      "combined_translation": "9-9"
    },
    {
      "verse": 10,
      "sanskrit": "स्नेहपूर्णेन मनसा स्थितांस्तानवनीश्वरान्। त्रिवर्गसहितं श्लक्ष्णं षड्गुणालङ्कृतं शुभम्॥१०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 107,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कालयवनं प्रति शालवगमनम्-०५२",
      "combined_translation": "10-10"
    },
    {
      "verse": 11,
      "sanskrit": "उवाच नयसम्पन्नं स्निग्धगम्भीरया गिरा।\n              भीष्मक उवाच।\n              भवतामवनीशानां समालोक्य नयान्वितम्॥११॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 107,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कालयवनं प्रति शालवगमनम्-०५२",
      "combined_translation": "11-11"
    },
    {
      "verse": 12,
      "sanskrit": "वचनं व्याहृतं श्रुत्वा कृतवाङ्कार्यमीदृशम्। क्षन्तव्यं भवतां सद्भिर्वयं नित्यापराधिनः॥१२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 107,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कालयवनं प्रति शालवगमनम्-०५२",
      "combined_translation": "12-12"
    },
    {
      "verse": 13,
      "sanskrit": "वैशम्पायन उवाच।\n              एवमुक्त्वा तु राजा स भीष्मको नयकोविदः। उवाच सुतमुद्दिश्य वचनं राजसंसदि॥१३॥",
      "english": "samhrAda's sons are सुन्द and निशुन्द; anuhrAda's sons are आयु, शिबि, and काल; prahrAda's son is विरोचन, and virochana's son is बलि...",
      "bhavadeepa": "व्याहृतं कृष्णस्तुतिरूपं कृतः कारितः कृतवान्वा॥१२॥",
      "chapter": 107,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कालयवनं प्रति शालवगमनम्-०५२",
      "combined_translation": "13-59"
    },
    {
      "verse": 14,
      "sanskrit": "भीष्मक उवाच।\n              पुत्रस्य चेष्टामालोक्य त्रासाकुलितलोचनः। मन्ये बालानिमाँल्लोकान्स एव पुरुषः परः॥१४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 107,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कालयवनं प्रति शालवगमनम्-०५२",
      "combined_translation": "14-14"
    },
    {
      "verse": 15,
      "sanskrit": "कीर्तिः कीर्तिमतां श्रेष्ठो यशश्च यशभाग्बली। स्थापिता भुवि मर्त्येऽस्मिन्स्वबाहुबलमूर्जितम्॥१५॥",
      "english": null,
      "bhavadeepa": "इमानिति पुत्रं प्रदर्श्याह। एषः कृष्णः॥१४॥",
      "chapter": 107,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कालयवनं प्रति शालवगमनम्-०५२",
      "combined_translation": "15-15"
    },
    {
      "verse": 16,
      "sanskrit": "धन्या खलु महाभागा देवकी योषितां वरा। पुत्रं त्रिभुवनश्रेष्ठं कृत्वा गर्भेण केशवम्॥१६॥",
      "english": null,
      "bhavadeepa": "यशभाग्यशोभोगी स्थापिता स्थापयिष्यति॥१५॥",
