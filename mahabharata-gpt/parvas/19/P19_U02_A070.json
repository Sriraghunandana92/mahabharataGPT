{
  "adhyaya_id": "P19_U02_A070",
  "book": 19,
  "parva_name": "हरिवंशः",
  "upaparva_name": "विष्णुपर्व",
  "adhyaya_name": "पारिजातं न दास्यामीतीन्द्रभाषणम्-०७०",
  "chapter": 125,
  "verse_count": 50,
  "verses": [
    {
      "verse": 1,
      "sanskrit": "वैशम्पायन उवाच।\n              देवराजवचः श्रुत्वा नारदः कुरुनन्दन। प्रोवाच वाक्यं वाक्यज्ञो धर्मात्मा धर्मवित्तमः॥१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 125,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पारिजातं न दास्यामीतीन्द्रभाषणम्-०७०"
    },
    {
      "verse": 2,
      "sanskrit": "अवश्यमेव वक्तव्यं हितं बलनिषूदन। मया तव महाबाहो बहुमानोऽस्ति मे त्वयि॥२॥",
      "english": null,
      "bhavadeepa": "अथास्मिन्सप्ततितमे प्रतिज्ञां नारदेरिताम्। कृष्णस्य बलमिच्छ्रुत्वा न दास्यामीत्यवावदीत्॥ देवराजेति॥१॥",
      "chapter": 125,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पारिजातं न दास्यामीतीन्द्रभाषणम्-०७०",
      "combined_translation": "2-2"
    },
    {
      "verse": 3,
      "sanskrit": "उक्तो मया वासुदेवो जानता भवतो मतम्। न दत्तः पारिजातोऽयं हरस्यापि त्वया पुरा॥३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 125,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पारिजातं न दास्यामीतीन्द्रभाषणम्-०७०",
      "combined_translation": "3-3"
    },
    {
      "verse": 4,
      "sanskrit": "हेतवश्च मया तस्य दर्शितास्ते समासतः। न चावगतवान्देवः सत्यमेतद्ब्रवीमि ते॥४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 125,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पारिजातं न दास्यामीतीन्द्रभाषणम्-०७०",
      "combined_translation": "4-12"
    },
    {
      "verse": 5,
      "sanskrit": "उपेन्द्रोऽहं महेन्द्रेण लालनीयः सदेति माम्। उवाच पुण्डरीकाक्षो दत्तमुत्तरमेव च॥५॥",
      "english": null,
      "bhavadeepa": "हेतवः महीतलं पारिजातमित्यादिना पूर्वोक्ताः। न चावगतवान् नाङ्गीकृतवान्॥४॥",
      "chapter": 125,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पारिजातं न दास्यामीतीन्द्रभाषणम्-०७०",
      "combined_translation": "5-5"
    },
    {
      "verse": 6,
      "sanskrit": "पुनः पुनर्मया वास्य हेतवो देव दर्शिताः। ततो न बुद्धिर्व्यावृत्ता वृत्रनाशाय तस्य वै॥६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 125,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पारिजातं न दास्यामीतीन्द्रभाषणम्-०७०",
      "combined_translation": "6-6"
    },
    {
      "verse": 7,
      "sanskrit": "अपि चाप्युक्तवान्देवो वाक्यान्ते मधुसूदनः। प्रत्याह पुरुषश्रेष्ठाः सरोषमिव वासव॥७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 125,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पारिजातं न दास्यामीतीन्द्रभाषणम्-०७०",
      "combined_translation": "7-7"
    },
    {
      "verse": 8,
      "sanskrit": "न देवगन्धर्वगणा न राक्षसा न चासुरा नैव च पन्नगोत्तमाः। मम प्रतिज्ञामपहन्तुमुद्यता मुने समर्थाः खलु भद्रमस्तु ते॥८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 125,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पारिजातं न दास्यामीतीन्द्रभाषणम्-०७०",
      "combined_translation": "8-38"
    },
    {
      "verse": 9,
      "sanskrit": "स पारिजातं यदि न प्रदास्यति प्रवाच्यमानो भवता पुरन्दरः। ततः शचीव्यामृदितानुलेपने गदां विमोक्ष्यामि पुरन्दरोरसि॥९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 125,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पारिजातं न दास्यामीतीन्द्रभाषणम्-०७०",
      "combined_translation": "9-9"
    },
    {
      "verse": 10,
      "sanskrit": "उपेन्द्रस्य महेन्द्रायं भ्रातुस्ते निश्चयः परः। यदत्र मन्यसे न्याय्यं सम्प्रधार्य कुरुष्व तत्॥१०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 125,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पारिजातं न दास्यामीतीन्द्रभाषणम्-०७०",
      "combined_translation": "10-10"
    },
    {
      "verse": 11,
      "sanskrit": "तत्त्वं हितं च देवेश श्रूयतां वदतो मम। नयनं पारिजातस्य द्वारकां मम रोचते॥११॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 125,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पारिजातं न दास्यामीतीन्द्रभाषणम्-०७०",
      "combined_translation": "11-11"
    },
    {
      "verse": 12,
      "sanskrit": "नारदेनैवमुक्तस्तु सुव्यक्तं बलदेहभित्। रोषाविष्टः सहस्राक्षोऽब्रवीदेतन्नराधिप॥१२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 125,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पारिजातं न दास्यामीतीन्द्रभाषणम्-०७०",
      "combined_translation": "12-12"
    },
    {
      "verse": 13,
      "sanskrit": "अनागसि मयि ज्येष्ठे सोदरं यदि केशवः। एवं प्रवृत्तः किं शक्यं कर्तुमद्य तपोधन॥१३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 125,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पारिजातं न दास्यामीतीन्द्रभाषणम्-०७०",
      "combined_translation": "13-13"
    },
    {
      "verse": 14,
      "sanskrit": "बहूनि प्रतिलोमानि पुरा स कृतवान्मयि। कृष्णो नारद सोढानि भ्रातेति स्म मया सदा॥१४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 125,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पारिजातं न दास्यामीतीन्द्रभाषणम्-०७०",
      "combined_translation": "14-14"
    },
    {
      "verse": 15,
      "sanskrit": "खाण्दवे चार्जुनरथं पुरा वाहयता सता। मदीया वारिता मेघाः शमयन्तोऽग्निमुद्धतम्॥१५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 125,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पारिजातं न दास्यामीतीन्द्रभाषणम्-०७०",
      "combined_translation": "15-15"
    },
    {
      "verse": 16,
      "sanskrit": "गोवर्धनं धारयता विप्रियं च कृतं मम। तथा वृत्रवधे प्राप्ते साहाय्यार्थं वृतो मया॥१६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 125,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पारिजातं न दास्यामीतीन्द्रभाषणम्-०७०",
      "combined_translation": "16-16"
    },
    {
      "verse": 17,
      "sanskrit": "समोऽहमिति सर्वेषां भूतानामिति चोक्तवान्। स्वबाहुबलमाश्रित्य वृत्रश्च निहतो मया॥१७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 125,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पारिजातं न दास्यामीतीन्द्रभाषणम्-०७०",
      "combined_translation": "17-17"
    },
    {
      "verse": 18,
      "sanskrit": "देवासुरेषु प्राप्तेषु सङ्ग्रामेषु च नारद। युद्ध्यत्यात्मेच्छया कृष्णो मुने सुविदितं तव॥१८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 125,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पारिजातं न दास्यामीतीन्द्रभाषणम्-०७०",
      "combined_translation": "18-18"
    },
    {
      "verse": 19,
      "sanskrit": "बहुनात्र किमुक्तेन तस्माद्दिष्ट्या प्रवर्तताम्। ज्ञातिभेदो न नः कार्यः साक्षी त्वं मम नारद॥१९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 125,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पारिजातं न दास्यामीतीन्द्रभाषणम्-०७०",
      "combined_translation": "19-19"
    },
    {
      "verse": 20,
      "sanskrit": "ममोरसि गदां मोक्तुमुद्यतो यदि केशवः। अनुशब्द्याथ पौलोमीं गुणः क इह दृश्यते॥२०॥",
      "english": null,
      "bhavadeepa": "ज्ञातिभेदः भ्रातृकलहः नोऽस्माभिः॥१९॥",
      "chapter": 125,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पारिजातं न दास्यामीतीन्द्रभाषणम्-०७०",
      "combined_translation": "20-20"
    },
    {
      "verse": 21,
      "sanskrit": "उदवासगतो धीमान्पिता नः कश्यपः प्रभुः। अदित्या सह मे मात्रा तयोर्वाक्यमिदं भवेत्॥२१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 125,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पारिजातं न दास्यामीतीन्द्रभाषणम्-०७०",
      "combined_translation": "21-21"
    },
    {
      "verse": 22,
      "sanskrit": "अजितात्मा मम भ्राता रजसा तमसा वृतः। कामेन च स्त्रियो वाक्यादेव मामुक्तवान्गुरुम्॥२२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 125,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पारिजातं न दास्यामीतीन्द्रभाषणम्-०७०",
      "combined_translation": "22-22"
    },
    {
      "verse": 23,
      "sanskrit": "धिक्स्त्रियः सर्वथा विप्र धिग्राजसमितिं तथा। यत्राधिक्षिप्तवान्विष्णुरेवं मां स्त्रीजितो द्विज॥२३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 125,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पारिजातं न दास्यामीतीन्द्रभाषणम्-०७०",
      "combined_translation": "23-23"
    },
    {
      "verse": 24,
      "sanskrit": "न दृष्टं कश्यपकुले व्यपदेश्यं महामुने। नैव दक्षकुलं दृष्टं मातुर्मे यत्र सम्भवः॥२४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 125,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पारिजातं न दास्यामीतीन्द्रभाषणम्-०७०",
      "combined_translation": "24-24"
    },
    {
      "verse": 25,
      "sanskrit": "न ज्येष्ठता न राजत्वं देवानां प्रतिमानितम्। कामरागाभिभूतेन कृष्णेन खलु नारद॥२५॥",
      "english": null,
      "bhavadeepa": "व्यपदेश्यं वाच्यम्॥२४॥",
      "chapter": 125,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पारिजातं न दास्यामीतीन्द्रभाषणम्-०७०",
      "combined_translation": "25-25"
    },
    {
      "verse": 26,
      "sanskrit": "पुत्रदारसहस्रैर्हि भ्रातानघ विशिष्यते। सद्वृत्तो ज्ञानसम्पन्न इति ब्रह्मा पुराब्रवीत्॥२६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 125,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पारिजातं न दास्यामीतीन्द्रभाषणम्-०७०",
      "combined_translation": "26-26"
    },
    {
      "verse": 27,
      "sanskrit": "नास्ति भ्रातृसमो बन्धुराहार्य इतरो जनः। इति मामब्रवीन्माता पिता चैव प्रजापतिः॥२७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 125,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पारिजातं न दास्यामीतीन्द्रभाषणम्-०७०",
      "combined_translation": "27-27"
    },
    {
      "verse": 28,
      "sanskrit": "सोदरे तु विशेषं तु पिता मे कश्यपोऽब्रवीत्। दृप्ता मय विरुद्ध्यन्ते दानवाः पापनिश्चयाः॥२८॥",
      "english": null,
      "bhavadeepa": "आहार्यः सम्भोज्यः सम्पाद्यो वा॥२७॥",
      "chapter": 125,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पारिजातं न दास्यामीतीन्द्रभाषणम्-०७०",
      "combined_translation": "28-28"
    },
    {
      "verse": 29,
      "sanskrit": "काममेतन्न वक्तव्यं स्वयमात्मस्तवान्वितम्। प्राप्तस्त्ववसरो विप्र यदिहाद्योच्यते मया॥२९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 125,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पारिजातं न दास्यामीतीन्द्रभाषणम्-०७०",
      "combined_translation": "29-29"
    },
    {
      "verse": 30,
