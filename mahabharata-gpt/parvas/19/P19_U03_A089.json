{
  "adhyaya_id": "P19_U03_A089",
  "book": 19,
  "parva_name": "हरिवंशः",
  "upaparva_name": "भविष्यपर्व",
  "adhyaya_name": "महादेवेन कृष्णस्वरूपवर्णनम्",
  "chapter": 272,
  "verse_count": 20,
  "verses": [
    {
      "verse": 1,
      "sanskrit": "वैशम्पायन उवाच।\n              इत्युक्त्वा देवदेवेशं मुनीनाह पुनः शिवः। एवं जानीत हे विप्रा ये भक्ता द्रष्टुमागताः॥१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 272,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "महादेवेन कृष्णस्वरूपवर्णनम्",
      "combined_translation": "1-68"
    },
    {
      "verse": 2,
      "sanskrit": "एतदेव परं वस्तु नैतस्मात्परमस्ति वः। एतदेव विजानीध्वमेतद्वः परमं तपः॥२॥",
      "english": null,
      "bhavadeepa": "इत्युक्त्वेति॥१॥",
      "chapter": 272,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "महादेवेन कृष्णस्वरूपवर्णनम्"
    },
    {
      "verse": 3,
      "sanskrit": "एतदेव सदा विप्रा ध्येयं सततमानसैः। एतद्वः परमं श्रेय एतद्वः परमं धनम्॥३॥",
      "english": null,
      "bhavadeepa": "एतदित्यङ्गुल्या कृष्णं दर्शयति। तपः तपःफलम्॥२॥",
      "chapter": 272,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "महादेवेन कृष्णस्वरूपवर्णनम्",
      "combined_translation": "3-3"
    },
    {
      "verse": 4,
      "sanskrit": "एतद्वो जन्मनः कृत्यमेतद्वस्तपसः फलम्। एष वः पुण्यनिलय एष धर्मः सनातनः॥४॥",
      "english": null,
      "bhavadeepa": "सततमानसैः अविच्छिन्नचित्तवृत्तिभिः॥३॥",
      "chapter": 272,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "महादेवेन कृष्णस्वरूपवर्णनम्",
      "combined_translation": "4-4"
    },
    {
      "verse": 5,
      "sanskrit": "एष वो मोक्षदाता च एष मार्ग उदाहृतः। एष पुण्यप्रदः साक्षादेतद्वः कर्मणां फलम्॥५॥",
      "english": null,
      "bhavadeepa": "फलम् ऐकाग्र्यम्॥४॥",
      "chapter": 272,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "महादेवेन कृष्णस्वरूपवर्णनम्",
      "combined_translation": "5-5"
    },
    {
      "verse": 6,
      "sanskrit": "एतदेव प्रशंसन्ति विद्वांसो ब्रह्मवादिनः। एष त्र्ययीगतिर्विप्राः प्रार्थ्यो ब्रह्मविदां सदा॥६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 272,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "महादेवेन कृष्णस्वरूपवर्णनम्",
      "combined_translation": "6-6"
    },
    {
      "verse": 7,
      "sanskrit": "एतदेव प्रशंसन्ति साङ्ख्ययोगसमाश्रिताः। एष ब्रह्मविदां मार्गः कथितो वेदवादिभिः॥७॥",
      "english": null,
      "bhavadeepa": "त्रयीगतिः कर्मकाण्डप्राप्यः॥६॥",
      "chapter": 272,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "महादेवेन कृष्णस्वरूपवर्णनम्",
      "combined_translation": "7-7"
    },
    {
      "verse": 8,
      "sanskrit": "एवमेव विजानीत नात्र कार्या विचारणा। हरिरेकः सदा ध्येयो भवद्भिः सत्त्वमास्थितैः॥८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 272,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "महादेवेन कृष्णस्वरूपवर्णनम्",
      "combined_translation": "8-8"
    },
    {
      "verse": 9,
      "sanskrit": "नान्यो जगति देवोऽस्ति विष्णोर्नारायत्णापरः। ओमित्येवं सदा विप्रा पठत ध्यात केशवम्॥९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 272,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "महादेवेन कृष्णस्वरूपवर्णनम्",
      "combined_translation": "9-9"
    },
    {
      "verse": 10,
      "sanskrit": "ततो निःश्रेयसप्राप्तिर्भविष्यति न संशयः। एवं ध्यातो हरिः साक्षात्प्रसन्नो वो भविश्यति॥१०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 272,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "महादेवेन कृष्णस्वरूपवर्णनम्",
      "combined_translation": "10-10"
    },
    {
      "verse": 11,
      "sanskrit": "भवनाशमयं देवः करिष्यति दृढं हरिः। सदा ध्यात हरिं विप्रा यदीच्छा प्राप्तुमच्युतम्॥११॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 272,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "महादेवेन कृष्णस्वरूपवर्णनम्",
      "combined_translation": "11-11"
    },
    {
      "verse": 12,
      "sanskrit": "एष संसारविभवं विनाशयति वो गुरुः। स्मरध्वं सततं विष्णुं पठध्वं त्रिशरीरिणम्॥१२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 272,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "महादेवेन कृष्णस्वरूपवर्णनम्",
      "combined_translation": "12-12"
    },
    {
      "verse": 13,
      "sanskrit": "मनःसंयमनं विप्राः कुरुध्वं यत्नतः सदा। शुद्धेऽन्तःकरणे विष्णुः प्रसीदति तपोधनाः॥१३॥",
      "english": null,
      "bhavadeepa": "संसारस्य विभवः नानारूपेण भवनं यस्याः साकाशात् सा मूलविद्या तां त्रिशरीरिणं ब्रह्मादित्रयदेहम्॥१२॥",
      "chapter": 272,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "महादेवेन कृष्णस्वरूपवर्णनम्",
      "combined_translation": "13-13"
    },
    {
      "verse": 14,
      "sanskrit": "ध्यात्वा मां सर्वयत्नेन ततो जानीत केशवम्। उपास्योऽहं सदा विप्रा उपास्योऽस्मिन्हरौ स्मृतः॥१४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 272,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "महादेवेन कृष्णस्वरूपवर्णनम्",
      "combined_translation": "14-14"
    },
    {
      "verse": 15,
      "sanskrit": "उपायोऽयं मया प्रोक्तो नात्र सन्देह इत्यपि। अयं मायी सदा विप्रा यतध्वमघनाशने॥१५॥",
      "english": null,
      "bhavadeepa": "ध्यात्वेति। स्वस्य सगुणब्रह्मभावं जानीतेति केशवस्य निर्गुणब्रह्मभावनं च सूचयति। उपास्यः चिन्तनीयः। उपास्य उपगत्य प्राप्यः॥१४॥",
      "chapter": 272,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "महादेवेन कृष्णस्वरूपवर्णनम्",
      "combined_translation": "15-15"
    },
    {
      "verse": 16,
      "sanskrit": "यथा वो बुद्धिरखिला शुद्धा भवति यत्नतः। तथा कुरुत विप्रेन्द्रा यथा देवः प्रसीदति॥१६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 272,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "महादेवेन कृष्णस्वरूपवर्णनम्",
      "combined_translation": "16-16"
    },
    {
      "verse": 17,
      "sanskrit": "वैशम्पायन उवाच।\n              एवमुक्तास्ततः सर्वे मुनयः पुण्यशीलिनः। यथावदुपगृह्णाना निरसन्संशयं नृप॥१७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 272,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "महादेवेन कृष्णस्वरूपवर्णनम्",
      "combined_translation": "17-17"
    },
    {
      "verse": 18,
      "sanskrit": "एवमेवेति तं विप्राः प्राहुः प्राञ्जलयो हरम्। छिन्नो नः संशयः सर्वे गृहीतोऽर्थः स तादृशः॥१८॥",
      "english": null,
      "bhavadeepa": "निरसन् निरस्तवन्तः॥१७॥",
      "chapter": 272,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "महादेवेन कृष्णस्वरूपवर्णनम्",
      "combined_translation": "18-18"
    },
    {
      "verse": 19,
      "sanskrit": "एतदर्थं समायाता वयमद्य तवालयम्। सङ्गमाद्युवयोः सर्वो नष्टो मोहो महानिह॥१९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 272,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "महादेवेन कृष्णस्वरूपवर्णनम्",
      "combined_translation": "19-19"
    },
    {
      "verse": 20,
      "sanskrit": "यथा वदसि देवेश तथा नः श्रेयसे परम्। यथाऽऽह भगवान्रुद्रो यतामः सततं हरौ। इति ते मुनयः प्रीताः प्रणेमुः केशवं हरिम्॥२०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 272,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "महादेवेन कृष्णस्वरूपवर्णनम्",
      "combined_translation": "20-20"
    }
  ]
}