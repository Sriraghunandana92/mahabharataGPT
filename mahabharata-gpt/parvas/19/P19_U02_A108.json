  "adhyaya_name": "मायावत्या सह प्रद्युम्नस्य द्वारकागमनम्-१०८",
  "chapter": 163,
  "verse_count": 36,
  "verses": [
    {
      "verse": 1,
      "sanskrit": "वैशम्पान उवाच।\n              समप्तमायो मायाज्ञो विक्रान्तः समरेऽव्ययः। अष्टम्यां निहतो युद्धे मायावी कालशम्बरः॥१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 163,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "मायावत्या सह प्रद्युम्नस्य द्वारकागमनम्-१०८"
    },
    {
      "verse": 2,
      "sanskrit": "तमृक्षवन्ते नगरे निहत्यासुरसत्तमम्। गृह्य मायावतीं देवीमागच्छन्नगरं पितुः॥२॥",
      "english": null,
      "bhavadeepa": "समाप्तेति॥१॥",
      "chapter": 163,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "मायावत्या सह प्रद्युम्नस्य द्वारकागमनम्-१०८",
      "combined_translation": "2-2"
    },
    {
      "verse": 3,
      "sanskrit": "सोऽन्तरिक्षगतो भूत्वा मायावी शीघ्रविक्रमः। आजगाम पुरीं रम्यां रक्षितां तेजसा पितुः॥३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 163,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "मायावत्या सह प्रद्युम्नस्य द्वारकागमनम्-१०८",
      "combined_translation": "3-3"
    },
    {
      "verse": 4,
      "sanskrit": "सोऽन्तरिक्षान्निपतितः केशवान्तःपुरे शिशुः। मायावत्या सह तया रूपवानिव मन्मथः॥४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 163,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "मायावत्या सह प्रद्युम्नस्य द्वारकागमनम्-१०८",
      "combined_translation": "4-4"
    },
    {
      "verse": 5,
      "sanskrit": "तस्मिंस्तत्रावपतिते महिष्यः केशवस्य याः। विस्मिताश्चैव हृष्टाश्च भीताश्चैवाभवंस्ततः॥५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 163,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "मायावत्या सह प्रद्युम्नस्य द्वारकागमनम्-१०८",
      "combined_translation": "5-5"
    },
    {
      "verse": 6,
      "sanskrit": "ततस्तं कामसङ्काशं कान्तया सह सङ्गतम्। प्रेक्षन्त्यो हृष्टवदनाः पिबन्त्यो नयनोत्सवम्॥६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 163,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "मायावत्या सह प्रद्युम्नस्य द्वारकागमनम्-१०८",
      "combined_translation": "6-6"
    },
    {
      "verse": 7,
      "sanskrit": "तं विनीतमुखं दृष्ट्वा सज्जमानं पदे पदे। अभवन्स्निग्धसङ्कल्पाः सर्वास्ताः कृष्णयोषितः॥७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 163,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "मायावत्या सह प्रद्युम्नस्य द्वारकागमनम्-१०८",
      "combined_translation": "7-7"
    },
    {
      "verse": 8,
      "sanskrit": "रुक्मिणी चैव तं दृष्ट्वा शोकार्ता पुत्रगर्द्धिनी। सपत्नीशतसङ्कीर्णा सबाष्पा वाक्यमब्रवीत्॥८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 163,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "मायावत्या सह प्रद्युम्नस्य द्वारकागमनम्-१०८",
      "combined_translation": "8-8"
    },
    {
      "verse": 9,
      "sanskrit": "यादृक्स्वप्नो मया दृष्टो निशायां यौवने गते। कंसारिणा ममानीय दत्तं साहारपल्लवम्॥९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 163,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "मायावत्या सह प्रद्युम्नस्य द्वारकागमनम्-१०८",
      "combined_translation": "9-9"
    },
    {
      "verse": 10,
      "sanskrit": "शशिरश्मिप्रतीकाशं मुक्तादामविभूषितम्। केशवेनाङ्कमारोप्य मम कण्ठे न्यबध्यत॥१०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 163,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "मायावत्या सह प्रद्युम्नस्य द्वारकागमनम्-१०८",
      "combined_translation": "10-10"
    },
    {
      "verse": 11,
      "sanskrit": "श्यामा सुचारुकेशा स्त्री शुक्लाम्बरविभूषिता। पद्महस्ता निरीक्षन्ती प्रविष्टा मम वेश्मनि॥११॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 163,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "मायावत्या सह प्रद्युम्नस्य द्वारकागमनम्-१०८",
      "combined_translation": "11-11"
    },
    {
      "verse": 12,
      "sanskrit": "तथा पुनरहं गृह्य स्नापिता रुचिराम्बुना। कुशेशयमयीं मालां स्त्री सङ्गृह्याथ पाणिना॥१२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 163,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "मायावत्या सह प्रद्युम्नस्य द्वारकागमनम्-१०८",
      "combined_translation": "12-12"
    },
    {
      "verse": 13,
      "sanskrit": "मम मूर्धन्युपाघ्राय दत्ता स्वच्छा तया मम। एवं स्वप्नान्कीर्तयन्ती रुक्मिणी हृष्टमानसा॥१३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 163,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "मायावत्या सह प्रद्युम्नस्य द्वारकागमनम्-१०८",
      "combined_translation": "13-13"
    },
    {
      "verse": 14,
      "sanskrit": "सखीजनवृता देवी कुमारं वीक्ष्य तं मुहुः। धन्यायाः खल्वयं पुत्रो दीर्घायुः प्रियदर्शनः॥१४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 163,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "मायावत्या सह प्रद्युम्नस्य द्वारकागमनम्-१०८",
      "combined_translation": "14-14"
    },
    {
      "verse": 15,
      "sanskrit": "ईदृशः कामसङ्काशो यौवने प्रथमे स्थितः। जीवपुत्रा त्वया पुत्र कासौ भाग्यसमन्विता॥१५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 163,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "मायावत्या सह प्रद्युम्नस्य द्वारकागमनम्-१०८",
      "combined_translation": "15-15"
    },
    {
      "verse": 16,
      "sanskrit": "किमर्थं चाम्बुदश्यामः सभार्यस्त्वमिहागतः। अस्मिन्वयसि सुव्यक्तं प्रद्युम्नो मम पुत्रकः॥१६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 163,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "मायावत्या सह प्रद्युम्नस्य द्वारकागमनम्-१०८",
      "combined_translation": "16-16"
    },
    {
      "verse": 17,
      "sanskrit": "भवेद्यदि न नीतः स्यात्कृतान्तेन बलीयसा। व्यक्तं कृष्णकुमारस्त्वं न मिथ्या मम तर्कितम्॥१७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 163,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "मायावत्या सह प्रद्युम्नस्य द्वारकागमनम्-१०८",
      "combined_translation": "17-17"
    },
    {
      "verse": 18,
      "sanskrit": "विज्ञातोऽसि मया चिह्नैर्विना चक्रं जनार्दनः। मुखं नारायणस्येव केशाः केशान्त एव च॥१८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 163,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "मायावत्या सह प्रद्युम्नस्य द्वारकागमनम्-१०८",
      "combined_translation": "18-18"
    },
    {
      "verse": 19,
      "sanskrit": "ऊरू वक्षो भुजौ तुल्यौ हलिनः श्वशुरस्य मे। कस्त्वं वृष्णिकुलं सर्वं द्योतयन्वपुषा स्थितः॥१९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 163,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "मायावत्या सह प्रद्युम्नस्य द्वारकागमनम्-१०८",
      "combined_translation": "19-19"
    },
    {
      "verse": 20,
      "sanskrit": "अहो नारायणस्येव दिव्या ते परमा तनुः। एतस्मिन्नन्तेरे कृष्णः सहसा प्रविवेश ह। नारदस्य वचः श्रुत्वा शम्बरस्य वधं प्रति॥२०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 163,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "मायावत्या सह प्रद्युम्नस्य द्वारकागमनम्-१०८",
      "english_ref": 1,
      "combined_translation": "1-20"
    },
    {
      "verse": 21,
      "sanskrit": "सोऽपश्यत्तं सुतं ज्येष्ठं सिद्धं मन्मथलक्षणैः। स्नुषां मायावतीं चैव हृष्टचेता जनार्दनः। सोऽब्रवीत्सहसा देवीं रुक्मिणीं देवतामिव॥२१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 163,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "मायावत्या सह प्रद्युम्नस्य द्वारकागमनम्-१०८"
    },
    {
      "verse": 22,
      "sanskrit": "कृष्ण उवाच\n              अयं स देवि सम्प्राप्तः सुतश्चापधरस्तव॥२२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 163,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "मायावत्या सह प्रद्युम्नस्य द्वारकागमनम्-१०८"
    },
    {
      "verse": 23,
      "sanskrit": "अनेन शम्बरं हत्वा मायायुद्धविशारदम्। हता मायासुताः सर्वा याभिर्देवानबाधयत्॥२३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 163,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "मायावत्या सह प्रद्युम्नस्य द्वारकागमनम्-१०८"
    },
    {
      "verse": 24,
      "sanskrit": "सती चेयं शुभा साध्वी भार्या वै तनयस्य ते। मायावतीति विख्याता शम्बरस्य गृहोषिता॥२४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 163,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "मायावत्या सह प्रद्युम्नस्य द्वारकागमनम्-१०८"
    },
    {
      "verse": 25,
      "sanskrit": "मा च ते शम्बरस्येयं पत्नीति भवतु व्यथा। मन्मथे तु गते नाशं गते चानङ्गतां पुरा॥२५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 163,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "मायावत्या सह प्रद्युम्नस्य द्वारकागमनम्-१०८"
    },
    {
      "verse": 26,
      "sanskrit": "कामपत्नी न कान्तैषा शम्बरस्य रतिप्रिया। मायारूपेण तं दैत्यं मोहयत्यसकृच्छुभा॥२६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 163,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "मायावत्या सह प्रद्युम्नस्य द्वारकागमनम्-१०८"
    },
    {
      "verse": 27,
      "sanskrit": "न चैषा तस्य कौमारे वशे तिष्ठति शोभना। आत्ममायामयं कृत्वा रूपं शम्बरमाविशत्॥२७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 163,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "मायावत्या सह प्रद्युम्नस्य द्वारकागमनम्-१०८"
    },
    {
      "verse": 28,
      "sanskrit": "पत्न्येषा मम पुत्रस्य स्नुषा तव वराङ्गना। लोककान्तस्या साहाय्यं करिष्यति मनोमयम्॥२८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 163,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "मायावत्या सह प्रद्युम्नस्य द्वारकागमनम्-१०८"
    },
    {
      "verse": 29,
      "sanskrit": "प्रवेशयैनां भवनं पूज्यां ज्येष्ठां स्नुषां मम। चिरं प्रनष्टं च सुतं भजस्व पुनरागतम्॥२९॥",
