      "bhavadeepa": null,
      "chapter": 163,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "मायावत्या सह प्रद्युम्नस्य द्वारकागमनम्-१०८"
    },
    {
      "verse": 30,
      "sanskrit": "वैशम्पायन उवाच।\n              श्रुत्वा तु वचनं देवी कृष्णेनोदाहृतं तदा। प्रहर्शमतुलं लब्ध्वा रुक्मिणी वाक्यमब्रवीत्॥३०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 163,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "मायावत्या सह प्रद्युम्नस्य द्वारकागमनम्-१०८",
      "english_ref": 26,
      "combined_translation": "26-30"
    },
