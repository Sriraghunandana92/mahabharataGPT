{
  "adhyaya_id": "P19_U03_A058",
  "book": 19,
  "parva_name": "हरिवंशः",
  "upaparva_name": "भविष्यपर्व",
  "adhyaya_name": "देवासुरयुद्धे केशिरुद्रयोस्तुमुलयुद्धम्",
  "chapter": 241,
  "verse_count": 102,
  "verses": [
    {
      "verse": 1,
      "sanskrit": "वैशम्पायन उवाच।\n              तत्रैव तु महायुद्धे रणाजिर्देवसत्तमः। युध्यते सह दैत्येन एकचक्रेण धीमता॥१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 241,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे केशिरुद्रयोस्तुमुलयुद्धम्",
      "combined_translation": "1-70"
    },
    {
      "verse": 2,
      "sanskrit": "प्रच्छाद्य रथपन्थानमुत्क्रोशंश्च महाबलः। एकचक्रस्य सैन्यं तच्छरवर्षैरवाकिरत्॥२॥",
      "english": null,
      "bhavadeepa": "तत्रैवेति। रणाजिः साध्यविशेषः॥१॥",
      "chapter": 241,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे केशिरुद्रयोस्तुमुलयुद्धम्",
      "combined_translation": "2-2"
    },
    {
      "verse": 3,
      "sanskrit": "महासुरा महावीर्या महापट्टिशयोधिनः। शूलानि च भुशुण्डीश्च क्षिपन्त स्म महारणे॥३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 241,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे केशिरुद्रयोस्तुमुलयुद्धम्",
      "combined_translation": "3-3"
    },
    {
      "verse": 4,
      "sanskrit": "तच्छूलवर्षं सुमहद्गदाशक्तिसमाकुलम्। अविशद्दितिजैर्मुक्तं दुर्निवार्यं चराचरैः॥४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 241,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे केशिरुद्रयोस्तुमुलयुद्धम्",
      "combined_translation": "4-4"
    },
    {
      "verse": 5,
      "sanskrit": "अन्योन्यमभिवर्तन्ते देवासुरगणा युधि। महाद्रिशिखराकारा विर्यवान्तो महाबलाः॥५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 241,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे केशिरुद्रयोस्तुमुलयुद्धम्",
      "combined_translation": "5-5"
    },
    {
      "verse": 6,
      "sanskrit": "तुरङ्गमाणां तु शतं युक्तं तस्य महारथे। महासुरवरस्येव हिरण्यकशिपोर्युधि॥६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 241,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे केशिरुद्रयोस्तुमुलयुद्धम्",
      "combined_translation": "6-6"
    },
    {
      "verse": 7,
      "sanskrit": "तेषां चरणपातेन चक्रनेमिस्वनेन च। तस्य बाणनिपातैश्च हता वै शतशः सुराः॥७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 241,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे केशिरुद्रयोस्तुमुलयुद्धम्",
      "combined_translation": "7-7"
    },
    {
      "verse": 8,
      "sanskrit": "ततः स लघुभिश्चित्रैः शरैः सन्नतपर्वभिः। सायुधानच्छिनत्क्रुद्धः शतशोऽथ सहस्रशः॥८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 241,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे केशिरुद्रयोस्तुमुलयुद्धम्",
      "combined_translation": "8-8"
    },
    {
      "verse": 9,
      "sanskrit": "वध्यमानाः शरैस्तीक्ष्णै रथद्विरदवाजिनः। गमिताः प्रक्षयं केचित् त्रिदशैर्दानवा रणे॥९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 241,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे केशिरुद्रयोस्तुमुलयुद्धम्",
      "combined_translation": "9-9"
    },
    {
      "verse": 10,
      "sanskrit": "ततः प्रक्षीयमाणांस्तानुपप्रेक्ष्य दितेः सुताः। त्यक्त्वा बाणान्न्यवर्तन्त प्रगृहीतवरायुधाः॥१०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 241,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे केशिरुद्रयोस्तुमुलयुद्धम्",
      "combined_translation": "10-10"
    },
    {
      "verse": 11,
      "sanskrit": "ते दिशो विदिशश्चैव प्रतियुद्धप्रहारिणः। अभ्यघ्नन्निशितैः शस्त्रैर्देवान्दितिसुता रणे॥११॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 241,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे केशिरुद्रयोस्तुमुलयुद्धम्",
      "combined_translation": "11-11"
    },
    {
      "verse": 12,
      "sanskrit": "रणाद्विचलितं घोरं परमं तिग्मतेजसम्। मुमोचास्त्रं महाबाहुर्मथनं नाम संयुगे॥१२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 241,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे केशिरुद्रयोस्तुमुलयुद्धम्",
      "combined_translation": "12-12"
    },
    {
      "verse": 13,
      "sanskrit": "ततः शस्त्राणि शूलानि निशितानि सहस्रशः। अतिवीर्येण महता दितिजः सम्प्रचिच्छिदे॥१३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 241,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे केशिरुद्रयोस्तुमुलयुद्धम्",
      "combined_translation": "13-13"
    },
    {
      "verse": 14,
      "sanskrit": "छित्वा शूलेन तान्सर्वानेकचक्रो महासुरः। अभ्यविध्यत तं साध्यं दशभिर्निशितैः शरैः॥१४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 241,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे केशिरुद्रयोस्तुमुलयुद्धम्",
      "combined_translation": "14-14"
    },
    {
      "verse": 15,
      "sanskrit": "अस्त्रवेगेन हत्वैव सोऽस्त्रैस्तस्यानुसैनिकान्। ज्वलितैरपरैः शीघ्रैस्तानविध्यत्सहस्रशः॥१५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 241,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे केशिरुद्रयोस्तुमुलयुद्धम्",
      "combined_translation": "15-15"
    },
    {
      "verse": 15,
      "sanskrit": "तेषां छिन्नानि गात्राणि विसृजन्ति स्म शोणितम्। प्रावृषीवाम्बुवृष्टीनि शृङ्गाणि धरणीभृताम्॥१५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 241,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे केशिरुद्रयोस्तुमुलयुद्धम्",
      "combined_translation": "15-15"
    },
    {
      "verse": 17,
      "sanskrit": "इन्द्राशनिसमस्पर्शैर्निपतद्भिरजिह्मगैः। दितिजैर्वध्यमानास्ते वित्रेसुः सुरसत्तमाः॥१७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 241,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे केशिरुद्रयोस्तुमुलयुद्धम्",
      "combined_translation": "17-17"
    },
    {
      "verse": 18,
      "sanskrit": "एकचक्रे रथे तिष्ठन्नपश्यद्गजयूथपम्। वराभरणनिर्ह्रादान्त्समुद्रस्वननिःस्वनान्॥१८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 241,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे केशिरुद्रयोस्तुमुलयुद्धम्",
      "combined_translation": "18-18"
    },
    {
      "verse": 19,
      "sanskrit": "मत्तान्त्सुविहितान्दृप्तान्महामात्रैरधिष्ठितान्। कुलीनान्वीर्यसम्पन्नान्प्रतिद्विरदघातिनः॥१९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 241,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे केशिरुद्रयोस्तुमुलयुद्धम्",
      "combined_translation": "19-19"
    },
    {
      "verse": 20,
      "sanskrit": "शिक्षितान्गजशिक्षायामैरावतसमान्युधि। न्यहनत्सुरसैन्यस्य गजान्गज इवासुरः॥२०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 241,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे केशिरुद्रयोस्तुमुलयुद्धम्",
      "combined_translation": "20-20"
    },
    {
      "verse": 21,
      "sanskrit": "विक्षरन्तो महानागान्भीमवेगांस्त्रिधा मदम्। मेघस्तनितनिर्घोषान्महाद्रीनिव चोत्थितान्॥२१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 241,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे केशिरुद्रयोस्तुमुलयुद्धम्",
      "combined_translation": "21-21"
    },
    {
      "verse": 22,
      "sanskrit": "सहस्रसम्मितान्दिव्याञ्जाम्बूनदपरिष्कृतान्। सुवर्णजालैर्विततांस्तरुणादित्यवर्चसः॥२२॥",
      "english": null,
      "bhavadeepa": "त्रिधा कण्ठकरकुम्भदेशेषु मदं क्षरन्तः। द्वितीयार्थे प्रथमा॥२१॥",
      "chapter": 241,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे केशिरुद्रयोस्तुमुलयुद्धम्",
      "combined_translation": "22-22"
    },
    {
      "verse": 23,
      "sanskrit": "एकचक्रो गदापाणिर्बलवान्गदिनां वरः। उत्सारयामास गजान्महाभ्राणीव मारुतः॥२३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 241,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे केशिरुद्रयोस्तुमुलयुद्धम्",
      "combined_translation": "23-23"
    },
    {
      "verse": 24,
      "sanskrit": "निहत्य गदया सर्वांस्तान्गजान्गजमर्दनः। भूयोऽश्वसङ्घान्त्स बली निरैक्षत महासुरः॥२४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 241,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे केशिरुद्रयोस्तुमुलयुद्धम्",
      "combined_translation": "24-24"
    },
    {
      "verse": 25,
      "sanskrit": "शुकवर्णानृष्यवर्णान्मयूरसदृशांस्तथा। पारावतसवर्णांश्च हंसवर्णांस्तथैव च॥२५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 241,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे केशिरुद्रयोस्तुमुलयुद्धम्",
      "combined_translation": "25-25"
    },
    {
      "verse": 26,
      "sanskrit": "मल्लिकाक्षान्विरूपाक्षान्क्रौञ्चवर्णान्मनोजवान्। अश्वसैन्यं महाबाहुस्तदप्रतिमपौरुषः॥२६॥",
      "english": null,
      "bhavadeepa": "ऋष्यः धूसरो मृगविशेषस्तद्वर्णान्॥२५॥",
      "chapter": 241,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे केशिरुद्रयोस्तुमुलयुद्धम्",
      "combined_translation": "26-26"
    },
    {
      "verse": 27,
      "sanskrit": "निषूदयामास बली गदया भीमविक्रमः। रणाजिर्व्यस्य समरे सर्वान्दृष्ट्वा सुरद्विषः॥२७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 241,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे केशिरुद्रयोस्तुमुलयुद्धम्",
      "combined_translation": "27-27"
    },
    {
      "verse": 28,
      "sanskrit": "अचिन्त्यविक्रमः श्रीमानभ्ययाद्देववाहिनीम्। गदायुद्धेषु कुशलो रथेन रथयूथपः॥२८॥",
      "english": null,
      "bhavadeepa": "व्यस्य त्यक्त्वा॥२७॥",
      "chapter": 241,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे केशिरुद्रयोस्तुमुलयुद्धम्",
      "combined_translation": "28-28"
    },
    {
      "verse": 29,
      "sanskrit": "हृष्टसैन्यो महाबाहुः प्रस्थितः शक्रसन्निधौ। त्रिंशच्छतसहस्राणि रथानां विनिहत्य सः॥२९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 241,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे केशिरुद्रयोस्तुमुलयुद्धम्",
      "combined_translation": "29-29"
    },
    {
      "verse": 30,
      "sanskrit": "रणेऽतिष्ठत दैत्येन्द्रो विधूम इव पावकः। तस्मिन्नेव तु सङ्ग्रमे बलदृप्तो महासुरः॥३०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 241,
