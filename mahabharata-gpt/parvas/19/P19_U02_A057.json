{
  "adhyaya_id": "P19_U02_A057",
  "book": 19,
  "parva_name": "हरिवंशः",
  "upaparva_name": "विष्णुपर्व",
  "adhyaya_name": "कालयवनवधः-०५७",
  "chapter": 112,
  "verse_count": 70,
  "verses": [
    {
      "verse": 1,
      "sanskrit": "जनमेजय उवाच।\n              भगवञ्छ्रोतुमिच्छामि विस्तरेण महात्मनः। चरितं वासुदेवस्य यदुश्रेष्ठस्य धीमतः॥१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 112,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कालयवनवधः-०५७"
    },
    {
      "verse": 2,
      "sanskrit": "किमर्थं च परित्यज्य मथुरां मधुसूदनः। मध्यदेशस्य ककुदं धाम लक्ष्म्याश्च केवलम्॥२॥",
      "english": null,
      "bhavadeepa": "सप्तपञ्चाशत्तमेऽस्मिन्मुचुकुन्ददृशा हरिः। यवनं घातयामास मानयञ्छाङ्करं वरम्॥१॥ भगवन्निति॥१॥",
      "chapter": 112,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कालयवनवधः-०५७",
      "combined_translation": "2-36"
    },
    {
      "verse": 3,
      "sanskrit": "शृङ्गं पृथिव्याः स्वालक्ष्यं प्रभूतधनधान्यवत्। आर्याढ्यजलभूयिष्ठमधिष्ठानवरोत्तमम्॥३॥",
      "english": null,
      "bhavadeepa": "परित्यज्य गत इत्यर्थः॥२॥",
      "chapter": 112,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कालयवनवधः-०५७",
      "combined_translation": "3-3"
    },
    {
      "verse": 4,
      "sanskrit": "अयुद्धेनैव दाशार्हस्त्यक्तवान्द्विजसत्तम। स कालयवनश्चापि कृष्णे किं प्रत्यपद्यत॥४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 112,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कालयवनवधः-०५७",
      "combined_translation": "4-4"
    },
    {
      "verse": 5,
      "sanskrit": "द्वारकां च समासाद्य वारिदुर्गां जनार्दनः। किं चकार महाबाहुर्महायोगी महातपाः॥५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 112,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कालयवनवधः-०५७",
      "combined_translation": "5-5"
    },
    {
      "verse": 6,
      "sanskrit": "किंवीर्याः कालयवनः केन जातश्च वीर्यवान्। यमसह्यं समालक्ष्य व्यपयातो जनार्दनः॥६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 112,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कालयवनवधः-०५७",
      "combined_translation": "6-6"
    },
    {
      "verse": 7,
      "sanskrit": "वैशम्पायन उवाच।\n              वृष्णीनामन्धकानां च गुरुर्गार्ग्यो महामनाः। ब्रह्मचारी पुरा भूत्वा न स्म दारान्स विन्दति॥७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 112,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कालयवनवधः-०५७",
      "combined_translation": "7-7"
    },
    {
      "verse": 8,
      "sanskrit": "तथा हि वर्तमानं तमूर्ध्वरेतसमव्ययम्। श्यालोऽभिशस्तवान्गार्ग्यमपुमानिति राजनि॥८॥",
      "english": null,
      "bhavadeepa": "दारान्विद्यमानानपि न विन्दति नाभ्यगच्छत्॥७॥",
      "chapter": 112,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कालयवनवधः-०५७",
      "combined_translation": "8-8"
    },
    {
      "verse": 9,
      "sanskrit": "सोऽभिशस्तास्तदा राजन्नगरे त्वजितं जये। अलिप्संस्तु स्त्रियं चैव तपस्तेपे सुदारुणम्॥९॥",
      "english": null,
      "bhavadeepa": "राजनि राजसभायाम्॥८॥",
      "chapter": 112,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कालयवनवधः-०५७",
      "combined_translation": "9-9"
    },
    {
      "verse": 10,
      "sanskrit": "ततो द्वादशवर्षाणि सोऽयश्चूर्णमभक्षयत्। आराधयन्महादेवमचिन्त्यं शूलपाणिनम्॥१०॥",
      "english": null,
      "bhavadeepa": "अलिप्सन् अनिच्छन् कोपेन॥९॥",
      "chapter": 112,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कालयवनवधः-०५७",
      "combined_translation": "10-10"
    },
    {
      "verse": 11,
      "sanskrit": "रुद्रस्तस्मै वरं प्रादात्समर्थं युधि निग्रहे। वृष्णीनामन्धकानां च सर्वतेजोमयं सुतम्॥११॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 112,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कालयवनवधः-०५७",
      "combined_translation": "11-11"
    },
    {
      "verse": 12,
      "sanskrit": "ततः शुश्राव तं राजा यवनाधिपतिर्वरम्। पुत्रप्रसवजं दैवादपुत्रः पुत्रकामिता॥१२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 112,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कालयवनवधः-०५७",
      "combined_translation": "12-12"
    },
    {
      "verse": 13,
      "sanskrit": "स नृपस्तमुपानाय्य सान्त्वयित्वा द्विजोत्तमम्। तं घोषमध्ये यवनो गोपस्त्रीषु समासृजत्॥१३॥",
      "english": null,
      "bhavadeepa": "पुत्रस्य कामिता कामयिता॥१२॥",
      "chapter": 112,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कालयवनवधः-०५७",
      "combined_translation": "13-13"
    },
    {
      "verse": 14,
      "sanskrit": "गोपाली त्वप्सरास्तत्र गोपस्त्रीवेषधारिणी। धारयामास गार्ग्यस्य गर्भं दुर्धरमच्युतम्॥१४॥",
      "english": null,
      "bhavadeepa": "तं गार्ग्यम् उपानाय्य स्वगृहमानाय्य॥१३॥",
      "chapter": 112,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कालयवनवधः-०५७",
      "combined_translation": "14-14"
    },
    {
      "verse": 15,
      "sanskrit": "मानुष्यां गार्ग्यभार्यायां नियोगाच्छूलपाणिनः। स कालयवनो नाम जज्ञे शूरो महाबलः॥१५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 112,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कालयवनवधः-०५७",
      "combined_translation": "15-15"
    },
    {
      "verse": 16,
      "sanskrit": "अपुत्रस्याथ राज्ञस्तु ववृधेऽन्तःपुरे शिशुः। तस्मिन्नुपरते राजन्स कालयवनो नृपः॥१६॥",
      "english": null,
      "bhavadeepa": "मानुष्यां मानुषीरूपायामप्सरसि भार्यायां भार्यावद्वर्त्तमानायाम्॥१५॥",
      "chapter": 112,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कालयवनवधः-०५७",
      "combined_translation": "16-16"
    },
    {
      "verse": 17,
      "sanskrit": "युद्धाभिकामो नृपतिः पर्यपृच्छद्द्विजोत्तमान्। वृष्ण्यन्धककुलं तस्य नारदेन निवेदितम्॥१७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 112,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कालयवनवधः-०५७",
      "combined_translation": "17-17"
    },
    {
      "verse": 18,
      "sanskrit": "ज्ञात्वा तु वरदानं तन्नारदान्मधुसूदनः। उपप्रैक्षत तेजस्वी वर्द्धन्तं यवनेषु तम्॥१८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 112,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कालयवनवधः-०५७",
      "combined_translation": "18-18"
    },
    {
      "verse": 19,
      "sanskrit": "समृद्धो हि यदा राजा यवनानां महाबलः। तत एवं नृपा म्लेच्छाः संश्रित्यानुययुस्तदा॥१९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 112,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कालयवनवधः-०५७",
      "combined_translation": "19-19"
    },
    {
      "verse": 20,
      "sanskrit": "शकास्तुषारा दरदाः पारदाः सृङ्गलाः खसाः। पह्लवाः शतशश्चान्ये म्लेच्छा हैमवतास्तथा॥२०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 112,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कालयवनवधः-०५७",
      "combined_translation": "20-20"
    },
    {
      "verse": 21,
      "sanskrit": "स तैः परिवृतो राजा दस्युभिः शलभैरिव। नानावेषायुधैर्भीमैर्मथुरामभ्यवर्तत॥२१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 112,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कालयवनवधः-०५७",
      "combined_translation": "21-21"
    },
    {
      "verse": 22,
      "sanskrit": "गजवाजिखरोष्ट्राणामयुतैरर्बुदैरपि। पृथिवीं कम्पयामास सैन्येन महता वृतः॥२२॥",
      "english": null,
      "bhavadeepa": "शलभैरवेति बहुत्वे दृष्टान्तः॥२१॥",
      "chapter": 112,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कालयवनवधः-०५७",
      "combined_translation": "22-22"
    },
    {
      "verse": 23,
      "sanskrit": "रेणुना सूर्यमार्गं तु समवच्छाद्य पार्थिवः। मूत्रेण शकृता चैव सैन्येन संसृजे नदीम्॥२३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 112,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कालयवनवधः-०५७",
      "combined_translation": "23-23"
    },
    {
      "verse": 24,
      "sanskrit": "अश्वोष्ट्रशकृतां राशेर्निस्सृतेति जनाधिप। ततोऽश्वशकृदित्येवं नाम नद्या बभूव ह॥२४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 112,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कालयवनवधः-०५७",
      "combined_translation": "24-24"
    },
    {
      "verse": 25,
      "sanskrit": "तत्सैन्यं महदायाद्वै श्रुत्वा वृष्ण्यन्धकाग्रणीः। वसुदेवः समानाय्य ज्ञातीनिदमुवाच ह॥२५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 112,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कालयवनवधः-०५७",
      "combined_translation": "25-25"
    },
    {
      "verse": 26,
      "sanskrit": "इदं समुत्थितं घोरं वृष्ण्यन्धकभवं महत्। अवध्यश्चापि नः शत्रुर्वरदानात्पिनाकिनः॥२६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 112,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कालयवनवधः-०५७",
      "combined_translation": "26-26"
    },
    {
      "verse": 27,
      "sanskrit": "सामादयोऽभ्युपायाश्च विहितास्तस्य सर्वशः। मत्तो मदबलाभ्यां तु युद्धमेव चिकीर्षति॥२७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 112,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कालयवनवधः-०५७",
      "combined_translation": "27-27"
    },
    {
      "verse": 28,
      "sanskrit": "एतावानिह वासश्च कथितो नारदेन मे। एतावति च वक्तव्यं सामैव परमं मतम्॥२८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 112,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कालयवनवधः-०५७",
      "combined_translation": "28-28"
    },
    {
      "verse": 29,
      "sanskrit": "जरासन्धश्च नो राजा नित्यमेव न मृष्यते। तथान्ये पृथिवीपाला वृष्णिचक्रप्रतापिताः॥२९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 112,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कालयवनवधः-०५७",
      "combined_translation": "29-29"
    },
    {
      "verse": 30,
      "sanskrit": "केचित्कंसवधाच्चापि विरक्तास्तद्गता नृपाः। समाशृत्य जरासन्धमस्मानिच्छन्ति बाधितुम्॥३०॥",
      "english": null,
      "bhavadeepa": "राजानोऽस्मान्॥२९॥",
      "chapter": 112,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कालयवनवधः-०५७",
      "combined_translation": "30-30"
    },
    {
      "verse": 31,
      "sanskrit": "बहवो ज्ञातयश्चैव यदूनां निहता नृपैः। वर्द्धितुं नैव शक्ष्याम पुरेऽस्मिन्निति केशवः॥३१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 112,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कालयवनवधः-०५७",
      "combined_translation": "31-31"
    },
    {
      "verse": 32,
      "sanskrit": "अपयाने मतिं कृत्वा दूतं तस्मै ससर्ज ह। ततः कुम्भे महासर्पं भिन्नाञ्जनचयोपमम्॥३२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 112,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
