  "upaparva_name": "विष्णुपर्व",
  "adhyaya_name": "पुनर्विशेषतो द्वारवतीनिर्माणम्-०९८",
  "chapter": 153,
  "verse_count": 76,
  "verses": [
    {
      "verse": 1,
      "sanskrit": "वैशम्पायन उवाच।\n              ददर्शाथ पुरीं कृष्णो द्वारकां गरुडे स्थितः। देवसद्मप्रतीकाशां समन्तात्प्रतिनादिताम्॥१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 153,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पुनर्विशेषतो द्वारवतीनिर्माणम्-०९८"
    },
    {
      "verse": 2,
      "sanskrit": "मणिपर्वतयन्त्राणि तथा क्रीडागृहाणि च। उद्यानवनमुख्यानि वलभीचत्वराणि च॥२॥",
      "english": null,
      "bhavadeepa": "ददर्शेति॥१॥",
      "chapter": 153,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पुनर्विशेषतो द्वारवतीनिर्माणम्-०९८",
      "combined_translation": "2-2"
    },
    {
      "verse": 3,
      "sanskrit": "सम्प्राप्ते तु तदा कृष्णे पुरीं देवकिनन्दने। विश्वकर्माणमाहूय देवराजोऽब्रवीदिदम्॥३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 153,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पुनर्विशेषतो द्वारवतीनिर्माणम्-०९८",
      "combined_translation": "3-3"
    },
    {
      "verse": 4,
      "sanskrit": "प्रियमिच्छसि चेत्कर्तुं मह्यं शिल्पवतां वर। कृष्णप्रियार्थं भूयस्त्वं प्रकुरुष्व मनोहराम्॥४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 153,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पुनर्विशेषतो द्वारवतीनिर्माणम्-०९८",
      "combined_translation": "4-4"
    },
    {
      "verse": 5,
      "sanskrit": "उद्यानशतसम्बाधां द्वारकां स्वर्गसंमिताम्। कुरुष्व विबुधश्रेष्ठ यथा मम पुरी तथा॥५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 153,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पुनर्विशेषतो द्वारवतीनिर्माणम्-०९८",
      "combined_translation": "5-5"
    },
    {
      "verse": 6,
      "sanskrit": "यत्किञ्चित्त्रिषु लोकेषु रत्नभूतं प्रपश्यसि। तेन संयुज्यतां क्षिप्रं पुरी द्वारवती त्वया॥६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 153,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पुनर्विशेषतो द्वारवतीनिर्माणम्-०९८",
      "combined_translation": "6-6"
    },
    {
      "verse": 7,
      "sanskrit": "कृष्णो हि सुरकार्येषु सर्वेषु सततोत्थितः। सङ्ग्रामान्घोररूपांश्च विगाहति महाबलः। तामिन्द्रवचनाद्गत्वा विश्वकर्मा पुरीं ततः॥७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 153,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पुनर्विशेषतो द्वारवतीनिर्माणम्-०९८",
      "combined_translation": "7-7"
    },
    {
      "verse": 8,
      "sanskrit": "अलञ्चक्रे समन्ताद्वै यथेन्द्रस्यामरावती। तां ददर्श दशार्हाणामीश्वरः पक्षिवाहनः। विश्वकर्मकृतैर्दिव्यैरभिप्रायैरलङ्कृताम्॥८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 153,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पुनर्विशेषतो द्वारवतीनिर्माणम्-०९८",
      "combined_translation": "8-8"
    },
    {
      "verse": 9,
      "sanskrit": "तां तदा द्वारकां दृष्ट्वा प्रभुर्नारायणो विभुः। हृष्टः सर्वार्थसम्पन्नः प्रवेष्टुमुपचक्रमे॥९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 153,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पुनर्विशेषतो द्वारवतीनिर्माणम्-०९८",
      "combined_translation": "9-9"
    },
    {
      "verse": 10,
      "sanskrit": "सोऽपश्यद्वृक्षखण्डांश्च रम्यान्दृष्टिमनोहरान्। द्वारकां प्रति दाशार्हश्चित्रितां विश्वकर्मणा॥१०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 153,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पुनर्विशेषतो द्वारवतीनिर्माणम्-०९८",
      "combined_translation": "10-10"
    },
    {
      "verse": 11,
      "sanskrit": "पद्मखण्डाकुलाभिश्च हंससेवितवारिभिः। गङ्गासिन्धुप्रकाशाभिः परिखाभिर्वृतां पुरीम्॥११॥",
      "english": null,
      "bhavadeepa": "खण्डान् समूहान्॥१०॥",
      "chapter": 153,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पुनर्विशेषतो द्वारवतीनिर्माणम्-०९८",
      "combined_translation": "11-11"
    },
    {
      "verse": 12,
      "sanskrit": "प्राकारेणार्कवर्णेन शातकौम्भेन राजता। चयमूर्ध्नि निविष्टेन द्यां यथैवाभ्रमालया॥१२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 153,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पुनर्विशेषतो द्वारवतीनिर्माणम्-०९८",
      "combined_translation": "12-12"
    },
    {
      "verse": 13,
      "sanskrit": "काननैर्नन्दनप्रख्यैस्तथा चैत्ररथोपमैः। बभौ चारुपरिक्षिप्ता द्वारका द्यौरिवाम्बुदैः॥१३॥",
      "english": null,
      "bhavadeepa": "चयमूर्ध्नि अट्टालोपरि॥१२॥",
      "chapter": 153,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पुनर्विशेषतो द्वारवतीनिर्माणम्-०९८",
      "combined_translation": "13-13"
    },
    {
      "verse": 14,
      "sanskrit": "बभौ रैवतकः शैलो रम्यसानुगुहाजिरः। पूर्वस्यां दिशि लक्ष्मीवान्मणिकाञ्चन्तोरणः॥१४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 153,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पुनर्विशेषतो द्वारवतीनिर्माणम्-०९८",
      "combined_translation": "14-14"
    },
    {
      "verse": 15,
      "sanskrit": "दक्षिणस्यां लताविष्टः पञ्चवर्णो विराजते। इन्द्रकेतुप्रतीकाशः पश्चिमायां तथा क्षयः॥१५॥",
      "english": null,
      "bhavadeepa": "मणिकाञ्चनमयानि तोरणानि बहिर्द्वाराणि यस्य॥१४॥",
      "chapter": 153,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पुनर्विशेषतो द्वारवतीनिर्माणम्-०९८",
      "combined_translation": "15-15"
    },
    {
      "verse": 16,
      "sanskrit": "उत्तरां दिशमत्यर्थं विभूषयति वेणुमान्। मन्दराद्रिप्रतीकाशः पाण्डुरः पार्थिवर्षभः॥१६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 153,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पुनर्विशेषतो द्वारवतीनिर्माणम्-०९८",
      "combined_translation": "16-16"
    },
    {
      "verse": 17,
      "sanskrit": "चित्रकं पञ्चवर्णं च पाञ्चजन्यं वनं महत्। सर्वर्तुकवनं चैव भाति रैवतकं प्रति॥१७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 153,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पुनर्विशेषतो द्वारवतीनिर्माणम्-०९८",
      "combined_translation": "17-17"
    },
    {
      "verse": 18,
      "sanskrit": "लतावेष्टितपर्यन्तं मेरुप्रभवनं महत्। भाति भानुवनं चैव पुष्पकं च महद्वनम्॥१८॥",
      "english": null,
      "bhavadeepa": "चित्रकादीनि चतुर्दश वनानि॥१७॥",
      "chapter": 153,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पुनर्विशेषतो द्वारवतीनिर्माणम्-०९८",
      "combined_translation": "18-18"
    },
    {
      "verse": 19,
      "sanskrit": "अक्षकैर्बीजकैश्चैव मन्दारैश्चोपशोभितम्। शतावर्तवनं चैव करवीराकरं तथा॥१९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 153,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पुनर्विशेषतो द्वारवतीनिर्माणम्-०९८",
      "combined_translation": "19-19"
    },
    {
      "verse": 20,
      "sanskrit": "भाति चैत्ररथं चैव नन्दनं च वनं महत्। रमणं भावनं चैवं वेणुमद्वै समन्ततः॥२०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 153,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पुनर्विशेषतो द्वारवतीनिर्माणम्-०९८",
      "combined_translation": "20-20"
    },
    {
      "verse": 21,
      "sanskrit": "वैडूर्यपत्रैर्जलजैस्तदा मन्दाकिनी नदी। भाति पुष्करिणी रम्या पूर्वस्यां दिशि भारत॥२१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 153,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पुनर्विशेषतो द्वारवतीनिर्माणम्-०९८",
      "combined_translation": "21-21"
    },
    {
      "verse": 22,
      "sanskrit": "सानवो भूषितास्तत्र केशवस्य प्रियैषिभिः। बहुभिर्देवगन्धर्वैश्चोदितैर्विश्वकर्मणा॥२२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 153,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पुनर्विशेषतो द्वारवतीनिर्माणम्-०९८",
      "combined_translation": "22-22"
    },
    {
      "verse": 23,
      "sanskrit": "महानदी द्वारवतीं पञ्चाशद्भिर्महामुखैः। प्रविष्टा पुण्यसलिला भावयन्ती समन्ततः॥२३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 153,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पुनर्विशेषतो द्वारवतीनिर्माणम्-०९८",
      "combined_translation": "23-23"
    },
    {
      "verse": 24,
      "sanskrit": "अप्रमेयां महोत्सेधामगाधपरिखायुताम्। प्राकारवरसम्पन्नां सुधापाण्डुरलेपनाम्॥२४॥",
      "english": null,
      "bhavadeepa": "महानदी मन्दाकिनी पञ्चाशद्भिर्विश्वजां सहस्रसंवत्सरे सत्रे पञ्चपञ्चाशतस्त्रिवृतः संवत्सराः पञ्चपञ्चाशतः पञ्चदशाः पञ्चपञ्चाशतः सप्तदशाः पञ्चपञ्चाशत एकविंशतिसङ्ख्याकाभिः पञ्चाशद्भिः सहस्त्रैः सम्पत्तिभिरुक्ता तावत्सङ्ख्यैः तत्फलभूतैरुद्यानादिभिरिति यावत्। भावयन्ती हर्षयन्ती जनानिति शेषः॥२३॥",
      "chapter": 153,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पुनर्विशेषतो द्वारवतीनिर्माणम्-०९८",
      "combined_translation": "24-24"
    },
    {
      "verse": 25,
      "sanskrit": "तीक्ष्णयन्त्रशतघ्नीभिर्हेमजालैश्च भूषिताम्। आयसैश्च महाचक्रैर्ददर्श द्वारकां पुरीम्॥२५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 153,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पुनर्विशेषतो द्वारवतीनिर्माणम्-०९८",
      "combined_translation": "25-25"
    },
    {
      "verse": 26,
      "sanskrit": "अष्टौ रथसहस्राणि नगरे किङ्किणीकिनाम्। समुच्छ्रितपताकानि यथा देवपुरे तथा॥२६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 153,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पुनर्विशेषतो द्वारवतीनिर्माणम्-०९८",
      "english_ref": 1,
      "combined_translation": "1-26"
    },
    {
      "verse": 27,
      "sanskrit": "अष्टयोजनविस्तीर्णामचलां द्वादशायताम्। द्विगुणोपनिवेशां च ददर्श द्वारकां पुरीम्॥२७॥",
      "english": null,
      "bhavadeepa": "किङ्किणीकिनां क्षुद्रघण्टिकावतां नर्तकानाम्॥२६॥",
      "chapter": 153,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पुनर्विशेषतो द्वारवतीनिर्माणम्-०९८"
    },
    {
      "verse": 28,
      "sanskrit": "अष्टमार्गमहारथ्यां महाषोडशचत्वराम्। एकमार्गपरिक्षिप्तां साक्षादुशनसा कृताम्॥२८॥",
      "english": null,
      "bhavadeepa": "द्वादशायतां द्वादशयोजनदीर्घाम् उपनिवेशाः शाखानगराणि तेषां द्विराजिभिर्द्विगुणायतां द्विगुणदीर्घां च॥२७॥",
      "chapter": 153,
