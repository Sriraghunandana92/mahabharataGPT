{
  "adhyaya_id": "P19_U03_A123",
  "book": 19,
  "parva_name": "हरिवंशः",
  "upaparva_name": "भविष्यपर्व",
  "adhyaya_name": "विचक्रवधः",
  "chapter": 306,
  "verse_count": 22,
  "verses": [
    {
      "verse": 1,
      "sanskrit": "वैशम्पायन उवाच।\n              एतस्मिन्नन्तरे राजन्द्वन्द्वयुद्धमवर्तत। विचक्रं योधयामास शार्ङ्गधन्वा गदाधरः॥१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 306,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "विचक्रवधः",
      "combined_translation": "1-26"
    },
    {
      "verse": 2,
      "sanskrit": "बलभद्रोऽथ हंसेन डिम्भकेन च सात्यकिः। वसुदेवोग्रसेनाभ्यां हिडिम्बः पुरुषादकः॥२॥",
      "english": null,
      "bhavadeepa": "एतस्मिन्निति॥१॥",
      "chapter": 306,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "विचक्रवधः",
      "combined_translation": "2-2"
    },
    {
      "verse": 3,
      "sanskrit": "शेषाश्च शेषै राजेन्द्र चक्रुर्युद्धमदीनगाः। वासुदेवस्त्रिसप्तत्या दैत्यं वक्षस्यताडयत्॥३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 306,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "विचक्रवधः",
      "combined_translation": "3-3"
    },
    {
      "verse": 4,
      "sanskrit": "शरैर्निशितधाराग्रैर्विस्मयं दर्शयन्रणे। दानवो देवदेवेशं दृढेन निशितेन च॥४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 306,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "विचक्रवधः",
      "combined_translation": "4-4"
    },
    {
      "verse": 5,
      "sanskrit": "शरेणाकर्णमाकृष्य धनुःप्रवरमीश्वरम्। जघान स्तनमध्ये च पश्यतस्तु शचीपते॥५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 306,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "विचक्रवधः",
      "combined_translation": "5-5"
    },
    {
      "verse": 6,
      "sanskrit": "तेन विद्धोऽथ भगवान्वक्षोदेशे जनार्दनः। अवमच्छोणितं विष्णुरादिकाले यथा प्रजाः॥६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 306,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "विचक्रवधः",
      "combined_translation": "6-6"
    },
    {
      "verse": 7,
      "sanskrit": "ततः क्रुद्धो हृषीकेशः क्षुरप्रेणाहनद्ध्वजम्। अश्वांश्च चतुरो हत्वा सारथिं च शरैस्त्रिभिः॥७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 306,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "विचक्रवधः",
      "combined_translation": "7-7"
    },
    {
      "verse": 8,
      "sanskrit": "ततो दध्मौ महाशङ्खं यथा तारामये रणे। रथादुत्प्लुत्य सहसा दानवः क्रोधमूर्च्छितः॥८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 306,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "विचक्रवधः",
      "combined_translation": "8-8"
    },
    {
      "verse": 9,
      "sanskrit": "गदां गृह्य महाघोरां दुःसहां वीर्यशालिनीम्। तया जघान दैत्येन्द्रः किरीटे केशवस्य ह॥९॥",
      "english": null,
      "bhavadeepa": "तारामये बृहस्पतिभार्याप्रधाने, तन्निमित्त इत्यर्थः॥८॥",
      "chapter": 306,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "विचक्रवधः"
    },
    {
      "verse": 10,
      "sanskrit": "ललाटे च पुनर्विष्णुं सिंहनादं व्यनीनदत्। ततः शिलां च महतीं प्रगृह्य दनुजः किल॥१०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 306,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "विचक्रवधः",
      "combined_translation": "10-10"
    },
    {
      "verse": 11,
      "sanskrit": "भ्रामयित्वा दशगुणं प्राहरत्केशवोरसि। तामापतन्तीं सम्प्रेक्ष्य हस्तेनादाय केशवः॥११॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 306,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "विचक्रवधः",
      "combined_translation": "11-11"
    },
    {
      "verse": 12,
      "sanskrit": "जघान च तथा दैत्यं स पपातार्दितः क्षितौ। गतासुरिव सञ्जज्ञे श्वसन्निव पपात ह॥१२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 306,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "विचक्रवधः"
    },
    {
      "verse": 13,
      "sanskrit": "प्राप्य संज्ञां ततो दैत्यः क्रोधाद्द्विगुणमाबभौ। आदाय परिघं घोरमिदमाह जनार्दान्म्॥१३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 306,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "विचक्रवधः"
    },
    {
      "verse": 14,
      "sanskrit": "अनेन तव गोविन्द दर्पजातं निहन्म्यहम्। विक्रमज्ञस्तदा चासि मम देवासुरे रणे॥१४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 306,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "विचक्रवधः",
      "combined_translation": "14-14"
    },
    {
      "verse": 15,
      "sanskrit": "तावेव विपुलौ बाहू स एवास्मि जनार्दन। तथापि युध्यसे वीर ज्ञात्वा त्वं मामकं बलम्॥१५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 306,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "विचक्रवधः",
      "combined_translation": "15-15"
    },
    {
      "verse": 16,
      "sanskrit": "वारयैनं महाबाहो परिघं बाहुनिःसृतम्। इत्युक्त्वा देवदेवेशं शङ्खचक्रगदाधरम्। चिक्षेप दैत्यो लोकेशं सर्वलोकस्य पश्यतः॥१६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 306,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "विचक्रवधः",
      "combined_translation": "16-16"
    },
    {
      "verse": 17,
      "sanskrit": "तं गृह्य बाहुना कृष्णो हतोऽसीति वदन्हरिः। खण्डशः कारयामास खड्गेन निशितेन ह॥१७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 306,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "विचक्रवधः",
      "combined_translation": "17-17"
    },
    {
      "verse": 18,
      "sanskrit": "उत्पाट्य वृक्षं दैत्येशः शतशाखं महाशिखम्। तेन सम्पोथयामास विष्टरश्रवसं विभुम्॥१८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 306,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "विचक्रवधः",
      "combined_translation": "18-18"
    },
    {
      "verse": 19,
      "sanskrit": "छित्त्वा तं चापि खड्गेन तिलशश्च चकार ह। विक्रीड्य सुचिरं विष्णुस्तेन दैत्येन माधवः॥१९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 306,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "विचक्रवधः"
    },
    {
      "verse": 20,
      "sanskrit": "हन्तुमैच्छत्तदा दैत्यमादाय निशितं शरम्। आग्नेयास्त्रेण संयोज्य जघानैनं महान् हरिः॥२०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 306,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "विचक्रवधः",
      "combined_translation": "20-20"
    },
    {
      "verse": 21,
      "sanskrit": "सन्दह्य स शरो दैत्यं सर्वलोकस्य पश्यतः। यथापूर्वं जगामाशु करं भगवतः पुनः॥२१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 306,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "विचक्रवधः",
      "combined_translation": "21-21"
    },
    {
      "verse": 22,
      "sanskrit": "हतशिष्टास्ततो दैत्याः पलायन्तो दिशो दश। अद्यापि न निवर्तन्ते गच्छन्तो वै महोदधिम्॥२२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 306,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "विचक्रवधः",
      "combined_translation": "22-22"
    }
  ]
}