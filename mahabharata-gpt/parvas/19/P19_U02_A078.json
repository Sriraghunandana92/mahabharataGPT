{
  "adhyaya_id": "P19_U02_A078",
  "book": 19,
  "parva_name": "हरिवंशः",
  "upaparva_name": "विष्णुपर्व",
  "adhyaya_name": "पुण्यकव्रतवर्णनम्-०७८",
  "chapter": 133,
  "verse_count": 35,
  "verses": [
    {
      "verse": 1,
      "sanskrit": "उमोवाच।\n              सर्वज्ञाहं यदा भर्तुः प्रसादेन शुचिस्मिते। तदा पुरा ममादिष्टो दृष्टः पुण्यविधिः शुभः॥१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 133,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पुण्यकव्रतवर्णनम्-०७८"
    },
    {
      "verse": 2,
      "sanskrit": "सनातनः पुण्यविधिरिति बुद्ध्यावगम्यताम्। महादेवप्रसादेन मया दृष्टस्त्वरुन्धति॥२॥",
      "english": null,
      "bhavadeepa": "अथाष्टसप्ततितमेऽध्यायेऽस्मिन्प्राह पार्वती। अरुन्धत्यै स्ववक्त्रेण प्रागुक्तमपि विस्तरात्॥१॥ सर्वज्ञेति। आदिष्टो उपदिष्टो भर्त्रेत्यर्थात् दृष्टो ज्ञातश्च॥१॥",
      "chapter": 133,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पुण्यकव्रतवर्णनम्-०७८",
      "combined_translation": "2-2"
    },
    {
      "verse": 3,
      "sanskrit": "पुण्यकानि च सर्वाणि चीर्णवत्यस्म्यनिन्दिते। अनुज्ञया भगवतो भर्तुः शर्वस्य धीमतः॥३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 133,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पुण्यकव्रतवर्णनम्-०७८",
      "combined_translation": "3-3"
    },
    {
      "verse": 4,
      "sanskrit": "सतीत्वं धर्मचरणं यस्या नित्यमखण्डितम्। पुण्यकानां विधिस्तस्याः पुराणैः परिकीर्तितः॥४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 133,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पुण्यकव्रतवर्णनम्-०७८",
      "combined_translation": "4-4"
    },
    {
      "verse": 5,
      "sanskrit": "दानोपवासपुण्यानि सुकृतान्यप्यरुन्धति। निष्फलान्यसतीनां हि पुण्यकानि तथा शुभे॥५॥",
      "english": null,
      "bhavadeepa": "अखण्डितम् ईप्सितं भवेत्॥४॥",
      "chapter": 133,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पुण्यकव्रतवर्णनम्-०७८",
      "combined_translation": "5-5"
    },
    {
      "verse": 6,
      "sanskrit": "या वञ्चयन्ति भर्तारं योनिदुष्टाश्च याः स्त्रियः। योनिदोषात्पुण्यफलं नाश्नन्ति निरयङ्गमाः॥६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 133,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पुण्यकव्रतवर्णनम्-०७८",
      "combined_translation": "6-6"
    },
    {
      "verse": 7,
      "sanskrit": "साध्व्यो जगद्धारयन्ति सुशीलाः पतिदेवताः। अनन्या धर्मनित्याश्च सतीपन्थानमाश्रिताः॥७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 133,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पुण्यकव्रतवर्णनम्-०७८",
      "combined_translation": "7-7"
    },
    {
      "verse": 8,
      "sanskrit": "अवाग्दुष्टाः शौचयुक्ता धृतिमत्यः शुभव्रताः। सततं साधुवादिन्यो धारयन्ति जगत्खलु॥८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 133,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पुण्यकव्रतवर्णनम्-०७८",
      "combined_translation": "8-8"
    },
    {
      "verse": 9,
      "sanskrit": "व्याधितः पतितो वापि दीनो वापि कथञ्चन। न त्यक्तव्यः स्त्रिया भर्ता धर्म एष सनातनः॥९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 133,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पुण्यकव्रतवर्णनम्-०७८",
      "combined_translation": "9-9"
    },
    {
      "verse": 10,
      "sanskrit": "अकार्यकारिणं वापि पतितं वापि निर्गुणम्। स्त्री पतिं तारयत्येव तथाऽऽत्मानं शुभानने॥१०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 133,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पुण्यकव्रतवर्णनम्-०७८",
      "combined_translation": "10-10"
    },
    {
      "verse": 11,
      "sanskrit": "योनिदुष्टस्त्रियो नास्ति प्रायश्चित्तं हतैव सा। वाग्दुष्टे विहितं सद्भिः प्रायश्चित्तं पुरातने॥११॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 133,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पुण्यकव्रतवर्णनम्-०७८",
      "combined_translation": "11-11"
    },
    {
      "verse": 12,
      "sanskrit": "भर्तुश्छन्देन कर्तव्यं व्रतकं सर्वदा स्त्रिया। उपवासोऽपि वा सत्ये काङ्क्षन्त्या सुकृतां गतिम्॥१२॥",
      "english": null,
      "bhavadeepa": "पुरातने वेदे॥११॥",
      "chapter": 133,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पुण्यकव्रतवर्णनम्-०७८",
      "combined_translation": "12-12"
    },
    {
      "verse": 13,
      "sanskrit": "कल्पान्तरसहस्रेषु न स्त्री सा लभते गतिम्। तिर्यग्योनिसहस्रेषु पच्यते योनिविप्लवात्॥१३॥",
      "english": null,
      "bhavadeepa": "हे सत्ये अरुन्धति॥१२॥",
      "chapter": 133,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पुण्यकव्रतवर्णनम्-०७८",
      "combined_translation": "13-13"
    },
    {
      "verse": 14,
      "sanskrit": "यदि सा नाम मानुष्यं स्त्री लभेदसती सती। चण्डालयोनौ दुर्मेधा जायते कुक्कुराशना॥१४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 133,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पुण्यकव्रतवर्णनम्-०७८",
      "combined_translation": "14-14"
    },
    {
      "verse": 15,
      "sanskrit": "भर्ता देवः सदा स्त्रीणां सद्भिर्दृष्टस्तपोधने। यस्या हि तुष्यते भर्ता सा सती धर्मचारिणी॥१५॥",
      "english": null,
      "bhavadeepa": "असती भूत्वा सती विद्यमाना॥१४॥",
      "chapter": 133,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पुण्यकव्रतवर्णनम्-०७८",
      "combined_translation": "15-15"
    },
    {
      "verse": 16,
      "sanskrit": "कौतूहलहतानां तु स्त्रीणां लोको न शोभनः। भर्तर्येव मनो यासां सद्भावेन व्यवस्थीतम्॥१६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 133,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पुण्यकव्रतवर्णनम्-०७८",
      "combined_translation": "16-16"
    },
    {
      "verse": 17,
      "sanskrit": "कर्मणा मनसा वचा पतिं नातिचरन्ति याः। तासां पुण्यफलं सौम्ये पुण्यकैः समुदाहृतम्॥१७॥",
      "english": null,
      "bhavadeepa": "कौतूहलम् आश्चर्यं प्रोक्तम्॥१६॥",
      "chapter": 133,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पुण्यकव्रतवर्णनम्-०७८",
      "combined_translation": "17-17"
    },
    {
      "verse": 18,
      "sanskrit": "पुण्यकानां विधिं कृत्स्नं स्वर्लोकप्रतिशोभने। निबोध सह सर्वाभिर्दृष्टो यस्तपसा मया॥१८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 133,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पुण्यकव्रतवर्णनम्-०७८",
      "combined_translation": "18-18"
    },
    {
      "verse": 19,
      "sanskrit": "स्नात्वा स्त्री प्रातरुत्थाय पतिं विज्ञापयेत्सती। उपवासार्थमथ वा व्रतकार्थं दृतव्रते॥१९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 133,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पुण्यकव्रतवर्णनम्-०७८",
      "combined_translation": "19-19"
    },
    {
      "verse": 20,
      "sanskrit": "श्वशुराभ्यां च चरणौ सततं सत्तमस्य च। ग्रहायौदुम्बरं पात्रं सकुशं साक्षतं तथा॥२०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 133,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पुण्यकव्रतवर्णनम्-०७८",
      "combined_translation": "20-20"
    },
    {
      "verse": 21,
      "sanskrit": "गोशृङ्गं दक्षिणं सिच्य प्रतिगृह्णीत तज्जलम्। ततो भर्तुः सती दद्यात्स्नातस्य प्रयतस्य च॥२१॥",
      "english": null,
      "bhavadeepa": "औदुम्बरं ताम्रमयम्॥२०॥",
      "chapter": 133,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पुण्यकव्रतवर्णनम्-०७८",
      "combined_translation": "21-21"
    },
    {
      "verse": 22,
      "sanskrit": "आत्मनोऽपि निषेक्तव्यं ततः शिरसि तज्जलम्। त्रैलोक्यसर्वतीर्थेषु स्नानमेतदुदाहृतम्॥२२॥",
      "english": null,
      "bhavadeepa": "सिच्य सिक्त्व॥२१॥",
      "chapter": 133,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पुण्यकव्रतवर्णनम्-०७८",
      "combined_translation": "22-22"
    },
    {
      "verse": 23,
      "sanskrit": "उपवासेषु कर्तव्यमेतद्धि व्रतकेषु च। स्नानमेतद्धि सामान्यं स्त्रीणां पुंसां च भामिनि॥२३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 133,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पुण्यकव्रतवर्णनम्-०७८",
      "combined_translation": "23-23"
    },
    {
      "verse": 24,
      "sanskrit": "अरुन्धति मया दृष्टं तपसा हरतेजसा। अशल्यविद्धं शयनमासनं च तथाविधम्॥२४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 133,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पुण्यकव्रतवर्णनम्-०७८",
      "combined_translation": "24-24"
    },
    {
      "verse": 25,
      "sanskrit": "स्वयं प्रक्षालनं चापि पादयोरनुशब्दितम्। अश्रुप्रपातो रोषश्च कलहश्च कृतः सति। उपवासाद्व्रताद्वापि सद्यो भ्रंशयति स्त्रियः॥२५॥",
      "english": null,
      "bhavadeepa": "व्रताङ्गनियमानाह- अशल्येत्यादिना॥२४॥",
      "chapter": 133,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पुण्यकव्रतवर्णनम्-०७८",
      "combined_translation": "25-25"
    },
    {
      "verse": 26,
      "sanskrit": "शुक्लमेव सदा वासः प्रशस्तं चन्द्रसम्भवे। अन्तर्वासोऽपरं चैव उपवासे व्रते तथा॥२६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 133,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पुण्यकव्रतवर्णनम्-०७८",
      "combined_translation": "26-26"
    },
    {
      "verse": 27,
      "sanskrit": "पादुकार्थं तृणैः कार्यं सर्वदा व्रतके सति। उपवासेऽपि च विधिरेष एव प्रवर्तितः॥२७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 133,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पुण्यकव्रतवर्णनम्-०७८",
      "english_ref": 1,
      "combined_translation": "1-27"
    },
    {
      "verse": 28,
      "sanskrit": "अञ्जनं रोचनं चापि गन्धान्सुमनसस्तथा। व्रतके चोपवासे च नित्यमेव विवर्जयेत्॥२८॥",
      "english": null,
      "bhavadeepa": "पादुकार्थं तृणैर्वैत्रादिभिः पादत्राणं कर्तव्यं न तु चर्ममयमित्यर्थः॥२७॥",
      "chapter": 133,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पुण्यकव्रतवर्णनम्-०७८",
      "english_ref": 10,
      "combined_translation": "10-28"
    },
    {
      "verse": 29,
      "sanskrit": "दन्तकाष्ठं शिरःस्नानमुद्वर्तनमथापि वा। विवर्जितं मृदा सर्वं शौचार्थं तु विधीयते॥२९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 133,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पुण्यकव्रतवर्णनम्-०७८"
    },
    {
      "verse": 30,
      "sanskrit": "बिल्वामृतफलैर्नित्यं श्रीफलैश्च समाचरेत्। प्रक्षालनं वै शिरसः सदा मृण्मिश्रितैर्जलैः॥३०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 133,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पुण्यकव्रतवर्णनम्-०७८"
    },
