{
  "adhyaya_id": "P19_U03_A113",
  "book": 19,
  "parva_name": "हरिवंशः",
  "upaparva_name": "भविष्यपर्व",
  "adhyaya_name": "हंसडिम्भकयोर्दूतप्रेषणम्",
  "chapter": 296,
  "verse_count": 28,
  "verses": [
    {
      "verse": 1,
      "sanskrit": "वैशम्पायन उवाच।\n              दुर्वासास्त्वथ तत्रैव नारदेन महात्मना। चिन्तयन्ब्रह्मणस्तत्त्वं विजहार यथासुखम्॥१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 296,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हंसडिम्भकयोर्दूतप्रेषणम्",
      "combined_translation": "1-25"
    },
    {
      "verse": 2,
      "sanskrit": "भगवानपि गोविन्दस्तयोर्वासममन्यत। ततस्तौ हंसडिम्भकौ तस्मिन्काले महीपतिम्॥२॥",
      "english": null,
      "bhavadeepa": "दुर्वास इति॥१॥",
      "chapter": 296,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हंसडिम्भकयोर्दूतप्रेषणम्",
      "combined_translation": "2-2"
    },
    {
      "verse": 3,
      "sanskrit": "ब्रह्मदत्तं महीपालं पितरं वीर्यशालिनम्। प्रावोचतामिदं वाक्यं समन्ताज्जनसंसदि॥३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 296,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हंसडिम्भकयोर्दूतप्रेषणम्"
    },
    {
      "verse": 4,
      "sanskrit": "राजसूयं महायज्ञं पितः कुरु सुयत्नतः। अस्मिन्मासि नृपश्रेष्ठ यतावो यज्ञसिद्धये॥४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 296,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हंसडिम्भकयोर्दूतप्रेषणम्",
      "combined_translation": "4-4"
    },
    {
      "verse": 5,
      "sanskrit": "आवां तेऽद्य महाराज दिशां विजयतत्परौ। यतिष्यावो बलैः सार्धं गजैरश्वै रथैरपि॥५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 296,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हंसडिम्भकयोर्दूतप्रेषणम्",
      "combined_translation": "5-5"
    },
    {
      "verse": 6,
      "sanskrit": "सम्भारा यज्ञसिद्ध्यर्थमानेतव्या नृपोत्तम। तथेति स महाबाहो ब्रह्मदत्तोऽब्रवीत्तदा॥६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 296,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हंसडिम्भकयोर्दूतप्रेषणम्",
      "combined_translation": "6-6"
    },
    {
      "verse": 7,
      "sanskrit": "जनार्दनस्तु विप्रेन्द्रो दृष्ट्वा साहसतत्परौ। अशक्यमिति मन्वानो वयस्यं हंसमब्रवीत्॥७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 296,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हंसडिम्भकयोर्दूतप्रेषणम्",
      "combined_translation": "7-7"
    },
    {
      "verse": 8,
      "sanskrit": "शृणु हंस वचो मह्यं श्रुत्वा निश्चित्य वीर्यवान्। आयुष्मान्साहसं कर्तुमुद्यतोऽसि नृपोत्तम॥८॥",
      "english": null,
      "bhavadeepa": "जनार्दनः ऋषिपुत्रः॥७॥",
      "chapter": 296,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हंसडिम्भकयोर्दूतप्रेषणम्",
      "combined_translation": "8-8"
    },
    {
      "verse": 9,
      "sanskrit": "स्थिते भीष्मे जरासन्धे बाह्लिके च नृपोत्तमे। किं च वीरेषु सर्वेषु यादवेषु नृपोत्तम॥९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 296,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हंसडिम्भकयोर्दूतप्रेषणम्",
      "combined_translation": "9-9"
    },
    {
      "verse": 10,
      "sanskrit": "भीष्मो हि बलवान्वृद्धः सत्यसन्धो जितेन्द्रियः। त्रिःसप्तकृत्वः पृथिवीं यो जिगाय भृगूत्तमः॥१०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 296,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हंसडिम्भकयोर्दूतप्रेषणम्",
      "combined_translation": "10-10"
    },
    {
      "verse": 11,
      "sanskrit": "तं युद्धे जितवान्भीष्मः सर्वक्षत्रस्य पश्यतः। जरासन्धस्य यद्वीर्यं तद्भवान्वेत्ति संयुगे॥११॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 296,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हंसडिम्भकयोर्दूतप्रेषणम्",
      "combined_translation": "11-11"
    },
    {
      "verse": 12,
      "sanskrit": "वृष्णिवीरास्तु ते सर्वे कृतास्त्रा युद्धदुर्मदाः। तत्र कृष्णो हृषीकेशो जितशत्रुः कृती सदा॥१२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 296,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हंसडिम्भकयोर्दूतप्रेषणम्",
      "combined_translation": "12-12"
    },
    {
      "verse": 13,
      "sanskrit": "जरासन्धेन सहितः सदा युद्धे जितश्रमः। प्रमुखे तस्य न स्थातुं शक्तो जीवन्नृपोत्तमः॥१३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 296,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हंसडिम्भकयोर्दूतप्रेषणम्",
      "combined_translation": "13-13"
    },
    {
      "verse": 14,
      "sanskrit": "बलभद्रस्तथा मत्तः क्रुद्धो यदि भवेद्बली। लोकानिमान्समाहर्तुं शक्नोतीति मतिर्मम॥१४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 296,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हंसडिम्भकयोर्दूतप्रेषणम्",
      "combined_translation": "14-14"
    },
    {
      "verse": 15,
      "sanskrit": "तथा च सात्यकिर्वीरः शक्तो जेतुं रणे रिपून्। तथान्ये यादवाः सर्वे कृष्णमाश्रित्य दंशितः॥१५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 296,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हंसडिम्भकयोर्दूतप्रेषणम्",
      "combined_translation": "15-15"
    },
    {
      "verse": 16,
      "sanskrit": "अस्माभिश्च कृतः पूर्वं विरोधो यतिभिः सह। दुर्वासा यतिभिः सार्धं गतो द्रष्टुं स केशवम्॥१६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 296,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हंसडिम्भकयोर्दूतप्रेषणम्",
      "combined_translation": "16-16"
    },
    {
      "verse": 17,
      "sanskrit": "इति श्रुतं नृपश्रेष्ठ ब्राह्मणाद्भोक्तुमागतात्। तथा सति यथा सिद्ध्येत्तथा चिन्त्यं च मन्त्रिभिः॥१७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 296,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हंसडिम्भकयोर्दूतप्रेषणम्",
      "combined_translation": "17-17"
    },
    {
      "verse": 18,
      "sanskrit": "ततः पश्चाद्विधास्यामो राजसूयं महाक्रतुम्।\n              हंस उवाच।\n              को नाम भीष्मो मन्दात्मा वृद्धो हीनबलः सदा॥१८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 296,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हंसडिम्भकयोर्दूतप्रेषणम्",
      "combined_translation": "18-18"
    },
    {
      "verse": 19,
      "sanskrit": "आवयोः पुरतः स्थातुं शक्तः स किल वृद्धकः। यादवा इति चित्रं नः शक्ताः स्थातुं रणे द्विज॥१९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 296,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हंसडिम्भकयोर्दूतप्रेषणम्",
      "combined_translation": "19-19"
    },
    {
      "verse": 20,
      "sanskrit": "कश्च कृष्णः पुरः स्थातुं बलदेवश्च मत्तकः। शैनेयश्चापि विप्रेन्द्र स्थातुं न इति चिन्तय॥२०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 296,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हंसडिम्भकयोर्दूतप्रेषणम्",
      "combined_translation": "20-20"
    },
    {
      "verse": 21,
      "sanskrit": "जरासन्धस्तु धर्मात्मा बन्धुरेव सदा मम। गच्छ विप्र यदुश्रेष्ठं ब्रूहि मद्वचनात्त्वरन्॥२१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 296,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हंसडिम्भकयोर्दूतप्रेषणम्",
      "combined_translation": "21-21"
    },
    {
      "verse": 22,
      "sanskrit": "दीयतां करसर्वस्वं यज्ञार्थं सुन्दरं बहु। लवणानि बहून्यद्य गृह्य केशव मा चिरम्॥२२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 296,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हंसडिम्भकयोर्दूतप्रेषणम्",
      "combined_translation": "22-22"
    },
    {
      "verse": 23,
      "sanskrit": "आगच्छ त्वरितं कृष्ण न ते कार्यं विलम्बनम्। इति ब्रूहि यदुश्रेष्ठं याहि त्वरितविक्रमः॥२३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 296,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हंसडिम्भकयोर्दूतप्रेषणम्",
      "combined_translation": "23-23"
    },
    {
      "verse": 24,
      "sanskrit": "न ब्रूयाश्चोत्तरं विप्र शपेयं त्वां प्रियोऽसि मे। मित्रभावादिदं ब्रूहि पश्यामि त्वां पुनः पुनः॥२४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 296,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हंसडिम्भकयोर्दूतप्रेषणम्",
      "combined_translation": "24-24"
    },
    {
      "verse": 25,
      "sanskrit": "इति सञ्चोदितो विप्रो नोत्तरं प्रत्यभाषत। मित्रभावात्तथा राजन्स्नेहाच्च जनमेजय॥२५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 296,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हंसडिम्भकयोर्दूतप्रेषणम्",
      "combined_translation": "25-25"
    },
    {
      "verse": 26,
      "sanskrit": "जनार्दनस्तु धर्मात्मा नित्यं गन्तुं समुद्यतः। अद्य श्वो वा परश्वो वा गच्छामीति यतेत सः॥२६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 296,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हंसडिम्भकयोर्दूतप्रेषणम्",
      "combined_translation": "26-26"
    },
    {
      "verse": 27,
      "sanskrit": "देवं द्रष्टुं जगद्योनिं शङ्खचक्रगदाधरम्। एक एव च धर्मात्मा हयमारुह्य सत्वरम्॥२७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 296,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हंसडिम्भकयोर्दूतप्रेषणम्",
      "combined_translation": "27-27"
    },
    {
      "verse": 28,
      "sanskrit": "प्रातरेव जगामाशु द्रष्टुं द्वारवतीं द्विजः। हरिं कृष्णं हृषीकेशं मनसा संस्मरन्द्विजः॥२८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 296,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हंसडिम्भकयोर्दूतप्रेषणम्",
      "combined_translation": "28-28"
    }
  ]
}