  "verses": [
    {
      "verse": 1,
      "sanskrit": "वैशम्पायन उवाच।\n              अथ भीतो महारौद्रमस्त्रं दृष्ट्वा नृपोत्तम। हंसो राजा महाराज निश्चेष्ट इव सम्बभौ॥१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 311,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हंसवधः",
      "combined_translation": "1-50"
    },
    {
      "verse": 2,
      "sanskrit": "उत्प्लुत्य स रथात्तस्माद्यमुनामभ्यधावत। यत्र कृष्णो हृषीकेशः कालियाहिं ममर्द ह॥२॥",
      "english": null,
      "bhavadeepa": "अथेति॥१॥",
      "chapter": 311,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हंसवधः",
      "combined_translation": "2-2"
    },
    {
      "verse": 3,
      "sanskrit": "महाह्रदं महारौद्रं यावत्पातालसंस्थितम्। तावद्दीर्घं महानीलं कालाञ्जननिभं हि यत्॥३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 311,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हंसवधः",
      "combined_translation": "3-3"
    },
    {
      "verse": 4,
      "sanskrit": "तस्मिन्ह्रदे महाघोरे पपाताथ स हंसकः। हंसे पतति तस्मिंस्तु महान्रावो बभूव ह॥४॥",
      "english": null,
      "bhavadeepa": "ह्रदमिति। क्लीबत्वमार्षम्॥३॥",
      "chapter": 311,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हंसवधः",
      "combined_translation": "4-4"
    },
    {
      "verse": 5,
      "sanskrit": "गिरीणां पात्यमानानां समुद्र इव वज्रिणा। रथादुत्प्लुत्य कृष्णोऽपि तस्योपरि पपात ह॥५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 311,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हंसवधः",
      "combined_translation": "5-5"
    },
    {
      "verse": 6,
      "sanskrit": "देवदेवो जगन्नाथो जगद्विस्मापयन्निव। प्राहरत्तं महाबाहुः पादाभ्यमथ केशवः॥६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 311,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हंसवधः",
      "combined_translation": "6-6"
    },
    {
      "verse": 7,
      "sanskrit": "पादक्षेपं नृपस्तस्माल्लब्ध्वा हंसो नृपोत्तम। ममार च नृपश्रेष्ठ केचिदेवं वदन्ति हि॥७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 311,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हंसवधः",
      "combined_translation": "7-7"
    },
    {
      "verse": 8,
      "sanskrit": "अन्ये पातालमायातो भक्षितः पन्नगैरिति। अद्यापि नैव राजेन्द्र दृष्ट इत्यनुशुश्रुम॥८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 311,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हंसवधः",
      "combined_translation": "8-8"
    },
    {
      "verse": 9,
      "sanskrit": "यथापूर्वं जगन्नाथो रथं समुपजग्मिवान्। हते तस्मिन्महाराज धर्मपुत्रो युधिष्ठिरः॥९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 311,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हंसवधः",
      "combined_translation": "9-9"
    },
    {
      "verse": 10,
      "sanskrit": "अकरोद्राजसूयं च तव पूर्वपितामहः। यदि जीवेदसौ हंसः को नमस्यति तं क्रतुम्॥१०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 311,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हंसवधः",
      "combined_translation": "10-10"
    },
    {
      "verse": 11,
      "sanskrit": "स च सर्वास्त्रविन्नित्यं रुद्राल्लब्धवरः प्रभो। क्षणादेव महाराज वार्तेयं गामगाहत॥११॥",
      "english": null,
      "bhavadeepa": "को नमस्यति कः पूजयेन्न कोऽपीत्यर्थः॥१०॥",
      "chapter": 311,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हंसवधः",
      "combined_translation": "11-11"
    },
    {
      "verse": 12,
      "sanskrit": "हतो हंसो हतो हंसः कृष्णेन रिपुमर्दिना। जगुर्गन्धर्वपतयो देवलोके दिवानिशम्॥१२॥",
      "english": null,
      "bhavadeepa": "इयं वार्ता हंसमरणकथा गां पृथ्वीम् अगाहत आक्रान्तवती॥११॥",
      "chapter": 311,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हंसवधः",
      "combined_translation": "12-12"
    },
    {
      "verse": 13,
      "sanskrit": "कृष्णेन लोकनाथेन विष्णुना प्रभविष्णुना। यमुनाया ह्रदे घोरे हंसो निहत इत्यपि॥१३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 311,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हंसवधः",
      "combined_translation": "13-13"
    }
  ]
}