{
  "adhyaya_id": "P19_U02_A080",
  "book": 19,
  "parva_name": "हरिवंशः",
  "upaparva_name": "विष्णुपर्व",
  "adhyaya_name": "अङ्गनिर्वेशहेतूनि व्रतानि-०८०",
  "chapter": 135,
  "verse_count": 52,
  "verses": [
    {
      "verse": 1,
      "sanskrit": "भगवत्युवाच।\n              निर्वेष्टव्यं शरीरं यैर्व्रतकैः पुण्यकैरपि। अरुन्धति प्रवक्ष्यामि सहैताभिर्वरेण तु॥१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 135,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "अङ्गनिर्वेशहेतूनि व्रतानि-०८०"
    },
    {
      "verse": 2,
      "sanskrit": "कृष्णाष्टमीं या क्षिपति स्याद्वा मूलफलाशिनी। ब्राह्मनायैकमशनं स्वं दत्त्वा भर्तृदेवता॥२॥",
      "english": null,
      "bhavadeepa": "अथाशीतितमेऽध्यायेऽस्मिन्प्रोक्तानि कामतः। अङ्गनिर्वेशहेतूनि व्रतकानि शुभान्यलम्॥१॥ निर्वेष्टव्यमिति। परसुखप्राप्तियोग्यं कर्तव्यम्॥१॥",
      "chapter": 135,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "अङ्गनिर्वेशहेतूनि व्रतानि-०८०",
      "combined_translation": "2-2"
    },
    {
      "verse": 3,
      "sanskrit": "शुक्लवस्त्रा शुभाचारा गुरुदैवतपूजका। एवं संवत्सरं कृत्वा ततो दद्याद्द्विजातये॥३॥",
      "english": null,
      "bhavadeepa": "क्षिपति उपोषणेन नयति॥२॥",
      "chapter": 135,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "अङ्गनिर्वेशहेतूनि व्रतानि-०८०",
      "combined_translation": "3-3"
    },
    {
      "verse": 4,
      "sanskrit": "गोवालरज्जुसुकृतं चामरं च ध्वजं तथा। दक्षिणापूर्णमिष्टान्नं शक्त्या वापि शुचिव्रते॥४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 135,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "अङ्गनिर्वेशहेतूनि व्रतानि-०८०",
      "combined_translation": "4-4"
    },
    {
      "verse": 5,
      "sanskrit": "ऊर्मिमन्तः स्वरालाग्राः श्रोणिदेशावलम्बिनः। तस्या भवन्ति केशास्तु भक्तिमत्या हि भर्तरि॥५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 135,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "अङ्गनिर्वेशहेतूनि व्रतानि-०८०",
      "combined_translation": "5-5"
    },
    {
      "verse": 6,
      "sanskrit": "शिरो निर्वेष्टुकामा तु गोमयेन शिरः सती। प्रक्षालयेन्मलं धात्र्या बिल्वेन श्रीफलेन च॥६॥",
      "english": null,
      "bhavadeepa": "ऊर्मिमन्तः सर्पसर्पणतुल्याः। स्वरालाग्राः सुतरां कुटिलाग्राः॥५॥",
      "chapter": 135,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "अङ्गनिर्वेशहेतूनि व्रतानि-०८०",
      "combined_translation": "6-6"
    },
    {
      "verse": 7,
      "sanskrit": "गोमूत्रं च सदा प्राश्येच्छिरःस्नानं च मिश्रयेत्। कृष्णां चतुर्दशीं त्वेतत्कर्तव्यं वरवर्णिनि॥७॥",
      "english": null,
      "bhavadeepa": "धात्र्या आमलक्या बिल्वेन श्रीफलेन समं कृत्वा तेन शिरः प्रक्षालयेत्॥६॥",
      "chapter": 135,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "अङ्गनिर्वेशहेतूनि व्रतानि-०८०",
      "combined_translation": "7-7"
    },
    {
      "verse": 8,
      "sanskrit": "भवत्यविधवा चैव सुभगा विज्वरा तथा। शिरोरोगैर्नैव चास्याः शरीरमभितप्यते॥८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 135,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "अङ्गनिर्वेशहेतूनि व्रतानि-०८०",
      "combined_translation": "8-8"
    },
    {
      "verse": 9,
      "sanskrit": "दर्शनीयं ललाटं या काङ्क्षति स्त्री शुचिस्मिते। तिथिं प्रतिपदं नित्यं सा क्षिपेदेकभोजना॥९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 135,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "अङ्गनिर्वेशहेतूनि व्रतानि-०८०",
      "combined_translation": "9-9"
    },
    {
      "verse": 10,
      "sanskrit": "पयसा च तथाश्नीयाद्यावत्संवत्सरो गतः। ब्राह्मणाय ततो दद्यात्पटं रूप्यमयं शुभम्॥१०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 135,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "अङ्गनिर्वेशहेतूनि व्रतानि-०८०",
      "combined_translation": "10-10"
    },
    {
      "verse": 11,
      "sanskrit": "ललाटं रूपसम्पन्नमाप्नोति स्त्री सुमध्यमा। सततं स्त्री द्वितीयायां भ्रुवोरिच्छेत्सुरूपताम्॥११॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 135,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "अङ्गनिर्वेशहेतूनि व्रतानि-०८०",
      "combined_translation": "11-11"
    },
    {
      "verse": 12,
      "sanskrit": "अनन्तरोपवासेन शाकभक्ताशना सती। ततः संवत्सरे पूर्णे ब्राह्मणं स्वस्ति वाचयेत्॥१२॥",
      "english": null,
      "bhavadeepa": "पयसा सहाश्नीयादोदनं पटं स्त्रीभिः शिरोदेशे बन्धनीयं रूप्यमयं स्वर्णमयम्॥११॥",
      "chapter": 135,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "अङ्गनिर्वेशहेतूनि व्रतानि-०८०",
      "combined_translation": "12-12"
    },
    {
      "verse": 13,
      "sanskrit": "फलैः परिणतैः सौम्यैर्माषाणां दक्षिणान्वितैः। लवणेन च भद्रं ते घृतपात्रेण चानघे॥१३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 135,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "अङ्गनिर्वेशहेतूनि व्रतानि-०८०",
      "combined_translation": "13-13"
    },
    {
      "verse": 14,
      "sanskrit": "आत्मनः शोभनौ कर्णाविच्छती स्त्री सुमध्यमा। नक्षत्रे श्रवणे प्राप्ते ध्रुवं भुञ्जीत यावकम्॥१४॥",
      "english": null,
      "bhavadeepa": "माषाणां सुवर्णमाषाणाम्॥१३॥",
      "chapter": 135,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "अङ्गनिर्वेशहेतूनि व्रतानि-०८०",
      "combined_translation": "14-14"
    },
    {
      "verse": 15,
      "sanskrit": "ततः संवत्सरे पूर्णे कर्णौ दद्याद्धिरण्मयौ। घृते प्रक्षिप्य विप्राय पयसा सहिते शुभे॥१५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 135,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "अङ्गनिर्वेशहेतूनि व्रतानि-०८०",
      "combined_translation": "15-15"
    },
    {
      "verse": 16,
      "sanskrit": "नासामिच्छेल्ललाटान्तामव्यङ्गां व्याधिवर्जिताम्। तिलगुल्मं सदा सिञ्चेद्यावत्पुष्पेद्धि रक्षितः॥१६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 135,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "अङ्गनिर्वेशहेतूनि व्रतानि-०८०",
      "combined_translation": "16-16"
    },
    {
      "verse": 17,
      "sanskrit": "अनन्तरोपवासेन सेक्तव्यः सलिलैः सदा। तस्मादवाप्य पुष्पाणि घृते प्रक्षिप्य दापयेत्॥१७॥",
      "english": null,
      "bhavadeepa": "तिलगुल्मं तिलस्तोमम्। अनन्तरेत्यव्यवहितपूर्वदिने उपोष्येत्यर्थः। एवं यावद्धान्योत्पत्तिः कर्तव्यम्॥१६॥",
      "chapter": 135,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "अङ्गनिर्वेशहेतूनि व्रतानि-०८०",
      "combined_translation": "17-17"
    },
    {
      "verse": 18,
      "sanskrit": "स्वक्षीभवेयमिति या स्त्री काङ्क्षत्यमृतोद्भवे। अनन्तरं वै भुञ्जाना पयसाथ घृतेन वा॥१८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 135,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "अङ्गनिर्वेशहेतूनि व्रतानि-०८०",
      "combined_translation": "18-18"
    },
    {
      "verse": 19,
      "sanskrit": "ततः संवत्सरे पूर्णे पद्मपत्राणि मण्डिता। तथैवोत्पलपत्राणि न्यसेत्क्षीरे शुचिस्मिते॥१९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 135,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "अङ्गनिर्वेशहेतूनि व्रतानि-०८०",
      "combined_translation": "19-19"
    },
    {
      "verse": 20,
      "sanskrit": "प्लवमानानि विप्राय ततो दद्यात्सती सति। कृष्णसारसमानाक्षी तद्दत्त्वा भवति स्म वै॥२०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 135,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "अङ्गनिर्वेशहेतूनि व्रतानि-०८०",
      "combined_translation": "20-20"
    },
    {
      "verse": 21,
      "sanskrit": "इच्छेदोष्ठौ चारुरूपौ या स्त्री धर्मगुणान्विता। सा मृन्मयेन तु पिबेदुदकं वत्सरं सती॥२१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 135,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "अङ्गनिर्वेशहेतूनि व्रतानि-०८०",
      "combined_translation": "21-21"
    },
    {
      "verse": 22,
      "sanskrit": "अयाचितेन भुञ्जीत नवम्यां धर्मभागिनी। ततः संवत्सरे पूर्णे विद्रुमं दातुमर्हति॥२२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 135,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "अङ्गनिर्वेशहेतूनि व्रतानि-०८०",
      "combined_translation": "22-22"
    },
    {
      "verse": 23,
      "sanskrit": "तेन बिम्बफलाभौष्ठी स्त्री भवेत्येव शोभने। सुभगाथ वपुःपुत्रधनाढ्या गोमती तथा॥२३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 135,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "अङ्गनिर्वेशहेतूनि व्रतानि-०८०",
      "combined_translation": "23-23"
    },
    {
      "verse": 24,
      "sanskrit": "या चारुरूपानिच्छेत दन्तानमरवर्णिनि। शुक्लाष्टमीं न साश्नीयाद्भक्तद्वयमनिन्दिता॥२४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 135,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "अङ्गनिर्वेशहेतूनि व्रतानि-०८०",
      "combined_translation": "24-24"
    },
    {
      "verse": 25,
      "sanskrit": "ततः संवत्सरे पूर्णे दद्याद्रौप्यमयान्सती। दन्तान्प्रक्षिप्य धर्मज्ञे पयस्यतिगुणोदिते॥२५॥",
      "english": null,
      "bhavadeepa": "भक्तद्वयमपि नाश्नीयादुपवसेदित्यर्थः॥२४॥",
      "chapter": 135,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "अङ्गनिर्वेशहेतूनि व्रतानि-०८०",
      "combined_translation": "25-25"
    },
    {
      "verse": 26,
      "sanskrit": "तेन सा जातिपुष्पाभान्दन्तान्प्राप्नोति सा सती। सौभाग्यमपि चाप्नोति सपुत्रत्वं तथानघे॥२६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 135,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "अङ्गनिर्वेशहेतूनि व्रतानि-०८०",
      "combined_translation": "26-26"
    },
    {
      "verse": 27,
      "sanskrit": "सर्वमेव मुखं कान्तमिच्छेद्या रुचिरानने। सा पूर्णमास्यां स्नात्वा तु प्राप्य चन्द्रोदये शुभे॥२७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 135,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "अङ्गनिर्वेशहेतूनि व्रतानि-०८०",
      "combined_translation": "27-27"
    },
    {
      "verse": 28,
      "sanskrit": "यावकं पयसा सिद्धं दत्त्वा विप्राय भामिनी। ततः संवत्सरे पूर्णे चन्द्रं रूप्यमयं शुभम्॥२८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 135,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "अङ्गनिर्वेशहेतूनि व्रतानि-०८०",
      "combined_translation": "28-28"
    },
    {
      "verse": 29,
      "sanskrit": "पद्मे फुल्ले तु विन्यस्य ब्राह्मणान्स्वस्ति वाचयेत्। पूर्णचन्द्रमुखी तेन दानेन स्त्री शुभा भवेत्॥२९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 135,
