{
  "adhyaya_id": "P19_U02_A087",
  "book": 19,
  "parva_name": "हरिवंशः",
  "upaparva_name": "विष्णुपर्व",
  "adhyaya_name": "महादेवेनान्धकवधः-०८७",
  "chapter": 142,
  "verse_count": 39,
  "verses": [
    {
      "verse": 1,
      "sanskrit": "वैशम्पायन उवाच।\n              अन्धको नारदवचः श्रुत्वा तत्त्वेन भारत। मन्दरं पर्वतं गन्तुं मनो दध्रे महासुरः॥१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 142,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "महादेवेनान्धकवधः-०८७"
    },
    {
      "verse": 2,
      "sanskrit": "सोऽसुरान्सुमहातेजाः समानीय महाबलः। जगाम मन्दरं क्रुद्धो महादेवालयं तदा॥२॥",
      "english": null,
      "bhavadeepa": "सप्ताशीतितमेऽध्यायेऽमुष्मिन्नन्धकवैरिणा। अन्धकस्य युधि प्राणो हृतो रुद्रेण चोच्यते॥१॥ अन्धक इति॥१॥",
      "chapter": 142,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "महादेवेनान्धकवधः-०८७",
      "combined_translation": "2-2"
    },
    {
      "verse": 3,
      "sanskrit": "तं महाभ्रप्रतिच्छन्नं महौषधिसमाकुलम्। नानासिद्धसमाकीर्णं महर्षिगणसेवितम्॥३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 142,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "महादेवेनान्धकवधः-०८७",
      "combined_translation": "3-3"
    },
    {
      "verse": 4,
      "sanskrit": "चन्दनागरुवृक्षाढ्यं सरलद्रुमसङ्कुलम्। किन्नरोद्गीतरम्यं च बहुनागकुलाकुलम्॥४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 142,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "महादेवेनान्धकवधः-०८७",
      "combined_translation": "4-4"
    },
    {
      "verse": 5,
      "sanskrit": "वातोद्धूतैर्वनैः फुल्लैर्नृत्यन्तमिव च क्वचित्। प्रस्रुतैर्धातुभिश्चित्रैर्विलिप्तमिव च क्वचित्॥५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 142,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "महादेवेनान्धकवधः-०८७",
      "combined_translation": "5-5"
    },
    {
      "verse": 6,
      "sanskrit": "पक्षिस्वनैः सुमधुरैर्नदन्तमिव च क्वचित्। हंसैः शुचिपदैः कीर्णं सम्पतद्भिरितस्ततः॥६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 142,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "महादेवेनान्धकवधः-०८७",
      "combined_translation": "6-6"
    },
    {
      "verse": 7,
      "sanskrit": "महाबलैश्च महिषैश्चरद्भिर्दैत्यनाशनैः। चन्द्रांशुविमलैः सिंहैर्भूषितं हेमसञ्चयम्॥७॥",
      "english": null,
      "bhavadeepa": "शुचिषदैः सदः सभा शुचिस्थाने सीदन्ति तिष्ठन्तीति शुचिषदास्तैः शुद्धसदोभिः। शुचिपदैरित्यपि पाठः॥६॥",
      "chapter": 142,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "महादेवेनान्धकवधः-०८७",
      "combined_translation": "7-7"
    },
    {
      "verse": 8,
      "sanskrit": "मृगराजसमाकीर्णं मृगवृन्दनिषेवितम्। स मन्दरं गिरिं प्राह रूपिणं बलदर्पितः॥८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 142,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "महादेवेनान्धकवधः-०८७",
      "combined_translation": "8-8"
    },
    {
      "verse": 9,
      "sanskrit": "वेत्सि त्वं हि यथावध्यो वरदानादहं पितुः। मम चैव वशे सर्वं त्रैलोक्यं सचराचरम्॥९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 142,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "महादेवेनान्धकवधः-०८७",
      "combined_translation": "9-9"
    },
    {
      "verse": 10,
      "sanskrit": "प्रतियोद्धुं न मां कश्चिदिच्छत्यपि गिरे भयात्। पारिजातवनं चास्ति तव सानौ महागिरे। सर्वकामप्रदैः पुष्पैर्भूषितं रत्नमुत्तमम्॥१०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 142,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "महादेवेनान्धकवधः-०८७",
      "combined_translation": "10-10"
    },
    {
      "verse": 11,
      "sanskrit": "तदाचक्ष्वोपभोक्ष्यामि तद्वनं तव सानुजम्। किं करिष्यसि क्रुद्धस्त्वं मनो हि त्वरते मम॥११॥",
      "english": null,
      "bhavadeepa": "रत्नमुत्तमं दिव्यं श्रेष्ठम्॥१०॥",
      "chapter": 142,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "महादेवेनान्धकवधः-०८७",
      "combined_translation": "11-11"
    },
    {
      "verse": 12,
      "sanskrit": "त्रातारं नानुपश्यामि मया खल्वर्दितस्य ते। इत्युक्तो मन्दरस्तेन तत्रैवान्तरधीयत॥१२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 142,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "महादेवेनान्धकवधः-०८७",
      "combined_translation": "12-12"
    },
    {
      "verse": 13,
      "sanskrit": "ततोऽन्धकोऽतिरुषितो वरदानेन दर्पितः। मुमोच नादं सुमहदिदं वचनमब्रवीत्॥१३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 142,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "महादेवेनान्धकवधः-०८७",
      "combined_translation": "13-13"
    },
    {
      "verse": 14,
      "sanskrit": "मया वै त्वं याच्यमानो यस्मान्न बहु मन्यसे। अहं चूर्णीकरोमि त्वां बलं पर्वत पश्य मे॥१४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 142,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "महादेवेनान्धकवधः-०८७",
      "combined_translation": "14-14"
    },
    {
      "verse": 15,
      "sanskrit": "एवमुक्त्वा गिरेः शृङ्गमुत्पाट्य बहुयोजनम्। निष्पिपेष गिरेस्तस्य शृङ्गेश्वन्यत्र वीर्यवान्॥१५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 142,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "महादेवेनान्धकवधः-०८७",
      "combined_translation": "15-78"
    },
    {
      "verse": 16,
      "sanskrit": "स हतैरसुरैः सर्वैर्वरदानेन दर्पितः। तं प्रच्छन्ननदीजालं मन्यमानं महागिरिम्॥१६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 142,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "महादेवेनान्धकवधः-०८७",
      "combined_translation": "16-16"
    },
    {
      "verse": 17,
      "sanskrit": "विदित्वा भगवान्रुद्रश्चकारानुग्रहं गिरेः। सविशेषतरं वीरं मत्तद्विपमृगायुतम्॥१७॥",
      "english": null,
      "bhavadeepa": "प्रच्छन्नानि नदीनां जालानि समूहा यत्र तम्॥१६॥",
      "chapter": 142,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "महादेवेनान्धकवधः-०८७",
      "combined_translation": "17-17"
    },
    {
      "verse": 18,
      "sanskrit": "नदीजालैर्बहुतरैराचितं चित्रकाननम्। नभश्च्युतैः पुरा यद्वत्तद्वदेव विराजते॥१८॥",
      "english": null,
      "bhavadeepa": "सविशेषतरं विशेषतरैः पारिजातादिभिः सहितम्॥१७॥",
      "chapter": 142,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "महादेवेनान्धकवधः-०८७",
      "combined_translation": "18-18"
    },
    {
      "verse": 19,
      "sanskrit": "अथ देवप्रभावेण शृङ्गाण्युत्पाटितानि तु। क्षिप्तानि चासुरानेव घ्नन्ति वीराणि भारत॥१९॥",
      "english": null,
      "bhavadeepa": "नभश्चयुतैः स्वर्गादागतैर्नदीजालैः पुरा अन्धकक्षोभात्पूर्वम्॥१८॥",
      "chapter": 142,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "महादेवेनान्धकवधः-०८७",
      "combined_translation": "19-19"
    },
    {
      "verse": 20,
      "sanskrit": "क्षिप्त्वा ये प्रपलायन्ते शृङ्गाणि तु महासुराः। शृङ्गैस्तैस्तैः स्म वध्यन्ति पर्वतस्य जनाधिप॥२०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 142,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "महादेवेनान्धकवधः-०८७",
      "combined_translation": "20-20"
    },
    {
      "verse": 21,
      "sanskrit": "ये स्वस्थास्त्वसुरास्तत्र तिष्ठन्ति गिरिसानुषु। शृङ्गैस्तेन स्म वध्यन्ते मन्दरस्य महागिरेः॥२१॥",
      "english": null,
      "bhavadeepa": "वध्यन्ति वध्यन्ते॥२०॥",
      "chapter": 142,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "महादेवेनान्धकवधः-०८७",
      "combined_translation": "21-21"
    },
    {
      "verse": 22,
      "sanskrit": "ततोऽन्धकस्तदा दृष्ट्वा सेनां तां मर्दितां तथा। रुषितः सुमहानादं नर्दित्वैवं तदाब्रवीत्॥२२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 142,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "महादेवेनान्धकवधः-०८७",
      "combined_translation": "22-22"
    },
    {
      "verse": 23,
      "sanskrit": "आह्वये तं वनं यस्य युद्धार्थमुपतिष्ठतु। किं त्वयाचल युद्धेन हताः स्म च्छद्मना रणे॥२३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 142,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "महादेवेनान्धकवधः-०८७",
      "combined_translation": "23-23"
    },
    {
      "verse": 24,
      "sanskrit": "एवमुक्ते त्वन्धकेन वृषभेण महेश्वरः। सम्प्राप्तः शूलमुद्यम्य देवोऽन्धकजिघांसया॥२४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 142,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "महादेवेनान्धकवधः-०८७",
      "combined_translation": "24-24"
    },
    {
      "verse": 25,
      "sanskrit": "प्रमथानां गणैर्धीमान्वृतो वै बहुलोचनः। तथा भूतगणैश्चैव धीमान्भूतगणेश्वरः॥२५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 142,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "महादेवेनान्धकवधः-०८७",
      "combined_translation": "25-25"
    },
    {
      "verse": 26,
      "sanskrit": "प्रचकम्पे ततः कृत्स्नं त्रैलोक्यं रुषिते हरे। सिन्धवश्च प्रतिस्रोतमूहुः प्रज्वलितोदकाः॥२६॥",
      "english": null,
      "bhavadeepa": "बहुलोचनः त्रिनेत्रः॥२५॥",
      "chapter": 142,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "महादेवेनान्धकवधः-०८७",
      "combined_translation": "26-26"
    },
    {
      "verse": 27,
      "sanskrit": "जग्मुर्दिशोऽग्निदाहाश्च सर्वे ते हरतेजसा। युयुधुश्च ग्रहाः सर्वे विपरीता जनाधिप॥२७॥",
      "english": null,
      "bhavadeepa": "सिन्धवो नद्यः॥२६॥",
      "chapter": 142,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "महादेवेनान्धकवधः-०८७",
      "combined_translation": "27-27"
    },
    {
      "verse": 28,
      "sanskrit": "चेलुश्च गिरयस्तत्र काले कुरुकुलोद्वह। प्रववर्षाथ पर्जन्यः सधूमाङ्गारवृष्टयः॥२८॥",
      "english": null,
      "bhavadeepa": "सर्वे ते सर्वास्ताः विपरीता वक्रीभूताः॥२७॥",
      "chapter": 142,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "महादेवेनान्धकवधः-०८७",
      "combined_translation": "28-28"
    },
    {
      "verse": 29,
      "sanskrit": "उष्णभाश्चन्द्रमाश्चासीत्सूर्यः शीतप्रभस्तथा। न ब्रह्म विविदुस्तत्र मुनयो ब्रह्मवादिनः॥२९॥",
      "english": null,
      "bhavadeepa": "सधूमाङ्गाराः वृष्टयो येषु ते गिरयः॥२८॥",
      "chapter": 142,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "महादेवेनान्धकवधः-०८७",
      "combined_translation": "29-29"
    },
    {
      "verse": 30,
      "sanskrit": "वडवाः सुषुवुर्गाश्च गवोऽश्वानपि चानघ। पेतुर्वृक्षाश्च मेदिन्यामच्छिन्ना भस्मसात्कृताः॥३०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 142,
      "parva_name": "हरिवंशः",
