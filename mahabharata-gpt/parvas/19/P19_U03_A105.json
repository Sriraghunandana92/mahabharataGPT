  "adhyaya_name": "हंसडिम्भकयोर्वरलाभः",
  "chapter": 288,
  "verse_count": 27,
  "verses": [
    {
      "verse": 1,
      "sanskrit": "वैशम्पायन उवाच।\n              हंसश्च डिम्भकश्चैवं तपश्चर्तुं महामती। मनश्चक्रतुरात्मांशौ शङ्करस्य नृपोत्तम॥१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 288,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हंसडिम्भकयोर्वरलाभः",
      "combined_translation": "1-20"
    },
    {
      "verse": 2,
      "sanskrit": "गत्वा तु हिमवत्पार्श्वं तपश्चक्रतुरञ्जसा। उद्धिश्य शङ्करं शर्वं नीलग्रीवमुमापतिम्॥२॥",
      "english": null,
      "bhavadeepa": "हंसश्चेति॥१॥",
      "chapter": 288,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हंसडिम्भकयोर्वरलाभः",
      "combined_translation": "2-2"
    },
    {
      "verse": 3,
      "sanskrit": "वीर्यास्त्रे चैव नौ स्यातामित्याधाय तु मानसे। एकाग्रौ प्रयतौ भूत्वा वाय्वम्बुप्राशिनौ नृप॥३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 288,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हंसडिम्भकयोर्वरलाभः",
      "combined_translation": "3-3"
    },
    {
      "verse": 4,
      "sanskrit": "नमस्ते देवदेवेति शङ्करेति दिवानिशम्। हर शर्व शिवानन्द नीलग्रीव उमापते॥४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 288,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हंसडिम्भकयोर्वरलाभः",
      "combined_translation": "4-4"
    },
    {
      "verse": 5,
      "sanskrit": "वृषध्वज विरूपाक्ष हर्यक्ष जगतां पते। भक्तप्रिय गिरीशेश वासुदेव शिवाच्युत॥५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 288,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हंसडिम्भकयोर्वरलाभः",
      "combined_translation": "5-5"
    },
    {
      "verse": 6,
      "sanskrit": "सद्योजात महादेव देवदेव गुहाशय। भूतभावन देवेश प्रणवात्मन्सदाशिव॥६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 288,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हंसडिम्भकयोर्वरलाभः",
      "combined_translation": "6-6"
    },
    {
      "verse": 7,
      "sanskrit": "इत्यादिनामभिर्नित्यं स्तुवन्तौ शङ्करं भवम्। हृदि कृत्वा विरूपाक्षं तपस्तेपतुरञ्जसा॥७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 288,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हंसडिम्भकयोर्वरलाभः",
      "combined_translation": "7-7"
    },
    {
      "verse": 8,
      "sanskrit": "निर्ममौ निरहङ्कारौ मौनव्रतसमास्थितौ। वर्षाणीह तदा राजन्पञ्च चक्रतुरोजसा॥८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 288,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हंसडिम्भकयोर्वरलाभः",
      "combined_translation": "8-8"
    },
    {
      "verse": 9,
      "sanskrit": "ततः प्रीतोऽभवच्छर्वस्ताभ्यां संयमनेन च। स ददौ दर्शनं नैजं व्याघ्रचर्मधरो हरः॥९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 288,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हंसडिम्भकयोर्वरलाभः",
      "combined_translation": "9-9"
    },
    {
      "verse": 10,
      "sanskrit": "त्रियक्षः शङ्करः शर्वः शूलपाणिरुमापतिः। अग्रतः संस्थितं शर्वं चन्द्रार्धकृतशेखरम्। तौ दृष्ट्वा प्रीतमनसौ नमश्चक्रतुरञ्जसा॥१०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 288,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हंसडिम्भकयोर्वरलाभः",
      "combined_translation": "10-10"
    },
    {
      "verse": 11,
      "sanskrit": "श्रीभगवानुवाच।\n              वरं वरय भद्रं वां यथेच्छा वां तथास्तु वै। तावूचतुस्तदा राजन्प्रीतस्त्वं भगवन्यदि॥११॥",
      "english": null,
      "bhavadeepa": "त्रियक्षः त्रिभिर्वेदैः इज्यत इति त्रियक्षः यज्ञेशः॥१०॥",
      "chapter": 288,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हंसडिम्भकयोर्वरलाभः",
      "combined_translation": "11-11"
    },
    {
      "verse": 12,
      "sanskrit": "देवासुरचमूमुख्यैर्यक्षगन्धर्वदानवैः। आवामजय्यौ सर्वात्मन्नेष नौ प्रथमो वरः॥१२॥",
      "english": null,
      "bhavadeepa": "वरस्य वरयतम्॥११॥",
      "chapter": 288,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हंसडिम्भकयोर्वरलाभः",
      "combined_translation": "12-12"
    },
    {
      "verse": 13,
      "sanskrit": "द्वितीयो नौ विरूपाक्ष रौद्रास्त्राणां च सङ्ग्रहः। माहेश्वरं तथा रौद्रमस्त्रं ब्रह्मशिरो महत्॥१३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 288,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हंसडिम्भकयोर्वरलाभः",
      "combined_translation": "13-13"
    },
    {
      "verse": 14,
      "sanskrit": "अभेद्यं कवचं दिव्यमच्छेद्यं चापि कार्मुकम्। परशुं च तथा शर्व सदा रक्षार्हमेव च॥१४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 288,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हंसडिम्भकयोर्वरलाभः",
      "combined_translation": "14-14"
    },
    {
      "verse": 15,
      "sanskrit": "सहायौ द्वौ महादेव भूतौ युद्धे हि गच्छताम्। एवमस्त्विति देवेश आह भृङ्गिरिटी हरः॥१५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 288,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हंसडिम्भकयोर्वरलाभः",
      "combined_translation": "15-15"
    },
    {
      "verse": 16,
      "sanskrit": "कुण्डोदरं विरूपाक्षं सर्वप्राणिहिते रतम्। युवामथ च भूतेशौ सहायौ सततं रणे॥१६॥",
      "english": null,
      "bhavadeepa": "भृङ्गिरिटी भृङ्गिं रिटिं च॥१५॥",
      "chapter": 288,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हंसडिम्भकयोर्वरलाभः",
      "combined_translation": "16-16"
    },
    {
      "verse": 17,
      "sanskrit": "सङ्ग्रामं गच्छतां घोरमेतयोर्बलशालिनोः। इत्युक्त्वा भगवाञ्छर्वस्तत्रैवान्तरधीयत॥१७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 288,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हंसडिम्भकयोर्वरलाभः",
      "combined_translation": "17-17"
    },
    {
      "verse": 18,
      "sanskrit": "ततस्तौ वीर्यसम्पन्नौ हंसो डिम्भक एव च। कृतास्त्रौ शस्त्रसम्पन्नौ चापिनौ वीर्यवत्तरौ॥१८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 288,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हंसडिम्भकयोर्वरलाभः",
      "combined_translation": "18-18"
    },
    {
      "verse": 19,
      "sanskrit": "आमुक्तकवचौ वीरावजय्यौ देवदानवैः। अत्यन्तभक्तौ देवेशे शङ्करे नीललोहिते॥१९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 288,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हंसडिम्भकयोर्वरलाभः",
      "combined_translation": "19-19"
    },
    {
      "verse": 20,
      "sanskrit": "नित्योत्सवकरौ देवे भस्मोद्धूलनशोभिनौ। कृतत्रिपुण्ड्रको नित्यं जटायुक्तशिरोधरौ॥२०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 288,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हंसडिम्भकयोर्वरलाभः",
      "combined_translation": "20-20"
    },
    {
      "verse": 21,
      "sanskrit": "रुद्राक्षार्पितसर्वाङ्गौ व्याघ्रचर्माम्बरावृतौ। नमः शिवाय शान्ताय महादेवाय धीमते॥२१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 288,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हंसडिम्भकयोर्वरलाभः",
      "combined_translation": "21-21"
    },
    {
      "verse": 22,
      "sanskrit": "इत्यदिभिर्महादेवं स्तुवन्तौ नामभिः शिवम्। साक्षादिव महादेवौ रेजतुर्जलधारिणौ॥२२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 288,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हंसडिम्भकयोर्वरलाभः",
      "combined_translation": "22-22"
    },
    {
      "verse": 23,
      "sanskrit": "ततः स्वभवनं गत्वा पितुः पादावगृह्यताम्। पितुश्च सख्युर्बलिनौ मातुश्च चरणौ तदा॥२३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 288,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हंसडिम्भकयोर्वरलाभः",
      "combined_translation": "23-23"
    },
    {
      "verse": 24,
      "sanskrit": "जनार्दनोऽपि धर्मात्मा कालेन महता नृप। विद्यापारं महाबुद्धिर्युक्तेनासावुपेयिवान्॥२४॥",
      "english": null,
      "bhavadeepa": "पितुर्ब्रह्मदत्तस्त सख्युः मित्रसहस्य॥२३॥",
      "chapter": 288,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हंसडिम्भकयोर्वरलाभः",
      "combined_translation": "24-24"
    },
    {
      "verse": 25,
      "sanskrit": "स च विष्णुं ह्रिषीकेशं पीतकौशेयवाससम्। ब्रह्मतत्त्वपरो नित्यमुपास्ते विजितेन्द्रियः॥२५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 288,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हंसडिम्भकयोर्वरलाभः",
      "combined_translation": "25-25"
    },
    {
      "verse": 26,
      "sanskrit": "हंसश्च डिम्भकश्चैव कृतदारौ बभूवतुः। जनर्दनोऽपि धर्मात्मा कृतदारो बभूव ह॥२६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 288,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हंसडिम्भकयोर्वरलाभः",
      "combined_translation": "26-26"
    },
    {
      "verse": 27,
      "sanskrit": "सर्वे ते यज्ञनिरताः पञ्चयज्ञपरास्तथा। स्वदारनिरताः सर्वे गुरुशुश्रुषणे रताः। धर्म एव परं श्रेय इति ते मेनिरे नृप॥२७॥",
      "english": null,
      "bhavadeepa": null,
