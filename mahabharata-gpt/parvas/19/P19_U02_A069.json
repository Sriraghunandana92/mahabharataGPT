  "chapter": 124,
  "verse_count": 73,
  "verses": [
    {
      "verse": 1,
      "sanskrit": "वैशम्पायन उवाच।\n              नारदोऽथ मुनिर्गत्वा महेन्द्रसदनं प्रति। तां रात्रिमवसत्तत्र ददृशे च महोत्सवम्॥१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 124,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "इन्द्रस्य पारिजातदानेऽसंमतिः-०६९"
    },
    {
      "verse": 2,
      "sanskrit": "तत्रादित्या महात्मानो वसवश्च सुरोत्तमाः। राजर्षयश्च विद्वांसः स्वर्गताः कर्मभिः शुभैः॥२॥",
      "english": null,
      "bhavadeepa": "एकोनसप्ततितमेऽध्यायेऽस्मिन्कृष्णवाक्छ्रवात्। पारिजातं न दास्यामीत्याह शक्र इतीर्यते॥१॥ नारदोऽथेति॥१॥",
      "chapter": 124,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "इन्द्रस्य पारिजातदानेऽसंमतिः-०६९",
      "combined_translation": "2-2"
    },
    {
      "verse": 3,
      "sanskrit": "नागा यक्षाश्च सिद्धाश्च चारणाश्च तपोधनाः। ब्रह्मर्षयश्च शतशो देवर्शिमनवस्तथा ॥ ३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 124,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "इन्द्रस्य पारिजातदानेऽसंमतिः-०६९",
      "combined_translation": "3-3"
    },
    {
      "verse": 4,
      "sanskrit": "सुपर्णाश्च महात्मानो मरुतश्च महाबलाः। दिवौकसां निकायाश्च शतशोऽन्ये समागताः॥४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 124,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "इन्द्रस्य पारिजातदानेऽसंमतिः-०६९",
      "combined_translation": "4-4"
    },
    {
      "verse": 5,
      "sanskrit": "उपर्युपरि सर्वेषां सोमदेवो महेश्वरः। तस्थावमितविक्रान्तः स्वैर्गणैः परिवारितः॥५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 124,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "इन्द्रस्य पारिजातदानेऽसंमतिः-०६९",
      "combined_translation": "5-5"
    },
    {
      "verse": 6,
      "sanskrit": "देवर्षिभिर्मुनिश्रेष्ठैः संवृतः सर्वभावनः। कल्पान्तरसहस्रेषु क्षयो येषां न विद्यते॥६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 124,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "इन्द्रस्य पारिजातदानेऽसंमतिः-०६९",
      "combined_translation": "6-6"
    },
    {
      "verse": 7,
      "sanskrit": "यानर्चयन्ति सततं देवा देवेश्वरोपमाः। आत्मज्ञा नावलेपान्धा ये च धर्मपथि स्थिताः॥७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 124,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "इन्द्रस्य पारिजातदानेऽसंमतिः-०६९",
      "combined_translation": "7-7"
    },
    {
      "verse": 8,
      "sanskrit": "रुद्राश्च काश्यपा देवमध्युपासन्त भारत। स्कन्दश्च भगवानग्निर्गङ्गां च सरितां वरा॥८॥",
      "english": null,
      "bhavadeepa": "नावलेपान्धाः गर्वहीनाः॥७॥",
      "chapter": 124,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "इन्द्रस्य पारिजातदानेऽसंमतिः-०६९",
      "combined_translation": "8-8"
    },
    {
      "verse": 9,
      "sanskrit": "अर्चिष्मांस्तुम्बुरुश्चैव भारिश्च वदतां वरः। नेतारो देवदेवानामेते हि तपसान्विताः॥९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 124,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "इन्द्रस्य पारिजातदानेऽसंमतिः-०६९",
      "combined_translation": "9-9"
    },
    {
      "verse": 10,
      "sanskrit": "एताननुविधीयन्ते सर्वदेवगणा नृप। धर्मनित्यास्तपोनित्याः सतां मार्गमुपाश्रिताः॥१०॥",
      "english": null,
      "bhavadeepa": "भारिर्गन्धर्वविशेषः॥९॥",
      "chapter": 124,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "इन्द्रस्य पारिजातदानेऽसंमतिः-०६९",
      "combined_translation": "10-10"
    },
    {
      "verse": 11,
      "sanskrit": "ये त्विमे मानुषा देवानर्चयन्ति शुभार्थिनः। तानर्चयन्ति ह्यमरास्तथा राजञ्छुभार्थिनः॥११॥",
      "english": null,
      "bhavadeepa": "अनुविधीयन्ते अनुसरन्ति॥१०॥",
      "chapter": 124,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "इन्द्रस्य पारिजातदानेऽसंमतिः-०६९",
      "combined_translation": "11-11"
    },
    {
      "verse": 12,
      "sanskrit": "पितृकृत्येषु देवानां संन्यासं ये त्वनुष्ठिताः। स्वाध्यायवन्तः कौरव्य सदा नियमचारिणः॥१२॥",
      "english": null,
      "bhavadeepa": "तान् मानुषान् अर्चयन्ति दृष्टफलप्रदानेन पूजयन्ति॥११॥",
      "chapter": 124,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "इन्द्रस्य पारिजातदानेऽसंमतिः-०६९",
      "combined_translation": "12-12"
    },
    {
      "verse": 13,
      "sanskrit": "गन्धर्वाधिपतिः श्रीमांस्तत्र चित्ररथो नृप। सपुत्रो वादयामास देववाद्यानि हृष्टवत्॥१३॥",
      "english": null,
      "bhavadeepa": "देवानां कृत्येषु ये वर्तन्ते ते इति च ज्ञेयम्। अनुष्ठिताः अनुष्ठितवन्तः॥१२॥",
      "chapter": 124,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "इन्द्रस्य पारिजातदानेऽसंमतिः-०६९",
      "combined_translation": "13-13"
    },
    {
      "verse": 14,
      "sanskrit": "ऊर्णायुश्चित्रसेनश्च हाहा हूहूस्तथैव च। डुम्बरस्तुम्बरुश्चैव जगुरन्ये च षड्गुणान्॥१४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 124,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "इन्द्रस्य पारिजातदानेऽसंमतिः-०६९",
      "combined_translation": "14-14"
    },
    {
      "verse": 15,
      "sanskrit": "उर्वशी विप्रचित्तिश्च हेमा रम्भा च भारत। हेमदन्ता घृताची च सहजन्या तथैव च॥१५॥",
      "english": null,
      "bhavadeepa": "षड्गुणान् वक्रिमस्निग्धमधुरलास्यविभक्तावबद्धाख्यान्॥१४॥",
      "chapter": 124,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "इन्द्रस्य पारिजातदानेऽसंमतिः-०६९",
      "combined_translation": "15-15"
    },
    {
      "verse": 16,
      "sanskrit": "जुजोष भगवान्देवस्तदुपस्थानमात्मवान्। वृत्तेन तुष्टः शक्रस्य जगाम जगतो गतिः॥१६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 124,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "इन्द्रस्य पारिजातदानेऽसंमतिः-०६९",
      "combined_translation": "16-16"
    },
    {
      "verse": 17,
      "sanskrit": "गते भूतपतौ सर्वे नृपा जग्मुर्यथागतम्। महेन्द्रेणार्चिता देवाः स्वानेव निलयान्गताः॥१७॥",
      "english": null,
      "bhavadeepa": "जुजोष प्रीत्या जग्राह। उपस्थानं नृत्यादिरूपां परिचर्याम्॥१६॥",
      "chapter": 124,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "इन्द्रस्य पारिजातदानेऽसंमतिः-०६९",
      "combined_translation": "17-17"
    },
    {
      "verse": 18,
      "sanskrit": "ततः सर्वेषु यातेषु सुखासीनं पुरन्दरम्। सदस्यैः स्वैः सहासीनं नारदोऽभिययौ मुनिः॥१८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 124,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "इन्द्रस्य पारिजातदानेऽसंमतिः-०६९",
      "combined_translation": "18-18"
    },
    {
      "verse": 19,
      "sanskrit": "तमिन्द्रः पुजयामास समुत्थाय तपोधनम्। दिदेश कुशगर्भं च पीठमात्मासनोपमम्॥१९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 124,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "इन्द्रस्य पारिजातदानेऽसंमतिः-०६९",
      "combined_translation": "19-19"
    },
    {
      "verse": 20,
      "sanskrit": "नारदोऽथ महातेजा महेन्द्रमिदमब्रवीत्। दूतोऽहममरश्रेष्ठ विष्णोरतुलतेजसः॥२०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 124,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "इन्द्रस्य पारिजातदानेऽसंमतिः-०६९",
      "combined_translation": "20-20"
    },
    {
      "verse": 21,
      "sanskrit": "किञ्चित्कार्यं पुरस्कृत्य प्रेषितोऽस्मि महात्मना। आनर्तादार्तिहरणं तस्यैवानघतेजसः॥२१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 124,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "इन्द्रस्य पारिजातदानेऽसंमतिः-०६९",
      "combined_translation": "21-21"
    },
    {
      "verse": 22,
      "sanskrit": "प्रीतिवाक्यानि हृद्यानि प्रयुज्य मुनये तदा। ततः प्रहृष्टो भगवानब्रवीत्पाकशासनः॥२२॥",
      "english": null,
      "bhavadeepa": "तस्यैवार्तिहरणं कार्यम्॥२१॥",
      "chapter": 124,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "इन्द्रस्य पारिजातदानेऽसंमतिः-०६९",
      "english_ref": 1,
      "combined_translation": "1-22"
    },
    {
      "verse": 23,
      "sanskrit": "किमाह पुरुषश्रेष्ठः शीघ्रमाचक्ष्व मे मुने। चिरस्य खलु कृष्णेन संस्मृतोऽस्मि महात्मना॥२३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 124,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "इन्द्रस्य पारिजातदानेऽसंमतिः-०६९"
    },
    {
      "verse": 24,
      "sanskrit": "नारद उवच।\n              महेन्द्रेन्द्रानुजं द्रष्टुं गतोऽहं भ्रातरं तव। कथञ्चिद्द्वारकां तत्र काश्यपानां यशस्करम्॥२४॥",
      "english": null,
      "bhavadeepa": "चिरस्य चिरेण॥२३॥",
      "chapter": 124,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "इन्द्रस्य पारिजातदानेऽसंमतिः-०६९"
    },
    {
      "verse": 25,
      "sanskrit": "तं तु रैवतकेऽद्राक्षं तदासीनमरिन्दमम्। रुक्मिण्या सहितं वीरं स्तुवन्तं वृषभध्वजम्॥२५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 124,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "इन्द्रस्य पारिजातदानेऽसंमतिः-०६९"
    },
    {
      "verse": 26,
      "sanskrit": "पारिजाततरोः पुष्पं तस्य दत्तं मयानघ। विस्मापनार्थं देवेश पत्नीनामुरुतेजसः॥२६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 124,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "इन्द्रस्य पारिजातदानेऽसंमतिः-०६९"
    },
    {
      "verse": 27,
      "sanskrit": "तद्दृष्ट्वा तस्य पत्न्यस्तु विस्मयं परमं ययुः। बहुकामप्रदं पुष्पं वृक्षराजसमुद्भवम्॥२७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 124,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "इन्द्रस्य पारिजातदानेऽसंमतिः-०६९"
    },
    {
      "verse": 28,
      "sanskrit": "गुणास्तासां मया ख्यातास्तस्य पुष्पस्य मानद। सृष्टिश्च पारिजातस्य कश्यपेन महात्मना॥२८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 124,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "इन्द्रस्य पारिजातदानेऽसंमतिः-०६९"
    },
    {
      "verse": 29,
      "sanskrit": "अदित्या कश्यपो दत्तः पुण्यार्थं च यथा मम। पुष्पदाम्ना वेष्टयित्वा कन्ठे पुण्यार्थमात्मवान्॥२९॥",
      "english": null,
      "bhavadeepa": "तासां कृष्णपत्नीनां पुरः॥२८॥",
      "chapter": 124,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "इन्द्रस्य पारिजातदानेऽसंमतिः-०६९"
    },
