      "combined_translation": "20-20"
    },
    {
      "verse": 21,
      "sanskrit": "देवेषु देवः सुश्रोणि दानवेषु च दानवः। मानुषेष्वपि धर्मात्मा मनुष्यः स महाबलः॥२१॥",
      "english": null,
      "bhavadeepa": null,
