    },
    {
      "verse": 28,
      "sanskrit": "प्रभावत्युवाच।\n              विष्णुर्मानुषलोकस्थः श्रुतः सुबहुशो मया। पितुः कथयतः सौम्ये नारदस्य च धीमतः॥२८॥",
      "english": null,
      "bhavadeepa": "तेजसा प्रभावेण॥२७॥",
