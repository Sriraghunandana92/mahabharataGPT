    },
    {
      "verse": 26,
      "sanskrit": "यान्यान्गुणान्पृथुश्रोणि मनसा कल्पयिष्यसि। एष्टव्यास्त्रिषु लोकेषु प्रद्युम्ने सर्व एव ते॥२६॥",
      "english": null,
      "bhavadeepa": null,
