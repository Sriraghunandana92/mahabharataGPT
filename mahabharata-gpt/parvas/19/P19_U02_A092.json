      "combined_translation": "21-21"
    },
    {
      "verse": 22,
      "sanskrit": "यं सदा देवि दृष्ट्वा हि स्रवन्ति जघनानि हि। आपीनानीव धेनूनां स्रोतांसि सरितामिव॥२२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 147,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "वज्रनाभपुरं प्रतिप्रद्युम्नादीनां गमनम्-०९२",
      "combined_translation": "22-22"
    },
    {
      "verse": 23,
      "sanskrit": "न पीर्णचन्द्रेण मुखं नयने वा कुशेशयैः। उत्सहे नोपमातुं हि मृगेन्द्रेणाथ वा गतिम्॥२३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 147,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "वज्रनाभपुरं प्रतिप्रद्युम्नादीनां गमनम्-०९२",
      "combined_translation": "23-23"
    },
    {
      "verse": 24,
      "sanskrit": "जगतः सारमुद्धृत्य पुत्रः स विहितः शुभे। कृत्वानङ्गं वरे साङ्गं विष्णुना प्रभविष्णुना॥२४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 147,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "वज्रनाभपुरं प्रतिप्रद्युम्नादीनां गमनम्-०९२",
      "english_ref": 1,
      "combined_translation": "1-24"
    },
    {
      "verse": 25,
      "sanskrit": "हृतेन शम्बरो बाल्ये येन पापो निबर्हितः। मायाश्च सर्वाः सम्प्राप्ता न च शीलं विनाशितम्॥२५॥",
      "english": null,
      "bhavadeepa": "अनङ्गं कामदेवं साङ्गं कृत्वा पुत्रो विहित इत्यन्वयः। निबर्हितः हतः॥२४॥",
      "chapter": 147,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
