  "verse_count": 63,
  "verses": [
    {
      "verse": 1,
      "sanskrit": "वैशम्पायन उवाच।\n              ते वासववचः श्रुत्वा हंसा वज्रपुरं ययुः। पूर्वोचितं हि गमनं तेषां तत्र जनाधिप॥१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 147,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "वज्रनाभपुरं प्रतिप्रद्युम्नादीनां गमनम्-०९२"
    },
    {
      "verse": 2,
      "sanskrit": "ते दीर्घिकासु रम्यासु निपेतुर्वीर पक्षिणः। पद्मोत्पलैरावृतासु काञ्चनैः स्पर्शनक्षमैः॥२॥",
      "english": null,
      "bhavadeepa": "ते वासवेति॥१॥",
      "chapter": 147,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "वज्रनाभपुरं प्रतिप्रद्युम्नादीनां गमनम्-०९२",
      "combined_translation": "2-2"
    },
    {
      "verse": 3,
      "sanskrit": "ते वै नदन्तो मधुरं संस्कृतापूर्वभाषिणः। पूर्वमप्यागतास्ते तु विस्मयं जनयन्ति हि॥३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 147,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "वज्रनाभपुरं प्रतिप्रद्युम्नादीनां गमनम्-०९२",
      "combined_translation": "3-3"
    },
    {
      "verse": 4,
      "sanskrit": "अन्तःपुरोपभोग्यासु चेरुर्वापीषु ते नृप। दृष्टास्ते वज्रनाभस्य त्रिविष्टपनिवासिनः॥४॥",
      "english": null,
      "bhavadeepa": "संस्कृतापूर्वभाषिणः संस्कृतम् अपूर्वं भाषन्ते तथा॥३॥",
      "chapter": 147,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "वज्रनाभपुरं प्रतिप्रद्युम्नादीनां गमनम्-०९२",
      "combined_translation": "4-4"
    },
    {
      "verse": 5,
      "sanskrit": "आलपन्तः सुमधुरं धार्तराष्ट्रा जनेश्वर। स तानुवाच दैतेयो धार्तराष्ट्रानिदं वचः॥५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 147,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "वज्रनाभपुरं प्रतिप्रद्युम्नादीनां गमनम्-०९२",
      "combined_translation": "5-5"
    },
    {
      "verse": 6,
      "sanskrit": "त्रिविष्टपे नित्यरता भवन्तश्चारुभाषिणः। यदैवेहोत्सवोऽस्माकं भवद्भिरवगम्यते॥६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 147,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "वज्रनाभपुरं प्रतिप्रद्युम्नादीनां गमनम्-०९२",
      "combined_translation": "6-6"
    },
    {
      "verse": 7,
      "sanskrit": "आगन्तव्यं जालपादाः स्वमिदं भवतां गृहम्। विस्रब्धं च प्रवेष्टव्यं त्रिविष्टपनिवासिभिः॥७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 147,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "वज्रनाभपुरं प्रतिप्रद्युम्नादीनां गमनम्-०९२",
      "combined_translation": "7-7"
    },
    {
      "verse": 8,
      "sanskrit": "ते तथोक्ताः शकुनयो वज्रनाभेन भारत। तथेत्युक्त्वा हि विविशुर्दानवेन्द्रनिवेशनम्॥८॥",
      "english": null,
      "bhavadeepa": "जालपादाः भो हंसाः॥७॥",
      "chapter": 147,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "वज्रनाभपुरं प्रतिप्रद्युम्नादीनां गमनम्-०९२",
      "combined_translation": "8-8"
    },
    {
      "verse": 9,
      "sanskrit": "चक्रुः परिचयं ते च देवकार्यव्यपेक्षया। मानुषालापिनस्ते तु कथाश्चक्रुः पृथग्विधाः॥९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 147,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "वज्रनाभपुरं प्रतिप्रद्युम्नादीनां गमनम्-०९२",
      "combined_translation": "9-9"
    },
    {
      "verse": 10,
      "sanskrit": "वंशबद्धाः काश्यपानां सर्वकल्याणभागिनाम्। स्त्रियो रेमुर्विशेषेण शृण्वन्त्यः सङ्गताः कथाः॥१०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 147,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "वज्रनाभपुरं प्रतिप्रद्युम्नादीनां गमनम्-०९२",
      "combined_translation": "10-10"
    },
    {
      "verse": 11,
      "sanskrit": "विचरन्तस्ततो हंसा ददृशुश्चारुहासिनीम्। प्रभावतीं वरारोहां वज्रनाभसुतां तदा॥११॥",
      "english": null,
      "bhavadeepa": "काश्यपानां दानवानाम्॥१०॥",
      "chapter": 147,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "वज्रनाभपुरं प्रतिप्रद्युम्नादीनां गमनम्-०९२",
      "combined_translation": "11-50"
    },
    {
      "verse": 12,
      "sanskrit": "हंसाः परिचितां चक्रुस्तां ततश्चारुहासिनीम्। सखीं शुचिमुखीं चक्रे हंसीं राजसुता तदा॥१२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 147,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "वज्रनाभपुरं प्रतिप्रद्युम्नादीनां गमनम्-०९२",
      "combined_translation": "12-12"
    },
    {
      "verse": 13,
      "sanskrit": "सा तां कदाचित्पप्रच्छ वज्रनाभसुतां सखीम्। विश्रम्भितां पृथक्सूक्तैराख्यानकशतैर्वराम्॥१३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 147,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "वज्रनाभपुरं प्रतिप्रद्युम्नादीनां गमनम्-०९२",
      "combined_translation": "13-13"
    },
    {
      "verse": 14,
      "sanskrit": "त्रैलोक्यसुन्दरीं वेद्मि त्वामहं हि प्रभावति। रूपशीलगुणैर्देवि किञ्चीत्वां वक्तुमुत्सहे॥१४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 147,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "वज्रनाभपुरं प्रतिप्रद्युम्नादीनां गमनम्-०९२",
      "combined_translation": "14-14"
    },
    {
      "verse": 15,
      "sanskrit": "व्यतिक्रामति ते भीरु यौवनं चारुहासिनि। यदतीतं पुनर्नैति गतं स्रोत इवाम्भसः॥१५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 147,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "वज्रनाभपुरं प्रतिप्रद्युम्नादीनां गमनम्-०९२",
      "combined_translation": "15-15"
    },
    {
      "verse": 16,
      "sanskrit": "कामोपभोगतुल्या हि रतिर्देवि न विद्यते। स्त्रीणां जगति कल्याणि सत्यमेतद्ब्रवीमि ते॥१६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 147,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "वज्रनाभपुरं प्रतिप्रद्युम्नादीनां गमनम्-०९२",
      "combined_translation": "16-31"
    },
    {
      "verse": 17,
      "sanskrit": "स्वयंवरे च न्यस्ता त्वं पित्रा सर्वाङ्गशोभने। न च कांश्चिद्वरयसे देवासुरकुलोद्भवान्॥१७॥",
      "english": null,
      "bhavadeepa": "रतिः सुखम्॥१६॥",
      "chapter": 147,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "वज्रनाभपुरं प्रतिप्रद्युम्नादीनां गमनम्-०९२",
      "combined_translation": "17-17"
    },
    {
      "verse": 18,
      "sanskrit": "व्रीडिता यान्ति सुश्रोणि प्रत्याख्यातास्त्वया शुभे। रूपशौर्यगुणैर्युक्तान्सदृशांस्त्वं कुलस्य हि॥१८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 147,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "वज्रनाभपुरं प्रतिप्रद्युम्नादीनां गमनम्-०९२",
      "combined_translation": "18-18"
    },
    {
      "verse": 19,
      "sanskrit": "आगतान्नेच्छसे देवि सदृशान्कुलरूपयोः। इहैष्यति किमर्थं त्वां प्रद्युम्नो रुक्मिणीसुतः॥१९॥",
      "english": null,
      "bhavadeepa": "“रूपं स्वभावे सौन्दर्ये” इति मेदिनी “कुलं जनपदे गृहे” इति विश्वः॥१८॥",
      "chapter": 147,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "वज्रनाभपुरं प्रतिप्रद्युम्नादीनां गमनम्-०९२",
      "combined_translation": "19-19"
    },
    {
      "verse": 20,
      "sanskrit": "त्रैलोक्ये यस्य रूपेण सदृशो न कुलेन वा। गुणैर्वा चारुसर्वाङ्गि शौर्येणप्यति वा शुभे॥२०॥",
      "english": null,
      "bhavadeepa": "किमर्थमेष्यति तस्यात्रागमनं प्रसक्तमेव नास्तीत्यर्थः॥१९॥",
      "chapter": 147,
