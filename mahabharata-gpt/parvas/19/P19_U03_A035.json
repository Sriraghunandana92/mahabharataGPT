{
  "adhyaya_id": "P19_U03_A035",
  "book": 19,
  "parva_name": "हरिवंशः",
  "upaparva_name": "भविष्यपर्व",
  "adhyaya_name": "महीवर्णनम्",
  "chapter": 218,
  "verse_count": 50,
  "verses": [
    {
      "verse": 1,
      "sanskrit": "वैशम्पायन उवाच।\n              तस्योपरि जलौघस्य महती नौरिव स्थिता। विततत्वात्तु देहस्य न ययौ सम्प्लवं मही॥१॥",
      "english": null,
      "bhavadeepa": "समुद्धरत् समुद्दधार॥४८॥",
      "chapter": 218,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "महीवर्णनम्"
    },
    {
      "verse": 2,
      "sanskrit": "ततः स चिन्तयामास प्रविभागं क्षितेर्विभुः। समुच्छ्रयं च सर्वेषां पर्वतानां नदीषु च॥२॥",
      "english": null,
      "bhavadeepa": "तस्येति। तस्य सम्प्लवं मज्जनम्॥१॥",
      "chapter": 218,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "महीवर्णनम्",
      "combined_translation": "2-2"
    },
    {
      "verse": 3,
      "sanskrit": "विलेखनं प्रमाणं च गतिं प्रस्रवमेव च। माहात्म्यं च विशेषं च नदीनामन्वचिन्तयत्॥३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 218,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "महीवर्णनम्",
      "combined_translation": "3-3"
    },
    {
      "verse": 4,
      "sanskrit": "चतुरन्तां धरां कृत्वा तथा चैव महार्णवम्। मध्ये पृथिव्याः सौवर्णमकरोन्मेरुपर्वतम्॥४॥",
      "english": null,
      "bhavadeepa": "विलेखनं मार्गज्ञापनं लेखारूपेण प्रमाणं योजनतः गतिं प्राङ्मुखादिमाहात्म्यं पावनत्वं विशेषं फलतारतम्यम्॥३॥",
      "chapter": 218,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "महीवर्णनम्",
      "combined_translation": "4-4"
    },
    {
      "verse": 5,
      "sanskrit": "प्राचीं दिशमथो गत्वा चकारोदयपर्वतम्। शतयोजनविस्तारं सहस्रं च समुच्छ्रयम्॥५॥",
      "english": null,
      "bhavadeepa": "चतुरन्तां चतुर्दलपद्माकाराम्। भरताः केतुमालाश्च भद्राश्वाः कुरवस्तथा। पत्राणि भूमिपद्मस्य मर्यादा शैलबाह्यतः॥ इति पुराणान्तरोक्तेः॥४॥",
      "chapter": 218,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "महीवर्णनम्",
      "combined_translation": "5-5"
    },
    {
      "verse": 6,
      "sanskrit": "जातरूपमयैः शृङ्गैस्तरुणादित्यसन्निभैः। आत्मतेजोगुणमयैर्वेदिकाभोगकल्पितम्॥६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 218,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "महीवर्णनम्",
      "combined_translation": "6-6"
    },
    {
      "verse": 7,
      "sanskrit": "विविधांश्च महास्कन्धान्काञ्चनान्पुष्करेक्षणः। नित्यपुष्पफलान्वृक्षान्कृतवांस्तत्र पर्वते॥७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 218,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "महीवर्णनम्",
      "combined_translation": "7-7"
    },
    {
      "verse": 8,
      "sanskrit": "शतयोजनविस्तारं ततस्त्रिगुणमायतम्। चकार स महादेवः पुनः सौमनसं गिरिम्॥८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 218,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "महीवर्णनम्",
      "combined_translation": "8-8"
    },
    {
      "verse": 9,
      "sanskrit": "नानारत्नसहस्राणां कृत्वा तत्र सुसञ्चयम्। वेदिकां बहुवर्णां च सन्ध्याभ्राभामकल्पयत्॥९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 218,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "महीवर्णनम्",
      "combined_translation": "9-9"
    },
    {
      "verse": 10,
      "sanskrit": "सहस्रशृङ्गं च गिरिं नानामणिशिलातलम्। कृतवान्वृक्षगहनं षष्टियोजनमुच्छ्रितम्॥१०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 218,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "महीवर्णनम्",
      "combined_translation": "10-10"
    },
    {
      "verse": 11,
      "sanskrit": "आसनं तत्र परमं सर्वभूतनमस्कृतम्। कृतवानात्मनः स्थानं विश्वकर्मा प्रजापतिः॥११॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 218,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "महीवर्णनम्",
      "combined_translation": "11-11"
    },
    {
      "verse": 12,
      "sanskrit": "शिशिरं च महाशैलं तुषारचयसन्निभम्। चकार दुर्गगहनं कन्दरान्तरमण्डितम्॥१२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 218,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "महीवर्णनम्",
      "combined_translation": "12-12"
    },
    {
      "verse": 13,
      "sanskrit": "शिशिरप्रभवां चैव नदीं द्विजगणायुताम्। चकार पुलिनोपेतां वसुधारामिति श्रुतिः॥१३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 218,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "महीवर्णनम्",
      "combined_translation": "13-13"
    },
    {
      "verse": 14,
      "sanskrit": "सा नदी निखिलां प्राचीं पुण्यां मुखशतैश्चिताम्। शोभयत्यमृतप्रख्यैर्मुक्ताशङ्खविभूषितैः॥१४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 218,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "महीवर्णनम्",
      "combined_translation": "14-14"
    },
    {
      "verse": 15,
      "sanskrit": "नित्यपुषफलोपेतैश्छादयद्भिः सुसंवृतैः। भूषिताभ्यधिकैः कान्तैः सा नदी तीरजैर्द्रुमैः॥१५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 218,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "महीवर्णनम्",
      "combined_translation": "15-15"
    },
    {
      "verse": 16,
      "sanskrit": "कृत्वा प्राचीविभागं च दक्षिणायामथो दिशि। चकार पर्वतं दिव्यं सर्वकाञ्चनराजतम्॥१६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 218,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "महीवर्णनम्",
      "combined_translation": "16-16"
    },
    {
      "verse": 17,
      "sanskrit": "एकतः सूर्यसङ्काशमेकतः शशिसन्निभम्। स बिभ्रच्छुशुभेऽतीव द्वौ वर्णौ पर्वतोत्तमः॥१७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 218,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "महीवर्णनम्",
      "combined_translation": "17-17"
    },
    {
      "verse": 18,
      "sanskrit": "तेजसा युगपद्व्याप्तं सूर्याचन्द्रमसाविव। वपुष्मन्तमथो तत्र भानुमन्तं महागिरिम्॥१८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 218,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "महीवर्णनम्",
      "combined_translation": "18-18"
    },
    {
      "verse": 19,
      "sanskrit": "सर्वकामफलैर्वृक्षैर्वृतं रम्यैर्मनोरमैः। चकार कुञ्जरं चैव कुञ्जरप्रतिमाकृतिम्॥१९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 218,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "महीवर्णनम्",
      "combined_translation": "19-19"
    },
    {
      "verse": 20,
      "sanskrit": "सर्वतः काञ्चनगुहं बहुयोजनविस्तृतम्। ऋषभप्रतिमं चैव ऋषभं नाम पर्वतम्॥२०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 218,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "महीवर्णनम्",
      "combined_translation": "20-20"
    },
    {
      "verse": 21,
      "sanskrit": "हेमकाञ्चनवृक्षाढ्यं पुष्पहासं स सृष्टवान्। महेन्द्रमथ शैलेन्द्रं शतयोजनमुच्छ्रितम्॥२१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 218,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "महीवर्णनम्",
      "combined_translation": "21-21"
    },
    {
      "verse": 22,
      "sanskrit": "जातरूपमयैः शृङ्गैः सपुष्पितमहाद्रुमम्। मेदिन्यां कृतवान्देवः प्रतिक्षोभमिवाचलम्॥२२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 218,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "महीवर्णनम्",
      "combined_translation": "22-22"
    },
    {
      "verse": 23,
      "sanskrit": "नानारत्नसमाकीर्णं सूर्येन्दुसदृशप्रभम्। चकार मलयं चाद्रिं चित्रपुष्पितपादपम्॥२३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 218,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "महीवर्णनम्",
      "english_ref": 1,
      "combined_translation": "1-23"
    },
    {
      "verse": 24,
      "sanskrit": "मैनाकं च महाशैलं शिलाजालसमावृतम्। दक्षिणस्यां दिशि शुभं चकाराचलमायतम्॥२४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 218,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "महीवर्णनम्",
      "combined_translation": "24-24"
    },
    {
      "verse": 25,
      "sanskrit": "सहस्रशिरसं विन्ध्यं नानाद्रुमलताकुलम्। नदीं च विपुलावर्तां पुलिनश्रोणिभूषिताम्॥२५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 218,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "महीवर्णनम्",
      "combined_translation": "25-25"
    },
    {
      "verse": 26,
      "sanskrit": "क्षीरसङ्काशसलिलां पयोधारामिति श्रुतिः। सुरभ्यां तोयकलिलां विहितां दक्षिणां दिशम्॥२६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 218,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "महीवर्णनम्",
      "combined_translation": "26-26"
    },
    {
      "verse": 27,
      "sanskrit": "दिव्यां तीर्थशतोपेतां प्लावयन्तीं शुभाम्भसा। दिशं याम्यां प्रतिष्ठाप्य प्रतीचीं दिशमागमत्॥२७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 218,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "महीवर्णनम्",
      "combined_translation": "27-27"
    },
    {
      "verse": 28,
      "sanskrit": "अकरोत्तत्र शैलेन्द्रं शतयोजनमुच्छ्रितम्। शोभितं शिखरैरश्चित्रैः सुप्रवृद्धैर्हिरण्मयैः॥२८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 218,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "महीवर्णनम्",
      "combined_translation": "28-28"
    },
    {
      "verse": 29,
      "sanskrit": "काञ्चनीभिः शिलाभिश्च गुहाभिश्च विभूषितम्। समाकुलं सूर्यनिभैः शालैस्तालैश्च भास्वरैः॥२९॥",
      "english": null,
      "bhavadeepa": "अकरोदिति। शैलेन्द्रम् अस्ताचलमित्यर्थः॥२८॥",
      "chapter": 218,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "महीवर्णनम्",
      "combined_translation": "29-29"
    },
    {
      "verse": 30,
      "sanskrit": "शुशुभे जातरूपश्च श्रीमद्भिश्चित्रवेदिकैः। षष्टिं गिरिसहस्राणि तत्रासौ संन्यवेशयत्॥३०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 218,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "महीवर्णनम्",
      "combined_translation": "30-30"
    },
    {
      "verse": 31,
      "sanskrit": "मेरुप्रतिमरूपाणि वपुषा प्रभया सह। सहस्रजलधारं च पर्वतं मेरुसन्निभम्॥३१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 218,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "महीवर्णनम्",
      "combined_translation": "31-31"
    },
    {
      "verse": 32,
      "sanskrit": "पुण्यतीर्थगुणोपेतं भगवान्त्संन्यवेशयत्। षष्टियोजनविस्तारं तावदेव समुच्छ्रितम्॥३२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 218,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "महीवर्णनम्",
      "combined_translation": "32-32"
    },
    {
      "verse": 33,
      "sanskrit": "आत्मरूपोपमं तत्र वाराहं नाम नामतः। निवेशयामास गिरिं दिव्यं वैडूर्यपर्वतम्॥३३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 218,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "महीवर्णनम्",
      "combined_translation": "33-33"
    },
    {
      "verse": 34,
