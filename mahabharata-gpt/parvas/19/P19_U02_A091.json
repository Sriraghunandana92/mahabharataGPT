  "adhyaya_name": "वज्रनाभवधवृत्तान्तः-०९१",
  "chapter": 146,
  "verse_count": 54,
  "verses": [
    {
      "verse": 1,
      "sanskrit": "जनमेजय उवाच।\n              भानुमत्यापहरणं विजयं केशवस्य च॥१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 146,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "वज्रनाभवधवृत्तान्तः-०९१"
    },
    {
      "verse": 2,
      "sanskrit": "क्रीडां च सागरे दिव्यां वृष्णीनामतितेजसाम्। अश्रौषं परमाश्चर्यं मुने धर्मभृतां वर॥२॥",
      "english": null,
      "bhavadeepa": "भानुमत्यापहरणमिति॥१॥",
      "chapter": 146,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "वज्रनाभवधवृत्तान्तः-०९१",
      "combined_translation": "2-2"
    },
    {
      "verse": 3,
      "sanskrit": "वज्रनाभवधं युक्तं निकुम्भवधकीर्तने। तन्मे कौतूहलं श्रोतुं प्रसादाद्भवतो मुने॥३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 146,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "वज्रनाभवधवृत्तान्तः-०९१",
      "combined_translation": "3-3"
    },
    {
      "verse": 4,
      "sanskrit": "वैशम्पायन उवाच।\n              हन्त ते वर्तयिष्यामि वज्रनाभवधं नृप। विजयं चैव कामस्य साम्बस्यैव च भारत॥४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 146,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "वज्रनाभवधवृत्तान्तः-०९१",
      "combined_translation": "4-4"
    },
    {
      "verse": 5,
      "sanskrit": "मेरोः सानौ नरपते तपश्चक्रे महासुरः। वज्रनाभ इति ख्यातो निश्चितः समितिञ्जयः॥५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 146,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "वज्रनाभवधवृत्तान्तः-०९१",
      "combined_translation": "5-5"
    },
    {
      "verse": 6,
      "sanskrit": "तस्य तुष्टो महातेजा ब्रह्मा लोकपितामहः। वरेण च्छन्दयामास तपसा परितोषितः॥६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 146,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "वज्रनाभवधवृत्तान्तः-०९१",
      "combined_translation": "6-6"
    },
    {
      "verse": 7,
      "sanskrit": "अवध्यत्वं स देवेब्यो वव्रे दानवसत्तमः। पुरं वज्रपुरं चापि सर्वरत्नमयं शुभम्॥७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 146,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "वज्रनाभवधवृत्तान्तः-०९१",
      "combined_translation": "7-7"
    },
    {
      "verse": 8,
      "sanskrit": "स्वच्छन्देन प्रवेशश्च न वायोरपि भारत। अचिन्तितेन कामानामुपपत्तिर्नराधिप॥८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 146,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "वज्रनाभवधवृत्तान्तः-०९१",
      "combined_translation": "8-8"
    },
    {
      "verse": 9,
      "sanskrit": "शाखानगरमुख्यानां संवाहानां शतानि च। नगरस्याप्रमेयस्य समन्ताज्जनमेजय॥९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 146,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "वज्रनाभवधवृत्तान्तः-०९१",
      "combined_translation": "9-9"
    },
    {
      "verse": 10,
      "sanskrit": "तथा तदभवत्तस्य वरदानेन भारत। उवास वज्रनगरे वज्रनाभो महासुरः॥१०॥",
      "english": null,
      "bhavadeepa": "शाखानगरं चतुर्दिक्षु संवाहानां सप्राकाराणामुद्यानानाम्॥९॥",
      "chapter": 146,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "वज्रनाभवधवृत्तान्तः-०९१",
      "combined_translation": "10-10"
    },
    {
      "verse": 11,
      "sanskrit": "कोटिशो वरलब्धं तमसुराः परिवार्य ते। ऊषुर्वज्रपुरे राजन्संवाहेषु तथैव च॥११॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 146,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "वज्रनाभवधवृत्तान्तः-०९१",
      "combined_translation": "11-11"
    },
    {
      "verse": 12,
      "sanskrit": "शाखानगरमुख्येषु रम्येषु च नराधिप। हृष्टपुष्टप्रमुदिता नृप देवस्य शत्रवः॥१२॥",
      "english": null,
      "bhavadeepa": "वरलब्धं लब्धवरम्॥११॥",
      "chapter": 146,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "वज्रनाभवधवृत्तान्तः-०९१",
      "combined_translation": "12-12"
    },
    {
      "verse": 13,
      "sanskrit": "वज्रनाभोऽथ दुष्टात्मा वरदानेन दर्पितः। पुरेऽस्य चात्मनश्चैव जगद्बाधितुमुद्यतः॥१३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 146,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "वज्रनाभवधवृत्तान्तः-०९१",
      "combined_translation": "13-13"
    },
    {
      "verse": 14,
      "sanskrit": "महेन्द्रमब्रवीद्गत्वा देवलोकं विशाम्पते। अहमीशितुमिच्छामि त्रैलोक्यं पाकशासन॥१४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 146,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "वज्रनाभवधवृत्तान्तः-०९१",
      "combined_translation": "14-14"
    },
    {
      "verse": 15,
      "sanskrit": "अथवा मे प्रयच्छस्व युद्धं देवगणेश्वर। सामान्यं हि जगत्कृत्स्नं काश्यपानां महात्मनाम्॥१५॥",
      "english": null,
      "bhavadeepa": "ईशितुं पालितुं त्वं त्वधुना स्वर्गराज्यं त्यजेति भावः॥१४॥",
      "chapter": 146,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "वज्रनाभवधवृत्तान्तः-०९१",
      "combined_translation": "15-15"
    },
    {
      "verse": 16,
      "sanskrit": "स बृहस्पतिना सार्धं मन्त्रयित्वा महेश्वरः। वज्रनाभं सुरश्रेष्ठः प्रोवाच कुरुवंशज॥१६॥",
      "english": null,
      "bhavadeepa": "काश्यपानां देवानाम् अदेवानां च॥१५॥",
      "chapter": 146,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "वज्रनाभवधवृत्तान्तः-०९१",
      "combined_translation": "16-16"
    },
    {
      "verse": 17,
      "sanskrit": "सत्रेषु दीक्षितः सौम्य कश्यपो नः पिता मुनिः। तस्मिन्वृत्ते यथान्याय्यं तथा स हि करिष्यति॥१७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 146,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "वज्रनाभवधवृत्तान्तः-०९१",
      "combined_translation": "17-17"
    },
    {
      "verse": 18,
      "sanskrit": "ततः स पितरं गत्वा कश्यपं दानवोऽब्रवीत्। यथोक्तं देवराजेन तमुवाचाथ कश्यपः॥१८॥",
      "english": null,
      "bhavadeepa": "न्याय्यं न्यायादनपेतम्॥१७॥",
      "chapter": 146,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "वज्रनाभवधवृत्तान्तः-०९१",
      "combined_translation": "18-18"
    },
    {
      "verse": 19,
      "sanskrit": "सत्रे वृत्ते करिष्यामि यथान्यायं भविष्यति। त्वं तु वज्रपुरे पुत्र वस गच्छ समाश्रितः॥१९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 146,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "वज्रनाभवधवृत्तान्तः-०९१",
      "english_ref": 1,
      "combined_translation": "1-19"
    },
    {
      "verse": 20,
      "sanskrit": "एवमुक्ते वज्रनाभः स्वमेव नगरं गतः। महेन्द्रोऽपि ययौ देवो द्वारकां द्वारशालिनीम्॥२०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 146,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "वज्रनाभवधवृत्तान्तः-०९१"
    },
    {
      "verse": 21,
      "sanskrit": "गत्वा चान्तर्हितो देवो वासुदेवमथाब्रवीत्। वज्रनाभस्य वृत्तान्तं तमुवाच जनार्दनः॥२१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 146,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "वज्रनाभवधवृत्तान्तः-०९१"
    },
    {
      "verse": 22,
      "sanskrit": "शौरेरुपस्थितो देव वाजिमेधो महाक्रतुः। तस्मिन्वृत्ते वज्रनाभं पातयिष्यामि वासव॥२२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 146,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "वज्रनाभवधवृत्तान्तः-०९१"
    },
    {
      "verse": 23,
      "sanskrit": "तत्रोपायं प्रवेशे तु चिन्तयावः सतां गतेः। नानिच्छया प्रवेशोऽस्ति तत्र वायोरपि प्रभो॥२३॥",
      "english": null,
      "bhavadeepa": "शौरेः वसुदेवस्य॥२२॥",
      "chapter": 146,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "वज्रनाभवधवृत्तान्तः-०९१"
    },
    {
      "verse": 24,
      "sanskrit": "ततो गतो देवराजो वासुदेवेन सत्कृतः। वाजिमेधे च सम्प्राप्ते वसुदेवस्य भारत॥२४॥",
      "english": null,
      "bhavadeepa": "सतां गतेः ब्रह्मकृतमर्यादाया असङ्गः सतां मार्गः। अतोऽसुरेच्छयैव तत्र प्रवेशो लभ्यते न बलादित्यर्थः॥२३॥",
      "chapter": 146,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "वज्रनाभवधवृत्तान्तः-०९१"
    },
    {
      "verse": 25,
      "sanskrit": "तस्मिन्यज्ञे वर्तमाने प्रवेशार्थं सुरोत्तमौ। चिन्तयामासतुर्वीरौ देवराजाच्युतावुभौ॥२५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 146,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "वज्रनाभवधवृत्तान्तः-०९१"
    },
    {
      "verse": 26,
      "sanskrit": "तत्र यज्ञे वर्तमाने सुनाट्येन नटास्तदा। महर्षींस्तोषयामास भद्रनामेति नामतः॥२६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 146,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "वज्रनाभवधवृत्तान्तः-०९१"
    },
    {
      "verse": 27,
      "sanskrit": "तं वरेण मुनिश्रेष्ठाश्छन्दयामासुरात्मवत्। स वव्रे तु नटो भद्रो वरं देवेश्वरोपमः॥२७॥",
      "english": null,
      "bhavadeepa": "तत्र वसुदेवयज्ञे नाट्येन नृत्येन॥२६॥",
      "chapter": 146,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "वज्रनाभवधवृत्तान्तः-०९१"
    },
    {
      "verse": 28,
      "sanskrit": "देवेन्द्रकृष्णच्छन्देन सरस्वत्या प्रचोदितः। प्रणिपत्य मुनिश्रेष्ठानश्वमेधे समागतान्॥२८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 146,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "वज्रनाभवधवृत्तान्तः-०९१"
    },
    {
      "verse": 29,
      "sanskrit": "नट उवाच।\n              भोज्यो द्विजानां सर्वेषां भवेयं मुनिसत्तमाः। सप्तद्वीपां च पृथिवीं विचरेयमिमामहम्॥२९॥",
      "english": null,
      "bhavadeepa": "देवेन्द्रादिभिरन्तःस्थैः प्रेरित इत्यर्थः॥२८॥",
      "chapter": 146,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "वज्रनाभवधवृत्तान्तः-०९१"
    },
    {
      "verse": 30,
      "sanskrit": "प्रसिद्धाकाशगमनः शक्नुवंश्च विशेषतः। अवध्यः सर्वभूतानां स्थावरा ये च जङ्गमाः॥३०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 146,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "वज्रनाभवधवृत्तान्तः-०९१"
    },
    {
      "verse": 31,
      "sanskrit": "यस्य यस्य च वेषेण प्रविशेयमहं खलु। मृतस्य जीवतो वापि भाव्येनोत्पादितस्य वा॥३१॥",
      "english": null,
      "bhavadeepa": "प्रकर्षेण सिद्धम् आकाशे गमनं यस्य सः तादृशः भवेयमिति शेषः। शक्नुवन् शक्तिमान्॥३०॥",
      "chapter": 146,
      "parva_name": "हरिवंशः",
