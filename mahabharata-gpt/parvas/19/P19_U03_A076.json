  "parva_name": "हरिवंशः",
  "upaparva_name": "भविष्यपर्व",
  "adhyaya_name": "श्रीकृष्णस्य बदरिकाश्रमगमनम्",
  "chapter": 259,
  "verse_count": 36,
  "verses": [
    {
      "verse": 1,
      "sanskrit": "वैशम्पायन उवाच।\n              ततः सञ्चिन्तयामास गरुडं पक्षिपुङ्गवम्। आगच्छ त्वरितं तार्क्ष्य इति विष्णुर्जगत्पतिः॥१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 259,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णस्य बदरिकाश्रमगमनम्"
    },
    {
      "verse": 2,
      "sanskrit": "ततः स भगवांस्तार्क्ष्यो वेदराशिरिति स्मृतः। बलवान्विक्रमी योगी शास्त्रनेता कुरूद्वह॥२॥",
      "english": null,
      "bhavadeepa": "ततः समिति॥१॥",
      "chapter": 259,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णस्य बदरिकाश्रमगमनम्",
      "combined_translation": "2-2"
    },
    {
      "verse": 3,
      "sanskrit": "यज्ञमूर्तिः पुराणात्मा साममूर्धा च पावनः। ऋग्वेदपक्षवान्पक्षी पिङ्गलो जटिलाकृतिः॥३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 259,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णस्य बदरिकाश्रमगमनम्",
      "combined_translation": "3-3"
    },
    {
      "verse": 4,
      "sanskrit": "ताम्रतुण्डः सोमहरः शक्रजेता महाशिराः। पन्नगारिः पद्मनेत्रः साक्षाद्विष्णुरिवापरः॥४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 259,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णस्य बदरिकाश्रमगमनम्",
      "combined_translation": "4-4"
    },
    {
      "verse": 5,
      "sanskrit": "वाहनं देवदेवस्य दानवीगर्भकृन्तनः। राक्षसासुरसङ्घानां जेता पक्षबलेन यः॥५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 259,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णस्य बदरिकाश्रमगमनम्",
      "combined_translation": "5-5"
    },
    {
      "verse": 6,
      "sanskrit": "प्रादुरासीन्महावीर्यः केशवस्याग्रतस्तदा। जानुभ्यामपतद्भूमौ नमो विष्णो जगत्पते॥६॥",
      "english": null,
      "bhavadeepa": "दानवीगर्भकृन्तनः यद्दर्शनमात्राद्दानवानां गर्भा नश्यन्तीत्यर्थः॥५॥",
      "chapter": 259,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णस्य बदरिकाश्रमगमनम्",
      "combined_translation": "6-6"
    },
    {
      "verse": 7,
      "sanskrit": "नमस्ते देवदेवेश हरे स्वामिन्निति ब्रुवन्। पस्पर्श पाणिना कृष्णः स्वागतं तार्क्ष्यपुङ्गवम्॥७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 259,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णस्य बदरिकाश्रमगमनम्",
      "combined_translation": "7-7"
    },
    {
      "verse": 8,
      "sanskrit": "इत्युवाच तदा तार्क्ष्यं यास्ये कैलासपर्वतम्। शूलिनं द्रष्टुमिच्छामि शङ्करं शाश्वतं शिवम्॥८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 259,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णस्य बदरिकाश्रमगमनम्",
      "combined_translation": "8-8"
    },
    {
      "verse": 9,
      "sanskrit": "बाढमित्यब्रवीत्तार्क्ष्य आरुह्यैनं जनार्दनः। तिष्ठध्वमिति होवाच यादवान्पार्श्ववर्तिनः॥९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 259,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णस्य बदरिकाश्रमगमनम्",
      "combined_translation": "9-9"
    },
    {
      "verse": 10,
      "sanskrit": "ततो ययौ जगन्नाथो दिशं प्रागुत्तरां हरिः। रवेण महता तार्क्ष्यस्त्रैलोक्यं समकम्पयत्॥१०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 259,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णस्य बदरिकाश्रमगमनम्",
      "combined_translation": "10-10"
    },
    {
      "verse": 11,
      "sanskrit": "सागरं क्षोभयामास पद्भ्यां पक्षी व्रजंस्तदा। पक्षेण पर्वतान्सर्वान्वहन्देवं जनार्दनम्॥११॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 259,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णस्य बदरिकाश्रमगमनम्",
      "combined_translation": "11-11"
    },
    {
      "verse": 12,
      "sanskrit": "ततो देवाः सगन्धर्वा आकाशेऽधिष्ठितास्तदा। तुष्टुवुः पुण्डरीकाक्षं वाग्भिरिष्टाभिरीश्वरम्॥१२॥",
      "english": null,
      "bhavadeepa": "पक्षेण पक्षवातेन पर्वतान् क्षोभयामासेत्यनुषज्यते॥११॥",
      "chapter": 259,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णस्य बदरिकाश्रमगमनम्",
      "combined_translation": "12-12"
    },
    {
      "verse": 13,
      "sanskrit": "जय देव जगन्नाथ जय विष्णो जगत्पते। जयाजेय नमो देव भूतभावनभावन॥१३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 259,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णस्य बदरिकाश्रमगमनम्",
      "combined_translation": "13-13"
    },
    {
      "verse": 14,
      "sanskrit": "नमः परमसिंहाय दैत्यदानवनाशन। जयाजेय हरे देव योगिध्येय परागत॥१४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 259,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णस्य बदरिकाश्रमगमनम्",
      "combined_translation": "14-14"
    },
    {
      "verse": 15,
      "sanskrit": "नारायण नमो देव कृष्ण कृष्ण हरे हरे। आदिकर्तः पुराणात्मन्ब्रह्मयोने सनातन॥१५॥",
      "english": null,
      "bhavadeepa": "परागत “सा काष्टा सा परा गतिः” इति श्रुत्युक्तपरगतिस्वरूपः। दैर्घ्यमार्षम्॥१४॥",
      "chapter": 259,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णस्य बदरिकाश्रमगमनम्",
      "combined_translation": "15-15"
    },
    {
      "verse": 16,
      "sanskrit": "नमस्ते सकलेशाय निर्गुणाय गुणात्मने। भक्तिप्रियाय भक्ताय नमो दानवनाशन॥१६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 259,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णस्य बदरिकाश्रमगमनम्",
      "combined_translation": "16-16"
    },
    {
      "verse": 17,
      "sanskrit": "अचिन्त्यमूर्तये तुभ्यं नमस्ते सकलेश्वर। इत्यादिभिस्तदा देवं वाग्भिरीशानमव्ययम्॥१७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 259,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णस्य बदरिकाश्रमगमनम्",
      "combined_translation": "17-17"
    },
    {
      "verse": 18,
      "sanskrit": "तुष्टुवुर्देवगन्धर्वा ऋषयः सिद्धचारणाः। शृण्वन्नेवं जगन्नाथः स्तुतिवाक्यानि तानि च॥१८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 259,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णस्य बदरिकाश्रमगमनम्",
      "combined_translation": "18-18"
    },
    {
      "verse": 19,
      "sanskrit": "ययौ सार्धं सुरगणैर्मुनिभिर्वेदपारगैः। यत्र पूर्वं स्वयं विष्णुस्तपस्तेपे सुदारुणम्॥१९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 259,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णस्य बदरिकाश्रमगमनम्",
      "combined_translation": "19-19"
    },
    {
      "verse": 20,
      "sanskrit": "लोकवृद्धिकरः श्रीमाँल्लोकानां हितकाम्यया। वर्षायुतं तपस्तप्तं विष्णुना प्रभविष्णुना॥२०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 259,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णस्य बदरिकाश्रमगमनम्",
      "combined_translation": "20-20"
    },
    {
      "verse": 21,
      "sanskrit": "यत्र विष्णुर्जगन्नाथस्तपस्तप्त्वा सुदारुणम्। द्विधाकरोत्स्वमात्मानं नरनारायणाख्यया॥२१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 259,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णस्य बदरिकाश्रमगमनम्",
      "combined_translation": "21-21"
    },
    {
      "verse": 22,
      "sanskrit": "गङ्गा यत्र सरिच्छ्रेष्ठा मध्ये धावति पावनी। यत्र शक्रः स्वयं हत्वा वृत्रं वेदार्थतत्त्वगम्॥२२॥",
      "english": null,
      "bhavadeepa": "यत्र बदरिकाश्रमे॥२१॥",
      "chapter": 259,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णस्य बदरिकाश्रमगमनम्",
      "combined_translation": "22-22"
    },
    {
      "verse": 23,
      "sanskrit": "ब्रह्महत्याविनाशार्थं तपो वर्षायुतं चरत्। यत्र सिद्धाश्च सिद्धाः स्युर्ध्यात्वा देवं जनार्दनम्॥२३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 259,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णस्य बदरिकाश्रमगमनम्",
      "combined_translation": "23-23"
    },
    {
      "verse": 24,
      "sanskrit": "यत्र हत्वा रणे रामो रावणं लोकरावणम्। एतच्छासनमिच्छंश्च तपो घोरमतप्यत॥२४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 259,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णस्य बदरिकाश्रमगमनम्",
      "combined_translation": "24-24"
    },
    {
      "verse": 25,
      "sanskrit": "देवाश्च मुनयश्चैव सिद्धिं यान्ति शुचिव्रताः। यत्र नित्यं जगन्नाथः साक्षाद्वसति केशवः॥२५॥",
      "english": null,
      "bhavadeepa": "एतत् शासनम् एतां शास्त्राज्ञां शक्रेन कृतां निर्गुणमपि ब्राह्मणं हत्वा ब्रह्महत्याव्रतं चरेदित्येवं इच्छन्पालयितुमपि शेषः॥२४॥",
      "chapter": 259,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णस्य बदरिकाश्रमगमनम्",
      "combined_translation": "25-25"
    },
    {
      "verse": 26,
      "sanskrit": "यत्र यज्ञाः प्रवर्तन्ते नित्यं मुनिगणैः सह। यस्याः स्मरणमात्रेण नरः स्वर्गं गमिष्यति॥२६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 259,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णस्य बदरिकाश्रमगमनम्",
      "combined_translation": "26-26"
    },
    {
      "verse": 27,
      "sanskrit": "स्वर्गसोपानमिच्छन्ति यां पुण्यां मुनिसत्तमाः। शत्रवो मित्रतां यान्ति यत्र नित्यं नृपोत्तमम्॥२७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 259,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णस्य बदरिकाश्रमगमनम्",
      "combined_translation": "27-27"
    },
    {
      "verse": 28,
      "sanskrit": "यामाहुः पुण्यशीलानां स्तानमुत्तमधर्मिणाम्। यत्र विष्णुं समाराध्य देवाः स्वर्गं समाययुः॥२८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 259,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णस्य बदरिकाश्रमगमनम्",
      "combined_translation": "28-28"
    },
    {
      "verse": 29,
      "sanskrit": "सिद्धक्षेत्रमिदं प्राहुरर्ऋषयो वीतमत्सराः। विशालां बदरीं विष्णुस्तां द्रष्टुं सकलेश्वरः॥२९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 259,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णस्य बदरिकाश्रमगमनम्",
      "combined_translation": "29-29"
    },
    {
      "verse": 30,
      "sanskrit": "सायाह्ने चामरगणैर्मुनिभिस्तत्त्वदर्शिभिः। प्रविवेश महापुण्यमृषिजुष्टं तपोवनम्॥३०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 259,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णस्य बदरिकाश्रमगमनम्",
