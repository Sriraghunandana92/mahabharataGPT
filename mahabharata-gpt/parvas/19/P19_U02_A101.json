{
  "adhyaya_id": "P19_U02_A101",
  "book": 19,
  "parva_name": "हरिवंशः",
  "upaparva_name": "विष्णुपर्व",
  "adhyaya_name": "कृष्णपराक्रमवर्णनम्-१०१",
  "chapter": 156,
  "verse_count": 73,
  "verses": [
    {
      "verse": 1,
      "sanskrit": "श्रीकृष्ण उवाच।\n              भवतां पुण्यकीर्तीनां तपोबलसमादिभिः। अपध्यानाच्च पापात्मा भौमः स नरको हतः॥१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 156,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कृष्णपराक्रमवर्णनम्-१०१"
    },
    {
      "verse": 2,
      "sanskrit": "मोक्षितं बन्धनाद्गुप्तं कन्यान्तःपुरमुत्तमम्। मणिपर्वतमुत्पाट्य शिखरं चैतदाहृतम्॥२॥",
      "english": null,
      "bhavadeepa": "भवतामिति॥१॥",
      "chapter": 156,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कृष्णपराक्रमवर्णनम्-१०१"
    },
    {
      "verse": 3,
      "sanskrit": "अयं धनौघः सुमहान्किङ्करैराहृतो मम। ईशा भवन्तो द्रव्यस्य तानुक्त्वा विरराम ह॥३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 156,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कृष्णपराक्रमवर्णनम्-१०१"
    },
    {
      "verse": 4,
      "sanskrit": "तच्छ्रुत्वा वासुदेवस्य भोजवृष्ण्यन्धका वचः। जहसुर्हृष्टरोमाणः पूजयन्तो जनार्दनम्॥४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 156,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कृष्णपराक्रमवर्णनम्-१०१"
    },
    {
      "verse": 5,
      "sanskrit": "ऊचुश्चैनं नृवीरास्ते कृताञ्जलिपुटास्ततः। नैतच्चित्रं महाबाहो त्वयि देवकिनन्दने॥५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 156,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कृष्णपराक्रमवर्णनम्-१०१"
    },
    {
      "verse": 6,
      "sanskrit": "यत्कृत्वा दुष्करं कर्म देवैरपि दुरासदम्। लालयेः स्वजनान्भोगै रत्नैश्च स्वयमर्जितैः॥६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 156,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कृष्णपराक्रमवर्णनम्-१०१"
    },
    {
      "verse": 7,
      "sanskrit": "ततः सर्वदशार्हाणामाहुकस्य च याः स्त्रियः। प्रीयमाणाः समाजग्मुर्वासुदेवदिदृक्षया॥७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 156,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कृष्णपराक्रमवर्णनम्-१०१"
    },
    {
      "verse": 8,
      "sanskrit": "देवकीसप्तमा देव्यो रोहिणी च शुभानना। ददृशुः कृष्णमासीनं रामं चैव महाभुजम्॥८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 156,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कृष्णपराक्रमवर्णनम्-१०१"
    },
    {
      "verse": 9,
      "sanskrit": "तौ तु पूर्वमतिक्रम्य रोहिणीमभिवाद्य च। अभिवादयतां देवीं देवकीं रामकेशवौ॥९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 156,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कृष्णपराक्रमवर्णनम्-१०१"
    },
    {
      "verse": 10,
      "sanskrit": "सा ताभ्यामृषभाक्षाभ्यां पुत्राभ्यां शुशुभेऽम्बिका। अदितिर्देवमातेव मित्रेण वरुणेन च॥१०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 156,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कृष्णपराक्रमवर्णनम्-१०१"
    },
    {
      "verse": 11,
      "sanskrit": "ततः प्राप्ता नराग्र्यौ तु तस्याः सा दुहिता तदा। एकानंशेति यामाहुर्नरा वै कामरूपिणीम्॥११॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 156,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कृष्णपराक्रमवर्णनम्-१०१"
    },
    {
      "verse": 12,
      "sanskrit": "तथा क्षणमुहूर्ताभ्यां यथा जज्ञे सुरेश्वरः। यत्कृते सगणं कंसं जघान पुरुषोत्तमः॥१२॥",
      "english": null,
      "bhavadeepa": "नराग्र्यौ प्रति एकानंशा सा योगमाया दुहिता तस्या यशोदायाः॥११॥",
      "chapter": 156,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कृष्णपराक्रमवर्णनम्-१०१"
    },
    {
      "verse": 13,
      "sanskrit": "सा कन्या ववृधे तत्र वृष्णिसद्मनि पूजिता। पुत्रवत्पाल्यमाना वै वासुदेवाज्ञया तदा॥१३॥",
      "english": null,
      "bhavadeepa": "क्षणः उक्तविधः सङ्केतः मुहूर्तः उक्तः कालश्च ताभ्यां जज्ञे आविर्बभूव॥१२॥",
      "chapter": 156,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कृष्णपराक्रमवर्णनम्-१०१"
    },
    {
      "verse": 14,
      "sanskrit": "एकानंशेति यामाहुरुत्पन्नां मानवा भुवि। योगकन्यां दुराधर्षां रक्षार्थं केशवस्य ह॥१४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 156,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कृष्णपराक्रमवर्णनम्-१०१"
    },
    {
      "verse": 15,
      "sanskrit": "यां वै सर्वे सुमनसः पूजयन्ति स्म यादवाः। देववद्दिव्यपुरुषः कृष्णः संरक्षितो यथा॥१५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 156,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कृष्णपराक्रमवर्णनम्-१०१"
    },
    {
      "verse": 16,
      "sanskrit": "तां च तत्रोपसङ्गम्य प्रियामिव सखीं स्वसाम्। दक्षिणेन कराग्रेण परिजग्राह माधवः॥१६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 156,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कृष्णपराक्रमवर्णनम्-१०१"
    },
    {
      "verse": 17,
      "sanskrit": "तथैव रामोऽतिबलः सम्परिष्वज्य भाविनीम्। मूर्ध्न्युपाघ्राय सव्येन प्रतिजग्राह पाणिना॥१७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 156,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कृष्णपराक्रमवर्णनम्-१०१"
    },
    {
      "verse": 18,
      "sanskrit": "ददृशुस्ताः स्त्रियो मध्ये भगिनीं रामकृष्णयोः। रुक्मपद्मव्यग्रकरां स्त्रियं पद्मालयामिव॥१८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 156,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कृष्णपराक्रमवर्णनम्-१०१"
    },
    {
      "verse": 19,
      "sanskrit": "तथाक्षतमहावृष्ट्या पुष्पैश्च विविधैः शुभैः। अवकीर्य च लाजैस्ताः स्त्रियो जग्मुर्यथालयम्॥१९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 156,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कृष्णपराक्रमवर्णनम्-१०१"
    },
    {
      "verse": 20,
      "sanskrit": "ततस्ते यादवाः सर्वे पूजयन्तो जनार्दनम्। उपोपविविशुः प्रीताः प्रशंसन्तोऽद्भुतं कृतम्॥२०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 156,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कृष्णपराक्रमवर्णनम्-१०१"
    },
    {
      "verse": 21,
      "sanskrit": "पूज्यमानो महाबाहुः पौराणां रतिवर्धनः। विरराज महाकीर्तिर्देवैरिव स तैः सह॥२१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 156,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कृष्णपराक्रमवर्णनम्-१०१"
    },
    {
      "verse": 22,
      "sanskrit": "समासीनेषु सर्वेषु यादवेषु जनार्दनम्। नियोगात्त्रिदशेन्द्रस्य नारदोऽभ्यागमत्सभाम्॥२२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 156,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कृष्णपराक्रमवर्णनम्-१०१"
    },
    {
      "verse": 23,
      "sanskrit": "सोऽथ सम्पूजितः पूज्यः शूरैस्तैर्यदुपुङ्गवैः। करं संस्पृश्य स हरेर्विवेश परमासने॥२३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 156,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कृष्णपराक्रमवर्णनम्-१०१"
    },
    {
      "verse": 24,
      "sanskrit": "सुखोपविष्टस्तान्वृष्णीनुपविष्टानुवाच ह। सम्प्राप्तं शक्रवचनाज्जानीध्वं मां नरर्षभाः॥२४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 156,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कृष्णपराक्रमवर्णनम्-१०१"
    },
    {
      "verse": 25,
      "sanskrit": "शृणुध्वं राजशार्दूलाः कृष्णस्यास्य पराक्रमम्। यानि कर्माणि कृतवान्बाल्यात्प्रभृति केशवः॥२५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 156,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कृष्णपराक्रमवर्णनम्-१०१"
    },
    {
      "verse": 26,
      "sanskrit": "उग्रसेनसुतः कंसः सर्वान्निर्मथ्य यादवान्। राज्यं जग्राह दुर्बुद्धिर्बद्ध्वा पितरमाहुकम्॥२६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 156,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कृष्णपराक्रमवर्णनम्-१०१"
    },
    {
      "verse": 27,
      "sanskrit": "समाश्रित्य जरासन्धं श्वशुरं कुलपांसनः। भोजवृष्ण्यन्धकान्सर्वानवमन्यत दुर्मतिः॥२७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 156,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कृष्णपराक्रमवर्णनम्-१०१"
    },
    {
      "verse": 28,
      "sanskrit": "ज्ञातिकार्यं चिकीर्षुस्तु वसुदेवः प्रतापवान्। उग्रसेनस्य रक्षार्थं स्वपुत्रं पर्यरक्षत॥२८॥",
      "english": null,
      "bhavadeepa": "अवमन्यत तेषाम् अवमानमकरोत्॥२७॥",
      "chapter": 156,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कृष्णपराक्रमवर्णनम्-१०१"
    },
    {
      "verse": 29,
      "sanskrit": "स गोपैः सह धर्मात्मा मथुरोपवने स्थितः। अत्यद्भुतानि कर्माणि कृतवान्मधुसूदनः॥२९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 156,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कृष्णपराक्रमवर्णनम्-१०१"
    },
    {
      "verse": 30,
      "sanskrit": "प्रत्यक्षं शूरसेनानां श्रयते महदद्भुतम्। उत्तानेन शयानेन शकटान्तरचारिणा॥३०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 156,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कृष्णपराक्रमवर्णनम्-१०१"
    },
    {
      "verse": 31,
      "sanskrit": "राक्षसी निहता रौद्रा शकुनीवेषधारिणी। पूतना नाम घोरा सा महाकाया महाबला॥३१॥",
      "english": null,
      "bhavadeepa": "शकटान्तरचारिणा शकटनाशार्थं चेष्टमानेन॥३०॥",
      "chapter": 156,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कृष्णपराक्रमवर्णनम्-१०१"
    },
    {
      "verse": 32,
      "sanskrit": "विषदिग्धं स्तनं रौद्रं प्रयच्छन्ती जनार्दने। ददृशुर्निहतां तां ते राक्षसीं वनगोचराः॥३२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 156,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कृष्णपराक्रमवर्णनम्-१०१"
    },
    {
      "verse": 33,
      "sanskrit": "पुनर्जातोऽयमित्याहुरुक्तस्तस्मादधोक्षजः। अत्यद्भुतमिदं चासीद्यच्छिशुः पुरुषोत्तमः॥३३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 156,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कृष्णपराक्रमवर्णनम्-१०१"
    },
    {
      "verse": 34,
      "sanskrit": "पादाङ्गुष्ठेन शकटं क्रीडमानो व्यलोडयत्। दाम्ना चोलूखले बद्धो विप्रकुर्वन्कुमारकम्॥३४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 156,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कृष्णपराक्रमवर्णनम्-१०१"
    },
    {
      "verse": 35,
      "sanskrit": "बभञ्जार्जुनवृक्षौ द्वौ ख्यातो दामोदरस्तदा। कालियश्च महानागो दुराधर्षो महाबलः॥३५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 156,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कृष्णपराक्रमवर्णनम्-१०१"
    },
    {
      "verse": 36,
      "sanskrit": "क्रीडता वासुदेवेन निर्जितो यमुनाह्रदे। अक्रूरस्य समक्षं च यन्नागभवने विभुः॥३६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 156,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कृष्णपराक्रमवर्णनम्-१०१"
    },
    {
      "verse": 37,
      "sanskrit": "पूज्यमानं तदा नागैर्दिव्यं वपुरधारयत्। शीतवातार्दिता गाश्च दृष्ट्वा कृष्णेन धीमता॥३७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 156,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कृष्णपराक्रमवर्णनम्-१०१"
    },
    {
      "verse": 38,
      "sanskrit": "धृतो गोवर्धनः शैलः सप्तरात्रं महात्मनः। शिशुना वासुदेवेन गवां त्राणार्थमिच्छताम्॥३८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 156,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कृष्णपराक्रमवर्णनम्-१०१"
    },
    {
      "verse": 39,
      "sanskrit": "तथोक्षदुष्टोऽतिबलो महाकायो नराण्तकृत्। गोपतिर्वासुदेवेन हतोऽरिष्टो महासुरः॥३९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 156,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कृष्णपराक्रमवर्णनम्-१०१"
    },
    {
      "verse": 40,
      "sanskrit": "धेनुकः स महाकायो दानवः सुमहाबलः। निहतो वासुदेवेन गवां त्राणाय दुर्मतिः॥४०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 156,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कृष्णपराक्रमवर्णनम्-१०१"
    },
    {
      "verse": 41,
      "sanskrit": "सुनामानममित्रघ्नः सर्वसैन्यपुरस्कृतम्। वृकैर्विद्रावयामास गृहीतं समुपस्थितम्॥४१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 156,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कृष्णपराक्रमवर्णनम्-१०१"
    },
    {
      "verse": 42,
      "sanskrit": "रौहिणेयेन सङ्गम्य वने विचरता पुनः। गोपवेषधरेणैव कंसस्य भयमाहितम्॥४२॥",
      "english": null,
      "bhavadeepa": "सुनाभानमित्यनेन कथान्तरं सूच्यते॥४१॥",
      "chapter": 156,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कृष्णपराक्रमवर्णनम्-१०१"
    },
    {
      "verse": 43,
      "sanskrit": "तथा व्रजगतः शौरिर्दृष्ट्वा युद्धबलं हयम्। प्रग्रहं भोजराजस्य जघान पुरुषोत्तमः॥४३॥",
      "english": null,
      "bhavadeepa": "भयं दैत्यान्तरवधश्रवणजम्॥४२॥",
      "chapter": 156,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कृष्णपराक्रमवर्णनम्-१०१"
    },
    {
      "verse": 44,
      "sanskrit": "प्रलम्बश्च महाबाहो रौहिणेयेन धीमता। दानवो मुष्टिनैकेन कंसामात्यो निपातितः॥४४॥",
      "english": null,
      "bhavadeepa": "प्रग्रहं सहायम्॥४३॥",
      "chapter": 156,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कृष्णपराक्रमवर्णनम्-१०१"
    },
    {
      "verse": 45,
      "sanskrit": "एतौ हि वसुदेवस्य पुत्रौ सुरसुतोपमौ। ववृधाते महावीर्यौ ब्रह्मगार्ग्येण संस्कृतौ॥४५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 156,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कृष्णपराक्रमवर्णनम्-१०१"
    },
    {
      "verse": 46,
      "sanskrit": "जन्मप्रभृति चाप्येतौ गार्ग्येण परमर्षिणा। याथातथ्येन विज्ञाप्य संस्कारं प्रतिपादितौ॥४६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 156,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कृष्णपराक्रमवर्णनम्-१०१"
    },
    {
      "verse": 47,
      "sanskrit": "यदा त्विमौ नरश्रेष्ठौ स्थितौ यौवनसंमुखे। सिंहशावाविवोदीर्णौ मत्तौ हैमवतौ यथा॥४७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 156,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कृष्णपराक्रमवर्णनम्-१०१"
    },
    {
      "verse": 48,
      "sanskrit": "ततो मनांसि गोपीनां हरमाणौ महाबलौ। आस्तां गोष्ठवरौ वीरौ देवपुत्रोपमद्युती॥४८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 156,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कृष्णपराक्रमवर्णनम्-१०१"
    },
    {
      "verse": 49,
      "sanskrit": "एतौ जये वा युद्धे वा क्रीडासु विविधासु च। नन्दगोपस्य गोपाला न शेकुः प्रसमीक्षितुम्॥४९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 156,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कृष्णपराक्रमवर्णनम्-१०१"
    },
    {
      "verse": 50,
      "sanskrit": "व्यूढोरस्कौ महाबाहू शालस्कन्धाविवोद्गतौ। श्रुत्वासौ व्यथितः कंसो मन्त्रिभिः सहितोऽभवत्॥५०॥",
      "english": null,
      "bhavadeepa": "नन्दगोपस्य सुताविति शेषः॥४९॥",
      "chapter": 156,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कृष्णपराक्रमवर्णनम्-१०१"
    },
    {
      "verse": 51,
      "sanskrit": "नाशकच्च यदा कंसो ग्रहीतुं बलकेशवौ। निजग्राह ततः क्रोधाद्वसुदेवं सबान्धवम्॥५१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 156,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कृष्णपराक्रमवर्णनम्-१०१"
    },
    {
      "verse": 52,
      "sanskrit": "सहोग्रसेनेन तदा चोरवद्गाढबन्धनम्। कालं महान्तमसुवत्कृच्छ्रमानकदुन्दुभिः॥५२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 156,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कृष्णपराक्रमवर्णनम्-१०१"
    },
    {
      "verse": 53,
      "sanskrit": "कंसस्तु पितरं बद्ध्वा शूरसेनाञ्शशास ह। जरासन्धं समाश्रित्य तथैवाह्वृतिभीष्मकौ॥५३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 156,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कृष्णपराक्रमवर्णनम्-१०१"
    },
    {
      "verse": 54,
      "sanskrit": "कस्यचित्त्वथ कालस्य मथुराया महोत्सवम्। पिनाकिनं समुद्दिश्य चक्रे कंसो नराधिपः॥५४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 156,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कृष्णपराक्रमवर्णनम्-१०१"
    },
    {
      "verse": 55,
      "sanskrit": "तत्र मल्लाः समाजग्मुर्नानादेश्या विशाम्पते। नर्तना गायनाश्चैव कुशला नृत्यकर्मसु॥५५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 156,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कृष्णपराक्रमवर्णनम्-१०१"
    },
    {
      "verse": 56,
      "sanskrit": "ततः कंसो महातेजा रङ्गवाटं महाधनम्। कुशलैः कारयामास शिल्पिभिः साधुनिष्ठितैः॥५६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 156,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कृष्णपराक्रमवर्णनम्-१०१"
    },
    {
      "verse": 57,
      "sanskrit": "तत्र मञ्चसहस्राणि पौरजानपदैर्जनैः। समाकीर्णानि दृश्यन्ते ज्योतींषि गगने यथा॥५७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 156,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कृष्णपराक्रमवर्णनम्-१०१",
      "english_ref": 36,
      "combined_translation": "36-57"
    },
    {
      "verse": 58,
      "sanskrit": "भोजराजः श्रिया जुष्टं रङ्गवाटं महर्धिमत्। आरुरोह ततः कंसो विमानं सुकृती यथा॥५८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 156,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कृष्णपराक्रमवर्णनम्-१०१"
    },
    {
      "verse": 59,
      "sanskrit": "रङ्गवाटे गजं मत्तं प्रभूतायुधकल्पितम्। शूरैरधिष्ठितः कंसः स्थापयामास वीर्यवान्॥५९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 156,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कृष्णपराक्रमवर्णनम्-१०१"
    },
    {
      "verse": 60,
      "sanskrit": "यदा हि स महातेजा रामकृष्णौ समागतौ। शुश्राव पुरुषव्याघ्रौ सूर्याचन्द्रमसाविव॥६०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 156,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कृष्णपराक्रमवर्णनम्-१०१"
    },
    {
      "verse": 61,
      "sanskrit": "तदाप्रभृति यत्नोऽभूद्रक्षां प्रति नराधिप। न च शिश्ये सुखं रात्रौ रामकृष्णौ विचिन्तयन्॥६१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 156,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कृष्णपराक्रमवर्णनम्-१०१"
    },
    {
      "verse": 62,
      "sanskrit": "श्रुत्वा तु रामः कृष्णश्च तं समाजमनुत्तमम्। उभौ विविशतुर्वीरौ शार्दूलौ गोव्रजं यथा॥६२॥",
      "english": null,
      "bhavadeepa": "शिश्ये शयनं कृतवान्॥६१॥",
      "chapter": 156,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कृष्णपराक्रमवर्णनम्-१०१"
    },
    {
      "verse": 63,
      "sanskrit": "ततः प्रवेशे संरुद्धौ रक्षिभिः पुरुषर्षभौ। हत्वा कुवलयापीडं ससादिनमरिन्दमौ। अवमृद्य दुराधर्षौ रङ्गं विविशतुस्तदा॥६३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 156,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कृष्णपराक्रमवर्णनम्-१०१"
    },
    {
      "verse": 64,
      "sanskrit": "चाणूरान्ध्रौ विनिष्पिष्य केशवेन बलेन च। औग्रसेनिः सुदुष्टात्मा सानुजो विनिपातितः॥६४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 156,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कृष्णपराक्रमवर्णनम्-१०१"
    },
    {
      "verse": 65,
      "sanskrit": "यत्कृतं यदुसिंहेन देवैरपि सुदुष्करम्। कर्म तत्केशवादन्यः कर्तुमर्हति कः पुमान्॥६५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 156,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कृष्णपराक्रमवर्णनम्-१०१"
    },
    {
      "verse": 66,
      "sanskrit": "यदि नाधिगतं पूर्वैः प्रह्लादबलिशम्बरैः। तदिदं प्रापितं वित्तं शौरिणा भवतां कृते॥६६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 156,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कृष्णपराक्रमवर्णनम्-१०१"
    },
