  "adhyaya_name": "हंसडिम्भकयोर्मृगया",
  "chapter": 289,
  "verse_count": 17,
  "verses": [
    {
      "verse": 1,
      "sanskrit": "वैशम्पायन उवाच।\n              ततः कदाचित्तौ वीरौ मृगयामटतुः किल। जनार्दनेन सहितौ रथैरश्वगजैरपि॥१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 289,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हंसडिम्भकयोर्मृगया",
      "combined_translation": "1-28"
    },
    {
      "verse": 2,
      "sanskrit": "वनं गत्वा तु तौ वीरौ सिंहव्याघ्रांश्च जघ्नतुः। शितैर्बाणैर्महाराज वराहानथ सर्वशः॥२॥",
      "english": null,
      "bhavadeepa": "तत इति॥१॥",
      "chapter": 289,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हंसडिम्भकयोर्मृगया",
      "combined_translation": "2-2"
    },
    {
      "verse": 3,
      "sanskrit": "व्यालानन्यान्मृगान्हिंस्राञ्छ्वभिश्च सहितौ नृप। एष आयाति विपुलो वराहो दीर्घलोचनः॥३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 289,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हंसडिम्भकयोर्मृगया",
      "combined_translation": "3-3"
    },
    {
      "verse": 4,
      "sanskrit": "एनं बाणेन सञ्छिन्धि याति चायं मृगाधिपः। अयमन्योऽथ महिषः शृङ्गप्रोतसरीसृपः॥४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 289,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हंसडिम्भकयोर्मृगया",
      "combined_translation": "4-4"
    },
    {
      "verse": 5,
      "sanskrit": "एते खलु मृगाः सार्धं शावैर्बाधन्ति सर्वशः। एतद्भ्रमति सर्वत्र भीतं शशकुलं महत्॥५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 289,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हंसडिम्भकयोर्मृगया",
      "combined_translation": "5-5"
    },
    {
      "verse": 6,
      "sanskrit": "शावं स्तनं पिबत्साधु न हन्तव्यामिदं शुभम्। ग्रहीतव्यमिदं सर्वं निरुध्य श्वगणैरिव॥६॥",
      "english": null,
      "bhavadeepa": "बाधन्ति बाधामनुभवन्ति शावैः पोतैः सहितः॥५॥",
      "chapter": 289,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हंसडिम्भकयोर्मृगया"
    },
    {
      "verse": 7,
      "sanskrit": "इत्यादिशब्दः सुमहान्मृगयां कुर्वतां नृप। क्षत्रियाणां नृपश्रेष्ठ व्याधानां चैव धावताम्॥७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 289,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हंसडिम्भकयोर्मृगया",
      "combined_translation": "7-7"
    },
    {
      "verse": 8,
      "sanskrit": "हत्वा मृगान्सुबहुशो व्याघ्रान् सिंहान्नृपोत्तमौ। श्रमं च जग्मतुर्वीरौ मध्यं याते दिवाकरे॥८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 289,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हंसडिम्भकयोर्मृगया",
      "combined_translation": "8-8"
    },
    {
      "verse": 9,
      "sanskrit": "अलं हि मृगयास्माकं श्रमः समुपजायते। इत्यूचतुर्महाराज पुष्करं जग्मतुः सरः॥९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 289,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हंसडिम्भकयोर्मृगया",
      "combined_translation": "9-9"
    },
    {
      "verse": 10,
      "sanskrit": "सरः समीपमागम्य मुनिसिद्धनिषेवितम्। वीजन्मारुतसानूपं श्रमात्तत्र सुखस्थितौ॥१०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 289,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हंसडिम्भकयोर्मृगया",
      "combined_translation": "10-10"
    },
    {
      "verse": 11,
      "sanskrit": "ततो जनाः सरः सर्वे विगाह्य श्रमकर्षिताः। बिसान्प्रवालान्पद्मानां भक्षयामासुरार्तवत्॥११॥",
      "english": null,
      "bhavadeepa": "अनूपं सजलप्रदेशस्तेन सहितं सानूपं वीजन्मारुतवतात्मना सानूपं चेति विग्रहः॥१०॥",
      "chapter": 289,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हंसडिम्भकयोर्मृगया",
      "combined_translation": "11-11"
    },
    {
      "verse": 12,
      "sanskrit": "जनार्दनेन सहितौ हंसो डिम्भक एव च। सरः क्वचित्समाश्रित्य श्रमं सन्त्यज्य तिष्ठतः॥१२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 289,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हंसडिम्भकयोर्मृगया"
    },
    {
      "verse": 13,
      "sanskrit": "विश्रम्य सरसस्तीरे तदाऽऽसाते सुखं नृपौ। अशृण्वातां परं ब्रह्म मुनिमुख्यैः समीरितम्॥१३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 289,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हंसडिम्भकयोर्मृगया",
      "combined_translation": "13-13"
    },
    {
      "verse": 14,
      "sanskrit": "मध्यन्दिनं तथा सर्वैः सवनं सस्वरं नृपौ। ततः प्रीतौ नृपौ भूत्वा श्रुत्वा वेदध्वनिं तदा॥१४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 289,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हंसडिम्भकयोर्मृगया",
      "combined_translation": "14-14"
    },
    {
      "verse": 15,
      "sanskrit": "ऐच्छेतां तौ तदा द्रष्टुं यज्ञं मुनिकृतं तदा। स्थापयित्वा ततः सेनां सर्वां मृगसमन्विताम्॥१५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 289,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हंसडिम्भकयोर्मृगया",
      "combined_translation": "15-15"
    },
    {
      "verse": 16,
      "sanskrit": "आदाय च महाचापे शरान्कतिचिदेव च। जनार्दनस्तदा वीरौ हंसो डिम्भक एव च॥१६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 289,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हंसडिम्भकयोर्मृगया",
      "combined_translation": "16-16"
    },
    {
      "verse": 17,
      "sanskrit": "पदातिनौ महाराज जग्मतुश्चाश्रमं किल। महर्षेः काश्यपस्याथ सत्रं वैष्णवसंज्ञकम्। यजन्तो मुनिभिः सार्धं जपहोमपरायणैः॥१७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 289,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हंसडिम्भकयोर्मृगया",
      "combined_translation": "17-17"
    }
  ]
}