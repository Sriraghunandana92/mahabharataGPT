{
  "adhyaya_id": "P19_U03_A059",
  "book": 19,
  "parva_name": "हरिवंशः",
  "upaparva_name": "भविष्यपर्व",
  "adhyaya_name": "देवासुरयुद्धे कालप्रह्रादयोर्युद्धम्",
  "chapter": 242,
  "verse_count": 103,
  "verses": [
    {
      "verse": 1,
      "sanskrit": "वैशम्पायन उवाच।\n              वृषपर्वा तु दैत्येन्द्रो विश्वमद्भुतदर्शनम्। निष्कुम्भं योधयामास लोहितार्कसमद्युतिम्॥१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 242,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे कालप्रह्रादयोर्युद्धम्"
    },
    {
      "verse": 2,
      "sanskrit": "क्रोधमूर्छितवक्त्रस्तु धुन्वन्परमकार्मुकम्। धनूंषि प्रेक्ष्य शत्रूणां सारथिं त्वरितोऽब्रवीत्॥२॥",
      "english": null,
      "bhavadeepa": "वृषपर्वा विश्वं विश्वेदेवान्तर्गतं निष्कुम्भं नामतः॥१॥",
      "chapter": 242,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे कालप्रह्रादयोर्युद्धम्",
      "combined_translation": "2-2"
    },
    {
      "verse": 3,
      "sanskrit": "अत्रैव तावत्त्वरितं नय मे सारथे रथम्। एते देवाश्च सहिता घ्नन्ति नः समरे बलम्॥३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 242,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे कालप्रह्रादयोर्युद्धम्",
      "combined_translation": "3-3"
    },
    {
      "verse": 4,
      "sanskrit": "एतान्निहन्तुमिच्छामि समरश्लाघिनो रणे। एतैर्हि दानवानीकं कृतच्छिद्रमिदं महत्॥४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 242,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे कालप्रह्रादयोर्युद्धम्",
      "combined_translation": "4-4"
    },
    {
      "verse": 5,
      "sanskrit": "ततः प्रजविताश्वेन रथेन रथिनां वरः। अरीनभ्यहनत्क्रुद्धः शरजालैर्महासुरः॥५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 242,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे कालप्रह्रादयोर्युद्धम्",
      "combined_translation": "5-5"
    },
    {
      "verse": 6,
      "sanskrit": "न स्थातुं देवताः शक्ताः किं पुनर्योद्धुमाहवे। वृषपर्वेषुनिर्भिन्नाः सर्व एवाभिदुद्रुवुः॥६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 242,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे कालप्रह्रादयोर्युद्धम्",
      "combined_translation": "6-6"
    },
    {
      "verse": 7,
      "sanskrit": "तान्मृत्युवशमापन्नान्वैवस्वतवशं गतान्। समीक्ष्य निहताञ्ज्ञातीनवतस्थे महासुरः॥७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 242,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे कालप्रह्रादयोर्युद्धम्",
      "combined_translation": "7-7"
    },
    {
      "verse": 8,
      "sanskrit": "दृष्ट्वा तं तत्र निष्कुम्भं सर्वे ते त्रिदशोत्त्तमाः। समेत्य सहिताः सर्वे द्रुतं तं पर्यवारयन्॥८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 242,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे कालप्रह्रादयोर्युद्धम्",
      "combined_translation": "8-8"
    },
    {
      "verse": 9,
      "sanskrit": "व्यवस्थितं तु निष्कुम्भं दृष्ट्वा त्रिदशसत्तमम्। बभूवुर्बलवन्तो वै तस्यास्त्रबलतेजसा॥९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 242,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे कालप्रह्रादयोर्युद्धम्",
      "combined_translation": "9-9"
    },
    {
      "verse": 10,
      "sanskrit": "वृषपर्वा तु शैलाभं निष्कुम्भं समरे स्थितम्। महेन्द्र इव धाराभिः शरवर्षैरवाकिरत्॥१०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 242,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे कालप्रह्रादयोर्युद्धम्",
      "combined_translation": "10-10"
    },
    {
      "verse": 11,
      "sanskrit": "अचिन्तयित्वा तु शराञ्छरीरे पतितान्बहून्। स्थितश्च प्रमुखे श्रीमान्ससैन्यः स महाबलः॥११॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 242,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे कालप्रह्रादयोर्युद्धम्",
      "combined_translation": "11-11"
    },
    {
      "verse": 12,
      "sanskrit": "सम्प्रहस्य महातेजा वृषपर्वाणमाहवे। अभिदुद्राव वेगेन कम्पयन्निव मेदिनीम्॥१२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 242,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे कालप्रह्रादयोर्युद्धम्",
      "combined_translation": "12-12"
    },
    {
      "verse": 13,
      "sanskrit": "तस्य त्वाधावमानस्य दीप्यमानस्य तेजसा। बभूव रूपं दुर्धर्षं दीप्तस्येव विभावसोः॥१३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 242,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे कालप्रह्रादयोर्युद्धम्",
      "combined_translation": "13-13"
    },
    {
      "verse": 14,
      "sanskrit": "रथं त्यक्त्वा महातेजाः सक्रोधः समपद्यत। वृक्षमुत्पाटयामास महातालं महोच्छ्रयम्॥१४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 242,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे कालप्रह्रादयोर्युद्धम्",
      "combined_translation": "14-14"
    },
    {
      "verse": 15,
      "sanskrit": "ततश्चिक्षेप तं वृक्षं निष्कुम्भो वृषपर्वणः। तं गृहीत्वा महावृक्षं पाणिनैकेन दानवः॥१५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 242,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे कालप्रह्रादयोर्युद्धम्",
      "combined_translation": "15-15"
    },
    {
      "verse": 16,
      "sanskrit": "विनद्य सुमहानादं भ्रामयित्वा च वीर्यवान्। सगजान्सगजारोहान्सरथान्रथिनस्तथा॥१६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 242,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे कालप्रह्रादयोर्युद्धम्",
      "combined_translation": "16-16"
    },
    {
      "verse": 17,
      "sanskrit": "जघान दानवस्तेन शाखिना त्रिदशांस्तदा। तमन्तकमिव क्रुद्धं समरे प्राणहारिणम्॥१७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 242,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे कालप्रह्रादयोर्युद्धम्",
      "combined_translation": "17-17"
    },
    {
      "verse": 18,
      "sanskrit": "वृषपर्वाणमासाद्य त्रिदशा विप्रदुद्रुवुः। तमापतन्तं सङ्क्रुद्धं त्रिदशानां भयावहम्॥१८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 242,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे कालप्रह्रादयोर्युद्धम्",
      "combined_translation": "18-18"
    },
    {
      "verse": 19,
      "sanskrit": "आलोक्य धन्वी निष्कुम्भश्चुक्रोध च ननाद च। स तत्र निशितैर्बाणैस्त्रिंशद्भिर्मर्मभेदिभिः॥१९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 242,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे कालप्रह्रादयोर्युद्धम्",
      "combined_translation": "19-19"
    },
    {
      "verse": 20,
      "sanskrit": "निर्बिभेद महावीर्यो निष्कुम्भो दानवाधिपम्। शरशक्तिभिरुग्राभिर्दैत्यानामधिपं प्रभुम्॥२०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 242,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे कालप्रह्रादयोर्युद्धम्",
      "combined_translation": "20-20"
    },
    {
      "verse": 21,
      "sanskrit": "विद्धः समरमध्यस्थो रुधिरं प्रास्रवद्बहू। उद्विग्ना मुक्तकेशास्ते भग्नदर्पाः पराजिताः॥२१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 242,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे कालप्रह्रादयोर्युद्धम्",
      "combined_translation": "21-21"
    },
    {
      "verse": 22,
      "sanskrit": "श्वसन्तो दुद्रुवुः सर्वे भयाद्वै वृषपर्वणः। अन्योन्यं प्रममन्थुस्ते त्रासिता वृषपर्वणा॥२२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 242,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे कालप्रह्रादयोर्युद्धम्",
      "combined_translation": "22-22"
    },
    {
      "verse": 23,
      "sanskrit": "पृष्ठवक्त्राः सुसंविग्नाः प्रेक्षमाणा मुहुर्मुहुः। त्यक्तप्रहरणाः सर्वे कृतास्ते वृषपर्वणा॥२३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 242,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे कालप्रह्रादयोर्युद्धम्",
      "combined_translation": "23-23"
    },
    {
      "verse": 24,
      "sanskrit": "सङ्ग्रामे युद्धशौण्डेन तदा निष्कुम्भसैनिकाः। तत्रैव तु महावीर्यः प्रह्लादः कालमाहवे॥२४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 242,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे कालप्रह्रादयोर्युद्धम्",
      "combined_translation": "24-24"
    },
    {
      "verse": 25,
      "sanskrit": "योधयामास रक्ताक्षो हिरण्यकशिपोः सुतः। तस्य दानववीरस्य युद्धकाले जयक्रियाः॥२५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 242,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे कालप्रह्रादयोर्युद्धम्",
      "combined_translation": "25-25"
    },
    {
      "verse": 26,
      "sanskrit": "चकार त्वरया युक्तो भार्गवो विजयावहाः। हुताशनं तर्पयतो ब्राह्मणांश्च नमस्यतः॥२६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 242,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे कालप्रह्रादयोर्युद्धम्",
      "combined_translation": "26-26"
    },
    {
      "verse": 27,
      "sanskrit": "आज्यगन्धप्रतिवहो मारुतः सुरभिर्ववौ। स्रजश्च विविधाश्चित्रा जयार्थमभिमन्त्रिताः॥२७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 242,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे कालप्रह्रादयोर्युद्धम्",
      "combined_translation": "27-27"
    },
    {
      "verse": 28,
      "sanskrit": "प्रह्लादस्य शुभे मूर्धन्याबबन्धोशनाः स्वयम्। कालेन सह सङ्ग्रामे प्रयुद्धस्य महात्मनः॥२८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 242,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे कालप्रह्रादयोर्युद्धम्",
      "combined_translation": "28-28"
    },
    {
      "verse": 29,
      "sanskrit": "प्रह्लादस्यातिवीर्यस्य शान्तिं चक्रे स भार्गवः। दश शिष्यसहस्राणि भार्गवस्य महात्मनः॥२९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 242,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे कालप्रह्रादयोर्युद्धम्",
      "combined_translation": "29-29"
    },
    {
      "verse": 30,
      "sanskrit": "यानि दानववीराणां जेपुः शान्तिमनुत्तमाम्। अथर्वाणमथो दिव्यं ब्रह्मसंस्तवचोदितम्॥३०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 242,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे कालप्रह्रादयोर्युद्धम्",
      "combined_translation": "30-30"
    },
    {
      "verse": 31,
      "sanskrit": "रणप्रवेशसदृशं कर्म वैजयिकं कृतम्। ततः सर्वास्त्रविदुषः समरेष्वनिवर्तिनः॥३१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 242,
      "parva_name": "हरिवंशः",
