{
  "adhyaya_id": "P19_U03_A127",
  "book": 19,
  "parva_name": "हरिवंशः",
  "upaparva_name": "भविष्यपर्व",
  "adhyaya_name": "श्रीकृष्णहंसयोर्युद्धम्",
  "chapter": 310,
  "verse_count": 49,
  "verses": [
    {
      "verse": 1,
      "sanskrit": "वैशम्पायन उवाच।\n              उभौ तौ हंसडिम्भकौ रात्रावेव महागिरिम्। जग्मतुः सहितौ राजन् गोवर्धनमथो नृप॥१॥",
      "english": null,
      "bhavadeepa": "हे नृप। प्रभातकाले गोवर्णने रणः सत्तमः इति ब्रुवन्त इत्यन्वयः। पुष्करदेशादपक्रम्य गोवर्धनं देशं प्रतिपलायिता इत्यर्थः॥४७॥",
      "chapter": 310,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णहंसयोर्युद्धम्",
      "combined_translation": "1-48"
    },
    {
      "verse": 2,
      "sanskrit": "अथ प्रभाते विमले सूर्ये चाभ्युदिते सति। गोवर्धनं जगामाशु केशवः केशिसूदनः॥२॥",
      "english": null,
      "bhavadeepa": "उभौ ताविति॥१॥",
      "chapter": 310,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णहंसयोर्युद्धम्",
      "combined_translation": "2-2"
    },
    {
      "verse": 3,
      "sanskrit": "शैनेयो बलबद्रश्च यादवाः सारणादयः। गन्धर्वैरप्सरोभिश्च नादितं बहुधा गिरिम्॥३॥",
      "english": null,
      "bhavadeepa": "सर्वज्ञो गोविन्दोऽपि सद्यस्तत्र गत गत्याह- अथेति॥२॥",
      "chapter": 310,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णहंसयोर्युद्धम्",
      "combined_translation": "3-3"
    },
    {
      "verse": 4,
      "sanskrit": "जग्मतुः सहितौ राजन् गोवर्धनमथो गिरिम्। गोधनैरथ सैन्यैश्च नादितं बहुधा गिरिम्॥४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 310,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णहंसयोर्युद्धम्",
      "combined_translation": "4-4"
    },
    {
      "verse": 5,
      "sanskrit": "तस्योत्तरं नृपश्रेष्ठ पार्श्वं सम्प्राप्य यादवाः। निकषा यमुनां राजंस्ततो युद्धमवर्तत॥५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 310,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णहंसयोर्युद्धम्"
    },
    {
      "verse": 6,
      "sanskrit": "विव्याध हंसडिम्भकौ वसुदेवश्च सप्तभिः। सारणः पञ्चविंशत्या दशभिः कङ्क एव च॥६॥",
      "english": null,
      "bhavadeepa": "यमिनां निकषा यमिनायाः समीपे॥५॥",
      "chapter": 310,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णहंसयोर्युद्धम्",
      "combined_translation": "6-6"
    },
    {
      "verse": 7,
      "sanskrit": "हंसेन डिम्भकेनाथ यादवैश्च समन्ततः। उग्रसेनस्त्रिसप्तत्या शराणां नतपर्वणाम्॥७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 310,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णहंसयोर्युद्धम्",
      "combined_translation": "7-7"
    },
    {
      "verse": 8,
      "sanskrit": "विराटस्त्रिंशता राजन्सात्यकिश्चापि सप्तभिः। अशीत्या विपृथू राजन्नुद्धवो दशभिः शरैः॥८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 310,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णहंसयोर्युद्धम्",
      "combined_translation": "8-8"
    },
    {
      "verse": 9,
      "sanskrit": "प्रद्युम्नस्त्रिंशता राजन्साम्बश्चापि च सप्तभिः। अनाधृष्टिस्त्वेकषष्ट्या शराणां नतपर्वाणाम्॥९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 310,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णहंसयोर्युद्धम्",
      "combined_translation": "9-9"
    },
    {
      "verse": 10,
      "sanskrit": "एवं ते सहिता राजंश्चक्रुर्युद्धमदीनवत्। अत्यद्भूतं महाघोरं यादवाः सर्व एव हि॥१०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 310,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णहंसयोर्युद्धम्",
      "combined_translation": "10-10"
    },
    {
      "verse": 11,
      "sanskrit": "चक्रुस्ताभ्यां महायुद्धं वासुदेवस्य पश्यतः। सर्वानपि महाराज यादवान्बलदर्पितान्॥११॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 310,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णहंसयोर्युद्धम्",
      "combined_translation": "11-11"
    },
    {
      "verse": 12,
      "sanskrit": "तावुभौ हंसडिम्भकौ नृपांस्तान्प्रत्यविध्यताम्। प्रत्येकं दशभिर्विद्ध्वा बाणैर्निशितकोमलैः॥१२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 310,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णहंसयोर्युद्धम्",
      "combined_translation": "12-12"
    },
    {
      "verse": 13,
      "sanskrit": "जघ्नतुश्च शरैस्तीक्ष्णैरत्यर्थं यादवेश्वरान्। व्यथिताः सर्व एवैते वमन्तः शोणितं बहु॥१३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 310,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णहंसयोर्युद्धम्",
      "combined_translation": "13-13"
    },
    {
      "verse": 14,
      "sanskrit": "माधवे किंशुका राजन्पुष्पिता इव ते बभुः। भीताश्च यादवा राजन्पलायनपरायणाः॥१४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 310,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णहंसयोर्युद्धम्",
      "combined_translation": "14-14"
    },
    {
      "verse": 15,
      "sanskrit": "एतास्मन्नतरे राजन्वसुदेवात्मजो नृप। वासुदेवो हली युद्धे प्रमुखे धन्विनौ तयोः॥१५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 310,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णहंसयोर्युद्धम्",
      "combined_translation": "15-15"
    },
    {
      "verse": 16,
      "sanskrit": "चक्रतुर्युद्धमतुलं स्कन्दशक्राविवाम्बरे। तयोरेव सगन्धर्वाः सिद्धा यक्षा महर्षयः॥१६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 310,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णहंसयोर्युद्धम्",
      "combined_translation": "16-16"
    },
    {
      "verse": 17,
      "sanskrit": "विमानस्थाश्च ददृशुर्युद्धं देवासुरोपमम्। ततः प्रादुरभूतां तौ दूतौ भूतेश्वरौ नृप॥१७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 310,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णहंसयोर्युद्धम्",
      "combined_translation": "17-17"
    },
    {
      "verse": 18,
      "sanskrit": "शूलिना प्रेषितौ युद्धे रक्षार्थं बलिनोस्तयोः। हंसोऽथ वासुदेवश्च युद्धं चक्रतुरीश्वरौ॥१८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 310,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णहंसयोर्युद्धम्",
      "combined_translation": "18-18"
    },
    {
      "verse": 19,
      "sanskrit": "रामश्च डिम्भकश्चैव सम्युक्तौ युद्धकाङ्क्षया। विशून्याः सर्व एवैते ह्यस्त्रे शस्त्रे तथा बले॥१९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 310,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णहंसयोर्युद्धम्",
      "combined_translation": "19-19"
    },
    {
      "verse": 20,
      "sanskrit": "शङ्खान्दध्मुः पृथग्घ्नादं स्वे स्वे सर्वे रथे स्थिताः। अथ कृष्णो हृषीकेशः पाञ्चजन्यं महारवम्॥२०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 310,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णहंसयोर्युद्धम्",
      "combined_translation": "20-20"
    },
    {
      "verse": 21,
      "sanskrit": "दध्मौ पद्मपलाशाक्षः सर्वान्विस्मापयन्निव। अथ भूतौ महाघोरौ लम्बोदरशरीरिणौ॥२१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 310,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णहंसयोर्युद्धम्",
      "combined_translation": "21-21"
    },
    {
      "verse": 22,
      "sanskrit": "दुद्रुवतुर्माहराज शूलमादाय केशवम्। शूलेन पोथयां राजञ्चक्रतुर्यादवेश्वरम्॥२२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 310,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णहंसयोर्युद्धम्",
      "combined_translation": "22-22"
    },
    {
      "verse": 23,
      "sanskrit": "ताभ्यां समाहतो विष्णुर्देवगन्धर्वसन्निधौ। ईशत्स्मिताधरो देवः किञ्चिदुत्प्लुत्य सत्वरम्॥२३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 310,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णहंसयोर्युद्धम्",
      "combined_translation": "23-23"
    },
    {
      "verse": 24,
      "sanskrit": "रथाद्रथिवरश्रेष्ठस्तौ प्रगृह्य जनार्दनः। भ्रामयित्वा शतगुणमलातमिव केशवः॥२४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 310,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णहंसयोर्युद्धम्"
    },
    {
      "verse": 25,
      "sanskrit": "कैलासं च समुद्दिश्य प्रचिक्षेप ततो हरिः। तावुपेत्य गिरेः शृङ्गं कैलासस्य महामते॥२५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 310,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णहंसयोर्युद्धम्",
      "combined_translation": "25-25"
    },
    {
      "verse": 26,
      "sanskrit": "दृष्ट्वा तत्कर्म देवस्य विस्मयं जग्मतुः परम्। हंसश्च दृष्ट्वा तत्कर्म रोषताम्रायतेक्षणः॥२६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 310,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णहंसयोर्युद्धम्",
      "combined_translation": "26-26"
    },
    {
      "verse": 27,
      "sanskrit": "उवाच वचनं हंसः शृण्वतां त्रिदिवौकसाम्। किमर्थं राजसूयस्य विघ्नं चरसि केशव॥२७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 310,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णहंसयोर्युद्धम्",
      "combined_translation": "27-27"
    },
    {
      "verse": 28,
      "sanskrit": "ब्रह्मदत्तो महीपालो यष्टा तस्य महाक्रतोः। करं दिश यथायोगं यदि प्राणान्हि रक्षसि॥२८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 310,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णहंसयोर्युद्धम्",
      "combined_translation": "28-28"
    },
    {
      "verse": 29,
      "sanskrit": "अथवा त्वं क्षणं तिष्ठ ततो ज्ञात्वा परं बहु। ददासि त्वं नन्दपुत्र ततो यष्टा स मे गुरुः॥२९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 310,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णहंसयोर्युद्धम्",
      "combined_translation": "29-29"
    },
    {
      "verse": 30,
      "sanskrit": "ईश्वरोऽहं सदा राज्ञां देवानामिव शूलभृत्। एष ते वीर्यमतुलं नाशयिष्यामि संयुगे॥३०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 310,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णहंसयोर्युद्धम्",
      "combined_translation": "30-30"
    },
    {
      "verse": 31,
      "sanskrit": "इत्युक्त्वा सशरं चापं शालतालोपमं नृप। आकृष्य च यथाप्राणं नाराचेन च केशवम्॥३१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 310,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णहंसयोर्युद्धम्",
      "combined_translation": "31-31"
    },
