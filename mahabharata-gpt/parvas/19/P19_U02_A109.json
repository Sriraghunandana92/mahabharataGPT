  "adhyaya_name": "बलदेवाह्निकम्-१०९",
  "chapter": 164,
  "verse_count": 107,
  "verses": [
    {
      "verse": 1,
      "sanskrit": "वैशम्पायन उवाच।\n              अत्राश्चर्यात्मकं स्तोत्रमाह्निकं जयतां वर। प्रद्युम्ने द्वारकां प्राप्ते हत्वा तं कालशम्बरम्॥१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 164,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "बलदेवाह्निकम्-१०९"
    },
    {
      "verse": 2,
      "sanskrit": "बलदेवेन रक्षार्थं प्रोक्तमाह्निकमुच्यते। यज्जप्त्वा तु नृपश्रेष्ठ सायं पूतात्मतां व्रजेत्॥२॥",
      "english": null,
      "bhavadeepa": "अत्राश्चर्येति॥१॥",
      "chapter": 164,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "बलदेवाह्निकम्-१०९",
      "combined_translation": "2-2"
    },
    {
      "verse": 3,
      "sanskrit": "कीर्तितं बलदेवेन विष्णुना चैव कीर्तितम्। धर्मकामैश्च मुनिभिर्ऋषिभिश्चापि कीर्तितम्॥३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 164,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "बलदेवाह्निकम्-१०९",
      "combined_translation": "3-3"
    },
    {
      "verse": 4,
      "sanskrit": "कर्हिचिद्रुक्मिणीपुत्रो हलिना संयुतो गृहे। उपविष्टः प्रणम्याथ तमुवाच कृताञ्जलिः॥४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 164,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "बलदेवाह्निकम्-१०९",
      "combined_translation": "4-4"
    },
    {
      "verse": 5,
      "sanskrit": "प्रद्युम्न उवाच।\n              कृष्णानुज महाभाग रोहिणीतनय प्रभो। किञ्चित्स्तोत्रं मम ब्रूहि यज्जप्त्वा निर्भयोऽभवम्॥५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 164,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "बलदेवाह्निकम्-१०९",
      "combined_translation": "5-5"
    },
    {
      "verse": 6,
      "sanskrit": "बलदेव उवाच।\n              सुरासुरगुरुर्ब्रह्मा पातु मां जगतः पतिः। अथोङ्कारवषट्कारौ सावित्री विधयस्त्रयः॥६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 164,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "बलदेवाह्निकम्-१०९",
      "combined_translation": "6-6"
    },
    {
      "verse": 7,
      "sanskrit": "ऋचो यजूंषि सामानि छन्दांस्याथर्वणानि च। चत्वारस्त्वखिला वेदाः सरहस्याः सविस्तराः॥७॥",
      "english": null,
      "bhavadeepa": "विधयस्त्रयः अपूर्वविधिर्नियमविधिः परिसङ्ख्याविधिश्चेति मीमांसकप्रसिद्धाः॥६॥",
      "chapter": 164,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "बलदेवाह्निकम्-१०९",
      "combined_translation": "7-47"
    },
    {
      "verse": 8,
      "sanskrit": "पुराणमितिहासाश्चाखिलान्युपखिलानि च। अङ्गान्युपाङ्गानि तथा व्याख्यातानि च पान्तु माम्॥८॥",
      "english": null,
      "bhavadeepa": "ऋच इत्युगाद्याभिमानिनी देवता लक्ष्यते॥७॥",
      "chapter": 164,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "बलदेवाह्निकम्-१०९",
      "combined_translation": "8-8"
    },
    {
      "verse": 9,
      "sanskrit": "पृथिवी वायुराकाशमापो ज्योतिश्च पञ्चमम्। इन्द्रियाणि मनो बुद्धिस्तथा सत्त्वं रजस्तमः॥९॥",
      "english": "प्राण-ऐर् abiding in the area of heart makes the foods and drinks enter the stomach, thus helps nourishment of the body; अपान-ऐर् abiding in sacral area facilitates excretion of मल, मूत्र, रेतस्; समान-ऐर् residing in abdominal region facilitates digestion-balance; समान-ऐर् abiding in the area of throat facilitates speech function; व्यान-ऐर् pervades whole inner space facilitates sweat, tears etc; thus the five vital airs enter the physique made up of five subtle elements – solidity, liquidity, resplendence, gaseousness, voidness, and blent with senses will undertake their functions...",
      "bhavadeepa": null,
      "chapter": 164,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "बलदेवाह्निकम्-१०९",
      "combined_translation": "9-59"
    },
    {
      "verse": 10,
      "sanskrit": "व्यानोदानौ समानश्च प्राणोऽपानश्च पञ्चमः। वायवः सप्त चैवान्ये येष्वायत्तमिदं जगत्॥१०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 164,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "बलदेवाह्निकम्-१०९",
      "combined_translation": "10-57"
    },
    {
      "verse": 11,
      "sanskrit": "मरीचिरङ्गिरात्रिश्च पुलस्त्यः पुलहः क्रतुः। भृगुर्वसिष्ठो भगवान्पान्तु ते मां महर्षयः॥११॥",
      "english": null,
      "bhavadeepa": "सप्त वायवः “आवहः प्रवहश्चैव उद्वहः संवहस्तथा। विवहः प्रण्वहश्चैव तथा परिवहोऽनिलः॥” इत्यन्यत्र प्रोक्ताः॥१०॥",
      "chapter": 164,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "बलदेवाह्निकम्-१०९",
      "combined_translation": "11-11"
    },
    {
      "verse": 12,
      "sanskrit": "कश्यपाद्याश्च मुनयश्चतुर्दश दिशो दश। नरनारायणौ देवौ सगणौ पान्तु मां सदा॥१२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 164,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "बलदेवाह्निकम्-१०९",
      "combined_translation": "12-12"
    },
    {
      "verse": 13,
      "sanskrit": "रुद्राश्चैकादश प्रोक्ता आदित्या द्वादशैव तु। अष्टौ च वसवो देवा अश्विनौ द्वौ प्रकीर्तितौ॥१३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 164,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "बलदेवाह्निकम्-१०९",
      "combined_translation": "13-13"
    },
    {
      "verse": 14,
      "sanskrit": "ह्रीः श्रीर्लक्ष्मीः स्वधा पुष्टिर्मेधा तुष्टिः स्मृतिर्धृतिः। अदितिर्दितिर्दनुश्चैव सिंहिका दैत्यमातरः॥१४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 164,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "बलदेवाह्निकम्-१०९",
      "combined_translation": "14-14"
    },
    {
      "verse": 15,
      "sanskrit": "हिमवान्हेमकूटश्च निषधः श्वेतपर्वतः। ऋषभः पारियात्रश्च विन्ध्यो वैडूर्यपर्वतः॥१५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 164,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "बलदेवाह्निकम्-१०९",
      "combined_translation": "15-15"
    },
    {
      "verse": 16,
      "sanskrit": "सह्योदयश्च मलयो मेरुमन्दरदर्दुराः। क्रौञ्चकैलासमैनाकाः पान्तु मां धरणीधराः॥१६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 164,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "बलदेवाह्निकम्-१०९",
      "combined_translation": "16-16"
    },
    {
      "verse": 17,
      "sanskrit": "शेषश्च वासुकिश्चैव विशालाक्षश्च तक्षकः। एलापत्रः शुक्लवर्णः कम्बलाश्वतरावुभौ॥१७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 164,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "बलदेवाह्निकम्-१०९",
      "combined_translation": "17-17"
    },
    {
      "verse": 18,
      "sanskrit": "हस्तिभद्रः पिटरकः कर्कोटकधनञ्जयौ। तथा पूरणकश्चैव नागश्च करवीरकः॥१८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 164,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "बलदेवाह्निकम्-१०९",
      "combined_translation": "18-18"
    },
    {
      "verse": 19,
      "sanskrit": "सुमनास्यो दधिमुखस्तथा शृङ्गारपिण्डकः। मणिनागश्च भगवांस्त्रिषु लोकेषु विश्रुतः॥१९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 164,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "बलदेवाह्निकम्-१०९",
      "combined_translation": "19-19"
    },
    {
      "verse": 20,
      "sanskrit": "नागराडधिकर्णश्च तथा हारिद्रकोऽपरः। एते चान्ये च बहवो ये चान्ये नानुकीर्तिताः॥२०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 164,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "बलदेवाह्निकम्-१०९",
      "combined_translation": "20-20"
    },
    {
      "verse": 21,
      "sanskrit": "भूधराः सत्यधर्माणः पान्तु मां भुजगेश्वराः। समुद्राः पान्तु चत्वारो गङ्गा च सरितां वरा॥२१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 164,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "बलदेवाह्निकम्-१०९",
      "english_ref": 1,
      "combined_translation": "1-21"
    },
    {
      "verse": 22,
      "sanskrit": "सरस्वती चन्द्रभागा शतद्रुर्देविका शिवा। द्वारावती विपाशा च शरयूर्यमुना तथा॥२२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 164,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "बलदेवाह्निकम्-१०९"
    },
    {
      "verse": 23,
      "sanskrit": "कल्माशी च रथोष्मा च बाहुदा च हिरण्यदा। प्लक्षा चेक्षुमती चैव स्रवन्ती च बृहद्रथा॥२३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 164,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "बलदेवाह्निकम्-१०९"
    },
    {
      "verse": 24,
      "sanskrit": "ख्याता चर्मण्वती चैव पुण्या चैव वधूसरा। एताश्चान्याश्च सरितो याश्चान्या नानुकीर्तिताः॥२४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 164,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "बलदेवाह्निकम्-१०९"
    },
    {
      "verse": 25,
      "sanskrit": "उत्तरापथगामिन्यः सलिलैः स्नपयन्तु माम्। वेणी गोदावरी सीता कावेरी कौङ्कणावती॥२५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 164,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "बलदेवाह्निकम्-१०९"
    },
    {
      "verse": 26,
      "sanskrit": "कृष्णा वेणा मुक्तिमती तमसा पुष्पवाहिनी। ताम्रपर्णी ज्योतिरथा उत्फलोदुम्बरावती॥२६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 164,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "बलदेवाह्निकम्-१०९"
    },
    {
      "verse": 27,
      "sanskrit": "नदी वैतरणी पुण्या विदर्भा नर्मदा शुभा। वितस्ता भीमरथ्या च ऐला चैव महानदी॥२७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 164,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "बलदेवाह्निकम्-१०९"
    },
    {
      "verse": 28,
      "sanskrit": "कालिन्दी गोमती पुण्या नदः शोणश्च विश्रुतः। एताश्चन्याश्च वै नद्यो याश्चान्या न तु कीर्तिताः॥२८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 164,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "बलदेवाह्निकम्-१०९"
    },
    {
      "verse": 29,
      "sanskrit": "दक्षिणापथवाहिन्यः सलिलैः स्नपयन्तु माम्। क्षिप्रा चर्मण्वती पुण्या मही शुभ्रवती तथा॥२९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 164,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "बलदेवाह्निकम्-१०९"
    },
    {
      "verse": 30,
      "sanskrit": "सिन्धुर्वेत्रवती चैव भोजान्ता वनमालिका। पूर्वभद्रा पराभद्रा ऊर्मिला च परद्रुमा॥३०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 164,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "बलदेवाह्निकम्-१०९"
    },
    {
      "verse": 31,
      "sanskrit": "ख्याता वेत्रवती चैव चापदासीति विश्रुता। प्रस्थावती कुण्डनदी नदी पुण्या सरस्वती॥३१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 164,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "बलदेवाह्निकम्-१०९"
    },
    {
      "verse": 32,
      "sanskrit": "चित्रघ्नी चेन्दुमाला च तथा मधुमती नदी। उमा गुरुनदी चैव तापी च विमलोदका॥३२॥",
      "english": null,
      "bhavadeepa": null,
