    },
    {
      "verse": 33,
      "sanskrit": "विमला विमलोदा च मत्तगङ्गा पयस्विनी। एताश्चान्याश्च वै नद्यो याश्चान्या नानुकीर्तिताः॥३३॥",
      "english": null,
      "bhavadeepa": null,
