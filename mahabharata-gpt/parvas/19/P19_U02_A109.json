      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "बलदेवाह्निकम्-१०९"
    },
    {
      "verse": 34,
      "sanskrit": "ता मां समभिषिञ्चन्तु पश्चिमामाश्रिता दिशम्। भागीरथी पुण्यजला प्राच्यां दिशि समाश्रिता॥३४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 164,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "बलदेवाह्निकम्-१०९"
    },
    {
      "verse": 35,
      "sanskrit": "सा तु दहतु मे पापं कीर्तिता शम्भुना धृता। प्रभासं च प्रयागं च नैमिषं पुष्कराणि च॥३५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 164,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "बलदेवाह्निकम्-१०९"
    },
    {
      "verse": 36,
      "sanskrit": "गङ्गातीर्थं कुरुक्षेत्रं श्रीकण्ठं गौतमाश्रमम्। रामह्रदं विनशनं रामतीर्थं तथैव च॥३६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 164,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "बलदेवाह्निकम्-१०९"
    },
    {
      "verse": 37,
      "sanskrit": "गङ्गाद्वारं कनखलं सोमो वै यत्र चोत्थितः। कपालमोचनं तीर्थं जम्बूमार्गं च विश्रुतम्॥३७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 164,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "बलदेवाह्निकम्-१०९"
    },
    {
      "verse": 38,
      "sanskrit": "सुवर्णबिन्दु विख्यातं तथा कनकपिङ्गलम्। दशाश्वमेधिकं चैव पुण्याश्रमविभूषितम्॥३८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 164,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "बलदेवाह्निकम्-१०९"
    },
    {
      "verse": 39,
      "sanskrit": "बदरी चैव विख्याता नरनारायणाश्रमः। विख्यातं फल्गुतीर्थं च तीर्थं चन्द्रवटं तथा॥३९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 164,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "बलदेवाह्निकम्-१०९"
    },
    {
      "verse": 40,
      "sanskrit": "कोकामुखं पुण्यतमं गङ्गासागरमेव च। मगधेषु तपोदश्च गङ्गोद्भेदश्च विश्रुतः॥४०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 164,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "बलदेवाह्निकम्-१०९"
    },
    {
      "verse": 41,
      "sanskrit": "तीर्थान्येतानि पुण्यानि सेवितानि महर्षिभिः। सूकरं योगमार्गं च श्वेतद्वीपं तथैव च॥४१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 164,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "बलदेवाह्निकम्-१०९"
    },
    {
      "verse": 42,
      "sanskrit": "ब्रह्मतीर्थं रामतीर्थं वाजिमेधशतोपमम्। धारासम्पातसंयुक्ता गङ्गा किल्बिषनाशिनी॥४२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 164,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "बलदेवाह्निकम्-१०९"
    },
    {
      "verse": 43,
      "sanskrit": "गङ्गा वैकुण्ठकेदारं सूकरोद्भेदनं परम्। तं शापमोचनं तीर्थं पुनन्त्वेतानि किल्बिषात्॥४३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 164,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "बलदेवाह्निकम्-१०९"
    },
    {
      "verse": 44,
      "sanskrit": "मां प्लावयन्तु सलिलैः कीर्तिताकीर्तितानि वै। धर्मार्थकामविषयो यशःप्राप्तिः शमो दमः। वरुणेशोऽथ धनदो यमो नियम एव च॥४४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 164,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "बलदेवाह्निकम्-१०९"
    },
    {
      "verse": 45,
      "sanskrit": "कालो नयः सन्नतिश्च क्रोधो मोहः क्षमा धृतिः। विद्युतोऽभ्राण्यथौषध्यः प्रमादोन्मादविग्रहाः॥४५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 164,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "बलदेवाह्निकम्-१०९"
    },
    {
      "verse": 46,
      "sanskrit": "यक्षाः पिशाचा गन्धर्वाः किन्नराः सिद्धचारणाः। नक्तञ्चराः खेचरिणो दंष्ट्रिणः प्रियविग्रहाः॥४६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 164,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "बलदेवाह्निकम्-१०९"
    },
    {
      "verse": 47,
      "sanskrit": "लम्बोदराश्च बलिनः पिङ्गाक्षा विश्वरूपिणः। मरुतः सह पर्जन्याः कलात्रुटिलवाः क्षणाः॥४७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 164,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "बलदेवाह्निकम्-१०९"
    },
    {
      "verse": 48,
      "sanskrit": "नक्षत्राणि ग्रहाश्चैव ऋतवः शिशिरादयः। मासाहोरात्रयश्चैव सूर्याचन्द्रमसौ तथा॥४८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 164,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "बलदेवाह्निकम्-१०९"
    },
    {
      "verse": 49,
      "sanskrit": "आमोदश्च प्रमोदश्च प्रहर्षः शोक एव च। रजस्तमस्तपः सत्यं शुद्धिर्बुद्धिर्धृतिः श्रुतिः॥४९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 164,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "बलदेवाह्निकम्-१०९"
    },
    {
      "verse": 50,
      "sanskrit": "रुद्राणी भद्रकाली च भद्रा ज्येष्ठा तु वारुणी। भासी च कालिका चैव शाण्डिली चेति विश्रुताः॥५०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 164,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "बलदेवाह्निकम्-१०९"
    },
    {
      "verse": 51,
      "sanskrit": "आर्या कुहूः सिनीवाली भीमा चित्ररथी रतिः। एकानंशा च कूष्माण्डी देवी कात्यायनी च या॥५१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 164,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "बलदेवाह्निकम्-१०९"
    },
    {
      "verse": 52,
      "sanskrit": "लोहित्या जनमाता च देवकन्यास्तु याः स्मृताः। गोनन्दा देवपत्नी च मां रक्षन्तु सबान्धवम्॥५२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 164,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "बलदेवाह्निकम्-१०९"
    },
    {
      "verse": 53,
      "sanskrit": "नानाभरणवेशाश्च नानारूपाङ्किताननाः। नानादेशविचारिण्यो नानाशस्त्रोपशोभिताः॥५३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 164,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "बलदेवाह्निकम्-१०९"
    },
    {
      "verse": 54,
      "sanskrit": "मेदोमज्जाप्रियाश्चैव मद्यमांसवसाप्रियाः। मार्जारद्वीपिवक्त्राश्च गजसिंहनिभाननाः॥५४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 164,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "बलदेवाह्निकम्-१०९"
    },
    {
      "verse": 55,
      "sanskrit": "कङ्कवायसगृध्राणां क्रौञ्चतुल्याननास्तथा। व्यालयज्ञोपवीताश्च चर्मप्रावरणास्तथा॥५५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 164,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "बलदेवाह्निकम्-१०९",
      "english_ref": 21,
      "combined_translation": "21-55"
    },
    {
      "verse": 56,
      "sanskrit": "क्षतजोक्षितवक्त्राश्च खरभेरीसमस्वनाः। मत्सराः क्रोधनाश्चैव प्रासादा रुचिरालयाः॥५६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 164,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "बलदेवाह्निकम्-१०९"
    },
    {
      "verse": 57,
      "sanskrit": "मत्तोन्मत्तप्रमत्ताश्च प्रहरन्त्यश्च धिष्ठिताः। पिङ्गाक्षाः पिङ्गकेशाश्च ततोऽन्या लूनमूर्धजाः॥५७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 164,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "बलदेवाह्निकम्-१०९"
    },
    {
      "verse": 58,
      "sanskrit": "ऊर्ध्वकेश्यः कृष्णकेश्यः श्वेतकेश्यस्तथा वराः। नागायुतबलाश्चैव वायुवेगास्तथापराः॥५८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 164,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "बलदेवाह्निकम्-१०९"
    },
    {
      "verse": 59,
      "sanskrit": "एकहस्ता एकपादा एकाक्षाः पिङ्गला मताः। बहुपुत्राल्पपुत्राश्च द्विपुत्राः पुत्रमण्डिकाः॥५९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 164,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "बलदेवाह्निकम्-१०९"
    },
    {
      "verse": 60,
      "sanskrit": "मुखमण्डी बिडाली च पूतना गन्धपूतना। शीतवातोष्णवेताली रेवती गृहसंज्ञिताः॥६०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 164,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "बलदेवाह्निकम्-१०९"
    },
    {
      "verse": 61,
      "sanskrit": "प्रियहास्याः प्रियक्रोधाः प्रियवासाः प्रियंवदाः। सुखप्रदाश्चासुखदाः सदा द्विजजनप्रियाः॥६१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 164,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "बलदेवाह्निकम्-१०९"
    },
    {
      "verse": 62,
      "sanskrit": "नक्तञ्चराः सुखोदर्काः सदा पर्वणि दारुणाः। मातरो मातृवत्पुत्रं रक्षन्तु मम नित्यशः॥६२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 164,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "बलदेवाह्निकम्-१०९"
    },
    {
      "verse": 63,
      "sanskrit": "पितामहमुखोद्भूता रौद्रा रुद्राङ्गसम्भवाः। कुमारस्वेदजाश्चैव ज्वरा वै वैष्णवादयः॥६३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 164,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "बलदेवाह्निकम्-१०९"
    },
    {
      "verse": 64,
      "sanskrit": "महाभीमा महावीर्या दर्पोद्भूता महाबलाः। क्रोधनाक्रोधनाः क्रूराः सुरविग्रहकारिणः॥६४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 164,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "बलदेवाह्निकम्-१०९"
    },
    {
      "verse": 65,
      "sanskrit": "नक्तञ्चराः केसरिणो दंष्ट्रिणः प्रियविग्रहाः। लम्बोदरा जघनिनः पिङ्गाक्षा विश्वरूपिणः॥६५॥",
