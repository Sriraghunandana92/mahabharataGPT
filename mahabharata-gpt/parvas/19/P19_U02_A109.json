      "bhavadeepa": null,
      "chapter": 164,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "बलदेवाह्निकम्-१०९"
    },
    {
      "verse": 66,
      "sanskrit": "शक्त्यृष्टिशूलपरिघप्रासचर्मासिपाणयः। पिनाकवज्रमुसलब्रह्मदण्डायुधप्रियाः॥६६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 164,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "बलदेवाह्निकम्-१०९"
    },
    {
      "verse": 67,
      "sanskrit": "दण्डिनः कुण्डिनः शूरा जटामुकुटधारिणः। वेदवेदाङ्गकुशला नित्ययज्ञोपवीतिनः॥६७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 164,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "बलदेवाह्निकम्-१०९"
    },
    {
      "verse": 68,
      "sanskrit": "व्यालापीडाः कुण्डलिनो वीराः केयूरधारिणः। नानावसनसंवीताश्चित्रमाल्यानुलेपनाः॥६८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 164,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "बलदेवाह्निकम्-१०९"
    },
    {
      "verse": 69,
      "sanskrit": "गजाश्वोष्ट्रर्क्षमार्जारसिंहव्याघ्रनिभाननाः। वराहोलूकगोमायुमृगाखुमहिषाननाः॥६९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 164,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "बलदेवाह्निकम्-१०९"
    },
    {
      "verse": 70,
      "sanskrit": "वामना विकटाः कुब्जाः कराला लूनमूर्धजाः। सहस्रशतशश्चान्ये सहस्रजटधारिणः॥७०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 164,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "बलदेवाह्निकम्-१०९"
    },
    {
      "verse": 71,
      "sanskrit": "श्वेताः कैलाससङ्काशाः केचिद्दिनकरप्रभाः। केचिज्जलदवर्णाभा नीलाञ्जनचयोपमाः॥७१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 164,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "बलदेवाह्निकम्-१०९"
    },
    {
      "verse": 72,
      "sanskrit": "एकपादा द्विपादाश्च तथा द्विशिरसोऽपरे। निर्मांसाः स्थूलजङ्घाश्च व्यादितास्या भयङ्कराः॥७२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 164,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "बलदेवाह्निकम्-१०९"
    },
    {
      "verse": 73,
      "sanskrit": "वापीतडागकूपेषु समुद्रेषु सरित्सु च। श्मशानशैलवृक्षेषु शून्यागारनिवासिनः॥७३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 164,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "बलदेवाह्निकम्-१०९"
    },
    {
      "verse": 74,
      "sanskrit": "एते ग्रहाश्च सततं रक्षन्तु मम सर्वतः। महागणपतिर्नन्दी महाकालो महाबलः। माहेश्वरो वैष्णवश्च ज्वरौ लोकभयावहौ॥७४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 164,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "बलदेवाह्निकम्-१०९"
    },
    {
      "verse": 75,
      "sanskrit": "ग्रामणीश्चैव गोपालो भृङ्गरीटिर्गणेश्वरः। देवश्च वामदेवश्च घण्टाकर्णः करन्धमः॥७५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 164,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "बलदेवाह्निकम्-१०९"
    },
    {
      "verse": 76,
      "sanskrit": "श्वेतमोदः कपाली च जम्भकः शत्रुतापनः। मज्जनोन्मज्जनौ चोभौ सन्तापनविलापनौ॥७६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 164,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "बलदेवाह्निकम्-१०९"
    },
    {
      "verse": 77,
      "sanskrit": "निजघासो घसश्चैव स्थूणाकर्णः प्रशोषणः। उल्कामाली धमधमो ज्वालामाली प्रदर्शनः॥७७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 164,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "बलदेवाह्निकम्-१०९"
    },
    {
      "verse": 78,
      "sanskrit": "सङ्घट्टनः सङ्कुटनः काष्ठभूतः शिवङ्करः। कूष्माण्डः कुम्भमूर्धा च रोचनो वैकृतो ग्रहः॥७८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 164,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "बलदेवाह्निकम्-१०९"
    },
    {
      "verse": 79,
      "sanskrit": "अनिकेतः सुरारिघ्नः शिवश्चाशिव एव च। क्षेमकः पिशिताशी च सुरारिर्हरिलोचनः॥७९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 164,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "बलदेवाह्निकम्-१०९"
    },
    {
      "verse": 80,
      "sanskrit": "भीमको ग्राहकश्चैव तथैवाग्रमयो ग्रहः। उपग्रहोऽर्यकश्चैव तथा स्कन्दग्रहोऽपरः॥८०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 164,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "बलदेवाह्निकम्-१०९"
    },
    {
      "verse": 81,
      "sanskrit": "चपलोऽसमवेतालस्तासमः सुमहाकपिः। हृदयोद्वर्तनश्चैडः कुण्डाशी कङ्कणप्रियः॥८१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 164,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "बलदेवाह्निकम्-१०९"
    },
    {
      "verse": 82,
      "sanskrit": "हरिश्मश्रुर्गरुत्मन्तो मनोमारुतरंहसः। पार्वत्या रोषसम्भूताः सहस्राणि शतानि च॥८२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 164,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "बलदेवाह्निकम्-१०९"
    },
    {
      "verse": 83,
      "sanskrit": "शक्तिमन्तो धृतिमन्तो ब्रह्मण्याः सत्यसङ्गराः। सर्वकामापहन्तारो द्विषतां च मृधे मृधे॥८३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 164,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "बलदेवाह्निकम्-१०९"
    },
    {
      "verse": 84,
      "sanskrit": "रात्रावहनि दुर्गेषु कीर्तिताः सकलैर्गुणैः। तेषां गणानां पतयः सगणाः पान्तु मां सदा॥८४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 164,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "बलदेवाह्निकम्-१०९"
    },
    {
      "verse": 85,
      "sanskrit": "नारदः पर्वतश्चैव गन्धर्वाप्सरसां गणाः। पितरः कारणं कार्यमाधयो व्याधयस्तथा॥८५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 164,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "बलदेवाह्निकम्-१०९"
    },
    {
      "verse": 86,
      "sanskrit": "अगस्त्यो गालवो गार्ग्यः शक्तिधौम्यः पराशरः। कृष्णात्रेयश्च भगवानसितो देवलो बलः॥८६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 164,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "बलदेवाह्निकम्-१०९"
    },
    {
      "verse": 87,
      "sanskrit": "बृहस्पतिरुतथ्यश्च मार्कण्डेयः श्रुतश्रवाः। द्वैपायनो विदर्भश्च जैमिनिर्माठरः कठः॥८७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 164,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "बलदेवाह्निकम्-१०९"
    },
    {
      "verse": 88,
      "sanskrit": "विश्वामित्रो वसिष्ठश्च लोमशश्च महामुनिः। उत्तङ्कश्चैव रैभ्यश्च पौलोमश्च द्वितस्त्रितः॥८८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 164,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "बलदेवाह्निकम्-१०९"
    },
    {
      "verse": 89,
      "sanskrit": "ऋषिर्वै कालवृक्षीयो मुनिमेधातिथिस्तथा। सारस्वतो यवक्रीतिः कुशिको गौतमस्तथा॥८९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 164,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "बलदेवाह्निकम्-१०९"
    },
    {
      "verse": 90,
      "sanskrit": "संवर्त ऋश्यशृङ्गश्च स्वस्त्यात्रेयो विभाण्डकः। ऋचीको जमदग्निश्च तथोर्वस्तपसां निधिः॥९०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 164,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "बलदेवाह्निकम्-१०९"
    },
    {
      "verse": 91,
      "sanskrit": "भरध्वाजः स्थूलशिराः कश्यपः पुलहः क्रतुः। बृहदग्निर्हरिश्मश्रुर्विजयः कण्व एव च॥९१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 164,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "बलदेवाह्निकम्-१०९"
    },
    {
      "verse": 92,
      "sanskrit": "वैतण्डी दीर्घतापश्च वेदगार्थोंऽशुमाञ्च्छिवः। अष्टावक्रो दधीचिश्च श्वेतकेतुस्तथैव च॥९२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 164,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "बलदेवाह्निकम्-१०९"
    },
    {
      "verse": 93,
      "sanskrit": "उद्दालकः क्षीरपाणिः शृङ्गी गौरमुखस्तथा। अग्निवेश्यः शमीकश्च प्रमुचुर्मुमुचुस्तथा॥९३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 164,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "बलदेवाह्निकम्-१०९"
    },
    {
      "verse": 94,
      "sanskrit": "एते चान्ये च ऋषयः बहवः शंसितव्रताः। मुनयः शंसितात्मानो ये चान्ये नानुकीर्तिताः॥९४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 164,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "बलदेवाह्निकम्-१०९"
    },
    {
      "verse": 95,
      "sanskrit": "क्रतवः शाधिनः शान्ताः शान्तिं कुर्वन्तु मे सदा। त्रयोऽग्नयस्त्रयो वेदास्त्रैविद्याः कौस्तुभो मणिः॥९५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 164,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "बलदेवाह्निकम्-१०९"
    },
    {
      "verse": 96,
      "sanskrit": "उच्चैःश्रवा हयः श्रीमान्वैद्यो धन्वन्तरिर्हरिः। अमृतं गौः सुपर्णश्च दधिगौराश्च सर्षपाः॥९६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 164,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "बलदेवाह्निकम्-१०९"
    },
    {
      "verse": 97,
      "sanskrit": "शुक्लाः सुमनसः कन्याः श्वेतच्छत्रं यवाक्षताः। दूर्वा हिरण्यं गन्धाश्च वालव्यजनमेव च॥९७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 164,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "बलदेवाह्निकम्-१०९"
    },
    {
      "verse": 98,
      "sanskrit": "तथाप्रतिहतं चक्रं महोक्षश्चन्दनं विषम्। श्वेतो वृषःकरी मत्तः सिंहो व्याघ्रो हयो गिरिः॥९८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 164,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "बलदेवाह्निकम्-१०९"
    },
    {
      "verse": 99,
      "sanskrit": "पृथिवी चोद्धृता लाजा ब्राह्मणा मधु पायसम्। स्वस्तिको वर्धमानश्च नन्द्यावर्तः प्रियङ्गवः। श्रीफलं गोमयं मत्स्यो दुन्दुभिः पटहस्वनः॥९९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 164,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "बलदेवाह्निकम्-१०९"
    },
    {
      "verse": 100,
      "sanskrit": "ऋषिपत्न्यश्च कन्याश्च श्रीमद्भद्रासनं धनुः। रोचना रुचकश्चैव नदीनां सङ्गमोदकम्॥१००॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 164,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "बलदेवाह्निकम्-१०९"
    },
    {
      "verse": 101,
      "sanskrit": "सुपर्णाः शतपत्राश्च चकोरा जीवजीवकाः। नन्दीमुखो मयूरश्च बद्धमुक्तामणिध्वजाः॥१०१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 164,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "बलदेवाह्निकम्-१०९"
    },
