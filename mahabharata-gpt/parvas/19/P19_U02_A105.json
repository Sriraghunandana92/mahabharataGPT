  "chapter": 160,
  "verse_count": 84,
  "verses": [
    {
      "verse": 1,
      "sanskrit": "वैशम्पायन उवाच।\n              ततः प्रवृद्धं युद्धं तु तुमुलं लोमहर्षणम्। शम्बरस्य तु पुत्राणां रुक्मिण्या नन्दनस्य च॥१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 160,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "प्रद्युम्नेन शम्बरसैन्यविद्रावणम्-१०५"
    },
    {
      "verse": 2,
      "sanskrit": "ततः क्रुद्धा महादैत्याः शरशक्तिपरश्वधान्। चक्रतोमरकुन्तानि भुशुण्डीर्मुसलानि च॥२॥",
      "english": null,
      "bhavadeepa": "तत इति॥१॥",
      "chapter": 160,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "प्रद्युम्नेन शम्बरसैन्यविद्रावणम्-१०५",
      "combined_translation": "2-2"
    },
    {
      "verse": 3,
      "sanskrit": "युगपत्पातयन्ति स्म प्रद्युम्नोपरि वेगिताः। कार्ष्णायनिस्तु सङ्क्रुद्धः सर्वास्त्रधनुषश्च्युतैः॥३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 160,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "प्रद्युम्नेन शम्बरसैन्यविद्रावणम्-१०५",
      "combined_translation": "3-3"
    },
    {
      "verse": 4,
      "sanskrit": "एकैकं पञ्चभिः क्रुद्धश्चिच्छेद रणमूर्धनि। पुनरेवासुराः क्रुद्धाः सर्वे ते कृतनिश्चयाः॥४॥",
      "english": null,
      "bhavadeepa": "सर्वमस्यते क्षिप्यतेऽनेनेति सर्वास्त्रं तच्च तद्धनुश्च तस्मात्॥३॥",
      "chapter": 160,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "प्रद्युम्नेन शम्बरसैन्यविद्रावणम्-१०५",
      "combined_translation": "4-4"
    },
    {
      "verse": 5,
      "sanskrit": "ववृषुः शरजालानि प्रद्युम्नवधकाङ्क्षया। ततः प्रकुपितोऽनङ्गो धनुरादाय सत्वरः॥५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 160,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "प्रद्युम्नेन शम्बरसैन्यविद्रावणम्-१०५",
      "combined_translation": "5-5"
    },
    {
      "verse": 6,
      "sanskrit": "शम्बरस्य जघानाशु दश पुत्रान्महौजसः। ततोऽपरेण भल्लेन कुपितः केशवात्मजः॥६॥",
      "english": null,
      "bhavadeepa": "अनङ्गः प्रद्युम्नः॥५॥",
      "chapter": 160,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "प्रद्युम्नेन शम्बरसैन्यविद्रावणम्-१०५",
      "combined_translation": "6-6"
    },
    {
      "verse": 7,
      "sanskrit": "चिच्छेदाशु शिरस्तस्य चित्रसेनस्य वीर्यवान्। ततस्ते हतशेषास्तु समेत्य समयुद्ध्यत॥७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 160,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "प्रद्युम्नेन शम्बरसैन्यविद्रावणम्-१०५",
      "combined_translation": "7-7"
    },
    {
      "verse": 8,
      "sanskrit": "शरवर्षं विमुञ्चन्तो ह्यभ्यधावञ्जिघांसितुम्। ततः सन्धाय बाणांस्ते विमुञ्चन्तो रणोत्सुकाः॥८॥",
      "english": null,
      "bhavadeepa": "समयुध्यत एकत्वमार्षं युद्धं कृतवन्तः॥७॥",
      "chapter": 160,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "प्रद्युम्नेन शम्बरसैन्यविद्रावणम्-१०५",
      "combined_translation": "8-8"
    },
    {
      "verse": 9,
      "sanskrit": "क्रीडन्निव महातेजाः शिरांस्येषामपातयत्। निहत्य समरे सर्वाञ्छतमुत्तमधन्विनाम्॥९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 160,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "प्रद्युम्नेन शम्बरसैन्यविद्रावणम्-१०५",
      "combined_translation": "9-9"
    },
    {
      "verse": 10,
      "sanskrit": "प्रद्युम्नः समराकाङ्क्षी तस्थौ सङ्ग्राममूर्धनि। हतं पुत्रशतं श्रुत्वा शम्बरः क्रोधमादधे॥१०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 160,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "प्रद्युम्नेन शम्बरसैन्यविद्रावणम्-१०५",
      "combined_translation": "10-10"
    },
    {
      "verse": 11,
      "sanskrit": "सूतं सञ्चोदयामास रथं मे सम्प्रयोजय। राज्ञो वाक्यं निशम्याथ प्रणम्य शिरसा भुवि॥११॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 160,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "प्रद्युम्नेन शम्बरसैन्यविद्रावणम्-१०५",
      "combined_translation": "11-11"
    },
    {
      "verse": 12,
      "sanskrit": "ससैन्यं नोदयामास रथं स सुसमाहितम्। युक्तमृष्यसहस्रेण सर्पराजसकेतनम्॥१२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 160,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "प्रद्युम्नेन शम्बरसैन्यविद्रावणम्-१०५",
      "combined_translation": "12-12"
    },
    {
      "verse": 13,
      "sanskrit": "शार्दूलचर्मसंविष्टं किङ्किणीजलपालिनम्। ईशामृगगणाकीर्णं पङ्क्तिभक्तिविराजितम्॥१३॥",
      "english": null,
      "bhavadeepa": "ऋष्याः मृगविशेषास्तेषां सहस्रेण॥१२॥",
      "chapter": 160,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "प्रद्युम्नेन शम्बरसैन्यविद्रावणम्-१०५",
      "combined_translation": "13-13"
    },
    {
      "verse": 14,
      "sanskrit": "ताराचित्रपिनद्धाङ्गं स्वर्णकूबरभूषितम्। सुपताकमहोच्छ्रायं मृगराजोग्रकेतनम्॥१४॥",
      "english": null,
      "bhavadeepa": "पङ्क्तिभक्तिभिः दशभिश्चित्रभागैः उपर्युपरि कोष्ठकौर्विराजितं शोभमानम्॥१३॥",
      "chapter": 160,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "प्रद्युम्नेन शम्बरसैन्यविद्रावणम्-१०५",
      "combined_translation": "14-14"
    },
    {
      "verse": 15,
      "sanskrit": "सुविभक्तवरूथं च लोहेषावज्रकूबरम्। मन्दारोदग्रशिखरं चारुचामरभूषितम्॥१५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 160,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "प्रद्युम्नेन शम्बरसैन्यविद्रावणम्-१०५",
      "combined_translation": "15-15"
    },
    {
      "verse": 16,
      "sanskrit": "नक्षत्रमालापिहितं हेमदण्डसमाहितम्। विराजमानं श्रीमन्तमारोहच्छम्बरो रथम्॥१६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 160,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "प्रद्युम्नेन शम्बरसैन्यविद्रावणम्-१०५",
      "combined_translation": "16-16"
    },
    {
      "verse": 17,
      "sanskrit": "काञ्चनं चित्रसन्नाहं धनुर्गृह्य शरांस्तथा। प्रस्थितः समराकाङ्क्षी मृत्युना परिचोदितः॥१७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 160,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "प्रद्युम्नेन शम्बरसैन्यविद्रावणम्-१०५",
      "combined_translation": "17-17"
    },
    {
      "verse": 18,
      "sanskrit": "चतुर्भिः सचिवैः सार्धं सैन्येन महता वृतः। दुर्धरः केतुमाली च शत्रुहन्ता प्रमर्दनः॥१८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 160,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "प्रद्युम्नेन शम्बरसैन्यविद्रावणम्-१०५",
      "combined_translation": "18-18"
    },
    {
      "verse": 19,
      "sanskrit": "एतैः परिवृतोऽमात्यैर्युयुत्सुः प्रस्थितो रणे। दशनागसहस्राणि रथानां द्वे शते तथा॥१९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 160,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "प्रद्युम्नेन शम्बरसैन्यविद्रावणम्-१०५",
      "combined_translation": "19-19"
    },
    {
      "verse": 20,
      "sanskrit": "हयानां चाष्टसाहस्रैः प्रयुतैश्च पदातिनाम्। एतैः परिवृतो योधैः शम्बरः प्रययौ तदा॥२०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 160,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "प्रद्युम्नेन शम्बरसैन्यविद्रावणम्-१०५",
      "combined_translation": "20-20"
    },
    {
      "verse": 21,
      "sanskrit": "प्रयातस्य तु सङ्ग्रामे उत्पाता बहवोऽभवन्। गृध्रचक्राकुले व्योम्नि सन्ध्याकाराभ्रनादितम्॥२१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 160,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "प्रद्युम्नेन शम्बरसैन्यविद्रावणम्-१०५",
      "combined_translation": "21-21"
    },
    {
      "verse": 22,
      "sanskrit": "गर्जन्ति परुषं मेघा निर्घातश्चाम्बरात्पतत्। शिवा विनेदुरशिवं सैन्यं सङ्कालयन्महत्॥२२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 160,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "प्रद्युम्नेन शम्बरसैन्यविद्रावणम्-१०५",
      "combined_translation": "22-22"
    },
    {
      "verse": 23,
      "sanskrit": "ध्वजशीर्षेऽपतद्गृध्रः काङ्क्षन्वै दानवासृजम्। रथाग्रे पतितश्चास्य कबन्धो भुवि दृश्यते॥२३॥",
      "english": null,
      "bhavadeepa": "निर्घातः अशनिः पतत् अपतत्। सङ्कालयन् क्षपयन्॥२२॥",
      "chapter": 160,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "प्रद्युम्नेन शम्बरसैन्यविद्रावणम्-१०५",
      "combined_translation": "23-23"
    },
    {
      "verse": 24,
      "sanskrit": "चीचीकूचीति वाशान्ति शम्बरस्य रथोपरि। स्वर्भानुग्रस्त आदित्यः परिघैः परिवेष्टितः॥२४॥",
      "english": null,
      "bhavadeepa": "गृध्रः दानवासृजं दानवरक्तम्॥२३॥",
      "chapter": 160,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "प्रद्युम्नेन शम्बरसैन्यविद्रावणम्-१०५",
      "combined_translation": "24-24"
    },
    {
      "verse": 25,
      "sanskrit": "स्फुरते नयनं चास्य सव्यं भयनिवेदनम्। बाहुः प्रकम्पते सव्यः प्रास्खलन्रथवाजिनः॥२५॥",
      "english": null,
      "bhavadeepa": "वाशन्ति पक्षिण इति शेषः॥२४॥",
      "chapter": 160,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "प्रद्युम्नेन शम्बरसैन्यविद्रावणम्-१०५",
      "combined_translation": "25-25"
    },
    {
      "verse": 26,
      "sanskrit": "ध्वाङ्क्षो मूर्ध्नि निपतितः शम्बरस्य सुरारिणः। ववर्ष रुधिरं देवः शर्कराङ्गारमिश्रितम्॥२६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 160,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "प्रद्युम्नेन शम्बरसैन्यविद्रावणम्-१०५",
      "combined_translation": "26-26"
    },
    {
      "verse": 27,
      "sanskrit": "उल्कापातसहस्राणि निपेतू रणमूर्धनि। प्रतोदो न्यपतद्धस्तात्सारथेर्हययायिनः॥२७॥",
      "english": null,
      "bhavadeepa": "सुरारिणः देवशत्रोः॥२६॥",
      "chapter": 160,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "प्रद्युम्नेन शम्बरसैन्यविद्रावणम्-१०५",
      "combined_translation": "27-27"
    },
    {
      "verse": 28,
      "sanskrit": "एतानचिन्तयित्वा तु उत्पातान्समुपस्थितान्। प्रययौ शम्बरः क्रुद्धः प्रद्युम्नवधकाङ्क्षया॥२८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 160,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "प्रद्युम्नेन शम्बरसैन्यविद्रावणम्-१०५",
      "english_ref": 1,
      "combined_translation": "1-28"
    },
    {
      "verse": 29,
      "sanskrit": "भेरीमृदङ्गशङ्खानां पणवानकदुन्दुभेः। युगपन्नाद्यमानानां पृथिवी समकम्पत॥२९॥",
      "english": null,
      "bhavadeepa": null,
