  "verses": [
    {
      "verse": 1,
      "sanskrit": "नारद उवाच।\n              सादिता मौरवाः पाशा निसुन्दनरकौ हतौ। कृतः क्षेम्यः पुनः पन्थाः पुरं प्राग्ज्योतिषं प्रति॥१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 157,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "नारदवाक्ये कृष्णस्तुतिः-१०२"
    },
    {
      "verse": 2,
      "sanskrit": "शौरिणा पृथिवीपालास्त्रासिताः स्पर्द्धिनो रणे। धनुषश्च निनादेन पाञ्चजन्यस्वनेन च॥२॥",
      "english": null,
      "bhavadeepa": "सादिता इति मौखाः मुरुकृताः॥१॥",
      "chapter": 157,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "नारदवाक्ये कृष्णस्तुतिः-१०२",
      "combined_translation": "2-2"
    },
    {
      "verse": 3,
      "sanskrit": "मेघप्रख्यै रथानीकैर्दाक्षिणात्यैः सुरक्षितम्। रुक्मिणं युधि निर्जित्य महाबलपराक्रमम्। रुक्मिणीमाजहाराशु केशवो वृष्णिपुङ्गवः॥३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 157,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "नारदवाक्ये कृष्णस्तुतिः-१०२",
      "combined_translation": "3-3"
    },
    {
      "verse": 4,
      "sanskrit": "ततः पर्जन्यघोषेण रथेनादित्यवर्चसा। अवाप्य महिषीं भोज्यां शङ्खचक्रगदासिभृत्॥४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 157,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "नारदवाक्ये कृष्णस्तुतिः-१०२",
      "combined_translation": "4-20"
    },
    {
      "verse": 5,
      "sanskrit": "जारूथ्यामाह्वृतिः क्राथः शिशुपालश्च निर्जितः। वक्रश्च सह सैन्येन शतधन्वाथ निर्जितः॥५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 157,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "नारदवाक्ये कृष्णस्तुतिः-१०२",
      "combined_translation": "5-5"
    },
    {
      "verse": 6,
      "sanskrit": "इन्द्रद्युम्नो हतः कोपाद्यवनश्च कशेरुमान्। हतः सौभपतिः श्रीमाञ्छाल्वश्च दृढधन्वना॥६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 157,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "नारदवाक्ये कृष्णस्तुतिः-१०२",
      "combined_translation": "6-6"
    },
    {
      "verse": 7,
      "sanskrit": "पर्वतानां सहस्रं च चक्रेण पुरुषोत्तमः। विकीर्य पुण्डरीकाक्षो द्युमत्सेनं व्यपोथयत्॥७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 157,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "नारदवाक्ये कृष्णस्तुतिः-१०२",
      "combined_translation": "7-7"
    },
    {
      "verse": 8,
      "sanskrit": "महेन्द्रशिखरे चैव निमेषान्तरचारिणौ। जघान पुरुषव्याघ्रो रावणस्याभितश्चरौ॥८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 157,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "नारदवाक्ये कृष्णस्तुतिः-१०२",
      "combined_translation": "8-8"
    },
    {
      "verse": 9,
      "sanskrit": "इरावत्यां महाभोजावग्निसूर्यसमौ युधि। गोपतिस्तालकेतुश्च निर्हतौ शार्ङ्गधन्वना॥९॥",
      "english": null,
      "bhavadeepa": "महेन्द्रस्य पर्वतस्य शिखरे इरावत्यां नगर्यामिति द्वयोः सम्बन्धः॥८॥",
      "chapter": 157,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "नारदवाक्ये कृष्णस्तुतिः-१०२",
      "combined_translation": "9-9"
    },
    {
      "verse": 10,
      "sanskrit": "अक्षप्रपातने चैव डिम्भो हंसश्च दानवौ। उभौ तावपि कृष्णेन सानुगौ विनिपातितौ॥१०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 157,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "नारदवाक्ये कृष्णस्तुतिः-१०२",
      "combined_translation": "10-10"
    },
    {
      "verse": 11,
      "sanskrit": "दग्धा वाराणसी चैव केशवेन महात्मना। सराष्ट्रः सानुबन्धश्च काशीनामधिपो हतः॥११॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 157,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "नारदवाक्ये कृष्णस्तुतिः-१०२",
      "combined_translation": "11-11"
    },
    {
      "verse": 12,
      "sanskrit": "विजित्य च यमं सङ्ख्ये शरैः सन्नतपर्वभिः। अथैन्द्रसेनिरानीतः कृष्णेनाद्भुतकर्मणा॥१२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 157,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "नारदवाक्ये कृष्णस्तुतिः-१०२",
      "combined_translation": "12-12"
    },
    {
      "verse": 13,
      "sanskrit": "सहितः सर्वयादोभिः समरेषु महाबलः। प्राप्य लोहितकूटं च कृष्णेन वरुणो जितः॥१३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 157,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "नारदवाक्ये कृष्णस्तुतिः-१०२",
      "combined_translation": "13-13"
    },
    {
      "verse": 14,
      "sanskrit": "महेन्द्रभवने यातो देवैर्गुप्तो महात्मभिः। अचिन्तयित्वा देवेन्द्रं पारिजातद्रुमो हृतः॥१४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 157,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "नारदवाक्ये कृष्णस्तुतिः-१०२",
      "combined_translation": "14-14"
    },
    {
      "verse": 15,
      "sanskrit": "पाण्ड्यं पौण्ड्रं कलिङ्गं च मात्स्यं चैव जनार्दनः। जघान सहितान्सर्वान्वङ्गराजं तथैव च॥१५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 157,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
