      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "नारदवाक्ये कृष्णस्तुतिः-१०२",
      "combined_translation": "23-23"
    },
    {
      "verse": 24,
      "sanskrit": "पीठं तथा महाबाहुः कंसामात्यं जनार्दनः। पैठिकं चासिलोमानं निजघान महाबलः॥२४॥",
      "english": null,
      "bhavadeepa": null,
