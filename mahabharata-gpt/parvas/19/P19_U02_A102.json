    },
    {
      "verse": 25,
      "sanskrit": "जृम्भमैरावणं चापि विरूपं च महायशाः। जघान पुरुषव्याघ्रो दैत्यं मानुषरूपिणम्॥२५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 157,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
