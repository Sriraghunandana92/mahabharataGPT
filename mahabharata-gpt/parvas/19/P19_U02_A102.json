    },
    {
      "verse": 29,
      "sanskrit": "निहत्य नरकं भौममाहृत्य मणिकुण्डले। देवमातुर्ददौ चैव प्रीत्यर्थं वज्रपाणिनः॥२९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 157,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "नारदवाक्ये कृष्णस्तुतिः-१०२"
    },
    {
      "verse": 30,
      "sanskrit": "एवं च देवदैत्यानां सुराणां च महायशाः। भयाभयकरः कृष्णः सर्वलोककरो विभुः॥३०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 157,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
