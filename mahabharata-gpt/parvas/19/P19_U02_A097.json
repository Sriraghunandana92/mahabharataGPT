{
  "adhyaya_id": "P19_U02_A097",
  "book": 19,
  "parva_name": "हरिवंशः",
  "upaparva_name": "विष्णुपर्व",
  "adhyaya_name": "वज्रनाभवधः-०९७",
  "chapter": 152,
  "verse_count": 44,
  "verses": [
    {
      "verse": 1,
      "sanskrit": "वैशम्पायन उवाच।\n              जगतश्चक्षुषि ततो मुहूर्ताभ्युदिते रवौ। प्रादुरासीद्धरिर्देवस्तार्क्ष्येणोरगशत्रुणा॥१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 152,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "वज्रनाभवधः-०९७"
    },
    {
      "verse": 2,
      "sanskrit": "हंसवायुमनोभिश्च सुशीघ्रतरगः खगः। तस्थौ वियति शक्रस्य समीपे कुरुनन्दन॥२॥",
      "english": null,
      "bhavadeepa": "जगत इति॥१॥",
      "chapter": 152,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "वज्रनाभवधः-०९७",
      "combined_translation": "2-2"
    },
    {
      "verse": 3,
      "sanskrit": "समेत्य च यथान्यायं कृष्णो वासवसन्निधौ। पाञ्चजन्यं हरिर्दध्मौ दैत्यानां भयवर्धनम्॥३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 152,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "वज्रनाभवधः-०९७",
      "combined_translation": "3-3"
    },
    {
      "verse": 4,
      "sanskrit": "तं श्रुत्वाभ्यागतस्तत्र प्रद्युम्नो परवीरहा। वज्रनाभं जहीत्युक्तः केशवेन त्वरेति च॥४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 152,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "वज्रनाभवधः-०९७",
      "combined_translation": "4-4"
    },
    {
      "verse": 5,
      "sanskrit": "तार्क्ष्यमारुह्य गच्छेति पुनरेव प्रणोदितः। चकार स तथा वीरः प्रणिपत्य सुरोत्तमौ॥५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 152,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "वज्रनाभवधः-०९७",
      "combined_translation": "5-5"
    },
    {
      "verse": 6,
      "sanskrit": "स मनोरंहसा वीर तार्क्ष्येणाशु ययौ नृप। अभ्यासं वज्रनाभस्य महाद्वन्द्वस्य भारत॥६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 152,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "वज्रनाभवधः-०९७",
      "combined_translation": "6-6"
    },
    {
      "verse": 7,
      "sanskrit": "ततस्तार्क्ष्यगतो वीरस्ततर्द रणमूर्धनि। वज्रनाभं स्थिरो भूत्वा सर्वास्त्रविदनिन्दितः॥७॥",
      "english": null,
      "bhavadeepa": "महाद्वन्द्वस्य महाव्युत्क्रमणस्य दुरन्तस्येत्यर्थः॥६॥",
      "chapter": 152,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "वज्रनाभवधः-०९७",
      "combined_translation": "7-7"
    },
    {
      "verse": 8,
      "sanskrit": "तेन तार्क्ष्यगतेनैव गदया कृष्णसूनुना। उरस्यभ्याहतो वीरो वज्रनाभो महात्मना॥८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 152,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "वज्रनाभवधः-०९७",
      "combined_translation": "8-8"
    },
    {
      "verse": 9,
      "sanskrit": "स तेनाभिहतो वीरो दैत्यो मोहवशं गतः। चक्षार च भृशं रक्तं बभ्रामैव गतासुवत्॥९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 152,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "वज्रनाभवधः-०९७",
      "combined_translation": "9-9"
    },
    {
      "verse": 10,
      "sanskrit": "आश्वसेतयथ तं कार्ष्णिरुवाच रणदुर्जयः। लब्धसंज्ञः स वीरस्तु प्रद्युम्नमिदम्ब्रवीत्॥१०॥",
      "english": null,
      "bhavadeepa": "चक्षार मुखेन उद्गीर्णवान्॥९॥",
      "chapter": 152,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "वज्रनाभवधः-०९७",
      "combined_translation": "10-10"
    },
    {
      "verse": 11,
      "sanskrit": "साधु यादव वीर्येण श्लाघ्यो मम रिपुर्भवान्। प्रतिप्रहारकालोऽयं स्थिरो भव महाबल॥११॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 152,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "वज्रनाभवधः-०९७",
      "combined_translation": "11-11"
    },
    {
      "verse": 12,
      "sanskrit": "एवमुक्त्वा महानादं मुक्त्वा मेघशतोपमम्। गदां मुमोच वेगेन सघण्टां बहुकण्टकाम्॥१२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 152,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "वज्रनाभवधः-०९७",
      "combined_translation": "12-12"
    },
    {
      "verse": 13,
      "sanskrit": "तया ललाटेऽभिहतः प्रद्युम्नो गदया नृप। उद्वमन्रुधिरं भूरि मुमोह यदुनन्दनः॥१३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 152,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "वज्रनाभवधः-०९७",
      "combined_translation": "13-13"
    },
    {
      "verse": 14,
      "sanskrit": "तं दृष्ट्वा भगवान्कृष्णः पाञ्चजन्यं जलोद्भवम्। दध्मावाश्वासनकरं पुत्रस्य रिपुनाशनः॥१४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 152,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "वज्रनाभवधः-०९७",
      "combined_translation": "14-14"
    },
    {
      "verse": 15,
      "sanskrit": "तं पाञ्चजन्यशब्देन प्रत्याश्वस्तं महाबलम्। दृष्ट्वा प्रमुदिता लोका विशेषेणेन्द्रकेशवौ॥१५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 152,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "वज्रनाभवधः-०९७",
      "combined_translation": "15-15"
    },
    {
      "verse": 16,
      "sanskrit": "तस्य चक्रं करे यातं कृष्णच्छन्देन भारत। क्षुरनेमिसहस्रारं दैत्यसङ्घकुलान्तकम्॥१६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 152,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "वज्रनाभवधः-०९७",
      "combined_translation": "16-16"
    },
    {
      "verse": 17,
      "sanskrit": "तन्मुमोचाच्युतसुतस्तस्य नाशाय भारत। नमस्कृत्वा सुरेन्द्राय कृष्णाय च महात्मने॥१७॥",
      "english": null,
      "bhavadeepa": "तस्य प्रद्युम्नस्य॥१६॥",
      "chapter": 152,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "वज्रनाभवधः-०९७",
      "combined_translation": "17-17"
    },
    {
      "verse": 18,
      "sanskrit": "वज्रनाभस्य तत्कायादुच्चकर्त शिरस्तदा। नारायणसुतोन्मुक्तं दैत्यानामनुपश्यताम्॥१८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 152,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "वज्रनाभवधः-०९७",
      "combined_translation": "18-18"
    },
    {
      "verse": 19,
      "sanskrit": "गदः सुनाभमवधीद्यतमानं रणाजिरे। हर्म्यपृष्ठे जिघांसन्तं रणदृप्तं भयानकम्॥१९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 152,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "वज्रनाभवधः-०९७",
      "combined_translation": "19-19"
    },
    {
      "verse": 20,
      "sanskrit": "साम्बः समरमध्यस्थानसुरानरिमर्दनः। निनाय निशितैर्बाणैः प्रेताधिपपरिग्रहम्॥२०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 152,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "वज्रनाभवधः-०९७",
      "combined_translation": "20-20"
    },
    {
      "verse": 21,
      "sanskrit": "निकुम्भोऽपि हते वीरे वज्रनाभे महासुरे। जगाम षट्पुरं वीरो नारायणभयार्दितः॥२१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 152,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "वज्रनाभवधः-०९७",
      "combined_translation": "21-21"
    },
    {
      "verse": 22,
      "sanskrit": "निबर्हिते देवरिपौ वज्रनाभे महासुरे। अवतीर्णौ महात्मानौ हरी वज्रपुरं तदा॥२२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 152,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "वज्रनाभवधः-०९७",
      "combined_translation": "22-22"
    },
    {
      "verse": 23,
      "sanskrit": "लब्धप्रशमनं चैव चक्रतुः सुरसत्तमौ। सान्त्वयामासतुश्चैव बालवृद्धं भयार्दितम्॥२३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 152,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "वज्रनाभवधः-०९७",
      "combined_translation": "23-23"
    },
    {
      "verse": 24,
      "sanskrit": "इन्द्रोपेन्द्रौ महात्मानौ मन्त्रयित्वा महाबलौ। आयन्त्यां च तदात्वे च बृहस्पतिमतानुगौ॥२४॥",
      "english": null,
      "bhavadeepa": "लब्धस्य शत्रुपराजयस्य प्रशमनं दुःखापनोदनम्॥२३॥",
      "chapter": 152,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "वज्रनाभवधः-०९७",
      "combined_translation": "24-24"
    },
    {
      "verse": 25,
      "sanskrit": "वज्रनाभस्य तद्राज्यं चतुर्धा चक्रतुर्नृप। विजयस्य चतुर्भागं जयन्ततनयस्य वै॥२५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 152,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "वज्रनाभवधः-०९७",
      "combined_translation": "25-25"
    },
    {
      "verse": 26,
      "sanskrit": "प्रद्युम्नस्य चतुर्भागं रौक्मिणेयसुतस्य च। चन्द्रप्रभस्य ददतुश्चतुर्भागं जनेश्वर॥२६॥",
      "english": null,
      "bhavadeepa": "विजयस्य इन्द्रपौत्रस्य॥२५॥",
      "chapter": 152,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "वज्रनाभवधः-०९७",
      "combined_translation": "26-26"
    },
    {
      "verse": 27,
      "sanskrit": "कोट्यश्चतस्रो ग्रामाणामधिकास्ता विशाम्पते। शाखापुरसहस्रं च स्फीतं वज्रपुरोपमम्। चतुर्धा चक्रतुस्तत्र संहृष्टौ शक्रकेशवौ॥२७॥",
      "english": null,
      "bhavadeepa": "प्रद्युम्नस्य प्रद्युम्नपुत्रस्य रौक्मिणेयोऽत्र साम्बस्तत्सुतस्य परिशेषः चन्द्रप्रभस्य गदपुत्रस्य॥२६॥",
      "chapter": 152,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "वज्रनाभवधः-०९७",
      "english_ref": 1,
      "combined_translation": "1-27"
    },
    {
      "verse": 28,
      "sanskrit": "कम्बलाजिनवासांसि रत्नानि विविधानि च। चतुर्धा चक्रतुर्वीरौ वीरवासवकेशवौ॥२८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 152,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "वज्रनाभवधः-०९७"
    },
    {
      "verse": 29,
      "sanskrit": "ततोऽभिषिक्तास्ते वीरा राजानो वासवाज्ञया। देवदुन्दुभिवाद्येन नृप विष्णुपदीजलैः॥२९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 152,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "वज्रनाभवधः-०९७"
    },
    {
      "verse": 30,
      "sanskrit": "स्वयं शक्रेण देवेन केशवेन च धीमता। ऋषिवंशे महात्मानः शक्रमाधवनन्दनाः॥३०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 152,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "वज्रनाभवधः-०९७"
    },
    {
      "verse": 31,
      "sanskrit": "विजयश्च प्रसिद्धैव गतिर्वियति धीमतः। मातृजेन गुणेनापि माधवानां महात्मनाम्॥३१॥",
      "english": null,
      "bhavadeepa": "ऋषिवंशे ऋषिसङ्घसमीपे अभिषिक्ता इति पूर्वस्थेनान्वयः॥३०॥",
      "chapter": 152,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "वज्रनाभवधः-०९७"
    },
    {
      "verse": 32,
      "sanskrit": "अभिषिच्य जयन्तं तु वासवो भगवान्ब्रवीत्। त्वयैते वीर संरक्ष्या राजानः समितिञ्जयाः॥३२॥",
      "english": null,
