  "chapter": 276,
  "verse_count": 25,
  "verses": [
    {
      "verse": 1,
      "sanskrit": "वैशम्पायन उवाच।\n              ततः क्रुद्धो महाराज पौण्ड्रो मदबलान्वितः। नारदं विप्रवर्यं तं प्रोवाच नृपसंसदि॥१॥",
      "english": null,
      "bhavadeepa": "तच्च शार्ङ्गादिकं तत्र विष्णौ स्थितं न दाप्यते त्वदीयेन शार्ङ्गादिना न च्छेद्येत इत्यर्थः “दा प्लवने” इत्यस्य रूपम्॥२३॥",
      "chapter": 276,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पौण्ड्रकस्य द्वारकावरोधः",
      "combined_translation": "1-24"
    },
    {
      "verse": 2,
      "sanskrit": "किमिदं प्राह विप्रर्षे राजाहं च द्विजैः सह। गच्छ त्वं काममथ वा मुने शापप्रदः सदा॥२॥",
      "english": null,
      "bhavadeepa": "तत इति॥१॥",
      "chapter": 276,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पौण्ड्रकस्य द्वारकावरोधः",
      "combined_translation": "2-2"
    },
    {
      "verse": 3,
      "sanskrit": "भीतस्त्वत्तो महाबुद्धे गच्छ त्वं काममद्य हि। इत्युक्तो नृपवीर्येण तूष्णीमेव स नारदः॥३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 276,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पौण्ड्रकस्य द्वारकावरोधः",
      "combined_translation": "3-3"
    },
    {
      "verse": 4,
      "sanskrit": "जगामाकाशगमनो यत्र तिष्ठति केशवः। स गत्वा विष्णुसङ्काशं विष्णोः सर्वं शशंस ह॥४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 276,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पौण्ड्रकस्य द्वारकावरोधः",
      "combined_translation": "4-4"
    },
    {
      "verse": 5,
      "sanskrit": "तच्छ्रुत्वा भगवान्विष्णुर्यथेष्टं वदतामिति। दर्पं तस्यापनेष्यामि श्वोभूते द्विजसत्तम॥५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 276,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पौण्ड्रकस्य द्वारकावरोधः",
      "combined_translation": "5-5"
    },
    {
      "verse": 6,
      "sanskrit": "इत्युक्त्वा विररामैव तस्मिन्बदरिकाश्रमे। ततः पौण्ड्रो महाबाहुर्बलैर्बहुभिरीश्वरः॥६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 276,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पौण्ड्रकस्य द्वारकावरोधः",
      "combined_translation": "6-6"
    },
    {
      "verse": 7,
      "sanskrit": "अश्वैरनेकसाहस्रैर्गजैर्बहुभिरन्वितः। शस्त्रकोटिसमायुक्तः स राजा सत्यसङ्गरः॥७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 276,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पौण्ड्रकस्य द्वारकावरोधः",
      "combined_translation": "7-7"
    },
    {
      "verse": 8,
      "sanskrit": "अनेकशतसाहस्रैः पत्तिभिश्च समन्वितः। एकलव्यप्रभृतिभी राजभिश्च समन्ततः॥८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 276,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पौण्ड्रकस्य द्वारकावरोधः",
      "combined_translation": "8-8"
    },
    {
      "verse": 9,
      "sanskrit": "अष्टौ रथसहस्राणि नागानामयुतं तथा। अर्बुदं पत्तिसङ्घानां तद्बलं समपद्यत॥९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 276,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पौण्ड्रकस्य द्वारकावरोधः",
      "combined_translation": "9-9"
    },
    {
      "verse": 10,
      "sanskrit": "एतेन च बलेनाजौ प्रस्फुरन्नृपसत्तमः। विरराज महाराज उदयस्थो महारविः॥१०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 276,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पौण्ड्रकस्य द्वारकावरोधः",
      "combined_translation": "10-10"
    },
    {
      "verse": 11,
      "sanskrit": "स ययौ मध्यरात्रेण नगरीं द्वारकामनु। पत्तयो दीपिकाहस्ता रत्रौ तमसि दारुणे॥११॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 276,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पौण्ड्रकस्य द्वारकावरोधः",
      "combined_translation": "11-11"
    },
    {
      "verse": 12,
      "sanskrit": "ययुर्विविधशस्त्रौघा सम्पतन्तो महाबलाः। द्वारकां वीर्यसम्पन्नां महाघोरां नृपोत्तमाः॥१२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 276,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पौण्ड्रकस्य द्वारकावरोधः",
      "combined_translation": "12-12"
    },
    {
      "verse": 13,
      "sanskrit": "रथं महान्तमारुह्य शस्त्रौघश्च समावृतम्। पट्टिशासिसमाकीर्णं गदापरिघसङ्कुलम्॥१३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 276,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पौण्ड्रकस्य द्वारकावरोधः",
      "combined_translation": "13-13"
    },
    {
      "verse": 14,
      "sanskrit": "शक्तितोमरसङ्कीर्णं ध्वजमालासमाचितम्। किङ्किनीजालसंयुक्तं शरासिप्राससंयुतम्॥१४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 276,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पौण्ड्रकस्य द्वारकावरोधः",
      "combined_translation": "14-14"
    },
    {
      "verse": 15,
      "sanskrit": "महाघोरं महारौद्रं युगान्तजलदोपमम्। धनुर्गदासमाकीर्णं महावाद्योपमं महत्॥१५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 276,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पौण्ड्रकस्य द्वारकावरोधः",
      "combined_translation": "15-15"
    },
    {
      "verse": 16,
      "sanskrit": "अग्न्यर्कसदृशाकारं ययौ द्वारवतीमनु। गृहीतदीपिको राजा वीर्यवान्बलवान्नृप॥१६॥",
      "english": null,
      "bhavadeepa": "महवाद्योपमं महामेघगर्जिततुल्यध्वनिं महत् महान्तं रथम्॥१५॥",
      "chapter": 276,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पौण्ड्रकस्य द्वारकावरोधः",
      "combined_translation": "16-16"
    },
    {
      "verse": 17,
      "sanskrit": "हन्तुमैच्छज्जगन्नाथं वृष्णींश्चैव समन्ततः। आकर्षन्बलमुख्यांस्तान्राज्ञः सर्वान्महाद्युतिः॥१७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 276,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पौण्ड्रकस्य द्वारकावरोधः",
      "combined_translation": "17-17"
    },
    {
      "verse": 18,
      "sanskrit": "पुरद्वारं समासाद्य बलं संस्थाप्य यत्नतः। इदं प्रोवाच राजा तु नृपान्सर्वानवस्थितान्॥१८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 276,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पौण्ड्रकस्य द्वारकावरोधः",
      "combined_translation": "18-18"
    },
    {
      "verse": 19,
      "sanskrit": "ताड्यतामत्र भेरी तु नाम विश्राव्य मामकम्। युध्यतां युध्यतामत्र देयं वा प्रतिदीयताम्॥१९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 276,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पौण्ड्रकस्य द्वारकावरोधः",
      "combined_translation": "19-19"
    },
    {
      "verse": 20,
      "sanskrit": "आगतः पौण्ड्रको राजा युद्धार्थी वीरवत्तरः। हन्तुकामः समग्रान्वः कृष्णबाहुबलाश्रयान्॥२०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 276,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पौण्ड्रकस्य द्वारकावरोधः",
      "combined_translation": "20-20"
    },
    {
      "verse": 21,
      "sanskrit": "इति ते प्रेषिताः सर्वे समीयुः सूचकान्बहून्। दीपिकाश्च प्रदीप्यन्ते बह्व्यः शतसहस्रशः॥२१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 276,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पौण्ड्रकस्य द्वारकावरोधः",
      "combined_translation": "21-21"
    },
    {
      "verse": 22,
      "sanskrit": "इतश्चेतश्च राजानो युध्यन्ते युद्धलालसाः। पुरीं ते पुरतस्तत्र क्षत्रियाः शस्त्रिणस्तदा॥२२॥",
      "english": null,
      "bhavadeepa": "सूचकान्बाह्यान्तरवृत्तान्तज्ञान् यदावभाटान्। सूर्यकान् इति पाठे सूर्यप्रकृतींस्तत्तुल्यान् यदून्॥२१॥",
      "chapter": 276,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पौण्ड्रकस्य द्वारकावरोधः",
      "combined_translation": "22-22"
    },
    {
      "verse": 23,
      "sanskrit": "सिंहनादं प्रकुर्वन्तः शस्त्रधारासमाकुलाः। कुतोऽयं वृष्णिप्रवरः कुतो राजा जगत्पतिः॥२३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 276,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पौण्ड्रकस्य द्वारकावरोधः",
      "combined_translation": "23-23"
    },
    {
      "verse": 24,
      "sanskrit": "कुतोऽयं सात्यकिर्वीरः कुतो हार्दिक्य एव च। कुतो नु बलभद्रश्च सर्वयादवसत्तमः। इत्येवं कथयन्तो वै राजानः सर्व एव ते॥२४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 276,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पौण्ड्रकस्य द्वारकावरोधः",
      "combined_translation": "24-24"
    },
    {
      "verse": 25,
      "sanskrit": "आदाय शस्त्राणि बहूनि सर्वतः शरांश्च चापानि बहूनि सर्वे। युद्धय सन्नाहनिबद्धशो ययुर्हरेः पुरीं द्वारवतीं नृपोत्तमाः॥२५॥",
