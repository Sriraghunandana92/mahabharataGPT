{
  "adhyaya_id": "P19_U02_A064",
  "book": 19,
  "parva_name": "हरिवंशः",
  "upaparva_name": "विष्णुपर्व",
  "adhyaya_name": "पारिजातहरणम्-०६४",
  "chapter": 119,
  "verse_count": 73,
  "verses": [
    {
      "verse": 1,
      "sanskrit": "वैशम्पायन उवाच।\n              निहत्य नरकं भौमं वासवोपमविक्रमम्। वासवावरजो विष्णुर्ददर्श नरकालयम्॥१॥",
      "english": null,
      "bhavadeepa": "हे देव तस्य नरकस्य ते प्रसिद्धे॥१२६॥",
      "chapter": 119,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पारिजातहरणम्-०६४"
    },
    {
      "verse": 2,
      "sanskrit": "अथार्थगृहमासाद्य नरकस्य जनार्दनः। ददर्श धनमक्षय्यं रत्नानि विविधानि च॥२॥",
      "english": null,
      "bhavadeepa": "चतुःषष्टितमेऽध्याये ह्यमुष्मिन्नन्दनस्थितम्। पारिजातं समुद्धृत्य द्वारकामनयद्धरिः॥१॥ निहत्येति॥१॥",
      "chapter": 119,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पारिजातहरणम्-०६४",
      "combined_translation": "2-2"
    },
    {
      "verse": 3,
      "sanskrit": "मनिमुक्ताप्रवालानि वैदूर्यस्य च सञ्चयान्। मासारगल्वकूटानि तथा वज्रस्य सञ्चयान्॥३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 119,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पारिजातहरणम्-०६४",
      "combined_translation": "3-3"
    },
    {
      "verse": 4,
      "sanskrit": "जाम्बूनदमयान्यस्य शातकुम्भमयानि च। प्रदीप्तज्वलनाभानि शीतरश्मिनिभानि च॥४॥",
      "english": null,
      "bhavadeepa": "मासारं मरकतं गल्वश्चन्द्रकान्तः वज्रं हीरः॥३॥",
      "chapter": 119,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पारिजातहरणम्-०६४",
      "combined_translation": "4-4"
    },
    {
      "verse": 5,
      "sanskrit": "शयनानि महार्हाणि तथा सिंहासनानि च। हिरण्यदण्डरुचिरं शीतरश्मिसमप्रभम्॥५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 119,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पारिजातहरणम्-०६४",
      "combined_translation": "5-5"
    },
    {
      "verse": 6,
      "sanskrit": "ददर्श तन्महच्छत्रं वर्षमाणमिवाम्बुदम्। जातरूपस्य शुभ्रस्य धाराः शतसहस्रशः॥६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 119,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पारिजातहरणम्-०६४",
      "combined_translation": "6-6"
    },
    {
      "verse": 7,
      "sanskrit": "वरुणादाहृतं पूर्वं नरकेणेति नः श्रुतम्। यावद्रत्नं गृहे दृष्टं नरकस्य धनं बहु॥७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 119,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पारिजातहरणम्-०६४",
      "combined_translation": "7-7"
    },
    {
      "verse": 8,
      "sanskrit": "नैव राज्ञः कुबेरस्य न शक्रस्य यमस्य च। रत्नसन्निचयस्तादृग्दृष्टपूर्वो न च श्रुतः॥८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 119,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पारिजातहरणम्-०६४",
      "combined_translation": "8-8"
    },
    {
      "verse": 9,
      "sanskrit": "हते भौमे निसुन्दे च हयग्रीवे च दानवे। उपानिन्युस्ततस्तानि रत्नान्यन्तःपुराणि च॥९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 119,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पारिजातहरणम्-०६४",
      "combined_translation": "9-9"
    },
    {
      "verse": 10,
      "sanskrit": "दानवा हतशिष्टा ये कोशसञ्चयरक्षिणः। केशवाय महार्हाणि यान्यर्हति जनार्दनः॥१०॥",
      "english": null,
      "bhavadeepa": "अन्तः पुराणि कन्यारत्नानि॥९॥",
      "chapter": 119,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पारिजातहरणम्-०६४",
      "combined_translation": "10-10"
    },
    {
      "verse": 11,
      "sanskrit": "दैत्या ऊचुः।\n              इमानि मणिरत्नानि विविधानि बहूनि च। भीमरूपाश्च मातङ्गाः प्रवालविकृताङ्कुशाः॥११॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 119,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पारिजातहरणम्-०६४",
      "combined_translation": "11-11"
    },
    {
      "verse": 12,
      "sanskrit": "हेमसूत्रा महाकक्षाश्चापतोमरशालिनः। रुचिराभिः पताकाभिः शबला रुचिराङ्कुशाः॥१२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 119,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पारिजातहरणम्-०६४",
      "combined_translation": "12-12"
    },
    {
      "verse": 13,
      "sanskrit": "ते च विंशतिसाहस्रा द्विस्तावत्यः करेणवः। अष्टौदश सहस्राणि देशजाश्चोत्तमा हयाः॥१३॥",
      "english": null,
      "bhavadeepa": "शबला नानावर्णाः॥१२॥",
      "chapter": 119,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पारिजातहरणम्-०६४",
      "combined_translation": "13-14"
    },
    {
      "verse": 14,
      "sanskrit": "गोषु चापि भवेत्कामो यावत्तव जनार्दन। तावतीः प्रापयिष्यामो वृष्ण्यन्धकनिवेशनम्॥१४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 119,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पारिजातहरणम्-०६४",
      "combined_translation": "14-17"
    },
    {
      "verse": 15,
      "sanskrit": "आविकानि च सूक्ष्माणि शयनान्यासनानि च। कामव्याहारिणश्चैव पक्षिणः प्रियदर्शनाः॥१५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 119,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पारिजातहरणम्-०६४",
      "combined_translation": "15-15"
    },
    {
      "verse": 16,
      "sanskrit": "चन्दनागरुकाष्ठानि तथा कालीयकान्यपि। वसु यत्त्रिषु लोकेचु धर्मेणाधिगतं तव॥१६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 119,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पारिजातहरणम्-०६४",
      "combined_translation": "16-16"
    },
    {
      "verse": 17,
      "sanskrit": "प्रापयिष्याम तत्सर्वं वृष्ण्यन्धकनिवेशनम्। देवगन्धर्वरत्नानि पन्नगानां च यद्वसु। तानि सर्वाणि सन्तीह नरकस्य निवेशने॥१७॥",
      "english": null,
      "bhavadeepa": "कालीयकानि कालागरुकाष्ठानि॥१६॥",
      "chapter": 119,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पारिजातहरणम्-०६४",
      "english_ref": 14,
      "combined_translation": "14-17"
    },
    {
      "verse": 18,
      "sanskrit": "वैशम्पायन उवाच।\n              तच्च सर्वं हृषीकेशः परिगृह्य परीक्ष्य च। सर्वमाहारयामास दानवैर्द्वारकां पुरीम्॥१८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 119,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पारिजातहरणम्-०६४",
      "combined_translation": "18-18"
    },
    {
      "verse": 19,
      "sanskrit": "ततस्तद्वारुणं छत्रं स्वयमुत्क्षिप्य माधवः। हिरण्यवर्षं वर्षन्तमारुरोह विहङ्गमम्॥१९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 119,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पारिजातहरणम्-०६४",
      "combined_translation": "19-19"
    },
    {
      "verse": 20,
      "sanskrit": "गरुडं पतगश्रेष्ठं मूर्तिमन्तमिवाम्बुदम्। ततोऽभ्ययाद्गिरिश्रेष्ठमभितो मणिपर्वतम्॥२०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 119,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पारिजातहरणम्-०६४",
      "combined_translation": "20-20"
    },
    {
      "verse": 21,
      "sanskrit": "तत्र पुण्या ववुर्वाता ह्यभवंश्चामलाः प्रभाः। मणीनां हेमवर्णानामभिभूय दिवाकरम्॥२१॥",
      "english": null,
      "bhavadeepa": "मणिपर्वतं कन्यावरोधपुरम्॥२०॥",
      "chapter": 119,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पारिजातहरणम्-०६४",
      "combined_translation": "21-21"
    },
    {
      "verse": 22,
      "sanskrit": "तत्र वैदूर्यरत्नानि ददर्श मधुसूदनः। सतोरणपताकानि द्वाराणि शिखराणि च॥२२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 119,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पारिजातहरणम्-०६४",
      "combined_translation": "22-22"
    },
    {
      "verse": 23,
      "sanskrit": "विद्युद्ग्रथितमेघाभः प्रबभौ मणिपर्वतः। हेमचित्रवितानैश्च प्रासादैरुपशोभितः॥२३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 119,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पारिजातहरणम्-०६४",
      "combined_translation": "23-23"
    },
    {
      "verse": 24,
      "sanskrit": "तत्र ता वरहेमाभा ददर्श मधुसूदनः। गन्धर्वसुरमुख्यानां प्रिया दुहितरस्तथा॥२४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 119,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पारिजातहरणम्-०६४",
      "combined_translation": "24-24"
    },
    {
      "verse": 25,
      "sanskrit": "ददर्श पृथुलश्रोणीः संरुद्धा गिरिकन्दरे। नरकेण समानीता रक्ष्यमाणाः समन्ततः॥२५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 119,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पारिजातहरणम्-०६४",
      "combined_translation": "25-25"
    },
    {
      "verse": 26,
      "sanskrit": "त्रिविष्टपसमे देशे तिष्ठन्तीरपराजिताः। निर्विशन्त्यो यथा देव्यः सुखिन्यः कामवर्जिताः॥२६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 119,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पारिजातहरणम्-०६४",
      "combined_translation": "26-26"
    },
    {
      "verse": 27,
      "sanskrit": "परिवव्रुर्महाबाहुमेकवेणीधराः स्त्रियः। सर्वाः काषायवासिन्यः सर्वाश्च नियतेन्द्रियाः॥२७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 119,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पारिजातहरणम्-०६४",
      "combined_translation": "27-27"
    },
    {
      "verse": 28,
      "sanskrit": "व्रतोपवासतन्वङ्ग्यः काङ्क्षन्त्यः कृष्णदर्शनम्। समेत्य यदुसिंहस्य सर्वाश्चक्रुः स्त्रियोऽञ्जलीन्॥२८॥",
      "english": null,
      "bhavadeepa": "महाबाहुं कृष्णम्॥२७॥",
      "chapter": 119,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पारिजातहरणम्-०६४",
      "combined_translation": "28-28"
    },
    {
      "verse": 29,
      "sanskrit": "नरकं निहतं ज्ञात्वा मुरं चैव महसुरम्। हयग्रीवं निसुन्दं च ताः कृष्णं पर्यवारयन्॥२९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 119,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पारिजातहरणम्-०६४",
      "combined_translation": "29-29"
    },
    {
      "verse": 30,
      "sanskrit": "ये चासां रक्षिणो वृद्धा दानवा यदुनन्दनम्। कृताञ्जलिपुटाः सर्वे प्रणिपेतुर्वयोऽधिकाः॥३०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 119,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पारिजातहरणम्-०६४",
      "combined_translation": "30-30"
    },
    {
      "verse": 31,
      "sanskrit": "तासां परमनारीणामृषभाक्षं निरीक्ष्य तम्। सर्वासामेव सङ्कल्पः पतित्वेनाभवत्ततः॥३१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 119,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पारिजातहरणम्-०६४",
      "combined_translation": "31-31"
    },
    {
      "verse": 32,
      "sanskrit": "तस्य चन्द्रोपमं वक्त्रं निरीक्ष्य मुदितेन्द्रियाः। सम्प्रहृष्टा महाबाहुमिदं वचनमब्रुवन्॥३२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 119,
