{
  "adhyaya_id": "P19_U02_A077",
  "book": 19,
  "parva_name": "हरिवंशः",
  "upaparva_name": "विष्णुपर्व",
  "adhyaya_name": "पुण्यकविधिः-०७७",
  "chapter": 132,
  "verse_count": 28,
  "verses": [
    {
      "verse": 1,
      "sanskrit": "जनमेजय उवाच।\n              पुण्यकानां ममोत्पत्तिं कथयस्व द्विजोत्तम। द्वैपायनप्रसादेन सर्वं हि विदितं तव॥१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 132,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पुण्यकविधिः-०७७",
      "combined_translation": "1-36"
    },
    {
      "verse": 2,
      "sanskrit": "वैशम्पायन उवाच।\n              उमया पुण्यकविधिर्नरेन्द्रोत्पादितः पुरा। शृणु येन विधानेन लोके धर्मभृतां वर॥२॥",
      "english": null,
      "bhavadeepa": "सप्ताधिके सप्ततिके पुण्यकानां निरूप्यते। पार्वत्या तपसा युक्तं स्वरूपं तद्विधिस्तथा॥१॥ पुण्यकानामिति॥१॥",
      "chapter": 132,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पुण्यकविधिः-०७७",
      "combined_translation": "2-2"
    },
    {
      "verse": 3,
      "sanskrit": "स्वर्गान्नीते पारिजाते कृष्णेनाक्लिष्टकर्मणा। ययौ द्वारवतीं धीमान्नारदो मुनिसत्तमः॥३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 132,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पुण्यकविधिः-०७७",
      "combined_translation": "3-3"
    },
    {
      "verse": 4,
      "sanskrit": "देवासुरे नृपश्रेष्ठ सङ्ग्रामे समुपस्थिते। षट्पुरस्य वधे घोरे महादेवाज्ञयानघ॥४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 132,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पुण्यकविधिः-०७७",
      "combined_translation": "4-4"
    },
    {
      "verse": 5,
      "sanskrit": "कृष्णेन सहितं विप्रं नारदं धर्मवित्तमम्। आसीनं परिपप्रच्छ रुक्मिणी भैष्मिकी नृप॥५॥",
      "english": null,
      "bhavadeepa": "वधे कृते सति॥४॥",
      "chapter": 132,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पुण्यकविधिः-०७७",
      "combined_translation": "5-5"
    },
    {
      "verse": 6,
      "sanskrit": "तत्र जाम्बवती देवी सत्यभामा च भामिनी। गान्धारराजपुत्री च योगयुक्ता नराधिप॥६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 132,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पुण्यकविधिः-०७७",
      "combined_translation": "6-6"
    },
    {
      "verse": 7,
      "sanskrit": "देव्यश्च नृप कृष्णस्य बह्व्योऽन्या वै समागताः। कुलशीलगुणोपेता धर्मशीलाः पतिव्रताः॥७॥",
      "english": null,
      "bhavadeepa": "तत्र जाम्बवत्यादयोऽपि समागताः॥६॥",
      "chapter": 132,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पुण्यकविधिः-०७७",
      "combined_translation": "7-7"
    },
    {
      "verse": 8,
      "sanskrit": "रुक्मिण्युवाच।\n              मुने धर्मभृतां श्रेष्ठ धर्मज्ञानभृतां वर। उत्पत्तिं पुण्यकानां त्वं वक्तुमर्हस्यशेषतः॥८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 132,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पुण्यकविधिः-०७७",
      "combined_translation": "8-8"
    },
    {
      "verse": 9,
      "sanskrit": "विधिं च फलयोगं च दानकालं तथैव च। कौतूहलं नस्तत्सिद्धिं वदस्व वदतां वर॥९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 132,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पुण्यकविधिः-०७७",
      "combined_translation": "9-9"
    },
    {
      "verse": 10,
      "sanskrit": "नारद उवाच।\n              शृणु वैदर्भि धर्मज्ञे सपत्नीभिः सहानघे। पुण्यकानां विधिः प्रोक्तो यथा देवि पुरा मया॥१०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 132,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पुण्यकविधिः-०७७",
      "combined_translation": "10-10"
    },
    {
      "verse": 11,
      "sanskrit": "चचारोमा व्रतं देवी पुण्यकानां शुचिव्रता। व्रतावसानेऽथ तथा सख्यो देवि निमन्त्रिताः॥११॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 132,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पुण्यकविधिः-०७७",
      "combined_translation": "11-11"
    },
    {
      "verse": 12,
      "sanskrit": "अदित्याद्याः सुताः सर्वा दक्षस्याक्लिष्टकर्मणः। पौलोमी च शची देवी ख्याता लोके पतिव्रता॥१२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 132,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पुण्यकविधिः-०७७",
      "combined_translation": "12-12"
    },
    {
      "verse": 13,
      "sanskrit": "रोहिणी च महाभागा सोमस्य दयिता सती। फाल्गुनी च तथा पूर्वा रेवती च विशाम्पते॥१३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 132,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पुण्यकविधिः-०७७",
      "combined_translation": "13-13"
    },
    {
      "verse": 14,
      "sanskrit": "तथा शतभिषा चैव मघा च कुरुनन्दन। एताभिर्हि महादेवी पूर्वमाराधिता सती॥१४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 132,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पुण्यकविधिः-०७७",
      "combined_translation": "14-14"
    },
    {
      "verse": 15,
      "sanskrit": "गङ्गा सरस्वती चैव वेणी गोदा च निम्नगा। तथा वैतरणी चैव गण्डकी या च भारत॥१५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 132,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पुण्यकविधिः-०७७",
      "combined_translation": "15-15"
    },
    {
      "verse": 16,
      "sanskrit": "अन्याश्च सरितो रम्या लोपामुद्रा च भारत। सत्यश्चान्या जगद्देव्यो धारयति हि ताः शुभाः॥१६॥",
      "english": null,
      "bhavadeepa": "गङ्गाद्या नद्यभिमानिन्यो देवताः॥१५॥",
      "chapter": 132,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पुण्यकविधिः-०७७",
      "combined_translation": "16-16"
    },
    {
      "verse": 17,
      "sanskrit": "शुभाश्च गिरिनन्दिन्यो वह्निकन्याश्च सुव्रताः। स्वाहा वह्निप्रिया देवी सावित्री च यशस्विनी॥१७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 132,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पुण्यकविधिः-०७७",
      "combined_translation": "17-17"
    },
    {
      "verse": 18,
      "sanskrit": "ऋद्धिः कुबेरकान्ता च जलेशमहिषी तथा। भार्या पितृपतेश्चैव वसुपत्न्यस्तथा च याः॥१८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 132,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पुण्यकविधिः-०७७",
      "combined_translation": "18-18"
    },
    {
      "verse": 19,
      "sanskrit": "ह्रीःश्रीर्धृतिस्तथा कीर्तिराशा मेधा च सुव्रताः। प्रीतिर्मतिश्च ख्यातिश्च सन्नीतिश्च तपोधनाः॥१९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 132,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पुण्यकविधिः-०७७",
      "combined_translation": "19-19"
    },
    {
      "verse": 20,
      "sanskrit": "देव्यः सत्यस्तथैवान्याः सर्वभूतहिते रताः। तासां व्रतावसाने च पूजां चक्रेऽम्बिका तदा॥२०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 132,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पुण्यकविधिः-०७७",
      "combined_translation": "20-20"
    },
    {
      "verse": 21,
      "sanskrit": "तिलरत्नमयं दत्त्वा पर्वतं सर्वधान्यवत्। वासोभिर्भूषणैर्मुख्यैर्नानारागैः सुमध्यमे॥२१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 132,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पुण्यकविधिः-०७७",
      "english_ref": 1,
      "combined_translation": "1-21"
    },
    {
      "verse": 22,
      "sanskrit": "प्रतिगृह्य तु तां पूजां दत्तां देव्या तपोधनाः। उपविष्टाः कथाश्चित्राः कुर्वन्त्यो भर्तृदेवताः॥२२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 132,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पुण्यकविधिः-०७७",
      "english_ref": 3,
      "combined_translation": "3-22"
    },
    {
      "verse": 23,
      "sanskrit": "पुण्यकार्थं कथास्तासामासन्देवी शशंस याः। विधिं च पुण्यकस्याथ सतीनां भर्तृदेवते॥२३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 132,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पुण्यकविधिः-०७७"
    },
    {
      "verse": 24,
      "sanskrit": "तासां मतेन साध्वीनां सवासां सोमनन्दिनी। पर्यपृच्छदुमां देवीं पुण्यकानां विधिं वरा॥२४॥",
      "english": null,
      "bhavadeepa": "भर्तृदेवते पतिव्रतासमुदाये॥२३॥",
      "chapter": 132,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पुण्यकविधिः-०७७"
    },
    {
      "verse": 25,
      "sanskrit": "उमा तासां प्रियार्थं तु पुण्यकान्यब्रवीत्तदा। समक्षं मम वैदर्भि सर्वभूतहिते रता॥२५॥",
      "english": null,
      "bhavadeepa": "सोमनन्दिनी अरुन्धती॥२४॥",
      "chapter": 132,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पुण्यकविधिः-०७७"
    },
    {
      "verse": 26,
      "sanskrit": "ममैव चोमया दत्तः स तदा रत्नपर्वतः। प्रतिगृह्य मया चैव कृतो ब्राह्मणसाच्छुभे॥२६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 132,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पुण्यकविधिः-०७७"
    },
    {
      "verse": 27,
      "sanskrit": "उमा त्वरुन्धतीं साध्वीमामन्त्र्य यदभाषत। शृणु कल्याणि वक्ष्यामि सर्वाभिः सहिता शुभे॥२७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 132,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पुण्यकविधिः-०७७"
    },
    {
      "verse": 28,
      "sanskrit": "पुण्यकानां विधिं कृत्स्नं यथावदनुपूर्वशः। यथा चैव मया दृष्टस्तत एष विधिः शुभे॥२८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 132,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पुण्यकविधिः-०७७"
    }
  ]
}