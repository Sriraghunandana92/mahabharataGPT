{
  "adhyaya_id": "P19_U02_A111",
  "book": 19,
  "parva_name": "हरिवंशः",
  "upaparva_name": "विष्णुपर्व",
  "adhyaya_name": "वासुदेवमाहात्म्यम्-१११",
  "chapter": 166,
  "verse_count": 18,
  "verses": [
    {
      "verse": 1,
      "sanskrit": "जनमेजय उवाच।\n              भूय एव महाबाहो कृष्णास्य जगतां पतेः। माहात्म्यं श्रोतुमिच्छामि परमं द्विजसत्तम॥१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 166,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "वासुदेवमाहात्म्यम्-१११"
    },
    {
      "verse": 2,
      "sanskrit": "न हि मे तृप्तिरस्तीह शृण्वतस्तस्य धीमतः। कर्मणामनुसन्धानं पुराणस्य महात्मनः॥२॥",
      "english": null,
      "bhavadeepa": "भूय एवेति। पूर्वं धन्योपाख्याने यज्ञानामाश्चर्यभूतः कृष्ण इत्युक्तम्। इदानीं यज्ञभोक्तुः श्वेतद्वीपपतेरपि कृष्ण आश्चर्यभूत इत्युच्यत आख्यायिकामुखेन। तेन ‘कृष्णस्तु भगवान् स्वयम्’ इत्येतदुपपादितं भवति॥१॥",
      "chapter": 166,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "वासुदेवमाहात्म्यम्-१११",
      "combined_translation": "2-2"
    },
    {
      "verse": 3,
      "sanskrit": "वैशम्पायन उवाच\n              नान्तः शक्यः प्रभावस्य वक्तुं वर्षशतैरपि। गोविन्दस्य महाराज श्रूयतामिदमद्भुतम्॥३॥",
      "english": null,
      "bhavadeepa": "अनुसन्धानम् अनुक्रमम्॥२॥",
      "chapter": 166,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "वासुदेवमाहात्म्यम्-१११",
      "combined_translation": "3-3"
    },
    {
      "verse": 4,
      "sanskrit": "शरतल्पे शयानेन भीष्मेण परिचोदितः। गाण्डीवधन्वा बीभत्सुर्माहात्म्यं केशवस्य यत्॥४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 166,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "वासुदेवमाहात्म्यम्-१११",
      "combined_translation": "4-4"
    },
    {
      "verse": 5,
      "sanskrit": "राज्ञां मध्ये महाराज ज्येष्ठं भ्रातरमब्रवीत्। युधिष्ठिरं जितामित्रमिति तच्छृणु कौरव॥५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 166,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "वासुदेवमाहात्म्यम्-१११",
      "combined_translation": "5-5"
    },
    {
      "verse": 6,
      "sanskrit": "अर्जुन उवाच।\n              पुराहं द्वारकां यातः सम्बन्धीनवलोककः। न्यवसं पूजितस्तत्र भोजवृष्ण्यन्धकोत्तमैः॥६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 166,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "वासुदेवमाहात्म्यम्-१११",
      "combined_translation": "6-6"
    },
    {
      "verse": 7,
      "sanskrit": "ततः कदाचिद्धर्मात्मा दीक्षितो मधुसूदनः। एकाहेन महाबाहुः शास्त्रदृष्टेन कर्मणा॥७॥",
      "english": null,
      "bhavadeepa": "सम्बन्धीन् सम्बन्धिनः अवलोककः अवलोकयितुम्॥६॥",
      "chapter": 166,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "वासुदेवमाहात्म्यम्-१११",
      "combined_translation": "7-7"
    },
    {
      "verse": 8,
      "sanskrit": "ततो दीक्षितमासीनमभिगम्य द्विजोत्तमः। कृष्णं विज्ञापयामास त्राहि त्राहीति चाब्रवीत्॥८॥",
      "english": null,
      "bhavadeepa": "एकाहेन एकसुत्यावता सोमयागेन॥७॥",
      "chapter": 166,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "वासुदेवमाहात्म्यम्-१११",
      "combined_translation": "8-8"
    },
    {
      "verse": 9,
      "sanskrit": "ब्राह्मण उवाच।\n              रक्षाधिकारो भवतः परित्रायस्व मां विभो। चतुर्थांशं हि धर्मस्य रक्षिता लभते फलम्॥९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 166,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "वासुदेवमाहात्म्यम्-१११",
      "combined_translation": "9-9"
    },
    {
      "verse": 10,
      "sanskrit": "वासुदेव उवाच।\n              न भेतव्यं द्विजश्रेष्ठ रक्षामि त्वां कुतो भयम्। ब्रूहि तत्त्वेन भद्रं ते यद्यपि स्यात्सुदुष्करम्॥१०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 166,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "वासुदेवमाहात्म्यम्-१११",
      "combined_translation": "10-10"
    },
    {
      "verse": 11,
      "sanskrit": "ब्राह्मण उवाच।\n              जातो जातो महाबाहो पुत्रो मे ह्रियतेऽनघ। त्रयो हृताश्चतुर्थं त्वं कृष्ण रक्षितुमर्हसि॥११॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 166,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "वासुदेवमाहात्म्यम्-१११",
      "combined_translation": "11-11"
    },
    {
      "verse": 12,
      "sanskrit": "ब्राह्मण्याः सूतिकालोऽद्य तत्र रक्षा विधीयताम्। यथा ध्रियेदपत्यं मे तथा कुरु जनार्दन॥१२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 166,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "वासुदेवमाहात्म्यम्-१११",
      "combined_translation": "12-12"
    },
    {
      "verse": 13,
      "sanskrit": "अर्जुन उवाच।\n              ततो मामाह गोविन्दो दीक्षितोऽहं क्रताविति। रक्षा च ब्राह्मणे कार्या सर्वावस्थागतैरपि॥१३॥",
      "english": null,
      "bhavadeepa": "ध्रियेत् जीवेत्॥१२॥",
      "chapter": 166,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "वासुदेवमाहात्म्यम्-१११",
      "combined_translation": "13-13"
    },
    {
      "verse": 14,
      "sanskrit": "श्रुत्वाहमेवं कृष्णस्य वचोऽवोचं नराधिप। मां नियोजय गोविन्द रक्षिष्येऽहं द्विजं भयात्॥१४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 166,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "वासुदेवमाहात्म्यम्-१११",
      "combined_translation": "14-14"
    },
    {
      "verse": 15,
      "sanskrit": "इत्युक्तः स स्मितं कृत्वा मामुवाच जनार्दनः। रक्षसीत्येवमुक्तस्तु व्रीडितोऽस्मि नराधिप॥१५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 166,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "वासुदेवमाहात्म्यम्-१११",
      "combined_translation": "15-15"
    },
    {
      "verse": 16,
      "sanskrit": "ततो मां व्रीडितं मत्वा पुनराह जनार्दनः। गम्यतां कौरवश्रेष्ठ शक्यते यदि रक्षितुम्॥१६॥",
      "english": null,
      "bhavadeepa": "रक्षसीति। काकूक्त्या न रक्षसीत्यभिप्राय उन्नेयः॥१५॥",
      "chapter": 166,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "वासुदेवमाहात्म्यम्-१११",
      "combined_translation": "16-16"
    },
    {
      "verse": 17,
      "sanskrit": "त्वत्पुरोगाश्च रक्षन्तु  वृष्ण्यन्धकमहारथाः। ऋते रामं महाबाहुं प्रद्युम्नं च महाबलम्॥१७॥",
      "english": null,
