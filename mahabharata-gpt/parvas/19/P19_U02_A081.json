  "adhyaya_name": "उमाव्रतकथनसमाप्तिः-०८१",
  "chapter": 136,
  "verse_count": 44,
  "verses": [
    {
      "verse": 1,
      "sanskrit": "उमोवाच।\n              बान्धवान्सगुणानिच्छेदेकभक्तेन नित्यदा। सप्तमीं सप्तमीं नित्यं क्षपेत्स्त्री पतिदेवता॥१॥",
      "english": null,
      "bhavadeepa": "पर्यश्नातु उपवसतु अतथ्यमनृतम्॥५२॥",
      "chapter": 136,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "उमाव्रतकथनसमाप्तिः-०८१",
      "combined_translation": "1-53"
    },
    {
      "verse": 2,
      "sanskrit": "ततः संवत्सरे पूर्णे वृक्षं दद्याद्धिरण्मयम्। सदक्षिणं ब्राह्मणाय शुभबन्धुमती भवेत्॥२॥",
      "english": null,
      "bhavadeepa": "एकाशीतितमेऽध्याये सौष्ठवं स्वजनस्य च। भवेद्यैर्यैर्व्रतैर्यद्यत्तत्तत्स्पष्टं निरूप्यते॥१॥ बान्धवानिति॥१॥",
      "chapter": 136,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "उमाव्रतकथनसमाप्तिः-०८१",
      "combined_translation": "2-2"
    },
    {
      "verse": 3,
      "sanskrit": "करञ्जे दीपकं दद्यात्सदा या प्रमदा वरे। पूर्णे संवत्सरे दद्यात्सौवर्णं दीपकं ततः॥३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 136,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "उमाव्रतकथनसमाप्तिः-०८१",
      "combined_translation": "3-64"
    },
    {
      "verse": 4,
      "sanskrit": "रुच्या सा स्त्री भवेद्भर्तुरिष्टा पुत्रवती तथा। सपत्नीनामधि तथा दीपवज्ज्वलते शुभे॥४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 136,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "उमाव्रतकथनसमाप्तिः-०८१",
      "combined_translation": "4-4"
    },
    {
      "verse": 5,
      "sanskrit": "या शेषभोजिनी नित्यं नैव च स्यादरुन्तुदा। न च स्याद्व्यशना सौम्ये नित्यं च पतिदेवता॥५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 136,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "उमाव्रतकथनसमाप्तिः-०८१",
      "combined_translation": "5-5"
    },
    {
      "verse": 6,
      "sanskrit": "शौचान्विता च सततं न च रूक्षाभिभाषिणी। श्वश्रूश्वशुरयोर्नित्यं शुश्रूषाभिरता सती॥६॥",
      "english": null,
      "bhavadeepa": "व्यशना अन्नवर्जिता सौम्ये हे अरुन्धति॥५॥",
      "chapter": 136,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "उमाव्रतकथनसमाप्तिः-०८१",
      "combined_translation": "6-6"
    },
    {
      "verse": 7,
      "sanskrit": "किं तस्या व्रतकैः कार्यं किं वा स्यादुपवासकैः। या भर्तृदेवता नित्यं सत्यधर्मगुणान्विता॥७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 136,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "उमाव्रतकथनसमाप्तिः-०८१",
      "combined_translation": "7-7"
    },
    {
      "verse": 8,
      "sanskrit": "विधवा स्त्री तु या हि स्याद्दैवयोगात्सती सति। तस्या वक्ष्यामि यो धर्मः पुराणोक्तः सुमध्यमे॥८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 136,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "उमाव्रतकथनसमाप्तिः-०८१",
      "combined_translation": "8-8"
    },
    {
      "verse": 9,
      "sanskrit": "पतिं सङ्कल्पयित्वा सा चित्रस्थं वाथ मृन्मयम्। तस्य पूजां सदा कुर्यात्सतां धर्ममनुस्मरेत्॥९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 136,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "उमाव्रतकथनसमाप्तिः-०८१",
      "combined_translation": "9-9"
    },
    {
      "verse": 10,
      "sanskrit": "तत एवाभ्यनुज्ञां सा नित्यं याचेत सुव्रता। व्रतके चोपवासे च भोजने च विशेषतः॥१०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 136,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "उमाव्रतकथनसमाप्तिः-०८१",
      "combined_translation": "10-28"
    },
    {
      "verse": 11,
      "sanskrit": "भर्तृलोकान्व्रजत्येव न चेद्व्युच्चरते पतिम्। शाण्डिली सूर्यवद्भाति सततं पतिदेवता॥११॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 136,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "उमाव्रतकथनसमाप्तिः-०८१",
      "combined_translation": "11-11"
    },
    {
      "verse": 12,
      "sanskrit": "अद्यप्रभृति सर्वेषां देवानां चैव योषितः। द्रक्ष्यन्ति पुण्यकविधिं पौराणो यः सनातनः॥१२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 136,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "उमाव्रतकथनसमाप्तिः-०८१",
      "combined_translation": "12-12"
    },
    {
      "verse": 13,
      "sanskrit": "मुनिश्च नारदः कृत्स्नं पौराणं ज्ञास्यते विधिम्। उपवासस्य धर्मात्मा व्रतकानां तथैव च॥१३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 136,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "उमाव्रतकथनसमाप्तिः-०८१",
      "combined_translation": "13-13"
    },
    {
      "verse": 14,
      "sanskrit": "अदितिस्तपसेन्द्राणी त्वं च सोमसुते वरे। प्रवर्तने पुण्यकानां व्रतकानां च सर्वदा॥१४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 136,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "उमाव्रतकथनसमाप्तिः-०८१",
      "combined_translation": "14-14"
    },
    {
      "verse": 15,
      "sanskrit": "कीर्तनीयाः सतीनां हि भविष्यथ गुणान्विताः। उपवासव्रतविधिं यथावदिह कृत्स्नशः॥१५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 136,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "उमाव्रतकथनसमाप्तिः-०८१",
      "combined_translation": "15-15"
    },
    {
      "verse": 16,
      "sanskrit": "प्रादुर्भावेषु सर्वेषु भार्या विष्णोर्महात्मनः। ज्ञास्यन्ति पुण्यकविधिं नित्यमेव सनातनम्॥१६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 136,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "उमाव्रतकथनसमाप्तिः-०८१",
      "combined_translation": "16-16"
    },
    {
      "verse": 17,
      "sanskrit": "सविशेषं च धर्माणां स्त्रीधर्मेषु प्रशस्यते। पतिभक्तिरदुष्टत्वमवाग्दुष्टत्वमेव च॥१७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 136,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "उमाव्रतकथनसमाप्तिः-०८१",
      "combined_translation": "17-17"
    },
    {
      "verse": 18,
      "sanskrit": "नारद उवाच\n              एवमुक्तास्तु ताः साध्व्यो महादेव्या तपोधनाः। जग्मुर्हृष्टा महादेवीं प्रणिपत्य हरप्रियाम्॥१८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 136,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "उमाव्रतकथनसमाप्तिः-०८१",
      "combined_translation": "18-18"
    },
    {
      "verse": 19,
      "sanskrit": "अदितिर्व्रतकं चक्रे शृणुयाद्धर्मचारिणी। उमाव्रतविधिः सर्वः पूर्वोद्दिष्टस्तया कृतः॥१९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 136,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "उमाव्रतकथनसमाप्तिः-०८१",
      "combined_translation": "19-19"
    },
    {
      "verse": 20,
      "sanskrit": "पारिजाते निबध्याथ मम दत्तस्तु कश्यपः। अदितिव्रतकं नाम तद्दत्तं सत्यभामया॥२०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 136,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "उमाव्रतकथनसमाप्तिः-०८१",
      "combined_translation": "20-20"
    },
    {
      "verse": 21,
      "sanskrit": "तदेव व्रतकं दत्तं सावित्र्या धर्मनित्यया। तैरेव युक्तैः संयुक्तमिदं त्वभ्यधिकं कृतम्॥२१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 136,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "उमाव्रतकथनसमाप्तिः-०८१",
      "combined_translation": "21-21"
    },
    {
      "verse": 22,
      "sanskrit": "सन्ध्याकाले तु सम्प्राप्ते स्थाने स्थाने तथैव च। पूजनं वा नमस्कारो जपश्च द्विगुणः स्मृतः॥२२॥",
      "english": null,
      "bhavadeepa": "युक्तैः उचितसाधनैः॥२१॥",
      "chapter": 136,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "उमाव्रतकथनसमाप्तिः-०८१",
      "english_ref": 1,
      "combined_translation": "1-22"
    },
    {
      "verse": 23,
      "sanskrit": "सावित्रीव्रतकं कृत्वा तथादित्या व्रतं सती। भर्तुः कुलं पितृकुलमात्मानं चैव तारयेत्॥२३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 136,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "उमाव्रतकथनसमाप्तिः-०८१"
    },
    {
      "verse": 24,
      "sanskrit": "इन्द्राणी व्रतकं चक्रे तदेवौमं यथाविधि। रक्तमभ्यधिकं वासो भोजनं चैव सामिषम्॥२४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 136,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "उमाव्रतकथनसमाप्तिः-०८१"
    },
    {
      "verse": 25,
      "sanskrit": "चतुर्थे दिवसे वापि पुण्यकार्थं विधिः पुनः। अहोरात्रोपवासश्च देयं कुम्भशतं तथा॥२५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 136,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "उमाव्रतकथनसमाप्तिः-०८१"
    },
    {
      "verse": 26,
      "sanskrit": "गङ्गया व्रतकं दत्तं तदेवौमं यशस्करि। स्नानमभ्यधिकं त्वत्र प्रत्यूषस्यात्मनो जले॥२६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 136,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "उमाव्रतकथनसमाप्तिः-०८१"
    },
    {
      "verse": 27,
      "sanskrit": "अन्यस्मिन्वा जले माघशुक्लपक्षे हरिप्रिये। एतद्गङ्गाव्रतं नाम सर्वकामप्रदं स्मृतम्॥२७॥",
      "english": null,
      "bhavadeepa": "आत्मनो गङ्गायाः जले स्वयमाहृते स्वयमुपगते वा॥२६॥",
      "chapter": 136,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "उमाव्रतकथनसमाप्तिः-०८१"
    },
    {
      "verse": 28,
      "sanskrit": "सप्त सप्त च सप्ताथ कुलानि हरिवल्लभे। स्त्री तारयति धर्मज्ञा गङ्गाव्रतकचारिणी॥२८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 136,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "उमाव्रतकथनसमाप्तिः-०८१"
    },
    {
      "verse": 29,
      "sanskrit": "देयं कुम्भसहस्रं तु गङ्गाया व्रतके शुभे। तारणं पारणं चैव तद्व्रतं सार्वकामिकम्॥२९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 136,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "उमाव्रतकथनसमाप्तिः-०८१"
    },
    {
      "verse": 30,
      "sanskrit": "यमभार्या चकाराथ व्रतं यामरथं शुभम्। हेमन्ते तत्तु कर्तव्यमाकाशे हरिवल्लभे॥३०॥",
      "english": null,
      "bhavadeepa": "तारणं दुःखानां पारणं मनोरथानाम्॥२९॥",
      "chapter": 136,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "उमाव्रतकथनसमाप्तिः-०८१"
    },
    {
      "verse": 31,
      "sanskrit": "इमानि चैव वाक्यानि ब्रूयादाकाशमास्थिता। स्नात्वा शुचिसमाचारा नमस्कृत्य पतिं शुभे॥३१॥",
      "english": null,
      "bhavadeepa": "यामरथं नामतः आकाशे अनाच्छादिते देशे॥३०॥",
      "chapter": 136,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "उमाव्रतकथनसमाप्तिः-०८१"
    },
