  "verses": [
    {
      "verse": 1,
      "sanskrit": "वैशम्पायन उवाच।\n              प्रभातायां तु शर्वर्यां गन्तुमैच्छज्जनार्दनः। हुताग्निः कृतकल्याणः समाप्तवरदक्षिणः॥१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 257,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णस्य कैलासगमनविचारः",
      "combined_translation": "1-46"
    },
    {
      "verse": 2,
      "sanskrit": "गाश्च दत्त्वाथ विप्रेभ्यो नमस्कृत्य द्विजोत्तमान्। आस्थानमण्डपं कृष्णः प्रविवेश जगत्पतिः॥२॥",
      "english": null,
      "bhavadeepa": "प्रभातायामिति॥१॥",
      "chapter": 257,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णस्य कैलासगमनविचारः",
      "combined_translation": "2-2"
    },
    {
      "verse": 3,
      "sanskrit": "आसनं महदास्थाय वृष्णीनाहूय सर्वशः। बलभद्रं शिनेः पुत्रं हार्दिक्यं शुकसारणौ॥३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 257,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णस्य कैलासगमनविचारः",
      "combined_translation": "3-3"
    },
    {
      "verse": 4,
      "sanskrit": "उग्रसेनं महाबुद्धिमुद्धवं नीतिमत्तरम्। यस्य बुद्धिं समाश्रित्य जीवन्ते यादवाः सुखम्॥४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 257,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णस्य कैलासगमनविचारः",
      "combined_translation": "4-4"
    },
    {
      "verse": 5,
      "sanskrit": "नेता च यदुवृष्णीनां स तु धर्मपरः सदा। यस्य बिभ्यति देवाश्च नीतेस्तस्य महात्मनः॥५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 257,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णस्य कैलासगमनविचारः",
      "combined_translation": "5-5"
    },
    {
      "verse": 6,
      "sanskrit": "यस्य बुद्धिवशाद्विष्णुः शशास पृथिवीं सदा। तं च वृष्णिवरं वीरमुद्धवं देवसुप्रभम्॥६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 257,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णस्य कैलासगमनविचारः",
      "combined_translation": "6-6"
    },
    {
      "verse": 7,
      "sanskrit": "अन्यानपि यदून्सर्वानुवाच भगवान्हरिः। शृण्वन्तु मम वाक्यानि यादवाः सर्व एव हि। शृणु चापि वचो मह्यं पितुरुद्धव मे सखे॥७॥",
      "english": null,
      "bhavadeepa": "देववत्सुप्रभम्॥६॥",
      "chapter": 257,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णस्य कैलासगमनविचारः",
      "combined_translation": "7-7"
    },
    {
      "verse": 8,
      "sanskrit": "बाल्यात्प्रभृति यो यत्नो मम दुष्टनिबर्हणे। प्रत्यक्षं भवता दृष्टं पूतनानिधनं नृप॥८॥",
      "english": null,
      "bhavadeepa": "मह्यं मम पितुः सखे॥७॥",
      "chapter": 257,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णस्य कैलासगमनविचारः",
      "combined_translation": "8-8"
    },
    {
      "verse": 9,
      "sanskrit": "केशी च निहतो बाल्ये मया बालेन यादवाः। गोवर्धनो धृतः शैलो गावश्च परिपालिताः॥९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 257,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णस्य कैलासगमनविचारः",
      "combined_translation": "9-9"
    },
    {
      "verse": 10,
      "sanskrit": "अभिषिक्तोऽस्मि शक्रेण देवानामग्रतः स्तितः। कंसोऽपि निधनं नीतो मया चाणूरमुष्टिकौ॥१०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 257,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णस्य कैलासगमनविचारः",
      "combined_translation": "10-10"
    },
    {
      "verse": 11,
      "sanskrit": "उग्रसेनोऽभिषिक्तश्च कृता द्वारवती मया। अन्ये चापि नृपा राजन्बलिनो निहता मया॥११॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 257,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णस्य कैलासगमनविचारः",
      "combined_translation": "11-11"
    },
    {
      "verse": 12,
      "sanskrit": "योऽपि वीरो जरासन्धो निगृहीतो बलान्मया। भीमेन बलिना राजन्नयने मम यादवाः॥१२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 257,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णस्य कैलासगमनविचारः",
      "combined_translation": "12-12"
    },
    {
      "verse": 13,
      "sanskrit": "शृगालो निहतः सङ्ख्ये गोमन्ताद्गच्छता मया। योऽपि वीरो दुरात्मासौ दानवो नरको हतः॥१३॥",
      "english": null,
      "bhavadeepa": "भीमेन भीमद्वारा॥१२॥",
      "chapter": 257,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णस्य कैलासगमनविचारः",
      "combined_translation": "13-13"
    },
    {
      "verse": 14,
      "sanskrit": "निष्कण्टकमिमं लोकं कृतवान्राजसत्तमाः। किं तु वीरो नृपो जज्ञे सखा भौमस्य यादवाः॥१४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 257,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णस्य कैलासगमनविचारः",
      "combined_translation": "14-14"
    },
    {
      "verse": 15,
      "sanskrit": "पौण्ड्रो वीर्यवतां नेता दृष्टा चासौ सदा मम। शिष्यो द्रोणस्य रजेन्द्रो बली ब्रह्मास्त्रवित्कृती॥१५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 257,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णस्य कैलासगमनविचारः",
      "combined_translation": "15-15"
    },
    {
      "verse": 16,
      "sanskrit": "शास्त्रज्ञो नीतिमान्साक्षान्नेता सर्वस्य यत्नवान्। योद्धा युद्धप्रियो राजा जामदग्न्या इवापरः॥१६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 257,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णस्य कैलासगमनविचारः",
      "combined_translation": "16-16"
    },
    {
      "verse": 17,
      "sanskrit": "एकान्तशत्रुरस्माकं छिद्रान्वेषी सदा मम। बाधिष्यते पुरीं योद्धा च्छिद्रं यदि लभेत सः॥१७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 257,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णस्य कैलासगमनविचारः",
      "combined_translation": "17-17"
    },
    {
      "verse": 18,
      "sanskrit": "न ह्यल्पसाध्यो बलवान्पुण्ड्रस्येशो नृपोत्तमाः। यत्ता भवन्तस्तिष्ठन्तु प्रगृहीतशरासनाः॥१८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 257,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णस्य कैलासगमनविचारः",
      "combined_translation": "18-18"
    },
    {
      "verse": 19,
      "sanskrit": "यथा न बाधते राजा पुरीं यदुकुलाश्रयाम्। अहं तु यास्ये कैलासं कुतश्चित्कारणान्नृपाः॥१९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 257,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णस्य कैलासगमनविचारः",
      "combined_translation": "19-19"
    },
    {
      "verse": 20,
      "sanskrit": "शङ्करं द्रष्टुकामोऽस्मि भूतभावनभावनम्। यावदागमनं मह्यं तावद्यत्ता भवन्त्विह॥२०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 257,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णस्य कैलासगमनविचारः"
    },
    {
      "verse": 21,
      "sanskrit": "मया विरहितां चेमां यदि जानाति पौण्ड्रकः। आगमिष्यति राजेन्द्रो योत्स्यते च पुरीमिमाम्॥२१॥",
      "english": null,
      "bhavadeepa": "भूतभावनभावनं वियदादिकारणस्याव्यक्तस्यापि कारणम्। “तस्मादव्यक्तमुत्पन्नं त्रिगुणं द्विजसत्तम” इति अव्यक्तस्यापि साक्षित्वस्मरणात्॥२०॥",
      "chapter": 257,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णस्य कैलासगमनविचारः",
      "combined_translation": "21-21"
    },
    {
      "verse": 22,
      "sanskrit": "इमां निर्यादवीं कर्तुं शक्नोतीति च मे मतिः। यत्ता भवत राजेन्द्राः खड्गैः पाशैः परश्वधैः॥२२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 257,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णस्य कैलासगमनविचारः",
      "combined_translation": "22-22"
    },
    {
      "verse": 23,
      "sanskrit": "पाषाणैः कर्षणीयैश्च सन्नद्धा भवत स्वकैः। पिधाय च कपाटानि महाद्वाराणि यत्नतः॥२३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 257,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णस्य कैलासगमनविचारः",
      "combined_translation": "23-23"
    },
    {
      "verse": 24,
      "sanskrit": "एक एव महाद्वारो गमनागमने सदा। मुद्रया सह गच्छन्तु राज्ञो यो गन्तुमीप्सवः॥२४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 257,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णस्य कैलासगमनविचारः",
      "combined_translation": "24-24"
    },
    {
      "verse": 25,
      "sanskrit": "न चामुद्रः प्रवेष्टव्यो द्वारपालस्य पश्यतः। यावदागमनं मह्यं तावदेवं भविष्यति॥२५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 257,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णस्य कैलासगमनविचारः",
      "combined_translation": "25-25"
    },
    {
      "verse": 26,
      "sanskrit": "मृगया नात्र कर्तव्या न च क्रीडा बहिः पुरात्। ज्ञातव्याश्च परे स्वे च गमनागमने सदा॥२६॥",
      "english": null,
