{
  "adhyaya_id": "P19_U02_A107",
  "book": 19,
  "parva_name": "हरिवंशः",
  "upaparva_name": "विष्णुपर्व",
  "adhyaya_name": "शम्बरवधः-१०७",
  "chapter": 162,
  "verse_count": 32,
  "verses": [
    {
      "verse": 1,
      "sanskrit": "वैशम्पायन उवाच।\n              शम्बरस्तु ततः क्रुद्धो मुद्गरं तं समाददे। मुद्गरे गृह्यमाणे तु द्वादशार्काः समुत्थिताः॥१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 162,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "शम्बरवधः-१०७"
    },
    {
      "verse": 2,
      "sanskrit": "पर्वताश्चलिताः सर्वे तथैव वसुधातलम्। उन्मार्गाः सागरा याताः सङ्क्षुब्धाश्चपि देवताः॥२॥",
      "english": null,
      "bhavadeepa": "शम्बरस्त्विति॥१॥",
      "chapter": 162,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "शम्बरवधः-१०७",
      "combined_translation": "2-2"
    },
    {
      "verse": 3,
      "sanskrit": "गृध्रचक्राकुलं व्योम उल्कापातो बभूव ह। ववर्ष रुधिरं देवः परुषं पवनो ववौ॥३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 162,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "शम्बरवधः-१०७",
      "combined_translation": "3-3"
    },
    {
      "verse": 4,
      "sanskrit": "एवं दृष्ट्वा महोत्पातान्प्रद्युम्नः स त्वरान्वितः। अवतीर्य रथाद्वीरः कृताञ्जलिपुटः स्थितः॥४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 162,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "शम्बरवधः-१०७",
      "combined_translation": "4-4"
    },
    {
      "verse": 5,
      "sanskrit": "देवीं सस्मार मनसा पार्वतीं शङ्करप्रियाम्। प्रणम्य शिरसा देवीं स्तोतुं समुपचक्रमे॥५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 162,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "शम्बरवधः-१०७",
      "combined_translation": "5-5"
    },
    {
      "verse": 6,
      "sanskrit": "प्रद्युम्न उवाच।\n              ॐ नमः कात्यायन्यै गिरीशायै नमो नमः। नमस्त्रैलोक्यमायायै कात्यायन्यै नमो नमः॥६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 162,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "शम्बरवधः-१०७",
      "combined_translation": "6-6"
    },
    {
      "verse": 7,
      "sanskrit": "नमः शत्रुविनाशिन्यै नमो गौर्यै शिवप्रिये। नमस्ये शुम्भमथनीं निशुम्भमथनीमपि॥७॥",
      "english": null,
      "bhavadeepa": "गिरीशायै गिरिशायै। दैर्घ्यमार्षम्॥६॥",
      "chapter": 162,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "शम्बरवधः-१०७",
      "combined_translation": "7-7"
    },
    {
      "verse": 8,
      "sanskrit": "कालरात्रि नमस्तुभ्यं कौमार्यै च नमो नमः। कान्तारवासिनीं देवीं नमस्यामि कृताञ्जलिः॥८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 162,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "शम्बरवधः-१०७",
      "combined_translation": "8-8"
    },
    {
      "verse": 9,
      "sanskrit": "विन्ध्यवासिनीं दुर्गघ्नां रणदुर्गां रणप्रियाम्। नमस्यामि महादेवीं जयां च विजयां तथा॥९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 162,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "शम्बरवधः-१०७",
      "combined_translation": "9-9"
    },
    {
      "verse": 10,
      "sanskrit": "अपराजितां नमस्येऽहमजितां शत्रुनाशिनीम्। घण्टाहस्तां नमस्यामि घण्टामालाकुलां तथा॥१०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 162,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "शम्बरवधः-१०७",
      "combined_translation": "10-10"
    },
    {
      "verse": 11,
      "sanskrit": "त्रिशूलिनीं नमस्यामि महिषासुरघातिनीम्। सिंहाननां नमस्यामि सिंहप्रवरकेतनाम्॥११॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 162,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "शम्बरवधः-१०७",
      "combined_translation": "11-11"
    },
    {
      "verse": 12,
      "sanskrit": "एकानंशां नमस्यामि गायत्रीं यज्ञसत्कृताम्। सावित्रीं चापि विप्राणां नमस्येऽहं कृताञ्जलिः॥१२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 162,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "शम्बरवधः-१०७",
      "combined_translation": "12-12"
    },
    {
      "verse": 13,
      "sanskrit": "रक्ष मां देवि सततं सङ्ग्रामे विजयं कुरु। इति कामवचस्तुष्टा दुर्गा सम्प्रीतमानसा॥१३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 162,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "शम्बरवधः-१०७",
      "combined_translation": "13-13"
    },
    {
      "verse": 14,
      "sanskrit": "उवाच वचनं देवी सुप्रीतेनान्तरात्मना। पश्य पश्य महाबाहो रुक्मिण्यानन्दवर्धन॥१४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 162,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "शम्बरवधः-१०७",
      "combined_translation": "14-24"
    },
    {
      "verse": 15,
      "sanskrit": "वरं वरय वत्स त्वममोघं दर्शनं मम। देव्यास्तु वचनं श्रुत्वा रोमाञ्चोद्गतमानसः॥१५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 162,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "शम्बरवधः-१०७",
      "combined_translation": "15-15"
    },
    {
      "verse": 16,
      "sanskrit": "प्रणम्य शिरसा देवीं विज्ञप्तुमुपचक्रमे। यदि त्वं देवि तुष्टासि दीयतां मे यदीप्सितम्॥१६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 162,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "शम्बरवधः-१०७",
      "combined_translation": "16-16"
    },
    {
      "verse": 17,
      "sanskrit": "वरं च वरदे याचे सर्वामित्रेषु मे जयः। यस्त्वया मुद्गरो दत्तः शम्बरस्यात्मसम्भवः॥१७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 162,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "शम्बरवधः-१०७",
      "combined_translation": "17-17"
    },
    {
      "verse": 18,
      "sanskrit": "एष मे गात्रमासाद्य माला पद्मवती भवेत्। तथास्त्विति च साप्युक्त्वा तत्रैवान्तरधीयत॥१८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 162,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "शम्बरवधः-१०७",
      "combined_translation": "18-18"
    },
    {
      "verse": 19,
      "sanskrit": "प्रद्युम्नस्तु महातेजास्तुष्टो रथमथारुहत्। मुद्गरं तं गृहीत्वा च शम्बरः क्रोधमूर्च्छितः॥१९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 162,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "शम्बरवधः-१०७",
      "combined_translation": "19-19"
    },
    {
      "verse": 20,
      "sanskrit": "भ्रामयित्वा स चिक्षेप प्रद्युम्नोरसि वीर्यवान्। स गत्वा मदनाभ्याशं माला भूत्वा तु पौष्करी॥२०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 162,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "शम्बरवधः-१०७",
      "combined_translation": "20-20"
    },
    {
      "verse": 21,
      "sanskrit": "प्रद्युम्नस्य च कण्ठे तु समासक्ता व्यराजत। नक्षत्राणां तु मालायां यथा परिवृतो विधुः॥२१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 162,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "शम्बरवधः-१०७",
      "combined_translation": "21-21"
    },
    {
      "verse": 22,
      "sanskrit": "ततो देवाः सगन्धर्वाः सिद्धाश्च परमर्षयः। साधु साध्विति वाचोचुः पूजयन्केशवात्मजम्॥२२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 162,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "शम्बरवधः-१०७",
      "combined_translation": "22-22"
    },
    {
      "verse": 23,
      "sanskrit": "मुद्गरं पुष्पभूतं तु दृष्ट्वा प्रद्युम्नसन्निधौ। वैष्णवं परमास्त्रं तु नारदेन यथाहृतम्॥२३॥",
      "english": null,
      "bhavadeepa": "वाचोचुः पूजयन् सन्धिरार्षः॥२२॥",
      "chapter": 162,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "शम्बरवधः-१०७",
      "combined_translation": "23-23"
    },
    {
      "verse": 24,
      "sanskrit": "सन्दधे चापमानम्य इदं वचनमब्रवीत्। यद्यहं रुक्मिणीपुत्रः केशवस्यात्मजो ह्यहम्॥२४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 162,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "शम्बरवधः-१०७",
      "combined_translation": "24-24"
    },
    {
      "verse": 25,
      "sanskrit": "तेन सत्येन बाणेन जहि त्वं शम्बरं रणे। इत्युक्त्वा चापमाकृष्य सन्धाय च महामनाः॥२५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 162,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "शम्बरवधः-१०७",
      "combined_translation": "25-25"
    },
    {
      "verse": 26,
      "sanskrit": "चिक्षेप शम्बरस्याथ दहँल्लोकत्रयं यथा। स क्षिप्तो वृष्णिसिंहेन शरः क्रव्यादमोहनः॥२६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 162,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "शम्बरवधः-१०७",
      "combined_translation": "26-26"
    },
    {
      "verse": 27,
      "sanskrit": "हृदयं शम्बरस्याथ भित्त्वा धरणिमागतः। न चास्य मांसं न स्नायुर्नास्थि न त्वङ् न शोणितम्॥२७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 162,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "शम्बरवधः-१०७",
      "combined_translation": "27-27"
    },
    {
      "verse": 28,
      "sanskrit": "सर्वं तद्भस्मसाद्भूतं वैष्णवास्त्रस्य तेजसा। हते दैत्ये महाकाये दानवे शम्बरेऽधमे॥२८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 162,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "शम्बरवधः-१०७",
      "combined_translation": "28-28"
    },
    {
      "verse": 29,
      "sanskrit": "जहृषुर्देवगन्धर्वा ननृतुश्चाप्सरोगणाः। उर्वशी मेनका रम्भा विप्रचित्तिस्तिलोत्तमा॥२९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 162,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "शम्बरवधः-१०७",
      "combined_translation": "29-29"
    },
    {
      "verse": 30,
      "sanskrit": "न नृतुर्हृष्टमनसो जगत्स्थावरजङ्गमम्। देवराजस्तु सुप्रीतः सर्वदेवगणैः सह। प्रद्युम्नं पुष्पवर्षेण तमभ्यर्च्य प्रहृष्टवत्॥३०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 162,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "शम्बरवधः-१०७",
      "combined_translation": "30-30"
    },
    {
      "verse": 31,
      "sanskrit": "अथ समरहते तु दैत्यराजे मधुमथनस्य सुतेन वैष्णवास्त्रैः। विगतरिपुभयाः सुराश्च जग्मुर्मकरविभूषणकेतनं स्तुवन्तः॥३१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 162,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "शम्बरवधः-१०७",
      "english_ref": 1,
      "combined_translation": "1-31"
    },
    {
      "verse": 32,
      "sanskrit": "स च समरपरिश्रमं वहन्वै नगरमुखं प्रविवेश रौक्मिणेयः। प्रियतम इव कान्तया प्रहृष्टस्त्वरितपदं रतिदर्शनं चकार॥३२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 162,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "शम्बरवधः-१०७"
    }
  ]
}