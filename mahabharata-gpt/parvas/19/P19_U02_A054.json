    {
      "verse": 1,
      "sanskrit": "वैशम्पायन उवाच।\n              एवं कथयमानं तं शाल्वराजं नृपाज्ञया। उवाच परमप्रीतो यवनाधिपतिर्नृपः॥१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 109,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कालयवनवाक्यम्-०५४",
      "combined_translation": "1-58"
    },
    {
      "verse": 2,
      "sanskrit": "कालयवन उवाच।\n              धन्योऽस्म्यनुगृहीतोऽस्मि सफलं जीवितं मम। कृष्णनिग्रहहेतोर्यन्नियुक्तो बहुभिर्नृपैः॥२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 109,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कालयवनवाक्यम्-०५४",
      "combined_translation": "2-2"
    },
    {
      "verse": 3,
      "sanskrit": "दुर्जयस्त्रिषु लोकेषु सुरासुरगणैरपि। तस्य निग्रहहेतोर्मामवधार्य जयाशिषम्॥३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 109,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कालयवनवाक्यम्-०५४",
      "combined_translation": "3-3"
    },
    {
      "verse": 4,
      "sanskrit": "प्रहृष्टै राजसिंहैस्तैरवधार्यो जयो मम। तेषां वाचाम्बुवर्षेण विजयो मे भविष्यति॥४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 109,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कालयवनवाक्यम्-०५४",
      "combined_translation": "4-4"
    },
    {
      "verse": 5,
      "sanskrit": "करिष्ये वचनं तेषां नृपसत्तमचोदितम्। पराजयोऽपि राजेन्द्र जयेन सदृशो मम॥५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 109,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कालयवनवाक्यम्-०५४",
      "combined_translation": "5-5"
    },
    {
      "verse": 6,
      "sanskrit": "अद्यैव तिथिनक्षत्रं मुहूर्तं करणं शुभम्। यास्यामि मथुरां राजन्विजेतुं केशवं रणे॥६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 109,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कालयवनवाक्यम्-०५४",
      "combined_translation": "6-6"
    },
    {
      "verse": 7,
      "sanskrit": "वैशम्पायन उवाच।\n              एवमाभाष्य राजानं सौभस्य पतिमूर्जितम्। सत्कृत्य च यथान्यायं महार्हमणिभूषणैः॥७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 109,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कालयवनवाक्यम्-०५४",
      "combined_translation": "7-7"
    },
    {
      "verse": 8,
      "sanskrit": "ब्राह्मणेभ्यो ददौ वित्तं सिद्धादेशाय वै नृपः। पुरोहिताय राजेन्द्र प्रददौ बहुशो धनम्॥८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 109,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कालयवनवाक्यम्-०५४",
      "combined_translation": "8-8"
    },
    {
      "verse": 9,
      "sanskrit": "हुत्वाग्निं विधिवद्राजा कृतकौतुकमङ्गलः। प्रस्थानं कृतवान्सम्यग्जेतुकामो जनार्दनम्॥९॥",
      "english": null,
      "bhavadeepa": "चतुष्पञ्चाशत्तमेऽथ शालवाक्येन तेजितः। अभ्ययाद्यवनाधीशः कृष्णं जेतुमितीर्यते॥१॥ सिद्धादेशाय अवितथाशिषे॥८॥",
      "chapter": 109,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कालयवनवाक्यम्-०५४",
      "combined_translation": "9-9"
