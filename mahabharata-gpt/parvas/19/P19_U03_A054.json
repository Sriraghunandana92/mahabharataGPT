{
  "adhyaya_id": "P19_U03_A054",
  "book": 19,
  "parva_name": "हरिवंशः",
  "upaparva_name": "भविष्यपर्व",
  "adhyaya_name": "देवासुरयोस्तुमुल्युद्धस्य यज्ञरूपेण वर्णनम्",
  "chapter": 237,
  "verse_count": 80,
  "verses": [
    {
      "verse": 1,
      "sanskrit": "वैशम्पायन उवाच।\n              उभयोः सेनयो राजन्भूयो युद्धमवर्तत। नादेन सञ्चालयतां त्रैलोक्यमिदमव्ययम्॥१॥",
      "english": "On hearing the assurance of grandparent brahma, mother earth went away as she has come, expecting the elimination of burdensome kings on earth, remembering the time-tag fixed to it",
      "bhavadeepa": null,
      "chapter": 237,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयोस्तुमुल्युद्धस्य यज्ञरूपेण वर्णनम्",
      "combined_translation": "1-42"
    },
    {
      "verse": 2,
      "sanskrit": "गोमुखाडम्बराणां च भेरीणां मुरजैः सह। झल्लरीडिण्डिमानां च व्यश्रूयन्त महास्वनाः॥२॥",
      "english": null,
      "bhavadeepa": "उभयोरिति। उभयोर्गोमुखादीनां नादेन प्रोत्साहितयोः सेनयोः॥१॥",
      "chapter": 237,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयोस्तुमुल्युद्धस्य यज्ञरूपेण वर्णनम्",
      "combined_translation": "2-2"
    },
    {
      "verse": 3,
      "sanskrit": "प्रवृत्तो युद्धयज्ञस्ते तुमुलो लोमहर्षणः। रणमध्ये महानादः स्वर्गीयः शूरसम्मतः॥३॥",
      "english": null,
      "bhavadeepa": "गोमुखादयस्तूर्यविशेषाः॥२॥",
      "chapter": 237,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयोस्तुमुल्युद्धस्य यज्ञरूपेण वर्णनम्",
      "combined_translation": "3-3"
    },
    {
      "verse": 4,
      "sanskrit": "युद्धयज्ञस्य नेताभूत्प्रह्रादो दैत्यसत्तमः। विरोचनस्तथाध्वर्युर्युद्धयज्ञप्रवर्तकः॥४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 237,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयोस्तुमुल्युद्धस्य यज्ञरूपेण वर्णनम्",
      "combined_translation": "4-4"
    },
    {
      "verse": 5,
      "sanskrit": "होता चैवात्र नमुचिर्वृत्रः स्तोत्रोपकल्पकः। मन्त्रा दैत्याः समाख्याता यज्ञकर्मणि तत्र वै॥५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 237,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयोस्तुमुल्युद्धस्य यज्ञरूपेण वर्णनम्",
      "combined_translation": "5-5"
    },
    {
      "verse": 6,
      "sanskrit": "अनुयातश्च पितृभिरधिको वा पराक्रमैः। यज्ञे तत्राभवद्बाणः संयुगे चोपतिष्ठते॥६॥",
      "english": null,
      "bhavadeepa": "स्तोत्रोपकल्पकः प्रस्तोता॥५॥",
      "chapter": 237,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयोस्तुमुल्युद्धस्य यज्ञरूपेण वर्णनम्",
      "combined_translation": "6-6"
    },
    {
      "verse": 7,
      "sanskrit": "ऐन्द्रं पाशुपतं ब्राह्मं स्थूणाकर्णं सुदुर्जयम्। मन्त्रास्तत्राभ्यवर्तन्त साध्वनुह्रादयोजिताः॥७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 237,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयोस्तुमुल्युद्धस्य यज्ञरूपेण वर्णनम्",
      "combined_translation": "7-7"
    },
    {
      "verse": 8,
      "sanskrit": "उद्गाता च मयः श्रीमान्स्थितः शत्रुभयङ्करः। विनदन्दितिजश्रेष्ठो देवानीकं व्यदारयत्॥८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 237,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयोस्तुमुल्युद्धस्य यज्ञरूपेण वर्णनम्",
      "combined_translation": "8-8"
    },
    {
      "verse": 9,
      "sanskrit": "बलिस्तु राजा द्युतिमान्त्स्वयं तत्र महासुरः। जाप्यैर्होमैश्च संयुक्तो ब्रह्मत्वमकरोत्प्रभुः॥९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 237,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयोस्तुमुल्युद्धस्य यज्ञरूपेण वर्णनम्",
      "combined_translation": "9-9"
    },
    {
      "verse": 10,
      "sanskrit": "रणाग्निर्ज्वलितो घोरो वैरेन्धनसमीरितः। हूयते त्वसुरैस्तत्र देवो विष्णुः सुरैः सह॥१०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 237,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयोस्तुमुल्युद्धस्य यज्ञरूपेण वर्णनम्",
      "combined_translation": "10-10"
    },
    {
      "verse": 11,
      "sanskrit": "शङ्खशब्दैः सुतुमुलैर्भेरीणां च महास्वनैः। उद्घुष्टं विमलं चैव ब्रह्मण्यं सुप्रयुज्यते॥११॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 237,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयोस्तुमुल्युद्धस्य यज्ञरूपेण वर्णनम्",
      "english_ref": 1,
      "combined_translation": "1-11"
    },
    {
      "verse": 12,
      "sanskrit": "बलश्च बलकश्चैव पुलोमा च महासुरः। प्रशस्तं च समं कृत्वा सत्रं सम्यक्प्रचक्रिरे॥१२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 237,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयोस्तुमुल्युद्धस्य यज्ञरूपेण वर्णनम्"
    },
    {
      "verse": 13,
      "sanskrit": "कल्माषदण्डविमला विपुला रथपङ्क्तयः। यूपाश्स्च समकल्पन्त युद्धयज्ञे महाफले॥१३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 237,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयोस्तुमुल्युद्धस्य यज्ञरूपेण वर्णनम्"
    },
    {
      "verse": 14,
      "sanskrit": "कर्णनालीकनाराचा वत्सदन्तोपबृंहिकाः। तोमराः सोमकलशा विचित्राणि धनूंषि च॥१४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 237,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयोस्तुमुल्युद्धस्य यज्ञरूपेण वर्णनम्"
    },
    {
      "verse": 15,
      "sanskrit": "अस्थीन्यत्र कपालानि पुरोडाशाः शिरांसि च। आज्यं च रौद्रं रुधिरं तस्मिन्यज्ञेऽभिहूयते॥१५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 237,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयोस्तुमुल्युद्धस्य यज्ञरूपेण वर्णनम्"
    },
    {
      "verse": 16,
      "sanskrit": "इध्माः परिधयस्तत्र प्रस्तारा विपुला गदाः। हयग्रीवोसिलोमा च राहुः केशी च दानवः॥१६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 237,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयोस्तुमुल्युद्धस्य यज्ञरूपेण वर्णनम्"
    },
    {
      "verse": 17,
      "sanskrit": "विरोचनश्च जम्भश्च कुजम्भश्च महाबलः। सदस्यास्तत्र तु मखे विप्रचित्तिस्तु वीर्यवान्॥१७॥",
      "english": null,
      "bhavadeepa": "इघ्माः प्रस्ताराः शरपङ्क्तयः परिधयो गदा इति सम्बन्धः॥१६॥",
      "chapter": 237,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयोस्तुमुल्युद्धस्य यज्ञरूपेण वर्णनम्"
    },
    {
      "verse": 18,
      "sanskrit": "इषवस्तु स्रुवास्तत्र रथाक्षसदृशाः शुभाः। धनुष्कोट्यो धनुर्ज्याश्च स्रुवस्तत्र महामखे॥१८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 237,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयोस्तुमुल्युद्धस्य यज्ञरूपेण वर्णनम्"
    },
    {
      "verse": 19,
      "sanskrit": "प्रतिप्रास्थानिकं कर्म वृषपर्वाकरोदिह। दीक्षितस्तत्र तु बलिस्तस्य पत्नी महाचमूः॥१९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 237,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयोस्तुमुल्युद्धस्य यज्ञरूपेण वर्णनम्"
    },
    {
      "verse": 20,
      "sanskrit": "शम्बरस्तत्र शामित्रमकरोद्दितिनन्दनः। अतिरात्रे महाबाहुर्वितते यज्ञकर्मणि॥२०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 237,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयोस्तुमुल्युद्धस्य यज्ञरूपेण वर्णनम्"
