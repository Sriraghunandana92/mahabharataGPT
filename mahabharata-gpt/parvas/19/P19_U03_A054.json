      "bhavadeepa": null,
      "chapter": 237,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयोस्तुमुल्युद्धस्य यज्ञरूपेण वर्णनम्"
    },
    {
      "verse": 30,
      "sanskrit": "हयानां हेषमाणानां दानवानां च गर्जताम्। क्ष्वेडितोत्क्रुष्टनिनदैः पाणिपादरवैस्तथा॥३०॥",
