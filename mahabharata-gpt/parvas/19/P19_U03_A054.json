      "bhavadeepa": null,
      "chapter": 237,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयोस्तुमुल्युद्धस्य यज्ञरूपेण वर्णनम्"
    },
    {
      "verse": 26,
      "sanskrit": "त्रैलोक्यहरणे सृष्टा युद्धयज्ञाय दीक्षिताः। बद्धकृष्णाजिनाः सर्वे व्रतिनो मुञ्जधारिणः॥२६॥",
