      "bhavadeepa": null,
      "chapter": 237,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयोस्तुमुल्युद्धस्य यज्ञरूपेण वर्णनम्"
    },
    {
      "verse": 27,
      "sanskrit": "एकनिश्चयकार्याश्च त्रैलोक्यजयकाङ्क्षिणः। सुरदानवदैत्यानां शब्दः समभवन्महान्॥२७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 237,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयोस्तुमुल्युद्धस्य यज्ञरूपेण वर्णनम्"
    },
    {
      "verse": 28,
      "sanskrit": "नानायुधविहस्तानां त्वरितानां प्रधावताम्। क्ष्वेडितोत्क्रुष्टनिनदैर्गजबृंहितनिःस्वनैः॥२८॥",
