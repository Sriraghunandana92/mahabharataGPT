{
  "adhyaya_id": "P19_U03_A104",
  "book": 19,
  "parva_name": "हरिवंशः",
  "upaparva_name": "भविष्यपर्व",
  "adhyaya_name": "हंसडिम्भकोत्पत्तिः",
  "chapter": 287,
  "verse_count": 19,
  "verses": [
    {
      "verse": 1,
      "sanskrit": "वैशम्पायन उवाच।\n              आसीच्छाल्वेषु राजेन्द्र ब्रह्मदत्तो नृपोत्तमः। नाम्ना राजन्स पूतात्मा सर्वभूतदयापरः॥१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 287,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हंसडिम्भकोत्पत्तिः",
      "combined_translation": "1-11"
    },
    {
      "verse": 2,
      "sanskrit": "पञ्चयज्ञपरो नित्यं जितात्मा विजितेन्द्रियः। ब्रह्मविद्वेदविच्चैव सदा यज्ञमयः शिवः॥२॥",
      "english": null,
      "bhavadeepa": "आसीदिति॥१॥",
      "chapter": 287,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हंसडिम्भकोत्पत्तिः",
      "combined_translation": "2-2"
    },
    {
      "verse": 3,
      "sanskrit": "तस्य भार्ये महीपाल रूपौदार्यगुणान्विते। बभूवतुः सुसम्पन्ने अनपत्ये नृपोत्तम॥३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 287,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हंसडिम्भकोत्पत्तिः",
      "combined_translation": "3-3"
    },
    {
      "verse": 4,
      "sanskrit": "स ताभ्यां मुमुदे राजा शच्या शक्र इवाम्बरे। नाम्ना मित्रसहो नाम सखा चासीद्द्द्विजोत्तमः॥४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 287,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हंसडिम्भकोत्पत्तिः",
      "combined_translation": "4-4"
    },
    {
      "verse": 5,
      "sanskrit": "तस्य राज्ञो महायोगी वेदवेदान्ततत्परः। अनपत्यः स विप्रेन्द्रो यथा राजा बभूव ह॥५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 287,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हंसडिम्भकोत्पत्तिः",
      "combined_translation": "5-5"
    },
    {
      "verse": 6,
      "sanskrit": "स राजा सहितस्ताभ्यामर्चयामास शङ्करम्। पुत्रार्थं शूलिनं शर्वं दश वर्षाण्यनन्यधीः॥६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 287,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हंसडिम्भकोत्पत्तिः",
      "combined_translation": "6-6"
    },
    {
      "verse": 7,
      "sanskrit": "स विप्रो वैष्णवं सत्रं पुत्रार्थे समयोजयत्। अर्चितस्तेन राजेन्द्र शङ्करो नीललोहितः॥७॥",
      "english": null,
      "bhavadeepa": "ताभ्यां स्त्रीभ्यां सह॥६॥",
      "chapter": 287,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हंसडिम्भकोत्पत्तिः",
      "combined_translation": "7-7"
    },
    {
      "verse": 8,
      "sanskrit": "आत्मानं दर्शयमास स्वप्ने राजानमब्रवीत्। प्रीतोऽस्मि तव भद्रं ते वरं वरय सुव्रत॥८॥",
      "english": null,
      "bhavadeepa": "स इति। तेन वैष्णवसत्रेण शङ्करस्यार्चनं विष्णुशङ्करयोर्वास्तवाभेदाभिप्रायेण॥७॥",
      "chapter": 287,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हंसडिम्भकोत्पत्तिः",
      "combined_translation": "8-8"
    },
    {
      "verse": 9,
      "sanskrit": "अथ राजा जगन्नाथमुवाचेदं स्मयन्निव। पुत्रौ मम भवेतां हि तथेत्युक्त्वा वृषध्वजः॥९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 287,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हंसडिम्भकोत्पत्तिः",
      "combined_translation": "9-9"
    },
    {
      "verse": 10,
      "sanskrit": "अन्तर्धानं गतः शम्भुः प्रतिबुद्धस्ततो नृपः। सोऽपि मित्रसहो विद्वान्देवं केशवमव्ययम्॥१०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 287,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हंसडिम्भकोत्पत्तिः",
      "combined_translation": "10-10"
    },
    {
      "verse": 11,
      "sanskrit": "पञ्चवर्षं जगन्नाथमर्चयामास भक्तितः। अर्चितस्तेन विप्रेण देवदेवो जनार्दनः॥११॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 287,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हंसडिम्भकोत्पत्तिः",
      "combined_translation": "11-11"
    },
    {
      "verse": 12,
      "sanskrit": "पुत्रमेकं ददौ तस्मै स्वात्मना सदृशं हरिः। ते भार्ये गर्भमाधत्तां तेजसा शङ्करस्य ह॥१२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 287,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हंसडिम्भकोत्पत्तिः",
      "combined_translation": "12-12"
    },
    {
      "verse": 13,
      "sanskrit": "विप्रभार्या महाराज वैष्णवं तेज आदधत्। महिष्यौ ते महावीर्ये पुत्रौ शङ्करनिर्मितौ॥१३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 287,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हंसडिम्भकोत्पत्तिः",
      "combined_translation": "13-13"
    },
    {
      "verse": 14,
      "sanskrit": "असूयेतां महीपाल क्रमेणैव नृपस्य ह। स तयोश्च महाराज नामकर्मादिकाः क्रियाः॥१४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 287,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हंसडिम्भकोत्पत्तिः",
      "combined_translation": "14-14"
    },
    {
      "verse": 15,
      "sanskrit": "चकार विधिवत्सर्वा विप्रेभ्योऽदान्महद्धनम्। स च विप्रो विनीतात्मा पुत्रमेकं हि लब्धवान्॥१५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 287,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हंसडिम्भकोत्पत्तिः",
      "combined_translation": "15-15"
    },
    {
      "verse": 16,
      "sanskrit": "साक्षादिव जगन्नाथं स्थितं पुत्रात्मना नृप। जातकर्मादिकं सर्वं ब्राह्मणः स चकार ह॥१६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 287,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हंसडिम्भकोत्पत्तिः",
      "combined_translation": "16-16"
    },
    {
      "verse": 17,
      "sanskrit": "तौ कुमारावयं चैव त्रयः सवयसोऽभवन्। वेदानधीत्य ते सर्वाञ्छ्रुत्वा चान्वीक्षिकीं तथा॥१७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 287,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हंसडिम्भकोत्पत्तिः",
      "combined_translation": "17-17"
    },
    {
      "verse": 18,
      "sanskrit": "धनुर्वेदे तथास्त्रे च निपुणास्तेऽभवंस्तदा। हंसो ज्येष्ठो नृपसुतो डिम्भकोऽनन्तरोऽभवत्॥१८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 287,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हंसडिम्भकोत्पत्तिः",
      "combined_translation": "18-18"
    },
    {
      "verse": 19,
      "sanskrit": "स च विप्रसुतो राजञ्जनार्दन इति स्मृतः। अन्योन्यं मित्रतां याताः सर्वे चैव कुमारकाः॥१९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 287,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
