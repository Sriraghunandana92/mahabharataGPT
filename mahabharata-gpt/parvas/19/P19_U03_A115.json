{
  "adhyaya_id": "P19_U03_A115",
  "book": 19,
  "parva_name": "हरिवंशः",
  "upaparva_name": "भविष्यपर्व",
  "adhyaya_name": "दूतस्य सन्देशनिवेदनम्",
  "chapter": 298,
  "verse_count": 39,
  "verses": [
    {
      "verse": 1,
      "sanskrit": "वैशम्पायन उवाच।\n              स निवेदितसर्वस्वो द्वाःस्त्येन हि जनार्दनः। अथ प्रविश्य धर्मात्मा सुधर्मां वै द्विजोत्तमः॥१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 298,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "दूतस्य सन्देशनिवेदनम्"
    },
    {
      "verse": 2,
      "sanskrit": "अपश्यद्देवदेवेशं सुधर्मकृतिसंस्थितम्। बलभद्रेण संयुक्तमध्यासितमहासनम्॥२॥",
      "english": null,
      "bhavadeepa": "स इति। निवेदितम् ईश्वरेऽर्पितं सर्वस्वं येन तादृशो द्वाःस्थेन द्वारा प्रविश्य सुधर्मां सभाम् अपश्यत्॥१॥",
      "chapter": 298,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "दूतस्य सन्देशनिवेदनम्",
      "combined_translation": "2-2"
    },
    {
      "verse": 3,
      "sanskrit": "अग्रतः स्थितशैनेयं पार्श्वतः स्थितनारदम्। दुर्वाससा कृतकथमुग्रसेनपुरस्कृतम्॥३॥",
      "english": null,
      "bhavadeepa": "सुधर्मः योगधर्मो साक्षात्तदाकारेण संस्थितिः संस्थानं यस्य तं सुधर्माकृतिसंस्थितम्॥२॥",
      "chapter": 298,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "दूतस्य सन्देशनिवेदनम्",
      "combined_translation": "3-3"
    },
    {
      "verse": 4,
      "sanskrit": "गायद्गन्धर्वमुख्यैश्च नृत्यदप्सरसां गणैः। सेव्यमानं महाराज सूतमागधवन्दिभिः॥४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 298,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "दूतस्य सन्देशनिवेदनम्",
      "combined_translation": "4-4"
    },
    {
      "verse": 5,
      "sanskrit": "उद्गीयमानयशसं माधवं मधुसूदनम्। उद्गीयमनं विप्रैश्च सामभिः सामगैर्हरिम्। दृष्ट्वा प्रीतमना विष्णुं प्रोद्भूतपुलकच्छविः॥५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 298,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "दूतस्य सन्देशनिवेदनम्",
      "combined_translation": "5-5"
    },
    {
      "verse": 6,
      "sanskrit": "नाम्ना जनार्दनोऽस्मीति ननाम चरणौ हरेः। बलभद्रं ततो देवं ववन्दे शिरसा द्विजः॥६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 298,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "दूतस्य सन्देशनिवेदनम्",
      "combined_translation": "6-6"
    },
    {
      "verse": 7,
      "sanskrit": "दूतोऽस्मि देवदेवेश हंसस्य डिम्भकस्य च। इति ब्रुवाणं विप्रेन्द्रमिदमाह स माधवः॥७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 298,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "दूतस्य सन्देशनिवेदनम्",
      "combined_translation": "7-7"
    },
    {
      "verse": 8,
      "sanskrit": "आस्वेदं विष्टरं पूर्वं पश्चाद्ब्रूहि प्रयोजनम्। तथेति चाब्रवीद्विप्रो महदासनमास्थितः॥८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 298,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "दूतस्य सन्देशनिवेदनम्",
      "combined_translation": "8-8"
    },
    {
      "verse": 9,
      "sanskrit": "वाचा सम्पूज्य विप्रेन्द्रमपृच्छत्कुशलं हरिः। ब्रह्मदत्तस्य राजेन्द्र हंसस्य डिम्भकस्य च॥९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 298,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "दूतस्य सन्देशनिवेदनम्",
      "combined_translation": "9-9"
    },
    {
      "verse": 10,
      "sanskrit": "श्रुतं चापि तयोर्वीर्यं प्रयोजनमतो द्विज। अपि वा कुशलं विप्र पिस्तुतव जनार्दन॥१०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 298,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "दूतस्य सन्देशनिवेदनम्",
      "combined_translation": "10-10"
    },
    {
      "verse": 11,
      "sanskrit": "जनार्दन उवाच।\n              कुशलं ब्रह्मदत्तस्य पितुश्च मम केशव। तयोरेव जगन्नाथ हंसस्य डिम्भकस्य च॥११॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 298,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "दूतस्य सन्देशनिवेदनम्",
      "combined_translation": "11-11"
    },
    {
      "verse": 12,
      "sanskrit": "श्रीभगवानुवाच।\n              किमाहतुर्महीपलौ तौ हंसडिम्भकौ नृपौ। ब्रूहि सर्वमशेषेण नात्र शङ्का द्विजोत्तम॥१२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 298,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "दूतस्य सन्देशनिवेदनम्",
      "combined_translation": "12-12"
    },
    {
      "verse": 13,
      "sanskrit": "वाच्यं वाप्यथवावाच्यं कर्तव्यमथ चेतरत्। श्रुत्वा तस्य विधास्यामो युक्तरूपं द्विजोत्तम॥१३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 298,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "दूतस्य सन्देशनिवेदनम्",
      "combined_translation": "13-13"
    },
    {
      "verse": 14,
      "sanskrit": "दूतोऽसि सर्वथा विप्र न वाच्यावाच्यकल्पना। यत्कर्मकारनिर्दिष्टं तद्वाच्यं दूतजन्मना॥१४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 298,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "दूतस्य सन्देशनिवेदनम्",
      "combined_translation": "14-14"
    },
    {
      "verse": 15,
      "sanskrit": "नात्र शङ्का त्वया कार्या वक्तव्यस्येतरस्य च। अतो वद यथा प्रोक्तं ताभ्यामिह जनार्दन॥१५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 298,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "दूतस्य सन्देशनिवेदनम्",
      "combined_translation": "15-15"
    },
    {
      "verse": 16,
      "sanskrit": "केशवेनैवमुक्तस्तु प्रोवाच स जनार्दनः। अजानन्निव किं ब्रूषे सर्वं प्रत्यक्षदर्शिवान्॥१६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 298,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "दूतस्य सन्देशनिवेदनम्",
      "combined_translation": "16-16"
    },
    {
      "verse": 17,
      "sanskrit": "न चास्ति ते परोक्षं तु जगद्वृत्तान्तमच्युत। सर्वं हि मनसा पश्यन्किं त्वमात्थ वदेति माम्॥१७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 298,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "दूतस्य सन्देशनिवेदनम्",
      "combined_translation": "17-17"
    },
    {
      "verse": 18,
      "sanskrit": "विद्वद्भिर्गीयसे विष्णो त्वमेव जगतीपते। इच्छया सर्वमाप्नोषि दृष्टादृष्टविवेचनम्॥१८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 298,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "दूतस्य सन्देशनिवेदनम्",
      "combined_translation": "18-18"
    },
    {
      "verse": 19,
      "sanskrit": "त्वमेवेदं जगत्सर्वं जगच्च त्वयि तिष्ठति। न त्वया रहितो ह्येकः पदार्थः सचराचरः॥१९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 298,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "दूतस्य सन्देशनिवेदनम्",
      "combined_translation": "19-19"
    },
    {
      "verse": 20,
      "sanskrit": "नास्ति किञ्चिदवेद्यं ते सर्वगोऽसि जगत्पते। त्वमिन्द्रः सर्वभूतानां रुद्रः संहारकर्मकृत्॥२०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 298,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "दूतस्य सन्देशनिवेदनम्",
      "combined_translation": "20-20"
    },
    {
      "verse": 21,
      "sanskrit": "रक्षितासि सदा विष्णुः सर्वलोकस्य माधव। संसारस्य भवान्स्रष्टा किं त्वमात्थ वदेतिमान्॥२१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 298,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "दूतस्य सन्देशनिवेदनम्",
      "combined_translation": "21-21"
    },
    {
      "verse": 22,
      "sanskrit": "विद्वद्भिर्गीयसे नित्यं ज्ञानात्मेति च माधव। प्राणं प्राणविदः प्राहुस्त्वामेव पुरुषोत्तम॥२२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 298,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "दूतस्य सन्देशनिवेदनम्",
      "combined_translation": "22-22"
    },
    {
      "verse": 23,
      "sanskrit": "शब्दं शब्दविदः प्राहुस्त्वामेव पुरुशोत्तम। तथा सति हृषीकेश किं त्वमात्थ वदेति माम्॥२३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 298,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "दूतस्य सन्देशनिवेदनम्",
      "combined_translation": "23-23"
    },
    {
      "verse": 24,
      "sanskrit": "तथापि शृणु देवेश चोदितोऽस्मि यतस्त्वया। वेदत्यसकृदेवैतत्तस्माद्वक्ष्यामि माधव॥२४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 298,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "दूतस्य सन्देशनिवेदनम्",
      "english_ref": 1,
      "combined_translation": "1-24"
    },
    {
      "verse": 25,
      "sanskrit": "राजसूयेन यज्ञेन ब्रह्मदत्तोऽद्य यक्ष्यते। तदर्थं प्रेषितस्ताभ्यां हंसेन डिम्भकेन च॥२५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 298,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "दूतस्य सन्देशनिवेदनम्"
    },
    {
      "verse": 26,
      "sanskrit": "करार्थं यदुमुख्येभ्यस्तव चामन्त्रणाय हि। लवणं बहु देयं ते यज्ञार्थं तस्य केशव॥२६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 298,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "दूतस्य सन्देशनिवेदनम्"
    },
    {
      "verse": 27,
      "sanskrit": "इत्यर्थं प्रेषितस्ताभ्यां करं देहि तदाज्ञया। इदं त्वमपरं ताभ्यामुक्तं शृणु जगत्पते॥२७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 298,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "दूतस्य सन्देशनिवेदनम्"
    },
    {
      "verse": 28,
      "sanskrit": "लवणानि बहून्याशु प्रगृह्य त्वरितं भवान्। आगच्छतु तयो राज्ञोः सेयं केशव वाग्विभो॥२८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 298,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "दूतस्य सन्देशनिवेदनम्"
    },
    {
      "verse": 29,
      "sanskrit": "इत्युक्तवति विप्रेन्द्रे दूते तत्र तयोर्नृप। प्रहस्य सुचिरं कृष्णो बभाषे दूतमिश्वरः॥२९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 298,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "दूतस्य सन्देशनिवेदनम्"
    },
    {
      "verse": 30,
      "sanskrit": "शृणु दूत वचो मह्यं युक्तमुक्तं द्विजोत्तम। करं ददामि ताभ्यां तु करदोऽस्मि यतो नृप॥३०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 298,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "दूतस्य सन्देशनिवेदनम्"
    },
    {
      "verse": 31,
      "sanskrit": "धार्ष्ट्यमेतत्तयोर्विप्र मत्तो यस्तु करग्रहः। अहो धार्ष्ट्यमहो धार्ष्ट्यं तयोः क्षत्रियबीजयोः॥३१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 298,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "दूतस्य सन्देशनिवेदनम्"
    },
    {
      "verse": 32,
      "sanskrit": "इदमश्रुतपूर्वं मे मत्तो यस्तु करग्रहः। इत्युक्त्वा केशवो दूतमिदमाह स्म यादवान्॥३२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 298,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "दूतस्य सन्देशनिवेदनम्"
    },
