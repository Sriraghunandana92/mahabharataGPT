  "verses": [
    {
      "verse": 1,
      "sanskrit": "वैशम्पायन उवाच।\n              ततः सम्पूज्य गरुडं वासुदेवोऽनुमान्य च। सखिवच्चोपगृह्यैनमनुजज्ञे गृहं प्रति॥१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 155,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कृष्णस्य सभाप्रवेशः-१००"
    },
    {
      "verse": 2,
      "sanskrit": "सोऽनुज्ञातो हि सत्कृत्य प्रणम्य च जनार्दनम्। ऊर्ध्वमाचक्रमे पक्षी यथेष्टं गगनेचरः॥२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 155,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कृष्णस्य सभाप्रवेशः-१००",
      "combined_translation": "2-2"
    },
    {
      "verse": 3,
      "sanskrit": "स पक्षवातसङ्क्षुब्धं समुद्रं मकरालयम्। कृत्वा वेगेन महता ययौ पूर्वमहोदधिम्॥३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 155,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कृष्णस्य सभाप्रवेशः-१००",
      "combined_translation": "3-3"
    },
    {
      "verse": 4,
      "sanskrit": "कृत्यकाले उपस्थास्य इत्युक्त्वा गरुडे गते। कृष्णो ददर्श पितरं वृद्धमानकदुन्दुभिम्॥४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 155,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कृष्णस्य सभाप्रवेशः-१००",
      "combined_translation": "4-4"
    },
    {
      "verse": 5,
      "sanskrit": "उग्रसेनं च राजानं बलदेवं च सात्यकिम्। काश्यं सान्दीपनिं चैव ब्रह्मगार्ग्यं तथैव च॥५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 155,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कृष्णस्य सभाप्रवेशः-१००",
      "combined_translation": "5-5"
    },
    {
      "verse": 6,
      "sanskrit": "अन्यांश्च वृद्धान्वृष्णीनां तांश्च भोजान्धकांस्तथा। रत्नप्रवेकैर्दाशार्हान्वीर्यलब्धैस्तथार्चयत्॥६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 155,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कृष्णस्य सभाप्रवेशः-१००",
      "combined_translation": "6-6"
    },
    {
      "verse": 7,
      "sanskrit": "हता ब्रह्मद्विषः सर्वे जयन्त्यन्धकवृष्णयः। रणात्प्रतिनिवृत्तोऽयमक्षतो मधुसूदनः॥७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 155,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कृष्णस्य सभाप्रवेशः-१००",
      "combined_translation": "7-7"
    },
    {
      "verse": 8,
      "sanskrit": "इति चत्वररथ्यासु द्वारवत्यां सुपूजितः। चाक्रिको घोषयामास पुरुषो मृष्टकुण्डलः॥८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 155,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कृष्णस्य सभाप्रवेशः-१००",
      "combined_translation": "8-8"
    },
    {
      "verse": 9,
      "sanskrit": "ततः सान्दीपनिं पूर्वमभिगम्य जनार्दनः। ववन्दे वृष्णिनृपतिमाहुकं विनयान्वितः॥९॥",
      "english": null,
      "bhavadeepa": "चाक्रिको राजाज्ञाघोषकः॥८॥",
      "chapter": 155,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कृष्णस्य सभाप्रवेशः-१००",
      "combined_translation": "9-9"
    },
    {
      "verse": 10,
      "sanskrit": "तथा हि परिपूर्णाक्षमानन्दागतचेतसम्। ववन्दे सह रामेण पितरं वासवानुजः॥१०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 155,
      "parva_name": "हरिवंशः",
