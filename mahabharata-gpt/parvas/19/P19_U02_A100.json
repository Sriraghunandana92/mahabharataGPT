      "sanskrit": "उपगम्य तथा शेषान्सत्कृत्य च यथार्हतः। सर्वेषां नाम जग्राह दाशार्हाणामधोक्षजः॥११॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 155,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कृष्णस्य सभाप्रवेशः-१००",
      "combined_translation": "11-11"
    },
    {
      "verse": 12,
      "sanskrit": "ततः सर्वाणि दिव्यानि सर्वरत्नमयानि च। आसनाग्र्याणि विविशुरुपेन्द्रप्रमुखास्तदा॥१२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 155,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कृष्णस्य सभाप्रवेशः-१००",
      "combined_translation": "12-12"
    },
    {
      "verse": 13,
      "sanskrit": "ततस्तद्धनमक्षय्यं किङ्करैर्यत्समाहृतम्। तत्सभामानयामासुः पुरुषाः कृष्णशासनात्॥१३॥",
      "english": null,
      "bhavadeepa": "विविशुः अभिनिविविशुः आसनेषु उपविष्टाः॥१२॥",
      "chapter": 155,
      "parva_name": "हरिवंशः",
