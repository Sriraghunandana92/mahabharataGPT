{
  "adhyaya_id": "P19_U03_A118",
  "book": 19,
  "parva_name": "हरिवंशः",
  "upaparva_name": "भविष्यपर्व",
  "adhyaya_name": "सात्यकिवाक्यम्",
  "chapter": 301,
  "verse_count": 48,
  "verses": [
    {
      "verse": 1,
      "sanskrit": "वैशम्पायन उवाच।\n              इत्युक्तवति हंसे च धर्मात्माथ जनार्दनः। उवाच प्रहसन्वीरः स्तुवन्नारायणं सदा॥१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 301,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "सात्यकिवाक्यम्",
      "combined_translation": "1-15"
    },
    {
      "verse": 2,
      "sanskrit": "अद्राक्षमद्राक्षमहं जनार्दनं हस्तस्थशङ्खं वरचक्रधारिणम्। आतप्तजाम्बूनदभूषिताङ्गदं स्फुरत्प्रभाद्योतितरत्नधारिणम्॥२॥",
      "english": null,
      "bhavadeepa": "इतीति॥१॥",
      "chapter": 301,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "सात्यकिवाक्यम्",
      "combined_translation": "2-2"
    },
    {
      "verse": 3,
      "sanskrit": "अद्राक्षमेनं यदुभिः पुरातनैः संसेव्यमानं मुनिवृन्दमुख्यैः। संस्तूयमानं प्रभुभिः समागधैः स्मितप्रवालाधरपल्लवारुणम्॥३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 301,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "सात्यकिवाक्यम्",
      "combined_translation": "3-3"
    },
    {
      "verse": 4,
      "sanskrit": "अद्राक्षमेनं कविभिः पुरातनैर्विविच्य वेद्यं विधिवत्सहामरैः। प्रफुल्लनीलोत्पलशोभितं श्रिया विनिद्रहेमाब्जविराजितोदरम्॥४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 301,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "सात्यकिवाक्यम्",
      "combined_translation": "4-4"
    },
    {
      "verse": 5,
      "sanskrit": "भूयोऽहमद्राक्षमजं जगद्गुरुं प्रमोदयन्तं वचनेन यादवान्। निरूपयन्तं विधिवन्मुनीश्वरैः प्रवृत्तवेदार्थविधिं पुरातनैः॥५॥",
      "english": null,
      "bhavadeepa": "विविच्य देहादिभिः पृथक्कृत्य॥४॥",
      "chapter": 301,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "सात्यकिवाक्यम्",
      "combined_translation": "5-5"
    },
    {
      "verse": 6,
      "sanskrit": "अद्राक्षमद्राक्षमहं पुनः पुनः समस्तलोकैकहितैषिणं हरिम्। वसन्तमस्मिञ्जगतो हिताय जगन्मयं तान्परिभूय शत्रून्॥६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 301,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "सात्यकिवाक्यम्",
      "combined_translation": "6-6"
    },
    {
      "verse": 7,
      "sanskrit": "भूयोऽप्यपश्यं सह यादवेश्वरैर्विक्रीड्यमानं च विहारकाले। रमन्तमीड्यं रमयन्तमीश्वरान्यदूत्तमान्यादवमुख्यमीश्वरम्॥७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 301,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "सात्यकिवाक्यम्"
    },
    {
      "verse": 8,
      "sanskrit": "भूयोऽप्यपश्यं सरसीरुहेक्षणं समेतया भीष्मतनूजया हरिम्। वसन्तमम्भोनिधिशायिनं विभुं भक्तप्रियं भक्तजनास्पदं शिवम्॥८॥",
      "english": null,
      "bhavadeepa": "भूयोऽप्यद्राक्षमित्यनुषङ्गः॥७॥",
      "chapter": 301,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "सात्यकिवाक्यम्",
      "combined_translation": "8-8"
    },
    {
      "verse": 9,
      "sanskrit": "अद्राक्षद्राक्षमहं मुनिर्वृतः पिबन्पिबंस्तस्य वपुः पुरातनम्। नेत्रेण मीलद्विवरेण केवलं धन्योऽहमस्मीति तदा व्यचिन्तयम्॥९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 301,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "सात्यकिवाक्यम्",
      "combined_translation": "9-9"
    },
    {
      "verse": 10,
      "sanskrit": "अद्राक्षमम्बोजयुगं दधानं प्रभुं विभुं भूतमयं विभावनम्। आद्यं ककुद्मानमुरुं विभावसुं संस्मृत्य संस्मृत्य तमेव निर्वृतः॥१०॥",
      "english": null,
      "bhavadeepa": "मीलद्विवरेण अच्छ्रिद्रेण॥९॥",
      "chapter": 301,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "सात्यकिवाक्यम्",
      "combined_translation": "10-10"
    },
    {
      "verse": 11,
      "sanskrit": "अद्राक्षं जगतामीशं वक्षोराजितकौस्तुभम्। वीज्यमानं हरिं कृष्णं चामराणां शतैः सदा॥११॥",
      "english": null,
      "bhavadeepa": "ककुद्मानं माहात्म्यवन्तं विभावसुं भास्वन्तम्॥१०॥",
      "chapter": 301,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "सात्यकिवाक्यम्",
      "combined_translation": "11-11"
    },
    {
      "verse": 12,
      "sanskrit": "युवां विद्वेषयुक्तेन चेतसा यादवेश्वरम्। स्मरन्तं सर्वदा विष्णुं क्व चैवं क्व च वेत्ति कः॥१२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 301,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "सात्यकिवाक्यम्",
      "combined_translation": "12-12"
    },
    {
      "verse": 13,
      "sanskrit": "क्व च द्रक्ष्यामि तौ मन्दौ कृतो वा मत्पुरोगतौ। ध्यायन्तमित्थं देवेशं करे शत्रुवहं सदा॥१३॥",
      "english": null,
      "bhavadeepa": "युवां स्मरन्तमद्राक्षमित्यन्वयः। क्व देशे तौ वर्तेते क्व च वा काले तौ द्रक्ष्यामीति स्मरन्तमित्यर्थः॥१२॥",
      "chapter": 301,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "सात्यकिवाक्यम्",
      "combined_translation": "13-13"
    },
    {
      "verse": 14,
      "sanskrit": "हसन्तमेनमद्राक्षं करदं हास्यतत्परम्। वदन्तं नारदे वाचं दुर्वाससि यतीश्वरे॥१४॥",
      "english": null,
      "bhavadeepa": "कुतः केनोपायेन मत्पुरोगतौ तौ स्याताम् इति शेषः॥१३॥",
      "chapter": 301,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "सात्यकिवाक्यम्",
      "combined_translation": "14-14"
    },
    {
      "verse": 15,
      "sanskrit": "ब्रह्मसूत्रपदां वाणीं दापयन्तं मुनीश्वरम्। दृष्ट्वाहं तं हरिं देवं पुनः पुनरचिन्तयम्॥१५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 301,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "सात्यकिवाक्यम्",
      "combined_translation": "15-15"
    },
    {
      "verse": 16,
      "sanskrit": "असाध्यमिदमारब्धं ताभ्यामिति नृपोत्तम। नारब्धव्यमिदं कार्यमितः प्रभृति भूमिप॥१६॥",
      "english": null,
      "bhavadeepa": "दापयन्तं शिष्येभ्यः पाठयितुमनुज्ञां प्रयच्छन्तं मुनीश्वरं दुर्वाससम्॥१५॥",
      "chapter": 301,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "सात्यकिवाक्यम्",
      "combined_translation": "16-16"
    },
    {
      "verse": 17,
      "sanskrit": "निवृत्ता सा कथा हंसाचिन्तयद्ग्रहणं तव। तद्वृत्तामखिलं सर्वं वदिष्यति हि सात्यकिः। एतद्वचनमाकर्ण्य हंसः क्रुद्धोऽब्रवीत्वचः॥१७॥",
      "english": null,
      "bhavadeepa": "अचिन्तयमित्युक्त्वा स्वचिन्तनमेवाह- असाध्यमिति। इदं राजसूयाख्यं कर्म॥१६॥",
      "chapter": 301,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "सात्यकिवाक्यम्",
      "combined_translation": "17-17"
    },
    {
      "verse": 18,
      "sanskrit": "हंस उवाच।\n              अरे ब्राह्मणदायाद का नाम तव वागियम्। आवयोः पुरतो वक्तुं त्रैलोक्यं जेतुमिच्छतोः॥१८॥",
      "english": null,
      "bhavadeepa": "सा कथा कृष्णात्करो ग्राह्य इति। इयं कृष्णप्रशंसात्मिका॥१७॥",
      "chapter": 301,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "सात्यकिवाक्यम्",
      "combined_translation": "18-18"
    },
    {
      "verse": 19,
      "sanskrit": "मायया त्वां भ्रामयति कृष्णो लीलाविधानवित्। तं दृष्ट्वा भ्रम एवैष तव सञ्जायते महान्॥१९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 301,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "सात्यकिवाक्यम्",
      "combined_translation": "19-19"
    },
    {
      "verse": 20,
      "sanskrit": "शङ्खचक्रगदाशार्ङ्गवनमालाविभूषितम्। वृष्णिवीरं समावेश्य समुच्छ्रितयशोधरम्॥२०॥",
      "english": null,
      "bhavadeepa": "एष भ्रमः आत्मस्वशक्तताबुद्धिः। माययेत्यादिवाक्यं निन्दापरतया भासमानमपि वाग्देवताभिप्रायेण यथार्थमे। स्पष्टमेव हि मायावित्वं वतुर्भुजादिकत्वं च भगवतः शास्त्रे इति दिक्॥१९॥",
      "chapter": 301,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "सात्यकिवाक्यम्",
      "combined_translation": "20-20"
    },
    {
      "verse": 21,
      "sanskrit": "सूतमागधसंस्तावप्रकटद्वारबाहुकम्। अत्यद्भुतयशोराशिं विक्रमाल्लोकमण्डनम्॥२१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 301,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "सात्यकिवाक्यम्",
      "combined_translation": "21-21"
    },
    {
      "verse": 22,
      "sanskrit": "चतुर्भुजं बलाक्रान्तं वृष्णियादवसंमतम्। अहोऽद्य भ्रम एवैष दर्शनात्तस्य चक्रिणः॥२२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 301,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "सात्यकिवाक्यम्",
      "combined_translation": "22-22"
    },
    {
      "verse": 23,
      "sanskrit": "इदानीं च महाराज भ्रामयत्येव दुर्मतिः। त्वामेव विप्र मन्दात्मन्निन्द्रजालिकता हि या॥२३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 301,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "सात्यकिवाक्यम्",
      "combined_translation": "23-23"
    },
    {
      "verse": 24,
      "sanskrit": "चापल्यमिदमेवैतत्तव विप्र भ्रमोद्भवम्। अहो हि खलु सादृश्यं वक्तव्यं भवता मम॥२४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 301,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "सात्यकिवाक्यम्",
      "combined_translation": "24-24"
    },
    {
      "verse": 25,
      "sanskrit": "अहमेव त्वया विप्र मर्शये प्रोदितं वचः। सखिभावाद्द्विजश्रेष्ठ अन्यथा कः सहेदिदम्॥२५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 301,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "सात्यकिवाक्यम्",
      "combined_translation": "25-25"
    },
    {
      "verse": 26,
      "sanskrit": "गच्छ मन्दमते विप्र यथेष्टं साम्प्रतं तव। द्विज गच्छ यथेष्टं त्वं पृथिवीं पृथिवी तव॥२६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 301,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "सात्यकिवाक्यम्",
      "combined_translation": "26-26"
    },
    {
      "verse": 27,
      "sanskrit": "जित्वा गोपालदायादं हत्वा यादवकान्बहून्। एष नः प्रथमः कल्पो जेष्याम इति यादवान्॥२७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 301,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "सात्यकिवाक्यम्",
      "combined_translation": "27-27"
    },
    {
      "verse": 28,
      "sanskrit": "गच्छ गच्छेति विप्र त्वं दृष्टं परुषवादिनम्। शत्रुपक्षस्तुतिपरं सह युक्त्वा सदा मया॥२८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 301,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "सात्यकिवाक्यम्",
      "combined_translation": "28-28"
    },
    {
      "verse": 29,
      "sanskrit": "न मे विप्रवधः कार्यः कष्टादपि हि सर्वतः। इत्युक्त्वा ब्राह्मणं भूयो हंसः सात्यकिमब्रवीत्॥२९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 301,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "सात्यकिवाक्यम्",
      "combined_translation": "29-29"
    },
    {
      "verse": 30,
      "sanskrit": "भो भो यादवदायाद किमर्थं प्राप्तवानिह। किमब्रवीन्नन्दसुतः किं वासौ मेऽदिशत्करम्॥३०॥",
      "english": null,
