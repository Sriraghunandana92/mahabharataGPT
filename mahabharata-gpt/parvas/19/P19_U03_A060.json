{
  "adhyaya_id": "P19_U03_A060",
  "book": 19,
  "parva_name": "हरिवंशः",
  "upaparva_name": "भविष्यपर्व",
  "adhyaya_name": "देवासुरयुद्धे कुबेरानुह्रादयोर्युद्धम्",
  "chapter": 243,
  "verse_count": 74,
  "verses": [
    {
      "verse": 1,
      "sanskrit": "वैशम्पायन उवाच।\n              धनाध्यक्षमनुह्रादः प्रह्रादस्यानुजो बली। ससैन्यं योधयामास क्षोभयन्यक्षवाहिनीम्॥१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 243,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे कुबेरानुह्रादयोर्युद्धम्"
    },
    {
      "verse": 2,
      "sanskrit": "महता च बलौघेन त्वनुह्रादोऽसुरोत्तमः। अर्दयामास सङ्क्रुद्धो धनाध्यक्षं प्रतापवान्॥२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 243,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे कुबेरानुह्रादयोर्युद्धम्",
      "combined_translation": "2-2"
    },
    {
      "verse": 3,
      "sanskrit": "अमृष्यमाणांस्त्रिदशानाहवस्थानुदायुधान्। चकार कदनं घोरं धनुष्पाणिर्महासुरः॥३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 243,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे कुबेरानुह्रादयोर्युद्धम्",
      "combined_translation": "3-3"
    },
    {
      "verse": 4,
      "sanskrit": "आवर्त इव सञ्जज्ञे बलस्य महतो महान्। क्षुभितस्याप्रमेयस्य सागरस्येव सम्प्लवः॥४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 243,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे कुबेरानुह्रादयोर्युद्धम्",
      "combined_translation": "4-4"
    },
    {
      "verse": 5,
      "sanskrit": "त्रिदाशानां शरीरैस्तु दानवानां च मेदिनी। बभूव निचिता घोरैः पर्वतैरिव सम्प्लवे॥५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 243,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे कुबेरानुह्रादयोर्युद्धम्",
      "combined_translation": "5-5"
    },
    {
      "verse": 6,
      "sanskrit": "मेरुपृष्ठं तु रक्तेन रञ्जितं सम्प्रकाशते। सर्वतो माधवे मासि पुष्पितैरिव किंशुकः॥६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 243,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे कुबेरानुह्रादयोर्युद्धम्",
      "combined_translation": "6-6"
    },
    {
      "verse": 7,
      "sanskrit": "हतैर्वीरैर्गजैरश्वैः प्रावर्तत महानदी। शोणितौघा महाघोरा यमराष्ट्रविवर्धिनी॥७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 243,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे कुबेरानुह्रादयोर्युद्धम्",
      "combined_translation": "7-7"
    },
    {
      "verse": 8,
      "sanskrit": "शकृन्मेदोमहापङ्का सम्प्रकीर्णान्त्रशैवला। छिन्नकायशिरोमीना अङ्गावयवशाड्वला॥८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 243,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे कुबेरानुह्रादयोर्युद्धम्",
      "combined_translation": "8-8"
    },
    {
      "verse": 9,
      "sanskrit": "गृध्रहंससमाकीर्णा केकिसारसनादिता। वसाफेनसमाकीर्णा प्रोत्कृष्टस्तनितस्वरा॥९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 243,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे कुबेरानुह्रादयोर्युद्धम्",
      "combined_translation": "9-9"
    },
    {
      "verse": 10,
      "sanskrit": "तां कापुरुषदुस्तारां युद्धभूमौ महानदीम्। नदीमिवातपापाये हंससङ्घोपशोभिताम्॥१०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 243,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे कुबेरानुह्रादयोर्युद्धम्"
    },
    {
      "verse": 11,
      "sanskrit": "त्रिदशा दानवाश्चैव तेरुस्ते दुस्तरां नदीम्। यथा पद्मरजोध्वस्तां नलिनीं गजयूथपाः॥११॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 243,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे कुबेरानुह्रादयोर्युद्धम्",
      "combined_translation": "11-11"
    },
    {
      "verse": 12,
      "sanskrit": "ततः सृजन्तं बाणौघाननुह्रादं रथे स्थितम्। ददर्श तरसा देवो निघ्नन्तं यक्षवाहिनीम्॥१२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 243,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे कुबेरानुह्रादयोर्युद्धम्",
      "combined_translation": "12-12"
    },
    {
      "verse": 13,
      "sanskrit": "क्रुद्धस्ततो दैत्यबलं सूदयामास वित्तपः। विक्षिपन्निव खे वायुर्महाभ्रपटलं बलात्॥१३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 243,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे कुबेरानुह्रादयोर्युद्धम्",
      "combined_translation": "13-13"
    },
    {
      "verse": 14,
      "sanskrit": "समीक्ष्य तुमुलं युद्धमनुह्रादश्च वीर्यवान्। रथेनादित्यवर्णेन कुबेरमभिदुद्रुवे॥१४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 243,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे कुबेरानुह्रादयोर्युद्धम्",
      "combined_translation": "14-14"
    },
    {
      "verse": 15,
      "sanskrit": "स धनुर्धन्विनां श्रेष्ठो विकृष्य रणमूर्धनि। उत्ससर्ज शितान्बाणान्वित्तेशस्य महात्मनः॥१५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 243,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे कुबेरानुह्रादयोर्युद्धम्",
      "combined_translation": "15-15"
    },
    {
      "verse": 16,
      "sanskrit": "कुबेरं प्राप्य ते बाणा निर्भिद्य सुसमाहिताः। अपरान्पृष्ठतो जघ्नुर्व्यासक्तान्यक्षराक्षसान्॥१६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 243,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे कुबेरानुह्रादयोर्युद्धम्",
      "combined_translation": "16-16"
    },
    {
      "verse": 17,
      "sanskrit": "देवः शरैरभिहतो निशितैर्ज्वलनोपमैः। अनुह्रादं प्रत्युदियात्सङ्क्रुद्धः परमाहवे॥१७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 243,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे कुबेरानुह्रादयोर्युद्धम्",
      "combined_translation": "17-17"
    },
    {
      "verse": 18,
      "sanskrit": "ततो वैश्रवणो राजा क्रुद्धो यक्षगणैः सह। ववर्ष शरवर्षाणि दानवं प्रति वीर्यवान्॥१८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 243,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे कुबेरानुह्रादयोर्युद्धम्",
      "combined_translation": "18-18"
    },
    {
      "verse": 19,
      "sanskrit": "तद्यथा शारदं वर्षं गोवृषः शीघ्रमागतम्। अपारयन्वारयितुं प्रतिगृह्णन्निमीलितः॥१९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 243,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे कुबेरानुह्रादयोर्युद्धम्",
      "combined_translation": "19-19"
    },
    {
      "verse": 20,
      "sanskrit": "एवमेव कुबेरस्य शरवर्षं महासुरः। निमीलिताक्षः सहसा दैत्यः सहति दारुणम्॥२०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 243,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे कुबेरानुह्रादयोर्युद्धम्",
      "combined_translation": "20-20"
    },
    {
      "verse": 21,
      "sanskrit": "रोषितः शरवर्षेण धनदेन महासुरः। इन्द्रकेतुप्रतीकाशमभीतोऽपश्यत द्रुमम्॥२१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 243,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे कुबेरानुह्रादयोर्युद्धम्",
      "combined_translation": "21-21"
    },
    {
      "verse": 22,
      "sanskrit": "प्रवृद्धशाखाविटपं तरुणाङ्कुरपल्लवम्। उत्पाट्य कुपितो दैत्यस्तरुं फलसमन्वितम्॥२२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 243,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे कुबेरानुह्रादयोर्युद्धम्",
      "combined_translation": "22-22"
    },
    {
      "verse": 23,
      "sanskrit": "निजघान हयाञ्छ्रेष्ठान्कुबेरस्य महात्मनः। तस्य कर्म महाघोरं दृष्ट्वा सर्वे महासुराः॥२३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 243,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे कुबेरानुह्रादयोर्युद्धम्"
    },
    {
      "verse": 24,
      "sanskrit": "सिंहनादं नदन्ति स्म अनुह्रादप्रहर्षिताः। तयोस्तु तुमुलं युद्धं सञ्जज्ञे देवदैत्ययोः॥२४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 243,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे कुबेरानुह्रादयोर्युद्धम्",
      "combined_translation": "24-24"
    },
    {
      "verse": 25,
      "sanskrit": "ततस्तौ क्रोधरक्ताक्षावन्योन्यवधकाङ्क्षिणौ। अन्योन्यं विविधैः शस्त्रैर्घोरैर्जघ्नतुराहवे॥२५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 243,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे कुबेरानुह्रादयोर्युद्धम्",
      "combined_translation": "25-25"
    },
    {
      "verse": 26,
      "sanskrit": "त्रिदशा दानवान्त्सर्वे मथित्वा प्राणदंस्तदा। दानवैस्त्रिदशाश्चापि क्रुद्धैर्भुवि निपातिताः॥२६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 243,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे कुबेरानुह्रादयोर्युद्धम्",
      "combined_translation": "26-26"
    },
    {
      "verse": 27,
      "sanskrit": "दानवास्त्वथा सङ्क्रुद्धास्त्रिदशान्निशितैः शरैः। विव्यधुर्वज्रसङ्काशैः कङ्कपत्रैरजिह्मगैः॥२७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 243,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे कुबेरानुह्रादयोर्युद्धम्",
      "combined_translation": "27-27"
    },
    {
      "verse": 28,
      "sanskrit": "विदार्यमाणा दैत्यौघैस्त्रिदशास्तु महाबलाः। अमर्षिततराश्चक्रुर्युद्धकर्माण्यभीतवत्॥२८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 243,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे कुबेरानुह्रादयोर्युद्धम्",
      "combined_translation": "28-28"
    },
    {
      "verse": 29,
      "sanskrit": "ते गदाभिः सुभीमाभिः पट्टिशैः शूलमुद्गरैः। परिघैश्च सुतीक्ष्णाग्रैर्दानवाः पीडिताः शरैः॥२९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 243,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे कुबेरानुह्रादयोर्युद्धम्",
      "combined_translation": "29-29"
    },
    {
      "verse": 30,
      "sanskrit": "शरनिर्भिन्नगात्राश्च खड्गविच्छिन्नवक्षसः। जगृहुस्ते शिलाश्चैव द्रुमांश्चासुरसत्तमाः॥३०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 243,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवासुरयुद्धे कुबेरानुह्रादयोर्युद्धम्",
      "combined_translation": "30-30"
    },
    {
      "verse": 31,
      "sanskrit": "ते भीमसङ्गा दितिजा नर्दमानाः पुनः पुनः। ममन्थुस्त्रिदशान्वीर्याञ्छतशोऽथ सहस्रशः॥३१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 243,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
