      "combined_translation": "9-9"
    },
    {
      "verse": 10,
      "sanskrit": "सेव्यां देवैः सर्षिगणैः सर्वदेवनमस्कृताम्। कालीं कात्यायनीं देवीं भयदां भयनाशिनीम्॥१०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 175,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
