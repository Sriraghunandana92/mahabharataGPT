      "combined_translation": "11-11"
    },
    {
      "verse": 12,
      "sanskrit": "यूथस्याद्यां महाभागां शकुनीं रेवतीं तथा। तिथीनां पञ्चमीं षष्ठीं पूर्णमासीं चतुर्दशीम्॥१२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 175,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
