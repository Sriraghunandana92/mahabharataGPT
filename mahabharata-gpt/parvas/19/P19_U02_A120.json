      "combined_translation": "10-10"
    },
    {
      "verse": 11,
      "sanskrit": "कालरात्रिं कामगमां त्रिणेत्रां ब्रह्मचारिणीम्। सौदामिनीं मेघरवां वेतालीं विपुलाननाम्॥११॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 175,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
