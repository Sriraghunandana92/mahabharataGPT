      "combined_translation": "19-19"
    },
    {
      "verse": 20,
      "sanskrit": "निशुम्भशुम्भमथनीं गजकुम्भोपमस्तनीम्। जननीं सिद्धसेनस्य सिद्धचारणसेविताम्॥२०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 175,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "अनिरुद्धकृतार्यास्तवो तद्वरलाभश्च-१२०",
      "english_ref": 1,
      "combined_translation": "1-20"
    },
    {
      "verse": 21,
      "sanskrit": "चरां कुमारप्रभवां पार्वतीं पर्वतात्मजाम्। पञ्चाशद्देवकन्यानां पत्न्यो देवगणस्य च॥२१॥",
      "english": null,
      "bhavadeepa": "यदेति। सिद्धसेनस्य कार्तिकेयस्य॥२०॥",
      "chapter": 175,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "अनिरुद्धकृतार्यास्तवो तद्वरलाभश्च-१२०"
    },
    {
      "verse": 22,
      "sanskrit": "क्रद्रुपुत्रसहस्रस्य पुत्रपौत्रवरस्त्रियः। माता पिता जगन्मान्या दिवि देवाप्सरोगणैः॥२२॥",
      "english": null,
      "bhavadeepa": "देवकन्यानामिति तत्प्रभृतिनारीषु असिसान्निध्यं कुरुषे इत्यर्थश्चतुर्थेनान्वयः॥२१॥",
      "chapter": 175,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "अनिरुद्धकृतार्यास्तवो तद्वरलाभश्च-१२०"
    },
    {
      "verse": 23,
      "sanskrit": "ऋषिपत्नीगणानां च यक्षगन्धर्वयोषिताम्। विद्याधराणां नारीषु साध्वीषु मनुजासु च॥२३॥",
      "english": null,
      "bhavadeepa": null,
