      "combined_translation": "16-16"
    },
    {
      "verse": 17,
      "sanskrit": "दारुणीं मदिरावासां विन्ध्यकैलासवासिनीम्। वराङ्गनां सिंहरथीं बहुरूपां वृषध्वजाम्॥१७॥",
      "english": null,
