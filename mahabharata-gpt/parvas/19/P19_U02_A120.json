      "combined_translation": "12-12"
    },
    {
      "verse": 13,
      "sanskrit": "सप्तविंशह्तिऋक्षाणि नद्यः सर्वा दिशो दश। नगरोपवनोद्यानद्वाराट्टालकवासिनीम्॥१३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 175,
