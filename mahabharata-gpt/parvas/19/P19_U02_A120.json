      "combined_translation": "13-13"
    },
    {
      "verse": 14,
      "sanskrit": "ह्रीं श्रीं गङ्गां च गन्धर्वां योगिनीं योगदां सताम्। कीर्तिमाशां दिशं स्पर्शां नमस्यामि सरस्वतीम्॥१४॥",
      "english": null,
      "bhavadeepa": null,
