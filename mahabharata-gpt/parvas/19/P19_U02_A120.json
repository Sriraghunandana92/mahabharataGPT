  "verse_count": 48,
  "verses": [
    {
      "verse": 1,
      "sanskrit": "वैशम्पायन उवाच।\n              यदा बाणपुरे वीरः सोऽनिरुद्धः सहोषया। सन्निरुद्धो नरेन्द्रेण बाणेन बलिसूनुना॥१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 175,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "अनिरुद्धकृतार्यास्तवो तद्वरलाभश्च-१२०"
    },
    {
      "verse": 2,
      "sanskrit": "तदा देवीं कोटवतीं रक्षार्थं शरणं गतः। यद्गीतमनिरुद्धेन देव्याः स्तोत्रमिदं श्रुणु॥२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 175,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "अनिरुद्धकृतार्यास्तवो तद्वरलाभश्च-१२०",
      "combined_translation": "2-2"
    },
    {
      "verse": 3,
      "sanskrit": "अनन्तमक्षयं दिव्यमादिदेवं सनातनम्। नारायणं नमस्कृत्य प्रवरं जगतां प्रभुम्॥३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 175,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "अनिरुद्धकृतार्यास्तवो तद्वरलाभश्च-१२०",
      "combined_translation": "3-3"
    },
    {
      "verse": 4,
      "sanskrit": "चण्डीं कात्यायनीं देवीमार्यां लोकनमस्कृताम्। वरदां कीर्तयिष्यामि नामभिर्हरिसंस्तुतैः॥४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 175,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "अनिरुद्धकृतार्यास्तवो तद्वरलाभश्च-१२०",
      "combined_translation": "4-4"
    },
    {
      "verse": 5,
      "sanskrit": "ऋषिभिर्दैवतैश्चैव वाक्पुष्पैरर्चितां शुभाम्। तां देवीं सर्वदेहस्थां सर्वदेवनमस्कृताम्॥५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 175,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "अनिरुद्धकृतार्यास्तवो तद्वरलाभश्च-१२०",
      "combined_translation": "5-5"
    },
    {
      "verse": 6,
      "sanskrit": "अनिरुद्ध उवाच\n              महेन्द्रविष्णुभगिनीं नम्स्यामि हिताय वै। मनसा भावशुद्धेन शुचिः स्तोष्ये कृताञ्जलिः॥६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 175,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "अनिरुद्धकृतार्यास्तवो तद्वरलाभश्च-१२०",
      "combined_translation": "6-6"
    },
    {
      "verse": 7,
      "sanskrit": "गौतमीं कंसभयदां यशोदानन्दवर्द्धिनीम्। मेध्यां गोकुलसम्भूतां नन्दगोपस्य नन्दिनीम्॥७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 175,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "अनिरुद्धकृतार्यास्तवो तद्वरलाभश्च-१२०",
      "combined_translation": "7-7"
    },
    {
      "verse": 8,
      "sanskrit": "प्राज्ञां दक्षां शिवां सौम्यां दनुपुत्रविमर्दिनीम्। तां देवीं सर्वदेहस्थां सर्वभूतनमस्कृताम्॥८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 175,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "अनिरुद्धकृतार्यास्तवो तद्वरलाभश्च-१२०",
      "combined_translation": "8-8"
    },
    {
      "verse": 9,
      "sanskrit": "दर्शनीं पूरणीं मायां वह्निसूर्यशशिप्रभाम्। शान्तिं ध्रुवां च जननीं मोहिनीं शोषणीं तथा॥९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 175,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
