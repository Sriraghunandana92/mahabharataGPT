{
  "adhyaya_id": "P19_U03_A069",
  "book": 19,
  "parva_name": "हरिवंशः",
  "upaparva_name": "भविष्यपर्व",
  "adhyaya_name": "कश्यपादीन्प्रति महाविष्णोर्वरप्रदानकथावतारः",
  "chapter": 252,
  "verse_count": 21,
  "verses": [
    {
      "verse": 1,
      "sanskrit": "वैशम्पायन उवाच।\n              नारायणस्तु भगवाऽछ्रुत्वैतत्परमं स्तवम्। ब्रह्मज्ञेन द्विजेन्द्रेण कश्यपेन समीरितम्॥१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 252,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "कश्यपादीन्प्रति महाविष्णोर्वरप्रदानकथावतारः",
      "combined_translation": "1-8"
    },
    {
      "verse": 2,
      "sanskrit": "स्निग्धगम्बीरनिर्घोषजीमूतस्वननिःस्वनम्। मनसा प्रीतियुक्तेन विबुधानां महात्मनाम्॥२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 252,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "कश्यपादीन्प्रति महाविष्णोर्वरप्रदानकथावतारः",
      "combined_translation": "2-2"
    },
    {
      "verse": 3,
      "sanskrit": "उवाच वचनं सम्यग्हृष्टपुष्टपदाक्षरम्। आकाशाच्छुश्रुवे शब्दो दर्शनं नोपलभ्यते। श्रीमान्प्रीतमना देवः प्रोवाच प्रभुरीश्वरः॥३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 252,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "कश्यपादीन्प्रति महाविष्णोर्वरप्रदानकथावतारः",
      "combined_translation": "3-3"
    },
    {
      "verse": 4,
      "sanskrit": "विष्णुरुवाच।\n              प्रीतोऽस्मि वः सुरश्रेष्ठाः सर्वे मत्तो विनिश्चयम्। वरं वृणुत भद्रं वो वरदोऽस्मि सुरोत्तमाः॥४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 252,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "कश्यपादीन्प्रति महाविष्णोर्वरप्रदानकथावतारः",
      "combined_translation": "4-4"
    },
    {
      "verse": 5,
      "sanskrit": "कश्यप उवाच।\n              यदैव भगवान्प्रीतः सर्वेषाममरोत्तमः। तदैव कृतकृत्याः स्म त्वं हि नः परमा गतिः॥५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 252,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "कश्यपादीन्प्रति महाविष्णोर्वरप्रदानकथावतारः",
      "combined_translation": "5-5"
    },
    {
      "verse": 6,
      "sanskrit": "यदि प्रसन्नो भगवान्दातव्यो वा वरो यदि। वासवस्यानुजो भ्राता ज्ञातीनां नन्दिवर्धनः। अदित्यां वामनः श्रीमान्भगवानस्तु वः सुरः॥६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 252,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "कश्यपादीन्प्रति महाविष्णोर्वरप्रदानकथावतारः",
      "combined_translation": "6-6"
    },
    {
      "verse": 7,
      "sanskrit": "वैशम्पायन उवाच।\n              अदितिर्देवमाता च एतमेवार्थमुत्तमम्। पुत्रार्थे वरदं प्राह भगवन्तं वरार्थिनी॥७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 252,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "कश्यपादीन्प्रति महाविष्णोर्वरप्रदानकथावतारः",
      "combined_translation": "7-7"
    },
    {
      "verse": 8,
      "sanskrit": "अदितिरुवाच।\n              याचे त्वां पुत्रकामा वै भवान्पुत्रो भवत्विति। निःश्रेयसाय सर्वेषां देवानां हि महात्मनाम्॥८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 252,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "कश्यपादीन्प्रति महाविष्णोर्वरप्रदानकथावतारः",
      "combined_translation": "8-8"
    },
    {
      "verse": 9,
      "sanskrit": "देवा ऊचुः।\n              भ्राता भर्ता च दाता च शरणं च भवस्व नः। अदित्याः पुत्रतां याते त्वयि देवाः सवासवाः। देवशब्दं वहिष्यन्ति कश्यपस्यात्मजो भव॥९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 252,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "कश्यपादीन्प्रति महाविष्णोर्वरप्रदानकथावतारः",
      "combined_translation": "9-9"
    },
    {
      "verse": 10,
      "sanskrit": "वैशम्पायन उवाच।\n              ततस्तानब्रवीद्विष्णुर्देवान्कश्यपमेव च। एवं भवतु भद्रं वो यथेष्टं काममाप्नुत। सर्वेषामेव युष्माकं ये भविष्यन्ति शत्रवः॥१०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 252,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "कश्यपादीन्प्रति महाविष्णोर्वरप्रदानकथावतारः",
      "combined_translation": "10-10"
    },
    {
      "verse": 11,
      "sanskrit": "मुहूर्तमपि ते सर्वे न स्थास्यन्ति ममाग्रतः। हत्वासुरगणान्सर्वान्ये चान्ये देवशत्रवः॥११॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 252,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "कश्यपादीन्प्रति महाविष्णोर्वरप्रदानकथावतारः",
      "combined_translation": "11-11"
    },
    {
      "verse": 12,
      "sanskrit": "करिष्ये देवताः सर्वा यज्ञभागाग्रभोजिनः। हव्यादांश्च सुरान्सर्वान्क्रव्यादांश्च पितॄनपि॥१२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 252,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "कश्यपादीन्प्रति महाविष्णोर्वरप्रदानकथावतारः",
      "combined_translation": "12-12"
    },
    {
      "verse": 13,
      "sanskrit": "करिष्ये विबुधश्रेष्ठाः पारमेष्ठ्येन कर्मणा। यथागतेन मार्गेण निवर्तध्वं सुरोत्तमाः॥१३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 252,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "कश्यपादीन्प्रति महाविष्णोर्वरप्रदानकथावतारः",
      "combined_translation": "13-13"
    },
    {
      "verse": 14,
      "sanskrit": "देवमातुस्तथादित्याः कश्यपस्यामितात्मनः। यथामनीषितं कर्ता गच्छध्वं स्वं स्वमालयम्॥१४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 252,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "कश्यपादीन्प्रति महाविष्णोर्वरप्रदानकथावतारः",
      "combined_translation": "14-14"
    },
    {
      "verse": 15,
      "sanskrit": "वैशम्पायन उवाच।\n              एवमुक्ते तु वचने विष्णुना प्रभविष्णुना। देवाः प्रहृष्टमनसः पूजयन्ति स्म सर्वशः॥१५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 252,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "कश्यपादीन्प्रति महाविष्णोर्वरप्रदानकथावतारः",
      "combined_translation": "15-15"
    },
    {
      "verse": 16,
      "sanskrit": "विश्वेदेवा महात्मानः कश्यपोऽदितिरेव च। साध्या मरुद्गणाश्चैव शक्रश्चैव महाबलः। नमस्कृत्य सुरेशाय तस्मै देवाय रंहसे॥१६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 252,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "कश्यपादीन्प्रति महाविष्णोर्वरप्रदानकथावतारः",
      "combined_translation": "16-16"
    },
    {
      "verse": 17,
      "sanskrit": "प्रयाताः प्राग्दिशं दिव्यं विपुलं कश्यपाश्रमम्। गत्वा ते आश्रमं तत्र ब्रह्मर्षिगणसेवितम्। चेरुः स्वाध्यायनियता अदित्या गर्भमीप्सवः॥१७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 252,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "कश्यपादीन्प्रति महाविष्णोर्वरप्रदानकथावतारः",
      "combined_translation": "17-17"
    },
    {
      "verse": 18,
      "sanskrit": "अदितिर्देवमाता च गर्भं दध्नेऽतितेजसम्। भूतात्मानं महात्मानं दिव्यं वर्शसहस्रकम्॥१८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 252,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "कश्यपादीन्प्रति महाविष्णोर्वरप्रदानकथावतारः",
      "combined_translation": "18-18"
    },
    {
      "verse": 19,
      "sanskrit": "पूर्णे वर्षसहस्रे तु प्रसूता गर्भमुत्तमम्। सुराणां शरणं देवमसुराणां विनाशनम्॥१९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 252,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "कश्यपादीन्प्रति महाविष्णोर्वरप्रदानकथावतारः",
      "combined_translation": "19-19"
    },
    {
      "verse": 20,
      "sanskrit": "गर्भस्थेन तु देवेन परित्राताः सुरास्तदा। आददानेन तेजांसि त्रैलोक्यस्य महात्मना॥२०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 252,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "कश्यपादीन्प्रति महाविष्णोर्वरप्रदानकथावतारः",
      "combined_translation": "20-20"
    },
    {
      "verse": 21,
      "sanskrit": "तस्मिञ्जाते तु देवेश त्रैलोक्यस्य सुखावहे। भयदे दैत्यसङ्घानां सुराणां नन्दिवर्धने॥२१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 252,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "कश्यपादीन्प्रति महाविष्णोर्वरप्रदानकथावतारः",
      "combined_translation": "21-21"
    }
  ]
}