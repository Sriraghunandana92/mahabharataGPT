  "chapter": 261,
  "verse_count": 26,
  "verses": [
    {
      "verse": 1,
      "sanskrit": "वैशम्पायन उवाच।\n              ततः स भगवान् विष्णुर्दुर्विज्ञेयगतिः प्रभुः। तत्र पूर्वं तपस्तप्तमात्मना यादवेश्वरः॥१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 261,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णस्य समाधिः कोलाहलश्च",
      "combined_translation": "1-21"
    },
    {
      "verse": 2,
      "sanskrit": "गङ्गायाश्चोत्तरे तीरे देशं द्रष्टुमुपागतः। स्वयमेव हरिः साक्षात्प्रविवेश तपोवनम्॥२॥",
      "english": null,
      "bhavadeepa": "तत इति॥१॥",
      "chapter": 261,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णस्य समाधिः कोलाहलश्च",
      "combined_translation": "2-2"
    },
    {
      "verse": 3,
      "sanskrit": "प्रविश्य सुचिरं देशं ददर्श च मनोरमम्। निषसाद ततस्तस्मिन्नाश्रमे पुण्यवर्द्धनः॥३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 261,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णस्य समाधिः कोलाहलश्च",
      "combined_translation": "3-3"
    },
    {
      "verse": 4,
      "sanskrit": "समाधौ योजयामास मनः पद्मनिभेक्षणः। किमप्येष जगन्नाथो ध्यात्वा देवेश्वरः स्थितः॥४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 261,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णस्य समाधिः कोलाहलश्च",
      "combined_translation": "4-4"
    },
    {
      "verse": 5,
      "sanskrit": "स्थिते देवगुरौ तत्र समाधौ दीपवद्धरौ। तत्र शब्दो महाघोरः प्रादुरासीत्समन्ततः॥५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 261,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णस्य समाधिः कोलाहलश्च",
      "combined_translation": "5-5"
    },
    {
      "verse": 6,
      "sanskrit": "खाद खादत मोदेत यात यात मृगानिमान्। प्रेषयेह पुनः सर्वान्प्रसादाच्छार्ङ्गधव्ननः॥६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 261,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णस्य समाधिः कोलाहलश्च",
      "combined_translation": "6-6"
    },
    {
      "verse": 7,
      "sanskrit": "एष विष्णुरयं कृष्णो हरिरीश इतोऽच्युतः। नमोऽस्तु विष्णो देवेश स्वामिन्माधव केशव॥७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 261,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णस्य समाधिः कोलाहलश्च",
      "combined_translation": "7-7"
    },
    {
      "verse": 8,
      "sanskrit": "इत्यादिशब्दः सुमहानाविरासित्तदा निशि। ततश्च सुमहानादः सिंहानां मृगविद्द्विषाम्॥८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 261,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णस्य समाधिः कोलाहलश्च",
      "combined_translation": "8-8"
    },
    {
      "verse": 9,
      "sanskrit": "धावतां च शुनां राजन्मृगाणां विनर्दताम्। मृगाणां भीतियुक्तानामृक्षाणां द्वीपिनां तथा॥९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 261,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णस्य समाधिः कोलाहलश्च",
      "combined_translation": "9-9"
    },
    {
      "verse": 10,
      "sanskrit": "गजानां नदतां राजन्बृंहितं च ततस्ततः। महावातसमुद्भूतक्षुभितस्येव वारिधेः॥१०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 261,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णस्य समाधिः कोलाहलश्च",
      "combined_translation": "10-10"
    },
    {
      "verse": 11,
      "sanskrit": "नादस्त्रैलोक्यवित्रासः प्रादुरासीत्तदा निशि। श्रुत्वा शब्दं हरिर्देवस्तादृशं तत्र धिष्ठितः॥११॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 261,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णस्य समाधिः कोलाहलश्च",
      "combined_translation": "11-11"
    },
    {
      "verse": 12,
      "sanskrit": "समाधिक्षोभमासाद्य विश्वस्य च जगत्पतिः। ततः स चिन्तयामास कोऽयमेष महास्वनः॥१२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 261,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णस्य समाधिः कोलाहलश्च",
      "combined_translation": "12-12"
    },
    {
      "verse": 13,
      "sanskrit": "कस्यायमीदृशः शब्दः स्तुतियुक्तो मम त्विति। अहोऽस्मिन्मृगया शब्दः शुनां सञ्चरतां वने॥१३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 261,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णस्य समाधिः कोलाहलश्च",
      "combined_translation": "13-13"
    },
    {
      "verse": 14,
      "sanskrit": "मृगाणामथ सर्वेषां नादश्च सुमहानयम्। व्यामिश्रस्तुतियुक्ताभिर्वाग्भिर्मम समन्ततः॥१४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 261,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णस्य समाधिः कोलाहलश्च",
      "combined_translation": "14-14"
    },
    {
      "verse": 15,
      "sanskrit": "इति सञ्चिन्त्य मनसा दिशो विप्रेक्ष्य सर्वतः। तत आस्ते हरिस्तत्र ज्ञातुं तत्र समुद्भवम्॥१५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 261,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णस्य समाधिः कोलाहलश्च",
      "combined_translation": "15-15"
    },
    {
      "verse": 16,
      "sanskrit": "ततो मृगाः समाधावन्यत्र तिष्टति केशवः। तांश्चैवानुचरो राजन्सगणः समपद्यत॥१६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 261,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णस्य समाधिः कोलाहलश्च",
      "combined_translation": "16-16"
    },
    {
      "verse": 17,
      "sanskrit": "अथ वै दीपिका राजञ्छतशोऽथ सहस्रशः। ततस्तस्मोऽपि व्यनशद्दिवेव समपद्यत॥१७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 261,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णस्य समाधिः कोलाहलश्च",
      "combined_translation": "17-17"
    },
    {
      "verse": 18,
      "sanskrit": "ततोनु भूतसङ्घाश्च समदृश्यन्त तत्र ह। पिशाचाश्च महाघोरा नर्दन्तो बहु विस्वनम्॥१८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 261,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णस्य समाधिः कोलाहलश्च",
      "combined_translation": "18-18"
    },
    {
      "verse": 19,
      "sanskrit": "भक्षयन्तोऽथ पिशितं पिबन्तो रुधिरं बहु। प्रादुरासन्महाघोराः पिशाचा विकृताननाः॥१९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 261,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णस्य समाधिः कोलाहलश्च",
      "combined_translation": "19-19"
    },
    {
      "verse": 20,
      "sanskrit": "हन्यमाना हता राजन्पतन्तः पतिता मृगाः। इतश्चेतश्च धावन्तो बाणैर्विद्धा मृगा द्विपः॥२०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 261,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णस्य समाधिः कोलाहलश्च",
      "combined_translation": "20-20"
    },
    {
      "verse": 21,
      "sanskrit": "ततो मृगसहस्राणि समिदीर्णानि भारत। यत्रासौ तिष्ठते देवस्तत्र याता निरन्तरम्॥२१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 261,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णस्य समाधिः कोलाहलश्च",
      "combined_translation": "21-21"
    },
    {
      "verse": 22,
      "sanskrit": "अन्तरीकृत्य देवेशं स्थितानीत्यनुशुश्रुम। पिशाच्यो विकृताकाराः कराला रोमहर्षणाः॥२२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 261,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णस्य समाधिः कोलाहलश्च",
      "combined_translation": "22-22"
    },
    {
      "verse": 23,
      "sanskrit": "पुत्रवत्यः समापेतुर्यत्र तिष्ठति केशवः। श्वगणस्तत्र राजेन्द्र चरत्येव ततस्ततः॥२३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 261,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णस्य समाधिः कोलाहलश्च",
      "combined_translation": "23-23"
    },
    {
      "verse": 24,
      "sanskrit": "ततः स भगवान्विष्णुः सर्वमालोक्य विष्ठितः। विस्मयं परमं गत्वा पश्यन्नास्ते स्म केशवः॥२४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 261,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णस्य समाधिः कोलाहलश्च",
      "combined_translation": "24-24"
    },
    {
      "verse": 25,
      "sanskrit": "कस्यैष विसृतो नादः कस्य वायं जनोऽपतत्। को नु मां स्तौति भक्त्या वै भविष्ये प्रीतिमानहम्॥२५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 261,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णस्य समाधिः कोलाहलश्च",
      "combined_translation": "25-25"
    },
    {
      "verse": 26,
      "sanskrit": "कस्य मुक्तिः समायाता प्रीते मयि सुदुर्लभा। इति सञ्चिन्त्य भगवानास्ते प्राकृतवद्धरिः॥२६॥",
