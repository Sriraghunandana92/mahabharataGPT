{
  "adhyaya_id": "P19_U02_A058",
  "book": 19,
  "parva_name": "हरिवंशः",
  "upaparva_name": "विष्णुपर्व",
  "adhyaya_name": "द्वारवतीनगरनिर्माणम्-०५८",
  "chapter": 113,
  "verse_count": 84,
  "verses": [
    {
      "verse": 1,
      "sanskrit": "वैशम्पायन उवाच।\n              ततः प्रभाते विमले भास्करे उदिते तदा। कृतजाप्यो हृषीकेशो वनान्ते निषसाद ह॥१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 113,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "द्वारवतीनगरनिर्माणम्-०५८"
    },
    {
      "verse": 2,
      "sanskrit": "परिचक्राम तं देशं दुर्गस्थानदिदृक्षया। उपतस्थुः कुलप्राग्र्या यादवा यदुनन्दनम्॥२॥",
      "english": null,
      "bhavadeepa": "अष्टपञ्चाशत्तमेऽथाध्याये त्वष्टारमाह्वयत्। द्वारकातिविशेषान्यो हरिस्तेन विनिर्ममे॥१॥ तत इति॥१॥",
      "chapter": 113,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "द्वारवतीनगरनिर्माणम्-०५८",
      "combined_translation": "2-2"
    },
    {
      "verse": 3,
      "sanskrit": "रोहिण्यामहनि श्रेष्ठे स्वस्ति वाच्य द्विजोत्तमान्। पुण्याहघोषैर्विपुलैर्दुर्गस्यारब्धवान्क्रियाम्॥३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 113,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "द्वारवतीनगरनिर्माणम्-०५८",
      "combined_translation": "3-3"
    },
    {
      "verse": 4,
      "sanskrit": "ततः पङ्कजपत्राक्षो यादवान्केशिसूदनः। प्रोवाच वदतां श्रेष्ठो देवान्वृत्ररिपुर्यथा॥४॥",
      "english": null,
      "bhavadeepa": "रोहिण्यां रोहिणीनक्षत्रे श्रेष्ठे अहनि मन्दवासरे “शनौ हि सुसमारम्भं कृतवानीश्वरः स्वयम्”। इति वचनात्॥३॥",
      "chapter": 113,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "द्वारवतीनगरनिर्माणम्-०५८",
      "combined_translation": "4-4"
    },
    {
      "verse": 5,
      "sanskrit": "कल्पितेयं मया भूमिः पश्यध्वं देवसद्मवत्। नाम चास्याः कृतं पुर्याः ख्यातिं यदुपयास्यति॥५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 113,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "द्वारवतीनगरनिर्माणम्-०५८",
      "combined_translation": "5-5"
    },
    {
      "verse": 6,
      "sanskrit": "इयं द्वारवती नाम पृथिव्यां निर्मिता मया। भविष्यति पुरी रम्या शक्रस्येवामरावती॥६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 113,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "द्वारवतीनगरनिर्माणम्-०५८",
      "combined_translation": "6-6"
    },
    {
      "verse": 7,
      "sanskrit": "तान्येवास्याः कारयिष्ये चिह्नान्यायतनानि च। चत्वारान्राजमार्गांश्च सम्यगन्तःपुराणि च॥७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 113,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "द्वारवतीनगरनिर्माणम्-०५८",
      "combined_translation": "7-7"
    },
    {
      "verse": 8,
      "sanskrit": "देवा इवात्र मोदन्तु भवन्तो विगतज्वराः। बाधमाना रिपूनुग्रानुग्रसेनपुरोगमाः॥८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 113,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "द्वारवतीनगरनिर्माणम्-०५८",
      "combined_translation": "8-8"
    },
    {
      "verse": 9,
      "sanskrit": "गृह्यन्तां वेश्मवास्तूनि कल्प्यन्तां त्रिकचत्वराः। मीयन्तां राजमार्गाश्च प्रासादस्य च या गतिः॥९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 113,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "द्वारवतीनगरनिर्माणम्-०५८",
      "combined_translation": "9-9"
    },
    {
      "verse": 10,
      "sanskrit": "प्रेष्यन्तां शिल्पिमुख्यानां युक्तानां वेश्मकर्मसु। नियुज्यन्तां च देशेषु प्रेष्यकर्मकरा जनाः॥१०॥",
      "english": null,
      "bhavadeepa": "त्रिकं तिसृभिः अट्टपङ्क्तिभिः कल्पितं त्रिकोणं त्रिकं चत्वरं चतसृभिश्चतुरस्त्रं तदेवं राजमार्गः द्वाभ्यां पण्यपङ्क्तिभ्यां कल्पितदीर्घरथ्यारूपः॥९॥",
      "chapter": 113,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "द्वारवतीनगरनिर्माणम्-०५८",
      "combined_translation": "10-10"
    },
    {
      "verse": 11,
      "sanskrit": "एवमुक्ते तु यदवो गृहसङ्ग्रहतत्पराः। यथानिवेशं संहृष्टाश्चक्रुर्वास्तुपरिग्रहम्॥११॥",
      "english": null,
      "bhavadeepa": "शिल्पिमुख्यानाम् आह्वायका इति शेषः॥१०॥",
      "chapter": 113,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "द्वारवतीनगरनिर्माणम्-०५८",
      "combined_translation": "11-11"
    },
    {
      "verse": 12,
      "sanskrit": "सूत्रहस्तास्ततो मानं चक्रुर्यादवसत्तमाः। पुण्येऽहनि महाराज द्विजातीनभिपूज्य च॥१२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 113,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "द्वारवतीनगरनिर्माणम्-०५८",
      "combined_translation": "12-12"
    },
    {
      "verse": 13,
      "sanskrit": "वास्तुदैवतकर्माणि विधिना कारयन्ति च। स्थपतीनथ गोविन्दस्तत्रोवाच महामतिः॥१३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 113,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "द्वारवतीनगरनिर्माणम्-०५८",
      "combined_translation": "13-13"
    },
    {
      "verse": 14,
      "sanskrit": "अस्मदर्थे सुविहितं क्रियतामत्र मन्दिरम्। विविक्तचत्वारपथं सुनिविष्टेष्टदैवतम्॥१४॥",
      "english": null,
      "bhavadeepa": "स्थपतान् वास्तुकर्मज्ञान् सूत्रधारान्॥१३॥",
      "chapter": 113,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "द्वारवतीनगरनिर्माणम्-०५८",
      "combined_translation": "14-14"
    },
    {
      "verse": 15,
      "sanskrit": "ते तथेति महाबाहुमुक्त्वा स्थपतयस्तदा। दुर्गकर्माणि संस्कारानुपकल्प्य यथाविधि॥१५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 113,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "द्वारवतीनगरनिर्माणम्-०५८",
      "combined_translation": "15-15"
    },
    {
      "verse": 16,
      "sanskrit": "यथान्यायं निर्मिमिरे दुर्गाण्यायतनानि च। स्थानानि निदधुश्चात्र ब्रह्मादीनां यथाक्रमम्॥१६॥",
      "english": null,
      "bhavadeepa": "संस्कारान् कण्टकाद्युद्वासनवटारोधादीन्॥१५॥",
      "chapter": 113,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "द्वारवतीनगरनिर्माणम्-०५८"
    },
    {
      "verse": 17,
      "sanskrit": "अपामग्नेः सुरेशस्य दृषदोलूखलस्य च। चातुर्दैवानि चत्वारि द्वाराणि निदधुश्च ते॥१७॥",
      "english": null,
      "bhavadeepa": "ब्रह्मादीनां, “द्वारे पितामहं विद्यात्” इत्यादिशास्त्रोक्तानां, गृहबलिदेवतानाम्॥१६॥",
      "chapter": 113,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "द्वारवतीनगरनिर्माणम्-०५८",
      "combined_translation": "17-17"
    },
    {
      "verse": 18,
      "sanskrit": "शुद्धाक्षमैन्द्रं भल्लाटं पुष्पदन्तं तथैव च। तेषु वेश्मसु युक्तेषु यादवेषु महात्मसु॥१८॥",
      "english": null,
      "bhavadeepa": "चतुर्देवानीति पाठे देवाः शुद्धाक्षादयस्तद्वन्ति तांश्च तत्तत्स्थानपूर्वकं पूजयेदित्यर्थः॥१७॥",
      "chapter": 113,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "द्वारवतीनगरनिर्माणम्-०५८",
      "combined_translation": "18-18"
    },
    {
      "verse": 19,
      "sanskrit": "पुर्याः क्षिप्रं निवेशार्थं चिन्तयामास माधवः। तस्य दैवोत्थिता बुद्धिर्विमला क्षिप्रकारिणी॥१९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 113,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "द्वारवतीनगरनिर्माणम्-०५८",
      "combined_translation": "19-19"
    },
    {
      "verse": 20,
      "sanskrit": "पुर्याः प्रियकरी सा वै यदूनामभिवर्द्धिनी। शिल्पिमुख्यस्तु देवानां प्रजापतिसुतः प्रभुः॥२०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 113,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "द्वारवतीनगरनिर्माणम्-०५८",
      "combined_translation": "20-20"
    },
    {
      "verse": 21,
      "sanskrit": "विश्वकर्मा स्वमत्या वै पुरीं संस्थापयिष्यति। मनसा समनुध्याय तस्यागमनकारणात्। त्रिदशाभिमुखः कृष्णो विविक्ते समपद्यत॥२१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 113,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "द्वारवतीनगरनिर्माणम्-०५८",
      "combined_translation": "21-21"
    },
    {
      "verse": 22,
      "sanskrit": "तस्मिन्नेव ततः काले शिल्पाचार्यो महामतिः। विश्वकर्मा सुरश्रेष्ठः कृष्णस्य प्रमुखे स्थितः॥२२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 113,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "द्वारवतीनगरनिर्माणम्-०५८",
      "combined_translation": "22-22"
    },
    {
      "verse": 23,
      "sanskrit": "विश्वकर्मोवाच।\n              शक्रेण प्रेषितः क्षिप्रं तव विष्णो धृतव्रत। किङ्करः समनुप्राप्तः शाधि मां किं करोमि ते॥२३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 113,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "द्वारवतीनगरनिर्माणम्-०५८",
      "combined_translation": "23-23"
    },
    {
      "verse": 24,
      "sanskrit": "यथासौ देवदेवो मे शङ्करश्च यथाव्ययः। तथा त्वं देव मान्यो मे विशेषो नास्ति वः प्रभो॥२४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 113,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "द्वारवतीनगरनिर्माणम्-०५८",
      "combined_translation": "24-24"
    },
    {
      "verse": 25,
      "sanskrit": "त्रैलोक्यज्ञापिकां वाचमुत्सृजस्व महाभुज। एषोऽस्मि परिदृष्टार्थः किं करोमि प्रशाधि माम्॥२५॥",
      "english": null,
      "bhavadeepa": "यथा मे ब्रह्मादयो मान्यास्तथा त्वं देवमान्यो ब्रह्मादीनां मान्योऽसि। वः युष्मत्तः पूजायां बहुत्वं विशेषो विशिष्टत्वं नास्ति॥२४॥",
      "chapter": 113,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "द्वारवतीनगरनिर्माणम्-०५८",
      "combined_translation": "25-25"
    },
    {
      "verse": 26,
      "sanskrit": "श्रुत्वा विनीतं वचनं केशवो विश्वकर्मणः। प्रत्युवाच यदुश्रेष्ठः कंसारिरतुलं वचः॥२६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 113,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "द्वारवतीनगरनिर्माणम्-०५८",
      "combined_translation": "26-26"
    },
    {
      "verse": 27,
      "sanskrit": "श्रुतार्थो देवगुह्यस्य भवान्यत्र वयं स्थिताः। अवश्यं त्विह कर्तव्यं सदनं मे सुरोत्तम॥२७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 113,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "द्वारवतीनगरनिर्माणम्-०५८",
      "combined_translation": "27-27"
    },
    {
      "verse": 28,
      "sanskrit": "तदियं पूः प्रकाशार्थं निवेश्या मयि सुव्रत। मत्प्रभावानुरूपैश्च गृहैश्चेयं समन्ततः॥२८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 113,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "द्वारवतीनगरनिर्माणम्-०५८",
      "combined_translation": "28-28"
    },
    {
      "verse": 29,
      "sanskrit": "उत्तमा च पृथिव्यां वै यथा स्वर्गेऽमरावती। तथेयं हि त्वया कार्या शक्तो ह्यसि महामते॥२९॥",
