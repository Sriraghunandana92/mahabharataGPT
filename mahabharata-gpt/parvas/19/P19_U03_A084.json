  "adhyaya_name": "श्रीकृष्णतपोवर्णनम्",
  "chapter": 267,
  "verse_count": 28,
  "verses": [
    {
      "verse": 1,
      "sanskrit": "वैशम्पायन उवाच।\n              ततः स भगवान्विष्णुर्मुनिभ्यस्तत्त्वमादितः। कथयामास यद्वृत्तं पिशाचस्य महात्मनः॥१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 267,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णतपोवर्णनम्",
      "combined_translation": "1-33"
    },
    {
      "verse": 2,
      "sanskrit": "तच्छ्रुत्वा मुनयः सर्वे विस्मयं परमं गताः। अहोऽस्य कर्मणः पाकस्तव सन्दर्शनादिति॥२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 267,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णतपोवर्णनम्",
      "combined_translation": "2-2"
    },
    {
      "verse": 3,
      "sanskrit": "अर्चितो मुनिभिः सर्वैः प्रीतः प्रीतिमतां प्रियः। ततः प्रभाते विमले सूर्ये चाभ्युदिते सति॥३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 267,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णतपोवर्णनम्",
      "combined_translation": "3-3"
    },
    {
      "verse": 4,
      "sanskrit": "आरुह्य गरुडं विष्णुर्ययौ कैलासमुत्तमम्। भवद्भिस्तत्र गन्तव्यमित्युक्त्वा मुनिसत्तमान्॥४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 267,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णतपोवर्णनम्",
      "combined_translation": "4-4"
    },
    {
      "verse": 5,
      "sanskrit": "यत्र विश्वेश्वराः सिद्धास्तपस्यन्ति यतव्रताः। यत्र वैश्रवणः साक्षादुपास्ते शङ्करं सदा॥५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 267,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णतपोवर्णनम्",
      "combined_translation": "5-5"
    },
    {
      "verse": 6,
      "sanskrit": "यत्र तन्मानसं नाम सरो हंसालयं महत्। यत्र भृङ्गी रिटिर्देवमुपास्ते शङ्करं शिवम्॥६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 267,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णतपोवर्णनम्",
      "combined_translation": "6-6"
    },
    {
      "verse": 7,
      "sanskrit": "गाणपत्यमवाप्याथ हरपार्श्वचरः सदा। यत्र सिंहा वराहाश्च द्विपद्वीपिमृगैः सह॥७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 267,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णतपोवर्णनम्",
      "combined_translation": "7-7"
    },
    {
      "verse": 8,
      "sanskrit": "क्रीडन्ति वन्यरतयः परस्परहिते रताः। यत्र नद्यः समुत्पन्ना गङ्गाद्याः सागरङ्गमाः॥८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 267,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णतपोवर्णनम्",
      "combined_translation": "8-8"
    },
    {
      "verse": 9,
      "sanskrit": "यत्र विश्वेश्वरः शम्भुरच्छिनद्ब्रह्मणः शिरः। यत्रोत्पन्ना महावेत्रा भूतानां दण्डतां ययुः॥९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 267,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णतपोवर्णनम्",
      "combined_translation": "9-9"
    },
    {
      "verse": 10,
      "sanskrit": "उमया यत्र सहितः शङ्करो नीललोहितः। ऋषिभिः प्रार्थितः पूर्वं ददौ यत्र गिरिः सुताम्॥१०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 267,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णतपोवर्णनम्",
      "combined_translation": "10-10"
    },
    {
      "verse": 11,
      "sanskrit": "शङ्कराय जगद्धात्रे शिवाय जगतीपते। यत्र लेभे हरिश्चक्रमुपास्य बहुभिर्दिनैः॥११॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 267,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णतपोवर्णनम्",
      "combined_translation": "11-11"
    },
    {
      "verse": 12,
      "sanskrit": "पुष्करैः शतपत्रैश्च नेत्रेण च जगत्पतिम्। गुहां यत्र समाश्रित्य क्रीडन्ते सिद्धकिन्नराः॥१२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 267,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णतपोवर्णनम्",
      "combined_translation": "12-12"
    },
    {
      "verse": 13,
      "sanskrit": "प्रियाभिः सह मोदन्ते पिबन्ते मधु चोत्तमम्। यमुद्धृत्य भुजैः सर्वैः पौलस्त्यो विरराम ह॥१३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 267,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णतपोवर्णनम्",
      "combined_translation": "13-13"
    },
    {
      "verse": 14,
      "sanskrit": "तमारुह्य महाशैलं देवकीनन्दनो हरिः। मानसस्योत्तरं तीरं जगाम यदुनन्दनः॥१४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 267,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णतपोवर्णनम्",
      "combined_translation": "14-14"
    },
    {
      "verse": 15,
      "sanskrit": "तपश्चर्तुं किल हरिर्विष्णुः सर्वेश्वरः शिवः। जटी चीरी जगन्नाथो मानुषं वपुरास्थितः॥१५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 267,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णतपोवर्णनम्",
      "combined_translation": "15-15"
    },
    {
      "verse": 16,
      "sanskrit": "तपसे धृतचित्तस्तु शुचौ भूमावुपाविशत्। अवरुह्य ततो यानाद्गरुडाद्वेदसंमितात्॥१६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 267,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णतपोवर्णनम्",
      "combined_translation": "16-16"
    },
    {
      "verse": 17,
      "sanskrit": "द्वादशाब्दं तपश्चर्तुं मनो दध्रे ततो हरिः। फाल्गुनेन तु मासेन समारेभे जगत्पतिः॥१७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 267,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णतपोवर्णनम्",
      "combined_translation": "17-17"
    },
    {
      "verse": 18,
      "sanskrit": "शाकभक्षो कृतजपो वेदाध्ययनतत्परः। किमुद्दिश्य जगन्नाथस्तपश्चरति मानवः॥१८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 267,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णतपोवर्णनम्",
      "combined_translation": "18-18"
    },
    {
      "verse": 19,
      "sanskrit": "तं न विद्मो यथाकामं दुर्ज्ञेयेश्वरचिन्तना। तपस्यति तदा विष्णौ पर्वते भूतसेविते॥१९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 267,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णतपोवर्णनम्",
      "combined_translation": "19-19"
    },
    {
      "verse": 20,
      "sanskrit": "गरुडः कश्यपसुत इन्धनानि समाचिनोत्। होमार्थं वासुदेवस्य चरतस्तप उत्तमम्॥२०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 267,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णतपोवर्णनम्",
      "combined_translation": "20-20"
    },
    {
      "verse": 21,
      "sanskrit": "चक्रराजोऽथ पुष्पाणि सञ्चिनोति तदा हरेः। दिक्षु सर्वासु सर्वत्र ररक्ष जलदस्तदा॥२१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 267,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णतपोवर्णनम्",
      "combined_translation": "21-21"
    },
    {
      "verse": 22,
      "sanskrit": "खड्ग आहृत्य यत्नेन कुशान्सुबहुशस्तदा। गदा कौमोदकी चैव परिचर्यां चकार ह॥२२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 267,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णतपोवर्णनम्",
      "combined_translation": "22-22"
    },
    {
      "verse": 23,
      "sanskrit": "धनुःप्रवरमत्युग्रं शार्ङ्गं दानवभीषणम्। स्थितं हि पुरतस्तस्य यथेष्टं भृत्यवत्स्वयम्॥२३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 267,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णतपोवर्णनम्",
      "combined_translation": "23-23"
    },
    {
      "verse": 24,
      "sanskrit": "जुहोति भगवान्विष्णुरेधोभिर्बहुभिः सदा। आज्यादिभिस्तदा हव्यैरग्निं सम्पूज्य माधवः॥२४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 267,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णतपोवर्णनम्",
      "combined_translation": "24-24"
    },
    {
      "verse": 25,
      "sanskrit": "सप्तार्चिषः समाप्तिं च समस्तव्यस्ततः कृती। एकस्मिन्नेकदा मासे भुञ्जानो नियतात्मवान्॥२५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 267,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णतपोवर्णनम्",
      "combined_translation": "25-25"
    },
    {
      "verse": 26,
      "sanskrit": "द्वितीये त्वथ पर्याये भुञ्जन्नेकेन केशवः। एकस्मिन्वत्सरे भुञ्जंस्तथैवैकेन केनचित्॥२६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 267,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णतपोवर्णनम्",
      "combined_translation": "26-26"
    },
    {
      "verse": 27,
      "sanskrit": "समाप्य तत्तपः सर्वमेवमेव जगत्पतिः। द्वादशाब्दे तथा पूर्णे ऊनमासे जगत्पतिः॥२७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 267,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णतपोवर्णनम्",
      "combined_translation": "27-27"
    },
    {
      "verse": 28,
      "sanskrit": "जुह्वन्नग्निं समास्थाय पठन्मन्त्रं जनार्दनः। आरण्यकं पठन्विष्णुः साक्षात्सर्वेश्वरो हरिः। आस्ते ध्यानपरस्तत्र पठन्प्रणवमुत्तमम्॥२८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 267,
