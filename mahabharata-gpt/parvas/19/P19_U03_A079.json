{
  "adhyaya_id": "P19_U03_A079",
  "book": 19,
  "parva_name": "हरिवंशः",
  "upaparva_name": "भविष्यपर्व",
  "adhyaya_name": "पिशाचागमनम्",
  "chapter": 262,
  "verse_count": 29,
  "verses": [
    {
      "verse": 1,
      "sanskrit": "वैशम्पायन उवाच।\n              तेषामनु महाघोरौ पिशाचौ विकृताननौ। प्रांशू पिङ्गलरोमाणौ दीर्घजिह्वौ महाहनू॥१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 262,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पिशाचागमनम्",
      "combined_translation": "1-27"
    },
    {
      "verse": 2,
      "sanskrit": "लम्बकेशौ विरूपाक्षौ ही ही हा हेति वादिनौ। खादन्तौ मांसपिटकं पिबन्तौ रुधिरं बहु॥२॥",
      "english": null,
      "bhavadeepa": "तेषामन्विति॥१॥",
      "chapter": 262,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पिशाचागमनम्",
      "combined_translation": "2-2"
    },
    {
      "verse": 3,
      "sanskrit": "अन्त्रवेष्टितसर्वाङ्गौ दीर्घौ कृशकृतोदरौ। लम्बमानमहाप्रान्तशूलप्रोतशिरोधरौ॥३॥",
      "english": null,
      "bhavadeepa": "मांसस्य पिटकं मञ्जूषामिव परस्य शरीरमित्यर्थः॥२॥",
      "chapter": 262,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पिशाचागमनम्",
      "combined_translation": "3-3"
    },
    {
      "verse": 4,
      "sanskrit": "कर्षन्तौ शवयूथानि बाहुभ्यां तत्र तत्र ह। हसन्तौ विविधं हासं स्वजातिसदृशं नृप॥४॥",
      "english": null,
      "bhavadeepa": "लम्बमानं च महाप्रान्तं च तत् शूलं च तत्र प्रोतानि शिरोधराणि याभ्यां तौ। नृमुण्डमालासंयुक्तशूलधारिणावित्यर्थः॥३॥",
      "chapter": 262,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पिशाचागमनम्",
      "combined_translation": "4-4"
    },
    {
      "verse": 5,
      "sanskrit": "वदन्तौ बहुरूपाणि वचांसि प्राकृतानि च। कम्पयन्तौ महावृक्षानूरुपादप्रघट्टनैः॥५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 262,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पिशाचागमनम्",
      "combined_translation": "5-5"
    },
    {
      "verse": 6,
      "sanskrit": "सृक्किणी लेलिहन्तौ च दन्तान्कटकटायिनौ। अस्थिस्नायुसमाकीर्णौ धमनीरज्जुसन्ततौ॥६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 262,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पिशाचागमनम्",
      "combined_translation": "6-6"
    },
    {
      "verse": 7,
      "sanskrit": "वदन्तौ कृष्ण कृष्णेति माधवेति च सन्ततम्। कदा नु द्रक्ष्यते विष्णुः स इदानीं क्व तिष्ठति॥७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 262,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पिशाचागमनम्",
      "combined_translation": "7-7"
    },
    {
      "verse": 8,
      "sanskrit": "स्वामिनः कुत्र वसतिः कुतो द्रष्टुं यतामहे। अत्र वा कुत्र देवेशः कुतो नु स्थास्यते हरिः॥८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 262,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पिशाचागमनम्",
      "combined_translation": "8-8"
    },
    {
      "verse": 9,
      "sanskrit": "कुतः पद्मपलाशाक्षः साक्षादिन्द्रानुजो हरिः। यमाहुः पुण्डरीकाक्षं ब्रह्म ब्रह्मविदो जनाः॥९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 262,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पिशाचागमनम्",
      "combined_translation": "9-9"
    },
    {
      "verse": 10,
      "sanskrit": "तमजं पुरुषं विष्णुं द्रष्टुमभ्युध्यता वयम्। अन्तकाले जगन्नाथं प्रविवेश जगत्त्रयम्॥१०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 262,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पिशाचागमनम्",
      "combined_translation": "10-10"
    },
    {
      "verse": 11,
      "sanskrit": "तमजं विश्वकर्तारं कुतो द्रक्ष्याम साम्प्रतम्। यस्य विस्तार एवैष लोकः प्राणिनिवासिनः॥११॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 262,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पिशाचागमनम्",
      "combined_translation": "11-11"
    },
    {
      "verse": 12,
      "sanskrit": "तं द्रष्टुं देवमीशानं यतामः साम्प्रतं हरिम्। दशा घोरतमा लोके विद्विष्टा सर्वजन्तुभिः॥१२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 262,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पिशाचागमनम्",
      "combined_translation": "12-12"
    },
    {
      "verse": 13,
      "sanskrit": "पैशाचीयं समुत्पन्ना कथं नौ प्राविशद्बलात्। नरमांसास्थिकलुषा सर्वभीतिप्रदायिनी॥१३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 262,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पिशाचागमनम्",
      "combined_translation": "13-13"
    },
    {
      "verse": 14,
      "sanskrit": "अहो नौ दुष्कृतं कर्म प्राक्तने कर्मसञ्चये। अत्रैव महती प्रीतिर्वर्तते सर्वदा तथा॥१४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 262,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पिशाचागमनम्",
      "combined_translation": "14-14"
    },
    {
      "verse": 15,
      "sanskrit": "यावन्नौ दुष्कृतं कर्म तावत्स्थास्यति तादृशी। दशा सा सर्वविद्विष्टा प्राणिपीडनकारिणी॥१५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 262,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पिशाचागमनम्",
      "combined_translation": "15-15"
    },
    {
      "verse": 16,
      "sanskrit": "सर्वथा दुष्कृतं कर्म बहुभिर्जन्मसञ्चयैः। तथा हि तत्फलं घोरमद्यापि न निवर्तते॥१६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 262,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पिशाचागमनम्",
      "combined_translation": "16-16"
    },
    {
      "verse": 17,
      "sanskrit": "यताः स्म प्राणिनो हन्तुं श्वगणैः सह साम्प्रतम्। तथाहि प्राणिनो लोके बाल्यमादौ समास्थिताः॥१७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 262,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पिशाचागमनम्",
      "combined_translation": "17-17"
    },
    {
      "verse": 18,
      "sanskrit": "अज्ञानावृतचित्ताश्च कृत्याकृत्यं न जानते। तथा यौवनिनो भ्रान्ता विषयैर्बहुलीकृताः॥१८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 262,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पिशाचागमनम्",
      "combined_translation": "18-18"
    },
    {
      "verse": 19,
      "sanskrit": "यतन्ते श्रेयसे नैव ततो विषयसंस्थिताः। विषयाविष्टचित्ता हि मनुष्या न विजानते॥१९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 262,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पिशाचागमनम्",
      "combined_translation": "19-19"
    },
    {
      "verse": 20,
      "sanskrit": "तथा च वृद्धभावे तु व्याधिभिर्बहुभिर्वृताः। ज्वरादिभिर्महाघोरैर्नानादुःखविधायिभिः॥२०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 262,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पिशाचागमनम्",
      "combined_translation": "20-20"
    },
    {
      "verse": 21,
      "sanskrit": "यतन्ते न हि वै श्रेयो विनष्टेन्द्रियगोचराः। ततो मृता गर्भवासे वसन्ति सततं नराः॥२१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 262,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पिशाचागमनम्",
      "combined_translation": "21-21"
    },
    {
      "verse": 22,
      "sanskrit": "विण्मूत्रकलिले घोरे दुःखैर्बहुभिराचिताः। च्यवन्ते तु ततो घोराद्गर्भात्संसारमण्डले॥२२॥",
      "english": null,
      "bhavadeepa": "श्रेयः श्रेयसे। विनष्टेन्द्रियगोचराः इतस्ततो भ्रममाणानामिन्द्रियणां वशगा इत्यर्थः॥२१॥",
      "chapter": 262,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पिशाचागमनम्",
      "combined_translation": "22-22"
    },
    {
      "verse": 23,
      "sanskrit": "परस्परं विहिंसन्तः कुर्वन्तः कर्मसञ्चयम्। महत्येवं सदा घोरे संसारे दुःखसङ्कुले॥२३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 262,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पिशाचागमनम्",
      "combined_translation": "23-23"
    },
    {
      "verse": 24,
      "sanskrit": "पापानि बहुरूपाणि कुर्वतेऽज्ञानतस्तदा। संसारस्यैष महिमा विस्तृतः सर्वजन्तुषु॥२४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 262,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पिशाचागमनम्",
      "combined_translation": "24-24"
    },
    {
      "verse": 25,
      "sanskrit": "अच्छेद्यः शस्त्रसम्पातैरुपायैर्बहुभिः सदा। एतस्मान्न निवर्तन्ते मर्त्याः प्राकृतबुद्धयः॥२५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 262,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पिशाचागमनम्",
      "combined_translation": "25-25"
    },
    {
      "verse": 26,
      "sanskrit": "इमं हत्वा मनुष्येन्द्रमिदमस्माद्धराम्यहम्। चोरयित्वा धनमिदं हरिष्याम्याददाम्यहम्॥२६॥",
      "english": null,
      "bhavadeepa": "प्राकृतबुद्धयः देहात्मवादिनः॥२५॥",
      "chapter": 262,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पिशाचागमनम्",
      "combined_translation": "26-26"
    },
    {
      "verse": 27,
      "sanskrit": "निर्भर्त्स्यैनमिमं शान्तं हरिष्यामि धनं बली। इत्यादिव्याकुला मूर्खा यतन्ते प्राणिपीडनम्॥२७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 262,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पिशाचागमनम्",
      "combined_translation": "27-27"
    },
    {
      "verse": 28,
      "sanskrit": "अस्यैव दुःखमूलस्य संसारस्य सदा हरिः। भेषजं सर्वथा देवः शङ्खचक्रगदाधरः॥२८॥",
      "english": null,
      "bhavadeepa": "पीडनं कर्तुम्॥२७॥",
      "chapter": 262,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पिशाचागमनम्",
      "combined_translation": "28-28"
    },
    {
      "verse": 29,
      "sanskrit": "आदिदेवः पुराणात्मा आत्मा ब्रह्मविदां सदा। ते वयं सर्वयत्नेन द्रक्ष्यामः सर्वथा हरिम्। इत्थं पिशाचौ भाशन्तौ प्रादुरास्तां हरेः पुरः॥२९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 262,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पिशाचागमनम्",
      "combined_translation": "29-29"
    }
  ]
}