  "verse_count": 16,
  "verses": [
    {
      "verse": 1,
      "sanskrit": "वैशम्पायन उवाच।\n              बृहस्पतेस्तु वचनं श्रुत्वा सत्यं समीरितम्। भूयः प्रजज्वाल रणे हविषेव महामखे॥१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 246,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "बलिं प्रति प्रह्रादवाक्यम्"
    },
    {
      "verse": 2,
      "sanskrit": "हतास्तु माया दैत्यानां प्रदीप्तेनाग्निना रणे। हतमाया हतबला बलिं ते समुपस्थिताः॥२॥",
      "english": null,
      "bhavadeepa": "बृहस्पतेस्त्विति॥१॥",
      "chapter": 246,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "बलिं प्रति प्रह्रादवाक्यम्",
      "combined_translation": "2-2"
    },
    {
      "verse": 3,
      "sanskrit": "पराजितेषु दैत्येषु वह्निनाद्भुतकर्मणा। प्रह्रादस्तूत्तरं वाक्यमाह दैत्यपतिं बलिम्॥३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 246,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "बलिं प्रति प्रह्रादवाक्यम्",
      "combined_translation": "3-3"
    },
    {
      "verse": 4,
      "sanskrit": "भवानग्निश्च वायुश्च भास्करः सलिलं शची। नक्षत्राणि दिशो व्योम भूश्च दानवसत्तम॥४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 246,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "बलिं प्रति प्रह्रादवाक्यम्",
      "combined_translation": "4-4"
    },
    {
      "verse": 5,
      "sanskrit": "भविश्यं चैव भूतं च भवच्चासुरसत्तम। दत्तं चैतद्भगवता वरदेन स्वयम्भुवा॥५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 246,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "बलिं प्रति प्रह्रादवाक्यम्",
      "combined_translation": "5-5"
    },
    {
      "verse": 6,
      "sanskrit": "इन्द्रत्वं चामरत्वं च युद्धे चाप्यपराजयः। ईशित्वं च वशित्वं च बलं चैवामितं शुभम्॥६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 246,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "बलिं प्रति प्रह्रादवाक्यम्",
      "combined_translation": "6-6"
    },
    {
      "verse": 7,
      "sanskrit": "सर्वभूतेश्वरत्वं च दैत्यराज सदा तव। महायोगीश्वरत्वं च शूरत्वं च महामृधे॥७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 246,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "बलिं प्रति प्रह्रादवाक्यम्",
      "combined_translation": "7-7"
    },
    {
      "verse": 8,
      "sanskrit": "अणिमा लघिमा चैव ये चान्ये सात्त्विका गुणाः। तत्पराजित्य दैत्येन्द्र देवान्सर्वांश्च सानुगान्॥८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 246,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "बलिं प्रति प्रह्रादवाक्यम्",
      "combined_translation": "8-8"
    },
    {
      "verse": 9,
      "sanskrit": "यथोक्तं ब्रह्मणा राजंस्तत्तथा न तदन्यथा। तस्य तद्वचनं श्रुत्वा प्रह्रादस्य महात्मनः। बलिः परमसंहृष्टः प्रायाच्छक्ररथं प्रति॥९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 246,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "बलिं प्रति प्रह्रादवाक्यम्",
      "combined_translation": "9-9"
    },
    {
      "verse": 10,
      "sanskrit": "ततः प्रयान्तं त्रिदशेन्द्रसन्निधौ महासुरेन्द्रं बलिमुत्तमश्रियम्। तमञ्जसा जग्मुरभिप्रदक्षिणं द्विजाश्च पुण्याः पशवश्च सत्तमाः॥१०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 246,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "बलिं प्रति प्रह्रादवाक्यम्",
      "combined_translation": "10-10"
    },
    {
      "verse": 11,
      "sanskrit": "महाजटाभारधरास्तपस्विनस्तदा तमाहुर्विधिमन्त्रमङ्गलैः। अभिष्टुवन्तः कवयः स्वलङ्कृतं बलिं प्रयान्तं रणमूर्धनि स्थिताः॥११॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 246,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "बलिं प्रति प्रह्रादवाक्यम्",
      "combined_translation": "11-11"
    },
    {
      "verse": 12,
      "sanskrit": "प्रतप्तजाम्बूनदचित्रभूषणैर्दिव्यैश्च रत्नैर्विविधैरलङ्कृतः। विराजमानः परमेण वर्चसा रणे विभात्यग्निशिखेव दानवः॥१२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 246,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "बलिं प्रति प्रह्रादवाक्यम्",
      "combined_translation": "12-12"
    },
    {
      "verse": 13,
      "sanskrit": "स वै तदा शत्रुबलार्दितं बलं बलिर्ददर्शोत्तमसत्त्ववीर्यवान्। जलागमे श्रीमदिवाभ्रमण्डलं विशीर्यमाणं नभसीव वायुना॥१३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 246,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "बलिं प्रति प्रह्रादवाक्यम्",
      "combined_translation": "13-13"
    },
    {
      "verse": 14,
      "sanskrit": "ततो ददर्शाथ बलानि सर्वतो रणे प्रगुप्तानि हुताशनेन वै। समुच्छ्रितान्युग्रतराणि तत्र वै समुद्रवेगानिव पर्वसन्धिषु॥१४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 246,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "बलिं प्रति प्रह्रादवाक्यम्",
      "combined_translation": "14-14"
    },
    {
      "verse": 15,
      "sanskrit": "सशूलशक्त्यृष्टिगदासिसायकान्क्षिपन्रिपूणां समरे महात्मनाम्। ननाद सिंहर्षभमत्तनागवज्जलागमे तोयदवच्च वीर्यवान्॥१५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 246,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "बलिं प्रति प्रह्रादवाक्यम्",
      "combined_translation": "15-15"
    },
    {
      "verse": 16,
      "sanskrit": "दिव्यास्त्रधूमः सुभुजोग्रवायुर्महाबलः पौरुषविक्रमेन्धनः। प्रजा दिधक्षन्निव कालवह्निः सुघोररूपो विबभौ रणे बलिः॥१६॥",
      "english": null,
      "bhavadeepa": null,
