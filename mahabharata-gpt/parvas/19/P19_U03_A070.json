{
  "adhyaya_id": "P19_U03_A070",
  "book": 19,
  "parva_name": "हरिवंशः",
  "upaparva_name": "भविष्यपर्व",
  "adhyaya_name": "वामनप्रादुर्भावः",
  "chapter": 253,
  "verse_count": 73,
  "verses": [
    {
      "verse": 1,
      "sanskrit": "वैशम्पायन उवाच।\n              प्रजानां पतयः सप्त सप्त चैव महर्षयः। तस्य देवस्य जातस्य नमस्कारं प्रचक्रिरे॥१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 253,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "वामनप्रादुर्भावः",
      "combined_translation": "1-22"
    },
    {
      "verse": 2,
      "sanskrit": "भारद्वाजः कश्यपो गौतमश्च विश्वामित्रो जमदग्निर्वसिष्ठः। यश्चोदितो भास्करे सम्प्रनष्टे सोऽप्यत्रात्रिर्भगवानाजगाम॥२॥",
      "english": null,
      "bhavadeepa": "प्रजानामिति। प्रजानां पतयः सप्त मरीच्यादयः॥१॥",
      "chapter": 253,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "वामनप्रादुर्भावः",
      "combined_translation": "2-2"
    },
    {
      "verse": 3,
      "sanskrit": "मरीचिरङ्गिराश्चैव पुलस्त्यः पुलहः क्रतुः। दक्षप्रजापतिश्चैव नमस्कारं प्रचक्रिरे॥३॥",
      "english": null,
      "bhavadeepa": "भास्करत्वकर्ता त्रिरप्याजगामेत्याह- यश्चेति॥२॥",
      "chapter": 253,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "वामनप्रादुर्भावः",
      "combined_translation": "3-3"
    },
    {
      "verse": 4,
      "sanskrit": "और्वो वसिष्ठपुत्रश्च स्तम्बः काश्यप एव च। कपीवानकपीवांश्च दत्तो निश्च्यवनस्तथा॥४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 253,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "वामनप्रादुर्भावः",
      "combined_translation": "4-12"
    },
    {
      "verse": 5,
      "sanskrit": "वसिष्ठपुत्राः सप्तासन्वासिष्ठा इति विश्रुताः। हिरण्यगर्भस्य सुताः पूर्वजाताः सुतेजसः॥५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 253,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "वामनप्रादुर्भावः",
      "combined_translation": "5-5"
    },
    {
      "verse": 6,
      "sanskrit": "गार्ग्यः पृथुस्तथैवान्यो जन्यो वामन एव च। देवबाहुर्यदुध्रश्च पर्जन्यश्चैव सोमजः॥६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 253,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "वामनप्रादुर्भावः",
      "combined_translation": "6-6"
    },
    {
      "verse": 7,
      "sanskrit": "हिरण्यरोमा वेदशिराः सप्तनेत्रस्तथैव च। विश्वोऽतिविश्वश्च्यवनः सुधामा विरजास्तथा॥७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 253,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "वामनप्रादुर्भावः",
      "combined_translation": "7-7"
    },
    {
      "verse": 8,
      "sanskrit": "अतिनामा सहिष्णुश्च नमस्कारमकुर्वत। उद्द्योतमाना वपुषा सर्वाभरणभूषिताः॥८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 253,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "वामनप्रादुर्भावः"
    },
    {
      "verse": 9,
      "sanskrit": "उपनृत्यन्ति देवेषं विष्णुमप्सरसां वराः। ततो गन्धर्वतूर्येषु प्रणदत्सु विहायसि॥९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 253,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "वामनप्रादुर्भावः",
      "combined_translation": "9-9"
    },
    {
      "verse": 10,
      "sanskrit": "बहुभिः सह गन्धर्वैः प्रागायत च तुम्बुरुः। महाश्रुतिश्चित्रशिरा ऊर्णायुरनघस्तथा॥१०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 253,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "वामनप्रादुर्भावः",
      "combined_translation": "10-10"
    },
    {
      "verse": 11,
      "sanskrit": "गोमायुः सूर्यवर्चाश्च सोमवर्चाश्च सप्तमः। युगपस्तृणपः कार्ष्णिर्नन्दिश्च त्रिशिरास्तथा॥११॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 253,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "वामनप्रादुर्भावः",
      "combined_translation": "11-11"
    },
    {
      "verse": 12,
      "sanskrit": "त्रयोदशः शालिशिराः पर्जन्यश्च चतुर्दशः। कलिः पञ्चदशश्चात्र तत्रैव तु महीपते॥१२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 253,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "वामनप्रादुर्भावः",
      "combined_translation": "12-12"
    },
    {
      "verse": 13,
      "sanskrit": "दश पञ्च त्विमे प्रोक्ता नारदश्चैव षोडशः। हाहा हूहूश्च गन्धर्वौ हंसश्चैव महाद्युतिः॥१३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 253,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "वामनप्रादुर्भावः",
      "combined_translation": "13-13"
    },
    {
      "verse": 14,
      "sanskrit": "सर्वे ते देवगन्धर्वा उपगायन्ति केशवम्। तथैवाप्सरसो हृष्टाः सर्वालङ्कारभूषिताः॥१४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 253,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "वामनप्रादुर्भावः",
      "combined_translation": "14-14"
    },
    {
      "verse": 15,
      "sanskrit": "वपुष्मन्तः सुजघनाः सर्वाङ्गशुभदर्शनाः। ननृतुश्च महाभागा जगुश्चायतलोचनाः॥१५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 253,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "वामनप्रादुर्भावः",
      "combined_translation": "15-15"
    },
    {
      "verse": 16,
      "sanskrit": "सुमध्याश्चारुमध्याश्च प्रियमुख्यो वराननाः। अनूकाथ तथा जामी मिश्रकेशी त्वलम्बुषा॥१६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 253,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "वामनप्रादुर्भावः",
      "combined_translation": "16-16"
    },
    {
      "verse": 17,
      "sanskrit": "मरीचिः शूचिकाश्चैव विद्युत्पूर्णा तिलोत्तमा। अद्रिका लक्षणा चैव रम्भा तद्वन्मनोरमा॥१७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 253,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "वामनप्रादुर्भावः",
      "combined_translation": "17-17"
    },
    {
      "verse": 18,
      "sanskrit": "असिता च सुबाहुश्च सुप्रिया सुभगा तथा। उर्वशी चित्रलेखा च सुग्रीवा च सुलोचना॥१८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 253,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "वामनप्रादुर्भावः",
      "combined_translation": "18-18"
    },
    {
      "verse": 19,
      "sanskrit": "पुण्डरीका सुगन्धा च सुरथा च प्रमाथिनी। नन्दा शारद्वती चैव तथान्यास्तत्र सङ्घशः॥१९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 253,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "वामनप्रादुर्भावः",
      "combined_translation": "19-19"
    },
    {
      "verse": 20,
      "sanskrit": "मेनका सहजन्या च पर्णिका पुञ्जिकस्थला। एताश्चाप्सरसोऽन्याश्च प्रनृत्यन्ति सहस्रशः॥२०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 253,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "वामनप्रादुर्भावः",
      "combined_translation": "20-20"
    },
    {
      "verse": 21,
      "sanskrit": "धातार्यमा च मिश्रश्च वरुणोऽंशो भगस्तथा। इन्द्रो विवस्वान्पूषा च त्वष्टा च सविता तथा॥२१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 253,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "वामनप्रादुर्भावः",
      "combined_translation": "21-21"
    },
    {
      "verse": 22,
      "sanskrit": "कथितो विष्णुरित्येवं काश्यपेयो गणस्तथा। इत्येते द्वादशादित्या ज्वलन्तः सूर्यवर्चसः॥२२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 253,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "वामनप्रादुर्भावः",
      "combined_translation": "22-22"
    },
    {
      "verse": 23,
      "sanskrit": "चक्रुस्तस्य सुरेशस्य नमस्कारं महात्मनः। मृगव्याधश्च सर्पश्च निर्ऋतिश्च महाबलः॥२३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 253,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "वामनप्रादुर्भावः",
      "combined_translation": "23-23"
    },
    {
      "verse": 24,
      "sanskrit": "अजैकपादहिर्बुध्न्यः पिनाकी चापराजितः। दहनोऽथेश्वरश्चैव कपाली च विशम्पते॥२४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 253,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "वामनप्रादुर्भावः",
      "combined_translation": "24-24"
    },
    {
      "verse": 25,
      "sanskrit": "स्थाणुर्भगश्च भगवान्रुद्रास्तत्रावतस्थिरे। अश्विनौ वसवश्चाष्टौ मरुतश्च महाबलाः॥२५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 253,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "वामनप्रादुर्भावः",
      "combined_translation": "25-25"
    },
    {
      "verse": 26,
      "sanskrit": "विश्वेदेवाश्च साध्याश्च तस्य प्राञ्जलयः स्थिताः। शेषानुजा महाभागा वासुकिप्रमुखास्तथा॥२६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 253,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "वामनप्रादुर्भावः",
      "combined_translation": "26-26"
    },
    {
      "verse": 27,
      "sanskrit": "कच्छपश्चापहर्ता च तक्षकश्च महाबलः। अधृष्टास्तेजसा युक्ता महाक्रोधा महाबलाः॥२७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 253,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "वामनप्रादुर्भावः",
      "combined_translation": "27-27"
    },
    {
      "verse": 28,
      "sanskrit": "एते नागा महात्मानस्तस्मै प्राञ्जलयः स्थिताः। तार्क्ष्यश्चारिष्टनेमिश्च गरुडश्च महाबलः॥२८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 253,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "वामनप्रादुर्भावः",
      "combined_translation": "28-28"
    },
    {
      "verse": 29,
      "sanskrit": "अरुणश्चारुणिश्चैव वैनतेया ह्युपस्थिताः। पितामहश्च भगवान्स्वयमागम्य लोककृत्। प्राह चैवं गुरुः श्रीमान्सह सर्वैर्महात्मभिः॥२९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 253,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "वामनप्रादुर्भावः",
      "combined_translation": "29-29"
    },
    {
      "verse": 30,
      "sanskrit": "ब्रह्मोवाच।\n              यस्मात्प्रसूयते लोकः प्रभविष्णुः सनातनः। तस्माल्लोकेश्वरः श्रीमान्विष्णुरेव भवत्वयम्॥३०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 253,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "वामनप्रादुर्भावः",
      "combined_translation": "30-30"
    },
    {
      "verse": 31,
      "sanskrit": "एवमुक्त्वा तु भगवान्सार्धं देवर्षिभिः प्रभुः। नमस्कृत्वा सुरेशाय जगाम त्रिदिवं पुनः॥३१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 253,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "वामनप्रादुर्भावः",
      "combined_translation": "31-31"
    },
    {
      "verse": 32,
      "sanskrit": "स तु जातः सुरेशानः कश्यपस्यात्मजः प्रभुः। नवदुर्दिनमेघाभो रक्ताक्षो वामनाकृतिः॥३२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 253,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "वामनप्रादुर्भावः",
      "combined_translation": "32-32"
    },
    {
      "verse": 33,
      "sanskrit": "श्रीवत्सेनोरसि श्रीमान्रोमजातेन राजता। उत्फुल्ललोचनाः सर्वाः पश्यन्त्यप्सरसस्तदा॥३३॥",
      "english": null,
