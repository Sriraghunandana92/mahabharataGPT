{
  "adhyaya_id": "P19_U02_A082",
  "book": 19,
  "parva_name": "हरिवंशः",
  "upaparva_name": "विष्णुपर्व",
  "adhyaya_name": "षट्पुरवधः--०८२",
  "chapter": 137,
  "verse_count": 35,
  "verses": [
    {
      "verse": 1,
      "sanskrit": "जनमेजय उवाच।\n              वैशम्पायन धर्मज्ञ व्यासशिष्य तपोधन। पारिजातस्य हरणे षट्पुरं परिकीर्तितम्॥१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 137,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "षट्पुरवधः--०८२"
    },
    {
      "verse": 2,
      "sanskrit": "निवासोऽसुरमुख्यानां दारुणानां तपोधन। तेषां वधं मुनिश्रेष्ठ कीर्तयस्वान्धकस्य च॥२॥",
      "english": null,
      "bhavadeepa": "द्व्यधिकेऽत्राशीतितमे ह्यध्याये वर्ण्यते ततः। षट्पुरस्थनिकुम्भस्य वधोपक्रमविस्तरः॥१॥ अथ उत्तरार्धकथा निरूप्यते- वैशम्पायनेति॥१॥",
      "chapter": 137,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "षट्पुरवधः--०८२",
      "combined_translation": "2-2"
    },
    {
      "verse": 3,
      "sanskrit": "वैशम्प्यन उवाच।\n              त्रिपुरे निहते वीरे रुद्रेणाक्लिष्टकर्मणा। तत्र प्रधाना बहवो बभूवुरसुरोत्तमाः॥३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 137,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "षट्पुरवधः--०८२",
      "combined_translation": "3-3"
    },
    {
      "verse": 4,
      "sanskrit": "शराग्निना न दग्धास्ते रुद्रेण त्रिपुरालयाः। षष्ठिः शतसहस्राणि न न्यूनान्यधिकानि च॥४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 137,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "षट्पुरवधः--०८२",
      "combined_translation": "4-4"
    },
    {
      "verse": 5,
      "sanskrit": "ते ज्ञातिवधसन्तप्ताश्चक्रुर्वीराः पुरा तपः। जम्बूमार्गे सतामिष्टे महर्षिगणसेविते॥५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 137,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "षट्पुरवधः--०८२",
      "combined_translation": "5-5"
    },
    {
      "verse": 6,
      "sanskrit": "आदित्याभिमुखा वीराः सहस्राणां शतं समाः। वायुभक्षा नृपश्रेष्ठ स्तुवन्तः पद्मसम्भवम्॥६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 137,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "षट्पुरवधः--०८२",
      "combined_translation": "6-6"
    },
    {
      "verse": 7,
      "sanskrit": "तेषामुदुम्बरं राजन्गण एकः समाश्रितः। वृक्षं तत्रावसन्वीरास्ते कुर्वन्तो महत्तपः॥७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 137,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "षट्पुरवधः--०८२",
      "combined_translation": "7-7"
    },
    {
      "verse": 8,
      "sanskrit": "कपित्थवृक्षमाश्रित्य केचित्तत्रोषिताः पुरा। सृगालवाटीस्त्वपरे चेरुरुग्रं तथा तपः॥८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 137,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "षट्पुरवधः--०८२",
      "combined_translation": "8-8"
    },
    {
      "verse": 9,
      "sanskrit": "वटमूले तथा चेरुस्तपः कौरवनन्दन। अधीयन्तो परं ब्रह्म वटं गत्वासुरात्मजाः॥९॥",
      "english": null,
      "bhavadeepa": "सृगालोऽपि वृक्षविशेषः साहचर्यात्॥८॥",
      "chapter": 137,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "षट्पुरवधः--०८२",
      "combined_translation": "9-9"
    },
    {
      "verse": 10,
      "sanskrit": "तेषां तुष्टः प्रजाकर्ता नरदेवपितामहः। वरं दातुं सुरश्रेष्ठः प्राप्तो धर्मभृतां वरः॥१०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 137,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "षट्पुरवधः--०८२",
      "combined_translation": "10-10"
    },
    {
      "verse": 11,
      "sanskrit": "वरं वरयतेत्युक्तास्ते राजन्पद्मयोनिना। नेषुस्तद्वरदानं तु द्विषन्तस्त्र्यम्बकं विभुम्॥११॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 137,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "षट्पुरवधः--०८२",
      "combined_translation": "11-11"
    },
    {
      "verse": 12,
      "sanskrit": "इच्छन्तोऽपचितिं गन्तुं ज्ञानिनां कुरुनन्दन। तानुवाच ततो ब्रह्मा सर्वज्ञः कुरुनन्दन॥१२॥",
      "english": null,
      "bhavadeepa": "तेन असुराः तेषु नाङ्गीकृतवन्तः॥११॥",
      "chapter": 137,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "षट्पुरवधः--०८२",
      "combined_translation": "12-12"
    },
    {
      "verse": 13,
      "sanskrit": "विश्वस्य जगतः कर्तुः संहर्तुश्च महात्मनः। कः शक्तोऽपचितिं गन्तुं मास्तु वोऽत्र वृथा श्रमः॥१३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 137,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "षट्पुरवधः--०८२",
      "combined_translation": "13-13"
    },
    {
      "verse": 14,
      "sanskrit": "अनादिमध्यनिधनः सोमो देवो महेश्वरः। तमासूय सुखं स्वर्गे वस्तुमिच्छन्ति येऽसुराः॥१४॥",
      "english": null,
      "bhavadeepa": "अपचितिं रुद्रद्रोहेण आनृण्यम्॥१३॥",
      "chapter": 137,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "षट्पुरवधः--०८२",
      "combined_translation": "14-14"
    },
    {
      "verse": 15,
      "sanskrit": "ते नेषुस्तत्र केचित्तु दुरात्मानो महासुराः। अथेषुरपरे राजन्नसुरा भव्यभावनाः॥१५॥",
      "english": null,
      "bhavadeepa": "आसूय प्रतिगर्जित्वा॥१४॥",
      "chapter": 137,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "षट्पुरवधः--०८२",
      "combined_translation": "15-15"
    },
    {
      "verse": 16,
      "sanskrit": "नेषुर्ये सुदुरात्मानस्तानुवाच पितामहः। वरयध्वं वरं वीरा रुद्रक्रोधमृतेऽसुराः॥१६॥",
      "english": null,
      "bhavadeepa": "नेषुः ब्रह्मोक्तं भव्यभावनाः दीर्घदर्शनाः भवमहिमाभिज्ञा वा॥१५॥",
      "chapter": 137,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "षट्पुरवधः--०८२",
      "combined_translation": "16-16"
    },
    {
      "verse": 17,
      "sanskrit": "ते ऊचुः सर्वदेवानामवध्याः स्याम हे विभो। पुराणि षट् च नो देव भवन्त्वन्तर्महीतले॥१७॥",
      "english": null,
      "bhavadeepa": "रुद्रक्रोधं रुद्रक्रोधनम् ऋते विना॥१६॥",
      "chapter": 137,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "षट्पुरवधः--०८२",
      "combined_translation": "17-17"
    },
    {
      "verse": 18,
      "sanskrit": "सर्वकामसमृद्धार्थं षट्पुरं चास्तु नः प्रभो। वयं च षट्पुरं गत्वा वसेम च सुखं विभो॥१८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 137,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "षट्पुरवधः--०८२",
      "combined_translation": "18-18"
    },
    {
      "verse": 19,
      "sanskrit": "रुद्रादुग्रं भयं न स्याद्येन नो ज्ञातयो हताः। निहतं त्रिपुरं दृष्ट्वा भीताः स्म तपसां निधे॥१९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 137,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "षट्पुरवधः--०८२",
      "combined_translation": "19-19"
    },
    {
      "verse": 20,
      "sanskrit": "पितामह उवाच।\n              असुरा भवतावध्या देवानां शङ्करस्य च। न बाधिष्यथ चेद्विप्रान्सत्पथस्थान्सतां प्रियान्॥२०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 137,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "षट्पुरवधः--०८२",
      "combined_translation": "20-20"
    },
    {
      "verse": 21,
      "sanskrit": "विप्रोपघातं मोहाच्चेत्करिष्यथ कथञ्चन। नाशं यास्यथ विप्रा हि जगतः परमा गतिः॥२१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 137,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "षट्पुरवधः--०८२",
      "combined_translation": "21-21"
    },
    {
      "verse": 22,
      "sanskrit": "नारायनाद्विभेतव्यं कुर्वद्भिर्ब्राह्मणाहितम्। सर्वभूतेषु भगवान्हितं धत्ते जनार्दनः॥२२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 137,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "षट्पुरवधः--०८२",
      "combined_translation": "22-22"
    },
    {
      "verse": 23,
      "sanskrit": "ते गता असुरा राजन्ब्रह्मणा ये विसर्जिताः। येऽपि भक्ता महादेवमसुरा धर्मचारिणः॥२३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 137,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "षट्पुरवधः--०८२",
      "combined_translation": "23-23"
    },
    {
      "verse": 24,
      "sanskrit": "स्वयं हि दर्शनं तेषां ददौ त्रिपुरनाशनः। श्वेतं वृषभमारुह्य सोमः सप्रवरः प्रभुः। उवाचेदं च भगवानसुरान्स सतां गतिः॥२४॥",
      "english": null,
      "bhavadeepa": "भव्यभावना इति यदुक्तं तदेव स्पष्टयति- येऽपि भक्ता इति। अपिशब्दस्तुशब्दार्थे॥२३॥",
      "chapter": 137,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "षट्पुरवधः--०८२",
      "combined_translation": "24-24"
    },
    {
      "verse": 25,
      "sanskrit": "वैरमुत्सृज्य दम्भं च हिंसां चासुरसत्तमाः। मामेव चाश्रितास्तस्माद्वरं साधु ददामि वः॥२५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 137,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "षट्पुरवधः--०८२",
      "combined_translation": "25-25"
    },
    {
      "verse": 26,
      "sanskrit": "यैर्दीक्षिताः स्थ मुनिभिः सत्क्रियापरमैर्द्विजैः। सह तैर्गम्यतां स्वर्गः प्रीतोऽहं वः सुकर्मणा॥२६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 137,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "षट्पुरवधः--०८२",
      "combined_translation": "26-26"
    },
    {
      "verse": 27,
      "sanskrit": "इह ये चैव वत्स्यन्ति तापसा ब्रह्मवादिनः। अपि कापित्थिका वृक्षे तेषां लोको यथा मम॥२७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 137,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "षट्पुरवधः--०८२",
      "combined_translation": "27-27"
    },
    {
      "verse": 28,
      "sanskrit": "इह मासान्तपक्षान्तौ यः करिष्यति मानवः। वानप्रस्थेन विधिना पूजयन्मां तपोधनः॥२८॥",
      "english": null,
      "bhavadeepa": "कापित्थिका कपित्थं तस्य वृक्षे॥२७॥",
      "chapter": 137,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "षट्पुरवधः--०८२",
      "combined_translation": "28-28"
    },
    {
      "verse": 29,
      "sanskrit": "वर्षाणां स सहस्रं तु तपसां प्राप्स्यते फलम्। कृत्वा विरात्रं विधिवल्लप्स्यते चेप्सितां गतिम्॥२९॥",
      "english": null,
      "bhavadeepa": "मासान्तपक्षान्तौ अमापूर्णिमे॥२८॥",
      "chapter": 137,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "षट्पुरवधः--०८२",
      "combined_translation": "29-29"
    },
    {
      "verse": 30,
      "sanskrit": "अर्कद्वीपे निवसतो द्विगुणं तद्भविष्यति। न विदेशे च भद्रं वो वरमेतद्ददाम्यहम्॥३०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 137,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "षट्पुरवधः--०८२",
      "combined_translation": "30-30"
    },
    {
      "verse": 31,
      "sanskrit": "श्वेतवाहननामानं यश्च मां पूजयिष्यति। सर्वतो भयचित्तोऽपि गतिं स मम यास्यति॥३१॥",
      "english": null,
