{
  "adhyaya_id": "P19_U03_A092",
  "book": 19,
  "parva_name": "हरिवंशः",
  "upaparva_name": "भविष्यपर्व",
  "adhyaya_name": "पौण्ड्रकनारदसंवादः",
  "chapter": 275,
  "verse_count": 23,
  "verses": [
    {
      "verse": 1,
      "sanskrit": "वैशम्पायन उवाच।\n              ततः कैलासशिखरान्निर्गतो मुनिसत्तमः। नारदः सर्वलोकज्ञः पौण्ड्रस्य नगरं प्रति॥१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 275,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पौण्ड्रकनारदसंवादः",
      "combined_translation": "1-19"
    },
    {
      "verse": 2,
      "sanskrit": "अवतीर्य नभोभागात्प्रत्यागम्य नरोत्तमम्। द्वाःस्थेन च समाज्ञप्तः प्रविवेश गृहोत्तमम्॥२॥",
      "english": null,
      "bhavadeepa": "तत इति॥१॥",
      "chapter": 275,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पौण्ड्रकनारदसंवादः",
      "combined_translation": "2-2"
    },
    {
      "verse": 3,
      "sanskrit": "अर्घ्यादिसमुदाचारं नृपाल्लब्ध्वा महामुनिः। निषसादासने शुभ्रे ह्यास्तृते शुभवाससा॥३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 275,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पौण्ड्रकनारदसंवादः",
      "combined_translation": "3-3"
    },
    {
      "verse": 4,
      "sanskrit": "कुशलं पृष्टवान्भूयो नृपः स मुनिसत्तमम्। उवाच नारदं भूयः पौण्ड्रको बलगर्वितः॥४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 275,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पौण्ड्रकनारदसंवादः",
      "combined_translation": "4-4"
    },
    {
      "verse": 5,
      "sanskrit": "भवान्सर्वत्र कुशलः सर्वकार्येषु पण्डितः। प्रथितो देवसिद्धेषु गन्धर्वेषु महात्मसु॥५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 275,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पौण्ड्रकनारदसंवादः",
      "combined_translation": "5-5"
    },
    {
      "verse": 6,
      "sanskrit": "सर्वत्रगो निराबाधो गत्वा सर्वत्र सर्वदा। अगम्यं तव विप्रेन्द्र ब्रह्माण्डे न हि किञ्चन॥६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 275,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पौण्ड्रकनारदसंवादः",
      "combined_translation": "6-6"
    },
    {
      "verse": 7,
      "sanskrit": "नारदेदं वद त्वं हि यत्र यत्र गतो भवान्। तत्र तत्र तपःसिद्धो लोके प्रथितवीर्यवान्॥७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 275,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पौण्ड्रकनारदसंवादः",
      "combined_translation": "7-7"
    },
    {
      "verse": 8,
      "sanskrit": "पौण्ड्र एव च विख्यातो वासुदेवेति शब्दितः। शङ्खी चक्री गदी शार्ङ्गी खड्गी तूणी तनुत्रवान्। विजेता राजसिंहानां दाता सर्वस्य सर्वदा॥८॥",
      "english": null,
      "bhavadeepa": "वद पौण्ड्रक एव वासुदेवशब्दित इति ख्यापयेत्यर्थः॥७॥",
      "chapter": 275,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पौण्ड्रकनारदसंवादः",
      "combined_translation": "8-8"
    },
    {
      "verse": 9,
      "sanskrit": "भोक्ता राज्यस्य सर्वस्य शास्ता राजा बलाद्बली। अजेयः शत्रुसैन्यानां रक्षिता स्वजनस्य च॥९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 275,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पौण्ड्रकनारदसंवादः",
      "combined_translation": "9-9"
    },
    {
      "verse": 10,
      "sanskrit": "योऽद्य गोपकनामासौ वासुदेवेति शब्दितः। तस्य वीर्यबले न स्तो नाम्नोऽस्य मम धारणे॥१०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 275,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पौण्ड्रकनारदसंवादः",
      "combined_translation": "10-10"
    },
    {
      "verse": 11,
      "sanskrit": "स हि गोपो वृथा बाल्याद्धारयत्येव नाम मे। इदं निश्चिनु विप्रेन्द्र एक एव भवाम्यहम्॥११॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 275,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पौण्ड्रकनारदसंवादः"
    },
    {
      "verse": 12,
      "sanskrit": "वासुदेवो जगत्यस्मिन्निर्जित्य बलिनं यदुम्। वृष्णीन्सर्वान्बलात्क्षिप्त्वा निहनिष्ये च तां पुरीम्॥१२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 275,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पौण्ड्रकनारदसंवादः",
      "combined_translation": "12-12"
    },
    {
      "verse": 13,
      "sanskrit": "द्वारकां विष्णुनिलयां योद्धा चाहं महामते। एते च बलिनः सर्वे नृपा मम समागताः॥१३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 275,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पौण्ड्रकनारदसंवादः",
      "combined_translation": "13-13"
    },
    {
      "verse": 14,
      "sanskrit": "अश्वाश्च वेगिनः सन्ति रथा वायुजवा मम। नानामन्त्राः सहस्रं च गजा नियुतमेव च॥१४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 275,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पौण्ड्रकनारदसंवादः",
      "combined_translation": "14-14"
    },
    {
      "verse": 15,
      "sanskrit": "एतेनाहं बलेनाजौ हनिष्ये केशवं रणे। तस्मादेवं सदा विप्र वद ब्रह्मन्पुरे मम॥१५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 275,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पौण्ड्रकनारदसंवादः",
      "combined_translation": "15-15"
    },
    {
      "verse": 16,
      "sanskrit": "इन्द्रस्यापि सदा विप्र वद नारद साम्प्रतम्। प्रार्थनैश्च मम विभो नमस्ये त्वां तपोधन॥१६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 275,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पौण्ड्रकनारदसंवादः"
    },
    {
      "verse": 17,
      "sanskrit": "नारद उवाच।\n              सर्वत्रगः सदा चास्मि यावद्ब्रह्माण्डसंस्थितिः। आचार्यः सर्वकार्येषु गमने केनचिन्नृप॥१७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 275,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पौण्ड्रकनारदसंवादः",
      "combined_translation": "17-17"
    },
    {
      "verse": 18,
      "sanskrit": "किन्नु वक्तुं तथा राजन्नुत्सहे नृपसत्तम। महीं शासति देवेशे चक्रपाणौ जनार्दने॥१८॥",
      "english": null,
      "bhavadeepa": "आचार्यः शरणीकरणाय। पाठान्तरे गमने आचार्य इति योज्यम्॥१७॥",
      "chapter": 275,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पौण्ड्रकनारदसंवादः",
      "combined_translation": "18-18"
    },
    {
      "verse": 19,
      "sanskrit": "विष्णौ सर्वत्रगे देवे दुष्टान्हत्वा सबान्धवान्। वासुदेवेति को नाम तिष्ठत्यस्मिन्हराविति॥१९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 275,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पौण्ड्रकनारदसंवादः",
      "combined_translation": "19-19"
    },
    {
      "verse": 20,
      "sanskrit": "को नाम वक्तुमेवेदं कृष्णे शासति गोमती। अज्ञानाद्वक्तुमेवं च समार्था प्राकृता जनाः॥२०॥",
      "english": null,
      "bhavadeepa": "को नाम धारयेदिति शेषः॥१९॥",
      "chapter": 275,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पौण्ड्रकनारदसंवादः",
      "combined_translation": "20-20"
    },
    {
      "verse": 21,
      "sanskrit": "हरिः सर्वत्रगो विष्णुर्दर्पं ते व्यपनेष्यति। अचिन्त्यविभवो विष्णुः शार्ङ्गधन्वा गदाधरः॥२१॥",
      "english": null,
      "bhavadeepa": "गोमती सूर्यकिरणसम्पर्कवती द्वे भुवन द्युभूनामनी शासति पालयात इदं वक्तुं को नाम समर्थः स्यात्। न कोऽपात्यर्थः। प्राकृतास्त्वादृशाः मूढाः॥२०॥",
      "chapter": 275,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पौण्ड्रकनारदसंवादः",
      "combined_translation": "21-21"
    },
    {
      "verse": 22,
      "sanskrit": "आदिदेवः पुराणात्मा दर्पं ते व्यपनेष्यति। हास्यमेतन्महाराज यच्च वै तत्र संस्थितम्॥२२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 275,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पौण्ड्रकनारदसंवादः",
      "combined_translation": "22-22"
    },
    {
      "verse": 23,
      "sanskrit": "शार्ङ्गं खड्गं तथा राजन्महाघोरं न दाप्यते। अतीव हासकालोऽयं तव सम्प्रति वर्तते॥२३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 275,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पौण्ड्रकनारदसंवादः",
      "combined_translation": "23-23"
    }
  ]
}