{
  "adhyaya_id": "P19_U02_A063",
  "book": 19,
  "parva_name": "हरिवंशः",
  "upaparva_name": "विष्णुपर्व",
  "adhyaya_name": "नरकवधः-०६३",
  "chapter": 118,
  "verse_count": 126,
  "verses": [
    {
      "verse": 1,
      "sanskrit": "जनमेजय उवाच।\n              प्रत्येत्य द्वारकां विष्णुर्हते रुक्मिणि वीर्यवान्। अकरोद्यन्महाबाहुस्तन्मे वद महामुने॥१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 118,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "नरकवधः-०६३",
      "combined_translation": "1-21"
    },
    {
      "verse": 2,
      "sanskrit": "वैशम्पायन उवाच।\n              स तैः परिवृतः श्रीमान्पुरीं यादवनन्दनः। द्वारकां भगवान्विष्णुः प्रत्यवैक्षत वीर्यवान्॥२॥",
      "english": null,
      "bhavadeepa": "अथात्र त्रिषष्टितमे सुरेन्द्रः कृष्णमब्रवीत्। कुण्डलान्यदितेर्मातुर्हर्तुश्चाथ निबर्हणम्॥१॥ प्रत्येत्येति॥१॥",
      "chapter": 118,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "नरकवधः-०६३",
      "combined_translation": "2-2"
    },
    {
      "verse": 3,
      "sanskrit": "प्रत्यपद्यत रत्नानि विविधानि वसूनि च। यथार्हं पुण्दरीकाक्षो नैर्ऋतान्प्रत्यवारयत्॥३॥",
      "english": null,
      "bhavadeepa": "तैः यदुभिः॥२॥",
      "chapter": 118,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "नरकवधः-०६३",
      "combined_translation": "3-3"
    },
    {
      "verse": 4,
      "sanskrit": "तत्र विघ्नं चरन्ति स्म दैतेयाः सह दानवैः। ताञ्जघान महाबाहुर्वरदृप्तान्महासुरान्॥४॥",
      "english": null,
      "bhavadeepa": "यानि रत्नानि प्रत्यपद्यत तानि नैर्ऋतान् प्रत्यवारयत् राक्षसैः स्वगृहे आनाय्य स्थापितवानित्यर्थः॥३॥",
      "chapter": 118,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "नरकवधः-०६३",
      "combined_translation": "4-4"
    },
    {
      "verse": 5,
      "sanskrit": "विघ्नं चास्याकरोत्तत्र नरको नाम दानवः। त्रासनः सर्वदेवानां देवराजरिपुर्महान्॥५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 118,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "नरकवधः-०६३",
      "combined_translation": "5-5"
    },
    {
      "verse": 6,
      "sanskrit": "स बभौ मूर्तिलिङ्गस्थः सर्वदेवाधिबाधिता। देवतानामृषीणां च प्रतीपमकरोत्तदा॥६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 118,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "नरकवधः-०६३",
      "combined_translation": "6-6"
    },
    {
      "verse": 7,
      "sanskrit": "त्वष्टुर्दुहितरं भौमः कशेरुमगमत्तदा। गजरूपेण जग्राह रुचिराङ्गीं चतुर्दशीम्॥७॥",
      "english": null,
      "bhavadeepa": "मूर्तिलिङ्गस्थः दृश्यज्ञापकं सत्त्वं मूर्तिर्लिङ्गं तत्स्थः प्राग्ज्योतिषपुरस्थो वा बाधिता बाधकः॥६॥",
      "chapter": 118,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "नरकवधः-०६३",
      "combined_translation": "7-7"
    },
    {
      "verse": 8,
      "sanskrit": "प्रमथ्य तां वरारोहां नरको वाक्यमब्रवीत्। नष्टशोकभयो मोहात्प्राग्ज्योतिषपतिस्तदा॥८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 118,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "नरकवधः-०६३",
      "combined_translation": "8-8"
    },
    {
      "verse": 9,
      "sanskrit": "यानि देवमनुष्येषु रत्नानि विविधानि च। बिभर्ति च मही कृत्स्ना सागरेषु च यद्वसु॥९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 118,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "नरकवधः-०६३",
      "combined_translation": "9-9"
    },
    {
      "verse": 10,
      "sanskrit": "अद्यप्रभृति तानीह सहिताः सर्वनैरृताः। ममैवोपाहरिष्यन्ति दैत्याश्च सह दानवैः॥१०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 118,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "नरकवधः-०६३",
      "combined_translation": "10-10"
    },
    {
      "verse": 11,
      "sanskrit": "एवमुत्तमरत्नानि वस्त्राणि विविधानि च। स जहार तदा भौमस्तच्च नाधिचकार सः॥११॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 118,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "नरकवधः-०६३",
      "combined_translation": "11-11"
    },
    {
      "verse": 12,
      "sanskrit": "गन्धर्वाणां च याः कन्या जहार नरको बली। याश्च देवमनुष्याणं सप्त चाप्सरसां गणाः॥१२॥",
      "english": null,
      "bhavadeepa": "तच्च रत्नजातमाहृतमपि नाधिचकार न बुभुजे॥११॥",
      "chapter": 118,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "नरकवधः-०६३",
      "combined_translation": "12-12"
    },
    {
      "verse": 13,
      "sanskrit": "चतुर्दश सहस्राणि एकविंशच्छतानि च। एकवेणीधराः सर्वाः सतीमार्गमनुव्रताः॥१३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 118,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "नरकवधः-०६३",
      "combined_translation": "13-13"
    },
    {
      "verse": 14,
      "sanskrit": "वैशम्पायन उवाच।\n              तासां पुरवरं भौमोऽकारयन्मणिपर्वतम्। अलकायामदीनात्मा मुरोः स्वविषयं प्रति॥१४॥",
      "english": null,
      "bhavadeepa": "एकविंशच्छतानि शताधिके द्वे चतुर्दश चेति षोडश सहस्राणि शतं च एकवेणीधराः कुमारिकाः॥१३॥",
      "chapter": 118,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "नरकवधः-०६३",
      "combined_translation": "14-14"
    },
    {
      "verse": 15,
      "sanskrit": "ताश्च प्राग्ज्योतिषपतिं मुरोश्चैव दशात्मजाः। नैर्ऋताश्च यथा मुख्याः पालयन्त उपासते। स एष तमसः पारे वरदृप्तो महासुरः॥१५॥",
      "english": null,
      "bhavadeepa": "मुरोर्दैत्यस्य॥१४॥",
      "chapter": 118,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "नरकवधः-०६३",
      "combined_translation": "15-15"
    },
    {
      "verse": 16,
      "sanskrit": "न चासुरगणैः सर्वैः सहितैः कर्म तत्पुरा। कृतपूर्वं तदा घोरं यदकार्षीन्महासुरः॥१६॥",
      "english": null,
      "bhavadeepa": "ताः प्राग्ज्योतिषपतिं चेत्यन्वयः। स एष नरकः तमसः नीलवर्णस्य समुद्रस्य पारे तीरे॥१५॥",
      "chapter": 118,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "नरकवधः-०६३",
      "combined_translation": "16-16"
    },
    {
      "verse": 17,
      "sanskrit": "अदितिं धर्षयामास कुण्डलार्थे महासुरः। यं मही सुषुवे देवी यस्य प्राग्ज्योतिषं पुरम्॥१७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 118,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "नरकवधः-०६३",
      "english_ref": 1,
      "combined_translation": "1-17"
    },
    {
      "verse": 18,
      "sanskrit": "द्वारपालाश्च चत्वारस्तस्यासन्युद्धदुर्मदाः। हयग्रीवो निसुन्दश्च वीरः पञ्चनदस्तथा॥१८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 118,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "नरकवधः-०६३"
    },
    {
      "verse": 19,
      "sanskrit": "मुरुः पुत्रसहसरैश्च वरदत्तोऽसुरो महान्। आदेवयानमावृत्य पन्थानं समुपस्थितः। वित्रासनः सुकृतिनां विरूपै राक्षसैः सह॥१९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 118,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "नरकवधः-०६३"
    },
    {
      "verse": 20,
      "sanskrit": "तद्वधार्थं महाबाहुः शङ्खचक्रगदासिभृत्। जातो वृष्णिषु देवक्यां वसुदेवाज्जनार्दनः॥२०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 118,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "नरकवधः-०६३",
      "english_ref": 4,
      "combined_translation": "4-20"
    },
    {
      "verse": 21,
      "sanskrit": "तस्याथ पुरुषेन्द्रस्य लोकप्रथिततेजसः। निवासो द्वारका देवैरुपायादुपपादिता॥२१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 118,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "नरकवधः-०६३"
    },
    {
      "verse": 22,
      "sanskrit": "अतीव हि पुरी रम्या द्वारका वासवक्षयात्। महार्णवपरिक्षिप्ता पञ्चपर्वतशोभिता॥२२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 118,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "नरकवधः-०६३"
    },
    {
      "verse": 23,
      "sanskrit": "तस्यां देवपुराभायां सभा काञ्चनतोरणा। सा दाशार्हीति विख्याता योजनायामविस्तृता॥२३॥",
      "english": null,
      "bhavadeepa": "वासवक्षयात् इन्द्रालयात्॥२२॥",
      "chapter": 118,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "नरकवधः-०६३"
    },
    {
      "verse": 24,
      "sanskrit": "तत्र वृष्ण्यन्धकाः सर्वे रामकृष्णपुरोगमाः। लोकयात्रामिमां कृत्स्नां परिरक्षन्त आसते॥२४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 118,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "नरकवधः-०६३"
    },
    {
      "verse": 25,
      "sanskrit": "तत्रासीनेषु सवषु कदाचिद्भरतर्षभ। दिव्यगन्धो ववौ वायुः पुष्पवर्षं पपात ह॥२५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 118,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "नरकवधः-०६३"
    },
    {
      "verse": 26,
      "sanskrit": "ततः किलकिलाशब्दः प्रभाजालाभिसंवृतः। मुहूर्तमन्तरिक्षेऽभूत्ततो भूमौ प्रतिष्ठितः॥२६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 118,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "नरकवधः-०६३"
    },
    {
      "verse": 27,
      "sanskrit": "मध्ये तु तेजसस्तस्य पाण्डुरं गजमास्थितः। वृतो देवगणैः सर्वैर्वासवः समदृश्यत॥२७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 118,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "नरकवधः-०६३"
    },
    {
      "verse": 28,
      "sanskrit": "रमकृष्णौ च राजा स वृष्ण्यन्धकगणैः सह। प्रत्युद्ययुर्महात्मनं पूजयन्तः सुरेश्वरम्॥२८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 118,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "नरकवधः-०६३"
    },
    {
      "verse": 29,
      "sanskrit": "सोऽवतीर्य गजात्तूर्णं परिष्वज्य जनार्दनम्। सस्वजे बलदेवं च तं च राजानमाहुकम्॥२९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 118,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "नरकवधः-०६३"
    },
    {
      "verse": 30,
      "sanskrit": "वृष्णीनन्यान्सस्वजे च यथाकालं यथावयः। पूजितो रामकृष्णाभ्यामाविवेश स तां सभाम्॥३०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 118,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "नरकवधः-०६३"
    },
    {
      "verse": 31,
      "sanskrit": "तत्रासीनोऽभ्यलङ्कृत्वा सभां ताममरेश्वरः। अर्घादिसमुदाचारं प्रत्यगृह्णाद्यथाविधि॥३१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 118,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "नरकवधः-०६३"
    },
    {
      "verse": 32,
      "sanskrit": "वैशम्पायन उवाच।\n              अथोवाच महातेजा वासवो वासवानुजम्। सान्त्वपूर्वं करेणास्य संस्पृश्य वदनं शुभम्॥३२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 118,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "नरकवधः-०६३"
    },
    {
      "verse": 33,
      "sanskrit": "देवकीनन्दन वचः शृणु मे मधुसूदन। येन त्वाभिगतोऽस्म्यद्य कार्येणामित्रकर्शन॥३३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 118,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "नरकवधः-०६३"
    },
    {
      "verse": 34,
      "sanskrit": "नैर्ऋतो नरको नाम ब्रह्मणो वरदर्पितः। अदित्याः कुण्डले मोहाज्जहार दितिनन्दनः॥३४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 118,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "नरकवधः-०६३"
    },
    {
      "verse": 35,
      "sanskrit": "देवानां विप्रिये नित्यमृषीणां च स वर्तते। तं च देवान्तरं प्रेक्ष्य जहि त्वं पापपूरुषम्॥३५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 118,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "नरकवधः-०६३"
    },
    {
      "verse": 36,
      "sanskrit": "अयं त्वां गरुडस्तत्र प्रापयिष्यति कामगः। कामवीर्योऽतितेजस्वी वैनतेयोऽन्तरिक्षगः॥३६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 118,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "नरकवधः-०६३"
    },
    {
      "verse": 37,
      "sanskrit": "अवध्यः सर्वभूतानां भौमः स नरकोऽसुरः। निषूदयित्वा तं पापं क्षिप्रमागन्तुमर्हसि॥३७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 118,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "नरकवधः-०६३"
    },
    {
      "verse": 38,
      "sanskrit": "इत्युक्तः पुण्डरीकाक्षो देवराजेन केशवः। प्रतिजज्ञे महाबाहुर्नरकस्य निबर्हणे॥३८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 118,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "नरकवधः-०६३"
    },
    {
      "verse": 39,
      "sanskrit": "ततः सहैव शक्रेण शङ्खचक्रगदासिभृत्। प्रतस्थे गरुडेनाथ सत्यभामासहायवान्॥३९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 118,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "नरकवधः-०६३"
    },
    {
      "verse": 40,
      "sanskrit": "क्रमेण सप्तस्कन्धान्स मरुतां सहवासवः। पश्यतां यदुसिंहानामूर्ध्वमाचक्रमे बली॥४०॥",
      "english": null,
      "bhavadeepa": "सत्यभामासहायवान् इति अस्याः सत्यभामायाः पृथिव्यंशत्वात् पृथिव्याज्ञयैव तस्य मृत्युर्विहितोऽस्तीति सत्यभामाज्ञयैव तं हनिष्यामीत्याशयः॥३९॥",
      "chapter": 118,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "नरकवधः-०६३"
    },
    {
      "verse": 41,
      "sanskrit": "वारणेन्द्रगतः शक्रो गरुडस्थो जनार्दनः। विदूरत्वात्प्रकाशेते सूर्याचन्द्रमसाविव॥४१॥",
      "english": null,
      "bhavadeepa": "सप्त स्कन्धान् आवहप्रवहादीन् वायुमार्गान्॥४०॥",
      "chapter": 118,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "नरकवधः-०६३"
    },
    {
      "verse": 42,
      "sanskrit": "अन्तरिक्षे च गन्धर्वैरप्सरोभिश्च केशवः। स्तूयमानोऽथ शक्रश्च क्रमेणान्तरधीयत॥४२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 118,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "नरकवधः-०६३"
    },
    {
      "verse": 43,
      "sanskrit": "समाधायेतिकर्तव्यं वासवो विबुधाधिपः। स्वमेव भवनं प्रायात्कृष्णः प्राग्ज्योतिषं प्रति॥४३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 118,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "नरकवधः-०६३"
    },
    {
      "verse": 44,
      "sanskrit": "पक्षानिलहतो वायुः प्रतिलोमं ववौ तदा। ततो भीमरवा मेघा बभ्रमुर्गगनेचराः॥४४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 118,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "नरकवधः-०६३"
    },
    {
      "verse": 45,
      "sanskrit": "क्षनेन समनुप्राप्तौ द्विजेनाकाशगेन वै। दूरादेव च तान्दृष्ट्वा प्रययौ यत्र ते स्थिताः॥४५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 118,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "नरकवधः-०६३"
    },
    {
      "verse": 46,
      "sanskrit": "अपश्यद्द्वारि तत्रस्थां हस्त्यश्वरथवाहिनीम्। क्षुरान्तान्मौरवान्पाशान्षट्सहस्रान्ददर्श ह॥४६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 118,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "नरकवधः-०६३"
    },
    {
      "verse": 47,
      "sanskrit": "वैशम्पायन उवाच।\n              गरुडस्योपरि श्रीमाञ्छङ्खचक्रगदाधरः। बिभ्रन्नीलाम्बुदाकारं पीतवासाश्चतुर्भुजः॥४७॥",
      "english": null,
      "bhavadeepa": "मौरवान्मुरुविहितान् क्षुरान्तवदतिसूक्ष्मान्दृढतरावयवसंयोगं पाषाणादिकमपि प्रविश्य छेत्तुमर्हानित्यर्थः॥४६॥",
      "chapter": 118,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "नरकवधः-०६३"
    },
    {
      "verse": 48,
      "sanskrit": "वनमालाकुलोरस्कः श्रीवत्साङ्कितभूषणः। किरीटमूर्द्धा सूर्याभः सविद्युदिव चन्द्रमाः॥४८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 118,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "नरकवधः-०६३"
    },
    {
      "verse": 49,
      "sanskrit": "ज्यां विकूजन्महाशब्दः श्रूयतेऽशनिनिःस्वनः। ज्ञात्वा च दानवः सर्वं स्वयं विष्णुरिहागतः॥४९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 118,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "नरकवधः-०६३"
    },
    {
      "verse": 50,
      "sanskrit": "क्रोधाद्द्विगुणरक्ताक्षो मुरुः कालान्तकोपमः। अभ्यधावत वेगेन शक्तिं गृह्य महासुरः॥५०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 118,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "नरकवधः-०६३"
    },
    {
      "verse": 51,
      "sanskrit": "चिक्षेप सुमहाशक्तिं वज्रकाञ्चनभूषिताम्। तामापतन्तीं शक्तीं तु महोल्कां ज्वलितामिव॥५१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 118,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "नरकवधः-०६३"
    },
    {
      "verse": 52,
      "sanskrit": "समाधत्त शरं चैकं रुक्मपुङ्खं जनार्दनः। द्विधाच्छिनत्क्षुरप्रेण वासुदेवः स वीर्यवान्॥५२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 118,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "नरकवधः-०६३"
    },
    {
      "verse": 53,
      "sanskrit": "शक्तिं चिच्छेद तत्रासौ विद्युत्पुञ्ज इव ज्वलन्। पुनश्च क्रोधरक्ताक्षो मुरुर्गृह्य महागदाम्॥५३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 118,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "नरकवधः-०६३"
    },
    {
      "verse": 54,
      "sanskrit": "इन्द्राशनिरिवेन्द्रेण विकृष्ट इव निःस्वनः। आकर्णमुक्तं चिक्षेप अर्धचन्द्रं सुरोत्तमः॥५४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 118,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "नरकवधः-०६३"
    },
    {
      "verse": 55,
      "sanskrit": "मध्यदेशे तु चिच्छेद गदां तां रुक्मभूषिताम्। पुनश्चिच्छेद भल्लेन दानवस्य शिरो रणे॥५५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 118,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "नरकवधः-०६३"
    },
    {
      "verse": 56,
      "sanskrit": "सञ्छिद्य पाशान्सर्वांस्तन्मुरुं हत्वा सबान्धवम्। सोऽग्र्यान्रक्षोगणान्हत्वा नरकस्य महाबलान्॥५६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 118,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "नरकवधः-०६३"
    },
    {
      "verse": 57,
      "sanskrit": "शिलासङ्घानतिक्रम्य भगवान्देवकीसुतः। अपश्यद्दानवं सैन्यं निसुन्दं च महाबलम्॥५७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 118,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "नरकवधः-०६३"
    },
    {
      "verse": 58,
      "sanskrit": "हयग्रीवं च दितिजं तथान्यांश्चित्रयोधिनः। रोधयामास तन्मार्गं स्वसैन्येन महाबलः॥५८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 118,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "नरकवधः-०६३"
    },
    {
      "verse": 59,
      "sanskrit": "निसुन्दो बलिनां श्रेष्ठो रथमारुह्य सत्वरम्। जग्राह कार्मुकं दिव्यं हेमपृष्ठं दुरासदम्॥५९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 118,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "नरकवधः-०६३"
    },
    {
      "verse": 60,
      "sanskrit": "विव्याध दशभिर्बाणैर्निसुन्दो मधुसूदनम्। केशवश्चापि सप्तत्या विव्याध निशितैः शरैः॥६०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 118,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "नरकवधः-०६३",
      "english_ref": 6,
      "combined_translation": "6-60"
    },
    {
      "verse": 61,
      "sanskrit": "अप्राप्तांश्चान्तरिक्षे ताञ्छरांश्चिच्छेद माधवः। ते सर्वे सैनिकाः कृष्णं समन्तात्पर्यवारयन्॥६१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 118,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "नरकवधः-०६३"
    },
    {
      "verse": 62,
      "sanskrit": "शरजालेन महता छाद्यमानः सुरोत्तमः। दृष्ट्वा तान्दानवान्सर्वान्सक्रोधो मधुसूदनः॥६२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 118,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "नरकवधः-०६३"
    },
    {
      "verse": 63,
      "sanskrit": "ततो दिव्येन चास्त्रेन पार्जन्येन जनार्दनः। महता शरवर्षेण वारयामास तद्बलम्॥६३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 118,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "नरकवधः-०६३"
    },
    {
      "verse": 64,
      "sanskrit": "पञ्चपञ्चशरैस्तेषु एकैकेन च तान्बहून्। पार्जन्यस्य प्रभावेण सर्वान्मर्मस्वताडयत्॥६४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 118,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "नरकवधः-०६३"
    },
    {
      "verse": 65,
      "sanskrit": "दुद्रुवुर्भयसन्त्रस्ता भग्नास्ते दानवा रणे। स्वसैन्यं विद्रुतं दृष्ट्वा निश्चक्राम पुनर्मृधे॥६५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 118,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "नरकवधः-०६३"
    },
    {
      "verse": 66,
      "sanskrit": "विसृजच्छरवर्षाणि छादयामास केशवम्। न विभाति रणे सूर्यो नापि व्योम दिशो दश॥६६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 118,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "नरकवधः-०६३"
    },
    {
      "verse": 67,
      "sanskrit": "शरैः सञ्छादयामास निसुन्दो गरुडध्वजम्। सावित्रं नाम दिव्यास्त्रं जग्राह पुरुषोत्तमः॥६७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 118,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "नरकवधः-०६३",
      "english_ref": 4,
      "combined_translation": "4-67"
    },
    {
      "verse": 68,
      "sanskrit": "तेन बाणेन तान्बाणंश्चिच्छेद समरे हरिः। बाणैर्बाणांश्च सञ्च्छिद्य तस्य कृष्णो महाबलः॥६८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 118,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "नरकवधः-०६३"
    },
    {
      "verse": 69,
      "sanskrit": "छत्रमेकेन बाणेन रथेषां च त्रिभिः शरैः। पुनश्चिच्छेद तानश्वांश्चतुर्भिश्चतुरः शरैः॥६९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 118,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "नरकवधः-०६३"
    },
    {
      "verse": 70,
      "sanskrit": "सारथिं पञ्चभिर्बाणैर्ध्वजमेकेन चिच्छिदे। शरैकेन वपुः कृष्णः सुतीक्ष्णेन शितेन वै॥७०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 118,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "नरकवधः-०६३"
    },
    {
      "verse": 71,
      "sanskrit": "शिरश्चिच्छेद भल्लेन निसुन्दस्य सुरोत्तमः। यः सहस्रसमास्त्वेकः सर्वान्देवानयोधयत्॥७१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 118,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "नरकवधः-०६३"
    },
    {
      "verse": 72,
      "sanskrit": "निसुन्दं पतितं दृष्ट्वा हयग्रीवः प्रतापवान्। शिलां प्रगृह्य महतीं तोलयामास दानवः॥७२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 118,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "नरकवधः-०६३"
    },
    {
      "verse": 73,
      "sanskrit": "आविध्य सहसामुञ्चच्छिलां शैलसमां प्रभुः। गृहीत्वा दिव्यपार्जन्यमस्त्रमस्त्रविदां वरः॥७३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 118,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "नरकवधः-०६३"
    },
    {
      "verse": 74,
      "sanskrit": "दिव्यास्त्रेण शिलां विष्णुः सप्तधाकृत तेजसा। तद्विदार्य महच्चाश्म पातयामास भूतले॥७४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 118,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "नरकवधः-०६३"
    },
    {
      "verse": 75,
      "sanskrit": "ततस्तैः शार्ङ्गनिर्मुक्तैर्नानावर्णैर्महाशरैः। यथा देवासुरं युद्धमभवद्भरतर्षभ। नानाप्रहरणाकीर्णं तथा घोरमवर्तत॥७५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 118,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "नरकवधः-०६३"
    },
    {
      "verse": 76,
      "sanskrit": "ततः शार्ङ्गविनिर्मुक्तैर्नानावर्णैर्महाशरैः। गरुडस्थो महाबाहुर्निजघान महासुरान्॥७६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 118,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "नरकवधः-०६३"
    },
    {
      "verse": 77,
      "sanskrit": "महालाङ्गलनिर्भिन्नाः शङ्खशक्तिनिपातिताः। विनेशुर्दानवाः सर्वे समासाद्य जनार्दनम्॥७७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 118,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "नरकवधः-०६३"
    },
    {
      "verse": 78,
      "sanskrit": "केचिच्चक्राग्निनिर्दग्धा दानवाः पेतुरम्बरात्। सन्निकर्षगताः केचिद्गतासुविकृताननाः॥७८॥",
      "english": null,
      "bhavadeepa": "महालाङ्गलनिर्भिन्नाः लाङ्गलेन भूरिविदारितदेहाः शङ्खशक्तिमहानादस्तेनैव पातिताः॥७७॥",
      "chapter": 118,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "नरकवधः-०६३"
    },
    {
      "verse": 79,
      "sanskrit": "असृजच्छरवर्षाणि वृष्टिमन्त इवाम्बुदाः। विकृताङ्गाः सुराः सर्वे कृष्णबाणप्रपीडिताः॥७९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 118,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "नरकवधः-०६३"
    },
    {
      "verse": 80,
      "sanskrit": "शोणिताक्ताः स्म दृश्यन्ते पुष्पिता इव किंशुकाः। व्यद्रवन्त सुवित्रस्ता भग्नास्त्राश्चित्रयोधिनः॥८०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 118,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "नरकवधः-०६३"
    },
    {
      "verse": 81,
      "sanskrit": "पुनश्च क्रोधरक्ताक्षो वायुवेगेन दानवः। दशव्यामोच्छ्रितं वृक्षं समारुह्य वनस्पतिम्॥८१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 118,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "नरकवधः-०६३"
    },
    {
      "verse": 82,
      "sanskrit": "वृक्षमुत्पाट्य वेगेन प्रतिगृह्याभ्यधावत। चिक्षेप स महावृक्षं शिक्षया सुघनाकृतिः॥८२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 118,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "नरकवधः-०६३"
    },
    {
      "verse": 83,
      "sanskrit": "वृक्षवेगानिलोद्धूतः शुश्रुवे सुमहास्वनः। ततः शरसहस्रेण यतमानो जनार्दनः॥८३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 118,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "नरकवधः-०६३"
    },
    {
      "verse": 84,
      "sanskrit": "नैकधा तं प्रचिच्छेद चित्रभक्तिनिभाकृतिम्। पुनश्चैकेन बाणेन हयग्रीवस्य चोरसि॥८४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 118,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "नरकवधः-०६३"
    },
    {
      "verse": 85,
      "sanskrit": "विव्याध स्तनयोर्मध्ये सायको ज्वलनप्रभः। विवेश सोऽपि वेगेन हृदं भित्त्वा विनिर्गतः॥८५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 118,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "नरकवधः-०६३"
    },
    {
      "verse": 86,
      "sanskrit": "तं जघान महाघोरं हयग्रीवं महाबलम्। अपारतेजा दुर्द्धर्षः स वै यादवनन्दनः॥८६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 118,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "नरकवधः-०६३"
    },
    {
      "verse": 87,
      "sanskrit": "मध्ये लोहितगङ्गस्य भगवान्देवकीसुतः। औदकायां विरूपाक्षं पाप्मानं पुरुषोत्तमः॥८७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 118,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "नरकवधः-०६३"
    },
    {
      "verse": 88,
      "sanskrit": "अष्टौ शतसहस्राणि दानवानां परन्तपः। निहत्य पुरुषव्याघ्रः प्राग्ज्योतिषमुपाद्रवत्॥८८॥",
      "english": null,
      "bhavadeepa": "लोहितगङ्गस्य सिन्धोः प्रदेशविशेषस्य मध्ये। औदकायाम् उदकपरिखायां पुर्याम्॥८७॥",
      "chapter": 118,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "नरकवधः-०६३"
    },
    {
      "verse": 89,
      "sanskrit": "हत्वा पञ्चनदं नाम नरकस्य महासुरम्। ततः प्राग्ज्योतिषं नाम दीप्यमानमिव श्रिया॥८९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 118,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "नरकवधः-०६३"
    },
    {
      "verse": 90,
      "sanskrit": "पुरमासादयामास युद्धं तत्राभवन्महत्। ततः प्राध्मापयच्छङ्खं पाञ्चजन्यं महाबलः॥९०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 118,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "नरकवधः-०६३"
    },
    {
      "verse": 91,
      "sanskrit": "शुश्रुवे सुमहाशब्दः संवर्तनिनदो यथा। श्रूयते त्रिषु लोकेषु भीमगम्भीरनिःस्वनः। तं श्रुत्वा नरकश्चासीत्क्रोधसंरक्तलोचनः॥९१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 118,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "नरकवधः-०६३"
    },
    {
      "verse": 92,
      "sanskrit": "लोहचक्राष्टसंयुक्तं त्रिनल्वप्रतिमं रथम्। रत्नकाञ्चनचित्राढ्यं वेदिकाभोगविस्तरम्॥९२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 118,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "नरकवधः-०६३"
    },
    {
      "verse": 93,
      "sanskrit": "वज्रध्वजेन महता काञ्चनेन विराजितं। हेमदण्डपताकाढ्यं वैदूर्यमणिकूबरम्॥९३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 118,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "नरकवधः-०६३"
    },
    {
      "verse": 94,
      "sanskrit": "युक्तमश्वसहस्रेण रथं पररथारुजम्। लोहजालैश्च सञ्छन्नं चित्रभक्तिविराजितम्॥९४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 118,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "नरकवधः-०६३"
    },
    {
      "verse": 95,
      "sanskrit": "रथमध्यगतो वीरः ससन्ध्य इव भास्करः। नानाप्रहरणाकीर्णं रथं हेमपरिष्कृतम्॥९५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 118,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "नरकवधः-०६३"
    },
    {
      "verse": 96,
      "sanskrit": "वज्रं रथोरच्छदमिन्दुवर्णं व्यानद्धमुक्तामलतुल्यतेजाः। किरीटमूर्द्धार्कहुताशनाभः कर्णौ तथा कुण्डलयोर्ज्वलन्तौ॥९६॥",
      "english": null,
      "bhavadeepa": "रथम् आरुरोहेति शेषः॥९५॥",
      "chapter": 118,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "नरकवधः-०६३"
    },
    {
      "verse": 97,
      "sanskrit": "धूम्रवर्णा महाकाया रक्ताक्षा विकृताननाः। नानाकवचिनः सर्वे दैत्यदानवराक्षसाः॥९७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 118,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "नरकवधः-०६३"
    },
    {
      "verse": 98,
      "sanskrit": "खड्गचर्मधराः केचित्केचित्तूर्णधनुर्भृतः। शक्तिहस्तास्तथा केचिच्छूलहस्तास्तथापरे॥९८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 118,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "नरकवधः-०६३"
    },
    {
      "verse": 99,
      "sanskrit": "गजवाजिरथौघैश्च कालयन्तश्च मेदिनीम्। निर्ययुर्नगरात्सर्वे सुसन्नद्धाः प्रहारिणः॥९९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 118,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "नरकवधः-०६३"
    },
    {
      "verse": 100,
      "sanskrit": "वृतो दैत्यगणैः सार्धं नरकः कालसन्निभः। भेरीशङ्खमृदङ्गानां पणवानां सहस्रशः॥१००॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 118,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "नरकवधः-०६३"
    },
    {
      "verse": 101,
      "sanskrit": "वाद्यमानानि शुश्राव जीमूतनिनदोपमः। यतः कृष्णस्ततो गत्वा सर्वे ते विकृताननाः॥१०१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 118,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "नरकवधः-०६३"
    },
    {
      "verse": 102,
      "sanskrit": "परिवार्य गरुत्मन्तं सर्वेऽयुध्यन्त सङ्गताः। महता छादयामासुः शरवर्षेण सैनिकाः॥१०२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 118,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "नरकवधः-०६३"
    },
    {
      "verse": 103,
      "sanskrit": "शक्तिशूलगदाप्रासांस्तोमरान्सायकान्बहून्। आकाशं छादयामासुर्विमुञ्चन्तः सहस्रशः॥१०३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 118,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "नरकवधः-०६३"
    },
    {
      "verse": 104,
      "sanskrit": "कृष्णः कृष्णोम्बुदाकारः शार्ङ्गं गृह्य धनुस्ततः। विस्फार्य सुमहच्चापं धनुर्जलदनिःस्वनम्॥१०४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 118,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "नरकवधः-०६३"
    },
    {
      "verse": 105,
      "sanskrit": "व्यसृजच्छरवर्षाणि दानवानां जनार्दनः। शरवर्षेण तत्सैन्यं व्यद्रवत्तु महाहवात्॥१०५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 118,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "नरकवधः-०६३"
    },
    {
      "verse": 106,
      "sanskrit": "तद्युद्धमभवद्घोरं घोररूपेण रक्षसा। भग्नव्यूहाश्च ते सर्वे कृष्णबाणप्रपीडिताः॥१०६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 118,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "नरकवधः-०६३"
    },
    {
      "verse": 107,
      "sanskrit": "केचिच्छिन्नभुजाश्चैव च्छिन्नग्रीवाशिराननाः। केचिच्चक्रद्विधाच्छिन्नाः केचिद्बाणार्दितोरसः॥१०७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 118,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "नरकवधः-०६३"
    },
    {
      "verse": 108,
      "sanskrit": "केचिद्द्विधाकृताः शक्त्या गजाश्वरथवाहनाः। केचित्कौमोदकीभिन्नाः केचिच्चक्रविदारिताः॥१०८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 118,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "नरकवधः-०६३"
    },
    {
      "verse": 109,
      "sanskrit": "एवं विमथिता सर्वा नराश्वरथवाहिनी। तत्रासीन्नरकेणास्य युद्धं परमदारुणम्॥१०९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 118,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "नरकवधः-०६३"
    },
    {
      "verse": 110,
      "sanskrit": "यत्समानेन वक्ष्यामि तन्मे निगदतः शृणु। त्रासनः सुरसङ्घानां नरकः पुरुषोत्तमम्॥११०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 118,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "नरकवधः-०६३"
    },
    {
      "verse": 111,
      "sanskrit": "योधयामास तेजस्वी मधुवन्मधुसूदनम्। क्रोधरक्तान्तनयनो नरको घनसन्निभः॥१११॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 118,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "नरकवधः-०६३"
    },
    {
      "verse": 112,
      "sanskrit": "जग्राह कार्मुकं वीरः शक्रचापमिवोच्छ्रितम्। तथार्ककिरणप्रख्यं बाणं जग्राह केशवः॥११२॥",
      "english": null,
      "bhavadeepa": "मधुः कैटभभ्राता तद्वत्॥१११॥",
      "chapter": 118,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "नरकवधः-०६३"
    },
    {
      "verse": 113,
      "sanskrit": "दिव्येनास्त्रेण समरे पूरयामास तं रथम्। उत्तमास्त्रं महापातं मुमोच नरको बली॥११३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 118,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "नरकवधः-०६३"
    },
    {
      "verse": 114,
      "sanskrit": "वज्रविस्फूर्जिताकारमायान्तं वीक्ष्य केशवः। चिच्छेदास्त्रं महाभागश्चक्रेण मधुसूदनः॥११४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 118,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "नरकवधः-०६३"
    },
    {
      "verse": 115,
      "sanskrit": "व्यहनत्स रथं चास्य शरैकेण जनार्दनः। सरथं सध्वजं साश्वं जघान दशभिः शरैः॥११५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 118,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "नरकवधः-०६३"
    },
    {
      "verse": 116,
      "sanskrit": "तनुत्रं चैव चिच्छेद शरेण मधुसूदनः। ततो विमुक्तकवचः सर्पस्येव तनुर्यथा॥११६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 118,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "नरकवधः-०६३"
    },
    {
      "verse": 117,
      "sanskrit": "हताश्वोऽपि रणे वीरो वितनुत्रश्च दानवः। जग्राह विमलज्वालं लोहभारार्पितं दृढम्॥११७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 118,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "नरकवधः-०६३"
    },
    {
      "verse": 118,
      "sanskrit": "आविध्य सहसा मुक्तं शूलमिन्द्राशनिप्रभम्। तदापतत्स सम्प्रेक्ष्य शूलं हेमपरिष्कृतम्॥११८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 118,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "नरकवधः-०६३"
    },
    {
      "verse": 119,
      "sanskrit": "द्विधा छिन्नं क्षुरप्रेण कृष्णेनाद्भुतकर्मणा। तद्युद्धमभवद्घोरं घोररूपेण रक्षसा॥११९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 118,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "नरकवधः-०६३"
    },
    {
      "verse": 120,
      "sanskrit": "शस्त्रपातमहाघातं नरकेन महात्मना। मुहूर्तं योधयामास नरकं मधुसूदनः॥१२०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 118,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "नरकवधः-०६३"
    },
    {
      "verse": 121,
      "sanskrit": "अथोग्रचक्रश्चक्रेण प्रदीप्तेनाकरोद्द्विधा। चक्रद्विधाकृतं तस्य शरीरमपतद्भुवि॥१२१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 118,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "नरकवधः-०६३"
    },
    {
      "verse": 122,
      "sanskrit": "विभक्तं कुलिशेनैव गिरेः शृङ्गं द्विधाकृतम्। कृष्णमासाद्य देवेशं जगामास्तमिवांशुमान्॥१२२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 118,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "नरकवधः-०६३"
    },
    {
      "verse": 123,
      "sanskrit": "चक्रोत्कृन्तितगात्रोऽसौ दानवः पतितो रणे। वज्रप्रहारनिर्भिन्नं यथा गैरिकपर्वतम्॥१२३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 118,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "नरकवधः-०६३"
    },
    {
      "verse": 124,
      "sanskrit": "भूमिस्तु पतितं पुत्रं निरीक्ष्यादाय कुण्डले। उपातिष्ठत गोविन्दं वचनं चेदमब्रवीत्॥१२४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 118,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "नरकवधः-०६३"
    },
    {
      "verse": 125,
      "sanskrit": "दत्तस्त्वयैव गोविन्द त्वयैव विनिपातितः। यथेच्छसि तथा क्रीड बालः क्रीडनकैरिव॥१२५॥",
      "english": null,
      "bhavadeepa": "भूमिः रूपिणी भूत्वा॥१२४॥",
      "chapter": 118,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "नरकवधः-०६३"
    },
    {
      "verse": 126,
      "sanskrit": "इमे ते कुण्डले देव प्रजास्तस्यानुपालय॥१२६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 118,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "नरकवधः-०६३"
    }
  ]
