{
  "adhyaya_id": "P19_U03_A066",
  "book": 19,
  "parva_name": "हरिवंशः",
  "upaparva_name": "भविष्यपर्व",
  "adhyaya_name": "देवगणैः सह कश्यपादित्योर्ब्रह्मसदनगमनकथनम्",
  "chapter": 249,
  "verse_count": 47,
  "verses": [
    {
      "verse": 1,
      "sanskrit": "जनमेजय उवाच।\n              पराजिताः सुरा दैत्यैः किमकुर्वत वै मुने। कथं च त्रिदिवं लब्धं भूयो देवैर्द्विजोत्तम॥१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 249,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवगणैः सह कश्यपादित्योर्ब्रह्मसदनगमनकथनम्",
      "combined_translation": "1-19"
    },
    {
      "verse": 2,
      "sanskrit": "वैशम्पायन उवाच।\n              श्रुत्वा वाणीं तु तां दिव्यां सह देवैः सुराधिपः। प्राग्दिशं प्रस्थितः श्रीमानदित्यालयमुत्तमम्॥२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 249,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवगणैः सह कश्यपादित्योर्ब्रह्मसदनगमनकथनम्",
      "combined_translation": "2-2"
    },
    {
      "verse": 3,
      "sanskrit": "प्राप्यादित्यालयं शक्रः कथयामास तां गिरम्। अदित्यां सा यथा युद्धे तेन वाणी पुरा श्रुता॥३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 249,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवगणैः सह कश्यपादित्योर्ब्रह्मसदनगमनकथनम्",
      "combined_translation": "3-3"
    },
    {
      "verse": 4,
      "sanskrit": "अदितिरुवाच।\n              यद्येवं पुत्र युष्माभिर्न शक्यो हन्तुमाहवे। बलिर्विरोचनसुतः सर्वैश्चैव मरुद्गणैः॥४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 249,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवगणैः सह कश्यपादित्योर्ब्रह्मसदनगमनकथनम्",
      "combined_translation": "4-4"
    },
    {
      "verse": 5,
      "sanskrit": "सहस्रशिरसा हन्तुं केवलं शक्यतेऽसुरः। तेनैकेन सहस्राक्ष न ह्यन्येन शतक्रतो॥५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 249,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवगणैः सह कश्यपादित्योर्ब्रह्मसदनगमनकथनम्",
      "combined_translation": "5-5"
    },
    {
      "verse": 6,
      "sanskrit": "तद्वः पृच्छस्व पितरं कश्यपं सत्यवादिनम्। पराजयार्थं दैत्यस्य बलेस्तस्य महात्मनः॥६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 249,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवगणैः सह कश्यपादित्योर्ब्रह्मसदनगमनकथनम्",
      "combined_translation": "6-6"
    },
    {
      "verse": 7,
      "sanskrit": "ततोऽदित्या सह सुराः सम्प्राप्ताः कश्यपान्तिकम्। अपश्यन्कश्यपं तत्र मुनिं दिव्यतपोनिधिम्॥७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 249,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवगणैः सह कश्यपादित्योर्ब्रह्मसदनगमनकथनम्",
      "combined_translation": "7-7"
    },
    {
      "verse": 8,
      "sanskrit": "आद्यं देवं गुरुं दिव्यं क्लिन्नं त्रिषवणाम्बुभिः। तेजसा भास्कराकारं गौरमग्निशिखाप्रभम्॥८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 249,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवगणैः सह कश्यपादित्योर्ब्रह्मसदनगमनकथनम्",
      "combined_translation": "8-8"
    },
    {
      "verse": 9,
      "sanskrit": "न्यस्तदण्डं तपोयुक्तं बद्धकृष्णाजिनोत्तरम्। वल्कलाजिनसंवीतं प्रदीप्तं ब्रह्मवर्चसा॥९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 249,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवगणैः सह कश्यपादित्योर्ब्रह्मसदनगमनकथनम्",
      "combined_translation": "9-9"
    },
    {
      "verse": 10,
      "sanskrit": "हुताशमिव दीप्यन्तमाज्यमन्त्रपुरस्कृतम्। स्वाध्यायनिरतं शान्तं वपुष्मन्तमिवानलम्॥१०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 249,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवगणैः सह कश्यपादित्योर्ब्रह्मसदनगमनकथनम्",
      "combined_translation": "10-10"
    },
    {
      "verse": 11,
      "sanskrit": "तं ब्रह्मवादिनां श्रेष्ठं सुरासुरगुरुं प्रभुम्। प्रतपन्तमिवादित्यं मारीचं दीप्ततेजसम्॥११॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 249,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवगणैः सह कश्यपादित्योर्ब्रह्मसदनगमनकथनम्",
      "combined_translation": "11-11"
    },
    {
      "verse": 12,
      "sanskrit": "यः स्रष्टा सर्वभूतानां प्रजानां पतिरुत्तमः। आत्मभावविशेषेण तृतीयो यः प्रजपतिः॥१२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 249,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवगणैः सह कश्यपादित्योर्ब्रह्मसदनगमनकथनम्",
      "combined_translation": "12-12"
    },
    {
      "verse": 13,
      "sanskrit": "ततः प्रणम्य ते वीराः सहादित्या सुरर्षभाः। ऊचुः प्राञ्जलयः सर्वे ब्रह्माणमिव मानसाः॥१३॥",
      "english": null,
      "bhavadeepa": "य इति। उत्तम इति चतुर्मुख उक्तः। तस्य “आत्मा वै पुत्रनामासि” इति श्रुत्यावगतः पुत्रे मरीचौ आत्मभावः एवं परम्परया पौत्रेऽपि साधारण्येनात्मभावप्राप्तावाह आत्मभावविशेषेणेति। पुत्रापेक्षयापौत्रे आत्मभावे विशेषतोऽस्ति। अत एव प्रह्लादगुणाः वैष्णवत्वादयः पौत्रे बलौ कार्स्न्येनाभिव्यक्ता न तु पुत्रे विरोचने। अत एव दाक्षिणात्याः पौत्रं पितामहनाम्ना योजयन्ति॥१२॥",
      "chapter": 249,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवगणैः सह कश्यपादित्योर्ब्रह्मसदनगमनकथनम्",
      "combined_translation": "13-13"
    },
    {
      "verse": 14,
      "sanskrit": "तच्छ्रुतं युधि शक्रेण सरस्वत्या समीरितम्। अजेयस्त्रिदशैः सर्वैर्बलिर्दानवसत्तमः॥१४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 249,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवगणैः सह कश्यपादित्योर्ब्रह्मसदनगमनकथनम्",
      "combined_translation": "14-14"
    },
    {
      "verse": 15,
      "sanskrit": "श्रुत्वा तु वचनं तेषां पुत्राणां कश्यपस्तदा। चकार गमने बुद्धिं ब्रह्मलोकाय लोककृत्॥१५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 249,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवगणैः सह कश्यपादित्योर्ब्रह्मसदनगमनकथनम्",
      "combined_translation": "15-15"
    },
    {
      "verse": 16,
      "sanskrit": "कश्यप उवाच।\n              गच्छाम ब्रह्मसदनं ब्रह्मघोषनिनादितम्। यथाश्रुतं च तत्रैव ब्रह्मणे वदतानघाः॥१६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 249,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवगणैः सह कश्यपादित्योर्ब्रह्मसदनगमनकथनम्",
      "combined_translation": "16-16"
    },
    {
      "verse": 17,
      "sanskrit": "वैशम्पायन उवाच।\n              ततोऽदित्या सह सुरा यान्तं कश्यपमन्वयुः। प्रस्थितं ब्रह्मसदनं देवर्षिगणसेवितम्॥१७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 249,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवगणैः सह कश्यपादित्योर्ब्रह्मसदनगमनकथनम्",
      "combined_translation": "17-17"
    },
    {
      "verse": 18,
      "sanskrit": "ते मुहूर्तेन सम्प्राप्ता ब्रह्मलोकं दिवौकसः। दिव्यैः कामगमैर्यानैर्महार्हैः सुमनोहरैः॥१८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 249,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवगणैः सह कश्यपादित्योर्ब्रह्मसदनगमनकथनम्",
      "combined_translation": "18-18"
    },
    {
      "verse": 19,
      "sanskrit": "दिदृक्षवस्ते ब्रह्माणं तपसो राशिमव्ययम्। अभ्यगच्छन्त विस्तीर्णां ब्रह्मणः परमां सभाम्॥१९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 249,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवगणैः सह कश्यपादित्योर्ब्रह्मसदनगमनकथनम्",
      "combined_translation": "19-19"
    },
    {
      "verse": 20,
      "sanskrit": "षट्पदोद्गीतनिनदां सामगीतविमिश्रिताम्। श्रेयस्करीममित्रघ्नीं दृष्ट्वा सञ्जहृषुर्मुदा॥२०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 249,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवगणैः सह कश्यपादित्योर्ब्रह्मसदनगमनकथनम्",
      "combined_translation": "20-20"
    },
    {
      "verse": 21,
      "sanskrit": "ब्राह्मणैश्च महभागैर्वेदवेदाङ्गपारगैः। ऋचो बह्वृचमुख्यैश्च शिक्षाविद्भिस्तथा द्विजैः। शब्दनिर्वचनार्थं च प्रेर्यमाणपदाक्षराः॥२१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 249,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवगणैः सह कश्यपादित्योर्ब्रह्मसदनगमनकथनम्",
      "combined_translation": "21-21"
    },
    {
      "verse": 22,
      "sanskrit": "शुश्रुवुस्तेऽमरव्याघ्रा विततेषु च कर्मसु। यज्ञवेदाङ्गविदुषां पदक्रमविदां तथा॥२२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 249,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवगणैः सह कश्यपादित्योर्ब्रह्मसदनगमनकथनम्",
      "combined_translation": "22-22"
    },
    {
      "verse": 23,
      "sanskrit": "घोषेण परमर्षीणां सा बभूव निनादिता। यज्ञसंस्तवविद्भिश्च शिक्षाविद्भिस्तथा द्विजैः॥२३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 249,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवगणैः सह कश्यपादित्योर्ब्रह्मसदनगमनकथनम्",
      "combined_translation": "23-23"
    },
    {
      "verse": 24,
      "sanskrit": "शब्दनिर्वचनार्थज्ञैः सर्वविद्याविशारदैः। मीमांसाहितवाक्यज्ञैः सर्ववादविशारदैः॥२४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 249,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवगणैः सह कश्यपादित्योर्ब्रह्मसदनगमनकथनम्",
      "combined_translation": "24-24"
    },
    {
      "verse": 25,
      "sanskrit": "हृष्टपुष्टस्वरैस्तत्र द्विजेन्द्रवल्गुवादिभिः। नादितं ब्रह्मसदनं प्रवरं देवसद्मवत्॥२५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 249,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवगणैः सह कश्यपादित्योर्ब्रह्मसदनगमनकथनम्",
      "combined_translation": "25-25"
    },
    {
      "verse": 26,
      "sanskrit": "ते तत्र समनुप्राप्य शृण्वन्तो वै ध्वनिं सुराः। पूतान्यात्मशरीराणि मेनिरे तु न संशयः॥२६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 249,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवगणैः सह कश्यपादित्योर्ब्रह्मसदनगमनकथनम्",
      "combined_translation": "26-26"
    },
    {
      "verse": 27,
      "sanskrit": "तूष्णिम्भूता एकचित्ता ब्रह्मण्यगतमानसाः। विस्मयोत्फुल्लनयना निरीक्षन्तः परस्परम्॥२७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 249,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवगणैः सह कश्यपादित्योर्ब्रह्मसदनगमनकथनम्",
      "combined_translation": "27-27"
    },
    {
      "verse": 28,
      "sanskrit": "नमस्कुर्वन्ति च पुनर्गुरुं लोकगुरुं प्रभुम्। मनसैव सुरश्रेष्ठाः पुरस्कृत्य तु कश्यपम्॥२८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 249,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवगणैः सह कश्यपादित्योर्ब्रह्मसदनगमनकथनम्",
      "combined_translation": "28-28"
    },
    {
