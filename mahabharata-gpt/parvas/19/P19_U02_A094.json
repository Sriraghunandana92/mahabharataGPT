  "verses": [
    {
      "verse": 1,
      "sanskrit": "वैशम्पायन उवाच।\n              आविष्टेयं मया बाला सर्वथेत्यवगम्य तु। कार्ष्णिर्हृष्टेन मनसा हंसीमिदमुवाच ह॥१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 149,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "प्रभावतीपाणिग्रहणम्-०९४"
    },
    {
      "verse": 2,
      "sanskrit": "दैत्येन्द्रतनयां प्राप्तमवगच्छस्व मामिह। षट्पदैः सह षट्पादो भूत्वा माल्ये विलीय हि॥२॥",
      "english": null,
      "bhavadeepa": "आविष्टेयमिति॥१॥",
      "chapter": 149,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "प्रभावतीपाणिग्रहणम्-०९४",
      "combined_translation": "2-2"
    },
    {
      "verse": 3,
      "sanskrit": "विधेयोऽस्मि प्रभावत्या यथेष्टं मयि वर्तताम्। इत्युक्त्वा दर्शयामास सुरूपो रूपमात्मनः॥३॥",
      "english": null,
      "bhavadeepa": "अवगच्छस्व ज्ञापय। माल्ये। निलीय प्राप्तं माम्॥२॥",
      "chapter": 149,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "प्रभावतीपाणिग्रहणम्-०९४",
      "combined_translation": "3-3"
    },
    {
      "verse": 4,
      "sanskrit": "तद्धर्म्यपृष्ठं प्रभया द्योतितं तस्य धीमतः। अभिभूता प्रभा चैव राजंश्चन्द्रोद्भवा शुभा॥४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 149,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "प्रभावतीपाणिग्रहणम्-०९४",
      "combined_translation": "4-4"
    },
    {
      "verse": 5,
      "sanskrit": "प्रभावत्यास्तु तं दृष्ट्वा ववृधे कामसागरः। चन्द्रस्येवोदये प्राप्ते पर्वण्यां सरितां पतिः॥५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 149,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "प्रभावतीपाणिग्रहणम्-०९४",
      "combined_translation": "5-5"
    },
    {
      "verse": 6,
      "sanskrit": "सलज्जाधोमुखी किञ्चित्किञ्चित्तिर्यगवेक्षिणी। प्रभावती तदा तस्थौ निश्चलं कमलेक्षणा॥६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 149,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "प्रभावतीपाणिग्रहणम्-०९४",
      "combined_translation": "6-6"
    },
    {
      "verse": 7,
      "sanskrit": "करेणाधःप्रदेशे तां चारुभूषणभूषिताम्। स्पृष्ट्वोवाच वरारोहां रोमाञ्चिततनुस्ततः॥७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 149,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "प्रभावतीपाणिग्रहणम्-०९४",
      "combined_translation": "7-7"
    },
    {
      "verse": 8,
      "sanskrit": "मनोरथशतैर्लब्धं किं पूर्णेन्दुसमप्रभम्। अधोमुखं मुखं कृत्वा न मां किञ्चित्प्रभाषसे॥८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 149,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "प्रभावतीपाणिग्रहणम्-०९४",
      "combined_translation": "8-8"
    },
    {
      "verse": 9,
      "sanskrit": "प्रभोपमर्दं मा कार्षीर्वदनस्य वरानने। साध्वसं त्यज्यतां भीरु दासः साध्वनुगृह्यताम्॥९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 149,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "प्रभावतीपाणिग्रहणम्-०९४",
      "combined_translation": "9-9"
    },
    {
      "verse": 10,
      "sanskrit": "न कालमिव पश्यामि भीरु भीरुत्वमुत्सृज। याचाम्येशोऽञ्जलिं कृत्वा प्राप्तकालं निबोध मे॥१०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 149,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "प्रभावतीपाणिग्रहणम्-०९४",
      "combined_translation": "10-10"
    },
    {
      "verse": 11,
      "sanskrit": "गान्धर्वेण विवाहेन कुरुष्वानुग्रहं मम। देशकालानुरूपेण रूपेणाप्रतिमा सती॥११॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 149,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "प्रभावतीपाणिग्रहणम्-०९४",
      "combined_translation": "11-11"
    },
    {
      "verse": 12,
      "sanskrit": "उपस्पृश्य ततो भैमो मणिस्थं जातवेदसम्। जुहाव समये वीरः पुष्पैर्मन्त्रानुदीरयन्॥१२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 149,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "प्रभावतीपाणिग्रहणम्-०९४",
      "combined_translation": "12-12"
    },
    {
      "verse": 13,
      "sanskrit": "जग्राहाथ करं तस्या वराभरणभूषितम्। चक्रे प्रदक्षिणं चैव तं मणिस्थं हुताशनम्॥१३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 149,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
