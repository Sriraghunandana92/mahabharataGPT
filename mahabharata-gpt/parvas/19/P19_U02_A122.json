      "combined_translation": "16-16"
    },
    {
      "verse": 17,
      "sanskrit": "वैशम्पायन उवाच।\n              एतच्छ्रुत्वा तु गरुडो वासुदेवस्य भाषितम्। चक्रे मुखसहस्रं हि कामरूपी महाबलः॥१७॥",
      "english": null,
      "bhavadeepa": null,
