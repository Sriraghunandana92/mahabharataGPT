      "combined_translation": "17-17"
    },
    {
      "verse": 18,
      "sanskrit": "गङ्गामुपागमत्तूर्णं वैनतेयो महाबलः। आप्लुत्याकाशगङ्गायामापीय सलिलं बहु॥१८॥",
      "english": null,
      "bhavadeepa": null,
