      "combined_translation": "19-19"
    },
    {
      "verse": 20,
      "sanskrit": "अग्निराहवनीयस्तु ततः शान्तिमुपागमत्। तं दृष्ट्वाऽऽहवनीयं तु शान्तमाकाशगङ्गया। परमं विस्मयं गत्वा सुपर्णो वाक्यमब्रवीत्॥२०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 177,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "युद्धेऽग्निगणापयानंज्वरोत्पत्तिस्तेन कृष्णस्य युद्धं च-१२२",
      "combined_translation": "20-20"
    },
    {
      "verse": 21,
      "sanskrit": "अहो वीर्यमथाग्नेस्तु यो दहेद्युगसङ्क्षये। यदेव वर्णवैरूप्यं चक्रे कृष्णस्य धीमतः॥२१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 177,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "युद्धेऽग्निगणापयानंज्वरोत्पत्तिस्तेन कृष्णस्य युद्धं च-१२२",
      "combined_translation": "21-21"
    },
    {
      "verse": 22,
      "sanskrit": "त्रयस्त्रयाणां लोकानां पर्याप्ता इति मे मतिः। कृष्णः सङ्कर्षणश्चैव प्रद्युम्नश्च महबलः॥२२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 177,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "युद्धेऽग्निगणापयानंज्वरोत्पत्तिस्तेन कृष्णस्य युद्धं च-१२२",
      "combined_translation": "22-22"
    },
    {
      "verse": 23,
      "sanskrit": "ततः प्रशान्ते दहने सम्प्रतस्थे स पक्षिराट्। स्वपक्षबलविक्षेपं कुर्वन्घोरं महास्वनम्॥२३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 177,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "युद्धेऽग्निगणापयानंज्वरोत्पत्तिस्तेन कृष्णस्य युद्धं च-१२२",
      "combined_translation": "23-23"
    },
    {
      "verse": 24,
      "sanskrit": "तं दृष्ट्वा विस्मयं तत्र रुद्रस्यानुचराग्नयः। आस्थिता गरुडं ह्येते नानारूपा भयावहाः॥२४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 177,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "युद्धेऽग्निगणापयानंज्वरोत्पत्तिस्तेन कृष्णस्य युद्धं च-१२२",
      "combined_translation": "24-69"
    },
    {
      "verse": 25,
      "sanskrit": "किमर्थमिह सम्प्राप्ताः के वापीमे जनास्त्रयः। निश्चयं नाधिगच्छन्ति ते गिरिव्रजवह्नयः॥२५॥",
      "english": null,
      "bhavadeepa": "विस्मयं प्रापुरिति शेषः॥२४॥",
      "chapter": 177,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "युद्धेऽग्निगणापयानंज्वरोत्पत्तिस्तेन कृष्णस्य युद्धं च-१२२",
      "combined_translation": "25-25"
    },
    {
      "verse": 26,
      "sanskrit": "प्रावर्तयंश्च सङ्ग्रामं तैस्त्रिभिः सह यादवैः। तेषां युद्धप्रसक्तानां सन्नादः सुमहानभूत्॥२६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 177,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "युद्धेऽग्निगणापयानंज्वरोत्पत्तिस्तेन कृष्णस्य युद्धं च-१२२",
      "english_ref": 1,
      "combined_translation": "1-26"
    },
    {
      "verse": 27,
      "sanskrit": "तं च श्रुत्वा महानादं सिंहानामिव गर्जताम्। अथाङ्गिराः स्वपुरुषं प्रेषयामास बुद्धिमान्॥२७॥",
