      "combined_translation": "18-18"
    },
    {
      "verse": 19,
      "sanskrit": "प्रववर्षोपरि गतो वैनतेयः प्रतापवान्। तेनाग्निं शमयामास बुद्धिमान्विनतात्मजः॥१९॥",
      "english": null,
