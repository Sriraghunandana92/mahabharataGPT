  "adhyaya_name": "युद्धेऽग्निगणापयानंज्वरोत्पत्तिस्तेन कृष्णस्य युद्धं च-१२२",
  "chapter": 177,
  "verse_count": 93,
  "verses": [
    {
      "verse": 1,
      "sanskrit": "वैशम्पायन उवाच।\n              ततस्तूर्यनिनादैश्च शङ्खानां च महास्वनैः। बन्दिमागधसूतानां स्तवैश्चापि सहस्रशः॥१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 177,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "युद्धेऽग्निगणापयानंज्वरोत्पत्तिस्तेन कृष्णस्य युद्धं च-१२२"
    },
    {
      "verse": 2,
      "sanskrit": "स तून्मुखैर्जयाशीर्भिः स्तूयमानो हि मानवैः। बभार रूपं सोमार्कशुक्राणां प्रतिमं तदा॥२॥",
      "english": null,
      "bhavadeepa": "तत इति॥१॥",
      "chapter": 177,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "युद्धेऽग्निगणापयानंज्वरोत्पत्तिस्तेन कृष्णस्य युद्धं च-१२२",
      "combined_translation": "2-2"
    },
    {
      "verse": 3,
      "sanskrit": "अतीव शुशुभे रूपं व्योम्नि तस्योत्पतिष्यतः। वैनतेयस्य भद्रं ते बृंहितं हरितेजसा॥३॥",
      "english": null,
      "bhavadeepa": "स रथस्थः अत एव उन्मुखैरूर्ध्वमुखैः॥२॥",
      "chapter": 177,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "युद्धेऽग्निगणापयानंज्वरोत्पत्तिस्तेन कृष्णस्य युद्धं च-१२२",
      "combined_translation": "3-3"
    },
    {
      "verse": 4,
      "sanskrit": "अथाष्टबाहुः कृष्णास्तु पर्वताकारसन्निभः। विबभौ पुण्डरीकाक्षो विकाङ्क्षन्बाणसङ्क्षयम्॥४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 177,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "युद्धेऽग्निगणापयानंज्वरोत्पत्तिस्तेन कृष्णस्य युद्धं च-१२२",
      "combined_translation": "4-4"
    },
    {
      "verse": 5,
      "sanskrit": "असिचक्रगदाबाणा दक्षिणं पार्श्वमास्थिताः। चर्म शार्ङ्गं तथा चापं शङ्खं चैवास्य वामतः॥५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 177,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "युद्धेऽग्निगणापयानंज्वरोत्पत्तिस्तेन कृष्णस्य युद्धं च-१२२",
      "combined_translation": "5-5"
    },
    {
      "verse": 6,
      "sanskrit": "शीर्षाणां वै सहस्रं तु विहितं शार्ङ्गधन्वना। सहस्रं चैव कायानां वहन्सङ्कर्षणस्तदा॥६॥",
      "english": null,
      "bhavadeepa": "अष्टसु वाहुषु अष्टान्यायुधान्याह- असीति॥५॥",
      "chapter": 177,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "युद्धेऽग्निगणापयानंज्वरोत्पत्तिस्तेन कृष्णस्य युद्धं च-१२२",
      "combined_translation": "6-6"
    },
    {
      "verse": 7,
      "sanskrit": "श्वेतप्रहरणोऽधृष्यः कैलास इव शृङ्गवान्। प्रस्थितो गरुडेनाथ उद्यन्निव दिवाकरः॥७॥",
      "english": null,
      "bhavadeepa": "सहस्रम् अनन्तं शीर्षाणि॥६॥",
      "chapter": 177,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "युद्धेऽग्निगणापयानंज्वरोत्पत्तिस्तेन कृष्णस्य युद्धं च-१२२",
      "combined_translation": "7-7"
    },
    {
      "verse": 8,
      "sanskrit": "सनत्कुमारस्य वपुः प्रादुरासीन्महात्मनः। प्रद्युम्नस्य महाबाहोः सङ्ग्रामे विक्रमिष्यतः॥८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 177,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "युद्धेऽग्निगणापयानंज्वरोत्पत्तिस्तेन कृष्णस्य युद्धं च-१२२",
      "combined_translation": "8-8"
    },
    {
      "verse": 9,
      "sanskrit": "स पक्षबलविक्षेपैर्विधुन्वन्पर्वतान्बहून्। जगाम मार्गं बलवान्वातस्य प्रतिषेधयन्॥९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 177,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "युद्धेऽग्निगणापयानंज्वरोत्पत्तिस्तेन कृष्णस्य युद्धं च-१२२",
      "combined_translation": "9-45"
    },
    {
      "verse": 10,
      "sanskrit": "अथ वायोरतिगतिमास्थाय गरुडस्तदा। सिद्धचारणसङ्घानां शुभं मार्गमवातरत्॥१०॥",
      "english": null,
      "bhavadeepa": "पक्षयोर्बलेन ये विक्षेपास्तैः॥९॥",
      "chapter": 177,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "युद्धेऽग्निगणापयानंज्वरोत्पत्तिस्तेन कृष्णस्य युद्धं च-१२२",
      "combined_translation": "10-145"
    },
    {
      "verse": 11,
      "sanskrit": "अथ रामोऽब्रवीद्वाक्यं कृष्णमप्रतिमं रणे। स्वाभिः प्रभाभिर्हीनाः स्म कृष्ण कस्मादपूर्ववत्॥११॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 177,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "युद्धेऽग्निगणापयानंज्वरोत्पत्तिस्तेन कृष्णस्य युद्धं च-१२२",
      "combined_translation": "11-11"
    },
    {
      "verse": 12,
      "sanskrit": "सर्वे कनकवर्णाभाः संवृत्ताः स्म न संशयः। किमिदं ब्रूहि नस्तत्त्वं किं मेरोः पार्श्वगा वयम्॥१२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 177,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "युद्धेऽग्निगणापयानंज्वरोत्पत्तिस्तेन कृष्णस्य युद्धं च-१२२",
      "combined_translation": "12-12"
    },
    {
      "verse": 13,
      "sanskrit": "श्रीभगवानुवाच\n              मन्ये बाणस्य नगरमभ्यासस्थमरिन्दम। रक्षार्थं तस्य निर्यातो वह्निरेष स्थितो ज्वलन्॥१३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 177,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "युद्धेऽग्निगणापयानंज्वरोत्पत्तिस्तेन कृष्णस्य युद्धं च-१२२",
      "combined_translation": "13-13"
    },
    {
      "verse": 14,
      "sanskrit": "अग्नेराहवनीयस्य प्रभया स्म समाहताः। तेन नो वर्णवैरूप्यमिदं जातं हलायुध॥१४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 177,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "युद्धेऽग्निगणापयानंज्वरोत्पत्तिस्तेन कृष्णस्य युद्धं च-१२२",
      "combined_translation": "14-14"
    },
    {
      "verse": 15,
      "sanskrit": "श्रीराम उवाच।\n              यदि स्म सन्निकर्षस्था यदि निष्प्रभतां गताः। तद्विधत्स्व स्वयं बुद्ध्या यदत्रानन्तरं हितम्॥१५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 177,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "युद्धेऽग्निगणापयानंज्वरोत्पत्तिस्तेन कृष्णस्य युद्धं च-१२२",
      "combined_translation": "15-15"
    },
    {
      "verse": 16,
      "sanskrit": "श्रीभगवानुवाच।\n              कुरुष्व वैनतेय त्वं यच्च कार्यमनन्तरम्। त्वया विधाने विहिते करिष्याम्यहमुत्तमम्॥१६॥",
      "english": null,
      "bhavadeepa": null,
