{
  "adhyaya_id": "P19_U03_A097",
  "book": 19,
  "parva_name": "हरिवंशः",
  "upaparva_name": "भविष्यपर्व",
  "adhyaya_name": "सात्यकिपौण्ड्रकयोर्युद्धम्",
  "chapter": 280,
  "verse_count": 26,
  "verses": [
    {
      "verse": 1,
      "sanskrit": "वैशम्पायन उवाच।\n              ततः क्रुद्धो गदापाणिः सात्यकिर्वृष्णिनन्दनः। वासुदेवं जघानाशु गदया तीक्ष्णया नृप॥१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 280,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "सात्यकिपौण्ड्रकयोर्युद्धम्",
      "combined_translation": "1-39"
    },
    {
      "verse": 2,
      "sanskrit": "सात्यकिं वासुदेवस्तु गदयाभ्यहनद्बली। तावुद्यतगदौ वीरौ शुशुभाते सुदारुणौ॥२॥",
      "english": null,
      "bhavadeepa": "तत इति॥१॥",
      "chapter": 280,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "सात्यकिपौण्ड्रकयोर्युद्धम्",
      "combined_translation": "2-2"
    },
    {
      "verse": 3,
      "sanskrit": "दृप्तौ वने यथा सिंहौ परस्परवधैषिणौ। ततः स सात्यकिः क्रुद्धः सव्यं मण्डलमागमत्॥३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 280,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "सात्यकिपौण्ड्रकयोर्युद्धम्",
      "combined_translation": "3-3"
    },
    {
      "verse": 4,
      "sanskrit": "दक्षिणं वासुदेवस्तु तं जघान स्तनान्तरे। युयुधानोऽथ वीरस्तु बाह्वोर्मध्यमताडयत्॥४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 280,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "सात्यकिपौण्ड्रकयोर्युद्धम्",
      "combined_translation": "4-4"
    },
    {
      "verse": 5,
      "sanskrit": "दृढं स ताडितो वीरो जानुभ्यामपतद्भुवि। तत उत्थाय वीरस्तु ललाटेऽभ्यहनद्गदाम्॥५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 280,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "सात्यकिपौण्ड्रकयोर्युद्धम्",
      "combined_translation": "5-5"
    },
    {
      "verse": 6,
      "sanskrit": "विषण्णः किञ्चिदास्थाय तत उत्थाय सत्वरम्। गदयाभ्यहनद्वीरः सात्यकिः पौण्ड्रसत्तमम्॥६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 280,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "सात्यकिपौण्ड्रकयोर्युद्धम्",
      "combined_translation": "6-6"
    },
    {
      "verse": 7,
      "sanskrit": "वासुदेवो बलिर्वीरः साक्षान्मृत्युरिवापरः। जघान गदया वृष्णिं निर्दहन्निव चक्षुषा॥७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 280,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "सात्यकिपौण्ड्रकयोर्युद्धम्",
      "combined_translation": "7-7"
    },
    {
      "verse": 8,
      "sanskrit": "स तया ताडितो वृष्णिर्गदया बाहुमुक्तया। आलम्ब्य भूमिं सहसा मृत्युरङ्कगतो यथा॥८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 280,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "सात्यकिपौण्ड्रकयोर्युद्धम्",
      "combined_translation": "8-8"
    },
    {
      "verse": 9,
      "sanskrit": "संज्ञां पुनः समालम्ब्य पाणिभ्यां दृढमेव च । गदां तस्य महाराज गृहीत्वा प्रग्रहेण ह॥९॥",
      "english": null,
      "bhavadeepa": "अङ्कगतः समीपं गतः॥८॥",
      "chapter": 280,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "सात्यकिपौण्ड्रकयोर्युद्धम्",
      "combined_translation": "9-9"
    },
    {
      "verse": 10,
      "sanskrit": "द्विधा कृत्वा महागुर्वीं गदां कालायसीं शुभाम्। उत्सृज्य सहसा वीरः सिंहनादं व्यनीनदत्॥१०॥",
      "english": null,
      "bhavadeepa": "प्रग्रहेण परप्रयुक्ताया उत्प्लुत्य प्रग्रहस्तेन॥९॥",
      "chapter": 280,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "सात्यकिपौण्ड्रकयोर्युद्धम्",
      "combined_translation": "10-10"
    },
    {
      "verse": 11,
      "sanskrit": "तत उत्सृज्य राजा तु वासुदेवो महाबलः। सव्येन सात्यकिं गृह्य दक्षिणेन करेण ह॥११॥",
      "english": null,
      "bhavadeepa": "द्विधा कृत्वा वेणुवत् भुङ्क्त्वा॥१०॥",
      "chapter": 280,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "सात्यकिपौण्ड्रकयोर्युद्धम्",
      "combined_translation": "11-11"
    },
    {
      "verse": 12,
      "sanskrit": "मुष्टिं कृत्वा महाघोरं वासुदेवः प्रतापवान्। ताडयामास मध्ये तु स्तनयोः सात्यकेर्नृप॥१२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 280,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "सात्यकिपौण्ड्रकयोर्युद्धम्",
      "combined_translation": "12-12"
    },
    {
      "verse": 13,
      "sanskrit": "शैनेयो वृष्णिवीरस्तु गदामुत्सृज्य सत्वरम्। तलेनाभ्यहनद्वीरो वासुदेवं रणाजिरे॥१३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 280,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "सात्यकिपौण्ड्रकयोर्युद्धम्",
      "combined_translation": "13-13"
    },
    {
      "verse": 14,
      "sanskrit": "तलेन वासुदेवोऽपि सात्यकिं सत्यसङ्गरम्। तयोरेवं महाघोरं तलयुद्धं प्रवर्तत॥१४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 280,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "सात्यकिपौण्ड्रकयोर्युद्धम्",
      "combined_translation": "14-14"
    },
    {
      "verse": 15,
      "sanskrit": "जानुभ्यां मुष्टिभिश्चैव बाहुभ्यां शिरसा तदा। उरसोरः समाहत्य जानुभ्यां जानुनी तथा॥१५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 280,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "सात्यकिपौण्ड्रकयोर्युद्धम्",
      "combined_translation": "15-15"
    },
    {
      "verse": 16,
      "sanskrit": "कराभ्यां करमाहत्य तौ युद्धं सम्प्रचक्रतुः। तालयोस्तत्र राजेन्द्र वृक्षयोः सन्निकर्षयोः॥१६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 280,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "सात्यकिपौण्ड्रकयोर्युद्धम्",
      "combined_translation": "16-16"
    },
    {
      "verse": 17,
      "sanskrit": "वने यथा निरुत्पन्नस्तथैवाभून्महास्वनः। तावाजौ प्रथितौ वीरावुभौ पौण्ड्रकसात्यकी॥१७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 280,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "सात्यकिपौण्ड्रकयोर्युद्धम्",
      "combined_translation": "17-17"
    },
    {
      "verse": 18,
      "sanskrit": "निशि स्तिमितमूकायां शस्त्रं त्यक्त्वा महाबलौ। युयुधाते महारङ्गे मल्लौ द्वाविव विश्रुतौ॥१८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 280,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "सात्यकिपौण्ड्रकयोर्युद्धम्",
      "combined_translation": "18-18"
    },
    {
      "verse": 19,
      "sanskrit": "उभे सेने महाराज्ञोः संशयं जग्मतुस्तदा। किं नु स्यात्सात्यकिर्वीरो हतस्तेन भविष्यति॥१९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 280,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "सात्यकिपौण्ड्रकयोर्युद्धम्",
      "combined_translation": "19-19"
    },
    {
      "verse": 20,
      "sanskrit": "आहोस्विद्वासुदेवस्तु हतस्तेन महात्मना। अद्य वै तौ महावीरौ परस्परवधैषिणौ॥२०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 280,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "सात्यकिपौण्ड्रकयोर्युद्धम्",
      "combined_translation": "20-20"
    },
    {
      "verse": 21,
      "sanskrit": "युध्यमानौ महावीरौ तदा स्वर्गं गमिष्यतः। अन्यथा नोपरम्येतां युद्धाद्वीरौ सुनिश्चितौ॥२१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 280,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "सात्यकिपौण्ड्रकयोर्युद्धम्",
      "combined_translation": "21-21"
    },
    {
      "verse": 22,
      "sanskrit": "अहो वीर्यमहो धैर्यमेतयोर्बलशालिनोः। एतौ महाबलौ लोके एतौ प्रकृतिसत्तमौ॥२२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 280,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "सात्यकिपौण्ड्रकयोर्युद्धम्",
      "combined_translation": "22-22"
    },
    {
      "verse": 23,
      "sanskrit": "नैवं युद्धं महाघोरमासीद्देवासुरेष्वपि। न श्रुतो न च वा दृष्टः सङ्ग्रामोऽयं कदाचन॥२३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 280,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "सात्यकिपौण्ड्रकयोर्युद्धम्",
      "combined_translation": "23-23"
    },
    {
      "verse": 24,
      "sanskrit": "एते वै सैनिका ब्रूयुः सेनयोरुभयोरपि। रात्रौ निशीथे मेघौघे दृष्ट्वा युद्धं सुदारुणम्॥२४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 280,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "सात्यकिपौण्ड्रकयोर्युद्धम्",
      "combined_translation": "24-24"
    },
    {
      "verse": 25,
      "sanskrit": "अथ तौ बाहुभिर्वीरौ सन्निपेततुरञ्जसा। दशभिर्मुष्टिभिर्जघ्ने सात्यकिः पौण्ड्रकं तदा॥२५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 280,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "सात्यकिपौण्ड्रकयोर्युद्धम्",
      "combined_translation": "25-25"
    },
    {
      "verse": 26,
      "sanskrit": "पञ्चभिः सात्यकिं पौण्ड्रः समाजघ्ने महाबलः। तयोश्चटचटाशब्दो ब्रह्माण्डक्षोभणो महान्। प्रादुरासीत्तु सर्वत्र सर्वान्विस्मापयन्निव॥२६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 280,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "सात्यकिपौण्ड्रकयोर्युद्धम्",
