{
  "adhyaya_id": "P19_U02_A088",
  "book": 19,
  "parva_name": "हरिवंशः",
  "upaparva_name": "विष्णुपर्व",
  "adhyaya_name": "जलक्रीडावर्णनम्-०८८",
  "chapter": 143,
  "verse_count": 81,
  "verses": [
    {
      "verse": 1,
      "sanskrit": "जनमेजय उवाच।\n              मुनेऽन्धकवधः श्राव्यः श्रुतोऽयं खलु भो मया। शान्तिस्त्रयाणां लोकानां कृत्वा देवेन धीमता॥१॥",
      "english": null,
      "bhavadeepa": "सोमः उमासहितः॥३९॥",
      "chapter": 143,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "जलक्रीडावर्णनम्-०८८"
    },
    {
      "verse": 2,
      "sanskrit": "निकुम्भस्य हतं देहं द्वितीयं चक्रपाणिना। यदर्थं च यथा चैव तद्भवान्वक्तुमर्हति॥२॥",
      "english": null,
      "bhavadeepa": "अष्टाशीतितमेऽमुष्मिन्नध्याये बलकृष्णयोः। वर्ण्यते च जलक्रीडा विशिष्टा पिण्डतारके॥ मुनेऽन्धकेति। श्राव्यः अवश्यं श्रोतव्यः॥१॥",
      "chapter": 143,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "जलक्रीडावर्णनम्-०८८",
      "combined_translation": "2-2"
    },
    {
      "verse": 3,
      "sanskrit": "वैशम्पायन उवाच।\n              श्रद्दधानस्य राजेन्द्र वक्तव्यं भवतोऽनघ। चरितं लोकनाथस्य हरेरमिततेजसः॥३॥",
      "english": null,
      "bhavadeepa": "निकुम्भस्य त्रिदेहस्य॥२॥",
      "chapter": 143,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "जलक्रीडावर्णनम्-०८८",
      "combined_translation": "3-3"
    },
    {
      "verse": 4,
      "sanskrit": "द्वारवत्यां निवसतो विष्णोरतुलतेजसः। समुद्रयात्रा सम्प्राप्ता तीर्थे पिण्डारके नृप॥४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 143,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "जलक्रीडावर्णनम्-०८८",
      "combined_translation": "4-4"
    },
    {
      "verse": 5,
      "sanskrit": "उग्रसेनो नरपतिर्वसुदेवश्च भारत। निक्षिप्तौ नगराध्यक्षौ शेषाः सर्वे विनिर्गताः॥५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 143,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "जलक्रीडावर्णनम्-०८८",
      "combined_translation": "5-5"
    },
    {
      "verse": 6,
      "sanskrit": "पृथग्बलः पृथग्धीमाँल्लोकनाथो जनार्दनः। गोष्ठ्याः पृथक्कुमाराणां नृदेवामिततेजसाम्॥६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 143,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "जलक्रीडावर्णनम्-०८८",
      "combined_translation": "6-6"
    },
    {
      "verse": 7,
      "sanskrit": "गणिकानां सहस्राणि निःसृतानि नराधिप। कुमारैः सह वार्ष्णेयै रूपवद्भिः स्वलङ्कृतैः॥७॥",
      "english": null,
      "bhavadeepa": "बलो बलरामः॥६॥",
      "chapter": 143,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "जलक्रीडावर्णनम्-०८८",
      "combined_translation": "7-7"
    },
    {
      "verse": 8,
      "sanskrit": "दैत्याधिवासं निर्जित्य यदुभिर्दृढविक्रमैः। वेश्या निवेशिता वीर द्वारवत्यां सहस्रशः॥८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 143,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "जलक्रीडावर्णनम्-०८८",
      "combined_translation": "8-8"
    },
    {
      "verse": 9,
      "sanskrit": "सामान्यास्ताः कुमाराणां क्रीडानार्यो महात्मनाम्। इच्छाभोग्या गुणैरेव राजन्या वेषयोषितः॥९॥",
      "english": null,
      "bhavadeepa": "दैत्याधिवासं समुद्रं निर्जित्य स्वस्थानादवसार्य तत्र निवेशिताः॥८॥",
      "chapter": 143,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "जलक्रीडावर्णनम्-०८८",
      "combined_translation": "9-9"
    },
    {
      "verse": 10,
      "sanskrit": "स्थितिरेषा हि भैमानां कृता कृष्णेन धीमता। स्त्रीनिमित्तं भवेद्वैरं मा यदूनामिति प्रभो॥१०॥",
      "english": null,
      "bhavadeepa": "वेषयोषितः वाराङ्गनाः॥९॥",
      "chapter": 143,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "जलक्रीडावर्णनम्-०८८",
      "combined_translation": "10-10"
    },
    {
      "verse": 11,
      "sanskrit": "रेवत्या चैकया सार्धं बलो रेमेऽनुकूलया। चक्रवाकानुरागेण यदुश्रेष्ठः प्रतापवान्॥११॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 143,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "जलक्रीडावर्णनम्-०८८",
      "combined_translation": "11-11"
    },
    {
      "verse": 12,
      "sanskrit": "कादम्बरीपानकलो भूषितो वनमालया। चिक्रीड सागरजले रेवत्या सहितो बलः॥१२॥",
      "english": null,
      "bhavadeepa": "चक्रवाकयोरिव ययोः अन्योन्यम् अनुरागस्तेन॥११॥",
      "chapter": 143,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "जलक्रीडावर्णनम्-०८८",
      "combined_translation": "12-12"
    },
    {
      "verse": 13,
      "sanskrit": "षोडश स्त्रीसहस्राणि जले जलजलोचनः। रमयामास गोविन्दो विश्वरूपेण सर्वदृक्॥१३॥",
      "english": null,
      "bhavadeepa": "कादम्बरी सुरा तस्याः पानेन कलः विकलः॥१२॥",
      "chapter": 143,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "जलक्रीडावर्णनम्-०८८",
      "combined_translation": "13-13"
    },
    {
      "verse": 14,
      "sanskrit": "अहमिष्टा मया सार्धं जले वसति केशवः। इति ता मेनिरे सर्वा रात्रौ नारायणस्त्रियः॥१४॥",
      "english": null,
      "bhavadeepa": "विश्वरूपेण सर्वरूपात्मना यावन्त्यः स्त्रियस्तावद्भी रूपैरित्यर्थः॥१३॥",
      "chapter": 143,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "जलक्रीडावर्णनम्-०८८",
      "combined_translation": "14-14"
    },
    {
      "verse": 15,
      "sanskrit": "सर्वाः सुरतचिह्नाङ्ग्यः सर्वाः सुरततर्पिताः। मानमूहुश्च ताः सर्वा गोविन्दे बहुमानजम्॥१५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 143,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "जलक्रीडावर्णनम्-०८८",
      "combined_translation": "15-15"
    },
    {
      "verse": 16,
      "sanskrit": "अहमिष्टाहमिष्टेति स्निग्धे परिजने तदा। नारायणस्त्रियः सर्वा मुदा शश्लाघिरे शुभाः॥१६॥",
      "english": null,
      "bhavadeepa": "चिह्नानि नखक्षतानि॥१५॥",
      "chapter": 143,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "जलक्रीडावर्णनम्-०८८",
      "combined_translation": "16-16"
    },
    {
      "verse": 17,
      "sanskrit": "करजद्विजचिह्नानि कुचाधरगतानि ताः। दृष्ट्वा दृष्ट्वा जहृषिरे दर्पणे कमलेक्षणाः॥१७॥",
      "english": null,
      "bhavadeepa": "तदेवाह- अहमिति। शश्लाघिरे आत्मानं प्रशशंसिरे॥१६॥",
      "chapter": 143,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "जलक्रीडावर्णनम्-०८८",
      "combined_translation": "17-17"
    },
    {
      "verse": 18,
      "sanskrit": "गोत्रमुद्दिश्य कृष्णस्य जगिरे कृष्णयोषितः। पिबन्त्य इव कृष्णस्य नयनैर्वदनाम्बुजम्॥१८॥",
      "english": null,
      "bhavadeepa": "करजाः नखाः द्विजाः दन्ताः तज्जानि चिह्नानि॥१७॥",
      "chapter": 143,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "जलक्रीडावर्णनम्-०८८",
      "combined_translation": "18-18"
    },
    {
      "verse": 19,
      "sanskrit": "कृष्णार्पितमनोदृष्ट्यः कान्ता नारायणस्त्रियः। मनोहरतरा राजन्नभवन्नेकनिश्चयाः॥१९॥",
      "english": null,
      "bhavadeepa": "गोत्रं नाम जगिरे गीतं कृतवत्यः॥१८॥",
      "chapter": 143,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "जलक्रीडावर्णनम्-०८८",
      "combined_translation": "19-19"
    },
    {
      "verse": 20,
      "sanskrit": "एकार्पितमनोदृष्ट्यो नेर्ष्यां ताश्चक्रिरेऽङ्गनाः। नारायणेन देवेन तर्प्यमाणमनोरथाः॥२०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 143,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "जलक्रीडावर्णनम्-०८८",
      "combined_translation": "20-20"
    },
    {
      "verse": 21,
      "sanskrit": "शिरांसि गर्वितान्यूहुः सर्वा निरवशेषतः। वाल्लभ्यं केशवमयं वहन्त्यश्चारुदर्शनाः॥२१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 143,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "जलक्रीडावर्णनम्-०८८",
      "combined_translation": "21-21"
    },
    {
      "verse": 22,
      "sanskrit": "ताभिस्तु सह चिक्रीड सर्वाभिर्हरिरात्मवान्। विश्वरूपेण विधिना समुद्रे विमले जले॥२२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 143,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "जलक्रीडावर्णनम्-०८८",
      "combined_translation": "22-22"
    },
    {
      "verse": 23,
      "sanskrit": "उवाह सर्वगन्धाढ्यं स्वच्छं वारि महोदधिः। तोयं विलवणं मृष्टं वासुदेवस्य शासनात्॥२३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 143,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "जलक्रीडावर्णनम्-०८८",
      "combined_translation": "23-23"
    },
    {
      "verse": 24,
      "sanskrit": "गुल्फदघ्नं जानुदघ्नमूरुदघ्नमथापि वा। नार्यस्ताः स्तनदघ्नं वा जलं समभिकाङ्क्षितम्॥२४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 143,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "जलक्रीडावर्णनम्-०८८",
      "combined_translation": "24-24"
    },
    {
      "verse": 25,
      "sanskrit": "सिषिचुः केशवं पत्न्यो धारा इव महोदधिम्। सिषेच ताश्च गोविन्दो मेघः फुल्ललता इव॥२५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 143,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "जलक्रीडावर्णनम्-०८८",
      "combined_translation": "25-25"
    },
    {
      "verse": 26,
      "sanskrit": "अवलम्ब्य पराः कण्ठे हरिं हरिणलोचनाः। उपगूहस्व मां वीर पतामीत्यब्रुवन्स्त्रियः॥२६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 143,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "जलक्रीडावर्णनम्-०८८",
      "combined_translation": "26-26"
    },
    {
      "verse": 27,
      "sanskrit": "काश्चित्काष्ठमयैस्तेरुः प्लवैः सर्वाङ्गशोभनाः। क्रौञ्चबर्हिणनागानामाकारसदृशैः स्त्रियः॥२७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 143,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "जलक्रीडावर्णनम्-०८८",
      "combined_translation": "27-27"
    },
    {
      "verse": 28,
      "sanskrit": "मकराकृतिभिश्चान्या मीनाभैरपि चापराः। बहुरूपाकृतिधरैः पुप्लुवुश्चापराः स्त्रियः॥२८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 143,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "जलक्रीडावर्णनम्-०८८",
      "combined_translation": "28-28"
    },
    {
      "verse": 29,
      "sanskrit": "स्तनकुम्भैस्तथा तेरुः कुम्भैरिव तथापराः। समुद्रसलिले रम्ये हर्षयन्त्यो जनार्दनम्॥२९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 143,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "जलक्रीडावर्णनम्-०८८",
      "combined_translation": "29-29"
    },
    {
      "verse": 30,
      "sanskrit": "रराम सह रुक्मिण्या जले तस्मिन्मुदा युतः। येनैव कार्ययोगेन रमतेऽमरसत्तमः॥३०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 143,
      "parva_name": "हरिवंशः",
