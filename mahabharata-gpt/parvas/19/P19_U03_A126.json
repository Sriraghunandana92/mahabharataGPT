{
  "adhyaya_id": "P19_U03_A126",
  "book": 19,
  "parva_name": "हरिवंशः",
  "upaparva_name": "भविष्यपर्व",
  "adhyaya_name": "हिडिम्बेन साकं वसुदेवोग्रसेनयोर्युद्धं बलभद्रेण हिडिम्बपराभवश्च",
  "chapter": 309,
  "verse_count": 47,
  "verses": [
    {
      "verse": 1,
      "sanskrit": "वैशम्पायन उवाच।\n              वसुदेवोग्रसेनौ च वृद्धौ युद्धे सुनिर्वृतौ। जराजरितसर्वाङ्गौ पलिताङ्गशिरोरुहौ॥१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 309,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हिडिम्बेन साकं वसुदेवोग्रसेनयोर्युद्धं बलभद्रेण हिडिम्बपराभवश्च",
      "combined_translation": "1-28"
    },
    {
      "verse": 2,
      "sanskrit": "ज्ञानविज्ञानसम्पन्नौ राजमार्गविशारदौ। युयुधाते महारङ्गे राक्षसेन दुरात्मना॥२॥",
      "english": null,
      "bhavadeepa": "वसुदेव इति॥१॥",
      "chapter": 309,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हिडिम्बेन साकं वसुदेवोग्रसेनयोर्युद्धं बलभद्रेण हिडिम्बपराभवश्च",
      "combined_translation": "2-2"
    },
    {
      "verse": 3,
      "sanskrit": "शरैरनेकसाहस्रैरर्दयामासतू रणे। राक्षसेन्द्रं दुरात्मानं हिडिम्बं पुरुषादकम्॥३॥",
      "english": null,
      "bhavadeepa": "राजमार्गः क्षत्रधर्मो युद्धाख्यः तत्र विशारदौ॥२॥",
      "chapter": 309,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हिडिम्बेन साकं वसुदेवोग्रसेनयोर्युद्धं बलभद्रेण हिडिम्बपराभवश्च",
      "combined_translation": "3-3"
    },
    {
      "verse": 4,
      "sanskrit": "हिडिम्बो राक्षसेन्द्रस्तु भक्षयन्सर्वतो नरान्। अतिप्रवृद्धो दुष्टात्मा लम्बबाहुर्महाहनुः॥४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 309,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हिडिम्बेन साकं वसुदेवोग्रसेनयोर्युद्धं बलभद्रेण हिडिम्बपराभवश्च"
    },
    {
      "verse": 5,
      "sanskrit": "लम्बोदरो विरूपाक्षः पिङ्गकेशो विलोचनः। श्येननासो महारौद्र ऊर्ध्वरोमा महाभुजः॥५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 309,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हिडिम्बेन साकं वसुदेवोग्रसेनयोर्युद्धं बलभद्रेण हिडिम्बपराभवश्च",
      "combined_translation": "5-5"
    },
    {
      "verse": 6,
      "sanskrit": "पर्वताकारवर्ष्मा च दीर्घदंष्ट्रः शिवाननः। लम्बोदरो दीर्घदन्तो जगद्ग्रासपरस्तथा॥६॥",
      "english": null,
      "bhavadeepa": "विलोचनः विरूपनेत्रः॥५॥",
      "chapter": 309,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हिडिम्बेन साकं वसुदेवोग्रसेनयोर्युद्धं बलभद्रेण हिडिम्बपराभवश्च",
      "combined_translation": "6-6"
    },
    {
      "verse": 7,
      "sanskrit": "उत्तुङ्गांसो महोरस्को दीर्घग्रीवो गजोपमः। भक्षयन्मांसपिटकं पिबञ्शोणितसञ्चयम्॥७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 309,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हिडिम्बेन साकं वसुदेवोग्रसेनयोर्युद्धं बलभद्रेण हिडिम्बपराभवश्च",
      "combined_translation": "7-7"
    },
    {
      "verse": 8,
      "sanskrit": "गजान्नागैः समाहत्य हयैरश्वान्नृपोत्तम। रथान्रथैः समाहत्य सादिनः सादिभिस्तथा॥८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 309,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हिडिम्बेन साकं वसुदेवोग्रसेनयोर्युद्धं बलभद्रेण हिडिम्बपराभवश्च",
      "combined_translation": "8-8"
    },
    {
      "verse": 9,
      "sanskrit": "मनुष्यान्स पुरो दृष्ट्वा नास्यग्रासं चकार सः। कांश्चिद्धत्वा महाराज वृष्णिपालान्समन्ततः॥९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 309,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हिडिम्बेन साकं वसुदेवोग्रसेनयोर्युद्धं बलभद्रेण हिडिम्बपराभवश्च",
      "combined_translation": "9-9"
    },
    {
      "verse": 10,
      "sanskrit": "भक्षयमास सहसा हिडिम्बः पुरुषादकः। यान्पश्यन्पुरतो रक्षस्ताञ्जघान विरूपधृक्॥१०॥",
      "english": null,
      "bhavadeepa": "नास्यग्रासं नासया अत्तुं योग्यं नास्यमिव ग्रसित्वेति नास्यग्रासम्। श्वासोच्छ्वासेन महिषो मशकानिव नासामार्गेण मनुष्यान्सञ्जहारेत्यर्थः॥९॥",
      "chapter": 309,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हिडिम्बेन साकं वसुदेवोग्रसेनयोर्युद्धं बलभद्रेण हिडिम्बपराभवश्च",
      "combined_translation": "10-10"
    },
    {
      "verse": 11,
      "sanskrit": "भक्षयन्नपरान्वृष्णीन्यादवान्राक्षसेश्वरः। चिक्षेप सहसा कांश्चिद्धिडिम्बः पुरुषादकः॥११॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 309,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हिडिम्बेन साकं वसुदेवोग्रसेनयोर्युद्धं बलभद्रेण हिडिम्बपराभवश्च",
      "combined_translation": "11-11"
    },
    {
      "verse": 12,
      "sanskrit": "अन्तकाले यथा क्रुद्धो रुद्रः प्राणभृतो नृप। क्षणेनैकेन सर्वांस्तान्भक्षयामास राक्षसः॥१२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 309,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हिडिम्बेन साकं वसुदेवोग्रसेनयोर्युद्धं बलभद्रेण हिडिम्बपराभवश्च",
      "combined_translation": "12-12"
    },
    {
      "verse": 13,
      "sanskrit": "केचिद्भीता दिशः प्रापुर्वृष्णयो वीर्यशालिनः। केचित्तु भक्षितास्तेन रक्षसा वृष्णिपुङ्गवाः॥१३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 309,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हिडिम्बेन साकं वसुदेवोग्रसेनयोर्युद्धं बलभद्रेण हिडिम्बपराभवश्च",
      "combined_translation": "13-13"
    },
    {
      "verse": 14,
      "sanskrit": "कुम्भकर्णो यथा राजन्भक्षयामस वानरान्। निश्चेष्टं वृष्णिसैन्यं तु स्थितं चित्रपटे यथा॥१४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 309,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हिडिम्बेन साकं वसुदेवोग्रसेनयोर्युद्धं बलभद्रेण हिडिम्बपराभवश्च",
      "combined_translation": "14-14"
    },
    {
      "verse": 15,
      "sanskrit": "एतस्मिन्नन्तरे क्रुद्धौ वृद्धौ यादवपुङ्गवौ। धनुर्गृह्य महाघोरं राक्षसस्य पुरः स्थितौ॥१५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 309,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हिडिम्बेन साकं वसुदेवोग्रसेनयोर्युद्धं बलभद्रेण हिडिम्बपराभवश्च",
      "combined_translation": "15-15"
    },
    {
      "verse": 16,
      "sanskrit": "यथा क्रुद्धस्य सिंहस्य मृगौ वृद्धतमाविव। व्यादायास्यं महारक्षस्तौ वृद्धावभ्यधावत॥१६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 309,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हिडिम्बेन साकं वसुदेवोग्रसेनयोर्युद्धं बलभद्रेण हिडिम्बपराभवश्च",
      "combined_translation": "16-16"
    },
    {
      "verse": 17,
      "sanskrit": "चिखादिषुर्विरूपाक्षः पातालतलसन्निभः। ततो रक्षः पर्यधावत्खादत्खादत्कलेवरम्॥१७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 309,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हिडिम्बेन साकं वसुदेवोग्रसेनयोर्युद्धं बलभद्रेण हिडिम्बपराभवश्च",
      "combined_translation": "17-17"
    },
    {
      "verse": 18,
      "sanskrit": "पूरयामासतुर्वीरौ शरैर्यदुवृषौ नृप। हिडिम्बस्य महाघोरं व्यादितास्यमिवान्तकम्॥१८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 309,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हिडिम्बेन साकं वसुदेवोग्रसेनयोर्युद्धं बलभद्रेण हिडिम्बपराभवश्च",
      "combined_translation": "18-18"
    },
    {
      "verse": 19,
      "sanskrit": "सर्वांस्तान्वारयामास देवशत्रुर्विरूपधृक्। धावति स्म ततो रक्षो व्यादितास्यं भयानकम्॥१९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 309,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हिडिम्बेन साकं वसुदेवोग्रसेनयोर्युद्धं बलभद्रेण हिडिम्बपराभवश्च",
      "combined_translation": "19-19"
    },
    {
      "verse": 20,
      "sanskrit": "तयोर्गृहीत्वा धनुषी बभञ्ज युद्धि सत्वरम्। बाहू प्रसार्य दुष्टात्मा राक्षसो विकृताननः॥२०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 309,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हिडिम्बेन साकं वसुदेवोग्रसेनयोर्युद्धं बलभद्रेण हिडिम्बपराभवश्च",
      "combined_translation": "20-20"
    },
    {
      "verse": 21,
      "sanskrit": "वसुदेवं महीपालं राजानं वृद्धसेविनम्। ग्रहीतुं राक्षसश्रेष्ठो यतते नृपसंसदि॥२१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 309,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हिडिम्बेन साकं वसुदेवोग्रसेनयोर्युद्धं बलभद्रेण हिडिम्बपराभवश्च",
      "combined_translation": "21-21"
    },
    {
      "verse": 22,
      "sanskrit": "हिडिम्ब उवाच।\n              एष वां भक्षयिष्यामि वसुदेवं त्वया सह। उग्रसेन किमर्थं त्वं तिष्ठसे मत्पुरोगमः॥२२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 309,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हिडिम्बेन साकं वसुदेवोग्रसेनयोर्युद्धं बलभद्रेण हिडिम्बपराभवश्च",
      "combined_translation": "22-22"
    },
    {
      "verse": 23,
      "sanskrit": "आगच्छ प्रविशास्यं मे ग्रासभूतौ तु वां मम। विधिना निर्मितो वृद्धो वसुदेवो हरेः पिता॥२३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 309,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हिडिम्बेन साकं वसुदेवोग्रसेनयोर्युद्धं बलभद्रेण हिडिम्बपराभवश्च",
      "combined_translation": "23-23"
    },
    {
      "verse": 24,
      "sanskrit": "बुभुक्षितः श्रमार्तश्च युद्धे त्वरितविक्रमः। मन्मुखान्नैष गच्छेतां प्रविशेतां त्वरान्वितौ॥२४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 309,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हिडिम्बेन साकं वसुदेवोग्रसेनयोर्युद्धं बलभद्रेण हिडिम्बपराभवश्च",
      "combined_translation": "24-24"
    },
    {
      "verse": 25,
      "sanskrit": "युवयोः शोणितं पीत्वा तृप्तिं यास्यामि निर्वृतः। खादामि च पुनर्मांसं वृद्धयोर्युवयोः सुखम्॥२५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 309,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हिडिम्बेन साकं वसुदेवोग्रसेनयोर्युद्धं बलभद्रेण हिडिम्बपराभवश्च",
      "combined_translation": "25-25"
    },
    {
      "verse": 26,
      "sanskrit": "इति ब्रुवंस्तथा रक्षो व्यादितास्यं महाहनुः। धावति स्म तदा क्षिप्रं हिडिम्बो राक्षसेश्वरः॥२६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 309,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हिडिम्बेन साकं वसुदेवोग्रसेनयोर्युद्धं बलभद्रेण हिडिम्बपराभवश्च"
    },
    {
      "verse": 27,
