  "chapter": 114,
  "verse_count": 81,
  "verses": [
    {
      "verse": 1,
      "sanskrit": "वैशम्पायन उवाच।\n              एतस्मिन्नेव काले तु जरासन्धः प्रतापवान्। नृपानुद्योजयामास चेदिराजप्रियेप्सया॥१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 114,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "रुक्मिणीहरणम्-०५९",
      "combined_translation": "1-85"
    },
    {
      "verse": 2,
      "sanskrit": "सुताया भीष्मकस्याथ रुक्मिण्या रुक्मभूषणः। शिशुपालस्य नृपतेर्विवाहो भविता किल॥२॥",
      "english": null,
      "bhavadeepa": "अथैकोनषष्टितमे गत्वा कुण्डिनभोजसा। रामोऽपरान्समासज्य रुक्मिणीमहरद्धरिः॥१॥ एतस्मिन्निति। चेदिराजो दमघोषः तस्य प्रियं शिशुपालाख्यपुत्रस्य विवाहस्तदीप्सया॥१॥",
      "chapter": 114,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "रुक्मिणीहरणम्-०५९",
      "combined_translation": "2-2"
    },
    {
      "verse": 3,
      "sanskrit": "दन्तवक्त्रस्य तनयं सुवक्त्रममितौजसम्। सहस्राक्षसमं युद्धे मायाशतविशारदम्॥३॥",
      "english": null,
      "bhavadeepa": "तदेवाह सुताया- इति॥२॥",
      "chapter": 114,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "रुक्मिणीहरणम्-०५९",
      "combined_translation": "3-3"
    },
    {
      "verse": 4,
      "sanskrit": "पौण्ड्रस्य वासुदेवस्य तथा पुत्रं महाबलम्। सुदेवं वीर्यसम्पन्नं पृथगक्षौहिणीपतिम्॥४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 114,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "रुक्मिणीहरणम्-०५९",
      "combined_translation": "4-4"
    },
    {
      "verse": 5,
      "sanskrit": "एकलव्यस्य पुत्रं च वीर्यवन्तं महाबलम्। पुत्रं च पाण्ड्यराजस्य कलिङ्गाधिपतिं तथा॥५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 114,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "रुक्मिणीहरणम्-०५९",
      "combined_translation": "5-5"
    },
    {
      "verse": 6,
      "sanskrit": "कृताप्रियं च कृष्णेन वैणुदारिं नराधिपम्। अंशुमन्तं तथा क्राथं श्रुतधर्माणमेव च॥६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 114,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "रुक्मिणीहरणम्-०५९",
      "combined_translation": "6-6"
    },
    {
      "verse": 7,
      "sanskrit": "निर्वृत्तशत्रुं कालिङ्गं गान्धाराधिपतिं तथा। प्रसह्य च महावीर्यं कौशाम्ब्यधिपमेव च॥७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 114,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "रुक्मिणीहरणम्-०५९",
      "combined_translation": "7-7"
    },
    {
      "verse": 8,
      "sanskrit": "भगदत्तो महासेनः शलः शाल्वो महाबलः। भूरिश्रवा महासेनः कुन्तिवीर्यश्च वीर्यवान्। स्वयंवरार्थं सम्प्राप्ता भोजराजनिवेशने॥८॥",
      "english": null,
      "bhavadeepa": "निवृत्ताः निष्प्रचाराः शत्रवो यस्य निवृत्तशत्रुं कीलितशत्रुमित्यर्थः॥७॥",
      "chapter": 114,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "रुक्मिणीहरणम्-०५९",
      "combined_translation": "8-8"
    },
    {
      "verse": 9,
      "sanskrit": "जनमेजय उवाच।\n              कस्मिन्देशे नृपो जज्ञे रुक्मी वेदविदां वरः। कस्यान्ववाये द्युतिमान्सम्भूतो द्विजसत्तम॥९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 114,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "रुक्मिणीहरणम्-०५९",
      "combined_translation": "9-9"
    },
    {
      "verse": 10,
      "sanskrit": "वैशम्पायन उवाच।\n              राजर्षेर्यादवस्यासीद्विदर्भो नाम वै सुतः। विन्ध्यस्य दक्षिणे पार्श्वे विदर्भायां न्यवेशयत्॥१०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 114,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "रुक्मिणीहरणम्-०५९",
      "combined_translation": "10-10"
    },
    {
      "verse": 11,
      "sanskrit": "क्रथकैशिकमुख्यास्तु पुत्रास्तस्य महाबलाः। बभूवुर्वीर्यसम्पन्नाः पृथग्वंशकरा नृपाः॥११॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 114,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "रुक्मिणीहरणम्-०५९",
      "combined_translation": "11-11"
    },
    {
      "verse": 12,
      "sanskrit": "तस्यान्ववाये भीमस्य जज्ञिरे वृष्णयो नृपाः। क्रथस्य त्वंशुमान्वंशे भीष्मकः कैशिकस्य तु॥१२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 114,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "रुक्मिणीहरणम्-०५९",
      "combined_translation": "12-12"
    },
    {
      "verse": 13,
      "sanskrit": "हिरण्यरोमेत्याहुर्यं दाक्षिणात्येश्वरं नृपाः। अगस्त्यगुप्तामाशां यः कुण्डिनस्थोऽन्वशान्नृपः॥१३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 114,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "रुक्मिणीहरणम्-०५९",
      "combined_translation": "13-13"
    },
    {
      "verse": 14,
      "sanskrit": "रुक्मी तस्याभवत्पुत्रो रुक्मिणी च विशाम्पते। रुक्मी चास्त्राणि दिव्यानि द्रुमात्प्राप महाबलः॥१४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 114,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "रुक्मिणीहरणम्-०५९",
      "combined_translation": "14-14"
    },
    {
      "verse": 15,
      "sanskrit": "जामदग्न्यात्तथा रामाद्ब्राह्ममस्त्रमवाप्तवान्। प्रास्पर्द्धत स कृष्णेन नित्यमद्भुतकर्मणा॥१५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 114,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "रुक्मिणीहरणम्-०५९",
      "combined_translation": "15-15"
    },
    {
      "verse": 16,
      "sanskrit": "रुक्मिणी त्वभवद्राजन्रूपेणासदृशी भुवि। चक्रमे वासुदेवस्तां श्रवादेव महाद्युतिः॥१६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 114,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "रुक्मिणीहरणम्-०५९",
      "combined_translation": "16-16"
    },
    {
      "verse": 17,
      "sanskrit": "स तथा चाभिलषितः श्रवादेव जनार्दनः। तेजोवीर्यबलोपेतः स मे भर्ता भवेदिति॥१७॥",
      "english": null,
      "bhavadeepa": "श्रवादाकर्णनात्॥१६॥",
      "chapter": 114,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "रुक्मिणीहरणम्-०५९",
      "combined_translation": "17-17"
    },
    {
      "verse": 18,
      "sanskrit": "तां ददौ न च कृष्णाय द्वेषाद्रुक्मी महाबलः। कंसस्य वधसन्तापात्कृष्णायामिततेजसे। याचमानाय कंसस्य द्वेष्योऽयमिति चिन्तयन्॥१८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 114,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "रुक्मिणीहरणम्-०५९",
      "combined_translation": "18-18"
    },
    {
      "verse": 19,
      "sanskrit": "चैद्यस्यार्थे सुनीथस्य जरासन्धस्तु भूमिपः। वरयामास तां राजा भीष्मकं भीमविक्रमम्॥१९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 114,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "रुक्मिणीहरणम्-०५९",
      "combined_translation": "19-19"
    },
    {
      "verse": 20,
      "sanskrit": "चेदिराजस्य तु वसोरासीत्पुत्रो बृहद्रथः। मगधेषु पुरा येन निर्मितोऽसौ गिरिव्रजः॥२०॥",
      "english": null,
      "bhavadeepa": "सुनीथस्य सुनीथपुत्रस्य शिशुपालस्य॥१९॥",
      "chapter": 114,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "रुक्मिणीहरणम्-०५९",
      "combined_translation": "20-20"
    },
    {
      "verse": 21,
      "sanskrit": "तस्यान्ववाये जज्ञेऽसौ जरासन्धो महाबलः। वसोरेव तदा वंशे दमघोषोऽपि चेदिराट्॥२१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 114,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "रुक्मिणीहरणम्-०५९",
      "combined_translation": "21-21"
    },
    {
      "verse": 22,
      "sanskrit": "दमघोषस्य पुत्रास्तु पञ्च भीमपराक्रमाः। भगिन्यां वसुदेवस्य श्रुतश्रवसि जज्ञिरे॥२२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 114,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "रुक्मिणीहरणम्-०५९",
      "combined_translation": "22-22"
    },
    {
      "verse": 23,
      "sanskrit": "शिशुपालो दशग्रीवो रैभ्योऽथोपदिशो बली। सर्वास्त्रकुशला वीरा वीर्यवन्तो महाबलाः॥२३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 114,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "रुक्मिणीहरणम्-०५९",
      "combined_translation": "23-23"
    },
    {
      "verse": 24,
      "sanskrit": "ज्ञातेः समानवंशस्य सुनीथः प्रददौ सुतम्। जरासन्धस्तु सुतवद्ददर्शैनं जुगोप च॥२४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 114,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "रुक्मिणीहरणम्-०५९",
      "combined_translation": "24-24"
    },
    {
      "verse": 25,
      "sanskrit": "जरासन्धं पुरस्कृत्य वृष्णिशत्रुं महाबलम्। कृतान्यागांसि चैद्येन वृष्णीनां चाप्रियैषिणा॥२५॥",
      "english": null,
      "bhavadeepa": "सुनीथः सुतं शिशुपालं ददौ तवायं सहकारी भूयादिति॥२४॥",
      "chapter": 114,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "रुक्मिणीहरणम्-०५९",
      "combined_translation": "25-25"
    },
    {
      "verse": 26,
      "sanskrit": "जामाता त्वभवत्तस्य कंसस्तस्मिन्हते युधि। कृष्णार्थं वैरमभवज्जरासन्धस्य वृष्णिभिः॥२६॥",
      "english": null,
      "bhavadeepa": "वृष्णीनां दुःखदानिति शेषः॥२५॥",
      "chapter": 114,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "रुक्मिणीहरणम्-०५९",
      "combined_translation": "26-26"
    },
    {
      "verse": 27,
      "sanskrit": "भीष्मकं वरयामास सुनीथार्थे च रुक्मिणीम्। तां ददौ भीष्मकश्चापि शिशुपालाय वीर्यवान्॥२७॥",
      "english": null,
      "bhavadeepa": "तत्र निमित्तमाह- जामातेति॥२६॥",
      "chapter": 114,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "रुक्मिणीहरणम्-०५९",
      "combined_translation": "27-27"
    },
    {
      "verse": 28,
      "sanskrit": "ततश्चैद्यमुपादाय जरासन्धो नराधिपः। ययौ विदर्भान्सहितो दन्तवक्त्रेण यायिना॥२८॥",
      "english": null,
      "bhavadeepa": "वरयामास जरासन्धः सुनीथार्थे शिशुपालार्थे॥२७॥",
      "chapter": 114,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "रुक्मिणीहरणम्-०५९",
      "combined_translation": "28-28"
    },
    {
      "verse": 29,
      "sanskrit": "अनुज्ञातश्च पौण्ड्रेण वासुदेवेन धीमता। अङ्गवङ्गकलिङ्गानामीश्वरः स महाबलः॥२९॥",
      "english": null,
      "bhavadeepa": "यायिना गच्छता सह सहायेन वा॥२८॥",
      "chapter": 114,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "रुक्मिणीहरणम्-०५९",
      "combined_translation": "29-29"
    },
    {
      "verse": 30,
      "sanskrit": "मानयिष्यंश्च तान्रुक्मी प्रत्युद्गम्य नराधिपान्। वरया पूजयोपेतांस्तान्निनाय पुरीं प्रति॥३०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 114,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "रुक्मिणीहरणम्-०५९",
      "combined_translation": "30-30"
    },
