  "verse_count": 70,
  "verses": [
    {
      "verse": 1,
      "sanskrit": "वैशम्पायन उवाच।\n              सत्रावसाने च मुनेः कश्यपस्यातितेजसः। जग्मुर्देवासुराः स्वानि स्थानान्यमितविक्रमाः॥१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 151,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "प्रद्युम्नदैत्ययुद्धम्-०९६",
      "combined_translation": "1-40"
    },
    {
      "verse": 2,
      "sanskrit": "वज्रनाभोऽपि निर्वृत्ते सत्रे कश्यपमभ्यगात्। त्रैलोक्यविजयाकाङ्क्षी तमुवाचाथ कश्यपः॥२॥",
      "english": null,
      "bhavadeepa": "सत्रावसान इति॥१॥",
      "chapter": 151,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "प्रद्युम्नदैत्ययुद्धम्-०९६",
      "combined_translation": "2-2"
    },
    {
      "verse": 3,
      "sanskrit": "वज्रनाभ निबोध त्वं श्रोतव्यं यदि चेन्मम। वस वज्रपुरे पुत्र स्वजनेन समावृतः॥३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 151,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "प्रद्युम्नदैत्ययुद्धम्-०९६",
      "combined_translation": "3-3"
    },
    {
      "verse": 4,
      "sanskrit": "तपसाभ्यधिकः शक्रः शक्तश्चैव स्वभावतः। ब्रह्मण्यश्च कृतज्ञश्च ज्येष्ठः श्रेष्ठतमो गुणैः॥४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 151,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "प्रद्युम्नदैत्ययुद्धम्-०९६",
      "combined_translation": "4-4"
    },
    {
      "verse": 5,
      "sanskrit": "राजा कृत्स्नस्य जगतः पात्रभूतः सतां गतिः। सम्प्राप्तो लोकराज्यं स सर्वभूतहिते रतः॥५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 151,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "प्रद्युम्नदैत्ययुद्धम्-०९६",
      "combined_translation": "5-5"
    },
    {
      "verse": 6,
      "sanskrit": "नैव शक्यस्त्वया जेतुं वज्रनाभ विहन्यसे। अहिं पदा व्युत्क्रमन्वै न चिराद्विनशिष्यसि॥६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 151,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "प्रद्युम्नदैत्ययुद्धम्-०९६",
      "combined_translation": "6-6"
    },
    {
      "verse": 7,
      "sanskrit": "वज्रनाभश्च तद्वाक्यं नाभिनन्दति भारत। कालपाशपरीताङ्गो मर्तुकाम इवौषधम्॥७॥",
      "english": null,
      "bhavadeepa": "विहन्यसे म्रियसे॥६॥",
      "chapter": 151,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "प्रद्युम्नदैत्ययुद्धम्-०९६",
      "combined_translation": "7-7"
    },
    {
      "verse": 8,
      "sanskrit": "अभिवाद्य स दुर्बुद्धिः कश्यपं लोकभावनम्। त्रैलोक्यविजयारम्भे मतिं चक्रे दुरासदः॥८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 151,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "प्रद्युम्नदैत्ययुद्धम्-०९६",
      "combined_translation": "8-8"
    },
    {
      "verse": 9,
      "sanskrit": "ज्ञातियोधान्समानीय मित्राणि सुबहूनि च। प्रतस्थे स्वर्गमेवाग्रे विजिगीषन्विशाम्पते॥९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 151,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "प्रद्युम्नदैत्ययुद्धम्-०९६",
      "combined_translation": "9-9"
    },
    {
      "verse": 10,
      "sanskrit": "एतस्मिन्नन्तरे देवौ कृष्णेन्द्रौ च महाबलौ। प्रेषयामासतुर्हंसान्वज्रनाहवधं प्रति॥१०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 151,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "प्रद्युम्नदैत्ययुद्धम्-०९६",
      "combined_translation": "10-10"
    },
    {
      "verse": 11,
      "sanskrit": "समागतास्तु तच्छ्रुत्वा यदुमुख्या महाबलाः। मन्त्रयित्वा महात्मानश्चिन्तामापेदिरे तथा॥११॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 151,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "प्रद्युम्नदैत्ययुद्धम्-०९६",
      "combined_translation": "11-11"
    },
    {
      "verse": 12,
      "sanskrit": "वज्रनाभोऽद्य हन्तव्यः प्रद्युम्नेनेत्यसंशयम्। तयोर्दुहितरो भार्या भक्त्या ताः सर्वभावनाः॥१२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 151,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "प्रद्युम्नदैत्ययुद्धम्-०९६",
      "combined_translation": "12-12"
    },
    {
      "verse": 13,
      "sanskrit": "सर्वाः सगर्भास्ताश्चैव किं नु कार्यमनन्तरम्। प्राप्तः प्रसवकालश्च तासां नातिचिरादिव॥१३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 151,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "प्रद्युम्नदैत्ययुद्धम्-०९६",
      "combined_translation": "13-13"
    },
    {
      "verse": 14,
      "sanskrit": "संमन्त्रयित्वैतदर्थं हंसानूचुर्महाबलाः। आख्येयमर्थवत्कृत्स्नं शक्रकेशवयोस्तदा॥१४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 151,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "प्रद्युम्नदैत्ययुद्धम्-०९६",
      "combined_translation": "14-14"
    },
    {
      "verse": 15,
      "sanskrit": "हंसैर्गत्वा तदाख्यातं देवयोस्तद्यथातथम्। ताभ्यां हंसास्तु सन्दिष्टा न भेतव्यमिति प्रभो॥१५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 151,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "प्रद्युम्नदैत्ययुद्धम्-०९६",
      "combined_translation": "15-15"
    },
    {
      "verse": 16,
      "sanskrit": "उत्पत्स्यन्ति गुणैः श्लाघ्याः पुत्रा वः कामरूपिणः। गर्भस्थाः सर्ववेदांश्च साङ्गान्वेत्स्यन्त्यनिन्दिताः॥१६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 151,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "प्रद्युम्नदैत्ययुद्धम्-०९६",
      "combined_translation": "16-16"
    },
    {
      "verse": 17,
      "sanskrit": "तथा चानागतं सर्वमस्त्राणि विविधानि च। सद्य एव युवानश्च भविष्यन्ति सुपण्डिताः॥१७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 151,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "प्रद्युम्नदैत्ययुद्धम्-०९६",
      "combined_translation": "17-17"
    },
    {
      "verse": 18,
      "sanskrit": "एवमुक्त्वा गता हंसाः पुनर्वज्रपुरं विभो। शशंसुश्चैव भैमानां शक्रकेशवभाषितम्॥१८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 151,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "प्रद्युम्नदैत्ययुद्धम्-०९६",
      "combined_translation": "18-18"
    },
    {
      "verse": 19,
      "sanskrit": "प्रभावती तदा पुत्रं सुषुवे सदृशं पितुः। सद्यो यौवनसम्प्राप्तं सर्वज्ञत्वं च भारत॥१९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 151,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "प्रद्युम्नदैत्ययुद्धम्-०९६",
      "combined_translation": "19-19"
    },
    {
      "verse": 20,
      "sanskrit": "मासमात्रेण सुषुवे देवी चन्द्रवती नृप। चन्द्रप्रभमिति ख्यातं तनयं सदृशं पितुः॥२०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 151,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "प्रद्युम्नदैत्ययुद्धम्-०९६",
      "combined_translation": "20-20"
    },
    {
      "verse": 21,
      "sanskrit": "सद्यश्च यौवनं प्राप्तं सर्वज्ञत्वं च भारत। गुणावत्यपि पुत्रं च गुणवन्तमनिन्दिता॥२१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 151,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "प्रद्युम्नदैत्ययुद्धम्-०९६",
      "combined_translation": "21-21"
    },
    {
      "verse": 22,
      "sanskrit": "युवानावथ सद्यस्तौ सर्वशास्त्रार्थकोविदौ। इन्द्रोपेन्द्रप्रसादेन संवृत्तौ युद्धवर्द्धनौ॥२२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 151,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "प्रद्युम्नदैत्ययुद्धम्-०९६",
      "combined_translation": "22-22"
    },
    {
      "verse": 23,
      "sanskrit": "हर्म्यपृष्ठे वर्द्धमाना दृष्टास्ते यदुनन्दनाः। इन्द्रोपेन्द्रेच्छया वीर नान्यथेत्यवधार्यताम्॥२३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 151,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "प्रद्युम्नदैत्ययुद्धम्-०९६",
      "combined_translation": "23-23"
    },
    {
      "verse": 24,
      "sanskrit": "निवेदिताश्च सम्भ्रान्तैर्दैत्यैराकाशरक्षिभिः। वज्रनाभाय वीराय त्रिविष्टपजयैषिणे॥२४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 151,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "प्रद्युम्नदैत्ययुद्धम्-०९६",
      "combined_translation": "24-24"
    },
    {
      "verse": 25,
      "sanskrit": "वधाय सर्वे गृह्यन्तां ममैते गृहधर्षकाः। इत्युवाचासुरपतिर्वज्रनाभो महासुरः॥२५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 151,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "प्रद्युम्नदैत्ययुद्धम्-०९६",
      "combined_translation": "25-25"
    },
    {
      "verse": 26,
      "sanskrit": "ततः सैन्यं समाज्ञप्तमसुरेन्द्रेण धीमता। आवारयामास दिशः सर्वाः कुरुकुलोद्वह॥२६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 151,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "प्रद्युम्नदैत्ययुद्धम्-०९६",
      "combined_translation": "26-26"
    },
    {
      "verse": 27,
      "sanskrit": "गृह्यतामाशु वध्यन्तामिति वाचस्ततस्ततः। उच्चेरुरसुरेन्द्रस्य शासनादरिशासिनः॥२७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 151,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "प्रद्युम्नदैत्ययुद्धम्-०९६",
      "combined_translation": "27-27"
    },
    {
      "verse": 28,
      "sanskrit": "तच्छ्रुत्वा व्यथितास्तेषां मातरः पुत्रवत्सलाः। रुरुदुस्ता रुदन्तीश्च प्रद्युम्नः प्रहसन्ब्रवीत्॥२८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 151,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "प्रद्युम्नदैत्ययुद्धम्-०९६",
      "combined_translation": "28-28"
    },
    {
      "verse": 29,
      "sanskrit": "मा भैष्ट जीवमानेषु स्थितेष्वस्मासु सर्वथा। किं नो दैत्याः करिष्यन्ति सर्वथा भद्रमस्तु वः॥२९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 151,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "प्रद्युम्नदैत्ययुद्धम्-०९६",
      "combined_translation": "29-29"
    },
    {
      "verse": 30,
      "sanskrit": "प्रभावतीमथोवाच प्रद्युम्नो विप्लवां स्थिताम्। पिता तव गदापाणिः पितृव्याश्च स्थितास्तव॥३०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 151,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "प्रद्युम्नदैत्ययुद्धम्-०९६",
      "combined_translation": "30-30"
    },
    {
      "verse": 31,
      "sanskrit": "भ्रातरश्चैव ते देवि ज्ञातयश्च तथापरे। एते पूज्याश्च मान्याश्च तवार्थे खलु सर्वथा॥३१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 151,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "प्रद्युम्नदैत्ययुद्धम्-०९६",
      "combined_translation": "31-31"
    },
    {
      "verse": 32,
      "sanskrit": "भगिन्यौ पृच्छ भद्रं ते कालोऽयं खलु दारुणः। मरणं सहमानानां युद्ध्यतां विजयो ध्रुवम्॥३२॥",
