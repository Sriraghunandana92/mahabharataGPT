{
  "adhyaya_id": "P19_U02_A090",
  "book": 19,
  "parva_name": "हरिवंशः",
  "upaparva_name": "विष्णुपर्व",
  "adhyaya_name": "भानुमतीहरणं निकुम्भवधश्च-०९०",
  "chapter": 145,
  "verse_count": 78,
  "verses": [
    {
      "verse": 1,
      "sanskrit": "वैशम्पायन उवाच।\n              तेषां क्रीडावसक्तानां यदूनां पुण्यकर्मणाम्। छिद्रमासाद्य दुर्बुद्धिर्देवशत्रुर्दुरासदः॥१॥",
      "english": null,
      "bhavadeepa": "प्रहृष्टरूपस्य सुहृष्टरूपा विनोदिताः केशिनिषूदनेनेत्यपि पाठः॥८८॥",
      "chapter": 145,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "भानुमतीहरणं निकुम्भवधश्च-०९०"
    },
    {
      "verse": 2,
      "sanskrit": "कन्यां भानुमतीं नाम भानोर्दुहितरं नृप। जहारात्मवधाकाङ्क्षी निकुम्भो नाम दानवः॥२॥",
      "english": null,
      "bhavadeepa": "अथास्मिन्नवतितमे ह्यध्याये सन्निरूप्यते। भानुमत्यापहरणं निकुम्भस्य तथा वधः॥१॥ तेषां क्रीडेति॥१॥",
      "chapter": 145,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "भानुमतीहरणं निकुम्भवधश्च-०९०",
      "combined_translation": "2-2"
    },
    {
      "verse": 3,
      "sanskrit": "अन्तर्हितो मोहयित्वा यदूनां प्रमदाजनम्। मायावी मायया राजन्पूर्ववैरमनुस्मरन्॥३॥",
      "english": null,
      "bhavadeepa": "भानोर्यादवविशेषस्य॥२॥",
      "chapter": 145,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "भानुमतीहरणं निकुम्भवधश्च-०९०",
      "combined_translation": "3-3"
    },
    {
      "verse": 4,
      "sanskrit": "भ्रातुर्हि वज्रनाभस्य तस्य कन्या प्रभावती। प्रद्युम्नेन हृता वीर वज्रनाभस्तथा हतः॥४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 145,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "भानुमतीहरणं निकुम्भवधश्च-०९०",
      "combined_translation": "4-4"
    },
    {
      "verse": 5,
      "sanskrit": "भानोरेव तथारण्ये वसत्यवसरेण हि। अस्वाधीने दुराधर्षे छिद्रज्ञो दानवाधमः॥५॥",
      "english": null,
      "bhavadeepa": "पूर्ववैरं प्रपञ्चयति- भ्रातुर्हीति॥४॥",
      "chapter": 145,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "भानुमतीहरणं निकुम्भवधश्च-०९०",
      "combined_translation": "5-5"
    },
    {
      "verse": 6,
      "sanskrit": "कन्यापुरे महानादः सहसा समुपस्थितः। तस्यां ह्रियन्त्यां कन्यायां रुदन्त्यां समितिञ्जयः॥६॥",
      "english": null,
      "bhavadeepa": "प्रस्तुतमाह- भानोरेवेति॥ भानोरेव कन्यापुरे महानाद आर्तरावः। सहसा आकस्मिकः। समुपस्थितः अभ्युत्थितः। कथम्भूते कन्यापुरे दुराधर्षेऽप्यस्वाधीने निरीश्वरे रक्षकाभावात् यदूनां न तु क्रीडासक्तत्वात्। तत्तु नातिचित्रमित्याह- छिद्रज्ञ इति। अवसरेणेत्येनप्प्रत्ययान्तम्। अवसरे दानवाधमो निकुम्भः छिद्रान्वेषी मायया वञ्चनरतो वसति तिष्ठत्येव। क्व अरण्ये द्वारकोपवने इति सार्द्धश्लोको वाक्यम्। ह्रियन्त्यां ह्रियमाणायाम्॥५॥",
      "chapter": 145,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "भानुमतीहरणं निकुम्भवधश्च-०९०",
      "combined_translation": "6-6"
    },
    {
      "verse": 7,
      "sanskrit": "वसुदेवाहुकौ वीरौ दंशितौ निर्गतावुभौ। आर्तनादमुपश्रुत्य भानोः कन्यापुरे तदा॥७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 145,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "भानुमतीहरणं निकुम्भवधश्च-०९०",
      "combined_translation": "7-7"
    },
    {
      "verse": 8,
      "sanskrit": "न दृष्टिगोचरौ तौ तु ददृशातेऽपकारिणम्। तथैव दंशितौ यातौ यत्र कृष्णो महाबलः॥८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 145,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "भानुमतीहरणं निकुम्भवधश्च-०९०",
      "combined_translation": "8-8"
    },
    {
      "verse": 9,
      "sanskrit": "श्रुतार्थः स्वं विमानं तदारुरोह जनार्दनः। पार्थेन सहितस्तार्क्ष्यं नागशत्रुमरिन्दमः॥९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 145,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "भानुमतीहरणं निकुम्भवधश्च-०९०",
      "combined_translation": "9-9"
    },
    {
      "verse": 10,
      "sanskrit": "रथी त्वमनुगच्छेति सन्दिश्य मकरध्वजम्। त्वरेति गरुडं वीरः सन्दिदेश च काश्यपम्॥१०॥",
      "english": null,
      "bhavadeepa": "विमानं वाहनं तर्हि किं सामान्यं न तार्क्ष्यमित्यादि॥९॥",
      "chapter": 145,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "भानुमतीहरणं निकुम्भवधश्च-०९०",
      "combined_translation": "10-10"
    },
    {
      "verse": 11,
      "sanskrit": "वज्रं नगरमायान्तं निकुम्भं रणदुर्जयम्। पार्थकृष्णौ महात्मानावासेदतुररिन्दमौ॥११॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 145,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "भानुमतीहरणं निकुम्भवधश्च-०९०",
      "combined_translation": "11-11"
    },
    {
      "verse": 12,
      "sanskrit": "प्रद्युम्नश्च महातेजा मायिनां प्रवरो नृप। निकुम्भश्चाथ तान्दृष्ट्वा त्रिधाऽऽत्मानमथाकरोत्॥१२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 145,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "भानुमतीहरणं निकुम्भवधश्च-०९०",
      "combined_translation": "12-12"
    },
    {
      "verse": 13,
      "sanskrit": "तान्सर्वान्योधयामास निकुम्भः प्रहसन्निव। बहुकण्टकगुर्वीभिर्गदाभिरमरोपमः॥१३॥",
      "english": null,
      "bhavadeepa": "तान् दानवान्॥१२॥",
      "chapter": 145,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "भानुमतीहरणं निकुम्भवधश्च-०९०",
      "combined_translation": "13-13"
    },
    {
      "verse": 14,
      "sanskrit": "सव्येनालम्ब्य हस्तेन कन्यां भानुमतीं नृपः। दक्षिणेनाथ हस्तेन गदया प्राहरत्पुनः॥१४॥",
      "english": null,
      "bhavadeepa": "तान् कृष्णादीन्॥१३॥",
      "chapter": 145,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "भानुमतीहरणं निकुम्भवधश्च-०९०",
      "combined_translation": "14-14"
    },
    {
      "verse": 15,
      "sanskrit": "कन्यार्थं न च कृष्णो वा कामो वा नृपसत्तमः। निर्दयं प्रहरन्ति स्म निकुम्भे च महासुरे॥१५॥",
      "english": null,
      "bhavadeepa": "भानुमतीं चर्मस्थानीयाम्॥१४॥",
      "chapter": 145,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "भानुमतीहरणं निकुम्भवधश्च-०९०",
      "combined_translation": "15-15"
    },
    {
      "verse": 16,
      "sanskrit": "समर्थास्ते महात्मानः शत्रुं हन्तुं दुरासदाः। निशश्वसुर्नरपते दयाभारावपीडिताः॥१६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 145,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "भानुमतीहरणं निकुम्भवधश्च-०९०",
      "combined_translation": "16-16"
    },
    {
      "verse": 17,
      "sanskrit": "श्रेष्ठो धनुष्मतां पार्थः सर्वथा कुशलो युधि। नागोष्ट्रविधिना दैत्यं शरपङ्क्त्या जघान ह॥१७॥",
      "english": null,
      "bhavadeepa": "निशश्वसुः निश्वासं मुमुचुः॥१६॥",
      "chapter": 145,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "भानुमतीहरणं निकुम्भवधश्च-०९०",
      "combined_translation": "17-17"
    },
    {
      "verse": 18,
      "sanskrit": "ते तु वैतस्तिकैर्बाणैर्विविधान्दानवान्युधि। न कन्यां कलया युक्त्या शिक्षया च महीपते॥१८॥",
      "english": null,
      "bhavadeepa": "नागोष्ट्रविधिनेति। यथा कश्चिद्धनुर्द्धरोऽस्त्रलाघवं दर्शयन् अजगरवेष्टितमुष्ट्रं दृष्ट्वा अस्त्रप्रयोगविशेषादजगरमेव हन्ति न तु क्रमेलकं तद्वत्॥१७॥",
      "chapter": 145,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "भानुमतीहरणं निकुम्भवधश्च-०९०",
      "combined_translation": "18-18"
    },
    {
      "verse": 19,
      "sanskrit": "ततः स कन्यया सार्धं तत्रैवान्तरधीयत। आसुरीमाश्रितो मायां न च तां वेत्ति कश्चन॥१९॥",
      "english": null,
      "bhavadeepa": "ते कृष्णप्रमुखा जघ्नुरिति क्रियाविपरिणामेनानुषङ्गः॥१८॥",
      "chapter": 145,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "भानुमतीहरणं निकुम्भवधश्च-०९०",
      "combined_translation": "19-19"
    },
    {
      "verse": 20,
      "sanskrit": "तं कृष्णो रौक्मिणेयश्च पृष्ठतोऽनुययुस्तदा। हारितः शकुनो भूत्वा तस्थावथ महासुरः॥२०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 145,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "भानुमतीहरणं निकुम्भवधश्च-०९०",
      "combined_translation": "20-20"
    },
    {
      "verse": 21,
      "sanskrit": "तं बाणैः पुनरेवाथ वीरो भूयो धनञ्जयः। वैतस्तिकैर्मर्मभिद्भिः कन्यां रक्षन्नताडयत्॥२१॥",
      "english": null,
      "bhavadeepa": "पृष्ठतोऽव्यवहितावेवानुययतुरित्यर्थः॥२०॥",
      "chapter": 145,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "भानुमतीहरणं निकुम्भवधश्च-०९०",
      "combined_translation": "21-21"
    },
    {
      "verse": 22,
      "sanskrit": "स इमां पृथिवीं कृत्स्नां सप्तद्वीपां महासुरः। बभ्रामानुगतश्चैव तैर्वीरैररिमर्दनः॥२२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 145,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "भानुमतीहरणं निकुम्भवधश्च-०९०",
      "combined_translation": "22-22"
    },
    {
      "verse": 23,
      "sanskrit": "गोकर्णस्योपरिष्टात्तु पर्वतस्य महासुरः। पपात वेलां गङ्गायाः पुलिने सह कन्यया॥२३॥",
      "english": null,
      "bhavadeepa": "अरिमर्दनोऽपि॥२२॥",
      "chapter": 145,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "भानुमतीहरणं निकुम्भवधश्च-०९०",
      "combined_translation": "23-23"
    },
    {
      "verse": 24,
      "sanskrit": "न देवा नासुराश्चापि लङ्घयन्ति तपोधनाः। गोकर्णं तेजसा गुप्तं महादेवस्य भारत॥२४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 145,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "भानुमतीहरणं निकुम्भवधश्च-०९०",
      "combined_translation": "24-24"
    },
    {
      "verse": 25,
      "sanskrit": "एतदन्तरमासाद्य प्रद्युम्नः शीघ्रविक्रमः। कन्यां भानुमतीं भैमो जग्राह रणदुर्जयः॥२५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 145,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "भानुमतीहरणं निकुम्भवधश्च-०९०",
      "combined_translation": "25-25"
    },
    {
      "verse": 26,
      "sanskrit": "असुरः सोऽर्दितो राजन्कृष्णाभ्यां निशितैः शरैः। त्यक्त्वाथोत्तरगोकर्णं निकुम्भो दक्षिणां दिशम्। जगाम पृष्ठतो यातौ कृष्णौ तार्क्ष्यगतौ तदा॥२६॥",
      "english": null,
      "bhavadeepa": "भैमः प्रद्युम्नः॥२५॥",
      "chapter": 145,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "भानुमतीहरणं निकुम्भवधश्च-०९०",
      "combined_translation": "26-26"
    },
