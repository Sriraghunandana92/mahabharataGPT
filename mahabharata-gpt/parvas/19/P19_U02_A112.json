  "verses": [
    {
      "verse": 1,
      "sanskrit": "अर्जुन उवाच।\n              मुहूर्तेन वयं ग्रामं तं प्राप्य भरतर्षभ। विश्रान्तवाहनाः सर्वे निवासायोपसंस्थिताः॥१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 167,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कृष्णस्योदीचीगमनम्-११२",
      "combined_translation": "1-19"
    },
    {
      "verse": 2,
      "sanskrit": "ततो ग्रामस्य मध्येऽहं निविष्टः कुरुनन्दन। समन्ताद्वृष्णिसैन्येन महता परिवारितः॥२॥",
      "english": null,
      "bhavadeepa": "मुहूर्तेनेति॥१॥",
      "chapter": 167,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कृष्णस्योदीचीगमनम्-११२",
      "combined_translation": "2-2"
    },
    {
      "verse": 3,
      "sanskrit": "ततः शकुनयो दीप्ता मृगाश्च क्रूरभाषिणः। दीप्तायां दिशि वाशन्तो भयमावेदयन्ति मे॥३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 167,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कृष्णस्योदीचीगमनम्-११२",
      "combined_translation": "3-3"
    },
    {
      "verse": 4,
      "sanskrit": "सन्ध्यारागो जपावर्णो भानुमांश्चैव निष्प्रभः। पपात महती चोल्का पृथिवी चाप्यकम्पत॥४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 167,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कृष्णस्योदीचीगमनम्-११२",
      "combined_translation": "4-4"
    },
    {
      "verse": 5,
      "sanskrit": "तान्समीक्ष्य महोत्पातान्दारुणाँल्लोमहर्षणान्। योगमाज्ञापयंस्तत्र जनस्योत्सुकचेतसः॥५॥",
      "english": null,
      "bhavadeepa": "जपावर्णः। “पौण्ड्रपुष्पे जपा मता” इति विश्वः। धूसराङ्कुरकुसुमवत् पीतवर्ण इत्यर्थः॥४॥",
      "chapter": 167,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कृष्णस्योदीचीगमनम्-११२",
      "combined_translation": "5-5"
    },
    {
      "verse": 6,
      "sanskrit": "युयुधानपुरोगाश्च वृष्ण्यन्धकमहारथाः। सर्वे युक्तरथाः सज्जाः स्वयं चाहं तथाभवम्॥६॥",
      "english": null,
      "bhavadeepa": "यागसेनायाः सन्नाहम्॥५॥",
      "chapter": 167,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कृष्णस्योदीचीगमनम्-११२",
      "combined_translation": "6-6"
    },
    {
      "verse": 7,
      "sanskrit": "गतेऽर्धरात्रसमये ब्राह्मणो भयविक्लवः। उपागम्य भयादस्मानिदं वचनमब्रवीत्॥७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 167,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कृष्णस्योदीचीगमनम्-११२",
      "combined_translation": "7-7"
    },
    {
      "verse": 8,
      "sanskrit": "कालोऽयं समनुप्राप्तो ब्राह्मण्याः प्रसवस्य मे। तथा भवन्तस्तिष्ठन्तु न भवेद्वञ्चनं यथा॥८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 167,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कृष्णस्योदीचीगमनम्-११२",
      "combined_translation": "8-8"
    },
    {
      "verse": 9,
      "sanskrit": "मुहूर्तादेव चाश्रौषं कृपणं रुदितस्वनम्। तस्य विप्रस्य भवने ह्रियतेऽह्रियतेति च॥९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 167,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कृष्णस्योदीचीगमनम्-११२",
      "combined_translation": "9-9"
    },
    {
      "verse": 10,
      "sanskrit": "अथाकाशे पुनर्वाचमश्रौषं बालकस्य वै। ऊँहेति ह्रियमाणस्य न च पश्यामि राक्षसम्॥१०॥",
      "english": null,
      "bhavadeepa": "ह्रियते शिशुः अह्रियत हृत इति॥९॥",
      "chapter": 167,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कृष्णस्योदीचीगमनम्-११२",
      "combined_translation": "10-10"
    },
    {
      "verse": 11,
      "sanskrit": "ततोऽस्माभिस्तदा तात शरवर्षैः समन्ततः। विष्टम्भिता दिशः सर्वा हृत एव स बालकः॥११॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 167,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कृष्णस्योदीचीगमनम्-११२",
      "combined_translation": "11-11"
    },
    {
      "verse": 12,
      "sanskrit": "ब्राह्मणोऽऽर्तस्वरं कृत्वा हृते तस्मिन्कुमारके। वाचः स परुषास्तीव्राः श्रावयामास मां तदा॥१२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 167,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कृष्णस्योदीचीगमनम्-११२",
      "combined_translation": "12-12"
    },
    {
      "verse": 13,
      "sanskrit": "वृष्णयो हतसङ्कल्पास्तथाहं नष्टचेतनः। मामेवं हि विशेषेण ब्राह्मणः प्रत्यभाषत॥१३॥",
      "english": null,
      "bhavadeepa": "आर्तेति छेदः। सन्धिरार्षः॥१२॥",
      "chapter": 167,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कृष्णस्योदीचीगमनम्-११२",
      "combined_translation": "13-13"
    },
    {
      "verse": 14,
      "sanskrit": "रक्षिष्यामीति चोक्तं ते न च रक्षितवानसि। शृणु वाक्यमिदं शेषं यत्त्वमर्हसि दुर्मते॥१४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 167,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कृष्णस्योदीचीगमनम्-११२",
      "combined_translation": "14-14"
    },
    {
      "verse": 15,
      "sanskrit": "वृथा त्वं स्पर्धसे नित्यं कृष्णेनामितबुद्धिना। यदि स्यादिह गोविन्दो नैतदत्याहितं भवेत्॥१५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 167,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कृष्णस्योदीचीगमनम्-११२",
      "combined_translation": "15-15"
    },
    {
      "verse": 16,
      "sanskrit": "यथा चतुर्थं धर्मस्य रक्षिता लभते फलम्। पापस्यापि तथा मूढ भागं प्राप्नोत्यरक्षिता॥१६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 167,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कृष्णस्योदीचीगमनम्-११२",
      "combined_translation": "16-16"
    },
    {
      "verse": 17,
      "sanskrit": "रक्षिष्यामीति चोक्तं ते न च शक्तोऽसि रक्षितुम्। मोघं गाण्डीवमेतत्ते मोघं वीर्यं यशश्च ते॥१७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 167,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कृष्णस्योदीचीगमनम्-११२",
      "combined_translation": "17-17"
    },
    {
      "verse": 18,
      "sanskrit": "अकिञ्चिदुक्त्वा तं विप्रं ततोऽहं प्रस्थितस्तथा। सह वृष्ण्यन्धकसुतैर्यत्र कृष्णो महाद्युतिः॥१८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 167,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कृष्णस्योदीचीगमनम्-११२",
      "combined_translation": "18-18"
    },
    {
      "verse": 19,
      "sanskrit": "ततो द्वारवतीं गत्वा दृष्ट्वा मधुनिघातिनम्। व्रीडितः शोकसन्तप्तो गोविन्देनोपलक्षितः॥१९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 167,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कृष्णस्योदीचीगमनम्-११२",
      "combined_translation": "19-102"
    },
    {
      "verse": 20,
      "sanskrit": "स तु मां व्रीडितं दृष्ट्वा विनिन्दन्कृष्णसन्निधौ। मौढ्यं पश्यत मे योऽहं श्रद्दधे क्लीबकत्थनम्॥२०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 167,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कृष्णस्योदीचीगमनम्-११२",
      "combined_translation": "20-20"
    },
    {
      "verse": 21,
      "sanskrit": "न प्रद्युम्नो नानिरुद्धो न रामो न च केशवः। यत्र शक्ताः परित्रातुं कोऽन्यस्तदवनेश्वरः॥२१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 167,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कृष्णस्योदीचीगमनम्-११२",
      "combined_translation": "21-21"
    },
    {
      "verse": 22,
      "sanskrit": "धिगर्जुनं वृथानादं धिगात्मश्लाघिनो धनुः। दैवोपसृष्टो यो मौर्ख्यादागच्छति च दुर्मतिः॥२२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 167,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कृष्णस्योदीचीगमनम्-११२",
      "combined_translation": "22-22"
    },
    {
      "verse": 23,
      "sanskrit": "एवं शपति विप्रर्षौ विद्यामास्थाय वैष्णवीम्। ययौ संयमनीं वीरो यत्रास्ते भगवान्यमः॥२३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 167,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कृष्णस्योदीचीगमनम्-११२",
      "combined_translation": "23-23"
    },
    {
      "verse": 24,
      "sanskrit": "विप्रापत्यमचक्षाणस्तत ऐन्द्रीमगात्पुरीम्। आग्नेयीं नैर्ऋतीं सौम्यामुदीचीं वारुणीं तथा॥२४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 167,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कृष्णस्योदीचीगमनम्-११२",
      "combined_translation": "24-24"
    },
    {
      "verse": 25,
      "sanskrit": "रसातलं नाकपृष्ठं धिष्ण्यान्यन्यान्युदायुधः। ततोऽलब्ध्वा द्विजसुतमनिस्तीर्णप्रतिश्रवः॥२५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 167,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कृष्णस्योदीचीगमनम्-११२",
      "english_ref": 1,
      "combined_translation": "1-25"
    },
    {
      "verse": 26,
      "sanskrit": "अग्निं विविक्षुः कृष्णेन प्रद्युम्नेन निषेधितः। दर्शये द्विजसूनुं ते मावज्ञात्मानमात्मना॥२६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 167,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कृष्णस्योदीचीगमनम्-११२"
    },
    {
      "verse": 27,
      "sanskrit": "कीर्तिं न एते विपुलां स्थापयिष्यन्ति मानवाः। इति सम्भाष्य मां स्नेहात्समाश्वास्य च माधवः॥२७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 167,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कृष्णस्योदीचीगमनम्-११२"
    },
    {
      "verse": 28,
      "sanskrit": "सान्त्वयित्वा तु तं विप्रमिदं वचनमब्रवीत्। सुग्रीवं चैव शैब्यं च मेघपुष्पबलाहकौ॥२८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 167,
      "parva_name": "हरिवंशः",
