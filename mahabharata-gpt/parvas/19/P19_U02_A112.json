    },
    {
      "verse": 29,
      "sanskrit": "योजयाश्वानिति तदा दारुकं प्रत्यभाषत। आरोप्य ब्राह्मणं कृष्णो ह्यवरोप्य च दारुकम्॥२९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 167,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "कृष्णस्योदीचीगमनम्-११२"
    },
    {
      "verse": 30,
      "sanskrit": "मामुवाच ततः शौरिः सारथ्यं क्रियतामिति। ततः समास्थाय रथं कृष्णोऽहं ब्राह्मणः स च। प्रयाताः स्म दिशं सौम्यामुदीचीं कौरवर्षभ॥३०॥",
      "english": null,
      "bhavadeepa": "आरोप्य रथ इति शेषः॥२९॥",
