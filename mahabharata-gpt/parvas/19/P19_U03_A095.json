  "adhyaya_name": "सात्यकिपौण्ड्रकयोः संवादः",
  "chapter": 278,
  "verse_count": 41,
  "verses": [
    {
      "verse": 1,
      "sanskrit": "वैशम्पायन उवाच।\n              निवृत्तेष्वथ सैन्येषु वृष्णिवीरेषु चैव हि। भीतेष्वथ महाराज हतेषु युधि सर्वतः॥१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 278,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "सात्यकिपौण्ड्रकयोः संवादः",
      "combined_translation": "1-34"
    },
    {
      "verse": 2,
      "sanskrit": "दीपिकासु प्रशान्तासु निःशब्दे सति सर्वतः। जितमित्येव यन्मत्वा वृष्णीनां बलमुत्तमम्॥२॥",
      "english": null,
      "bhavadeepa": "निवृत्तेष्विति॥१॥",
      "chapter": 278,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "सात्यकिपौण्ड्रकयोः संवादः",
      "combined_translation": "2-2"
    },
    {
      "verse": 3,
      "sanskrit": "ततः पौण्ड्रो महावीर्यो बभाषे सैनिकान्स्वकान्। शीघ्रं गच्छत राजेन्द्राष्टङ्कैः कुन्तैः पुरीमिमाम्॥३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 278,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "सात्यकिपौण्ड्रकयोः संवादः",
      "combined_translation": "3-3"
    },
    {
      "verse": 4,
      "sanskrit": "कुठारैः कुन्तलैश्चैव पाषाणैः सर्वतोदिशम्। कर्षणस्थैः सुपाषाणैः सर्वतो यात भूमिपाः॥४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 278,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "सात्यकिपौण्ड्रकयोः संवादः",
      "combined_translation": "4-4"
    },
    {
      "verse": 5,
      "sanskrit": "भिद्यन्तां प्राकारचया प्रासादाश्च समन्ततः। गृह्यन्तां कन्यकाः सर्वा दास्यश्चैव समन्ततः॥५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 278,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "सात्यकिपौण्ड्रकयोः संवादः",
      "combined_translation": "5-5"
    },
    {
      "verse": 6,
      "sanskrit": "गृह्यन्तां वसुमुख्यानि धनानि सुबहून्यथ। ते तथेति महात्मानो राजानः सर्व एव तु॥६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 278,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "सात्यकिपौण्ड्रकयोः संवादः",
      "combined_translation": "6-6"
    },
    {
      "verse": 7,
      "sanskrit": "कुठारैः सर्वतश्चैव चिच्छिदुः पौण्ड्रकाज्ञया। प्राकारांश्चैव सर्वत्र प्रासादान्नरसञ्चयान्॥७॥",
      "english": null,
      "bhavadeepa": "वसुमुख्यानि रत्नानि॥६॥",
      "chapter": 278,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "सात्यकिपौण्ड्रकयोः संवादः",
      "combined_translation": "7-7"
    },
    {
      "verse": 8,
      "sanskrit": "अथ तत्र महाशब्दः प्रादुरासीत्समन्ततः। टङ्केषु पात्यमानेषु प्राकारेषु महाबलैः॥८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 278,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "सात्यकिपौण्ड्रकयोः संवादः",
      "combined_translation": "8-8"
    },
    {
      "verse": 9,
      "sanskrit": "पूर्वद्वारे महाराज भिन्नाः प्राकारसञ्चयाः। श्रुत्वा शब्दं महाघोरं सात्यकिः क्रोधमूर्च्छितः॥९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 278,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "सात्यकिपौण्ड्रकयोः संवादः",
      "combined_translation": "9-9"
    },
    {
      "verse": 10,
      "sanskrit": "मयि सर्वं समारोप्य केशवो यादवेश्वरः। गतः कैलासशिखरं द्रष्टुं शङ्करमव्ययम्॥१०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 278,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "सात्यकिपौण्ड्रकयोः संवादः",
      "combined_translation": "10-10"
    },
    {
      "verse": 11,
      "sanskrit": "अवश्यं हि मया रक्ष्या पुरी द्वारवती त्वियम्। इति सञ्चिन्त्य मनसा धनुरादाय सत्वरम्॥११॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 278,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "सात्यकिपौण्ड्रकयोः संवादः",
      "combined_translation": "11-11"
    },
    {
      "verse": 12,
      "sanskrit": "रथं महान्तमारुह्य दारुकस्य महात्मनः। पुत्रेण संस्कृतं घोरं यन्ता च स्वयमेव हि॥१२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 278,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "सात्यकिपौण्ड्रकयोः संवादः",
      "combined_translation": "12-12"
    },
    {
      "verse": 13,
      "sanskrit": "धनुर्महत्तदादाय शरांश्चाशीविषोपमान्। आमुच्य कवचं घोरं शस्त्रसम्पातदुःसहम्॥१३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 278,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "सात्यकिपौण्ड्रकयोः संवादः",
      "combined_translation": "13-13"
    },
    {
      "verse": 14,
      "sanskrit": "अङ्गदी कुण्डली तूणी शरी चापी गदासिमान्। ययौ युद्धाय शैनेयः संस्मरन्कैशवं वचः॥१४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 278,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "सात्यकिपौण्ड्रकयोः संवादः",
      "combined_translation": "14-14"
    },
    {
      "verse": 15,
      "sanskrit": "दीपिकादीपिते देशे ययौ सात्यकिरुत्तमः। तथैव बलदेवोऽपि रथमारुह्य भास्वरम्॥१५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 278,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "सात्यकिपौण्ड्रकयोः संवादः",
      "combined_translation": "15-15"
    },
    {
      "verse": 16,
      "sanskrit": "गदी शरी महावीर्यः प्रायाद्रणचिकीर्षया। सिंहनादं प्रकुर्वन्तो मुञ्चन्तो भैरवं रवम्॥१६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 278,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "सात्यकिपौण्ड्रकयोः संवादः",
      "combined_translation": "16-16"
    },
    {
      "verse": 17,
      "sanskrit": "उद्धवोऽपि बली साक्षाद्गजमारुह्य सत्वरम्। मत्तं महारवं घोरां सङ्ग्रामे नीतिमत्तरम्॥१७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 278,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "सात्यकिपौण्ड्रकयोः संवादः",
      "combined_translation": "17-17"
    },
    {
      "verse": 18,
      "sanskrit": "ययौ नीतिं विचिन्वानः परां प्रीतिं महाबलः। अन्ये च वृष्णयः सर्वे ययुः सङ्ग्रामलालसाः॥१८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 278,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "सात्यकिपौण्ड्रकयोः संवादः",
      "combined_translation": "18-18"
    },
    {
      "verse": 19,
      "sanskrit": "रथान्गजान्समारुह्य हार्दिक्यप्रमुख्यास्तथा। दीपिकाभिश्च सर्वत्र पुरोवृत्ताभिरीश्वराः॥१९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 278,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "सात्यकिपौण्ड्रकयोः संवादः",
      "combined_translation": "19-19"
    },
    {
      "verse": 20,
      "sanskrit": "सिंहनादं प्रकुर्वन्तः स्मरन्तः केशवं वचः। पूर्वद्वारं समागम्य वृष्णयो युद्धलालसाः॥२०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 278,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "सात्यकिपौण्ड्रकयोः संवादः",
      "combined_translation": "20-20"
    },
    {
      "verse": 21,
      "sanskrit": "ते समेत्य यथायोगं स्थितास्तत्र महाबलाः। स्थिते सैन्ये महाघोरे दीपिकादीपिते पथि॥२१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 278,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "सात्यकिपौण्ड्रकयोः संवादः",
      "combined_translation": "21-21"
    },
    {
      "verse": 22,
      "sanskrit": "शिनिर्वीरः शरी चापी गदी तूणीरवान्विभो। वायव्यास्त्रं समादाय योजयित्वा महाशरम्॥२२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 278,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "सात्यकिपौण्ड्रकयोः संवादः",
      "combined_translation": "22-22"
    },
    {
      "verse": 23,
      "sanskrit": "आकर्णं पूर्णमाकृष्य धनुः प्रवरमुत्तमम्। मुमोच परसैन्येषु शिनिर्वीरः प्रतापवान्॥२३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 278,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "सात्यकिपौण्ड्रकयोः संवादः",
      "combined_translation": "23-23"
    },
    {
      "verse": 24,
      "sanskrit": "वायव्यास्त्रेण ते सर्वे तत्रस्था नरसत्तमाः। विजिता ह्यस्त्रवीर्येण यत्र तिष्ठति पौण्ड्रकः॥२४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 278,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "सात्यकिपौण्ड्रकयोः संवादः",
      "combined_translation": "24-24"
    },
    {
      "verse": 25,
      "sanskrit": "तत्र गत्वा स्थिताः सर्वे निर्धूता वातरंहसा। यत्र पूर्वं स्थिताः सर्वे विद्रुता राजसत्तमाः॥२५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 278,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "सात्यकिपौण्ड्रकयोः संवादः",
      "combined_translation": "25-25"
    },
    {
      "verse": 26,
      "sanskrit": "तत्र स्थित्वा च शैनेयः शरमादाय सत्वरम्। निशितं सर्पभोगाभं बभाषे सात्यकिस्तदा॥२६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 278,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "सात्यकिपौण्ड्रकयोः संवादः",
      "combined_translation": "26-26"
    },
    {
      "verse": 27,
      "sanskrit": "क्व इदानीं महाबुद्धिः पौण्ड्रको राजसत्तमः। स्थितोऽस्ति व्यवसायेन शरी चापी महाबलः॥२७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 278,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "सात्यकिपौण्ड्रकयोः संवादः",
      "combined_translation": "27-27"
    },
    {
      "verse": 28,
      "sanskrit": "यदि द्रष्टा दुरात्मानं ततो हन्ता नृपाधमम्। भृत्योऽस्मि केशवस्याहं जिघांसुः पौण्ड्रकं शितः॥२८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 278,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "सात्यकिपौण्ड्रकयोः संवादः",
      "combined_translation": "28-28"
    },
    {
      "verse": 29,
      "sanskrit": "छित्त्वा शिरस्तु तस्यास्य सर्वक्षत्रस्य पश्यतः। बलिं दास्यामि गृध्रेभ्यः श्वभ्यश्चैव दुरात्मनः॥२९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 278,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "सात्यकिपौण्ड्रकयोः संवादः",
      "combined_translation": "29-29"
    },
    {
      "verse": 30,
      "sanskrit": "को नाम ईदृशं कर्म चौरवच्च समाचरेत्। सुप्तेषु निशि सर्वत्र यादवेषु महात्मसु॥३०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 278,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "सात्यकिपौण्ड्रकयोः संवादः",
      "combined_translation": "30-30"
    },
    {
      "verse": 31,
      "sanskrit": "चौरोऽयं सर्वथा राजा न हि राजा बलान्वितः। यदि शक्तो न कुर्याच्च चौर्यमेवं नृपाधमः॥३१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 278,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "सात्यकिपौण्ड्रकयोः संवादः",
      "combined_translation": "31-31"
    },
    {
      "verse": 32,
      "sanskrit": "अहोऽस्य बलिनो राज्ञश्चौरकार्यं प्रकुर्वतः। सर्वथागमनं तस्य न हि पश्यामि साम्प्रतम्॥३२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 278,
