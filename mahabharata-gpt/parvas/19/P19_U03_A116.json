      "sanskrit": "असिना वाथ दास्यामि निशितेन महात्मनोः। शिरो वा छेत्स्यते चक्रं मत्करप्रहितं बलिम्॥३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 299,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णस्य प्रतिसन्देशः",
      "combined_translation": "3-3"
    },
    {
      "verse": 4,
      "sanskrit": "यो वरं दत्तवान्रुद्रो युवयोर्धार्ष्ट्यकारणम्। स एव रक्षिता वां स्यात्तं जित्वा वां निहन्म्यहम्॥४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 299,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णस्य प्रतिसन्देशः",
      "combined_translation": "4-4"
    },
