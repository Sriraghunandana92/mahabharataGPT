{
  "adhyaya_id": "P19_U02_A065",
  "book": 19,
  "parva_name": "हरिवंशः",
  "upaparva_name": "विष्णुपर्व",
  "adhyaya_name": "पारिजातनिबन्धनः सत्याकोपः-०६५",
  "chapter": 120,
  "verse_count": 55,
  "verses": [
    {
      "verse": 1,
      "sanskrit": "जनमेजय उवाच।\n              प्रादुर्भावे मुनिश्रेष्ठ माथुरे चरितं शुभम्। शृण्वन्नैवाधिगच्छामि तृप्तिं कृष्णस्य धीमतः॥१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 120,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पारिजातनिबन्धनः सत्याकोपः-०६५"
    },
    {
      "verse": 2,
      "sanskrit": "द्वारकायां निवसतः कृतदारस्य षड्गुणम्। चरितं ब्रूहि कृष्णस्य सर्वं हि विदितं तव॥२॥",
      "english": null,
      "bhavadeepa": "पञ्चषष्टितमेऽध्याये द्युतरोः पुष्पमर्थिनी। रुक्मिणी हरिणा श्रुत्वा रुष्टा सत्येति वर्ण्यते॥ प्रादुर्भाव इति॥१॥",
      "chapter": 120,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पारिजातनिबन्धनः सत्याकोपः-०६५",
      "combined_translation": "2-2"
    },
    {
      "verse": 3,
      "sanskrit": "वैशम्पायन उवाच।\n              जनमेजय कृष्णस्य कृतदारस्य भारत। निबोध चरितं चित्रं तस्यैव सदृशं प्रभो॥३॥",
      "english": null,
      "bhavadeepa": "षड्गुणम्- “ऐश्वर्यस्य समग्रस्य ज्ञानस्य यशसः श्रियः। वैराग्यस्य च धर्मस्य षण्णां भग इतीरणा॥” इति षड्विधैश्वर्यमुक्तम्। यद्वा षडङ्गानि च। “सर्वज्ञता तृप्तिरनादिबोधः स्वतन्त्रता नित्यमलुप्तशक्तिः। अनन्तशक्तिश्च विभोर्विभुज्ञाः षडाहुरङ्गानि महेश्वरस्य॥” इति वायुपुराणोक्तानि॥२॥",
      "chapter": 120,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पारिजातनिबन्धनः सत्याकोपः-०६५",
      "combined_translation": "3-3"
    },
    {
      "verse": 4,
      "sanskrit": "प्राप्तदारो महातेजा वासुदेवः प्रतापवान्। रुक्मिण्या सहितो देव्या ययौ रैवतकं नृप॥४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 120,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पारिजातनिबन्धनः सत्याकोपः-०६५",
      "combined_translation": "4-4"
    },
    {
      "verse": 5,
      "sanskrit": "उपवासावसानं हि रुक्मिण्याः प्रतिपूजयन्। तर्पयिष्यन्स्वयं विप्राञ्जगाम मधुसूदनः॥५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 120,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पारिजातनिबन्धनः सत्याकोपः-०६५",
      "combined_translation": "5-5"
    },
    {
      "verse": 6,
      "sanskrit": "कुमाराः प्रययुस्तत्र पुत्रभ्रातर एव च। प्रेषिता वासुदेवेन नारदस्याभ्यनुज्ञया॥६॥",
      "english": null,
      "bhavadeepa": "अवसानं व्रतपारणाम्॥५॥",
      "chapter": 120,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पारिजातनिबन्धनः सत्याकोपः-०६५",
      "combined_translation": "6-6"
    },
    {
      "verse": 7,
      "sanskrit": "षोडश स्त्रीसहस्राणि जग्मुरेव च धीमतः। ऋद्ध्या परमया राजन्विष्णोरेवानुरूपया॥७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 120,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पारिजातनिबन्धनः सत्याकोपः-०६५",
      "combined_translation": "7-7"
    },
    {
      "verse": 8,
      "sanskrit": "ततस्तत्र द्विजातीनां कामान्प्रादादधोक्षजः। अर्थिनां धर्मनित्यानां बन्दिनामिष्टवादिनाम्॥८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 120,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पारिजातनिबन्धनः सत्याकोपः-०६५",
      "combined_translation": "8-8"
    },
    {
      "verse": 9,
      "sanskrit": "कल्याणनामगोत्राणां महतां पुण्यकर्मणाम्। यौनैः श्रौतैश्च माखैश्च शुद्धानां कुरुनन्दनः॥९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 120,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पारिजातनिबन्धनः सत्याकोपः-०६५",
      "combined_translation": "9-9"
    },
    {
      "verse": 10,
      "sanskrit": "तर्पयित्वा द्विजान्कामैरिष्टैरिष्टः सतां गतिः। ज्ञातीन्सन्तर्पयामास यथार्हं भक्तवत्सलः॥१०॥",
      "english": null,
      "bhavadeepa": "यौनैः योनिसम्बन्धैः श्रौतैः अध्ययनसम्बन्धैर्माखैः आर्त्विज्यसम्बन्धैः॥९॥",
      "chapter": 120,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पारिजातनिबन्धनः सत्याकोपः-०६५",
      "combined_translation": "10-10"
    },
    {
      "verse": 11,
      "sanskrit": "उपवासावसानेऽथ भगवान्स विशेषतः। बहु मेने प्रियां भार्यां रुक्मिणीं भीष्मकात्मजाम्॥११॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 120,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पारिजातनिबन्धनः सत्याकोपः-०६५",
      "combined_translation": "11-11"
    },
    {
      "verse": 12,
      "sanskrit": "वसतस्तस्य कृष्णस्य सदारस्यामितौजसः। सहासीनस्य रुक्मिण्या नारदोऽभ्याययौ मुनिः॥१२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 120,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पारिजातनिबन्धनः सत्याकोपः-०६५",
      "combined_translation": "12-12"
    },
    {
      "verse": 13,
      "sanskrit": "आगतं चाप्रमेयात्मा मुनिमिन्द्रानुजस्तदा। शास्त्रदृष्टेन विधिना अर्चयामास केशवः॥१३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 120,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पारिजातनिबन्धनः सत्याकोपः-०६५",
      "combined_translation": "13-13"
    },
    {
      "verse": 14,
      "sanskrit": "सोऽर्चितो वासुदेवेन मुनिरर्च्य तमः सताम्। पारिजाततरोः पुष्पं ददौ कृष्णाय भारत॥१४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 120,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पारिजातनिबन्धनः सत्याकोपः-०६५",
      "combined_translation": "14-14"
    },
    {
      "verse": 15,
      "sanskrit": "तद्वृक्षराजकुसुमं रुक्मिण्याः प्रददौ हरिः। पार्श्वस्था सा हि कृष्णस्य भोज्या नरवराभवत्॥१५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 120,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पारिजातनिबन्धनः सत्याकोपः-०६५",
      "combined_translation": "15-15"
    },
    {
      "verse": 16,
      "sanskrit": "प्रतिगृह्य तु तत्पुष्पं कामारणिरनिन्दिता। शिरस्यमलपत्राक्षी ददौ कृष्णेङ्गितानुगा॥१६॥",
      "english": null,
      "bhavadeepa": "हे नरवर॥१५॥",
      "chapter": 120,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पारिजातनिबन्धनः सत्याकोपः-०६५",
      "combined_translation": "16-16"
    },
    {
      "verse": 17,
      "sanskrit": "त्रैलोक्यरूपसर्वस्वं नारायणमनोहरा। शुशुभे देवपुष्पेण द्विगुणं भैष्मकी तदा॥१७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 120,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पारिजातनिबन्धनः सत्याकोपः-०६५",
      "combined_translation": "17-17"
    },
    {
      "verse": 18,
      "sanskrit": "तां नारदस्तथोवाच मुनिर्ब्रह्मसुतस्तदा। तवैवौपयिकं पुष्पमेकं देवि पतिव्रते॥१८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 120,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
