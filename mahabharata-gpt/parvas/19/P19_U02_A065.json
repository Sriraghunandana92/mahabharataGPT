    },
    {
      "verse": 29,
      "sanskrit": "बुभुक्षा वा पिपासा वा ग्लानिर्वाप्यथवा जरा। देववद्धारयन्त्यास्ते स्वच्छन्देन भविष्यति॥२९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 120,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
