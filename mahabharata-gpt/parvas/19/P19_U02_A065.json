      "combined_translation": "18-18"
    },
    {
      "verse": 19,
      "sanskrit": "अलङ्कृतं पुष्पमेतत्संसर्गात्तव सर्वथा। अत्यर्हा च मता मे त्वमेतत्पुष्पाद्धृतव्रते॥१९॥",
      "english": null,
      "bhavadeepa": "आपयिकं योग्यम्॥१८॥",
      "chapter": 120,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
