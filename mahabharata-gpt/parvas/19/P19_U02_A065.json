    },
    {
      "verse": 23,
      "sanskrit": "सेव्यमानं च सौभाग्यं ददाति वरवर्णिनि। स्रवत्यपि तथा गन्धानीप्सितान्प्रीतिवर्द्धनान्॥२३॥",
      "english": null,
      "bhavadeepa": null,
