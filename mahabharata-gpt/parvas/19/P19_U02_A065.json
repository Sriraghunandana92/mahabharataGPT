    {
      "verse": 28,
      "sanskrit": "सन्तानकस्रजो मालां पुष्पवस्त्रादि वाच्युतम्। पुष्पमण्डपमुख्यानि चिन्तितेन प्रदास्यति॥२८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 120,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
