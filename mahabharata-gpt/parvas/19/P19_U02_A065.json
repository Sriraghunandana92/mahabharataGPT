      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पारिजातनिबन्धनः सत्याकोपः-०६५"
    },
    {
      "verse": 26,
      "sanskrit": "यद्यदिच्छसि वर्णं च तत्सर्वं धारयिष्यति। स्वल्पं वा यदि वा स्थूलं छन्दतस्ते भविष्यति॥२६॥",
      "english": null,
      "bhavadeepa": "भगाधानम् ऐश्वर्याधायकम्॥२५॥",
