{
  "adhyaya_id": "P19_U03_A094",
  "book": 19,
  "parva_name": "हरिवंशः",
  "upaparva_name": "भविष्यपर्व",
  "adhyaya_name": "यादवानां युद्धोद्योगः",
  "chapter": 277,
  "verse_count": 33,
  "verses": [
    {
      "verse": 1,
      "sanskrit": "वैशम्पायन उवाच।\n              ततश्च यादवाः सर्वे दृष्ट्वा सैनिकसञ्चयम्। रात्रौ च व्यसनं प्राप्तं महाशस्त्रसमाकुलम्॥१॥",
      "english": null,
      "bhavadeepa": "निबद्धानिव इति निबद्धशः सर्वे सन्नाहनिबद्धाः इत्यर्थः॥२५॥",
      "chapter": 277,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "यादवानां युद्धोद्योगः",
      "combined_translation": "1-26"
    },
    {
      "verse": 2,
      "sanskrit": "महावातसमुद्भूतं कल्पान्ते समरोपमम्। सन्नद्धाः समपद्यन्त शस्त्रिणो युद्धलालसाः॥२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 277,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "यादवानां युद्धोद्योगः",
      "combined_translation": "2-2"
    },
    {
      "verse": 3,
      "sanskrit": "गृहीतदीपिकाः सर्वे यादवाः शस्त्रयोधिनः। सात्यकिर्बलभद्रश्च हार्दिक्यो निशठस्तथा॥३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 277,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "यादवानां युद्धोद्योगः",
      "combined_translation": "3-3"
    },
    {
      "verse": 4,
      "sanskrit": "उद्धवोऽथ महाबुद्धिरुग्रसेनो महाबलः। अन्ये च यादवाः सर्वे कवचप्रग्रहे रताः॥४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 277,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "यादवानां युद्धोद्योगः",
      "combined_translation": "4-4"
    },
    {
      "verse": 5,
      "sanskrit": "समस्तयुद्धकुशला रात्रौ सन्नाहयोधिनः। शस्त्रिणः खड्गिनश्चैव सर्वे शस्त्रसमाकुलाः॥५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 277,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "यादवानां युद्धोद्योगः",
      "combined_translation": "5-5"
    },
    {
      "verse": 6,
      "sanskrit": "युद्धाय समपद्यन्त बहवो बाहुशालिनः। रथिनो गदिनश्चैव सादिनः सायुधास्तथा॥६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 277,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "यादवानां युद्धोद्योगः",
      "combined_translation": "6-6"
    },
    {
      "verse": 7,
      "sanskrit": "नित्ययुक्ता महात्मानो धन्विनः पुरुषोत्तमाः। निर्ययुर्नगरात्तूर्णं दीपिकाभिः समन्ततः॥७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 277,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "यादवानां युद्धोद्योगः",
      "combined_translation": "7-7"
    },
    {
      "verse": 8,
      "sanskrit": "कुतः पौण्ड्रक इत्येवं वदन्तः सर्वसात्वताः। दीपिकादीपितो देशो निस्तमाः समपद्यत॥८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 277,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "यादवानां युद्धोद्योगः",
      "combined_translation": "8-8"
    },
    {
      "verse": 9,
      "sanskrit": "ततो वितिमिरो देशः समन्तात्प्रत्यपद्यत। युद्धं समभवद्घोरं वृष्णिभिः शत्रुभिः सह॥९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 277,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "यादवानां युद्धोद्योगः",
      "combined_translation": "9-9"
    },
    {
      "verse": 10,
      "sanskrit": "ततो महान्समभवत्सन्नादो रोमहर्षणः। हया हयैः समायुक्ता गजाश्च गजयूथपैः॥१०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 277,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "यादवानां युद्धोद्योगः",
      "combined_translation": "10-10"
    },
    {
      "verse": 11,
      "sanskrit": "रथा रथैः समायुक्ताः सादिभिः सादिनस्तथा। खड्गिनः खड्गिभिः सार्धं गदिभिर्गदिनस्तथा॥११॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 277,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "यादवानां युद्धोद्योगः",
      "combined_translation": "11-11"
    },
    {
      "verse": 12,
      "sanskrit": "परस्परव्यतीकारो रण आसीत्सुदारुणः। महाप्रलयसङ्क्षोभः शब्दस्तेषां महात्मनाम्॥१२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 277,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "यादवानां युद्धोद्योगः",
      "combined_translation": "12-12"
    },
    {
      "verse": 13,
      "sanskrit": "धावन्तः प्रहरन्त्येतान्हन्त्येतान् सर्वतो नृपान्। अयमेष महाबाहुः खड्गी पतति वीर्यवान्॥१३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 277,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "यादवानां युद्धोद्योगः",
      "combined_translation": "13-13"
    },
    {
      "verse": 14,
      "sanskrit": "अयमेष शरो घोरो वर्ततेऽतिसुदारुणः। गदी चायं महावीर्यः सर्वान्नो बाधते नृपः॥१४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 277,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "यादवानां युद्धोद्योगः",
      "combined_translation": "14-14"
    },
    {
      "verse": 15,
      "sanskrit": "अयं रथी शरी चपी गदी तूणी तनुत्रवान्। यादृशः सर्वतो याति कुन्तपाणिरयं बली॥१५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 277,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "यादवानां युद्धोद्योगः",
      "combined_translation": "15-15"
    },
    {
      "verse": 16,
      "sanskrit": "अयमत्र महाशूली संश्रितः सर्वतोदिशम्। गजोऽयं सविषाणाग्रो वर्तते सर्वतः प्रति॥१६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 277,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "यादवानां युद्धोद्योगः",
      "combined_translation": "16-16"
    },
    {
      "verse": 17,
      "sanskrit": "अतिसर्वत्रगः शूरो वेगवान्वातसन्निभः। शराञ्च्छरैः समाहन्ति दण्डान्दण्डैर्जगत्पते॥१७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 277,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "यादवानां युद्धोद्योगः",
      "combined_translation": "17-17"
    },
    {
      "verse": 18,
      "sanskrit": "कुन्तान्कुन्तैः समाजघ्नुर्गदाभिश्च गदास्तथा। परिघान्परिघैः सार्धं शूलाञ्च्छूलैः समन्ततः॥१८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 277,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "यादवानां युद्धोद्योगः",
      "combined_translation": "18-18"
    },
    {
      "verse": 19,
      "sanskrit": "एवं तेषां महाराज कुर्वतां रणमुत्तमम्। सङ्ग्रामः सुमहानासीच्छब्दश्चापि महानभूत्॥१९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 277,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "यादवानां युद्धोद्योगः",
      "combined_translation": "19-19"
    },
    {
      "verse": 20,
      "sanskrit": "भूतानि सुबहून्याजौ शब्दवन्ति महान्ति च। प्रादुरासन्सहस्राणि शङ्खानां भीमनिःस्वनः॥२०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 277,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "यादवानां युद्धोद्योगः",
      "combined_translation": "20-20"
    },
    {
      "verse": 21,
      "sanskrit": "रात्रौ प्रादुरभूच्छब्दः सङ्ग्रामे रोमहर्षणः। वर्तमाने महायुद्धे वृष्णीनां चैव तैः सह॥२१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 277,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "यादवानां युद्धोद्योगः",
      "combined_translation": "21-21"
    },
    {
      "verse": 22,
      "sanskrit": "केचिद्ग्रस्ताः समापेतुः पृथिव्यां पृथिवीक्षितः। केचित्पतितश्लिष्टाश्च विप्रकीर्णशिरोधराः॥२२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 277,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "यादवानां युद्धोद्योगः",
      "combined_translation": "22-22"
    },
    {
      "verse": 23,
      "sanskrit": "पेतुरुर्व्यां महावीर्या राजानः शस्त्रपाणयः। केचित्तु भिन्नवर्माणः समापेतुः सहस्रधा॥२३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 277,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "यादवानां युद्धोद्योगः",
      "combined_translation": "23-23"
    },
    {
      "verse": 24,
      "sanskrit": "परस्परं समाश्रित्य परस्परवधैषिणः। न्यस्तशस्त्रा महात्मानः समन्तात्क्षतविग्रहाः॥२४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 277,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "यादवानां युद्धोद्योगः",
      "combined_translation": "24-24"
    },
    {
      "verse": 25,
      "sanskrit": "पेतुर्गतासवः केचिद्यमराष्ट्रविवर्धनाः। एवं ते निहता राजन्योधिताः सर्व एव तु॥२५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 277,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "यादवानां युद्धोद्योगः",
      "combined_translation": "25-25"
    },
    {
      "verse": 26,
      "sanskrit": "एतस्मिन्नन्तरे शूर एकलव्यो निषादयः। धनुर्गृह्य महाघोरं कालान्तकयमोपमः॥२६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 277,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "यादवानां युद्धोद्योगः",
      "combined_translation": "26-26"
    },
    {
      "verse": 27,
      "sanskrit": "शरैरनेकसाहस्रैरर्दयामास यादवान्। परःशतैः शराणां तु निशितैर्मर्मभेधिभिः॥२७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 277,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "यादवानां युद्धोद्योगः",
      "combined_translation": "27-27"
    },
    {
      "verse": 28,
      "sanskrit": "वृष्णीनां च बलं सर्वं पोथयामास सर्वतः। युद्ध्यतः शस्त्रपाणींश्च क्षत्रियान्वीर्यवत्तरान्॥२८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 277,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "यादवानां युद्धोद्योगः",
      "combined_translation": "28-28"
    },
    {
      "verse": 29,
      "sanskrit": "निशठं पञ्चविंशत्या शराणां नतपर्वणाम्। सारणं दशभिर्विद्ध्वा हार्दिक्यं पञ्चभिः शरैः॥२९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 277,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "यादवानां युद्धोद्योगः",
      "combined_translation": "29-29"
    },
    {
      "verse": 30,
      "sanskrit": "उग्रसेनं नवत्याशु वसुदेवं च सप्तभिः। उद्धवं दशभिश्चैव ह्यक्रूरं पञ्चभिः शरैः॥३०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 277,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "यादवानां युद्धोद्योगः",
      "combined_translation": "30-30"
    },
    {
      "verse": 31,
      "sanskrit": "एवमेकैकशः सर्वे निहता निशितैः शरैः। विद्राव्य यादवीं सेनां नाम विश्राव्य वीर्यवान्॥३१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 277,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "यादवानां युद्धोद्योगः",
      "combined_translation": "31-31"
    },
    {
      "verse": 32,
      "sanskrit": "एकलव्यो यदुवृषान्वीर्यवान्बलवानहम्। इदानीं सात्यकिर्वीरः क्व यास्यति महाबलः॥३२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 277,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "यादवानां युद्धोद्योगः",
      "combined_translation": "32-32"
    },
    {
      "verse": 33,
      "sanskrit": "मदमत्तो हली साक्षात्क्व यातीह गदाधरः। इत्याह सिंहनादेन सिंहान्विस्मापयन्निव॥३३॥",
      "english": null,
      "bhavadeepa": null,
