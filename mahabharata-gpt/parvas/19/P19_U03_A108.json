{
  "adhyaya_id": "P19_U03_A108",
  "book": 19,
  "parva_name": "हरिवंशः",
  "upaparva_name": "भविष्यपर्व",
  "adhyaya_name": "संन्यासधर्मनिन्दा",
  "chapter": 291,
  "verse_count": 19,
  "verses": [
    {
      "verse": 1,
      "sanskrit": "हंसडिम्भकावूचतुः।\n              ज्ञानलेशाद्विहीनात्मन्किं ते व्यवसितं द्विज। कश्चायमाश्रमो विप्र भवता यः समाश्रितः॥१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 291,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "संन्यासधर्मनिन्दा",
      "combined_translation": "1-31"
    },
    {
      "verse": 2,
      "sanskrit": "गृहमेधं परित्यज्य किं त्वया साधितं पदम्। दम्भ एव भवान्व्यक्तं शङ्के नास्त्यत्र कारणम्॥२॥",
      "english": null,
      "bhavadeepa": "ज्ञानलेशादिति॥१॥",
      "chapter": 291,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "संन्यासधर्मनिन्दा",
      "combined_translation": "2-2"
    },
    {
      "verse": 3,
      "sanskrit": "लोकांश्चेमान्सदा मूढ नाशयिष्यसि निर्वृतः। एतान्सर्वान्विनेतासि नरके पातयिष्यसि॥३॥",
      "english": null,
      "bhavadeepa": "दम्भः दम्भमीर्तिः॥२॥",
      "chapter": 291,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "संन्यासधर्मनिन्दा",
      "combined_translation": "3-3"
    },
    {
      "verse": 4,
      "sanskrit": "स्वयं नष्टः परान्मूर्ख नाशयिष्यसि यत्नतः। अहो शास्ता कथं नास्ति तव मन्दमतेर्द्विज॥४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 291,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "संन्यासधर्मनिन्दा",
      "combined_translation": "4-4"
    },
    {
      "verse": 5,
      "sanskrit": "सर्वथा त्वद्विनेता च पापो नास्त्यत्र संशयः। त्यक्त्वेममाश्रमं विप्र गृही भव यतात्मवान्॥५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 291,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "संन्यासधर्मनिन्दा",
      "combined_translation": "5-5"
    },
    {
      "verse": 6,
      "sanskrit": "पञ्च यज्ञान्सदा विप्र कुरु यत्नपरो भव। ततः स्वर्गं परं गत्वा स्वर्गे हि सुमहत्सुखम्॥६॥",
      "english": null,
      "bhavadeepa": "त्वद्विनेता तव शिक्षकः॥५॥",
      "chapter": 291,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "संन्यासधर्मनिन्दा",
      "combined_translation": "6-6"
    },
    {
      "verse": 7,
      "sanskrit": "एष श्रेयः पथो विप्र जीविते चेत्स्पृहा तव। इत्युक्तवन्तौ धर्मात्मा श्रुत्वा विप्रो जनार्दनः॥७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 291,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "संन्यासधर्मनिन्दा",
      "combined_translation": "7-7"
    },
    {
      "verse": 8,
      "sanskrit": "उवाच च यतिं दृष्ट्वा प्रणम्यासौ सुनीतवत्। मा ब्रूतमीदृशं वाक्यं राजानौ मन्दतेजसौ॥८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 291,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "संन्यासधर्मनिन्दा",
      "combined_translation": "8-8"
    },
    {
      "verse": 9,
      "sanskrit": "अश्राव्यमीदृशं घोरं लोकयोरुभयोरपि। को वक्तुमीशो मन्दात्मा यदि जीवेत्सबान्धवः॥९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 291,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "संन्यासधर्मनिन्दा",
      "combined_translation": "9-9"
    },
    {
      "verse": 10,
      "sanskrit": "सर्वथा काल एवायं युवयोर्मन्दचेतसोः। समाप्त आयुशः शेषो ब्रह्मदण्डहतौ युवाम्॥१०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 291,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "संन्यासधर्मनिन्दा",
      "combined_translation": "10-10"
    },
    {
      "verse": 11,
      "sanskrit": "एते हि यतयः शुद्धा ज्ञानदीपितचेतसः। ज्ञानाग्निदग्धकर्माणः प्राणान्प्राणेषु जुह्वति॥११॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 291,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "संन्यासधर्मनिन्दा",
      "combined_translation": "11-11"
    },
    {
      "verse": 12,
      "sanskrit": "ऋते वामीदृशं वाक्यं कः समर्थो ह्यनुब्रुवन्। सर्वथा ज्ञातमस्माभिः समाप्तमिह जीवितम्॥१२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 291,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "संन्यासधर्मनिन्दा",
      "combined_translation": "12-12"
    },
    {
      "verse": 13,
      "sanskrit": "चत्वार आश्रमाः पूर्वमृषिभिर्विहिता नृपौ। ब्रह्मचरी गृहस्थश्च वानप्रस्थश्च भिक्षुकः॥१३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 291,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "संन्यासधर्मनिन्दा",
      "combined_translation": "13-13"
    },
    {
      "verse": 14,
      "sanskrit": "तेषामग्रश्चतुर्थोऽयमाश्रमे भिक्षुकः स्मृतः। आस्ते तस्मिन्महाबुद्धिः स हि पुण्यतरः स्मृतः॥१४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 291,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "संन्यासधर्मनिन्दा",
      "combined_translation": "14-14"
    },
    {
      "verse": 15,
      "sanskrit": "नोपासिता भवद्भ्यां च वृद्धाः सम्यग्विनीतवत्। ज्ञानं नाप्तं तपस्विभ्यस्तथा चैवं वदेत कः॥१५॥",
      "english": null,
      "bhavadeepa": "अग्रः अग्र्यः॥१४॥",
      "chapter": 291,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "संन्यासधर्मनिन्दा",
      "combined_translation": "15-15"
    },
    {
      "verse": 16,
      "sanskrit": "अश्राव्यमीदृशं घोरं मया प्राणभृता नृप। किं करिष्यामि मन्दात्मन्मित्रत्वाद्भवतो नृप॥१६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 291,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "संन्यासधर्मनिन्दा",
      "combined_translation": "16-16"
    },
    {
      "verse": 17,
      "sanskrit": "ज्ञानं यदाप्तं भवता गुरुभ्यस्तदत्र दुःखाय हि केवलं नृप। ज्ञानं हि धर्मप्रभवं यथेष्टं बलाद्विपापस्य विधातृरूपम्॥१७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 291,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "संन्यासधर्मनिन्दा",
      "combined_translation": "17-17"
    },
    {
      "verse": 18,
      "sanskrit": "युवां विहाय यास्ये वा पतेयं वा शिलातलम्। पिबेयं वा विषं घोरं पतेयं वा महोर्मिषु॥१८॥",
      "english": null,
      "bhavadeepa": "अन्यस्य ज्ञानं धर्मप्रभावं धर्मस्य फलम्। युवयोर्ज्ञानं तु पापस्य विधातृरूपं पापोत्पत्तिहेतु॥१७॥",
      "chapter": 291,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "संन्यासधर्मनिन्दा",
      "combined_translation": "18-18"
    },
    {
      "verse": 19,
      "sanskrit": "आत्मानं वात्र सन्त्यक्ष्ये पश्यतां शृण्वतां पुनः। इत्युक्त्वा विललापैवं म ब्रूतमिति तौ वदन्॥१९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 291,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "संन्यासधर्मनिन्दा",
      "combined_translation": "19-19"
    }
  ]
}