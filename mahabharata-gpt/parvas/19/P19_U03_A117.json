{
  "adhyaya_id": "P19_U03_A117",
  "book": 19,
  "parva_name": "हरिवंशः",
  "upaparva_name": "भविष्यपर्व",
  "adhyaya_name": "हंसवाक्यम्",
  "chapter": 300,
  "verse_count": 14,
  "verses": [
    {
      "verse": 1,
      "sanskrit": "वैशम्पायन उवाच।\n              इत्युक्त्वा ब्राह्मणं कृष्णः सात्यकिं पुनराह सः। गत्वा शैनेय विप्रेण ब्रूहि मद्वचनात्तयोः॥१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 300,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हंसवाक्यम्",
      "combined_translation": "1-10"
    },
    {
      "verse": 2,
      "sanskrit": "यन्मयोक्तमशेषेण वद गत्वा तयोः पुरः। यथा नः सङ्गतिर्युद्धे तथा वद बलात्तदा॥२॥",
      "english": null,
      "bhavadeepa": "इतीति॥१॥",
      "chapter": 300,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हंसवाक्यम्",
      "combined_translation": "2-2"
    },
    {
      "verse": 3,
      "sanskrit": "धनुरादाय गच्छ त्वं बद्धगोधाङ्गुलित्रवान्। एकेनाश्वेन गच्छ त्वमसहायो यदूत्तम॥३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 300,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हंसवाक्यम्",
      "combined_translation": "3-3"
    },
    {
      "verse": 4,
      "sanskrit": "सात्यकिस्तं तथेत्युक्त्वा हयमारुह्य शीघ्रगम्। गन्तुमैच्छत्ततो राजन्नसहायः स सात्यकिः॥४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 300,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हंसवाक्यम्",
      "combined_translation": "4-4"
    },
    {
      "verse": 5,
      "sanskrit": "जनार्दनं विसृज्याशु दूतं तं यादवेश्वरः। अहो धार्ष्ट्यमहो धार्ष्ट्यमित्युवाच जनार्दनः॥५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 300,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हंसवाक्यम्",
      "combined_translation": "5-5"
    },
    {
      "verse": 6,
      "sanskrit": "नमस्कृत्य तदा दूतो माधवं माधवेश्वरम्। स ययौ शाल्वनगरं शैनेयेन समन्वितः॥६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 300,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हंसवाक्यम्",
      "combined_translation": "6-6"
    },
    {
      "verse": 7,
      "sanskrit": "ततः प्रविश्य धर्मात्मा ब्राह्मणो ब्रह्मवित्तमः। आसनं महदास्थाय विसृज्य यादवे पुनः॥७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 300,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हंसवाक्यम्",
      "combined_translation": "7-7"
    },
    {
      "verse": 8,
      "sanskrit": "आस्ते सुखं यदा विप्रः शैनेयेन समन्वितः। अथ तं हंसडिम्भयोर्दर्शयामास सात्यकिम्॥८॥",
      "english": null,
      "bhavadeepa": "प्रविश्य गृहमिति शेषः। यादवे सात्यकिनिमित्तं पुनः आसनं विसृज्य समर्प्य॥७॥",
      "chapter": 300,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हंसवाक्यम्",
      "combined_translation": "8-8"
    },
    {
      "verse": 9,
      "sanskrit": "दूतोऽयं सात्यकिः प्राप्तः सव्यो बाहुरयं हरेः। तस्य तद्वचनं श्रुत्वा हंसः प्राह वचस्तदा॥९॥",
      "english": null,
      "bhavadeepa": "विप्रः जनार्दनः हंसडिम्भयोरन्यद्वारा आह॥८॥",
      "chapter": 300,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हंसवाक्यम्",
      "combined_translation": "9-9"
    },
    {
      "verse": 10,
      "sanskrit": "श्रुतः समागमः पूर्वमद्य दृष्टो मया त्वसौ। धनुर्वेदे च वेदे च शास्त्रे शस्त्रे तथैव च॥१०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 300,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हंसवाक्यम्",
      "combined_translation": "10-10"
    },
    {
      "verse": 11,
      "sanskrit": "निपुणोऽयं सदा धिरा इत्येवमनुशुश्रुम। अथो दृष्टपथं प्राप्तः प्रीतिं नौ विदधात्यसौ॥११॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 300,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हंसवाक्यम्"
    },
    {
      "verse": 12,
      "sanskrit": "कुशलं वासुदेवस्य बलभद्रस्य वा पुनः। कुशलाः सात्वताः सर्वे उग्रसेनपुरोगमाः॥१२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 300,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हंसवाक्यम्",
      "combined_translation": "12-12"
    },
    {
      "verse": 13,
      "sanskrit": "तथेति सात्यकिः प्राह मन्दमुन्मथिताननः। ततो जनार्दनं प्राह हंसो वाक्यविशारदः॥१३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 300,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हंसवाक्यम्",
      "combined_translation": "13-13"
    },
    {
      "verse": 14,
      "sanskrit": "अपि दृष्टस्त्वया चक्री सिद्धं नः कार्यमीहितम्। वद सर्वमशेषेण म वृथा कालमत्यगाः॥१४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 300,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हंसवाक्यम्",
      "combined_translation": "14-14"
    }
  ]
}