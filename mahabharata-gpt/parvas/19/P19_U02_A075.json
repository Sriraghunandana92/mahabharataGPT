      "bhavadeepa": null,
      "chapter": 130,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "स्वर्गात्पारिजातानयनम्-०७५"
    },
    {
      "verse": 32,
      "sanskrit": "ततः शक्रस्य कौरव्य दत्वा वाचाभयं तदा। यत्र देवगणाः सर्वे समेता धर्मचारिणः॥३२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 130,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "स्वर्गात्पारिजातानयनम्-०७५"
    },
    {
      "verse": 33,
      "sanskrit": "ततो ययुर्विमानैस्तु देवाः सर्वे त्रिविष्टपम्। ऋद्ध्या परमया युक्तास्तेषामेवानुरूपया॥३३॥",
      "english": null,
      "bhavadeepa": "अभयं दत्वा दत्तवान्। कृष्ण इति शेषः। ददातेः “आतो मनिन्क्वनिब्वानपश्च” इति ववनिप्॥३२॥",
      "chapter": 130,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "स्वर्गात्पारिजातानयनम्-०७५"
    },
    {
      "verse": 34,
      "sanskrit": "कश्यपश्चादितिश्चैव तथा शक्रजनार्दनौ। विमानमेकमारुह्य गता राजंस्त्रिविष्टपम्॥३४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 130,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "स्वर्गात्पारिजातानयनम्-०७५"
    },
    {
      "verse": 35,
      "sanskrit": "ते शक्रसदनं प्राप्ता रम्यं सर्वगुणान्वितम्। ऊषुरेकत्र कौरव्य मुदिता धर्मचारिणः॥३५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 130,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "स्वर्गात्पारिजातानयनम्-०७५"
    },
    {
      "verse": 36,
      "sanskrit": "शची तु कश्यपं पत्न्या सहितं धर्मवत्सला। उपाचरन्महात्मानं सर्वभूतहिते रतम्॥३६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 130,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "स्वर्गात्पारिजातानयनम्-०७५"
    },
    {
      "verse": 37,
      "sanskrit": "ततस्तस्यां प्रभातायां रजन्यामब्रवीद्धरिम्। आदातधमतत्त्वज्ञा सर्वहूतहितं वचः॥३७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 130,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "स्वर्गात्पारिजातानयनम्-०७५"
    },
    {
      "verse": 38,
      "sanskrit": "उपेन्द्र द्वारकां गच्छ पारिजातं नयस्व च। वध्वा सम्प्रापयस्वेश पुण्यकं हृदये स्थितम्॥३८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 130,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "स्वर्गात्पारिजातानयनम्-०७५"
    },
    {
      "verse": 39,
      "sanskrit": "पुण्यके सत्यया प्राप्ते पुनरेष त्वया तरुः। नन्दने पुरुषश्रेष्ठा स्थाप्यः स्थाने यथोचिते॥३९॥",
      "english": null,
      "bhavadeepa": "पुण्यकं व्रतोत्सवम्॥३८॥",
      "chapter": 130,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "स्वर्गात्पारिजातानयनम्-०७५"
    },
    {
      "verse": 40,
      "sanskrit": "एवमस्त्विति कृष्णेन देवमाता यशस्विनी। उक्ता धर्मगुणैर्युक्ता नारदेन महात्मना॥४०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 130,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "स्वर्गात्पारिजातानयनम्-०७५"
    },
    {
      "verse": 41,
      "sanskrit": "ततोऽभिवाद्य पितरं मातरं च जनार्दनः। महेन्द्रं सह शच्याथ प्रतस्थे द्वारकां प्रति॥४१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 130,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "स्वर्गात्पारिजातानयनम्-०७५"
    },
    {
      "verse": 42,
      "sanskrit": "ददौ कृष्णाय पौलोमी नियोगान्कुरुनन्दन। सर्वासामेव कृष्णस्य भार्याणां धर्मचारिणी॥४२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 130,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "स्वर्गात्पारिजातानयनम्-०७५"
    },
    {
      "verse": 43,
      "sanskrit": "दिव्यानां सर्वरत्नानां वाससां च मनस्विनी। नानारागाविरक्तानां सदेवारजसामपि॥४३॥",
      "english": null,
      "bhavadeepa": "नियोगान् प्रीतिदेयान् आभरणादीन्॥४२॥",
      "chapter": 130,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "स्वर्गात्पारिजातानयनम्-०७५"
    },
    {
      "verse": 44,
      "sanskrit": "भार्याणां च सहस्राणि यानि षोडश माधवे। प्रतिगृह्य महातेजाः प्रययौ द्वारकां प्रति॥४४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 130,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "स्वर्गात्पारिजातानयनम्-०७५"
    },
    {
      "verse": 45,
      "sanskrit": "सम्पूज्यमानो द्युतिमान्खेचरैः पुण्यकर्मभिः। ससात्यकिः सपुत्रश्च प्राप्तो रैवतकं गिरिम्॥४५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 130,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "स्वर्गात्पारिजातानयनम्-०७५"
    },
    {
      "verse": 46,
      "sanskrit": "स तत्र स्थापयित्वा च पारिजातं वरद्रुमम्। सत्यकं प्रेषयामास द्वारकां द्वारशालिनीम्॥४६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 130,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "स्वर्गात्पारिजातानयनम्-०७५"
    },
    {
      "verse": 47,
      "sanskrit": "श्रीकृष्ण उवाच।\n              पारिजातमिहानीतं महेन्द्रस्दनान्मया। निवेदय महाबाहो भैमानां भैमवर्धन॥४७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 130,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "स्वर्गात्पारिजातानयनम्-०७५"
    },
    {
      "verse": 48,
      "sanskrit": "अद्य द्वारवतीं चैव पारिजातमहं द्रुमम्। प्रवेशयिष्ये नगरे शोभा प्रक्रियतां शुभा॥४८॥",
      "english": null,
      "bhavadeepa": "भैमानां भीमवंशोद्भवानां यादवानाम्॥४७॥",
      "chapter": 130,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "स्वर्गात्पारिजातानयनम्-०७५"
    },
    {
      "verse": 49,
      "sanskrit": "इत्युक्तः सत्यको गत्वा तथोक्त्व पुनरागतः। कुमारैर्नागरैः सार्धं साम्बप्रभृतिभिः प्रभो॥४९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 130,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "स्वर्गात्पारिजातानयनम्-०७५"
    },
    {
      "verse": 50,
      "sanskrit": "ततोऽग्रतः पारिजातमारोप्य गरुडे तदा। प्रद्युम्नो द्वारकां रम्यां विवेश रथिनां वरः॥५०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 130,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "स्वर्गात्पारिजातानयनम्-०७५"
    },
    {
      "verse": 51,
      "sanskrit": "शैब्यादिहययुक्तेन रथेनानुनयौ हरिः। तस्याथ रथमुख्येन सत्यकः साम्ब एव च॥५१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 130,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "स्वर्गात्पारिजातानयनम्-०७५"
    },
    {
      "verse": 52,
      "sanskrit": "ते त्वन्ये नृप वार्ष्णेया यानैर्बहुविधैस्तथा। ययुः प्रहृष्टास्तत्कर्म पूजयन्तो महात्मनः॥५२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 130,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "स्वर्गात्पारिजातानयनम्-०७५"
    },
    {
      "verse": 53,
      "sanskrit": "सत्यकाद्विस्तरं श्रुत्वा यादवा नागरास्तथा। विस्मयं परमं जग्मुरप्रमेयस्य कर्मणा॥५३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 130,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "स्वर्गात्पारिजातानयनम्-०७५"
    },
    {
      "verse": 54,
      "sanskrit": "तं दिव्यकुसुमं वृक्षं दृष्ट्वाऽऽनर्तनिवासिनः। राजन्न ततृपुर्हृष्टाः पश्यमाना महोदयम्॥५४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 130,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "स्वर्गात्पारिजातानयनम्-०७५"
    },
    {
      "verse": 55,
      "sanskrit": "तमद्भुतमचिन्त्यं च मदकेलिकलाण्डजम्। वृक्षोत्तमं पश्यतां वै वृद्धानामगमज्जरा॥५५॥",
      "english": null,
      "bhavadeepa": "पश्यमानाः पश्यन्तः॥५४॥",
      "chapter": 130,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "स्वर्गात्पारिजातानयनम्-०७५"
    },
    {
      "verse": 56,
      "sanskrit": "ये त्वन्धचक्षुषः सर्वे तेऽभवन्दिव्यचक्षुषः। विरोगा रोगिणश्चासन्घ्रात्वा गन्धं वनस्पतेः॥५६॥",
      "english": null,
      "bhavadeepa": "मदेन केलिकलाः क्रीडापरा अण्डजा यत्र तम्॥५५॥",
      "chapter": 130,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "स्वर्गात्पारिजातानयनम्-०७५"
    },
    {
      "verse": 57,
      "sanskrit": "लपन्तः कोकिलाञ्छ्वेताञ्छ्रुत्वाऽऽनर्तनिवासिनः। बभूवुर्हृष्टमनसो ववन्दुश्च जनार्दनम्॥५७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 130,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "स्वर्गात्पारिजातानयनम्-०७५"
    },
    {
      "verse": 58,
      "sanskrit": "नानाविधानि तूर्याणि गेयानि मधुराणि च। शुश्रुवुस्तस्य वृक्षस्य नातिदूरं गता नराः॥५८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 130,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "स्वर्गात्पारिजातानयनम्-०७५"
    },
    {
      "verse": 59,
      "sanskrit": "योऽयं सङ्कल्पयामास गन्धं हृद्यं नरस्तथा। स तदैव तमाजघ्रे पारिजातसमुद्भवम्॥५९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 130,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "स्वर्गात्पारिजातानयनम्-०७५"
    },
    {
      "verse": 60,
      "sanskrit": "ततः प्रविश्य रम्यां तु द्वारकां यदुनन्दनः। वसुदेवं महात्मानं ददृशे देवकीं तथा॥६०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 130,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "स्वर्गात्पारिजातानयनम्-०७५"
    },
    {
      "verse": 61,
      "sanskrit": "कुकुराधिपतिं चैव बलं भ्रातरमेव च। वृद्धाश्च यादवानां ये मानार्हानमरोपमान्॥६१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 130,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "स्वर्गात्पारिजातानयनम्-०७५"
    },
    {
      "verse": 62,
      "sanskrit": "विसृज्य तान्वै भगवाननादिनिधनोऽच्युतः। सम्पूज्य च यथान्यायं स्वमेव भवनं गतः॥६२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 130,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "स्वर्गात्पारिजातानयनम्-०७५"
    },
    {
      "verse": 63,
      "sanskrit": "स सत्यभामया वासं विवेश मधुसूदनः। पारिजातं तरुश्रेष्ठं ग्रहाय गदपूर्वजः॥६३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 130,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "स्वर्गात्पारिजातानयनम्-०७५"
    },
    {
      "verse": 64,
