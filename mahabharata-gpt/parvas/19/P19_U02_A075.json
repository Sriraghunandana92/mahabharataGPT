      "adhyaya_name": "स्वर्गात्पारिजातानयनम्-०७५",
      "combined_translation": "8-8"
    },
    {
      "verse": 9,
      "sanskrit": "स च बाणसहस्रैश्च कृष्णो गजमवाकिरत्। गरुडं च महातेजा बलभिद्धरिवाहनम्॥९॥",
      "english": null,
      "bhavadeepa": "शैब्याद्यान् शैब्यसुग्रीवबलाहकमेघपुष्पाख्यान् कृष्णाश्वान्। सैन्याद्यानिति पाठे सेनायां शूरभूतानश्वादीन्॥८॥",
      "chapter": 130,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "स्वर्गात्पारिजातानयनम्-०७५",
      "combined_translation": "9-9"
    },
