  "verses": [
    {
      "verse": 1,
      "sanskrit": "वैशम्पायन उवाच।\n              ततो रथवरं कृष्णः समारुह्य महामनाः। बिल्वोदकेश्वरं देवं नमस्कृत्य ययौ नृपः॥१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 130,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "स्वर्गात्पारिजातानयनम्-०७५"
    },
    {
      "verse": 2,
      "sanskrit": "महेन्द्रमाह्वयामास रथस्थो मधुसूदनः। सत्कृतं पुष्कराभ्याशे सर्वैर्देवगणैः सह॥२॥",
      "english": null,
      "bhavadeepa": "पञ्चसप्ततितमेऽध्याये युद्धेनाराध्य वासवम्। द्वारकामनयद्धृष्टः पारिजातमितिीर्यते॥१॥ ततो रथेति॥१॥",
      "chapter": 130,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "स्वर्गात्पारिजातानयनम्-०७५",
      "combined_translation": "2-2"
    },
    {
      "verse": 3,
      "sanskrit": "ततः शक्रो जयन्तोऽथ हरिभिर्युक्तमुत्तमम्। आरुरोह रथं देवः सर्वकामप्रदः सताम्॥३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 130,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "स्वर्गात्पारिजातानयनम्-०७५",
      "combined_translation": "3-3"
    },
    {
      "verse": 4,
      "sanskrit": "ततो रथस्थयोर्युद्धमभवत्कुरुनन्दन। देवयोर्दैवयोगेन पारिजातकृते तदा॥४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 130,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "स्वर्गात्पारिजातानयनम्-०७५",
      "combined_translation": "4-4"
    },
    {
      "verse": 5,
      "sanskrit": "ततोऽहनद्रणे विष्णुर्बाणैः शत्रुबलार्दनः। सैन्यानि देवराजस्य बाणजालैरजिह्मगैः॥५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 130,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "स्वर्गात्पारिजातानयनम्-०७५",
      "combined_translation": "5-5"
    },
    {
      "verse": 6,
      "sanskrit": "उपेन्द्रं न महेन्द्रोऽथ नैव विष्णुः सुरेश्वरम्। ताडयामासतुर्वीरौ शस्त्रैः शक्तावपि प्रभो॥६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 130,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "स्वर्गात्पारिजातानयनम्-०७५",
      "combined_translation": "6-6"
    },
    {
