{
  "adhyaya_id": "P19_U01_A052",
  "book": 19,
  "parva_name": "हरिवंशः",
  "upaparva_name": "हरिवंशपर्व",
  "adhyaya_name": "विष्णुं प्रति पृथिव्या वाक्यम्",
  "chapter": 52,
  "verse_count": 60,
  "verses": [
    {
      "verse": 1,
      "sanskrit": "वैशम्पायन उवाच।\n              बाढमित्येव सह तैर्दुर्दिनाम्भोदनिःस्वनः। प्रतस्थे दुर्दिनाकारः सदुर्दिन इवाचलः॥१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 52,
      "parva_name": "हरिवंशः",
      "upaparva_name": "हरिवंशपर्व",
      "adhyaya_name": "विष्णुं प्रति पृथिव्या वाक्यम्",
      "combined_translation": "1-34"
    },
    {
      "verse": 2,
      "sanskrit": "समुक्तामणिविद्योतं सचन्द्राम्भोदवर्चसम्। सजटामण्डलं कृत्स्नं स बिभ्रच्छ्रीधरो हरिः॥२॥",
      "english": null,
      "bhavadeepa": "वर्ण्यतेऽथ द्विपञ्चाशे समाजे सुरसंसदि। धरण्या भारखिन्नाया विज्ञप्तिः करुणोदया॥१॥ बाढं दुर्दिनहेतुत्वाद्दुर्दिनो मेघस्तदाकारस्तद्वर्णः सदुर्दिनः गर्जन्मेघसहितः। कृत्स्नम् उदरम्। “कृत्स्नं सर्वाम्बुकुक्षिषु” (नवर्गे २) इति मेदिनी। जटामण्डलसहितं बिभ्रत् पाठान्तरे स्पष्टोऽर्थः॥१॥",
      "chapter": 52,
      "parva_name": "हरिवंशः",
      "upaparva_name": "हरिवंशपर्व",
      "adhyaya_name": "विष्णुं प्रति पृथिव्या वाक्यम्",
      "combined_translation": "2-2"
    },
    {
      "verse": 3,
      "sanskrit": "स चास्योरसि विस्तीर्णे रोमाञ्चोद्गतराजिमान्। स्रीवत्सो राजते श्रीमांस्तनद्वयमुखाञ्चितः॥३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 52,
      "parva_name": "हरिवंशः",
      "upaparva_name": "हरिवंशपर्व",
      "adhyaya_name": "विष्णुं प्रति पृथिव्या वाक्यम्",
      "combined_translation": "3-3"
    },
    {
      "verse": 4,
      "sanskrit": "पीते वसानो वसने लोकानां गुरुरव्ययः। हरिः सोऽभवदालक्ष्यः स सन्ध्याभ्र इवाचलः॥४॥",
      "english": null,
      "bhavadeepa": "रोमाञ्चाः रोम्णामुच्छ्रायाः तैः कृत्वा उद्गता राजयो रेषा इव तद्वान् स्तनद्वयमुखपर्यन्तम् अञ्चितं रश्मिद्वारा स्वतो वाऽपसर्पणं यस्य सः स्तनद्वयमुखाञ्चितः॥३॥",
      "chapter": 52,
      "parva_name": "हरिवंशः",
      "upaparva_name": "हरिवंशपर्व",
      "adhyaya_name": "विष्णुं प्रति पृथिव्या वाक्यम्",
      "combined_translation": "4-4"
    },
    {
      "verse": 5,
      "sanskrit": "तं व्रजन्तं सुपर्णेन पद्मयोनिगतानुगम्। अनुजग्मुः सुराः सर्वे तद्गतासक्तचक्षुषः॥५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 52,
      "parva_name": "हरिवंशः",
      "upaparva_name": "हरिवंशपर्व",
      "adhyaya_name": "विष्णुं प्रति पृथिव्या वाक्यम्",
      "combined_translation": "5-5"
    },
    {
      "verse": 6,
      "sanskrit": "नातिदीर्घेण कालेन सम्प्राप्ता रत्नपर्वतम्। ददृशुर्देवतास्तत्र तां सभां कामरूपिणीम्॥६॥",
      "english": null,
      "bhavadeepa": "पद्मयोनिर्गतानुगोऽनुगामी यस्य तम्॥५॥",
      "chapter": 52,
      "parva_name": "हरिवंशः",
      "upaparva_name": "हरिवंशपर्व",
      "adhyaya_name": "विष्णुं प्रति पृथिव्या वाक्यम्",
      "combined_translation": "6-6"
    },
    {
      "verse": 7,
      "sanskrit": "मेरोः शिखरविन्यस्तां सम्युक्तां सूर्यवर्चसा। काञ्चनस्तम्भरचितां वज्रसन्धानतोरणाम्॥७॥",
      "english": null,
      "bhavadeepa": "रत्नपर्वतं मेरुम्। कामरूपिणीं यथा सङ्कल्पितं तथा रूपधारिणीम्॥६॥",
      "chapter": 52,
      "parva_name": "हरिवंशः",
      "upaparva_name": "हरिवंशपर्व",
      "adhyaya_name": "विष्णुं प्रति पृथिव्या वाक्यम्",
      "combined_translation": "7-7"
    },
    {
      "verse": 8,
      "sanskrit": "मनोनिर्माणचित्राढ्यां विमानशतमालिनीम्। रत्नजालान्तरवतीं कामगां रत्नभूषिताम्॥८॥",
      "english": null,
      "bhavadeepa": "वज्रसन्धानतोरणां रत्नखचितबहिर्द्वाराम्॥७॥",
      "chapter": 52,
      "parva_name": "हरिवंशः",
      "upaparva_name": "हरिवंशपर्व",
      "adhyaya_name": "विष्णुं प्रति पृथिव्या वाक्यम्",
      "combined_translation": "8-8"
    },
    {
      "verse": 9,
      "sanskrit": "कॢप्तरत्नसमाकीर्णां सर्वर्तुकुसुमोत्कटाम्। देवमायाधरां दिव्यां विहितां विश्वकर्मणा॥९॥",
      "english": null,
      "bhavadeepa": "मनोनिर्माणचित्राढ्यां स्वसङ्कल्पोत्थविचित्ररचनावतीम्॥८॥",
      "chapter": 52,
      "parva_name": "हरिवंशः",
      "upaparva_name": "हरिवंशपर्व",
      "adhyaya_name": "विष्णुं प्रति पृथिव्या वाक्यम्",
      "combined_translation": "9-9"
    },
    {
      "verse": 10,
      "sanskrit": "तां हृष्टमनसः सर्वे यथास्थानं यथाविधि। यथानिदेशं त्रिदशा विविशुस्ते सभां शुभाम्॥१०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 52,
      "parva_name": "हरिवंशः",
      "upaparva_name": "हरिवंशपर्व",
      "adhyaya_name": "विष्णुं प्रति पृथिव्या वाक्यम्",
      "combined_translation": "10-10"
    },
    {
      "verse": 11,
      "sanskrit": "ते निषेदुर्यथोक्तेषु विमानेष्वासनेषु च। भद्रासनेषु पीठेषु कुथास्वास्तरणेषु च॥११॥",
      "english": null,
