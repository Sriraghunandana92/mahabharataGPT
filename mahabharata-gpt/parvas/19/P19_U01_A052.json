      "chapter": 52,
      "parva_name": "हरिवंशः",
      "upaparva_name": "हरिवंशपर्व",
      "adhyaya_name": "विष्णुं प्रति पृथिव्या वाक्यम्",
      "combined_translation": "11-11"
    },
    {
      "verse": 12,
      "sanskrit": "ततः प्रभञ्जनो वायुर्ब्रह्मणा सधु चोदितः। मा शब्दमिति सर्वत्र प्रचक्रामाथ तां सभाम्॥१२॥",
