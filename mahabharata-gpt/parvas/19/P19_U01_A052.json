      "parva_name": "हरिवंशः",
      "upaparva_name": "हरिवंशपर्व",
      "adhyaya_name": "विष्णुं प्रति पृथिव्या वाक्यम्",
      "combined_translation": "12-12"
    },
    {
      "verse": 13,
      "sanskrit": "निःशब्दस्तिमिते तस्मिन्समाजे त्रिदिवौकसाम्। बभाषे धरणी वाक्यं खेदात्करुणभाषिणी॥१३॥",
      "english": null,
