    },
    {
      "verse": 11,
      "sanskrit": "शृणोति श्रावयेद्वापि हरिवंशे तु यो नरः। सर्वथा पापनिर्मुक्तो वैष्णवं पदमाप्नुयात्॥११॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 318,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
