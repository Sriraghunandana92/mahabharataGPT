  "verses": [
    {
      "verse": 1,
      "sanskrit": "जनमजय उवाच।\n              हरिवंशे पुराणे तु श्रुते मुनिवरोत्तम। किं फलं किं च देयं वै तद्ब्रूहि त्वं ममाग्रतः॥१॥",
