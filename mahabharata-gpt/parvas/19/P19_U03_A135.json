      "bhavadeepa": null,
      "chapter": 318,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हरिवंशश्रवणफलं मभारातसमाप्तिश्च"
    },
    {
      "verse": 2,
      "sanskrit": "वैशम्पायन उवाच।\n              हरिवंशे पुराणे तु श्रुते च भरतोत्तम। कायिकं वाचिकं चैव मनसा समुपार्जितम्॥२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 318,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हरिवंशश्रवणफलं मभारातसमाप्तिश्च"
    },
    {
      "verse": 3,
      "sanskrit": "तत्सर्वं नाशमायाति हिमं सूर्योदये यथा। अष्टादशपुराणानां श्रवणाद्यत्फलं भवेत्॥३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 318,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हरिवंशश्रवणफलं मभारातसमाप्तिश्च"
    },
    {
      "verse": 4,
      "sanskrit": "तत्फलं समवाप्नोति वैष्णवो नात्र संशयः। श्लोकार्धं श्लोकपादं वा हरिवंशसमुद्भवम्॥४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 318,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हरिवंशश्रवणफलं मभारातसमाप्तिश्च"
    },
    {
      "verse": 5,
      "sanskrit": "शृण्वन्ति श्रद्धया युक्ता वैष्णवं पदमाप्नुयुः। जम्बुद्वीपं समाश्रित्य श्रोतारो दुर्लभाः कलौ॥५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 318,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हरिवंशश्रवणफलं मभारातसमाप्तिश्च"
    },
    {
      "verse": 6,
      "sanskrit": "भविष्यन्ति नरा राजन्सत्यं सत्यं वदाम्यहम्। स्त्रीभिश्च पुत्रकामाभिः श्रोतव्यं वैष्णवं यशः॥६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 318,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हरिवंशश्रवणफलं मभारातसमाप्तिश्च"
    },
    {
      "verse": 7,
      "sanskrit": "दक्षिणा चात्र देया वै निष्कत्रयसुवर्णकम्। वाचकाय यथाशक्त्या यथोक्तं फलमिच्छता॥७॥",
      "english": null,
