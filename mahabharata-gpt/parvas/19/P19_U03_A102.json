{
  "adhyaya_id": "P19_U03_A102",
  "book": 19,
  "parva_name": "हरिवंशः",
  "upaparva_name": "भविष्यपर्व",
  "adhyaya_name": "एकलव्यनिर्याणम्",
  "chapter": 285,
  "verse_count": 24,
  "verses": [
    {
      "verse": 1,
      "sanskrit": "वैशम्पायन उवाच।\n              निषादेशं ततो रामः शक्त्या वीर्यवतां वरः। आजघान स्तनद्वन्द्वे सिंहनादं व्यनीनदत्॥१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 285,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "एकलव्यनिर्याणम्"
    },
    {
      "verse": 2,
      "sanskrit": "ततः क्रुद्धो निषादेशो रामं मत्तं महाबलम्। गदया लोकविख्यातो जघान स्तनवक्षसि॥२॥",
      "english": null,
      "bhavadeepa": "निषादेशमिति। निषादेशम् एककव्यम्॥१॥",
      "chapter": 285,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "एकलव्यनिर्याणम्"
    },
    {
      "verse": 3,
      "sanskrit": "आहतः स तु तेनाशु बलभद्रो महाबलः। उभाभ्यां चैव रामस्तु कराभ्यां वृष्णिपुङ्गवः॥३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 285,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "एकलव्यनिर्याणम्",
      "combined_translation": "3-3"
    },
    {
      "verse": 4,
      "sanskrit": "गदां गृह्य महाघोरामायान्तीं प्राणहारिणीम्। दुद्रावाथ निषादेशः समुद्रं मकरालयम्॥४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 285,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "एकलव्यनिर्याणम्",
      "combined_translation": "4-4"
    },
    {
      "verse": 4,
      "sanskrit": "तस्मिञ्छासति देवेशे राज्यं निष्कण्टकं प्रभो। सुखमेव प्रजाः सर्वा जीवन्ति ब्राह्मणादयः॥४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 285,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "एकलव्यनिर्याणम्",
      "combined_translation": "4-4"
    },
    {
      "verse": 5,
      "sanskrit": "धावत्येवं तदा राज्ञि एकलव्ये निषादपे। धावत्येवं च रामोऽपि यत्र यातो निषादपः॥५॥",
      "english": null,
      "bhavadeepa": "प्राणहारिणीं ज्ञात्वा दुद्राव॥४॥",
      "chapter": 285,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "एकलव्यनिर्याणम्",
      "combined_translation": "5-5"
    },
    {
      "verse": 6,
      "sanskrit": "सागरं स प्रविश्याशु गत्वा योजनपञ्चकम्। भीत एव तदा राजन्नेकलव्यो निषादपः॥६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 285,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "एकलव्यनिर्याणम्",
      "combined_translation": "6-6"
    },
    {
      "verse": 7,
      "sanskrit": "किञ्चिद्द्वीपान्तरं राजन्प्रविश्य न्यवसत्तदा। ततो रामो निषादेशं जिगाय यदुनन्दनः॥७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 285,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "एकलव्यनिर्याणम्",
      "combined_translation": "7-7"
    },
    {
      "verse": 8,
      "sanskrit": "तां सभां मणिरत्नाढ्यां प्रविवेश हलायुधः। सात्यकिर्युद्धसंसक्तस्तां सभां प्रविवेश ह॥८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 285,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "एकलव्यनिर्याणम्",
      "combined_translation": "8-8"
    },
    {
      "verse": 9,
      "sanskrit": "अन्ये च यादवा राजन्तथायोगमुपस्थिताः। आसीनेषु च सर्वेषु वृष्णिवीरेषु सर्वतः॥९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 285,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "एकलव्यनिर्याणम्",
      "combined_translation": "9-9"
    },
    {
      "verse": 10,
      "sanskrit": "अभिवाद्य यथायोगं वृष्णीन्सर्वाश्च केशवः। उवाच वचनं काले भगवान्देवकीसुतः॥१०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 285,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "एकलव्यनिर्याणम्",
      "combined_translation": "10-10"
    },
    {
      "verse": 11,
      "sanskrit": "दृष्टं कैलासशिखरं शङ्करो नीललोहितः। स तु मह्यं यदुवरः प्रीतिमांश्च ददौ वरम्॥११॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 285,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "एकलव्यनिर्याणम्",
      "combined_translation": "11-11"
    },
    {
      "verse": 12,
      "sanskrit": "तत्र देवाः समायाता मुनयश्च तपोधनाः। दृष्ट्वा मां शङ्करश्चैव प्रीतः स्तुत्वा समाययौ॥१२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 285,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "एकलव्यनिर्याणम्",
      "combined_translation": "12-12"
    },
    {
      "verse": 13,
      "sanskrit": "अत्यद्भुतं मया दृष्टं रात्रौ यादवसत्तमः। पिशाचौ द्वौ महाघोरौ वदन्तौ मामिकां कथाम्॥१३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 285,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "एकलव्यनिर्याणम्",
      "combined_translation": "13-13"
    },
    {
      "verse": 14,
      "sanskrit": "मृगयां चक्रतुस्तौ तु चिन्तयन्तौ तु मां सदा। दृष्ट्वा मां तौ तु राजेन्द्राः प्रीतिमन्तौ तपस्विनौ॥१४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 285,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "एकलव्यनिर्याणम्",
      "combined_translation": "14-14"
    },
    {
      "verse": 15,
      "sanskrit": "भक्तिनम्रौ महात्मानौ प्रणामं चक्रतुस्तदा। ततोऽहं सर्वथा प्रीतस्तौ नीतौ स्वर्गमुत्तमम्॥१५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 285,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "एकलव्यनिर्याणम्",
      "combined_translation": "15-15"
    },
    {
      "verse": 16,
      "sanskrit": "तोषयित्वा महादेवं मया चाद्य समागतम्।\n              वैशम्पायन उवाच।\n              ततस्ते वृष्णयः सर्वे देवदेवं शशंसिरे॥१६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 285,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "एकलव्यनिर्याणम्",
      "combined_translation": "16-16"
    },
    {
      "verse": 17,
      "sanskrit": "सर्वथा कृतकृत्यास्ते वृष्णयः केशवाश्रयाः। यादवाः सर्व एवैते स्वं स्वं जग्मुर्यथालयम्॥१७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 285,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "एकलव्यनिर्याणम्",
      "combined_translation": "17-17"
    },
    {
      "verse": 18,
      "sanskrit": "अभ्यन्तरे जगन्नाथः प्रविश्य हरिरीश्वरः। रुक्मिणीसत्यभामाभ्यामाचचक्षे यथाभवत्॥१८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 285,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "एकलव्यनिर्याणम्",
      "combined_translation": "18-18"
    },
    {
      "verse": 19,
      "sanskrit": "ते प्रीते प्रीतियुक्तेन केशवेन समन्विते। एतत्ते सर्वमाख्यातं केशवस्य विचेष्टितम्॥१९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 285,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "एकलव्यनिर्याणम्",
      "combined_translation": "19-19"
    },
    {
      "verse": 20,
      "sanskrit": "शशास पृथिवीं कृत्स्नां दुष्टान्हत्वा महाबलान्। नरकं घोरकर्मणं पौण्ड्रकं नृपसत्तमम्॥२०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 285,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "एकलव्यनिर्याणम्",
      "combined_translation": "20-20"
    },
    {
      "verse": 21,
      "sanskrit": "हयग्रीवं निशुम्भं च तथा सुन्दोपसुन्दकौ। ररक्ष विप्रान्देवेशो मुनीन्मुनिवरार्चितः॥२१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 285,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "एकलव्यनिर्याणम्",
      "combined_translation": "21-21"
    },
    {
      "verse": 22,
      "sanskrit": "विप्रेभ्यश्च ददौ वित्तं गाश्च दत्त्वा स केशवः। अग्निहोत्रं प्रयुञ्जानो ब्राह्मणांश्च सुतर्पयन्॥२२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 285,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "एकलव्यनिर्याणम्",
      "combined_translation": "22-22"
    },
    {
      "verse": 23,
      "sanskrit": "मुनींश्च ब्रह्मचर्येण देवान्यज्ञैरनेकधा। स्वधया च पितॄन्सर्वान्प्रीणयन्नेव सर्वदा॥२३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 285,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "एकलव्यनिर्याणम्",
      "combined_translation": "23-23"
    }
  ]
}