{
  "adhyaya_id": "P19_U03_A112",
  "book": 19,
  "parva_name": "हरिवंशः",
  "upaparva_name": "भविष्यपर्व",
  "adhyaya_name": "कृष्णस्य हंसडिम्भकवधप्रतिज्ञा यतिभोजनं च",
  "chapter": 295,
  "verse_count": 24,
  "verses": [
    {
      "verse": 1,
      "sanskrit": "वैशम्पायन उवाच।\n              यतेर्वचनमाकर्ण्य मन्दमुच्छ्वस्य केशवः। दुर्वाससं समालोक्य बभाषे यादवेश्वरः॥१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 295,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "कृष्णस्य हंसडिम्भकवधप्रतिज्ञा यतिभोजनं च"
    },
    {
      "verse": 2,
      "sanskrit": "क्षन्तव्यं भवता सर्वं दोष एव ममैव हि। शृणु वाक्यं ममैतत्तु श्रुत्वा शान्तिपरो भव॥२॥",
      "english": null,
      "bhavadeepa": "यतेरिति॥१॥",
      "chapter": 295,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "कृष्णस्य हंसडिम्भकवधप्रतिज्ञा यतिभोजनं च",
      "combined_translation": "2-2"
    },
    {
      "verse": 3,
      "sanskrit": "जेष्यामि तौ रणे विप्र हंसं डिम्भकमेव च। गिरीशो वा वरं दद्याच्छक्रो वा धनदोऽपि वा॥३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 295,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "कृष्णस्य हंसडिम्भकवधप्रतिज्ञा यतिभोजनं च",
      "combined_translation": "3-3"
    },
    {
      "verse": 4,
      "sanskrit": "यमो वा वरुणो वापि ब्रह्मा वाथ चतुर्मुखः। सबलौ सानुजौ हत्वा पुनर्दास्यामि वो रतिम्॥४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 295,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "कृष्णस्य हंसडिम्भकवधप्रतिज्ञा यतिभोजनं च",
      "combined_translation": "4-4"
    },
    {
      "verse": 5,
      "sanskrit": "सत्येनैव शपाम्यद्य मा रोषवशगो भव। रक्षां वोऽहं करिष्यामि हत्वा तौ च नृपाधमौ॥५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 295,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "कृष्णस्य हंसडिम्भकवधप्रतिज्ञा यतिभोजनं च",
      "combined_translation": "5-5"
    },
    {
      "verse": 6,
      "sanskrit": "जानामि तौ दुरात्मानौ युष्मद्दोषकरौ हि तौ। श्रुतं च पूर्वमस्माभिस्तीक्ष्णदण्डधराविति॥६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 295,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "कृष्णस्य हंसडिम्भकवधप्रतिज्ञा यतिभोजनं च",
      "combined_translation": "6-6"
    },
    {
      "verse": 7,
      "sanskrit": "अत्यन्तबलिनौ मत्तौ गिरीशवरदर्पितौ। नाल्पप्रयत्नसंसाध्यौ जरासन्धहितैषिणौ॥७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 295,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "कृष्णस्य हंसडिम्भकवधप्रतिज्ञा यतिभोजनं च",
      "combined_translation": "7-7"
    },
    {
      "verse": 8,
      "sanskrit": "प्राणानपि तयो राजा दास्यत्येव न संशयः। जरासन्धो महीपालो विना तौ जयते महीम्॥८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 295,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "कृष्णस्य हंसडिम्भकवधप्रतिज्ञा यतिभोजनं च",
      "combined_translation": "8-8"
    },
    {
      "verse": 9,
      "sanskrit": "जये तयोर्विप्रवर्य तत्र श्रेयो भवेत्ततः। यत्र यत्र तु तौ गत्वा स्थितावित्यनुशुश्रुम॥९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 295,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "कृष्णस्य हंसडिम्भकवधप्रतिज्ञा यतिभोजनं च",
      "combined_translation": "9-9"
    },
    {
      "verse": 10,
      "sanskrit": "तत्र तत्र च हन्ताहं नात्र कार्या विचारणा। गच्छध्वं यतयः स्वैरं निजकार्यपरायणाः॥१०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 295,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "कृष्णस्य हंसडिम्भकवधप्रतिज्ञा यतिभोजनं च",
      "combined_translation": "10-10"
    },
    {
      "verse": 11,
      "sanskrit": "अचिरेणैव कालेन जेष्यामि रणपुङ्गवौ। ततः प्रीतः प्रसन्नात्मा यादवेश्वरमाह सः॥११॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 295,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "कृष्णस्य हंसडिम्भकवधप्रतिज्ञा यतिभोजनं च",
      "combined_translation": "11-11"
    },
    {
      "verse": 12,
      "sanskrit": "स्वस्त्यस्तु भवते कृष्ण जगतां स्वस्ति कुर्वते। किन्नु नाम जगन्नाथ दुःसाध्यं तव केशव॥१२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 295,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "कृष्णस्य हंसडिम्भकवधप्रतिज्ञा यतिभोजनं च",
      "combined_translation": "12-12"
    },
    {
      "verse": 13,
      "sanskrit": "त्रिलोकेश त्रिधामासि सर्वसंहारकारकः। देवानामपि देवेश सर्वत्र समदर्शनः॥१३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 295,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "कृष्णस्य हंसडिम्भकवधप्रतिज्ञा यतिभोजनं च",
      "combined_translation": "13-13"
    },
    {
      "verse": 14,
      "sanskrit": "विष्णो देव हरे कृष्ण नमस्ते चक्रपाणये। नमः स्वभावशुद्धाय शुद्धाय नियताय च॥१४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 295,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "कृष्णस्य हंसडिम्भकवधप्रतिज्ञा यतिभोजनं च",
      "combined_translation": "14-14"
    },
    {
      "verse": 15,
      "sanskrit": "शब्दगोचर देवेश नमस्ते भक्तवत्सल। अज्ञानादथवा ज्ञानाद्यन्मयोक्तं क्षमस्व तत्॥१५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 295,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "कृष्णस्य हंसडिम्भकवधप्रतिज्ञा यतिभोजनं च",
      "combined_translation": "15-15"
    },
    {
      "verse": 16,
      "sanskrit": "त्वमेवाहं जगन्नाथ नावयोरन्तरं पृथक्। अतः क्षमस्व भगवन्क्षमासारा हि साधवः॥१६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 295,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "कृष्णस्य हंसडिम्भकवधप्रतिज्ञा यतिभोजनं च",
      "combined_translation": "16-16"
    },
    {
      "verse": 17,
      "sanskrit": "श्रीभगवानुवाच।\n              क्षन्तव्यं भवता विप्र क्षमासारा वयं तदा। संन्यासिनः क्षमासाराः क्षमा तेषां परं बलम्॥१७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 295,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "कृष्णस्य हंसडिम्भकवधप्रतिज्ञा यतिभोजनं च",
      "combined_translation": "17-17"
    },
    {
      "verse": 18,
      "sanskrit": "क्षमा मोक्षकरी नित्यं तत्त्वज्ञानमिव द्विज। क्षमा धर्मः क्षमा सत्यं क्षमा दानं क्षमा यशः॥१८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 295,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "कृष्णस्य हंसडिम्भकवधप्रतिज्ञा यतिभोजनं च",
      "combined_translation": "18-18"
    },
    {
      "verse": 19,
      "sanskrit": "क्षमा स्वर्गस्य सोपानमिति वेदविदो विदुः। तस्मात्सर्वप्रयत्नेन क्षमां पालयत स्वकाम्॥१९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 295,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "कृष्णस्य हंसडिम्भकवधप्रतिज्ञा यतिभोजनं च"
    },
    {
      "verse": 20,
      "sanskrit": "प्रत्यक्षज्ञानसंयुक्ता यूयं सर्वे यतीश्वराः। य एते यतयो विप्राः पूजनीया मयाद्य वै॥२०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 295,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "कृष्णस्य हंसडिम्भकवधप्रतिज्ञा यतिभोजनं च",
      "combined_translation": "20-20"
    },
    {
      "verse": 21,
      "sanskrit": "भोक्तव्या यतयो विप्रा भिक्षुकाः सर्व एव हि। तथेति ते प्रतिज्ञाय भोक्तुमैच्छन्हरेर्गृहे॥२१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 295,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "कृष्णस्य हंसडिम्भकवधप्रतिज्ञा यतिभोजनं च",
      "combined_translation": "21-21"
    },
    {
      "verse": 22,
      "sanskrit": "ततः स्वभवनं विष्णुः प्रविश्य हरिरीश्वरः। चतुर्विधं तथाहारं कारयित्वा यथाविधि॥२२॥",
      "english": null,
      "bhavadeepa": "भोक्तव्याः भोजनीयाः॥२१॥",
      "chapter": 295,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "कृष्णस्य हंसडिम्भकवधप्रतिज्ञा यतिभोजनं च",
      "combined_translation": "22-22"
    },
    {
      "verse": 23,
      "sanskrit": "भोजयामास तान्सर्वान्यतीन्यतिवरार्चितः। छित्वा छित्वा च देवेशो दुकूलानि मृदूनि सः॥२३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 295,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "कृष्णस्य हंसडिम्भकवधप्रतिज्ञा यतिभोजनं च",
      "combined_translation": "23-23"
    },
    {
      "verse": 24,
      "sanskrit": "ददौ तेभ्यस्तदा विष्णुः सर्वेभ्यो जनमेजय। ते च प्रीता यथायोगं यथापूर्वं ततो गताः॥२४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 295,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "कृष्णस्य हंसडिम्भकवधप्रतिज्ञा यतिभोजनं च",
      "combined_translation": "24-24"
    }
  ]
}