{
  "adhyaya_id": "P19_U03_A098",
  "book": 19,
  "parva_name": "हरिवंशः",
  "upaparva_name": "भविष्यपर्व",
  "adhyaya_name": "एकलव्यसैन्यवधः",
  "chapter": 281,
  "verse_count": 25,
  "verses": [
    {
      "verse": 1,
      "sanskrit": "वैशम्पायन उवाच।\n              एतस्मिन्नन्तरे क्रुद्ध एकलव्यो निषादपः। बलभद्रमभिक्षिप्रं धनुरादाय सत्वरम्॥१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 281,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "एकलव्यसैन्यवधः",
      "combined_translation": "1-27"
    },
    {
      "verse": 2,
      "sanskrit": "नाराचैर्दशभिर्विद्ध्वा बाणैश्च दशभिः परैः। चिच्छेद धनुरर्धं तत्सर्वक्षत्रस्य पश्यतः॥२॥",
      "english": null,
      "bhavadeepa": "एतस्मिन्निति॥१॥",
      "chapter": 281,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "एकलव्यसैन्यवधः",
      "combined_translation": "2-2"
    },
    {
      "verse": 3,
      "sanskrit": "सूतं दशभिराहत्य रथं त्रिंशद्भिरेव च। ध्वजं चिच्छेद भल्लेन निषादस्य जगत्पतिः॥३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 281,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "एकलव्यसैन्यवधः",
      "combined_translation": "3-3"
    },
    {
      "verse": 4,
      "sanskrit": "ततः परं महच्चापं निषादो वीर्यसम्मतः। दृढमौर्व्या समायुक्तं दशतालप्रमाणतः॥४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 281,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "एकलव्यसैन्यवधः",
      "combined_translation": "4-4"
    },
    {
      "verse": 5,
      "sanskrit": "कामपालं शरेणाशु जघान जनमध्यतः। बलदेवो महावीर्यः सर्पः शेष इव श्वसन्॥५॥",
      "english": null,
      "bhavadeepa": "दशतालप्रमाणतः दशप्रादेशसम्मितम्॥४॥",
      "chapter": 281,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "एकलव्यसैन्यवधः",
      "combined_translation": "5-5"
    },
    {
      "verse": 6,
      "sanskrit": "दशभिस्तद्धनुर्दिव्यं शरैः सर्पसमैर्बलः। चिच्छेद मुष्टिदेशे तु माधवो माधवाग्रजः॥६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 281,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "एकलव्यसैन्यवधः",
      "combined_translation": "6-6"
    },
    {
      "verse": 7,
      "sanskrit": "एकलव्यो निषादेशः खड्गमादाय सत्वरः। प्राहिणोद्बलमादाय निशितं घोरविग्रहम्॥७॥",
      "english": null,
      "bhavadeepa": "माधवो मधुवंश्यः माधवाग्रजो लक्ष्मीपतेर्ज्येष्ठभ्राता॥६॥",
      "chapter": 281,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "एकलव्यसैन्यवधः",
      "combined_translation": "7-7"
    },
    {
      "verse": 8,
      "sanskrit": "तमन्तरे पटुर्वीरो वृष्णिवीरः प्रतापवान्। तिलशः पञ्चभिर्बाणैश्चकार यदुनन्दनः॥८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 281,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "एकलव्यसैन्यवधः",
      "combined_translation": "8-8"
    },
    {
      "verse": 9,
      "sanskrit": "ततोऽपरं महत्खड्गं सर्वकालायसं शुभम्। प्राहिणोत्सारथेः कायमालोक्याथ निषादजः॥९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 281,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "एकलव्यसैन्यवधः",
      "combined_translation": "9-9"
    },
    {
      "verse": 10,
      "sanskrit": "तं चापि दशभिर्वीरो माधवो यदुनन्दनः। बाह्वोरन्तरयोश्चैव निर्बिभेद महारणे॥१०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 281,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "एकलव्यसैन्यवधः",
      "combined_translation": "10-10"
    },
    {
      "verse": 11,
      "sanskrit": "ततः शक्तिं समादाय घण्टामालाकुलां नृपः। निषादो बलदेवाय प्रेषयित्वा महाबलः॥११॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 281,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "एकलव्यसैन्यवधः",
      "combined_translation": "11-11"
    },
    {
      "verse": 12,
      "sanskrit": "सिंहनादं महाघोरमकरोत्स निषादपः। स शक्तिः सर्वकल्याणी बलदेवमुपागतम्॥१२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 281,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "एकलव्यसैन्यवधः",
      "combined_translation": "12-12"
    },
    {
      "verse": 13,
      "sanskrit": "उत्पतन्तीं महाघोरां बलभद्रः प्रतापवान्। आदायाथ निषादेशं सर्वान्विस्मापयन्निव॥१३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 281,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "एकलव्यसैन्यवधः",
      "combined_translation": "13-13"
    },
    {
      "verse": 14,
      "sanskrit": "तथैव तं जघानाशु वक्षोदेशे च माधवः। स तया ताडितो वीरः स्वशक्त्याथ निषादपः॥१४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 281,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "एकलव्यसैन्यवधः",
      "combined_translation": "14-14"
    },
    {
      "verse": 15,
      "sanskrit": "विह्वलः सर्वगात्रेषु निपपात महीतले। प्राणसंशयमापन्नो निषादो रामताडितः॥१५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 281,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "एकलव्यसैन्यवधः",
      "combined_translation": "15-15"
    },
    {
      "verse": 16,
      "sanskrit": "निषादास्तस्य राजेन्द्र शतशोऽथ सहस्रशः। अष्टाशीतिसहस्राणि निषादास्तस्य योधिनः॥१६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 281,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "एकलव्यसैन्यवधः",
      "combined_translation": "16-16"
    },
    {
      "verse": 17,
      "sanskrit": "गदिनः खड्गिनश्चैव महेष्वासा महाबलाः। शरैरनेकसहस्रैः शक्तिभिश्च परश्वधैः॥१७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 281,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "एकलव्यसैन्यवधः",
      "combined_translation": "17-17"
    },
    {
      "verse": 18,
      "sanskrit": "गदाभिः पट्टिशैः शूलैः परिघैः प्रासतोमरैः। कुन्तैरथ कुठारैश्च यदवानां महौजसाम्॥१८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 281,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "एकलव्यसैन्यवधः",
      "combined_translation": "18-18"
    },
    {
      "verse": 19,
      "sanskrit": "शलभा इव राजेन्द्र दीप्यमानं हुताशनम्। ते शरैः पातयाञ्चक्रू रामं राममिवापरम्॥१९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 281,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "एकलव्यसैन्यवधः",
      "combined_translation": "19-19"
    },
    {
      "verse": 20,
      "sanskrit": "केचित्कुठारैराजघ्नुः केचित्कुन्तैः परश्वधैः। गदाभिः केचिदाघ्नन्ति शक्तिभिश्च तथा परे॥२०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 281,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "एकलव्यसैन्यवधः",
      "combined_translation": "20-20"
    },
    {
      "verse": 21,
      "sanskrit": "निजघ्नुः सहसा रामं स्फुरन्तं पावकं यथा। ततः क्रुद्धो हली साक्षाद्धलमुद्यम्य सत्वरम्॥२१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 281,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "एकलव्यसैन्यवधः",
      "combined_translation": "21-21"
    },
    {
      "verse": 22,
      "sanskrit": "सर्वानकर्षयामास मुसलेन हि पीडयन्। ते हन्यामाना राजेन्द्र निषादाः पर्वताश्रयाः॥२२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 281,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "एकलव्यसैन्यवधः",
      "combined_translation": "22-22"
    },
    {
      "verse": 23,
      "sanskrit": "निपेतुर्धरणीपृष्ठे शतशोऽथ सहस्रशः। क्षणेन तन्महाराज हत्वा सर्वान्महाबलान्॥२३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 281,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "एकलव्यसैन्यवधः",
      "combined_translation": "23-23"
    },
    {
      "verse": 24,
      "sanskrit": "सिंहवद्व्ययनदंस्तत्र तस्थौ रामो महाबलः। ततो रात्रौ महाघोराः पिशाचाः पिशिताशनाः॥२४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 281,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "एकलव्यसैन्यवधः",
      "combined_translation": "24-24"
    },
    {
      "verse": 25,
      "sanskrit": "आकृष्य मांसयूथानि भक्षयन्तः समासते। पिबन्तः शोणितं कोष्ठात्सञ्छिद्य च शवं बहु॥२५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 281,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "एकलव्यसैन्यवधः",
      "combined_translation": "25-25"
    }
  ]
}