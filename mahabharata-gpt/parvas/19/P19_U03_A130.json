  "chapter": 313,
  "verse_count": 20,
  "verses": [
    {
      "verse": 1,
      "sanskrit": "वैशम्पायन उवाच।\n              यशोदा नन्दगोपश्च कृष्णदर्शनलालसौ। गोवर्धनगतं श्रुत्वा वासुदेवं सहाग्रजम्॥१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 313,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "नन्दयशोदयोर्गोवर्धने श्रीकृष्णदर्शनम्"
    },
    {
      "verse": 2,
      "sanskrit": "नवनीतं च दधि च पायसं कृसरं तथा। वन्यं पुष्पं महाराज मयूराङ्गदमेव च॥२॥",
      "english": null,
      "bhavadeepa": "यशोदेति॥१॥",
      "chapter": 313,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "नन्दयशोदयोर्गोवर्धने श्रीकृष्णदर्शनम्"
    },
    {
      "verse": 3,
      "sanskrit": "बल्लवैरपरैः सार्धं गोपिभिश्च समन्ततः। जग्मतुः सहसा प्रीतौ गोवर्धनमथो नृप॥३॥",
      "english": null,
      "bhavadeepa": "मयूराङ्गदं मयूरपिच्छमयं बाहुभूषणम्॥२॥",
      "chapter": 313,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "नन्दयशोदयोर्गोवर्धने श्रीकृष्णदर्शनम्"
    },
    {
      "verse": 4,
      "sanskrit": "क्वचिद्वृक्षे समासक्तं कृष्णं कृष्णमृगेक्षणम्। ददर्शतुर्महाबाहुं वासुदेवं सहाग्रजम्॥४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 313,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "नन्दयशोदयोर्गोवर्धने श्रीकृष्णदर्शनम्"
    },
    {
      "verse": 5,
      "sanskrit": "प्रणेमतुः सुसंहृष्टौ तत्र दृष्ट्वा महाबलौ। दर्शयामासतुर्देवौ पायसानि महान्ति च॥५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 313,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "नन्दयशोदयोर्गोवर्धने श्रीकृष्णदर्शनम्"
    },
    {
      "verse": 6,
      "sanskrit": "तात मातर्व्रजे गोष्ठे कुशलं वा स्वगोधनम्। अपि गावः क्षीरवत्यो वत्सा वत्सतराः पितः॥६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 313,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "नन्दयशोदयोर्गोवर्धने श्रीकृष्णदर्शनम्"
    },
    {
      "verse": 7,
      "sanskrit": "अपि वा सुशुभं क्षीरमपि गावः सुशोभनाः। अपि वा दारका मातर्वत्सपालाः पिबन्ति च॥७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 313,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "नन्दयशोदयोर्गोवर्धने श्रीकृष्णदर्शनम्"
    },
    {
      "verse": 8,
      "sanskrit": "बहूनि चापि दामानि कीलका अपि वा बहु। तृणानि बहुरूपाणि किं वा सन्ति पितः सदा॥८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 313,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "नन्दयशोदयोर्गोवर्धने श्रीकृष्णदर्शनम्"
    },
    {
      "verse": 9,
      "sanskrit": "शकटानि सुगन्धीनि किं वा सन्ति पितर्ध्रुवम्। अपि गोप्यः पुत्रवत्यो दारकान्किमजीजनन्॥९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 313,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "नन्दयशोदयोर्गोवर्धने श्रीकृष्णदर्शनम्"
    },
    {
      "verse": 10,
      "sanskrit": "घटाः किं बहवो मातरभिन्नाः सर्वतो व्रजे। किं गावः क्षीरमतुलं स्रवन्त्यहरहः पितः॥१०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 313,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "नन्दयशोदयोर्गोवर्धने श्रीकृष्णदर्शनम्"
    },
    {
      "verse": 11,
      "sanskrit": "हैयङ्गवीनं क्षीराणि दधि वा किमजीजनन्। गोधनं सर्वमेवेदं नीरोगं प्रतिपद्यते॥११॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 313,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "नन्दयशोदयोर्गोवर्धने श्रीकृष्णदर्शनम्"
    },
    {
      "verse": 12,
      "sanskrit": "नन्द उवाच।\n              सर्वमेतद्यदुश्रेष्ठ नीरोगं बहुशः प्रभो। कुशलं गोधनस्यैव सर्वकालेषु केशव॥१२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 313,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "नन्दयशोदयोर्गोवर्धने श्रीकृष्णदर्शनम्"
    },
    {
      "verse": 13,
      "sanskrit": "रक्षणात्तव देवेश सदा कुशलिनो वयम्। सगोधनाः सवत्साश्च नीरोगा इव केशव॥१३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 313,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "नन्दयशोदयोर्गोवर्धने श्रीकृष्णदर्शनम्"
    },
    {
      "verse": 14,
      "sanskrit": "एकमेव सदा दुःखं न त्वां द्रक्ष्यामि केशव। यदेतत्केवलं दुःखमिति धीः शीर्यते सदा॥१४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 313,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "नन्दयशोदयोर्गोवर्धने श्रीकृष्णदर्शनम्"
    },
    {
      "verse": 15,
      "sanskrit": "वैशम्पायन उवाच।\n              एवमादि विलप्यन्तं गच्छेत्याह स केशवः। यशोदां पुनराहेदं मातर्गच्छ गृहं प्रति॥१५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 313,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "नन्दयशोदयोर्गोवर्धने श्रीकृष्णदर्शनम्"
    },
    {
      "verse": 16,
      "sanskrit": "ये च त्वां कीर्तयिष्यन्ति ते च स्वर्गमवाप्नुयुः। ये केचित्त्वां नमस्यन्ति ते मे प्रियतराः सदा॥१६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 313,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "नन्दयशोदयोर्गोवर्धने श्रीकृष्णदर्शनम्"
    },
    {
      "verse": 17,
      "sanskrit": "मद्भक्ताः सर्वदा सन्तु गच्छेत्याह च तां हरिः। इत्युक्त्वा पितरौ देवो वासुदेवः सनातनः॥१७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 313,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "नन्दयशोदयोर्गोवर्धने श्रीकृष्णदर्शनम्"
    },
    {
      "verse": 18,
      "sanskrit": "गाढमालिङ्ग्य तौ प्रीतौ प्रेषयामास केशवः। यशोदा नन्दगोपश्च जग्मतुः स्वगृहं प्रति॥१८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 313,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "नन्दयशोदयोर्गोवर्धने श्रीकृष्णदर्शनम्"
    },
    {
      "verse": 19,
      "sanskrit": "ततः कृष्णो हृषीकेशो यादवैः सह वृष्णिभिः। गन्तुमैच्छत्तदा विष्णुः पुरीं द्वारवतीं किल॥१९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 313,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "नन्दयशोदयोर्गोवर्धने श्रीकृष्णदर्शनम्"
    },
    {
      "verse": 20,
      "sanskrit": "य एतच्छ्रुणुयान्नित्यं पठेद्वापि समाहितः। पुत्रवान्धनवांश्चैव अन्ते मोक्षं च गच्छति॥२०॥",
