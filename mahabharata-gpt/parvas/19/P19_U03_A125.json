{
  "adhyaya_id": "P19_U03_A125",
  "book": 19,
  "parva_name": "हरिवंशः",
  "upaparva_name": "भविष्यपर्व",
  "adhyaya_name": "सात्यकिडिम्भकयोर्युद्धम्",
  "chapter": 308,
  "verse_count": 27,
  "verses": [
    {
      "verse": 1,
      "sanskrit": "वैशम्पायन उवाच।\n              युद्धं चक्रतुरत्यर्थं ततो डिम्भकसात्यकी। तावुभौ बलिनौ वीरौ विख्यातौ क्षत्रियेषु च॥१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 308,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "सात्यकिडिम्भकयोर्युद्धम्",
      "combined_translation": "1-23"
    },
    {
      "verse": 2,
      "sanskrit": "कृतश्रमौ महायुद्धे सततं वृद्धसेविनौ। सात्यकिर्दशभिर्वीरो डिम्भकं वेदपारगम्॥२॥",
      "english": null,
      "bhavadeepa": "युद्धमिति॥१॥",
      "chapter": 308,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "सात्यकिडिम्भकयोर्युद्धम्",
      "combined_translation": "2-2"
    },
    {
      "verse": 3,
      "sanskrit": "अविध्यन्निशितैर्बाणैस्तेन वक्त्रे तथोरसि। स तेन विद्धो बलिना डिम्भकः क्षत्रियोत्तमः॥३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 308,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "सात्यकिडिम्भकयोर्युद्धम्",
      "combined_translation": "3-3"
    },
    {
      "verse": 4,
      "sanskrit": "नाराचैः पञ्चसाहस्रैर्विव्याध युधि गर्वितः। तानन्तरे वृष्णिवीरो निषिद्धन्निनदन्ब्रुवन्॥४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 308,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "सात्यकिडिम्भकयोर्युद्धम्"
    },
    {
      "verse": 5,
      "sanskrit": "अथ क्रुद्धो नृपवरो विद्धः सप्तभिराशुगैः। पुनः शतसहस्रेण प्रत्यविध्यत सात्यकिम्॥५॥",
      "english": null,
      "bhavadeepa": "निषिद्धन् खण्डयन्। निनदन् गर्हन्। ब्रयवन् गर्जितशब्देनैव तेषां निषेधं चकारेत्यर्थः॥४॥",
      "chapter": 308,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "सात्यकिडिम्भकयोर्युद्धम्",
      "combined_translation": "5-5"
    },
    {
      "verse": 6,
      "sanskrit": "सात्यकिस्त्वथ विक्रान्तो धनुश्चिच्छेद तस्य तत्। अर्धचन्द्रेण तीक्ष्णेन डिम्भकस्य स यादवः॥६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 308,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "सात्यकिडिम्भकयोर्युद्धम्",
      "combined_translation": "6-6"
    },
    {
      "verse": 7,
      "sanskrit": "आजघ्ने डिम्भको वीरश्चापमादाय चापरम्। क्षुरप्रेणाथ रौद्रेण तैलधौतेन विक्रमी॥७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 308,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "सात्यकिडिम्भकयोर्युद्धम्",
      "combined_translation": "7-7"
    },
    {
      "verse": 8,
      "sanskrit": "स तेन विद्धो बाणेन वमञ्छोणितकं नृप। अतीव शुशुभे राजन्वसन्ते किंशुको यथा॥८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 308,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "सात्यकिडिम्भकयोर्युद्धम्",
      "combined_translation": "8-8"
    },
    {
      "verse": 9,
      "sanskrit": "धनुश्चिच्छेद भूयस्तु गृहीतं यत्पूरा धनुः। ततोऽन्यद्धनुरादाय डिम्भको यादवेश्वरम्॥९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 308,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "सात्यकिडिम्भकयोर्युद्धम्",
      "combined_translation": "9-9"
    },
    {
      "verse": 10,
      "sanskrit": "जघान निशितैर्बाणैः सर्वक्षत्रस्य पश्यतः। स धनुः पुनरत्युग्रं चिच्छेद युधि सात्यकिः॥१०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 308,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "सात्यकिडिम्भकयोर्युद्धम्"
    },
    {
      "verse": 11,
      "sanskrit": "शरेण तीक्ष्णपुङ्खेन डिम्भकस्य दुरात्मनः। ततोऽन्यद्धनुरादाय सत्वरं स नृपोत्तमः॥११॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 308,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "सात्यकिडिम्भकयोर्युद्धम्",
      "combined_translation": "11-11"
    },
    {
      "verse": 12,
      "sanskrit": "धनुषा तेन राजेन्द्र सात्यकिं विव्यधे पुनः। एवं धनूंषि राजेन्द्र शतं पञ्च च पञ्च च॥१२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 308,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "सात्यकिडिम्भकयोर्युद्धम्",
      "combined_translation": "12-12"
    },
    {
      "verse": 13,
      "sanskrit": "छित्त्वा ननाद शैनेयः सर्वक्षत्रस्य पश्यतः। धनुषी तौ परित्यज्य वीरौ डिम्भकसात्यकी॥१३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 308,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "सात्यकिडिम्भकयोर्युद्धम्",
      "combined_translation": "13-13"
    },
    {
      "verse": 14,
      "sanskrit": "खड्गौ प्रगृह्य चात्युग्रौ युद्धाय समुपस्थितौ। तौ हि खड्गविदां श्रेष्ठौ वीरौ डिम्भकसात्यकी॥१४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 308,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "सात्यकिडिम्भकयोर्युद्धम्",
      "combined_translation": "14-14"
    },
    {
      "verse": 15,
      "sanskrit": "दौःशासनिर्महाभागः सौमदत्तिस्तथैव च। अभिमन्युश्च विक्रान्तो नकुलश्च तथैव च॥१५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 308,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "सात्यकिडिम्भकयोर्युद्धम्",
      "combined_translation": "15-15"
    },
    {
      "verse": 16,
      "sanskrit": "एते खड्गविदांश्रेष्ठाः कीर्तिता युद्धि सत्तमाः। एतेष्वेतौ नृपश्रेष्ठौ षट्सु वै नृपसत्तम॥१६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 308,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "सात्यकिडिम्भकयोर्युद्धम्",
      "combined_translation": "16-16"
    },
    {
      "verse": 17,
      "sanskrit": "तावेतावसिना युद्धं चक्रतुर्युद्धलालसौ। भ्रान्तमुद्भ्रान्तमाविद्धं प्रविद्धं बाहुनिःसृतम्॥१७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 308,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "सात्यकिडिम्भकयोर्युद्धम्",
      "combined_translation": "17-17"
    },
    {
      "verse": 18,
      "sanskrit": "आकरं विकरं भिन्नं निर्मर्यादममानुषम्। सङ्कोचितं कुलचितं सव्यजानु विजानु च॥१८॥",
      "english": null,
      "bhavadeepa": "भ्रान्तमुद्भ्रान्तमित्यादयो द्वात्रिंशत्खड्गभेदा यथायथमूह्याः खड्गशास्त्रे वान्वेषणीयाः॥१७॥",
      "chapter": 308,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "सात्यकिडिम्भकयोर्युद्धम्",
      "combined_translation": "18-18"
    },
    {
      "verse": 19,
      "sanskrit": "आहिकं चित्रकं क्षिप्तं कुसुम्बं लम्बनं धृतम्। सर्वबाहु विनिर्बाहु सव्येतरमथोत्तरम्॥१९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 308,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "सात्यकिडिम्भकयोर्युद्धम्",
      "combined_translation": "19-19"
    },
    {
      "verse": 20,
      "sanskrit": "त्रिबाहुस्तुङ्गबाहुश्च सव्योन्नतमुदासि च। पृष्ठतः प्रथितं चैव यौधिकं प्रथितं तथा॥२०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 308,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "सात्यकिडिम्भकयोर्युद्धम्",
      "combined_translation": "20-20"
    },
    {
      "verse": 21,
      "sanskrit": "इति प्राकारन्द्वात्रिंशच्चक्रतुः खड्गयोधिनौ। पुनः पुनः प्रहरन्तौ न च श्रममुपेयतुः॥२१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 308,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "सात्यकिडिम्भकयोर्युद्धम्",
      "combined_translation": "21-21"
    },
    {
      "verse": 22,
      "sanskrit": "पुष्करस्थौ महाराज युद्धाय कृतनिश्चयौ। ततो देवाः सगन्धर्वाः सिद्धाश्च परमर्षयः॥२२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 308,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "सात्यकिडिम्भकयोर्युद्धम्",
      "combined_translation": "22-22"
    },
    {
      "verse": 23,
      "sanskrit": "तुष्टुवुस्तौ महाराज जये कृतपरिश्रमौ। अहो वीर्यमहो धैर्यमनयोर्बाहुशालिनोः॥२३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 308,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "सात्यकिडिम्भकयोर्युद्धम्",
      "combined_translation": "23-23"
    },
    {
      "verse": 24,
      "sanskrit": "एतावेव रणे शक्तौ खड्गे धनुशि पारगौ। एकः शिष्यो गिरीशस्य द्रोणस्यान्यो हि धीमतः॥२४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 308,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "सात्यकिडिम्भकयोर्युद्धम्",
      "combined_translation": "24-24"
    },
    {
      "verse": 25,
      "sanskrit": "अर्जुनः सात्यकिश्चैव वासुदेवो जगत्पतिः। त्रय एते महाराज प्रथिताः सङ्गरे सदा॥२५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 308,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "सात्यकिडिम्भकयोर्युद्धम्",
      "combined_translation": "25-25"
    },
    {
      "verse": 26,
      "sanskrit": "डिम्भकः शक्तिभृच्छर्वस्त्रय एते महारथाः। प्रसिद्धाः सर्व एवैते वीर्येषु च बलेषु च॥२६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 308,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "सात्यकिडिम्भकयोर्युद्धम्",
      "combined_translation": "26-26"
    },
    {
      "verse": 27,
      "sanskrit": "इति ते देवगन्धर्वाः सिद्धा यक्षा महोरगाः। दिविस्थिताः समं ब्रूयुर्युद्धदर्शनलालसाः॥२७॥",
      "english": null,
      "bhavadeepa": "शक्तिभृत् कार्तिकेयः॥२६॥",
      "chapter": 308,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "सात्यकिडिम्भकयोर्युद्धम्",
      "combined_translation": "27-27"
    }
  ]
}