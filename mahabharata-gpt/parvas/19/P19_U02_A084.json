{
  "adhyaya_id": "P19_U02_A084",
  "book": 19,
  "parva_name": "हरिवंशः",
  "upaparva_name": "विष्णुपर्व",
  "adhyaya_name": "अनिरुद्धविक्रमः राज्ञां बन्धनं च-०८४",
  "chapter": 139,
  "verse_count": 68,
  "verses": [
    {
      "verse": 1,
      "sanskrit": "वैशम्पायन उवाच।\n              मुहूर्ताभ्युदिते सूर्ये जनचक्षुषि निर्मले। बलः कृष्णः सात्यकिश्च तार्क्ष्यमारुरुहुस्तदा॥१॥",
      "english": null,
      "bhavadeepa": "तं स्कन्धावारं दत्तगुल्माप्रतिसरं दत्तैर्वृत्त्यर्थं स्थापिर्तर्गुल्मैर्न प्रतिसरः अनिष्टमार्गो यस्मिंस्तम्। अटने रक्षार्थं परिभ्रमणे॥५६॥",
      "chapter": 139,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "अनिरुद्धविक्रमः राज्ञां बन्धनं च-०८४"
    },
    {
      "verse": 2,
      "sanskrit": "बद्धगोधाङ्गुलित्राणा दंशिता युद्धकाङ्क्षिणः। बिल्वोदकेश्वरं देवं नमस्कृत्य सुरोत्तमम्॥२॥",
      "english": null,
      "bhavadeepa": "चतुर्भिरधिकेऽशीतितमे कामस्य विक्रमः। राजा बद्ध्वा रिपूञ्जित्वा कन्यास्त्वानीय आगतः॥ मुहूर्तेति॥१॥",
      "chapter": 139,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "अनिरुद्धविक्रमः राज्ञां बन्धनं च-०८४",
      "combined_translation": "2-2"
    },
    {
      "verse": 3,
      "sanskrit": "आवर्तया जले स्नात्वा रुद्रेण वरदत्तया। गङ्गायाः कुरुशार्दूल रुद्रवाक्येन पुण्यया॥३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 139,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "अनिरुद्धविक्रमः राज्ञां बन्धनं च-०८४",
      "combined_translation": "3-3"
    },
    {
      "verse": 4,
      "sanskrit": "प्रद्युम्नमग्रे सैन्यस्य वियति स्थ्पाय मानदः। रक्षार्थं यज्ञवाटस्य पाण्डवान्विनियुज्य च॥४॥",
      "english": null,
      "bhavadeepa": "तृतीया षष्ठ्यर्थे॥३॥",
      "chapter": 139,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "अनिरुद्धविक्रमः राज्ञां बन्धनं च-०८४",
      "combined_translation": "4-4"
    },
    {
      "verse": 5,
      "sanskrit": "शेषां सेनां गुहाद्वारि भगवान्विनियुज्य च। जयन्तमथ सस्मार प्रवरं च सतां गतिः॥५॥",
      "english": null,
      "bhavadeepa": "वियति उपरिभागे॥४॥",
      "chapter": 139,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "अनिरुद्धविक्रमः राज्ञां बन्धनं च-०८४",
      "combined_translation": "5-5"
    },
    {
      "verse": 6,
      "sanskrit": "तावापेततुरेवाथ स्वयं चापश्यतां तथा। वियत्येव नियुक्तौ तौ प्रद्युम्न इव भारत॥६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 139,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "अनिरुद्धविक्रमः राज्ञां बन्धनं च-०८४",
      "combined_translation": "6-6"
    },
    {
      "verse": 7,
      "sanskrit": "ततः कृष्णस्य वचनादाहतो रणदुन्दुभिः। जलजा मुरजाश्चैव वाद्यान्येवापराणि च॥७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 139,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "अनिरुद्धविक्रमः राज्ञां बन्धनं च-०८४",
      "combined_translation": "7-7"
    },
    {
      "verse": 8,
      "sanskrit": "मकरो रचितो व्यूहः साम्बेन च गदेन च। सारणश्चोद्धवश्चैव भोजो वैतरणस्तथा॥८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 139,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "अनिरुद्धविक्रमः राज्ञां बन्धनं च-०८४",
      "combined_translation": "8-8"
    },
    {
      "verse": 9,
      "sanskrit": "अनाधृष्टिश्च धर्मात्मा पृथुर्विपृथुरेव च। कृतवर्मा च दंष्ट्रश्च निचक्षुररिमर्दनः॥९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 139,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "अनिरुद्धविक्रमः राज्ञां बन्धनं च-०८४",
      "combined_translation": "9-9"
    },
    {
      "verse": 10,
      "sanskrit": "सनत्कुमारो धर्मात्मा चारुदेष्णश्च भारत। अनिरुद्धसहायौ तौ पृष्ठानीकं ररक्षतुः॥१०॥",
      "english": null,
      "bhavadeepa": "निचक्षुर्यादवः॥९॥",
      "chapter": 139,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "अनिरुद्धविक्रमः राज्ञां बन्धनं च-०८४",
      "combined_translation": "10-10"
    },
    {
      "verse": 11,
      "sanskrit": "शेषा यादवसेना तु व्यूहमध्ये व्यवस्थिता। रथैरश्वैर्नरैर्नागैराकुला कुलवर्धन॥११॥",
      "english": null,
      "bhavadeepa": "सनत्कुमारोऽपि यादवः॥१०॥",
      "chapter": 139,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "अनिरुद्धविक्रमः राज्ञां बन्धनं च-०८४",
      "combined_translation": "11-11"
    },
    {
      "verse": 12,
      "sanskrit": "षट्पुरादपि निष्क्रान्ता दानवा युद्धदुर्मदाः। आरुह्य मेघनादांश्च गर्दभानपि हस्तिनः॥१२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 139,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "अनिरुद्धविक्रमः राज्ञां बन्धनं च-०८४",
      "combined_translation": "12-12"
    },
    {
      "verse": 13,
      "sanskrit": "मकराञ्छिशुमारांश्च द्रुतानपि च भारत। महिषानपि खड्गांश्च उष्ट्रानपि च कच्छपान्॥१३॥",
      "english": null,
      "bhavadeepa": "मेघानामिव नादो येषां तान्॥१२॥",
      "chapter": 139,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "अनिरुद्धविक्रमः राज्ञां बन्धनं च-०८४",
      "combined_translation": "13-13"
    },
    {
      "verse": 14,
      "sanskrit": "एतैरेव रथैर्युक्ता विविधायुधपाणयः। किरीटापीडमुकुटैरङ्गदैरपि मण्डिताः॥१४॥",
      "english": null,
      "bhavadeepa": "द्रुतान् जविनः॥१३॥",
      "chapter": 139,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "अनिरुद्धविक्रमः राज्ञां बन्धनं च-०८४",
      "combined_translation": "14-14"
    },
    {
      "verse": 15,
      "sanskrit": "नानर्दमानैर्विविधैस्तूर्यैर्नेमिस्वनाकुलैः। प्रध्मायमानैः शङ्खैश्च महाम्बुदसमस्वनैः॥१५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 139,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "अनिरुद्धविक्रमः राज्ञां बन्धनं च-०८४",
      "combined_translation": "15-15"
    },
    {
      "verse": 16,
      "sanskrit": "तासामसुरसेनानामुद्यतानां जनेश्वर। निकुम्भो निर्ययावग्रे देवानामिव वासवः॥१६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 139,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "अनिरुद्धविक्रमः राज्ञां बन्धनं च-०८४",
      "combined_translation": "16-16"
    },
    {
      "verse": 17,
      "sanskrit": "भूमिं द्यां च ववृधिरे दानवास्ते बलोत्कटाः। नदन्तो विविधान्नादान्क्ष्वेडन्तश्च पुनः पुनः॥१७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 139,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "अनिरुद्धविक्रमः राज्ञां बन्धनं च-०८४",
      "combined_translation": "17-17"
    },
    {
      "verse": 18,
      "sanskrit": "राजसेनापि संयत्ता चेदिराजपुरोगमा। असुराणां सहायार्थं निश्चिता जनमेजय॥१८॥",
      "english": null,
      "bhavadeepa": "भूमिं द्यां च पूरयित्वेति शेषः॥१७॥",
      "chapter": 139,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "अनिरुद्धविक्रमः राज्ञां बन्धनं च-०८४",
      "combined_translation": "18-18"
    },
    {
      "verse": 19,
      "sanskrit": "दुर्योधनं भ्रातृशतं चेदिराजानुजाग्रगम्। स्थितं रथैर्नरव्याघ्र गन्धर्वनगरोपमैः॥१९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 139,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "अनिरुद्धविक्रमः राज्ञां बन्धनं च-०८४",
      "combined_translation": "19-19"
    },
    {
      "verse": 20,
      "sanskrit": "कठिना नादिनो वीरा द्रुपदस्यन्दनास्तथा। रुक्मी चैवाह्वृतिश्चैव तस्थतुर्निश्चितौ रणे। तालवृक्षप्रतीकाशे धुन्वानौ धनुषी शुभे॥२०॥",
      "english": null,
      "bhavadeepa": "चेदिराजः शिशुपालस्तदनुजेभ्योऽग्रगम्॥१९॥",
      "chapter": 139,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "अनिरुद्धविक्रमः राज्ञां बन्धनं च-०८४",
      "combined_translation": "20-20"
    },
    {
      "verse": 21,
      "sanskrit": "शल्यश्च शकुनिश्चोभौ भगदत्तश्च पार्थिवः। जरासन्धस्त्रिगर्तश्च विराटश्च सहोत्तरः॥२१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 139,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "अनिरुद्धविक्रमः राज्ञां बन्धनं च-०८४",
      "combined_translation": "21-21"
    },
    {
      "verse": 22,
      "sanskrit": "युद्धार्थमुद्यता वीरा निकुम्भाद्या जयैषिणः। युयुत्समाना यदुभिर्देवैरिव महासुराः॥२२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 139,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "अनिरुद्धविक्रमः राज्ञां बन्धनं च-०८४",
      "combined_translation": "22-22"
    },
    {
      "verse": 23,
      "sanskrit": "ततो निकुम्भः समरे शरैराशीविषोपमैः। ममर्द समरे सेनां भैमानां भीमदर्शनाम्॥२३॥",
      "english": null,
      "bhavadeepa": "निकुम्भ आद्यः प्रधानः येषां ते॥२२॥",
      "chapter": 139,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "अनिरुद्धविक्रमः राज्ञां बन्धनं च-०८४",
      "combined_translation": "23-23"
    },
    {
      "verse": 24,
      "sanskrit": "सेनापतिरनाधृष्टिर्ममृषे तत्र यादवः। ममर्द घोरैर्बाणौघैश्चित्रपुङ्खैः शिलाशितैः॥२४॥",
      "english": null,
      "bhavadeepa": "भैमानां यदूनाम्॥२३॥",
      "chapter": 139,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "अनिरुद्धविक्रमः राज्ञां बन्धनं च-०८४",
      "combined_translation": "24-24"
    },
    {
      "verse": 25,
      "sanskrit": "न रथोऽसुरमुख्यस्य ददृशे न च वाजिनः। न ध्वजो न निकुम्भस्तु सर्वे बाणाभिसंवृताः॥२५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 139,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "अनिरुद्धविक्रमः राज्ञां बन्धनं च-०८४",
      "combined_translation": "25-25"
    },
    {
      "verse": 26,
      "sanskrit": "स परीत्य ततो वीरो निकुम्भो मायिनां वरः। अस्तम्भयदनाधृष्टिं मायया भैमसत्तमम्॥२६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 139,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "अनिरुद्धविक्रमः राज्ञां बन्धनं च-०८४",
      "combined_translation": "26-26"
    },
    {
      "verse": 27,
      "sanskrit": "स्तम्भयित्वानयद्वीरं गुहां षट्पुरसंज्ञिताम्। रुद्ध्वा चाभ्यगमद्वीरो मायाबलमुपाश्रितः॥२७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 139,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "अनिरुद्धविक्रमः राज्ञां बन्धनं च-०८४",
      "combined_translation": "27-27"
    },
    {
      "verse": 28,
      "sanskrit": "पुनरेव निकुम्भस्तु कृतवर्माणमाहवे। अनयच्चारुदेष्णं च भोजं वैतरणं तथा॥२८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 139,
