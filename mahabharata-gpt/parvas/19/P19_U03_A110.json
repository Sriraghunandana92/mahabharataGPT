{
  "adhyaya_id": "P19_U03_A110",
  "book": 19,
  "parva_name": "हरिवंशः",
  "upaparva_name": "भविष्यपर्व",
  "adhyaya_name": "यतीनां द्वारकागमनम्",
  "chapter": 293,
  "verse_count": 17,
  "verses": [
    {
      "verse": 1,
      "sanskrit": "वैशम्पायन उवाच।\n              ततस्तौ हंसडिम्भकौ क्रुद्धौ कालेन चोदितौ। शिक्यं कमण्डलुं चैव द्विदलं दारुमेव च॥१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 293,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "यतीनां द्वारकागमनम्",
      "combined_translation": "1-21"
    },
    {
      "verse": 2,
      "sanskrit": "दण्डान्पात्रविशेषांश्च छित्त्वा भित्त्वा च सर्वशः। तस्मिन्देशे महाराज व्याधैर्मांसान्यदीदहन्॥२॥",
      "english": null,
      "bhavadeepa": "ततस्ताविति। द्विदलं दारुगोकर्णाकारं भोजनपात्रम्। दारुमिति पुंस्त्वमार्षम्॥१॥",
      "chapter": 293,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "यतीनां द्वारकागमनम्",
      "combined_translation": "2-2"
    },
    {
      "verse": 3,
      "sanskrit": "भक्षयित्वा ततो देशात्स्वपुरीं तौ प्रजग्मतुः। जनार्दनश्च धर्मात्मा स्नेहादनुययौ तयोः॥३॥",
      "english": null,
      "bhavadeepa": "पात्रविशेषान् शालग्रामसम्पुटादीन्॥२॥",
      "chapter": 293,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "यतीनां द्वारकागमनम्",
      "combined_translation": "3-3"
    },
    {
      "verse": 4,
      "sanskrit": "नष्टाविमाविति तदा स मेने दुःखितः परम्। गतेषु तेषु सर्वेषु दुर्वासा यतिसत्तमः॥४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 293,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "यतीनां द्वारकागमनम्",
      "combined_translation": "4-4"
    },
    {
      "verse": 5,
      "sanskrit": "पलायनपरान्सर्वानिदं प्राह यतीश्वरान्। इतो देशाद्विनिर्गत्य पुष्करात्पुण्यसंयुतात्॥५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 293,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "यतीनां द्वारकागमनम्",
      "combined_translation": "5-5"
    },
    {
      "verse": 6,
      "sanskrit": "मन्दं मन्दं समाश्वस्य विश्रम्य च ततस्ततः। प्रविश्य द्वारकां देवं शङ्खचक्रगदाधरम्॥६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 293,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "यतीनां द्वारकागमनम्",
      "combined_translation": "6-6"
    },
    {
      "verse": 7,
      "sanskrit": "दृष्ट्वा च तस्मै प्रभवे वक्ष्यामो यतिसत्तमाः। स हि रक्षञ्जगदिदं धर्मवर्त्मनि संस्थितः॥७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 293,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "यतीनां द्वारकागमनम्",
      "combined_translation": "7-7"
    },
    {
      "verse": 8,
      "sanskrit": "आद्यो लोकगुरुर्विष्णुर्यतात्मा तत्त्ववित्प्रियः। उद्धृत्य कण्टकान्सर्वाञ्छशास पृथिवीमिमाम्॥८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 293,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "यतीनां द्वारकागमनम्",
      "combined_translation": "8-8"
    },
    {
      "verse": 9,
      "sanskrit": "स च पापान्महाघोरान्सर्वान्पापकृतान्प्रभुः। रक्षेन्नः सकलान्सर्वाञ्ज्ञानेषु नियतात्मनः॥९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 293,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "यतीनां द्वारकागमनम्",
      "combined_translation": "9-9"
    },
    {
      "verse": 10,
      "sanskrit": "इदमद्य क्षमं विप्रा यानमद्य विधीयताम्। साहसं यत्कृतं ताभ्यां पात्रभेदादि सत्तमाः॥१०॥",
      "english": null,
      "bhavadeepa": "पापकृतान्पापजन्मभाजः ज्ञानेषु ज्ञानसाधनेषु अमानित्वादिषु॥९॥",
      "chapter": 293,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "यतीनां द्वारकागमनम्",
      "combined_translation": "10-10"
    },
    {
      "verse": 11,
      "sanskrit": "एतत्सर्वमशेषेण दर्शयाम जनार्दनम्। तथेति ते प्रतिज्ञाय यतयो ज्ञानचक्षुषः॥११॥",
      "english": null,
      "bhavadeepa": "यानं प्रयाणम्॥१०॥",
      "chapter": 293,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "यतीनां द्वारकागमनम्",
      "combined_translation": "11-11"
    },
    {
      "verse": 12,
      "sanskrit": "छिन्नं ताभ्यां समादाय शिक्यं दारुमयं तथा। द्विदलं कर्पटं चैव कौपीनमथ वल्कलम्॥१२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 293,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "यतीनां द्वारकागमनम्",
      "combined_translation": "12-12"
    },
    {
      "verse": 13,
      "sanskrit": "कमण्डलुं तथा राजन्नर्धप्रोतकपालकम्। एतानन्यान्समादाय द्रष्टुं केशवमाययुः॥१३॥",
      "english": null,
      "bhavadeepa": "कर्पटं काषायवासः॥१२॥",
      "chapter": 293,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "यतीनां द्वारकागमनम्"
    },
    {
      "verse": 14,
      "sanskrit": "पञ्च चैव सहस्राणि पुरस्कृत्य महमुनीन्। दुर्वाससं तपोयोनिमीश्वरस्यात्मसम्भवम्॥१४॥",
      "english": null,
      "bhavadeepa": "अर्धप्रोतकपालकम् अलाबूफलस्य मूलादग्रान्तं द्विधा कृतस्यैकदेशः॥१३॥",
      "chapter": 293,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "यतीनां द्वारकागमनम्",
      "combined_translation": "14-14"
    },
    {
      "verse": 15,
      "sanskrit": "अहोरात्रेण ते सर्वे द्वारकां कृष्णपालिताम्। ययुर्दान्ता महात्मानो लोमशाः केशवर्जिताः॥१५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 293,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "यतीनां द्वारकागमनम्",
      "combined_translation": "15-15"
    },
    {
      "verse": 16,
      "sanskrit": "प्रातः प्रविश्य राजेन्द्र वापिकायां  यतीश्वराः। स्नात्वोपस्पृश्य ते सर्वे यत्नेन महता तदा॥१६॥",
      "english": null,
      "bhavadeepa": "लोमशाः गलादधः केशवर्जिताः उपरि केशवर्जिता वा॥१५॥",
      "chapter": 293,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "यतीनां द्वारकागमनम्",
      "combined_translation": "16-16"
    },
    {
      "verse": 17,
      "sanskrit": "द्रष्टुमभ्युद्यता विष्णुं कण्टकोद्धृतितत्परम्। एकरूपं समास्थाय सुधर्मायामवस्थितम्॥१७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 293,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "यतीनां द्वारकागमनम्",
      "combined_translation": "17-17"
    }
  ]
