{
  "adhyaya_id": "P19_U02_A061",
  "book": 19,
  "parva_name": "हरिवंशः",
  "upaparva_name": "विष्णुपर्व",
  "adhyaya_name": "प्रद्युम्नविवाहो रुक्मिवधश्च-०६१",
  "chapter": 116,
  "verse_count": 59,
  "verses": [
    {
      "verse": 1,
      "sanskrit": "वैशम्पायन उवाच।\n              ततः काले व्यतीते तु रुक्मी महति वीर्यवान्। दुहितुः कारयामास स्वयंवरमरिन्दमः॥१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 116,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "प्रद्युम्नविवाहो रुक्मिवधश्च-०६१",
      "combined_translation": "1-46"
    },
    {
      "verse": 2,
      "sanskrit": "तत्राहूता हि राजानो राजपुत्राश्च रुक्मिणा। समाजग्मुर्महावीर्या नानादिग्भ्यः श्रियान्विताः॥२॥",
      "english": null,
      "bhavadeepa": "एकषष्टितमेऽध्याये प्रद्युम्नतत्तनूजयोः। विवाहः कथ्यते तत्र रुमिक्णश्च तथा वधः॥१॥ तत इति। काले महति॥१॥",
      "chapter": 116,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "प्रद्युम्नविवाहो रुक्मिवधश्च-०६१",
      "combined_translation": "2-2"
    },
    {
      "verse": 3,
      "sanskrit": "तत्राजगाम प्रद्युम्नः कुमारैरपरैर्वृतः। सा हि तं चकमे कन्या स च तां शुभलोचनाम्॥३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 116,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "प्रद्युम्नविवाहो रुक्मिवधश्च-०६१",
      "combined_translation": "3-3"
    },
    {
      "verse": 4,
      "sanskrit": "शुभाङ्गी नाम वैदर्भी कान्तिद्युतिसमन्विता। पृथिव्यामभवत्ख्याता रुक्मिणस्तनया तदा॥४॥",
      "english": null,
      "bhavadeepa": "सा कन्या चकमे कामितवती॥३॥",
      "chapter": 116,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "प्रद्युम्नविवाहो रुक्मिवधश्च-०६१",
      "combined_translation": "4-4"
    },
    {
      "verse": 5,
      "sanskrit": "उपविष्टेषु सर्वेषु पार्थिवेषु महात्मसु। वैदर्भी वरयामास प्रद्युम्नमरिसूदनम्॥५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 116,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "प्रद्युम्नविवाहो रुक्मिवधश्च-०६१",
      "combined_translation": "5-5"
    },
    {
      "verse": 6,
      "sanskrit": "स हि सर्वास्त्रकुशलः सिंहसंहननो युवा। रूपेनाप्रतिमो लोके केशवस्यात्मजोऽभवत्॥६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 116,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "प्रद्युम्नविवाहो रुक्मिवधश्च-०६१",
      "combined_translation": "6-6"
    },
    {
      "verse": 7,
      "sanskrit": "वयोरूपगुणोपेता राजपुत्री च साभवत्। नारायणी चन्द्रसेना जातकामा च तं प्रति॥७॥",
      "english": null,
      "bhavadeepa": "सिंहसंहननः सिंहवदतिदृढाङ्गः। “वराङ्गरूपोपेतो यः सिंहसंहननो हि सः” इत्युक्तां वा॥६॥",
      "chapter": 116,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "प्रद्युम्नविवाहो रुक्मिवधश्च-०६१",
      "combined_translation": "7-7"
    },
    {
      "verse": 8,
      "sanskrit": "वृत्ते स्वयंवरे जग्मू राजानः स्वपुराणि ते। उपादाय च वैदर्भीं प्रद्युम्नो द्वारकां ययौ॥८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 116,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "प्रद्युम्नविवाहो रुक्मिवधश्च-०६१",
      "combined_translation": "8-8"
    },
    {
      "verse": 9,
      "sanskrit": "रेमे सह तया वीरो दमयन्त्या नलो यथा। स तस्यां जनयामास देवगर्भोपमं सुतम्॥९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 116,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "प्रद्युम्नविवाहो रुक्मिवधश्च-०६१",
      "combined_translation": "9-9"
    },
    {
      "verse": 10,
      "sanskrit": "अनिरुद्धमिति ख्यातं कर्मणाप्रतिमं भुवि। धनुर्वेदे च वेदे च नीतिशास्त्रे च पारगम्॥१०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 116,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "प्रद्युम्नविवाहो रुक्मिवधश्च-०६१",
      "combined_translation": "10-10"
    },
    {
      "verse": 11,
      "sanskrit": "अभवत्स यदा राजन्ननिरुद्धो वयोऽन्वितः। तदास्य रुक्मिणः पौत्रीं श्रीमतीं रुक्मसन्निभाम्। पत्न्यर्थे वरयामास नाम्ना रुक्मवतीति सा॥११॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 116,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "प्रद्युम्नविवाहो रुक्मिवधश्च-०६१",
      "combined_translation": "11-11"
    },
    {
      "verse": 12,
      "sanskrit": "अनिरुद्धं गुणैर्दातुं कृतबुद्धिर्नृपस्ततः। प्रीत्या हि रौक्मिणेयस्य रुक्मिन्याश्चाप्युपग्रहात्॥१२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 116,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "प्रद्युम्नविवाहो रुक्मिवधश्च-०६१",
      "combined_translation": "12-12"
    },
    {
      "verse": 13,
      "sanskrit": "विस्पर्द्धन्नपि कृष्णेन वैरं त्यज्य महायशाः। ददामीत्यब्रवीद्राजा प्रीतिमाञ्जनमेजय॥१३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 116,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "प्रद्युम्नविवाहो रुक्मिवधश्च-०६१",
      "combined_translation": "13-13"
    },
    {
      "verse": 14,
      "sanskrit": "केशवः सह रुक्मिण्या पुत्रैः सङ्कर्षणेन च। अन्यैश्च वृष्णिभिः सार्धं विदर्भान्सबलो ययौ॥१४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 116,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "प्रद्युम्नविवाहो रुक्मिवधश्च-०६१",
      "combined_translation": "14-14"
    },
    {
      "verse": 15,
      "sanskrit": "संयुक्ता ज्ञातयश्चैव रुक्मिणः सुहृदश्च ये। आहूता रुक्मिणा तेऽपि तत्राजग्मुर्नराधिपाः॥१५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 116,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "प्रद्युम्नविवाहो रुक्मिवधश्च-०६१",
      "combined_translation": "15-15"
    },
    {
      "verse": 16,
      "sanskrit": "शुभे तिथौ महाराज नक्षत्रे चाभिपूजिते । विवाहः सोऽनिरुद्धस्य बभूव परमोत्सवः॥१६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 116,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "प्रद्युम्नविवाहो रुक्मिवधश्च-०६१",
      "combined_translation": "16-16"
    },
    {
      "verse": 17,
      "sanskrit": "पाणौ गृहीते वैदर्भ्यास्त्वनिरुद्धेन तत्र वै। वैदर्भयादवानां च बभूव परमोत्सवः॥१७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 116,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "प्रद्युम्नविवाहो रुक्मिवधश्च-०६१",
      "combined_translation": "17-17"
    },
    {
      "verse": 18,
      "sanskrit": "रेमिरे वृष्णयस्तत्र पूज्यमाना यथामराः। अथाश्मकानामधिपो वैणुदारिरुदारधीः॥१८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 116,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "प्रद्युम्नविवाहो रुक्मिवधश्च-०६१",
      "combined_translation": "18-18"
    },
    {
      "verse": 19,
      "sanskrit": "अक्षः श्रुतर्वा चाणूरः क्रथश्चैवांशुमानपि। जयत्सेनः कलिङ्गानामधिपश्च महाबलः॥१९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 116,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "प्रद्युम्नविवाहो रुक्मिवधश्च-०६१",
      "combined_translation": "19-19"
    },
    {
      "verse": 20,
      "sanskrit": "पाण्ड्यश्च नृपतिः श्रीमानृषीकाधिपतिस्तथा। एते संमन्त्र्य राजानो दाक्षिणात्या महर्द्धयः॥२०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 116,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "प्रद्युम्नविवाहो रुक्मिवधश्च-०६१",
      "combined_translation": "20-20"
    },
    {
      "verse": 21,
      "sanskrit": "अभिगम्याब्रुवन्त्सर्वे रुक्मिणं रहसि प्रभुम्। भवानक्षेषु कुशलो वयं चापि रिरंसवः। प्रियद्यूतश्च रामोऽसावक्षेष्वनिपुणोऽपि च॥२१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 116,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "प्रद्युम्नविवाहो रुक्मिवधश्च-०६१",
      "combined_translation": "21-21"
    },
    {
      "verse": 22,
      "sanskrit": "ते भवन्तं पुरस्कृत्य जेतुमिच्छाम तं वयम्। इत्युक्तो रोचयामास रुक्मी द्यूतं महारथः॥२२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 116,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "प्रद्युम्नविवाहो रुक्मिवधश्च-०६१",
      "combined_translation": "22-22"
    },
    {
      "verse": 23,
      "sanskrit": "ते शुभां काञ्चनस्तम्भां कुसुमैर्भूषिताजिराम्। सभामाविविशुर्हृष्टाः सिक्तां चन्दनवारिणा॥२३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 116,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "प्रद्युम्नविवाहो रुक्मिवधश्च-०६१",
      "combined_translation": "23-23"
    },
    {
      "verse": 24,
      "sanskrit": "तां प्रविश्य ततः सर्वे शुभ्रस्रगनुलेपनाः। सौवर्णेष्वासनेश्वासाञ्चक्रिरे विजिगीषवः॥२४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 116,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "प्रद्युम्नविवाहो रुक्मिवधश्च-०६१",
      "combined_translation": "24-24"
    },
    {
      "verse": 25,
      "sanskrit": "आहूतो बलदेवस्तु कितवैरक्षकोविदैः। बाडमित्यब्रवीद्धृष्टः सह दीव्याम पण्यताम्॥२५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 116,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "प्रद्युम्नविवाहो रुक्मिवधश्च-०६१",
      "combined_translation": "25-25"
    },
    {
      "verse": 26,
      "sanskrit": "निकृत्या विजिगीषन्तो दाक्षिणात्या नराधिपाः। मणिमुक्ताः सुवर्णं च तत्रानिन्युः सहस्रशः॥२६॥",
      "english": null,
      "bhavadeepa": "कितवेर्द्यूतवेदिभिः॥२५॥",
      "chapter": 116,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "प्रद्युम्नविवाहो रुक्मिवधश्च-०६१",
      "combined_translation": "26-26"
    },
    {
      "verse": 27,
      "sanskrit": "ततः प्रावर्तत द्यूतं तेषां रतिविनाशनम्। कलहस्यास्पदं घोरं दुर्मतीनां क्षयावहम्॥२७॥",
      "english": null,
      "bhavadeepa": "निकृत्या कपटेन॥२६॥",
      "chapter": 116,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "प्रद्युम्नविवाहो रुक्मिवधश्च-०६१",
      "combined_translation": "27-27"
    },
    {
      "verse": 28,
      "sanskrit": "निष्काणां च सहस्राणि सुवर्नस्य दशादितः। रुक्मिणा सह सम्पाते बलदेवो ग्लहं ददौ॥२८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 116,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "प्रद्युम्नविवाहो रुक्मिवधश्च-०६१",
      "combined_translation": "28-28"
    },
    {
      "verse": 29,
      "sanskrit": "तं जिगाय ततो रुक्मी यतमानं महाबलम्। तावदेवापरं भूयो बलदेवं जिगाय सः॥२९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 116,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "प्रद्युम्नविवाहो रुक्मिवधश्च-०६१",
      "combined_translation": "29-29"
    },
    {
      "verse": 30,
      "sanskrit": "असकृज्जीयमानस्तु रुक्मिणा केशवाग्रजः। सुवर्णकोटीर्जग्राह ग्लहं तस्य महात्मनः॥३०॥",
      "english": null,
      "bhavadeepa": null,
