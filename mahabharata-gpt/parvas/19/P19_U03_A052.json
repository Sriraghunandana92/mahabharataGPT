{
  "adhyaya_id": "P19_U03_A052",
  "book": 19,
  "parva_name": "हरिवंशः",
  "upaparva_name": "भविष्यपर्व",
  "adhyaya_name": "देवसैन्यानां युद्धोद्योगः",
  "chapter": 235,
  "verse_count": 64,
  "verses": [
    {
      "verse": 1,
      "sanskrit": "वैशम्पायन उवाच।\n              श्रुतस्ते दैत्यसैन्यस्य विस्तरो जनमेजय। भूयस्त्रिदशसैन्यस्य शृणु विस्तरमादितः॥१॥",
      "english": null,
      "bhavadeepa": "महाबलानि महान्ति सैन्यानि॥९२॥",
      "chapter": 235,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवसैन्यानां युद्धोद्योगः"
    },
    {
      "verse": 2,
      "sanskrit": "सुराधिपस्तु भगवानाज्ञापयत वै सुरान्। मरुद्गणांस्तथादित्यान्विश्वान्देवांश्च वासवः॥२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 235,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवसैन्यानां युद्धोद्योगः",
      "combined_translation": "2-2"
    },
    {
      "verse": 3,
      "sanskrit": "वसूनष्टौ भृशं सर्वान्यक्षरक्षोमहोरगान्। विद्याधरगणान्सर्वान्गन्धर्वांश्च महाबलान्॥३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 235,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवसैन्यानां युद्धोद्योगः",
      "combined_translation": "3-3"
    },
    {
      "verse": 4,
      "sanskrit": "महार्णवांश्च शैलांश्व तथा रुद्रान्महौजसः। यमवैश्रवणौ चोभौ वरुणं च जनाधिपम्॥४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 235,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवसैन्यानां युद्धोद्योगः",
      "combined_translation": "4-4"
    },
    {
      "verse": 5,
      "sanskrit": "ये तु सिद्धा महात्मानः पितरश्च मनस्विनः। राजर्षयश्च शतशो योगसिद्धास्तथैव च॥५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 235,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवसैन्यानां युद्धोद्योगः",
      "combined_translation": "5-5"
    },
    {
      "verse": 6,
      "sanskrit": "त्रिदशाज्ञापकः शक्र आज्ञापयति वीर्यवान्। भवन्तो दैत्यनाशाय सन्नह्यन्तामिति प्रभुः॥६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 235,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवसैन्यानां युद्धोद्योगः",
      "combined_translation": "6-6"
    },
    {
      "verse": 7,
      "sanskrit": "शक्रस्य वचनं श्रुत्वा ततः सर्वे दिवौकसः। सन्नह्यन्त महात्मानः शक्रस्य समविक्रमाः॥७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 235,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवसैन्यानां युद्धोद्योगः",
      "combined_translation": "7-7"
    },
    {
      "verse": 8,
      "sanskrit": "नानाकवचिनः सर्वे विचित्रकवचध्वजाः। नानायुधोद्यतकरा मत्ता इव महागजाः॥८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 235,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवसैन्यानां युद्धोद्योगः",
      "combined_translation": "8-8"
    },
    {
      "verse": 9,
      "sanskrit": "केचिदारुरुहुर्याघ्रान्केचिदारुरुहुर्गजान्। केचिदारुरुहुर्नगान्केचिदारुरुहुर्वेषान्॥९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 235,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवसैन्यानां युद्धोद्योगः",
      "combined_translation": "9-9"
    },
    {
      "verse": 10,
      "sanskrit": "हरिनेत्रो हरिश्मश्रुर्द्विरदैरावृतध्वजम्। रथं हरिहयैर्युक्तं स प्रायात्समरं प्रति॥१०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 235,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवसैन्यानां युद्धोद्योगः",
      "combined_translation": "10-10"
    },
    {
      "verse": 11,
      "sanskrit": "आदित्यवर्णं विरजं सुधौतं त्वष्ट्रा स्वयं निर्मितमीश्वरार्थम्। जालैश्च जाम्बूनदभक्तिचित्रैरलङ्कृतं काञ्चनदामभिश्च॥११॥",
      "english": null,
      "bhavadeepa": "श्रुतस्त इति। रथम् आरोह्येति शेषः॥१०॥",
      "chapter": 235,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवसैन्यानां युद्धोद्योगः",
      "combined_translation": "11-11"
    },
    {
      "verse": 12,
      "sanskrit": "सकूबरोपस्करबन्धुरेषं विद्युत्प्रभाभिः कृतमामिताभ्रम्। कैलासङ्गोपममिन्द्रयानं सुचारुचारुप्रतिचक्रचक्रम्॥१२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 235,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवसैन्यानां युद्धोद्योगः",
      "combined_translation": "12-12"
    },
    {
      "verse": 13,
      "sanskrit": "तारासहस्रैः खचितं ज्वलिद्भिर्देवार्हमाल्यार्चितसर्वदेहम्। समुच्छ्रितं श्रीध्वजमक्षयाक्षं प्रज्वाल्यमानं पुरुषोत्तमेन॥१३॥",
      "english": null,
      "bhavadeepa": "आभिताम्रम् ईषत्सर्वतस्ताम्रं सुचारुभ्योऽपि चारु यानं रथं प्रतिचस्क्रय वैरिसमूहस्यापि चक्रं पातालं ज्ञापक गच्छतेत्येवमादि॥१२॥",
      "chapter": 235,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवसैन्यानां युद्धोद्योगः",
      "combined_translation": "13-13"
    },
    {
      "verse": 14,
      "sanskrit": "आस्थाय तं भास्करमाशुवेगं शचीपतिर्लोकपतिः सुरेशः। वज्रस्य धर्ता भुवनस्य गोप्ता ययौ महात्मा भगवान्महेन्द्रः॥१४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 235,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवसैन्यानां युद्धोद्योगः",
      "combined_translation": "14-14"
    },
    {
      "verse": 15,
      "sanskrit": "आमुच्य वर्माथ सहस्त्रतारं हुताशनादित्यसमप्रभावम्। सूर्यप्रभं चामुमुचे किरीटं मालां च जाम्बूनदवैजयन्तीम्॥१५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 235,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवसैन्यानां युद्धोद्योगः",
      "combined_translation": "15-15"
    },
    {
      "verse": 16,
      "sanskrit": "त्वष्ट्रा कृतं भास्कररश्मिदीप्तं सुतीक्ष्णघोरामलतीव्रधारम्। महासुराणां रुधिरार्द्रमुग्रं प्रगृह वज्रं शतपर्वभीमम्॥१६॥",
      "english": null,
      "bhavadeepa": "जाम्बूनदमयी चासौ वैजयन्ती आपादलम्बिनी तां जाम्बूनदवैजयन्तीम्॥१५॥",
      "chapter": 235,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवसैन्यानां युद्धोद्योगः",
      "combined_translation": "16-16"
    },
    {
      "verse": 17,
      "sanskrit": "महाशनी द्वे च महाग्रहाभे दीप्ताममोघां च स शक्तिमुग्राम्। चक्रं तथैन्द्रं सुमहत्प्रतापं प्रगृह्य शक्तः प्रययौ रणाय॥१७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 235,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवसैन्यानां युद्धोद्योगः",
      "combined_translation": "17-17"
    },
    {
      "verse": 18,
      "sanskrit": "सहस्रभूतपतिः सनातनः सनातनानामपि यः सनातनः। खङ्गं च देवाधिपतिर्महात्मा वैयाघ्रमादाय च चर्म चित्रम्॥१८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 235,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवसैन्यानां युद्धोद्योगः",
      "combined_translation": "18-18"
    },
    {
      "verse": 19,
      "sanskrit": "क्षरोदधिक्षोभसमुच्छ्रितानि पुरामृतादुत्तमभूषणानि। देवासुराणां समनिर्जितानि सोमार्कनक्षत्रतडित्प्रभाणि॥१९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 235,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवसैन्यानां युद्धोद्योगः",
      "combined_translation": "19-19"
    },
    {
      "verse": 20,
      "sanskrit": "दत्तान्यदित्या मणिकुण्डलानि युद्धे प्रयातस्य सुरेश्वरस्य। तैर्भूषितो भाति सहस्रचक्षुरुद्योतयन्वे विदिशो दिशश्च॥२०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 235,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवसैन्यानां युद्धोद्योगः",
      "combined_translation": "20-20"
    },
    {
      "verse": 21,
      "sanskrit": "हरिः प्रभुर्नेत्रसहस्रचित्रो विभाति युद्धाभिमुखः सुरेन्द्रः। यथा सितं शारदमभ्रकल्पं नभस्तलं ह्यृक्षसहस्रचित्रम्॥२१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 235,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवसैन्यानां युद्धोद्योगः",
      "combined_translation": "21-21"
    },
    {
      "verse": 22,
      "sanskrit": "स्तुवन्ति यान्तं विपुलैवचोभिर्जयाशिषा चोर्जितसत्त्ववीर्यम्। अत्रिर्वसिष्ठो जमदग्निरुर्वो बृहस्पतिर्नारदपर्वतौ च॥२२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 235,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवसैन्यानां युद्धोद्योगः",
      "combined_translation": "22-22"
    },
    {
      "verse": 23,
      "sanskrit": "तमन्वयुर्देवगणा महेन्द्रं प्रयान्तमादित्यसमानवर्चसम्। विश्वे च देवा मरुतस्तथैव साध्यास्तथादित्यगणाश्च सर्वे॥२३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 235,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवसैन्यानां युद्धोद्योगः",
      "combined_translation": "23-23"
    },
    {
      "verse": 24,
      "sanskrit": "ते देवराजस्य पुरन्दरस्य हयाश्च ये मातलिसङ्गृहीताः। प्रयान्ति देवेश्वरमुद्रहन्तो नमस्तलं पद्भिरिवाक्षिपन्तः॥२४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 235,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवसैन्यानां युद्धोद्योगः",
      "combined_translation": "24-24"
    },
    {
      "verse": 25,
      "sanskrit": "ब्रह्मर्षयश्चैव महर्षयश्च राजर्षयश्चाक्षयपुण्यलोकाः। सर्वेऽनुजग्मुः सहसा ज्वलन्तं तेजोन्वितं शक्रममित्रसाहम्॥२५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 235,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवसैन्यानां युद्धोद्योगः",
      "combined_translation": "25-25"
    },
    {
      "verse": 26,
      "sanskrit": "प्रगृह्य शूलांश्च परश्वधांश्च दीप्तानि चापान्यशनीर्विचित्राः। वर्माणि चामुच्य हिरण्मयानि प्रयान्ति सूर्यांशुसमप्रभाणि॥२६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 235,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवसैन्यानां युद्धोद्योगः",
      "combined_translation": "26-26"
    },
    {
      "verse": 27,
      "sanskrit": "तथा कुबेरोऽश्वसहस्रयुक्तं श्रेष्ठं रथं सर्वसहं महार्हम्। दिव्यं समारुह्य रणाय यातो धनेश्वरो दीप्तगदाग्रहस्तः॥२७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 235,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवसैन्यानां युद्धोद्योगः",
      "combined_translation": "27-27"
    },
    {
      "verse": 28,
      "sanskrit": "निशाचराः पावकधूमकाया रक्षोवृषा रुद्रसखस्य तस्य। विशालनानायुधदप्तिहस्ता यान्त्यग्रतो वैश्रवणस्य राज्ञः॥२८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 235,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "देवसैन्यानां युद्धोद्योगः",
      "combined_translation": "28-28"
    },
    {
      "verse": 29,
      "sanskrit": "ते लोहिताक्षाः परिवार्य देवं व्रजान्ति भिन्नाञ्जनचूर्णवर्णाः। यक्षोत्तमा यक्षपतिं धनेशं रक्षन्ति वै पाशगदासिहस्ताः॥२९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 235,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
