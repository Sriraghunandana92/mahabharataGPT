{
  "adhyaya_id": "P19_U03_A083",
  "book": 19,
  "parva_name": "हरिवंशः",
  "upaparva_name": "भविष्यपर्व",
  "adhyaya_name": "घण्टाकर्णस्य मुक्तिः",
  "chapter": 266,
  "verse_count": 32,
  "verses": [
    {
      "verse": 1,
      "sanskrit": "वैशम्पायन उवाच।\n              विहस्य विकृतं भूयः प्रनृत्य च यथाबलम्। ब्राह्मणस्य हतस्याथ शवमादाय सत्वरः॥१॥",
      "english": null,
      "bhavadeepa": "केशवेत्यन्तं पठन्॥४३॥",
      "chapter": 266,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "घण्टाकर्णस्य मुक्तिः"
    },
    {
      "verse": 2,
      "sanskrit": "द्विधाकृत्य महाघोरं पिशितं केशशाड्वलम्। ततः खण्डं समादाय अद्भिरभ्युक्ष्य यत्नतः॥२॥",
      "english": null,
      "bhavadeepa": "गृहाणेति॥१॥",
      "chapter": 266,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "घण्टाकर्णस्य मुक्तिः",
      "combined_translation": "2-2"
    },
    {
      "verse": 3,
      "sanskrit": "विधाय पात्रे सुशुभे नमस्कृत्य जनार्दनम्। इदं प्रोवाच देवेशं प्राञ्जलिः प्रणतः स्थितः॥३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 266,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "घण्टाकर्णस्य मुक्तिः",
      "combined_translation": "3-3"
    },
    {
      "verse": 4,
      "sanskrit": "गृहाण मे जगन्नाथ भक्ष्यं योग्यं तव प्रभो। भवादृशैर्जगन्नाथ ग्राह्यं सर्वात्मना हरे॥४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 266,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "घण्टाकर्णस्य मुक्तिः",
      "combined_translation": "4-4"
    },
    {
      "verse": 5,
      "sanskrit": "भक्तिनम्रा वयं विष्णो नात्र कार्या विचारणा। दत्तं यद्भक्तिनम्रेण ग्राह्यं तत्स्वामिना हरे॥५॥",
      "english": null,
      "bhavadeepa": "योग्यं “यदन्नः पुरुषो भवति तदन्नास्तस्य देवता” इति श्रुतेरित्याशयः॥४॥",
      "chapter": 266,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "घण्टाकर्णस्य मुक्तिः",
      "combined_translation": "5-5"
    },
    {
      "verse": 6,
      "sanskrit": "नवं सुसंस्कृतं भक्ष्यं ब्रह्मण्यं शवमुत्तमम्। अस्माकं पिशिताशानां शास्त्रे नियतमेव हि॥६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 266,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "घण्टाकर्णस्य मुक्तिः",
      "combined_translation": "6-6"
    },
    {
      "verse": 7,
      "sanskrit": "तस्माद्गृहाण भगवन्यदि दोषो न विद्यते। इत्युक्त्वा विकृतं भूयो विहस्य स तु कामतः॥७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 266,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "घण्टाकर्णस्य मुक्तिः",
      "combined_translation": "7-7"
    },
    {
      "verse": 8,
      "sanskrit": "दातुमैच्छत्तदा खण्डमस्पृश्यं तु शवस्य ह। ततः प्रीतोऽभवत्तस्मै मनसापूजयच्च तम्॥८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 266,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "घण्टाकर्णस्य मुक्तिः",
      "combined_translation": "8-8"
    },
    {
      "verse": 9,
      "sanskrit": "अहोऽस्य स्नेहकारुण्यं मयि सर्वत्र वर्तते। इति सञ्चिन्त्य मनसा प्रोवाच यदुपुङ्गवः॥९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 266,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "घण्टाकर्णस्य मुक्तिः",
      "combined_translation": "9-9"
    },
    {
      "verse": 10,
      "sanskrit": "अलमेतेन सर्वत्र पिशाच पिशिताशन। अस्पृश्यं मादृशैरेतद्ब्राह्मण्यं शवमुत्तमम्॥१०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 266,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "घण्टाकर्णस्य मुक्तिः",
      "combined_translation": "10-10"
    },
    {
      "verse": 11,
      "sanskrit": "ब्राह्मणः सर्वथा पूज्यो जन्तुभिर्धर्मकाङ्क्षिभिः। पिशाचा घोरकर्माणो यतन्ते ब्रह्महिंसने॥११॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 266,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "घण्टाकर्णस्य मुक्तिः",
      "combined_translation": "11-11"
    },
    {
      "verse": 12,
      "sanskrit": "न हन्तव्याः सदा विप्रास्तद्धिंसा नरकावहा। तस्मादस्पृश्यमस्माभिर्नात्र कार्या विचारणा॥१२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 266,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "घण्टाकर्णस्य मुक्तिः",
      "combined_translation": "12-12"
    },
    {
      "verse": 13,
      "sanskrit": "भक्त्या प्रीतोऽस्मि भद्रं ते मनो निर्मलता मया। मनःशुद्धिं यदा यत्नं ततः प्रीतोऽस्मि मांसप॥१३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 266,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "घण्टाकर्णस्य मुक्तिः",
      "combined_translation": "13-13"
    },
    {
      "verse": 14,
      "sanskrit": "अस्मत्सङ्कीर्तनाच्छश्वच्छुद्धं हि करणं तव। अतीव मनसा प्रीत इत्युक्त्वा भगवान्हरिः॥१४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 266,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "घण्टाकर्णस्य मुक्तिः",
      "combined_translation": "14-14"
    },
    {
      "verse": 15,
      "sanskrit": "पस्पर्शाङ्गं तदा विष्णुः पिशाचस्याथ सर्वतः। करेण मृदुना देवः पापान्निर्मोचयद्धरिः॥१५॥",
      "english": null,
      "bhavadeepa": "करणम् अन्तःकरणम्॥१४॥",
      "chapter": 266,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "घण्टाकर्णस्य मुक्तिः",
      "combined_translation": "15-15"
    },
    {
      "verse": 16,
      "sanskrit": "ततस्तस्याभवद्रूपं कामरूपसमप्रभम्। दीर्घकुञ्चितकेशाढ्यो दीर्घबाहुः सुलोचनः॥१६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 266,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "घण्टाकर्णस्य मुक्तिः",
      "combined_translation": "16-16"
    },
    {
      "verse": 17,
      "sanskrit": "समाङ्गुलिः समनखः समवक्त्रः समुन्नसः। पद्माक्षः पद्मवर्णाभः पद्मकेशरभूषणः॥१७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 266,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "घण्टाकर्णस्य मुक्तिः",
      "combined_translation": "17-17"
    },
    {
      "verse": 18,
      "sanskrit": "केयूरी चाङ्गदी चैव कौशेयवसनस्तदा। ज्ञानवान्सत्त्वसम्पन्नः साक्षादिन्द्र इवापरः॥१८॥",
      "english": null,
      "bhavadeepa": "पद्माक्षः सन्निमेषदृष्टिः। पिशाचानां प्राक् तदभावात्॥१७॥",
      "chapter": 266,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "घण्टाकर्णस्य मुक्तिः",
      "combined_translation": "18-18"
    },
    {
      "verse": 19,
      "sanskrit": "गन्धर्व इव गायंस्तु सिद्धः सिद्ध इव स्वयम्। साक्षत्स्पृष्टं तदा विष्णोः करेण मृदुपूर्वकम्॥१९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 266,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "घण्टाकर्णस्य मुक्तिः",
      "combined_translation": "19-19"
    },
    {
      "verse": 20,
      "sanskrit": "न नूनं तादृशं रूपमासीत्कालान्तरेष्वापि। अद्यापि नैव मुनयो लभन्ते तादृशं वपुः॥२०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 266,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "घण्टाकर्णस्य मुक्तिः",
      "combined_translation": "20-20"
    },
    {
      "verse": 21,
      "sanskrit": "कृत्वा सुबहुशो घोरं तपः परमदरुणम्। यच्च लब्धं तदा तेन पिशाचेन नृपोत्तम॥२१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 266,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "घण्टाकर्णस्य मुक्तिः",
      "combined_translation": "21-21"
    },
    {
      "verse": 22,
      "sanskrit": "को नु नाम जगन्नाथमाश्रितः सीदते नृप। स हि सर्वत्र कल्याणो यो हि नित्यं जनार्दनम्॥२२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 266,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "घण्टाकर्णस्य मुक्तिः",
      "combined_translation": "22-22"
    },
    {
      "verse": 23,
      "sanskrit": "ध्यायन्पठञ्जपन्वापि तस्य किं नास्ति भूपते। ततः प्रोवाच भगवान्स्थितं काममिवापरम्॥२३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 266,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "घण्टाकर्णस्य मुक्तिः",
      "combined_translation": "23-23"
    },
    {
      "verse": 24,
      "sanskrit": "अक्षयः स्वर्गवासस्ते यवादिन्द्रो वसिष्यति। तावत्स्वर्गी भवानस्तु शासनान्मम नान्यतः॥२४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 266,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "घण्टाकर्णस्य मुक्तिः",
      "combined_translation": "24-24"
    },
    {
      "verse": 25,
      "sanskrit": "नष्टे चक्रे ततः स्वर्गात्सायुज्यं मम गच्छतु। योऽयं भ्राता तव स्वर्गी यावदिन्द्रो भवेत्तदा॥२५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 266,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "घण्टाकर्णस्य मुक्तिः"
    },
    {
      "verse": 26,
      "sanskrit": "वरं वरय भद्रं ते यस्ते मनसि वर्तते। दातास्मि सर्वं सर्वत्र नात्र कार्या विचारणा॥२६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 266,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "घण्टाकर्णस्य मुक्तिः",
      "combined_translation": "26-26"
    },
    {
      "verse": 27,
      "sanskrit": "घण्टाकर्ण उवाच।\n              यश्चेमं सङ्गमं देव संस्मरन्नियतात्मवान्। भक्तिस्तस्याचला देव त्वयि भूयज्जनार्दन॥२७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 266,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "घण्टाकर्णस्य मुक्तिः",
      "combined_translation": "27-27"
    },
    {
      "verse": 28,
      "sanskrit": "मनःशुद्धिर्भवेत्तस्य मा भूत्कलुषता हरे। कालुष्यं मनसस्तस्य मा भूदेष वरो मम॥२८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 266,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "घण्टाकर्णस्य मुक्तिः",
      "combined_translation": "28-28"
    },
    {
      "verse": 29,
      "sanskrit": "एवमस्त्विति देवेशः स्वर्गं गच्छेति केशवः। इन्द्रातिथिर्भवानस्तु त्वां प्रतीक्ष्य हरिः स्थितः॥२९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 266,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "घण्टाकर्णस्य मुक्तिः",
      "combined_translation": "29-29"
    },
    {
      "verse": 30,
      "sanskrit": "इत्युक्त्वा भगवान्कृष्ण उत्थाप्य ब्राह्मणं तदा। तेन स्तुतो जगन्नाथः पूजयित्वा च तं द्विजम्॥३०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 266,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "घण्टाकर्णस्य मुक्तिः",
      "combined_translation": "30-30"
    },
    {
      "verse": 31,
      "sanskrit": "ततो विसृज्य गोविन्दस्तस्माद्देशादुपागमत्। यत्र ते मुनयः सिद्धा अग्निहोत्रसमन्विताः॥३१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 266,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "घण्टाकर्णस्य मुक्तिः",
      "combined_translation": "31-31"
    },
    {
      "verse": 32,
      "sanskrit": "स च स्वर्गी ततः स्वर्गमाज्ञया केशवस्य ह। तस्मात्पठ सदा राजन्मनःशुद्धिं यदीच्छसि। मनश्च शुद्धं भवति पठतस्ते जगत्पते॥३२॥",
      "english": null,
      "bhavadeepa": null,
