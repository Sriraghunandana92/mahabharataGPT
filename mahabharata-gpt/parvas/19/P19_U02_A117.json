      "bhavadeepa": null,
      "chapter": 172,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पार्वत्याः सकाशात् उषाया वरलाभः-११७"
    },
    {
      "verse": 26,
      "sanskrit": "ततः क्रीडाविहारं तमनुभूय सहोमया। गतेऽहनि ततः सर्वा नार्यस्ताः परमाद्भुताः॥२६॥",
      "english": null,
      "bhavadeepa": "यत्तव मनोरथं मनोरथगोचरं प्रार्थितं वस्तु तत् देव्या तव दत्तमिति सखीनां वाक्यं प्रतिपूज्य उषा प्रतीक्षते इति शेषः॥२५॥",
      "chapter": 172,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पार्वत्याः सकाशात् उषाया वरलाभः-११७"
    },
    {
      "verse": 27,
      "sanskrit": "ययुः स्वानालयान्सर्वा देवी चादर्शनं गता। काश्चिदश्वैस्तथा यानैर्गजैरन्यास्तथा रथैः॥२७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 172,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पार्वत्याः सकाशात् उषाया वरलाभः-११७"
    },
    {
      "verse": 28,
      "sanskrit": "पुरं प्रविविशुर्हृष्टाः काश्चिदाकाशमास्थिताः। ततः प्रभृति सा देवी काममोहं गता विभो॥२८॥",
