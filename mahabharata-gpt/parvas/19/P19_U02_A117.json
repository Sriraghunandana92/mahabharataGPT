      "bhavadeepa": null,
      "chapter": 172,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पार्वत्याः सकाशात् उषाया वरलाभः-११७"
    },
    {
      "verse": 25,
      "sanskrit": "उषा सखीनां तद्वाक्यं प्रतिपूज्य यथाविधि। यत्तन्मनोरथं देव्या भावयन्ती व्यवस्थिता॥२५॥",
