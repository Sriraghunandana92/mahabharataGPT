  "verses": [
    {
      "verse": 1,
      "sanskrit": "वैशम्पायन उवाच।\n              क्रीदाविहारोपगतः कदाचिदभवद्भवः। देव्या सह नदीतीरे रम्ये श्रीमति स प्रभुः॥१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 172,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पार्वत्याः सकाशात् उषाया वरलाभः-११७"
    },
    {
      "verse": 2,
      "sanskrit": "शतानि तत्राप्सरसां चिक्रीडुश्च समन्ततः। सर्वर्तुकवने रम्ये गन्धर्वपतयस्तथा॥२॥",
      "english": null,
      "bhavadeepa": "क्रीडेति॥१॥",
      "chapter": 172,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पार्वत्याः सकाशात् उषाया वरलाभः-११७",
      "combined_translation": "2-2"
    },
    {
      "verse": 3,
      "sanskrit": "कुसुमैः पारिजातस्य पुष्पैः सन्तानकस्य च। गन्धोद्दाममिवाकाशं नदीतीरं तु सर्वशः॥३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 172,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पार्वत्याः सकाशात् उषाया वरलाभः-११७",
      "combined_translation": "3-3"
    },
    {
      "verse": 4,
      "sanskrit": "वेणुवीणामृदङ्गैश्च पणवैश्च सहस्रशः। वाद्यमानैः स शुश्राव गीतमप्सरसां तदा॥४॥",
      "english": null,
      "bhavadeepa": "सन्तानकस्य कल्पतरुविशेषस्य॥३॥",
      "chapter": 172,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पार्वत्याः सकाशात् उषाया वरलाभः-११७",
      "combined_translation": "4-4"
    },
    {
      "verse": 5,
      "sanskrit": "सूतमागधकल्पैश्चास्तुवन्नप्सरसां गणाः। देवदेवं सुवपुषं स्रग्विणं रक्तवाससम्॥५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 172,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पार्वत्याः सकाशात् उषाया वरलाभः-११७",
      "combined_translation": "5-5"
    },
    {
      "verse": 6,
      "sanskrit": "श्रीमहेशं देवदेवमर्चयन्ति मनोरमम्। ततस्तु देव्या रूपेण चित्रलेखा वराप्सराः॥६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 172,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पार्वत्याः सकाशात् उषाया वरलाभः-११७",
      "combined_translation": "6-6"
    },
    {
      "verse": 7,
      "sanskrit": "भवं प्रसादयामास देवी च प्राहसत्तदा। प्रसादयन्तीमीशानं प्रहसन्त्यप्सरोगणाः॥७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 172,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पार्वत्याः सकाशात् उषाया वरलाभः-११७",
      "combined_translation": "7-7"
    },
    {
      "verse": 8,
      "sanskrit": "भवस्य पार्षदा दिव्या नानारूपा महौजसः। देव्या ह्यनुज्ञया सर्वे क्रीडन्ते तत्र तत्र ह॥८॥",
      "english": null,
      "bhavadeepa": "प्रसादयामासेत्युक्तेरिदं सूचयते- मद्भार्यारूपग्रहणेन मामपि सर्वान्तर्यामिणभियं मोहयितुं प्रवृत्तेति महादेवस्य तस्या उपरि क्रियानपि कोपो जात आसीदिति तत एवापराधात् चित्रलेखा स्वांशेन कुम्भाण्डस्य बाणामात्यस्य कन्या जातेति अग्रिमग्रन्थाद्गम्यते। प्रसादयन्तीं ताम् अप्सरोगणाः प्रहसन्ति ईशेऽपि कापट्यभियं करोतीत्याशयेन॥७॥",
      "chapter": 172,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पार्वत्याः सकाशात् उषाया वरलाभः-११७",
      "combined_translation": "8-8"
    },
    {
      "verse": 9,
      "sanskrit": "अथ ते पार्षदास्तत्र रहस्ये सुविपश्चितः। महादेवस्य रूपेण तच्चिह्नं रूपमास्थिताः॥९॥",
      "english": null,
      "bhavadeepa": "क्रीडन्ते महादेवस्य रूपेणेति द्वयोः सम्बन्धः॥८॥",
      "chapter": 172,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पार्वत्याः सकाशात् उषाया वरलाभः-११७",
      "combined_translation": "9-9"
    },
    {
      "verse": 10,
      "sanskrit": "ततो देव्याः सुरूपेण लीलया वदनेन च। देवी प्रहासं मुमुचे ताश्चैवाप्सरसस्तदा। ततः किलकिलाशब्दः प्रादुर्भूतः समन्ततः॥१०॥",
      "english": null,
      "bhavadeepa": "तच्चिह्नं वृषभध्वजादिचिह्नरूपं देव्या रूपेण युक्ताः अप्सरसोऽपि क्रीडन्त इत्यनुषज्यते॥९॥",
      "chapter": 172,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पार्वत्याः सकाशात् उषाया वरलाभः-११७",
      "combined_translation": "10-10"
    },
    {
      "verse": 11,
      "sanskrit": "प्रहर्षमतुलं लेभे भवः प्रीतमनास्तदा। बाणस्य दुहिता कन्या तत्रोषा नाम भामिनी॥११॥",
      "english": null,
      "bhavadeepa": "ततश्च देवीः प्रहासं मुमुचे। तत्र हेतुः। चित्रलेखाया मानभङ्गार्थं सर्वा अप्सरसो देवीरूपं जगृहुस्तस्याश्च भ्रान्तिमुत्पादयितुं सर्वे पार्षदा महादेवरूपं जगृहुरिति प्रघट्टकार्थः॥१०॥",
      "chapter": 172,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पार्वत्याः सकाशात् उषाया वरलाभः-११७",
      "combined_translation": "11-58"
    },
    {
      "verse": 12,
      "sanskrit": "देवं सङ्क्रीडितं दृष्ट्वा देव्या सह नदीगतम्। दीप्यमानं महादेवं द्वादशादित्यतेजसम्॥१२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 172,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पार्वत्याः सकाशात् उषाया वरलाभः-११७",
      "combined_translation": "12-12"
    },
    {
      "verse": 13,
      "sanskrit": "नानारूपं वपुः कृत्वा देव्याः प्रियचिकीर्षया। उषा मनोरथं चक्रे पार्वत्याः सन्निधौ तथा॥१३॥",
      "english": null,
      "bhavadeepa": "सङ्क्रीडितं क्रीडितम्॥१२॥",
      "chapter": 172,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पार्वत्याः सकाशात् उषाया वरलाभः-११७",
      "combined_translation": "13-13"
    },
    {
      "verse": 14,
      "sanskrit": "धन्या हि भर्तृसहिता रमत्येवं समागताः। मनसा त्वथ सङ्कल्पमुषया भाषितं तथा॥१४॥",
      "english": null,
      "bhavadeepa": "नानारूपं वपुः कृत्वा सङ्क्रीडितमिति पूर्वेण सम्बन्धः॥१३॥",
      "chapter": 172,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पार्वत्याः सकाशात् उषाया वरलाभः-११७",
      "combined_translation": "14-14"
    },
    {
      "verse": 15,
      "sanskrit": "विज्ञाय तदभिप्रायमुषायाः पर्वतात्मजा। प्राह देवी ततो वाक्यमुषां हर्षयती शनैः॥१५॥",
      "english": null,
      "bhavadeepa": "भाषितं सखीजने इति शेषः॥१४॥",
      "chapter": 172,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पार्वत्याः सकाशात् उषाया वरलाभः-११७",
      "english_ref": 1,
      "combined_translation": "1-15"
    },
    {
      "verse": 16,
      "sanskrit": "उषे त्वं शीघ्रमप्येवं भर्त्रा सह रमिष्यसि। यथा देवो मया सार्धं शङ्करः शत्रुनाशनः॥१६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 172,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पार्वत्याः सकाशात् उषाया वरलाभः-११७"
    },
    {
      "verse": 17,
      "sanskrit": "एवमुक्ते तदा देव्या वाक्ये चिन्ताविलेक्षणा। उषा भावं तदा चक्रे भर्त्रा रंस्ये कदा सह॥१७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 172,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पार्वत्याः सकाशात् उषाया वरलाभः-११७"
    },
    {
      "verse": 18,
      "sanskrit": "तदा हैमवती वाक्यं सम्प्रहस्येदमब्रवीत्। उषे शृणुष्व वाक्यं मे यदा संयोगमेष्यसि॥१८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 172,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पार्वत्याः सकाशात् उषाया वरलाभः-११७"
    },
    {
      "verse": 19,
      "sanskrit": "वैशाखे मासि हर्म्यस्थां द्वादश्यां त्वं दिनक्षये। रमयिष्यति यः स्वप्ने स ते भर्ता भविष्यति॥१९॥",
      "english": null,
