      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "पार्वत्याः सकाशात् उषाया वरलाभः-११७"
    },
    {
      "verse": 22,
      "sanskrit": "किन्नर्यो यक्षकन्याश्च नानादैतेयकन्यकाः। अप्सरोगणकन्याश्च उषायाः सखितां गताः॥२२॥",
      "english": null,
