  "verses": [
    {
      "verse": 1,
      "sanskrit": "वैशम्पायन उवाच।\n              गच्छन्नथ महाविष्णुः पुष्करं प्राप्य यादवैः। अपश्यन्मुनिमुख्यांस्तु पुष्करस्थान्नृपोत्तम॥१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 314,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णस्य द्वारवतीगमनम्",
      "combined_translation": "1-2"
    },
    {
      "verse": 2,
      "sanskrit": "ते समेत्य महादेवमृषयो वीतमत्सराः। अर्घ्यादिसमुदाचारं कृत्वैनं यादवोत्तमम्॥२॥",
      "english": null,
      "bhavadeepa": "गच्छन्निति। गच्छन् यादवः सहेति शेषः॥१॥",
      "chapter": 314,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णस्य द्वारवतीगमनम्",
      "english_ref": 1,
      "combined_translation": "1-2"
    },
    {
      "verse": 3,
      "sanskrit": "प्रोचुर्विश्वेश्वरं विष्णुं भूतभव्यभवत्प्रभुम्। अत्यद्भुतमिदं विष्णो तव वीर्यं जनार्दन॥३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 314,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णस्य द्वारवतीगमनम्"
    },
    {
      "verse": 4,
      "sanskrit": "येन तौ निहतौ युद्धे हंसो डिम्भक एव च। यो विचक्रो दुराधर्षो देवैरपि सुदुःसहः॥४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 314,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णस्य द्वारवतीगमनम्"
    },
    {
      "verse": 5,
      "sanskrit": "सङ्गरे निहतो देव दुःसाध्य इति नो मतिः। क्षेमो नः सर्वकार्येषु चरतां तप उत्तमम्॥५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 314,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णस्य द्वारवतीगमनम्"
    },
    {
      "verse": 6,
      "sanskrit": "निष्कल्मषा भविष्यामस्तव संस्मरणाद्धरे। त्वं हि सर्वस्य दुःखस्य हर्ता त्वां ध्यायतां सदा॥६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 314,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णस्य द्वारवतीगमनम्"
    },
    {
      "verse": 7,
      "sanskrit": "त्वदनुस्मरणं जन्तोः सदा पुण्यप्रदं प्रभो। त्वं हि नः सततं धाता विधाता तपसो हरेः॥७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 314,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णस्य द्वारवतीगमनम्"
    },
    {
      "verse": 8,
      "sanskrit": "त्वमोङ्कारो वषट्कारस्त्वं यज्ञस्त्वं पितामहः। त्वं ज्योतिर्ब्रह्मणो मूर्तिस्त्वं ब्रह्मा रुद्र एव च॥८॥",
      "english": null,
      "bhavadeepa": "धाता प्रवर्तकः विधाता फलप्रदः॥७॥",
      "chapter": 314,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णस्य द्वारवतीगमनम्"
    },
    {
      "verse": 9,
      "sanskrit": "प्राणस्त्वं सर्वभूतानामन्तरात्मेति कथ्यते। उपास्यः सर्वभूतानां यज्ञैर्दानैर्जगत्पते॥९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 314,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णस्य द्वारवतीगमनम्"
    },
    {
      "verse": 10,
      "sanskrit": "नमो विश्वसृजे देव नमस्ते विश्वमूर्तये। पाहि लोकमिमं देव हत्वा ब्रह्मद्विषः सदा॥१०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 314,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णस्य द्वारवतीगमनम्"
    },
    {
      "verse": 11,
      "sanskrit": "स तथेति हरिर्विष्णुर्ययौ द्वारवतीं पुरीम्। अवसद्वृष्णिभिः सार्धं स्तूयमानः समागधैः॥११॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 314,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णस्य द्वारवतीगमनम्"
    },
    {
      "verse": 12,
      "sanskrit": "इयं च देवदेवस्य चेष्टा हि जनमेजय। प्रोक्ता ते पृच्छते राजन्किमन्यच्छ्रुतमिच्छसि॥१२॥",
      "english": null,
