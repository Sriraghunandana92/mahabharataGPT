{
  "adhyaya_id": "P19_U02_A123",
  "book": 19,
  "parva_name": "हरिवंशः",
  "upaparva_name": "विष्णुपर्व",
  "adhyaya_name": "ज्वरस्य पराजयो वरलाभश्च-१२३",
  "chapter": 178,
  "verse_count": 39,
  "verses": [
    {
      "verse": 1,
      "sanskrit": "वैशम्पायन उवाच।\n              मृतमित्यभिविज्ञाय ज्वरं शत्रुनिषूदनः। कृष्णो भुजबलाभ्यां तु चिक्षेपाथ महीतले॥१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 178,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "ज्वरस्य पराजयो वरलाभश्च-१२३"
    },
    {
      "verse": 2,
      "sanskrit": "मुक्तमात्रः स बाहुभ्यां कृष्णदेहं विवेश ह। अमुक्त्वा विग्रहं तस्य कृष्णस्याप्रतिमौजसः॥२॥",
      "english": null,
      "bhavadeepa": "मृतमिति॥१॥",
      "chapter": 178,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "ज्वरस्य पराजयो वरलाभश्च-१२३",
      "combined_translation": "2-2"
    },
    {
      "verse": 3,
      "sanskrit": "स ह्याविष्टस्तथा तेन ज्वरेणाप्रतिमौजसा। कृष्णः स्खलन्निव मुहुः क्षितौ गाढं व्यवर्तत॥३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 178,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "ज्वरस्य पराजयो वरलाभश्च-१२३",
      "combined_translation": "3-3"
    },
    {
      "verse": 4,
      "sanskrit": "जृम्भते श्वसते चैव वल्गते च पुनः पुनः। रोमाञ्चोत्थितगात्रश्च निद्रया चाभिभूयते॥४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 178,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "ज्वरस्य पराजयो वरलाभश्च-१२३",
      "combined_translation": "4-4"
    },
    {
      "verse": 5,
      "sanskrit": "ततः स्थैर्यं समालम्ब्य कृष्णः परपुरञ्जयः। विकुर्वति महायोगी जृम्भमाणः पुनः पुनः॥५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 178,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "ज्वरस्य पराजयो वरलाभश्च-१२३",
      "combined_translation": "5-5"
    },
    {
      "verse": 6,
      "sanskrit": "ज्वराभिभूतमात्मानं विज्ञाय पुरुषोत्तमः। सोऽसृजज्ज्वरमन्यं तु पूर्वज्वरविनाशनम्॥६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 178,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "ज्वरस्य पराजयो वरलाभश्च-१२३",
      "combined_translation": "6-6"
    },
    {
      "verse": 7,
      "sanskrit": "घोरं वैष्णवमत्युग्रं सर्वप्राणिभयङ्करम्। संसृष्टवान्स तेजस्वी तं ज्वरं भीमविक्रमम्॥७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 178,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "ज्वरस्य पराजयो वरलाभश्च-१२३",
      "combined_translation": "7-7"
    },
    {
      "verse": 8,
      "sanskrit": "ज्वरः कृष्णविसृष्टस्तु गृहीत्वा तं ज्वरं बलात्। कृष्णाय हृष्टः प्रायच्छत्तं जग्राह ततो हरिः॥८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 178,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "ज्वरस्य पराजयो वरलाभश्च-१२३",
      "combined_translation": "8-8"
    },
    {
      "verse": 9,
      "sanskrit": "ततस्तं परमक्रुद्धो वासुदेवो महाबलः। स्वगात्रात्स्वज्वरेणैव निष्कासयत वीर्यवान्॥९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 178,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "ज्वरस्य पराजयो वरलाभश्च-१२३",
      "combined_translation": "9-86"
    },
    {
      "verse": 10,
      "sanskrit": "आविध्य भूतले चैनं शतधा कर्तुमुद्यतः। व्यघोषत ज्वरस्तत्र भोः परित्रातुमर्हसि॥१०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 178,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "ज्वरस्य पराजयो वरलाभश्च-१२३",
      "combined_translation": "10-10"
    },
    {
      "verse": 11,
      "sanskrit": "आविद्ध्यमाने तस्मिंस्तु कृष्णेनामिततेजसा। अशरीरा ततो वाणी ह्यन्तरिक्षादभाशत॥११॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 178,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "ज्वरस्य पराजयो वरलाभश्च-१२३",
      "combined_translation": "11-11"
    },
    {
      "verse": 12,
      "sanskrit": "कृष्ण कृष्ण महाबाहो यदूनां नन्दिवर्धन। मा वधीर्ज्वरमेनं तु रक्षणीयस्त्वयानघ॥१२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 178,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "ज्वरस्य पराजयो वरलाभश्च-१२३",
      "combined_translation": "12-30"
    },
    {
      "verse": 13,
      "sanskrit": "इत्येवमुक्ते वचने तं मुमोच हरिः स्वयम्। भूतभव्यभविष्यस्य जगतः परमो गुरुः॥१३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 178,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "ज्वरस्य पराजयो वरलाभश्च-१२३",
      "combined_translation": "13-49"
    },
    {
      "verse": 14,
      "sanskrit": "कृष्णस्य पादयोर्मूर्ध्ना शरणं सोऽगमज्ज्वरः। एवमुक्तो हृषीकेशं ज्वरो वाक्यमथाब्रवीत्॥१४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 178,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "ज्वरस्य पराजयो वरलाभश्च-१२३",
      "combined_translation": "14-14"
    },
    {
      "verse": 15,
      "sanskrit": "शृणुष्व मम गोविन्द विज्ञाप्यं यदुनन्दन। यो मे मनोरथो देव तं त्वं कुरु महाभुज॥१५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 178,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "ज्वरस्य पराजयो वरलाभश्च-१२३",
      "combined_translation": "15-15"
    },
    {
      "verse": 16,
      "sanskrit": "अहमेको ज्वरस्तात नान्यो लोके ज्वरो भवेत्। त्वत्प्रसादाद्धि देवेश वरमेनं वृणोम्यहम्॥१६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 178,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "ज्वरस्य पराजयो वरलाभश्च-१२३",
      "combined_translation": "16-16"
    },
    {
      "verse": 17,
      "sanskrit": "देव उवाच।\n              एवं भवतु भद्रं ते यथा त्वं ज्वर काङ्क्षसे। वरार्थिनां वरो देयो भवांश्च शरणं गतः॥१७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 178,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "ज्वरस्य पराजयो वरलाभश्च-१२३",
      "combined_translation": "17-17"
    },
    {
      "verse": 18,
      "sanskrit": "एक एव ज्वरो लोके भवानस्तु यथा पुरा। योऽयं मया ज्वरः सृष्टो मय्येवैष प्रलीयताम्॥१८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 178,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "ज्वरस्य पराजयो वरलाभश्च-१२३",
      "combined_translation": "18-18"
    },
    {
      "verse": 19,
      "sanskrit": "वैशम्पायन उवाच।\n              एवमुक्ते तु वचने ज्वरं प्रति महायशाः। कृष्णः प्रहरतां श्रेष्ठः पुनर्वाक्यमुवाच ह॥१९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 178,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "ज्वरस्य पराजयो वरलाभश्च-१२३",
      "combined_translation": "19-89"
    },
    {
      "verse": 20,
      "sanskrit": "वासुदेव उवाच\n              शृणुष्व ज्वर सन्देशं यथा लोके चरिष्यसि। सर्वजातिषु विश्रब्धं यथा स्थावरजङ्गमे॥२०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 178,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "ज्वरस्य पराजयो वरलाभश्च-१२३",
      "combined_translation": "20-20"
    },
    {
      "verse": 21,
      "sanskrit": "त्रिधा विभज्य चात्मानं मत्प्रियं यदि काङ्क्षसे। चतुष्पादान्भजैकेन द्वितीयेन च स्थावरान्॥२१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 178,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "ज्वरस्य पराजयो वरलाभश्च-१२३",
      "combined_translation": "21-21"
    },
    {
      "verse": 22,
      "sanskrit": "तृतीयो यश्च ते भागो मानुषेषूपपत्स्य ते। त्रिधा भूतं वपुः कृत्वा पक्षिषु त्वं भव ज्वर॥२२॥",
      "english": null,
      "bhavadeepa": "त्रिधेति॥ त्वं त्रिधाभूतं वपुः कृत्वा चतुष्पादादिषु भवेत्यध्याहृत्य योज्यम्॥२१॥",
      "chapter": 178,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "ज्वरस्य पराजयो वरलाभश्च-१२३",
      "combined_translation": "22-22"
    },
    {
      "verse": 23,
      "sanskrit": "चतुर्थो यस्तृतीयस्य भविष्यति स ते ध्रुवम्। एकान्तरस्तृतीयस्तु स वै चातुर्थिको ज्वरः॥२३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 178,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "ज्वरस्य पराजयो वरलाभश्च-१२३",
      "english_ref": 1,
      "combined_translation": "1-23"
    },
    {
      "verse": 24,
      "sanskrit": "मानुषेष्वभिभेदेन वस त्वं प्रविभज्य वै। जातिष्वथावशेषासु निवस त्वं शृणुष्व मे॥२४॥",
      "english": null,
      "bhavadeepa": "तथा तृतीयस्य भागस्य चतुर्थांशः सपक्षिषु ध्रुवो भविष्यतीति योजना॥२३॥",
      "chapter": 178,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "ज्वरस्य पराजयो वरलाभश्च-१२३"
    },
    {
      "verse": 25,
      "sanskrit": "वृक्षेषु कीटरूपेण तथा सङ्कोचपत्रकः। पाण्डुपत्रश्च विख्यातः फलेष्वातुर्यमेव च॥२५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 178,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "ज्वरस्य पराजयो वरलाभश्च-१२३"
    },
    {
      "verse": 26,
      "sanskrit": "अपां तु नीलिकां विद्याच्छिखोद्भेदेन बर्हिणाम्। पद्मिन्यादौ हिमो भूत्वा पृथिव्यामपि चोषरः॥२६॥",
      "english": null,
      "bhavadeepa": "आतुर्यम् एकप्रदेशे जालकेन सङ्कोचः॥२५॥",
      "chapter": 178,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "ज्वरस्य पराजयो वरलाभश्च-१२३"
    },
    {
      "verse": 27,
      "sanskrit": "गैरिकः पर्वतेष्वेव मत्प्रसादाद्भविष्यसि। गोष्वपस्मारको भूत्वा खोरकश्च भविष्यसि॥२७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 178,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "ज्वरस्य पराजयो वरलाभश्च-१२३"
    },
    {
      "verse": 28,
      "sanskrit": "एवं त्वं बहुरूपेण भविष्यसि महीतले। दर्शनात्स्पर्शनाच्चापि प्राणिनां वधमेष्यसि॥२८॥",
      "english": null,
      "bhavadeepa": "अपस्मारकः भूतावेशः। खोरकश्चरणरोगः॥२७॥",
      "chapter": 178,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "ज्वरस्य पराजयो वरलाभश्च-१२३"
    },
    {
      "verse": 29,
      "sanskrit": "ऋते देवमनुष्याणां नान्यस्त्वां विसहिष्यति।\n              वैशम्पायन उवाच।\n              कृष्णस्य वचनं श्रुत्वा ज्वरो हृष्टमना ह्यभूत्॥२९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 178,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "ज्वरस्य पराजयो वरलाभश्च-१२३"
    },
    {
      "verse": 30,
      "sanskrit": "प्रोवाच वचनं किञ्चित्प्रणमित्वा कृताञ्जलिः।\n              ज्वर उवाच।\n              सर्वजातिप्रभुत्वेन कृतो धन्योऽस्मि माधव॥३०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 178,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "ज्वरस्य पराजयो वरलाभश्च-१२३"
    },
