{
  "adhyaya_id": "P19_U03_A109",
  "book": 19,
  "parva_name": "हरिवंशः",
  "upaparva_name": "भविष्यपर्व",
  "adhyaya_name": "दुर्वाससो भाषणम्",
  "chapter": 292,
  "verse_count": 20,
  "verses": [
    {
      "verse": 1,
      "sanskrit": "वैशम्पायन उवाच।\n              ततः क्रुद्धोऽथ दुर्वासा धक्षन्निव तयोरसून्। एकेनाक्ष्णाथ दुर्वासा रौद्रेणाग्नियुजा सदा॥१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 292,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "दुर्वाससो भाषणम्",
      "combined_translation": "1-20"
    },
    {
      "verse": 2,
      "sanskrit": "पश्यंस्तौ च दुरात्मानौ रोषव्याकुलितेन्द्रियः। कुर्वन्निव तदा लोकान्भस्मभूतानिमान्नृप॥२॥",
      "english": null,
      "bhavadeepa": "ततः क्रुद्ध इति॥१॥",
      "chapter": 292,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "दुर्वाससो भाषणम्",
      "combined_translation": "2-2"
    },
    {
      "verse": 3,
      "sanskrit": "ब्राह्मणं चक्षुषा पश्यन्सौम्येनान्येन केवलम्। उवाच वचनं राजन्ध्वंसत ध्वंसतेति च॥३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 292,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "दुर्वाससो भाषणम्",
      "combined_translation": "3-3"
    },
    {
      "verse": 4,
      "sanskrit": "इतो गच्छत राजानौ किं विलम्बत मा चिरम्। न वां वचनसम्भूतं रोषं धारयितुं क्षमे॥४॥",
      "english": null,
      "bhavadeepa": "ब्राह्मणं जनार्दनम्। इतरान् स्वीयान्प्रति ध्वंसत। इतः शीघ्रं प्रस्थानं कुर्वन्त्विति वचनम् उवाचेत्यर्थः॥३॥",
      "chapter": 292,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "दुर्वाससो भाषणम्",
      "combined_translation": "4-4"
    },
    {
      "verse": 5,
      "sanskrit": "अन्यथा वो महीपालान्सर्वान्दग्धुमहं क्षमः। किमतः साहसं वक्तुं कश्च शक्नोति मत्पुरः॥५॥",
      "english": null,
      "bhavadeepa": "तदाह- इतो गच्छतेति। भो राजानावित्यादिवाक्यान्तम्॥४॥",
      "chapter": 292,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "दुर्वाससो भाषणम्",
      "combined_translation": "5-5"
    },
    {
      "verse": 6,
      "sanskrit": "दर्पं वा लोकविख्यातः शङ्खचक्रगदाधरः। व्यपनेष्यति मन्दज्ञौ किं वो वक्ष्यामि साम्प्रतम्॥६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 292,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "दुर्वाससो भाषणम्",
      "combined_translation": "6-6"
    },
    {
      "verse": 7,
      "sanskrit": "तत उत्थाय धर्मात्मा गन्तुमैच्छद्यतीश्वरः। ततो निषेद्धुं हंसस्तं यतते स्म यतीश्वरम्॥७॥",
      "english": null,
      "bhavadeepa": "मन्दज्ञौ मन्दफलं गार्हस्थ्यमेव जानन्तौ॥६॥",
      "chapter": 292,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "दुर्वाससो भाषणम्"
    },
    {
      "verse": 8,
      "sanskrit": "तस्य बाहुं समादाय हंसो नृपवरोत्तमः। कौपीनं चिच्छेदे क्रूरः कृतान्त इव सत्तम॥८॥",
      "english": null,
      "bhavadeepa": "गन्तुं देशान्तरं निषेद्धुं संन्यासधर्मादपाक्रष्टुम्॥७॥",
      "chapter": 292,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "दुर्वाससो भाषणम्",
      "combined_translation": "8-8"
    },
    {
      "verse": 9,
      "sanskrit": "यथयोऽन्ये पलायन्ति दिशो दश विचेतसः। कष्टं हेति वदन्विप्रो मित्रभावाज्जनार्दनः॥९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 292,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "दुर्वाससो भाषणम्"
    },
    {
      "verse": 10,
      "sanskrit": "न्यवारयद्यथाशक्ति किमिदं साहसं त्विति। दुर्वासाः सत्यधर्मस्तु हन्तुमीशोऽपि तं ततः॥१०॥",
      "english": null,
      "bhavadeepa": "हा इतीति च्छैदः॥९॥",
      "chapter": 292,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "दुर्वाससो भाषणम्"
    },
    {
      "verse": 11,
      "sanskrit": "मन्दं मन्दमुवाचेदं हंसं डिम्भकमेव च। शापेनाहं समर्थोऽपि हन्तुं राजकुलाधमौ॥११॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 292,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "दुर्वाससो भाषणम्",
      "combined_translation": "11-11"
    },
    {
      "verse": 12,
      "sanskrit": "तथापि न करोम्यन्तं यतयो ह्यत्र ते वयम्। यो हि देवो जगन्नाथः केशवो यादवेश्वरः॥१२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 292,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "दुर्वाससो भाषणम्",
      "combined_translation": "12-12"
    },
    {
      "verse": 13,
      "sanskrit": "शङ्खचक्रगदापाणिर्गर्वं वां व्यपनेष्यति। लोके तस्मिन्यदुश्रेष्ठं रक्षत्येवं जगत्पतौ॥१३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 292,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "दुर्वाससो भाषणम्",
      "combined_translation": "13-13"
    },
    {
      "verse": 14,
      "sanskrit": "युवयोः सर्वथा जीवः सज्जीव इति मे मतिः। जरासन्धोऽपि वां बन्धुः स च वक्तुं न चेच्छति॥१४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 292,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "दुर्वाससो भाषणम्",
      "combined_translation": "14-14"
    },
    {
      "verse": 15,
      "sanskrit": "ईदृशं लोकविद्विष्टं स हि धर्मपथे सदा। एतावता स वां बन्धुर्न हि भूयो भविष्यति॥१५॥",
      "english": null,
      "bhavadeepa": "युवयोः वां सज्जीवः सदिति मृत्युना स्वर्गमनुलाभादिति भावः॥१४॥",
      "chapter": 292,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "दुर्वाससो भाषणम्",
      "combined_translation": "15-15"
    },
    {
      "verse": 16,
      "sanskrit": "विद्वेषो ह्यस्तु वां तस्य मागधस्य महीपतेः। श्रुत्वेदं घोररूपं तु स हि बन्धुः सहेत चेत्॥१६॥",
      "english": null,
      "bhavadeepa": "एतावता संन्यासिद्रोहेण जरासन्धो बन्धुत्वं युवयोत्स्यक्ष्यतीत्यर्थः॥१५॥",
      "chapter": 292,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "दुर्वाससो भाषणम्",
      "combined_translation": "16-16"
    },
    {
      "verse": 17,
      "sanskrit": "धर्मनाशो भवेत्तस्य नात्र कार्या विचारणा। इत्युक्त्वा गच्छ गच्छेति हंसं प्राह पुनः पुनः॥१७॥",
      "english": null,
      "bhavadeepa": "वां युवाभ्याम्॥१६॥",
      "chapter": 292,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "दुर्वाससो भाषणम्",
      "combined_translation": "17-17"
    },
    {
      "verse": 18,
      "sanskrit": "जनार्दनमुवाचेदं दुर्वासा यतिसत्तमः। स्वस्त्यस्तु तव विप्रेन्द्र भक्तिरस्तु जनार्दने॥१८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 292,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "दुर्वाससो भाषणम्",
      "combined_translation": "18-18"
    },
    {
      "verse": 19,
      "sanskrit": "सङ्गतिस्तव तस्यास्तु शङ्खचक्रगदाभृतः। अद्य श्वो वा परश्वो वा साधुरेव सदा भवान्॥१९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 292,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "दुर्वाससो भाषणम्",
      "combined_translation": "19-19"
    },
    {
      "verse": 20,
      "sanskrit": "न हि साधोर्विनाशोऽस्ति लोकयोरुभयोरपि। गच्छ सर्वं पितुर्ब्रूहि ज्ञात्वा वृत्तं यथाखिलम्॥२०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 292,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "दुर्वाससो भाषणम्",
      "combined_translation": "20-20"
    }
  ]
}