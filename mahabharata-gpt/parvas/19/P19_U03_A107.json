{
  "adhyaya_id": "P19_U03_A107",
  "book": 19,
  "parva_name": "हरिवंशः",
  "upaparva_name": "भविष्यपर्व",
  "adhyaya_name": "दुर्वासोदर्शनम्",
  "chapter": 290,
  "verse_count": 30,
  "verses": [
    {
      "verse": 1,
      "sanskrit": "वैशम्पायन उवाच।\n              जनार्दनश्च धर्मात्मा हंसो डिम्भक एव च। सदः प्रविश्य सत्रस्य नमश्चक्रुर्मुनीश्वरान्॥१॥",
      "english": null,
      "bhavadeepa": "सत्रं यजतः अनुष्ठितः॥१७॥",
      "chapter": 290,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "दुर्वासोदर्शनम्",
      "combined_translation": "1-18"
    },
    {
      "verse": 2,
      "sanskrit": "तानागतान्महात्मानो मुनयः शिष्यसंयुताः। अर्घ्यपाद्यासनादीनि चक्रुः पूजां प्रयत्नतः॥२॥",
      "english": null,
      "bhavadeepa": "जनार्दन इति। सदः यज्ञमण्डपम्॥१॥",
      "chapter": 290,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "दुर्वासोदर्शनम्",
      "combined_translation": "2-2"
    },
    {
      "verse": 3,
      "sanskrit": "तौ नृपौ स च विप्रेन्द्रः सपर्यां प्रतिगृह्य च। प्रीतात्मानो महात्मान आसते ससुखं नृप॥३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 290,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "दुर्वासोदर्शनम्",
      "combined_translation": "3-3"
    },
    {
      "verse": 4,
      "sanskrit": "ततो हंसो बभाषे तान्मुनीन्संयतवाङ् नृप। पिता हि नौ मुनिश्रेष्ठा यष्टुमैच्छत्ससाधनम्॥४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 290,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "दुर्वासोदर्शनम्",
      "combined_translation": "4-4"
    },
    {
      "verse": 5,
      "sanskrit": "गन्तव्यं तत्र युष्माभिः सत्रान्ते मुनिसत्तमाः। राजसूयेन यज्ञेन कृत्वा दिग्विजयं वयम्॥५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 290,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "दुर्वासोदर्शनम्",
      "combined_translation": "5-5"
    },
    {
      "verse": 6,
      "sanskrit": "याजयिष्याम हे विप्राः पितरं धार्मिकं नृपम्। आयान्तु तत्र विप्रेन्द्राः सशिष्याः सपरिच्छदाः॥६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 290,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "दुर्वासोदर्शनम्",
      "combined_translation": "6-6"
    },
    {
      "verse": 7,
      "sanskrit": "वयमद्यैव सहितौ दिशो जेष्यामहे वयम्। शक्ता वयमिहैवैतत्कर्तुं सैनिकसञ्चयैः॥७॥",
      "english": null,
      "bhavadeepa": "सपरिच्छदाः अग्निहोत्रादिसामग्रीसहिताः॥६॥",
      "chapter": 290,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "दुर्वासोदर्शनम्",
      "combined_translation": "7-7"
    },
    {
      "verse": 8,
      "sanskrit": "आवयोः पुरतः स्थातुं न शक्ता देवदानवाः। कैलासनिलयाद्देवाद्वरं लब्धाः स्म यत्नतः॥८॥",
      "english": null,
      "bhavadeepa": "अहयं हयसामग्रीरहितं यथा स्यात्तथा केवलं सैनिकः पुरुषैः सह एवं दिग्विजयाख्यं कार्यं कर्तुं शक्ताविति योजना॥७॥",
      "chapter": 290,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "दुर्वासोदर्शनम्",
      "combined_translation": "8-8"
    },
    {
      "verse": 9,
      "sanskrit": "अजय्यौ शत्रुसङ्घानामस्त्राणि विविधानि च। इत्युक्त्वा विररामैव हंसो मदबलान्वितः॥९॥",
      "english": null,
      "bhavadeepa": "वरं लब्धाः अजेयाः स्मेति योजना॥८॥",
      "chapter": 290,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "दुर्वासोदर्शनम्",
      "combined_translation": "9-9"
    },
    {
      "verse": 10,
      "sanskrit": "मुनय ऊचुः।\n              यदि स्यात्तत्र गच्छामो वयं शिष्यैर्नृपोत्तम। आस्महे वान्यथा राजन्नित्यूचुः किलः तापसाः॥१०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 290,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "दुर्वासोदर्शनम्",
      "combined_translation": "10-10"
    },
    {
      "verse": 11,
      "sanskrit": "वैशम्पायन उवाच।\n              ततो देशान्महाराज गन्तुं निश्चितमानसौ। पुष्करस्योत्तरं तीरं दुर्वासा यत्र तिष्ठति॥११॥",
      "english": null,
      "bhavadeepa": "यदि स्याद्राजसूयः तर्हि तत्र गच्छामोऽन्यथाऽत्रैवास्महे॥१०॥",
      "chapter": 290,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "दुर्वासोदर्शनम्",
      "combined_translation": "11-11"
    },
    {
      "verse": 12,
      "sanskrit": "यतयो नियता भूत्वा मन्त्रब्रह्मनिषेविणः। ब्रह्मसूत्रपदे सक्तास्तदर्थालोकतत्पराः॥१२॥",
      "english": null,
      "bhavadeepa": "एवं कर्मनिष्ठैः संवासं कृत्वा नैष्कर्म्यनिष्ठायुक्तान् उच्छेत्तुं प्रवृत्ता इत्याह- ततो देशानित्यादिना॥११॥",
      "chapter": 290,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "दुर्वासोदर्शनम्",
      "combined_translation": "12-12"
    },
    {
      "verse": 13,
      "sanskrit": "निर्ममा निरहङ्काराः कौपीनाच्छादनव्रताः। तमात्मानं जगद्योनिं विष्णुं विश्वेश्वरं विभुम्॥१३॥",
      "english": null,
      "bhavadeepa": "मन्त्रब्रह्म मन्त्रमयं ब्रह्म प्रणवरूपं, ब्रह्मसूत्रं “ब्रह्मविदाप्नोति परम्” इत्येदि, तत्र निर्दिष्टं यत्पदं पदनीयं वस्तु तत्रासक्ताः तत्प्राप्त्यर्थं यतमानाः॥१२॥",
      "chapter": 290,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "दुर्वासोदर्शनम्",
      "combined_translation": "13-13"
    },
    {
      "verse": 14,
      "sanskrit": "ब्रह्मरूपं शुभं शान्तमक्षरं सर्वतोमुखम्। वेदान्तमूर्तिमव्यक्तमनन्तं शाश्वतं शिवम्॥१४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 290,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "दुर्वासोदर्शनम्"
    },
    {
      "verse": 15,
      "sanskrit": "नित्ययुक्तं विरूपाक्षं भूताधारमनामयम्। ध्यायन्तं सर्वदा देवं मनसा सर्वतोमुखम्॥१५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 290,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "दुर्वासोदर्शनम्",
      "combined_translation": "15-15"
    },
    {
      "verse": 16,
      "sanskrit": "दुर्वाससा सदोपास्यं वेदान्तैकरसं गुरुम्। तर्कनिश्चिततत्त्वार्था ज्ञाननिर्मलचेतसः॥१६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 290,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "दुर्वासोदर्शनम्",
      "combined_translation": "16-16"
    },
    {
      "verse": 17,
      "sanskrit": "हंसाः परमहंसाश्च शिष्या दुर्वाससः प्रभो। गत्वा तत्र महात्मानौ तौ दृष्ट्वा तूर्ध्वरेतसम्॥१७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 290,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "दुर्वासोदर्शनम्",
      "combined_translation": "17-17"
    },
    {
      "verse": 18,
      "sanskrit": "दुर्वाससं महाबुद्धिं विचिन्वानं परं पदम्। क्रुद्धो यदि स दुर्वासा दग्धुं लोकानिमान्क्षमः॥१८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 290,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "दुर्वासोदर्शनम्",
      "combined_translation": "18-18"
    },
    {
      "verse": 19,
      "sanskrit": "देवा अपि च यं द्रष्टुं क्रुद्धं वै न क्षमाः सदा। रोषमूर्तिः सदा यस्तु रुद्रात्मा विश्वरूपधृक्॥१९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 290,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "दुर्वासोदर्शनम्",
      "combined_translation": "19-19"
    },
    {
      "verse": 20,
      "sanskrit": "रक्तकौपीनवसनो हंसः परम एव च। दृष्ट्वैनं च तयोरेवं बुद्धिरासीन्महामते॥२०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 290,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "दुर्वासोदर्शनम्",
      "combined_translation": "20-20"
    },
    {
      "verse": 21,
      "sanskrit": "को नामासौ महाभूतः काषायी वर्णवित्तमः। कश्चायमाश्रमो नाम विहाय च गृहाश्रमम्॥२१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 290,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "दुर्वासोदर्शनम्",
      "combined_translation": "21-21"
    },
    {
      "verse": 22,
      "sanskrit": "गृहस्थ एव धर्मात्मा गृहस्थो धर्मवित्तमः। गृहस्थो धर्मरूपस्तु गृहस्थो वर्ण एव च॥२२॥",
      "english": null,
      "bhavadeepa": "वर्णवित्तमः वर्णविभागविदां श्रेष्ठ इत्युपहासः। सर्ववर्णबहिष्कृत् इत्याशयः॥२१॥",
      "chapter": 290,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "दुर्वासोदर्शनम्",
      "combined_translation": "22-22"
    },
    {
      "verse": 23,
      "sanskrit": "गृहस्थश्च सदा माता प्राणिनां जीविनं सदा। तं विनान्येन रूपेण वर्तते योऽति मूर्खवत्॥२३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 290,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "दुर्वासोदर्शनम्",
      "combined_translation": "23-23"
    },
    {
      "verse": 24,
      "sanskrit": "उन्मत्तोऽयं विरूपोऽयमथ वा मूर्ख एव च। ध्यायन्निव सदा चायमास्ते वञ्चयितापि वा॥२४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 290,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "दुर्वासोदर्शनम्",
      "combined_translation": "24-24"
    },
    {
      "verse": 25,
      "sanskrit": "किमेते प्राकृतज्ञाना ध्यायन्त इति किञ्चन। वयमेतान्दुरारोहानाश्रमानन्तरकल्पकान्॥२५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 290,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "दुर्वासोदर्शनम्",
      "combined_translation": "25-25"
    },
    {
      "verse": 26,
      "sanskrit": "स्थापयिष्यामहे सर्वान्मन्दबुद्धीनिमान्गृहे। बलादेव द्विजानेतान्मूढविज्ञानतत्परान्॥२६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 290,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "दुर्वासोदर्शनम्",
      "combined_translation": "26-26"
    },
    {
      "verse": 27,
      "sanskrit": "असद्ग्राहगृहीतांश्च बालिशान्दुर्मतीनिमान्। एषां शास्ता च को मूढो न विप्रो वयमत्र ह॥२७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 290,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "दुर्वासोदर्शनम्",
      "combined_translation": "27-27"
    },
    {
      "verse": 28,
      "sanskrit": "धर्म्ये वर्त्मनि संस्थाप्य पुनर्यास्याव निर्वृतौ। इति सञ्चिन्त्य तौ वीरौ विप्रेण सहितौ नृप॥२८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 290,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "दुर्वासोदर्शनम्",
      "combined_translation": "28-28"
    },
    {
      "verse": 29,
      "sanskrit": "जनार्दनेन राजानौ मोहाद्भाग्यक्षयान्नृप। समीपं तस्य राजेन्द्र यतेः संयतचेतसः॥२९॥",
      "english": null,
      "bhavadeepa": "संस्थाप्य एषां शास्तारमित्यर्थात्॥२८॥",
      "chapter": 290,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "दुर्वासोदर्शनम्",
      "combined_translation": "29-29"
    },
    {
      "verse": 30,
      "sanskrit": "गत्वा च प्रोचतुरुभौ दुर्वाससमतीन्द्रियम्। यतींश्च नियतान्क्रुद्धौ राजानौ राजसत्तम॥३०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 290,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "दुर्वासोदर्शनम्",
      "combined_translation": "30-30"
    }
  ]
}