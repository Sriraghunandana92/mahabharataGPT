  "chapter": 282,
  "verse_count": 15,
  "verses": [
    {
      "verse": 1,
      "sanskrit": "वैशम्पायन उवाच।\n              क्रव्यादाः सर्व एवाशु भक्षयन्तस्तदा शवम्। हसन्तो विविधं घोरं नदयन्तो वसुन्धराम्॥१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 282,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पौण्ड्रकयुद्धम्",
      "combined_translation": "1-26"
    },
    {
      "verse": 2,
      "sanskrit": "राक्षसाश्च पिशाचाश्च पिबन्तः शोणितं बहु। आशिखं भुञ्जते राजञ्छवस्य पिशिताशनाः॥२॥",
      "english": null,
      "bhavadeepa": "क्रव्यादा इति। शवं शवजातीयम्॥१॥",
      "chapter": 282,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पौण्ड्रकयुद्धम्",
      "combined_translation": "2-2"
    },
    {
      "verse": 3,
      "sanskrit": "नृत्यन्ति स्म तदा राजन्नगर्यां रणतोशिताः। काका बलाका गृध्राश्च श्येना गोमायवस्तथा॥३॥",
      "english": null,
      "bhavadeepa": "आशिखं शिखामपि केशास्थ्यपि न त्यजन्तीत्यर्थः॥२॥",
      "chapter": 282,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पौण्ड्रकयुद्धम्",
      "combined_translation": "3-3"
    },
    {
      "verse": 4,
      "sanskrit": "भक्षयन्तः प्रवर्तन्ते राक्षसाश्चैव दारुणाः। एतस्मिन्नन्तरे वीरो निषादो लब्धसंज्ञकः॥४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 282,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पौण्ड्रकयुद्धम्"
    },
    {
      "verse": 5,
      "sanskrit": "हतान्सर्वान्समालोक्य निषादान्नगचारिणः। गदामादाय कुपितो राममेव जगाम ह॥५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 282,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पौण्ड्रकयुद्धम्"
    },
    {
      "verse": 6,
      "sanskrit": "जघान गदया राजंश्छत्रदेशे निषादपः। ततो रामो गदी राजन्निषादं बाहुशालिनम्॥६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 282,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पौण्ड्रकयुद्धम्",
      "combined_translation": "6-6"
    },
    {
      "verse": 7,
      "sanskrit": "आजघ्ने गदया क्रूरं मदमत्तो हलायुधः। तयोश्च तुमुलं युद्धं गदाभ्यां समवर्तत॥७॥",
      "english": null,
      "bhavadeepa": "छत्रदेशे॥६॥",
      "chapter": 282,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पौण्ड्रकयुद्धम्",
      "combined_translation": "7-7"
    },
    {
      "verse": 8,
      "sanskrit": "आकाशे शब्द आसीत्तु तयोर्युद्धे महाभुज। समुद्राणां यथा घोषः सर्वेषां सन्निगच्छताम्॥८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 282,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पौण्ड्रकयुद्धम्",
      "combined_translation": "8-8"
    },
    {
      "verse": 9,
      "sanskrit": "कल्पक्षये महाराज शब्दः सुतुमुलोऽभवत्। क्षोभितो नागराजश्च नागाः क्षोभं समाययुः॥९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 282,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पौण्ड्रकयुद्धम्",
      "combined_translation": "9-9"
    },
    {
      "verse": 10,
      "sanskrit": "पृथिवी चान्तरिक्षं च सर्वं शब्दमयं बभौ। ततः स पौण्ड्रको राजा सात्यकिं वृष्णिनन्दनम्॥१०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 282,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पौण्ड्रकयुद्धम्",
      "combined_translation": "10-10"
    },
    {
      "verse": 11,
      "sanskrit": "गदयैव जघानाशु सत्वरं रणकोविदः। युयुधानो बली राजन्वासुदेवं जघान ह॥११॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 282,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पौण्ड्रकयुद्धम्",
      "combined_translation": "11-11"
    },
    {
      "verse": 12,
      "sanskrit": "तयोश्च तुमुलः शब्दः प्रादुरासीन्महारणे। चतुर्णां युध्यतां राजन्परस्परवधैषिणाम्॥१२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 282,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पौण्ड्रकयुद्धम्",
      "combined_translation": "12-12"
    },
    {
      "verse": 13,
      "sanskrit": "ब्रह्माण्डक्षोभणो राजन्छब्द आसीत्सुदारुणः। ततो रजः प्रादुरभूत्तस्मिन्सङ्ग्राममूर्धनि॥१३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 282,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पौण्ड्रकयुद्धम्",
      "combined_translation": "13-13"
    },
    {
      "verse": 14,
      "sanskrit": "नारका निष्प्रभा राजंस्तमस्येवं क्षयं गते। उषसि प्रतिबुद्धायां ततो निःशेषतां ययौ॥१४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 282,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पौण्ड्रकयुद्धम्",
      "combined_translation": "14-14"
    },
    {
      "verse": 15,
      "sanskrit": "उदितो भगवान्सूर्यश्चन्द्रश्च क्षयमाययौ। तयोर्युद्धं प्रादुरभूच्चतुर्णां बाहुशालिनाम्। देवासुरसमं राजन्नुदितो भास्करे महत्॥१५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 282,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "पौण्ड्रकयुद्धम्",
      "combined_translation": "15-15"
    }
  ]
