  "chapter": 90,
  "verse_count": 111,
  "verses": [
    {
      "verse": 1,
      "sanskrit": "वैशम्पायन उवाच।\n              मथुरोपवने गत्वा निविष्टांस्तान्नराधिपान्। अपश्यन्वृष्णयः सर्वे पुरस्कृत्य जनार्दनम्॥१॥",
      "english": "Thus, this is the thirty-fourth chapter of first canto called harivamsha-parva, in harivamsha-purANa, the sequel of mahAbhArata, narrating the dynasty of vR^iShNi.",
      "bhavadeepa": null,
      "chapter": 90,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "यादवमागधयुद्धम्-०३५",
      "combined_translation": "1-23"
    },
    {
      "verse": 2,
      "sanskrit": "ततो हृष्टमनाः कृष्णो रामं वचनमब्रवीत्। त्वरते खलु कार्यार्थो देवतानां न संशयः॥२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 90,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "यादवमागधयुद्धम्-०३५",
      "combined_translation": "2-2"
    },
    {
      "verse": 3,
      "sanskrit": "यथायं सन्निकृष्टो हि जरासन्धो नराधिपः। लक्ष्यन्ते हि ध्वजाग्राणि रथानां वातरंहसाम्॥३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 90,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "यादवमागधयुद्धम्-०३५",
      "combined_translation": "3-3"
    },
    {
      "verse": 4,
      "sanskrit": "एतानि शशिकल्पानि नृपाणां विजिगीषताम्। छत्राण्यार्य विराजन्ते प्रोच्छ्रितानि सितानि च॥४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 90,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "यादवमागधयुद्धम्-०३५",
      "combined_translation": "4-4"
    },
    {
      "verse": 5,
      "sanskrit": "अहो नृपरथोदग्रा विमलाश्छत्रपङ्क्तयः। अभिवर्तन्ति नः शुभ्रा यथा खे हंसपङ्क्तयः॥५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 90,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "यादवमागधयुद्धम्-०३५",
      "combined_translation": "5-5"
    },
    {
      "verse": 6,
      "sanskrit": "काले खलु नृपः प्राप्तो जरासन्धो महीपतिः। आवयोर्युद्धनिकषः प्रथमः समरातिथिः॥६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 90,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "यादवमागधयुद्धम्-०३५",
      "combined_translation": "6-6"
    },
    {
      "verse": 7,
      "sanskrit": "आर्य तिष्ठाव सहितावनुप्राप्ते महीपतौ। युद्धारम्भः प्रयोक्तव्यो बलं तावद्विमृश्यताम्॥७॥",
      "english": null,
      "bhavadeepa": "पञ्चत्रिंशे त्वथाध्याये मथुरामेत्य मागधः। रुरोध नगरं सैन्यैश्चतुरङ्गैरितीर्यते॥१॥ मथुरेत्यादि। निकषः स्वर्णनिकषवद्बलाबलनिर्णयहेतुः॥६॥",
      "chapter": 90,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "यादवमागधयुद्धम्-०३५",
      "combined_translation": "7-7"
    },
    {
      "verse": 8,
      "sanskrit": "एवमुक्त्वा ततः कृष्णः स्वस्थः सङ्ग्रामलालसः। जरासन्धबलं प्रेप्सुश्चकार बलदर्शनम्॥८॥",
      "english": null,
      "bhavadeepa": "बलं परेषां सैन्यं गतायुः चिरायुर्वेति विमृश्यतां विचारणीयमित्यर्थः॥७॥",
      "chapter": 90,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "यादवमागधयुद्धम्-०३५",
      "combined_translation": "8-8"
    },
    {
      "verse": 9,
      "sanskrit": "वीक्षमाणश्च तान्सर्वान्नृपान्यदुवरोऽव्ययः। आत्मनैवात्मनो वाक्यमुवाच हृदि मन्त्रवित्॥९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 90,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "यादवमागधयुद्धम्-०३५",
      "combined_translation": "9-9"
    },
    {
      "verse": 10,
      "sanskrit": "इमे ते पृथिवीपालाः पार्थिवे वर्त्मनि स्थिताः। ये विनाशं गमिष्यन्ति शास्त्रदृष्टेन कर्मणा॥१०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 90,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "यादवमागधयुद्धम्-०३५",
      "combined_translation": "10-10"
    },
    {
      "verse": 11,
      "sanskrit": "प्रोक्षितान्खल्विमान्मन्ये मृत्युना नृपपुङ्गवान्। स्वर्गगामीनि चाप्येषां वपूंषि प्रचकाशिरे॥११॥",
      "english": null,
      "bhavadeepa": "पार्थिवे पृथ्वीस्थजनयोग्ये मृत्युमार्गे इत्यर्थः॥१०॥",
      "chapter": 90,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "यादवमागधयुद्धम्-०३५",
      "combined_translation": "11-11"
    },
    {
      "verse": 12,
      "sanskrit": "स्थाने भारपरिश्रान्ता वसुधेयं दिवं गता। एषां नृपाणां मुख्यानां बलौघैरभिपीडिता॥१२॥",
      "english": null,
      "bhavadeepa": "प्रोक्षितान्यज्ञपशुवदासन्नमृत्यून्॥११॥",
      "chapter": 90,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "यादवमागधयुद्धम्-०३५",
      "combined_translation": "12-12"
    },
    {
      "verse": 13,
      "sanskrit": "मही निरन्तरा चेयं बलराष्ट्राभिसंवृता। स्वल्पेन खलु कालेन विविक्तं पृथिवीतलम्॥१३॥",
      "english": null,
      "bhavadeepa": "स्थाने युक्तम्, अस्याः भारावतरणमित्यर्थः। यतः इयं दिवं गता दिविस्थं ब्रह्माणं प्रति शरणं गता॥१२॥",
      "chapter": 90,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "यादवमागधयुद्धम्-०३५",
      "combined_translation": "13-13"
    },
    {
      "verse": 14,
      "sanskrit": "भविष्यति नरेन्द्रौघैः शतशो विनिपातितैः।\n              वैशम्पायन उवाच।\n              जरासन्धस्ततः क्रुद्धः प्रभुः सर्वमहीक्षिताम्॥१४॥",
      "english": null,
      "bhavadeepa": "विविक्तं निर्जनम्॥१३॥",
      "chapter": 90,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "यादवमागधयुद्धम्-०३५",
      "combined_translation": "14-14"
    },
    {
      "verse": 15,
      "sanskrit": "नराधिपसहस्रौघैरनुयातो महाद्युतिः। व्यायतोदग्रतुरगैः सुयानैः सुसमाहितैः॥१५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 90,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "यादवमागधयुद्धम्-०३५",
      "combined_translation": "15-15"
    },
    {
      "verse": 16,
      "sanskrit": "रथैः साङ्ग्रामिकैर्युक्तैरसङ्गगतिभिः क्वचित्। हेमकक्षैर्महाघण्टैर्वारणैर्वारिदोपमैः॥१६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 90,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "यादवमागधयुद्धम्-०३५",
      "combined_translation": "16-16"
    },
    {
      "verse": 17,
      "sanskrit": "महामात्रोत्तमारूढैः कल्पितै रणकोविदैः। स्वारूढैः सादिभिर्युक्तैः प्रेङ्खमाणैः प्रवल्गितैः॥१७॥",
      "english": null,
      "bhavadeepa": "हेमकक्षैः सुवर्णशृङ्खलैः॥१६॥",
      "chapter": 90,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "यादवमागधयुद्धम्-०३५",
      "combined_translation": "17-17"
    },
    {
      "verse": 18,
      "sanskrit": "वाजिभिर्मेघसङ्काशैः प्लवद्भिरिव पत्तिभिः। खड्गचर्मधरोदग्रैः पत्तिभिर्बलिनां वरैः॥१८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 90,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "यादवमागधयुद्धम्-०३५",
      "combined_translation": "18-18"
    },
    {
      "verse": 19,
      "sanskrit": "सहस्रसङ्ख्यासंयुक्तैरुत्पतद्भिरिवोरगैः। एवं चतुर्विधैः सैन्यैः कम्पमानैरिवाम्बुदैः॥१९॥",
      "english": null,
      "bhavadeepa": "प्रेङ्खमाणैः कूर्दमानैः॥१८॥",
      "chapter": 90,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "यादवमागधयुद्धम्-०३५",
      "combined_translation": "19-19"
    },
    {
      "verse": 20,
      "sanskrit": "नृपः प्रयातो बलवाञ्जरासन्धो धृतव्रतः। स रथैर्मेघनिर्घोषैर्गजैश्च मदसंयुतैः॥२०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 90,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "यादवमागधयुद्धम्-०३५",
      "combined_translation": "20-20"
    },
    {
      "verse": 21,
      "sanskrit": "हेषमाणैश्च तुरगैः क्ष्वेडमानैश्च पत्तिभिः। नादयानो दिशः सर्वास्तस्याः पुर्या वनानि च॥२१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 90,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "यादवमागधयुद्धम्-०३५",
      "combined_translation": "21-21"
    },
    {
      "verse": 22,
      "sanskrit": "स राजा सागराकारः ससैन्यः प्रत्यदृश्यत। तद्बलं पृथिवीशानां हृष्टयोधजनाकुलम्॥२२॥",
      "english": null,
      "bhavadeepa": "वनानि च नादयानः॥२१॥",
      "chapter": 90,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "यादवमागधयुद्धम्-०३५",
      "combined_translation": "22-22"
    },
    {
      "verse": 23,
      "sanskrit": "क्ष्वेडितास्फोटितरवं मेघसैन्यमिवाबभौ। रथैः पवनसम्पातैर्गजैश्च जलदोपमैः। तुरगैश्च जवोपेतैः पत्तिभिः खगमोपमैः॥२३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 90,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "यादवमागधयुद्धम्-०३५",
      "english_ref": 1,
      "combined_translation": "1-23"
    },
    {
      "verse": 24,
      "sanskrit": "विमिश्रं सर्वतो भाति मत्तद्विपसमाकुलम्। घर्मान्ते सागरगतं यथाभ्रपटलं तथा॥२४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 90,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "यादवमागधयुद्धम्-०३५",
      "combined_translation": "24-24"
    },
    {
      "verse": 25,
      "sanskrit": "सबलास्ते महीपाला जरासन्धपुरोगमाः। परिवार्य पुरीं सर्वे निवेशायोपचक्रिरे॥२५॥",
      "english": null,
      "bhavadeepa": "विमिश्रं सैन्यमिति शेषः॥२४॥",
      "chapter": 90,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "यादवमागधयुद्धम्-०३५",
      "combined_translation": "25-25"
    },
    {
      "verse": 26,
      "sanskrit": "बभौ तस्य निविष्टस्य फलश्रीः शिबिरस्य वै। शुक्लपर्यन्तपूर्णास्य यथा रूपं महोदधेः॥२६॥",
      "english": null,
      "bhavadeepa": "निवेशाय स्थानपरिग्रहाय॥२५॥",
      "chapter": 90,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "यादवमागधयुद्धम्-०३५",
      "combined_translation": "26-26"
    },
    {
      "verse": 27,
      "sanskrit": "वीतरात्रे ततः काले समुत्तस्थुर्महीक्षितः। आरोहणार्थं पुर्यास्ते समीयुर्युद्धलालसाः॥२७॥",
      "english": null,
      "bhavadeepa": "शिबिरस्य सेनागृहस्य पटमयस्य जात्यभिप्रायमेकवचनम्॥२६॥",
      "chapter": 90,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "यादवमागधयुद्धम्-०३५",
      "combined_translation": "27-27"
    },
    {
      "verse": 28,
      "sanskrit": "समवायीकृताः सर्वे यमुनामनु ते नृपाः। निविष्टा मन्त्रयामासुर्युद्धकालकुतूहलाः॥२८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 90,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "यादवमागधयुद्धम्-०३५",
      "combined_translation": "28-28"
    },
    {
      "verse": 29,
      "sanskrit": "तेषां सुतुमुलः शब्दः शुश्रुवे पृथिवीक्षिताम्। युगान्ते भिद्यमानानां सागराणामिव स्वनः॥२९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 90,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "यादवमागधयुद्धम्-०३५",
      "combined_translation": "29-29"
    },
