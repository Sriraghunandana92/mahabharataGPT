      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "यादवमागधयुद्धम्-०३५"
    },
    {
      "verse": 76,
      "sanskrit": "अथवा तिष्ठत रथैः प्रेक्षकाः समवस्थिताः। यावदेतौ रणे गोपौ प्रेषयामि यमक्षयम्॥७६॥",
      "english": null,
      "bhavadeepa": null,
