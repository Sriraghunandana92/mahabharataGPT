{
  "adhyaya_id": "P19_U02_A083",
  "book": 19,
  "parva_name": "हरिवंशः",
  "upaparva_name": "विष्णुपर्व",
  "adhyaya_name": "यशविस्तरो दुष्टनिग्रहश्च-०८३",
  "chapter": 138,
  "verse_count": 56,
  "verses": [
    {
      "verse": 1,
      "sanskrit": "वैशम्पायन उवाच।\n              एतस्मिन्नेव काले तु चतुर्वेदषडङ्गवित्। ब्राह्मणो याज्ञवल्क्यस्य शिष्यो धर्मगुणान्वितः॥१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 138,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "यशविस्तरो दुष्टनिग्रहश्च-०८३",
      "combined_translation": "1-36"
    },
    {
      "verse": 2,
      "sanskrit": "ब्रह्मदत्तेति विख्यातो विप्रो वाजसनेयिवान्। अश्वमेधः कृतस्तेन वसुदेवस्य धीमतः॥२॥",
      "english": null,
      "bhavadeepa": "त्र्यधिकेऽथाशीतितमेऽत्राध्याये यज्ञविस्तरः। वर्ण्यते ब्रह्मदत्तस्य तत्र दुष्टविनिग्रहः॥१॥ एतस्मिन्निति॥१॥",
      "chapter": 138,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "यशविस्तरो दुष्टनिग्रहश्च-०८३",
      "combined_translation": "2-2"
    },
    {
      "verse": 3,
      "sanskrit": "स संवत्सरदीक्षायां दीक्षितः षट्पुरालयः। आवर्तायाः शुभे तीरे सुनद्या मुनिजुष्टया॥३॥",
      "english": null,
      "bhavadeepa": "ब्रह्मदत्तेत्यत्र सन्धिरार्षः। कारितः सम्पादित इत्यर्थः॥२॥",
      "chapter": 138,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "यशविस्तरो दुष्टनिग्रहश्च-०८३",
      "combined_translation": "3-3"
    },
    {
      "verse": 4,
      "sanskrit": "सखा च वसुदेवस्य सहाध्यायी द्विजोत्तमः। उपाध्यायश्च कौरव्य क्षीरहोता महात्मनः॥४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 138,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "यशविस्तरो दुष्टनिग्रहश्च-०८३",
      "combined_translation": "4-4"
    },
    {
      "verse": 5,
      "sanskrit": "वसुदेवस्तत्र यातो देवक्या सहितः प्रभो। याजमान्ये षट्पुरस्थं यथा शक्रो बृहस्पतिम्॥५॥",
      "english": null,
      "bhavadeepa": "क्षीरहोताऽध्वर्युः॥४॥",
      "chapter": 138,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "यशविस्तरो दुष्टनिग्रहश्च-०८३",
      "combined_translation": "5-5"
    },
    {
      "verse": 6,
      "sanskrit": "तत्सत्रं ब्रह्मदत्तस्य बह्वन्नं बहुदक्षिणम्। उपासन्ति मुनिश्रेष्ठा महात्मानो दृढव्रताः॥६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 138,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "यशविस्तरो दुष्टनिग्रहश्च-०८३",
      "combined_translation": "6-6"
    },
    {
      "verse": 7,
      "sanskrit": "व्यासोऽहं याज्ञवल्क्यश्च सुमन्तुर्जैमिनिस्तथा। धृतिमाञ्जाबलिश्चैव देवलाद्याश्च भारत॥७॥",
      "english": null,
      "bhavadeepa": "उपासन्ति सेवन्ते॥६॥",
      "chapter": 138,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "यशविस्तरो दुष्टनिग्रहश्च-०८३",
      "combined_translation": "7-7"
    },
    {
      "verse": 8,
      "sanskrit": "ऋद्ध्यानुरूपया युक्तं वसुदेवस्य धीमतः। यत्रेप्सितान्ददौ कामान्देवकी धर्मचारिणी॥८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 138,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "यशविस्तरो दुष्टनिग्रहश्च-०८३",
      "combined_translation": "8-8"
    },
    {
      "verse": 9,
      "sanskrit": "वासुदेवप्रभावेण जगत्स्रष्टुर्महीतले। तस्मिन्सत्रे वर्तमाने दैत्याः षट्पुरवासिनः॥९॥",
      "english": null,
      "bhavadeepa": "ददौ समागतेभ्यः॥८॥",
      "chapter": 138,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "यशविस्तरो दुष्टनिग्रहश्च-०८३",
      "combined_translation": "9-9"
    },
    {
      "verse": 10,
      "sanskrit": "निकुम्भाद्याः समागम्य तमूचुर्वरदर्पिताः। कार्यतां यज्ञभागो नः सोमं पास्यामहे वयम्। कन्याश्च ब्रह्मदत्तो नो यजमानः प्रयच्छतु॥१०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 138,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "यशविस्तरो दुष्टनिग्रहश्च-०८३",
      "combined_translation": "10-10"
    },
    {
      "verse": 11,
      "sanskrit": "बह्व्यः सन्त्यस्य कन्याश्च रूपवत्यो महातमनः। आहूय ताः प्रदातव्याः सर्वथैव हि नः श्रुतम्॥११॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 138,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "यशविस्तरो दुष्टनिग्रहश्च-०८३",
      "combined_translation": "11-11"
    },
    {
      "verse": 12,
      "sanskrit": "रत्नानि च ब्रह्मदत्तो विशिष्टानि ददातु नः। अन्यथा तु न यष्टव्यं वयमाज्ञापयामहे॥१२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 138,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "यशविस्तरो दुष्टनिग्रहश्च-०८३",
      "combined_translation": "12-12"
    },
    {
      "verse": 13,
      "sanskrit": "एतच्छ्रुत्वा ब्रह्मदत्तस्तानुवाच महासुरान्। यज्ञभागो न विहितः पुराणेऽसुरसत्तमाः॥१३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 138,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "यशविस्तरो दुष्टनिग्रहश्च-०८३",
      "combined_translation": "13-13"
    },
    {
      "verse": 14,
      "sanskrit": "कथं सत्रे सोमपानं शक्यं दातुं मया हि वः। पृच्छतेह मुनिश्रेष्ठान्वेदभाष्यार्थकोविदान्॥१४॥",
      "english": null,
      "bhavadeepa": "पुराणशब्देनात्र वेदोऽभिधीयते तस्मिन्॥१३॥",
      "chapter": 138,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "यशविस्तरो दुष्टनिग्रहश्च-०८३",
      "combined_translation": "14-14"
    },
    {
      "verse": 15,
      "sanskrit": "कन्या हि मम या देयास्ताश्च सङ्कल्पिता मया। अन्तर्वेद्यां प्रदातव्याः सदृशानामसंशयम्॥१५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 138,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "यशविस्तरो दुष्टनिग्रहश्च-०८३",
      "combined_translation": "15-15"
    },
    {
      "verse": 16,
      "sanskrit": "रत्नानि तु प्रयच्छामि सान्त्वेनाहं विचिन्त्यताम्। बलान्नैव प्रदास्यामि देवकीपुत्रमाश्रितः॥१६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 138,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "यशविस्तरो दुष्टनिग्रहश्च-०८३",
      "combined_translation": "16-16"
    },
    {
      "verse": 17,
      "sanskrit": "निकुम्भाद्यास्तु रुषिताः पापाः षट्पुरवासिनः। यज्ञवाटं विलुलुठुर्जह्रुः कन्याश्च तास्तथा॥१७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 138,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "यशविस्तरो दुष्टनिग्रहश्च-०८३",
      "combined_translation": "17-17"
    },
    {
      "verse": 18,
      "sanskrit": "तद्दृष्ट्वा सम्प्रवृत्तं तु दध्यावानकदुन्दुभिः। वासुदेवं महात्मानं बलभद्रं गदं तथा॥१८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 138,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
