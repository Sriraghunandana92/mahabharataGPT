      "combined_translation": "18-18"
    },
    {
      "verse": 19,
      "sanskrit": "विदितार्थस्ततः कृष्णः प्रद्युम्नमिदमब्रवीत्। गच्छ कन्यापरित्राणं कुरु पुत्राशु मायया॥१९॥",
      "english": null,
      "bhavadeepa": "तत् यज्ञवाटलुण्ठनम्॥१८॥",
      "chapter": 138,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "यशविस्तरो दुष्टनिग्रहश्च-०८३",
      "combined_translation": "19-19"
    },
    {
      "verse": 20,
      "sanskrit": "यावद्यादवसैन्येन षट्पुरं याम्यहं प्रभो। स ययौ षट्पुरं वीरः पितुराज्ञाकरस्तदा॥२०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 138,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "यशविस्तरो दुष्टनिग्रहश्च-०८३",
      "combined_translation": "20-20"
    },
    {
      "verse": 21,
      "sanskrit": "निमेषान्तरमात्रेण गत्वा कामो महाबलः। कन्यास्ता मायया धीमानुपजह्रे महाबलः॥२१॥",
      "english": null,
      "bhavadeepa": "प्रभो इति सम्बोधनम्। कन्यागोप्तृत्वं सम्भावयति॥२०॥",
      "chapter": 138,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "यशविस्तरो दुष्टनिग्रहश्च-०८३",
      "combined_translation": "21-21"
    },
    {
      "verse": 22,
      "sanskrit": "मायामयीश्च कृत्वाऽन्या न्यस्तवान्रुक्मिणीसुतः। मा भैरिति च धर्मात्मा देवकीमुक्तवांस्तदा॥२२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 138,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "यशविस्तरो दुष्टनिग्रहश्च-०८३",
      "combined_translation": "22-22"
    },
    {
      "verse": 23,
      "sanskrit": "मायामयीस्ततो हृत्वा सुता ह्यस्य दुरासदाः। षट्पुरं विविशुर्दैत्याः परितुष्टा नराधिप॥२३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 138,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "यशविस्तरो दुष्टनिग्रहश्च-०८३",
      "combined_translation": "23-23"
    },
    {
      "verse": 24,
      "sanskrit": "कर्म चासार्यते तत्र विधिदृष्टेण कर्मणा। यद्विशिष्टं बहुगुणं तदभूच्च नराधिप॥२४॥",
      "english": null,
      "bhavadeepa": "सुता ब्रह्मदत्तस्य पारम्पर्यतो दुरासदाः॥२३॥",
      "chapter": 138,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "यशविस्तरो दुष्टनिग्रहश्च-०८३",
      "combined_translation": "24-24"
    },
    {
      "verse": 25,
      "sanskrit": "एतस्मिन्नन्तरे प्राप्ता राजानस्तत्र भारत। सत्रे निमन्त्रिताः पूर्वं ब्रह्मदत्तेन धीमता॥२५॥",
      "english": null,
      "bhavadeepa": "कर्म सत्राख्यम् आसार्यते प्रसार्यते विधीयत इत्यर्थः॥२४॥",
      "chapter": 138,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "यशविस्तरो दुष्टनिग्रहश्च-०८३",
      "english_ref": 7,
      "combined_translation": "7-25"
    },
    {
      "verse": 26,
      "sanskrit": "जरासन्धो दन्तवक्त्रः शिशुपालस्तथैव च। पाण्डवाः धार्तराष्ट्राश्च मालवाः सगणास्तथा॥२६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 138,
      "parva_name": "हरिवंशः",
