{
  "adhyaya_id": "P19_U03_A134",
  "book": 19,
  "parva_name": "हरिवंशः",
  "upaparva_name": "भविष्यपर्व",
  "adhyaya_name": "हरिवंशवृत्तान्तसङ्ग्रहः",
  "chapter": 317,
  "verse_count": 31,
  "verses": [
    {
      "verse": 1,
      "sanskrit": "वैशम्पायन उवाच।\n              हरिवंशेऽत्र वृत्तान्ताः प्रकीर्त्यन्ते क्रमोदिताः। तत्राद्यमादिसर्गस्तु भूतसर्गस्ततः परः॥१॥",
      "english": null,
      "bhavadeepa": "विष्णुर्धर्मः योगेन साम्यबुद्ध्यानुष्ठितः सन् प्रस्मयन् आश्चर्यमिव स्तूयते। अविद्यामुपजीव्य प्रवृत्तोऽपि तामेव मूलत उच्छिनत्तीत्याश्चर्यम्। तदेव मनेनाध्यायेन कृत्स्नस्य भारतस्य तात्पर्यं वर्णितं धर्मबलेनैव विद्योत्पत्तावविद्योच्छेदात्परमानन्दाभिव्यक्तिरिति शिवम्॥८३॥",
      "chapter": 317,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हरिवंशवृत्तान्तसङ्ग्रहः"
    },
    {
      "verse": 2,
      "sanskrit": "पृथोर्वैन्यस्य चाख्यानं मनूनां कीर्तनं तथा। वैवस्वतकुलोत्पत्तिर्धुन्धुमारकथा तथा॥२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 317,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हरिवंशवृत्तान्तसङ्ग्रहः"
    },
    {
      "verse": 3,
      "sanskrit": "गालवोत्पत्तिरिक्ष्वाकुवंशस्याप्यनुकीर्तनम्। पितृकल्पस्तथोत्पत्तिः सोमस्य च बुधस्य च॥३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 317,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हरिवंशवृत्तान्तसङ्ग्रहः"
    },
    {
      "verse": 4,
      "sanskrit": "अमावसोरन्वयस्य कीर्तनं कीर्तिवर्धनम्। च्युतिप्रतिष्ठे शक्रस्य प्रसवः क्षत्रवृद्धजः॥४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 317,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हरिवंशवृत्तान्तसङ्ग्रहः"
    },
    {
      "verse": 5,
      "sanskrit": "दिवोदासप्रतिष्ठा च त्रिशङ्कोः क्षत्रियस्य च। ययातिचरितं चैव पुरुवंशस्य कीर्तनम्॥५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 317,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हरिवंशवृत्तान्तसङ्ग्रहः"
    },
    {
      "verse": 6,
      "sanskrit": "कीर्तनं कृष्णसम्भूतेः स्यमन्तकमणेस्तथा। सङ्क्षेपात्कीर्तिता विष्णोः प्रादुर्भावास्ततः परम्॥६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 317,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हरिवंशवृत्तान्तसङ्ग्रहः"
    },
    {
      "verse": 7,
      "sanskrit": "तारकामययुद्धं च ब्रह्मलोकस्य वर्णनम्। योगनिद्रासमुत्थानं विष्णोर्वाक्यं च वेधसः॥७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 317,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हरिवंशवृत्तान्तसङ्ग्रहः"
    },
    {
      "verse": 8,
      "sanskrit": "पृथ्वीवाक्यं च देवानामंशावतरणं तथा। ततो नारदवाक्यं च स्वप्नगर्भविधिस्तथा॥८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 317,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हरिवंशवृत्तान्तसङ्ग्रहः"
    },
    {
      "verse": 9,
      "sanskrit": "आर्यास्तवः पुनः कृष्णसमुत्पत्तिः प्रपञ्चतः। गोव्रजे गमनं विष्णोः शकटस्य निवर्तनम्॥९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 317,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हरिवंशवृत्तान्तसङ्ग्रहः"
    },
    {
      "verse": 10,
      "sanskrit": "पूतनाया वधो भङ्गो यमलार्जुनयोरपि। वृकसन्दर्शनं चैव वृन्दावननिवेशनम्॥१०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 317,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हरिवंशवृत्तान्तसङ्ग्रहः"
    },
    {
      "verse": 11,
      "sanskrit": "प्रावृषो वर्णनं चापि यमुनाह्रददर्शनम्। कालियस्यापि दमनं धेनुकस्य च भञ्जनम्॥११॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 317,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हरिवंशवृत्तान्तसङ्ग्रहः"
    },
    {
      "verse": 12,
      "sanskrit": "प्रलम्बनिधनं चैव शरद्वर्णनमेव च। गिरियज्ञप्रवृत्तिश्च गोवर्धनविधारणम्॥१२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 317,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हरिवंशवृत्तान्तसङ्ग्रहः"
    },
    {
      "verse": 13,
      "sanskrit": "गोविन्दस्याभिषेकं च गोपीसङ्क्रीडनं तथा। रिष्टासुरस्य निधनमक्रूरप्रेषणं तथा॥१३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 317,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हरिवंशवृत्तान्तसङ्ग्रहः"
    },
    {
      "verse": 14,
      "sanskrit": "अन्धकस्य च वाक्यानि केशिनो निधनं तथा। अक्रूरागमनं चैव नागलोकस्य दर्शनम्॥१४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 317,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हरिवंशवृत्तान्तसङ्ग्रहः"
    },
    {
      "verse": 15,
      "sanskrit": "धनुर्भङ्गस्य कथनं कंसवाक्यमतः परम्। कुवलयापीडवधश्चाणूरान्ध्रवधस्तथा॥१५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 317,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हरिवंशवृत्तान्तसङ्ग्रहः"
    },
    {
      "verse": 16,
      "sanskrit": "कंसस्य निधनं चापि विलापः कंसयोषिताम्। उग्रसेनाभिषेकश्च यादवाश्वासनं तथा॥१६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 317,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हरिवंशवृत्तान्तसङ्ग्रहः"
    },
    {
      "verse": 17,
      "sanskrit": "प्रत्यागतिर्गुरुकुलादथोक्ता रामकृष्णयोः। मथुरायाश्चोपरोधो जरासन्धनिवर्तनम्॥१७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 317,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हरिवंशवृत्तान्तसङ्ग्रहः"
    },
    {
      "verse": 18,
      "sanskrit": "विकद्रुवाक्यं रामस्य दर्शनं भाषणं तथा। गोमन्तारोहणं चापि जरासन्धगतिस्तथा॥१८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 317,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हरिवंशवृत्तान्तसङ्ग्रहः"
    },
    {
      "verse": 19,
      "sanskrit": "गोमन्तस्य गिरेर्दाहः करवीरपुरे गतिः। शृगालस्य वधस्तत्र मथुरागमनं ततः॥१९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 317,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हरिवंशवृत्तान्तसङ्ग्रहः"
    },
    {
      "verse": 20,
      "sanskrit": "यमुनाकर्षणं चैव मथुरापक्रमस्तथा। उपायेन वधः कालयवनस्य प्रकीर्तितः॥२०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 317,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हरिवंशवृत्तान्तसङ्ग्रहः"
    },
    {
      "verse": 21,
      "sanskrit": "निर्माणं द्वारवत्यास्तु रुक्मिणीहरणं तथा। विवाहश्चैव रुक्मिण्या रुक्मिणो निधनं तथा॥२१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 317,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हरिवंशवृत्तान्तसङ्ग्रहः"
    },
    {
      "verse": 22,
      "sanskrit": "बलदेवाह्निकं पुण्यं बलमाहात्म्यमेव च। नरकस्य वधः पारिजातस्य हरणं तथा॥२२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 317,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हरिवंशवृत्तान्तसङ्ग्रहः"
    },
    {
      "verse": 23,
      "sanskrit": "द्वारवत्या विशेषेण पुनर्निर्माणकीर्तनम्। द्वारकायां प्रवेशश्च सभायां च प्रवेशनम्॥२३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 317,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हरिवंशवृत्तान्तसङ्ग्रहः"
    },
    {
      "verse": 24,
      "sanskrit": "नारदस्य च वाक्यानि वृष्णिवंशानुकीर्तनम्। षट्पुरस्य वधाख्यानं मेध्यकस्य निबर्हणम्॥२४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 317,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हरिवंशवृत्तान्तसङ्ग्रहः"
    },
    {
      "verse": 25,
      "sanskrit": "समुद्रयात्रा कृष्णस्य जलक्रीडाकुतूहलम्। तथा भैमप्रवीराणां मधुपानप्रवर्तकम्॥२५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 317,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हरिवंशवृत्तान्तसङ्ग्रहः"
    },
    {
      "verse": 26,
      "sanskrit": "ततश्छालिक्यगान्धर्वसमुदाहरणं हरेः। भानोश्च दुहितुर्भानुमत्या हरणकीर्तनम्॥२६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 317,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हरिवंशवृत्तान्तसङ्ग्रहः"
    },
    {
      "verse": 27,
      "sanskrit": "शम्बरस्य वधश्चैव धन्योपाख्यानमेव च। वासुदेवस्य महात्म्यं बाणयुद्धं प्रपञ्चितम्॥२७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 317,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हरिवंशवृत्तान्तसङ्ग्रहः"
    },
    {
      "verse": 28,
      "sanskrit": "भविष्यं पुष्करं चैव प्रपञ्चेनैव कीर्तितम्। वराहं नारसिंहं च वामनं बहुविस्तरम्॥२८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 317,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हरिवंशवृत्तान्तसङ्ग्रहः"
    },
    {
      "verse": 29,
      "sanskrit": "कैलासयात्रा कृष्णस्य पौण्ड्रकस्य वधस्ततः। हंसस्य डिम्भकस्यैव वधश्चैव प्रकीर्तितः॥२९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 317,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हरिवंशवृत्तान्तसङ्ग्रहः"
    },
    {
      "verse": 30,
      "sanskrit": "पुरत्रयस्य संहार इति वृत्तान्तसङ्ग्रहः। कथितो नृपशार्दूल सर्वपापप्रणाशनः॥३०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 317,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हरिवंशवृत्तान्तसङ्ग्रहः"
    },
    {
      "verse": 31,
      "sanskrit": "वृत्तान्तं शृणुयाद्यस्तु सायं प्रातः समाहितः। स याति वैष्णवं धाम लब्धकामाः कुरूद्वह। धन्यं यशस्यमायुष्यं भुक्तिमुक्तिफलप्रदम्॥३१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 317,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "हरिवंशवृत्तान्तसङ्ग्रहः"
    }
  ]
}