{
  "adhyaya_id": "P19_U02_A093",
  "book": 19,
  "parva_name": "हरिवंशः",
  "upaparva_name": "विष्णुपर्व",
  "adhyaya_name": "वज्रनाभपुरे प्रद्युम्नप्रवेशः-०९३",
  "chapter": 148,
  "verse_count": 62,
  "verses": [
    {
      "verse": 1,
      "sanskrit": "वैशम्पायन उवाच।\n              ततः स्वपुरवासीनामसुराणां नराधिप। ददावाज्ञां वज्रनाभो दीयतां गृहमुत्तमम्॥१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 148,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "वज्रनाभपुरे प्रद्युम्नप्रवेशः-०९३"
    },
    {
      "verse": 2,
      "sanskrit": "आतिथ्यं क्रियतामेषां बहुरत्नमुपायनम्। वासांसि सुविचित्राणि सुखाय जनरञ्जनम्॥२॥",
      "english": null,
      "bhavadeepa": "ततः पूर्वश्रुतो भद्रनामा नट एवात्र प्राप्त इति तेषां बुद्धिरभूदित्यर्थः॥१॥",
      "chapter": 148,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "वज्रनाभपुरे प्रद्युम्नप्रवेशः-०९३",
      "combined_translation": "2-2"
    },
    {
      "verse": 3,
      "sanskrit": "भर्तुराज्ञां समालभ्य तथा चक्रुश्च सर्वशः। पूर्वाश्रुतो नटः प्राप्तः कौतूहलमजीजनत्॥३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 148,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "वज्रनाभपुरे प्रद्युम्नप्रवेशः-०९३",
      "combined_translation": "3-3"
    },
    {
      "verse": 4,
      "sanskrit": "नटस्याथ ददुर्दैत्याः सत्कारं परया मुदा। पर्यायार्थे ददुश्चापि रत्नानि सुबहून्यथ॥४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 148,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "वज्रनाभपुरे प्रद्युम्नप्रवेशः-०९३",
      "combined_translation": "4-4"
    },
    {
      "verse": 5,
      "sanskrit": "ततः स ननृते तत्र वरदत्तो नटस्तथा। स्वपुरे पुरवासीनां परं हर्षं समादधत्॥५॥",
      "english": null,
      "bhavadeepa": "पर्यायार्थे वेषधारणार्थम्॥४॥",
      "chapter": 148,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "वज्रनाभपुरे प्रद्युम्नप्रवेशः-०९३",
      "combined_translation": "5-5"
    },
    {
      "verse": 6,
      "sanskrit": "रामायणं महाकाव्यमुद्देश्यं नाटकीकृतम्। जन्म विष्णोरमेयस्य राक्षसेन्द्रवधेप्सया॥६॥",
      "english": null,
      "bhavadeepa": "वासीनां दैर्घ्यमार्षम्॥५॥",
      "chapter": 148,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "वज्रनाभपुरे प्रद्युम्नप्रवेशः-०९३",
      "combined_translation": "6-6"
    },
    {
      "verse": 7,
      "sanskrit": "लोमपादो दशरथ ऋष्यशृङ्गं महामुनिम्। शान्तामप्यानयामास गणिकाभिः सहानघ॥७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 148,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "वज्रनाभपुरे प्रद्युम्नप्रवेशः-०९३",
      "combined_translation": "7-7"
    },
    {
      "verse": 8,
      "sanskrit": "रामलक्ष्मणशत्रुघ्ना भरतश्चैव भारत। ऋष्यशृङ्गश्च शान्ता च तथारूपैर्नटैः कृताः॥८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 148,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "वज्रनाभपुरे प्रद्युम्नप्रवेशः-०९३",
      "combined_translation": "8-8"
    },
    {
      "verse": 9,
      "sanskrit": "तत्कालजीविनो वृद्धा दानवा विस्मयं गताः। आचचक्षुश्च तेषां वै रूपतुल्यत्वमच्युतम्॥९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 148,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "वज्रनाभपुरे प्रद्युम्नप्रवेशः-०९३",
      "combined_translation": "9-9"
    },
    {
      "verse": 10,
      "sanskrit": "संस्काराभिनयौ तेषां प्रस्तावानां च धारणम्। दृष्ट्वा सर्वे प्रवेशं च दानवा विस्मयं गताः॥१०॥",
      "english": null,
      "bhavadeepa": "अच्युत हे राजन्॥९॥",
      "chapter": 148,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "वज्रनाभपुरे प्रद्युम्नप्रवेशः-०९३",
      "combined_translation": "10-10"
    },
    {
      "verse": 11,
      "sanskrit": "ते रक्ता विस्मयं नेदुरसुराः परया मुदा। उत्थायोत्थाय नाट्यस्य विषयेषु पुनः पुनः॥११॥",
      "english": null,
      "bhavadeepa": "संस्कारः वेषधारणम् अभिनयः क्रियादर्शनं प्रस्तावः क्रियाणां प्रसञ्जनं प्रवेशं पात्राणां प्रथमदर्शनम्॥१०॥",
      "chapter": 148,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "वज्रनाभपुरे प्रद्युम्नप्रवेशः-०९३",
      "combined_translation": "11-11"
    },
    {
      "verse": 12,
      "sanskrit": "ददुर्वस्त्राणि तुष्टाश्च ग्रैवेयवलयानि च। हारान्मनोहरांश्चैव हेमवैडूर्यभूषितान्॥१२॥",
      "english": null,
      "bhavadeepa": "विस्मयं सविस्मयं साश्चर्यम्॥११॥",
      "chapter": 148,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "वज्रनाभपुरे प्रद्युम्नप्रवेशः-०९३",
      "combined_translation": "12-12"
    },
    {
      "verse": 13,
      "sanskrit": "पृथगर्थेषु दत्तेषु लोकैस्ते तुष्टुवुर्नटाः। असुरांश्च मुनींश्चैव गोत्रैरभिजनैरपि॥१३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 148,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "वज्रनाभपुरे प्रद्युम्नप्रवेशः-०९३",
      "combined_translation": "13-13"
    },
    {
      "verse": 14,
      "sanskrit": "प्रेषितं वज्रनाभस्य शाखानगरवासिभिः। नटस्य दिव्यरूपस्य नरेन्द्रागमनं तदा॥१४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 148,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "वज्रनाभपुरे प्रद्युम्नप्रवेशः-०९३",
      "combined_translation": "14-14"
    },
    {
      "verse": 15,
      "sanskrit": "पुरा श्रुतार्थो दैत्येन्द्रः प्रेषयामास भारत। आनीयतां वज्रपुरं नतोऽसाविति हर्षितः॥१५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 148,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "वज्रनाभपुरे प्रद्युम्नप्रवेशः-०९३",
      "combined_translation": "15-15"
    },
    {
      "verse": 16,
      "sanskrit": "दानवेन्द्रवचः श्रुत्वा शाखानगरवासिभिः। नीता वज्रपुरं रम्यं नटवेषेण यादवाः॥१६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 148,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "वज्रनाभपुरे प्रद्युम्नप्रवेशः-०९३",
      "combined_translation": "16-16"
    },
    {
      "verse": 17,
      "sanskrit": "आवासश्च ततो दत्तः सुकृतो विश्वकर्मणा। एष्टव्यं यच्च तत्सर्वं दत्तं शतगुणोत्तरम्॥१७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 148,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "वज्रनाभपुरे प्रद्युम्नप्रवेशः-०९३",
      "combined_translation": "17-17"
    },
    {
      "verse": 18,
      "sanskrit": "अथ कालोत्सवं चक्रे वज्रनाभो महासुरः। कारयामास रम्यं च चमूवाटं प्रहृष्टवान्॥१८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 148,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "वज्रनाभपुरे प्रद्युम्नप्रवेशः-०९३",
      "combined_translation": "18-18"
    },
    {
      "verse": 19,
      "sanskrit": "ततस्तान्परिविश्रान्तान्प्रेक्षार्थाय प्रचोदयत्। दत्त्वा रत्नानि भूरीणि वज्रनाभो महाबलः॥१९॥",
      "english": null,
      "bhavadeepa": "कालोत्सवं महाकालरुद्रस्योत्सवं चक्रे नटद्वारा चमूवाटं सैनिकाह्वानं प्रेक्षणार्थम्॥१८॥",
      "chapter": 148,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "वज्रनाभपुरे प्रद्युम्नप्रवेशः-०९३",
      "combined_translation": "19-19"
    },
    {
      "verse": 20,
      "sanskrit": "उपविष्टश्च तान्द्रष्टुं सह ज्ञातिभिरात्मवान्। छन्ने चान्तःपुरं स्थाप्य चक्षुर्दृश्ये नराधिपः॥२०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 148,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "वज्रनाभपुरे प्रद्युम्नप्रवेशः-०९३",
      "combined_translation": "20-20"
    },
    {
      "verse": 21,
      "sanskrit": "भैमापि बद्धनेपथ्या नटवेषधरास्तथा। कार्यार्थं भीमकर्माणो नृत्यार्थमुपचक्रमुः॥२१॥",
      "english": null,
      "bhavadeepa": "छन्ने जालजवनिकापिहितस्थाने अत एव चक्षुदृश्य चक्षुःसन्निहितं दृश्यं नाट्यं यत्र तत्तथाभूते॥२०॥",
      "chapter": 148,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "वज्रनाभपुरे प्रद्युम्नप्रवेशः-०९३",
      "combined_translation": "21-21"
    },
    {
      "verse": 22,
      "sanskrit": "ततो घनं ससुषिरं मुरजानकभूषितम्। तन्त्रीस्वरगणैर्विद्धानातोद्यानन्ववादयन्॥२२॥",
      "english": null,
      "bhavadeepa": "भैमा अपीति सन्धिरार्षः॥२१॥",
      "chapter": 148,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "वज्रनाभपुरे प्रद्युम्नप्रवेशः-०९३",
      "combined_translation": "22-22"
    },
    {
      "verse": 23,
      "sanskrit": "ततस्तु देवगान्धारं छालिक्यं श्रवणामृतम्। भैमस्त्रियः प्रजगिरे मनःश्रोत्रसुखावहम्॥२३॥",
      "english": null,
      "bhavadeepa": "घनं कांस्यतालादिकं ससुषिरं सच्छिद्रं वेणुप्रभृतिकं मुरजा मर्दलाः आनकः पटहः तन्त्रीति रुद्रवीणादिकानामुपलक्षणम् एवमादीनातोद्यान् वाद्यविशेषान्॥२२॥",
      "chapter": 148,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "वज्रनाभपुरे प्रद्युम्नप्रवेशः-०९३",
      "combined_translation": "23-23"
    },
    {
      "verse": 24,
      "sanskrit": "आगान्धारग्रामरागं गङ्गावतरणं तथा। विद्धमासारितं रम्यं जगिरे स्वरसम्पदा॥२४॥",
      "english": null,
      "bhavadeepa": "भैमस्त्रियः भैमैरानीता वारनार्यः॥२३॥",
      "chapter": 148,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "वज्रनाभपुरे प्रद्युम्नप्रवेशः-०९३",
      "combined_translation": "24-24"
    },
    {
      "verse": 25,
      "sanskrit": "लयतालसमं श्रुत्वा गङ्गावतरणं शुभम्। असुरांस्तोषयामास उत्थायोत्थाय भारत॥२५॥",
      "english": null,
      "bhavadeepa": "आगान्धारमिति। निषादर्षभगान्धारषड्जमध्यमधैवताख्यान् सप्त स्वरान् व्याप्य ग्रामः कतिपयस्वरसङ्घः। ते च त्रयः। रागो वसन्तादिः। साकल्येन गान्धारादयो यत्र तत् गङ्गावतरणं नाम गीतविशेषविद्धं रागान्तरमिश्रम् आसारितं मूर्च्छितं जगिरे गीतं कृतवत्यः॥२४॥",
      "chapter": 148,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "वज्रनाभपुरे प्रद्युम्नप्रवेशः-०९३",
      "combined_translation": "25-25"
    },
    {
      "verse": 26,
      "sanskrit": "नन्दिं च वादयामास प्रद्युम्नो गद एव च। साम्बश्च वीर्यसम्पन्नः कार्यार्थं नटतां गतः॥२६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 148,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "वज्रनाभपुरे प्रद्युम्नप्रवेशः-०९३",
      "english_ref": 1,
      "combined_translation": "1-26"
    },
    {
      "verse": 27,
      "sanskrit": "नान्द्यन्ते च तदा श्लोकं गङ्गावतरणाश्रितम्। रौक्मिणेयस्तदोवाच सम्यक्स्वभिनयान्वितम्॥२७॥",
      "english": null,
