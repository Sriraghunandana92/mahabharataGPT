  "adhyaya_name": "बलदेवमाहात्म्यम्-०६२",
  "chapter": 117,
  "verse_count": 20,
  "verses": [
    {
      "verse": 1,
      "sanskrit": "राजोवाच।\n              भूय एव तु विप्रर्षे बलदेवस्य धीमतः। माहात्म्यं श्रोतुमिच्छामि शेषस्य धरणीभृतः॥१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 117,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "बलदेवमाहात्म्यम्-०६२"
    },
    {
      "verse": 2,
      "sanskrit": "अतीव बलदेवं तं तेजोराशिमनिर्जितम्। कथयन्ति महात्मानं ये पुराणविदो जनाः॥२॥",
      "english": null,
      "bhavadeepa": "अथाध्याये षष्टितमे द्व्यधिकेऽस्मिन्निरूप्यते। बलदेवस्य माहात्म्यं भूरि भाग्यवतां प्रियम्॥१॥ भूय इति॥१॥",
      "chapter": 117,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "बलदेवमाहात्म्यम्-०६२",
      "combined_translation": "2-149"
    },
    {
      "verse": 3,
      "sanskrit": "तस्य कर्माण्यहं विप्र श्रोतुमिच्छामि तत्त्वतः। अनन्तं यं विदुर्नागमादिदेवं नगेश्वरम्॥३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 117,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "बलदेवमाहात्म्यम्-०६२",
      "combined_translation": "3-3"
    },
    {
      "verse": 4,
      "sanskrit": "वैशम्पायन उवाच।\n              पुराणे नागराजोऽसौ पठ्यते धरणीधरः। शेषस्तेजोनिधिः श्रीमानकम्प्यः पुरुषोत्तमः॥४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 117,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "बलदेवमाहात्म्यम्-०६२",
      "combined_translation": "4-4"
    },
    {
      "verse": 5,
      "sanskrit": "योगाचार्यो महावीर्यो देवमन्त्रमुखो बली। जरासन्धं गदायुद्धे जितवान्यो न चावधीत्॥५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 117,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "बलदेवमाहात्म्यम्-०६२",
      "combined_translation": "5-5"
    },
    {
      "verse": 6,
      "sanskrit": "बहवश्चैव राजानः प्रथिताः पृथिवीतले। अन्वयुर्मागधं सर्वे ते चापि विजिता रणे॥६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 117,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "बलदेवमाहात्म्यम्-०६२",
      "combined_translation": "6-6"
    },
    {
      "verse": 7,
      "sanskrit": "नागायुतबलप्राणो भीमो भीमपराक्रमः। असकृद्बलदेवेन बाहुयुद्धे पराजितः॥७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 117,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "बलदेवमाहात्म्यम्-०६२",
      "combined_translation": "7-7"
    },
    {
      "verse": 8,
      "sanskrit": "दुर्योधनस्य कन्यां तु हरमाणो न्यगृह्यत। साम्बो जाम्बवतीपुत्रो नगरे नागसाह्वये॥८॥",
      "english": null,
      "bhavadeepa": "भीमो भीमसेनः॥७॥",
      "chapter": 117,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "बलदेवमाहात्म्यम्-०६२",
      "combined_translation": "8-8"
    },
    {
      "verse": 9,
      "sanskrit": "राजभिः सर्वतो रुद्धे हरमाणो बलात्किल। तदुपश्रुत्य संरुद्धमाजगाम महाबलः॥९॥",
      "english": null,
      "bhavadeepa": "न्यगृह्यत गृहीतः कौरवैरिति शेषः॥८॥",
      "chapter": 117,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "बलदेवमाहात्म्यम्-०६२",
      "combined_translation": "9-9"
    },
    {
      "verse": 10,
      "sanskrit": "रामस्तस्य तु मोक्षार्थमागतो नालभच्च तम्। ततश्चुक्रोध बलवानद्भुतं चाकरोन्महत्॥१०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 117,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "बलदेवमाहात्म्यम्-०६२",
      "combined_translation": "10-10"
    },
    {
      "verse": 11,
      "sanskrit": "अनिवार्यमभेद्यं च दिव्यमप्रतिमं बले। लाङ्गलास्त्रं समुद्यम्य ब्रह्ममन्त्राभिमन्त्रितम्॥११॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 117,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "बलदेवमाहात्म्यम्-०६२",
      "combined_translation": "11-11"
    },
    {
      "verse": 12,
      "sanskrit": "प्राकारवप्रे विन्यस्य पुरस्य च महाद्युतिः। प्रक्षेप्तुमैच्छद्गङ्गायां नगरं कौरवस्य तत्॥१२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 117,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "बलदेवमाहात्म्यम्-०६२",
      "combined_translation": "12-12"
    },
    {
      "verse": 13,
      "sanskrit": "तद्विघूर्णितमालक्ष्य पुरं दुर्योधनो नृपः। साम्बं निर्यातयामास सभार्यं तस्य धीमतः॥१३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 117,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "बलदेवमाहात्म्यम्-०६२",
      "combined_translation": "13-13"
    },
    {
      "verse": 14,
      "sanskrit": "ददौ शिश्यं तदात्मानं रामस्य सुमहात्मनः। गदायुद्धे कुरुपतिं शिष्यं जग्राह तं च सः॥१४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 117,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "बलदेवमाहात्म्यम्-०६२",
      "combined_translation": "14-14"
    },
    {
      "verse": 15,
      "sanskrit": "ततः प्रभृति राजेन्द्र पुरमेतद्विघूर्णितम्। आवर्जितमिवाभाति गङ्गामभिमुखं नृप॥१५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 117,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "बलदेवमाहात्म्यम्-०६२",
      "combined_translation": "15-15"
    },
    {
      "verse": 16,
      "sanskrit": "इदमत्यद्भुतं कर्म रामस्य कथितं भुवि। भाण्डीरे कथितं राजन्यत्कृतं शौरिणा पुरा॥१६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 117,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "बलदेवमाहात्म्यम्-०६२",
      "combined_translation": "16-16"
    },
    {
      "verse": 17,
      "sanskrit": "प्रलम्बं मुष्टिनैकेन यज्जघान हलायुधः। धेनुकं तु महावीर्यं चिक्षेप नगमूर्धनि। स गतायुः पपातोर्व्यां दैत्यो गर्दभरूपधृक्॥१७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 117,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "बलदेवमाहात्म्यम्-०६२",
      "combined_translation": "17-17"
    },
    {
      "verse": 18,
      "sanskrit": "लवणजलगमा महानदी द्रुतजलवेगतरङ्गमालिनी। नगरमभिमुखं यदा हृता हलविधृता यमुना यमस्वसा॥१८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 117,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "बलदेवमाहात्म्यम्-०६२",
      "combined_translation": "18-18"
    },
    {
      "verse": 19,
      "sanskrit": "बलदेवस्य माहात्म्यमेतत्ते कथितं मया। अनन्तस्याप्रमेयस्य शेषस्य धरणीभृतः॥१९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 117,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "बलदेवमाहात्म्यम्-०६२",
      "combined_translation": "19-19"
    },
    {
      "verse": 20,
      "sanskrit": "इति पुरुशवरस्य लाङ्गलेर्बहुविधमुत्तममन्यदेव च। यदकथितमिहाद्य कर्म ते तदुपलभस्व पुराणविस्तरात्॥२०॥",
