{
  "adhyaya_id": "P19_U02_A060",
  "book": 19,
  "parva_name": "हरिवंशः",
  "upaparva_name": "विष्णुपर्व",
  "adhyaya_name": "रुक्मिपराजयः-०६०",
  "chapter": 115,
  "verse_count": 45,
  "verses": [
    {
      "verse": 1,
      "sanskrit": "वैशम्पायन उवाच।\n              कृष्णेन ह्रियमाणां तां रुक्मी श्रुत्वा तु रुक्मिणीम्। प्रतिज्ञामकरोत्क्रुद्दः समक्षं भीष्मकस्य ह॥१॥",
      "english": null,
      "bhavadeepa": "जुगूह समावृणोत्॥८१॥",
      "chapter": 115,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "रुक्मिपराजयः-०६०",
      "combined_translation": "1-82"
    },
    {
      "verse": 2,
      "sanskrit": "[रुक्म्युवाच।]\n              अहत्वा युधि गोविन्दमनानीय च रुक्मिणीम्। कुण्डिनं न प्रवेक्ष्यामि सत्यमेतद्ब्रवीम्यहम्॥२॥",
      "english": null,
      "bhavadeepa": "अथ षष्टितमेऽध्याये रुक्मिणे श्रीहरिः स्वयम्। जित्वा मुक्त्वाऽथ वैदर्भीमुपयेम इतीर्यते॥१॥ कृष्णेनेति॥१॥",
      "chapter": 115,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "रुक्मिपराजयः-०६०",
      "combined_translation": "2-2"
    },
    {
      "verse": 3,
      "sanskrit": "आस्थाय स रथं वीरः समुदग्रायुधध्वजम्। जवेन प्रययौ क्रुद्धो बलेन महता वृतः॥३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 115,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "रुक्मिपराजयः-०६०",
      "combined_translation": "3-3"
    },
    {
      "verse": 4,
      "sanskrit": "तमन्वयुर्नृपाश्चैव दक्षिणापथवर्तिनः। क्राथोऽंशुमाञ्छ्रुतर्वा च वैणुदारिश्च वीर्यवान्॥४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 115,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "रुक्मिपराजयः-०६०",
      "combined_translation": "4-4"
    },
    {
      "verse": 5,
      "sanskrit": "भीष्मकस्य सुताश्चान्ये रथेन रथिनां वराः। क्रथकैशिकमुख्याश्च सर्व एव महारथाः॥५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 115,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "रुक्मिपराजयः-०६०",
      "combined_translation": "5-5"
    },
    {
      "verse": 6,
      "sanskrit": "ते गत्वा दूरमध्वानं सरितं नर्मदामनु। गोविन्दं ददृशुः क्रुद्धाः सहैव प्रियया स्थितम्॥६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 115,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "रुक्मिपराजयः-०६०",
      "combined_translation": "6-6"
    },
    {
      "verse": 7,
      "sanskrit": "अवस्थाप्य च तत्सैन्यं रुक्मी मदबलान्वितः। चिकीर्षुर्द्वैरथं युद्धमभ्ययान्मधुसूदनम्॥७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 115,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "रुक्मिपराजयः-०६०",
      "combined_translation": "7-7"
    },
    {
      "verse": 8,
      "sanskrit": "स विव्याध चतुःषष्ट्या गोविन्दं निशितैः शरैः। तं प्रत्यविध्यत्सप्तत्या बाणैर्युधि जनार्दनः॥८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 115,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "रुक्मिपराजयः-०६०",
      "combined_translation": "8-8"
    },
    {
      "verse": 9,
      "sanskrit": "पतमानस्य चिच्छेद ध्वजं चास्य महाबलः। जहार च शिरः कायात्सारथेस्तस्य वीर्यवान्॥९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 115,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "रुक्मिपराजयः-०६०",
      "combined_translation": "9-9"
    },
    {
      "verse": 10,
      "sanskrit": "तं कृच्छ्रगतमाज्ञाय परिवव्रुर्जनार्दनम्। दाक्षिणात्या जिघांसन्तो राजानः सर्व एव हि॥१०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 115,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "रुक्मिपराजयः-०६०",
      "combined_translation": "10-84"
    },
    {
      "verse": 11,
      "sanskrit": "तमंशुमान्महाबाहुर्विव्याध दशभिः शरैः। श्रुतर्वा पञ्चभिः क्रुद्धो वैणुदारिश्च सप्तभिः॥११॥",
      "english": null,
      "bhavadeepa": "तं रुक्मिणम्। जनार्दनं जिघांसन्तः॥१०॥",
      "chapter": 115,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "रुक्मिपराजयः-०६०",
      "combined_translation": "11-11"
    },
    {
      "verse": 12,
      "sanskrit": "ततोंऽशुमन्तं गोविन्दो बिभेदोरसि वीर्यवान्। निशसाद रथोपस्थे व्यथितः स नराधिपः॥१२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 115,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "रुक्मिपराजयः-०६०",
      "combined_translation": "12-12"
    },
    {
      "verse": 13,
      "sanskrit": "श्रुतर्वणो जघानाश्वांश्चतुर्भिश्चतुरः शरैः। वैणुदारोर्ध्वजं छित्त्वा भुजं विव्याध दक्षिणम्॥१३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 115,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "रुक्मिपराजयः-०६०",
      "combined_translation": "13-13"
    },
    {
      "verse": 14,
      "sanskrit": "तथैव च श्रुतर्वाणं शरैर्विव्याध पञ्चभिः। शिश्रिये स ध्वजं शान्तो न्यषीदच्च व्यथान्वितः॥१४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 115,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "रुक्मिपराजयः-०६०",
      "combined_translation": "14-14"
    },
    {
      "verse": 15,
      "sanskrit": "मुञ्चन्तः शरवर्षाणि वासुदेवं ततोऽभ्ययुः। क्रथकैशिकमुख्याश्च सर्व एव महारथाः॥१५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 115,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "रुक्मिपराजयः-०६०",
      "combined_translation": "15-15"
    },
    {
      "verse": 16,
      "sanskrit": "बाणैर्बाणांश्च चिच्छेद तेषां युधि जनार्दनः। जघान चैषां संरब्धः पतमानश्च ताञ्छरान्॥१६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 115,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "रुक्मिपराजयः-०६०",
      "combined_translation": "16-16"
    },
    {
      "verse": 17,
      "sanskrit": "पुनरान्यांश्चतुःषष्ट्या जघान निशितैः शरैः। क्रुद्धानापततो वीरानद्रिवत्स महाबलः॥१७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 115,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "रुक्मिपराजयः-०६०",
      "combined_translation": "17-17"
    },
    {
      "verse": 18,
      "sanskrit": "विद्रुतं स्वबलं दृष्ट्वा रुक्मी क्रोधवशङ्गतः। पञ्चभिर्निशितैर्बाणैर्विव्याधोरसि केशवम्॥१८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 115,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "रुक्मिपराजयः-०६०",
      "combined_translation": "18-18"
    },
    {
      "verse": 19,
      "sanskrit": "सारथिं चास्य विव्याध सायकैर्निशितैस्त्रिभिः। आजघान शरेणास्य ध्वजं च नतपर्वणा॥१९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 115,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "रुक्मिपराजयः-०६०",
      "combined_translation": "19-19"
    },
    {
      "verse": 20,
      "sanskrit": "केशवस्त्वरितं दृष्ट्वा क्रुद्धो विव्याध मार्गणैः। धनुश्चिच्छेद चाप्यस्य पतमानस्य रुक्मिणः॥२०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 115,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "रुक्मिपराजयः-०६०",
      "combined_translation": "20-20"
    },
    {
      "verse": 21,
      "sanskrit": "अथान्यद्धनुरादाय रुक्मी कृष्णजिघांसया। प्रादुश्चकार चान्यानि दिव्यान्यस्त्राणि वीर्यवान्॥२१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 115,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "रुक्मिपराजयः-०६०",
      "combined_translation": "21-21"
    },
    {
      "verse": 22,
      "sanskrit": "अस्त्रैरस्त्राणी संवार्य तस्य कृष्णो महाबलः। पुनश्चिच्छेद तच्चापं रथिनां च त्रिभिः शरैः॥२२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 115,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "रुक्मिपराजयः-०६०",
      "combined_translation": "22-22"
    },
    {
      "verse": 23,
      "sanskrit": "स च्छिन्नधन्वा विरथः खड्गमादाय चर्म च। उत्पपात रथाद्वीरो गरुत्मानिव वीर्यवान्॥२३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 115,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "रुक्मिपराजयः-०६०",
      "combined_translation": "23-90"
    },
    {
      "verse": 24,
      "sanskrit": "तस्याभिपततः खड्गं चिच्छेद युधि केशवः। नाराचैश्च त्रिभिः क्रुद्धो बिभेदैनमथोरसि॥२४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 115,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "रुक्मिपराजयः-०६०",
      "combined_translation": "24-24"
    },
    {
      "verse": 25,
      "sanskrit": "स पपात महाबाहुर्वसुधामनुनादयन्। विसंज्ञो मूर्च्छितो राजा वज्रेणेव महासुरः॥२५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 115,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "रुक्मिपराजयः-०६०",
      "combined_translation": "25-25"
    },
    {
      "verse": 26,
      "sanskrit": "तांश्च राज्ञः शरैः सर्वान्पुनर्विव्याध माधवः। रुक्मिणं पतितं दृष्ट्वा व्यद्रवन्त नराधिपाः॥२६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 115,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "रुक्मिपराजयः-०६०",
      "combined_translation": "26-26"
    },
    {
      "verse": 27,
      "sanskrit": "विचेष्टमानं तं भूमौ भ्रातरं वीक्ष्य रुक्मिणी। पादयोर्न्यपतद्विष्णोर्भ्रातुर्जीवितकाङ्क्षिणी॥२७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 115,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "रुक्मिपराजयः-०६०",
      "combined_translation": "27-27"
    },
    {
      "verse": 28,
      "sanskrit": "तामुत्थाप्य परिष्वज्य सान्त्वयामास केशवः। अभयं रुक्मिणे दत्त्वा प्रययौ स्वपुरीं ततः॥२८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 115,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "रुक्मिपराजयः-०६०",
      "combined_translation": "28-28"
    },
    {
      "verse": 29,
      "sanskrit": "वृष्णयोऽपि जरासन्धं भङ्क्त्वा तांश्चैव पार्थिवान्। प्रययुर्द्वारकां हृष्टाः पुरस्कृत्य हलायुधम्॥२९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 115,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "रुक्मिपराजयः-०६०",
      "combined_translation": "29-29"
    },
    {
      "verse": 30,
      "sanskrit": "प्रयाते पुण्डरीकाक्षे श्रुतर्वाभ्येत्य सङ्गरे। रुक्मिणं रथमारोप्य प्रययौ स्वां पुरीं प्रति ॥३०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 115,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "रुक्मिपराजयः-०६०",
      "combined_translation": "30-30"
    },
    {
      "verse": 31,
      "sanskrit": "अनानीय स्वसारं तु रुक्मी मानमदान्वितः। हीनप्रतिज्ञो नैच्छत्स प्रवेष्टुं कुण्डिनं पुरम्॥३१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 115,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "रुक्मिपराजयः-०६०",
      "combined_translation": "31-31"
    },
    {
      "verse": 32,
