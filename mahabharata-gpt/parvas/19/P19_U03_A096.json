  "verses": [
    {
      "verse": 1,
      "sanskrit": "वैशम्पायन उवाच।\n              ततः क्रुद्धो महाराज सात्यकिर्वृष्णिपुङ्गवः। उवाच वचनं राजन्वासुदेवं स्मरन्निव॥१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 279,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "सात्यकिपौण्ड्रकयोर्युद्धम्"
    },
    {
      "verse": 2,
      "sanskrit": "अवोचदीदृशं वाक्यं वासुदेवं नृपाधमः। को नाम जगतां नाथमित्थं ब्रूयाज्जिजीविषुः॥२॥",
      "english": null,
      "bhavadeepa": "तत इति॥१॥",
      "chapter": 279,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "सात्यकिपौण्ड्रकयोर्युद्धम्",
      "combined_translation": "2-2"
    },
    {
      "verse": 3,
      "sanskrit": "मृत्युस्त्वां सर्वथा याति वदन्तं तादृशं वचः। जिह्वा ते शतधा दीर्याद्वदतस्तादृशं वचः॥३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 279,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "सात्यकिपौण्ड्रकयोर्युद्धम्",
      "combined_translation": "3-3"
    },
    {
      "verse": 4,
      "sanskrit": "एष ते पातयिष्यामि शिरः कायाच्च पौण्ड्रक। यन्नाम वासुदेवेति तव सम्प्रति वर्तते॥४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 279,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "सात्यकिपौण्ड्रकयोर्युद्धम्",
      "combined_translation": "4-4"
    },
    {
      "verse": 5,
      "sanskrit": "यावत्पतति कायात्ते शिरस्तावत्प्रवर्तते। स एव श्वो न भगवान्वासुदेवो भविष्यति॥५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 279,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "सात्यकिपौण्ड्रकयोर्युद्धम्",
      "combined_translation": "5-5"
    },
    {
      "verse": 6,
      "sanskrit": "एक एव जगन्नाथः कर्ता सर्वस्य सर्वगः। दुरात्मन्सर्वथा देवो भविष्यति न संशयः॥६॥",
      "english": null,
      "bhavadeepa": "प्रवर्तते तव नामेति शेषः। स एव त्वं श्वो न भविष्यसि मरिष्यति॥५॥",
      "chapter": 279,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "सात्यकिपौण्ड्रकयोर्युद्धम्",
      "combined_translation": "6-6"
    },
    {
      "verse": 7,
      "sanskrit": "एष तेऽहं शिरः कायात्पातयिष्यामि राजक। यदसौ भगवान्विष्णुर्नागमिष्यति साम्प्रतम्॥७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 279,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "सात्यकिपौण्ड्रकयोर्युद्धम्",
      "combined_translation": "7-7"
    },
    {
      "verse": 8,
      "sanskrit": "अस्त्रवीर्यं बलं चैव सर्वं दर्शय साम्प्रतम्। नातः परतरं राजन्वीर्यं च तव वर्तते॥८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 279,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "सात्यकिपौण्ड्रकयोर्युद्धम्",
      "combined_translation": "8-8"
    },
    {
      "verse": 9,
      "sanskrit": "सर्वं दर्शय यत्नेन स्थितोऽस्मि व्यवसायवान्। शरी चापी गदी खड्घी सर्वथाहमुपस्थितः॥९॥",
      "english": null,
      "bhavadeepa": "राजन् करत्सितराजन्॥८॥",
      "chapter": 279,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "सात्यकिपौण्ड्रकयोर्युद्धम्",
      "combined_translation": "9-9"
    },
    {
      "verse": 10,
      "sanskrit": "नैतन्नगरमायासीः सत्यमेतद्ब्रवीम्यहम्। सर्वथा कृतकृत्योऽस्मि दृष्ट्वा त्वां वासुदेवकम्॥१०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 279,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "सात्यकिपौण्ड्रकयोर्युद्धम्",
      "combined_translation": "10-10"
    },
    {
      "verse": 11,
      "sanskrit": "तवाङ्गं तिलशः कृत्वा श्वभ्यो दास्यामि राजक। इत्युक्त्वा बाणमादाय वासुदेवं महाबलः॥११॥",
      "english": null,
      "bhavadeepa": "नायासीः नागतोऽभूः तर्हि नैतद्ब्रवीमि यदायातः आगतोऽसि अतः सत्यमेव मम वचनमित्यर्थघः॥१०॥",
      "chapter": 279,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "सात्यकिपौण्ड्रकयोर्युद्धम्",
      "combined_translation": "11-11"
    },
    {
      "verse": 12,
      "sanskrit": "आकर्णपूर्णमाकृष्य विव्याध निशितं शरम्। स तेन विद्धो यदुना वासुदेवः प्रतापवान्॥१२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 279,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "सात्यकिपौण्ड्रकयोर्युद्धम्",
      "combined_translation": "12-12"
    },
    {
      "verse": 13,
      "sanskrit": "वमञ्छोणितमत्युष्णमङ्गान्नेत्रान्नृपोत्तम। ततश्चुक्रोध नृपतिर्वासुदेवः प्रतापवान्॥१३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 279,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "सात्यकिपौण्ड्रकयोर्युद्धम्",
      "combined_translation": "13-13"
    },
    {
      "verse": 14,
      "sanskrit": "नवभिर्दशभिश्चैव शरैः सन्नतपर्वभिः। विव्याध सात्यकिं राजा नदंश्च बहुधा किल॥१४॥",
