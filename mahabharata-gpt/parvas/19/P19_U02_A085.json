    {
      "verse": 32,
      "sanskrit": "ते बाणास्तस्य गात्रेषु परिघे च जनाधिप। भग्नाः शिलाशिताः सर्वे निपेतुः कुञ्चिता क्षितौ॥३२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 140,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "निकुम्भप्रभृतीनां वधः-०८५"
    },
    {
      "verse": 33,
      "sanskrit": "विफलानस्त्रयुक्तांस्तान्दृष्ट्वा बाणान्धनञ्जयः। पप्रच्छ केशवं वीरः किमेतदिति भारत॥३३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 140,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "निकुम्भप्रभृतीनां वधः-०८५"
    },
    {
      "verse": 34,
      "sanskrit": "पर्वतानपि भिन्दन्ति मम वज्रोपमाः शराः। किमिदं देवकीपुत्र विस्मयोऽत्र महान्मम॥३४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 140,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "निकुम्भप्रभृतीनां वधः-०८५"
    },
    {
      "verse": 35,
      "sanskrit": "तमुवाच ततः कृष्णः प्रहसन्निव भारत। महद्भूतं निकुम्भोऽयं कौन्तेय शृणु विस्तरात्॥३५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 140,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "निकुम्भप्रभृतीनां वधः-०८५"
    },
    {
      "verse": 36,
      "sanskrit": "पुरा गत्वोत्तरकुरूंस्तपश्चक्रे महासुरः। शतं वर्षसहस्राणां देवशत्रुर्दुरासदः॥३६॥",
      "english": null,
      "bhavadeepa": "महद्भूतं लोकोत्तरविक्रमः॥३५॥",
      "chapter": 140,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "निकुम्भप्रभृतीनां वधः-०८५"
    },
    {
      "verse": 37,
      "sanskrit": "अथैनं छन्दयामास वरेण भगवान्हरः। स वव्रे त्रीणि रूपाणि न वध्यानि सुरासुरैः॥३७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 140,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "निकुम्भप्रभृतीनां वधः-०८५"
    },
    {
      "verse": 38,
      "sanskrit": "तमुवाच महादेवो भगवान्वृषभध्वजः। मम वा ब्राह्मणानां वा विष्णोर्वा प्रियमाचरन्॥३८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 140,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "निकुम्भप्रभृतीनां वधः-०८५"
    },
    {
      "verse": 39,
      "sanskrit": "भविष्यसि हरेर्वध्यो न त्वन्यस्य महासुर। ब्रह्मण्योऽहं च विष्णुश्च विप्राणां परमा गतिः॥३९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 140,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "निकुम्भप्रभृतीनां वधः-०८५"
    },
    {
      "verse": 40,
      "sanskrit": "स एव सर्वशस्त्राणामवध्यः पाण्डुनन्दन। त्रिदेहोऽतिप्रमाथी च वरमत्तश्च दानवः॥४०॥",
      "english": null,
      "bhavadeepa": "ब्रह्मण्यः ब्राह्मणकुलहितः गतिराश्रयः॥३९॥",
      "chapter": 140,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "निकुम्भप्रभृतीनां वधः-०८५"
    },
    {
      "verse": 41,
      "sanskrit": "भानुमत्यापहरणे देहोऽस्यैको हतो मया। अवध्यं षट्पुरं देहमिदमस्य दुरात्मनः॥४१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 140,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "निकुम्भप्रभृतीनां वधः-०८५"
    },
    {
      "verse": 42,
      "sanskrit": "दितिं शुश्रूषति त्वेको देहोऽस्य तपसान्वितः। अन्यस्तु देहो घोरोऽस्य येनावसति षट्पुरम्॥४२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 140,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "निकुम्भप्रभृतीनां वधः-०८५"
    },
    {
      "verse": 43,
      "sanskrit": "एतत्तु सर्वमाख्यातं निकुम्भचरितं मया। त्वरयास्य वधे वीर कथा पश्चाद्भविष्यति॥४३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 140,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "निकुम्भप्रभृतीनां वधः-०८५"
    },
    {
      "verse": 44,
      "sanskrit": "तयोः कथयतोरेवं कृष्णयोरसुरस्तदा। गुहां षट्पुरसंज्ञां तां विवेश रणदुर्जयः॥४४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 140,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "निकुम्भप्रभृतीनां वधः-०८५"
    },
    {
      "verse": 45,
      "sanskrit": "अन्विष्य तस्य भगवान्विवेश मधुसूदनः। तां षट्पुरगुहां घोरां दुर्धर्षां कुरुनन्दन॥४५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 140,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "निकुम्भप्रभृतीनां वधः-०८५"
    },
    {
      "verse": 46,
      "sanskrit": "चन्द्रसूर्यप्रभाहीनां ज्वलन्तीं स्वेन तेजसा। सुखदुःखोष्णशीतानि प्रयच्छन्तीं यथेप्सितम्॥४६॥",
      "english": null,
      "bhavadeepa": "अन्विष्य तद्गमनमार्गमिति शेषः॥४५॥",
      "chapter": 140,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "निकुम्भप्रभृतीनां वधः-०८५"
    },
    {
      "verse": 47,
      "sanskrit": "तत्र प्रविश्य भगवानपश्यत जनाधिपान्। युयुधे सह घोरेण निकुम्भेन जनाधिप॥४७॥",
      "english": null,
      "bhavadeepa": "सुखदुःखेति। स्वीयानां सुखं परेषां दुःखमिति वक्तव्यम्॥४६॥",
      "chapter": 140,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "निकुम्भप्रभृतीनां वधः-०८५"
    },
    {
      "verse": 48,
      "sanskrit": "कृष्णस्यानुप्रविष्टास्तु बलाद्या यादवास्तदा। प्रविष्टाश्च तथा सर्वे पाण्दवास्ते महात्मनः॥४८॥",
      "english": null,
      "bhavadeepa": "जनाधिपान् निकुम्भनिगृहीतान् यदून्॥४७॥",
      "chapter": 140,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "निकुम्भप्रभृतीनां वधः-०८५"
    },
    {
      "verse": 49,
      "sanskrit": "समेतास्तु प्रविष्टास्ते कृष्णस्यानुमतेन वै। युयुधे स तु कृष्णेन रौक्मिणेयः प्रचोदितः। अनयद्यादवान्सर्वान्यानयं बद्धवान्पुरा॥४९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 140,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "निकुम्भप्रभृतीनां वधः-०८५"
    },
    {
      "verse": 50,
      "sanskrit": "ते मुक्ता रौक्मिणेयेन प्राप्ता यत्र जनार्दनः। प्रहृष्टमनसः सर्वे निकुम्भवधकाङ्क्षिणः॥५०॥",
      "english": null,
      "bhavadeepa": "कृष्णेनेति। तत्र तेनायमर्थः। स निकुम्भः कृष्णेन सह युयुधे रौक्मिणेयस्तु कृष्णेनैव प्रचोदितः मनसा प्रेरितो यादवाननयदित्युत्तरेण सम्बन्धः॥४९॥",
      "chapter": 140,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "निकुम्भप्रभृतीनां वधः-०८५"
    },
    {
      "verse": 51,
      "sanskrit": "राजानो वीर मुञ्चेति पुनः कामं यथाब्रुवन्। मुमोच चाथ तान्वीरो रौक्मिणेयः प्रतापवान्॥५१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 140,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "निकुम्भप्रभृतीनां वधः-०८५"
    },
    {
      "verse": 52,
      "sanskrit": "अधोमुखमुखाः सर्वे बद्धमौना नराधिपाः। लज्जयाभिप्लुता विरास्तस्थुर्नष्टश्रियस्तत्दा॥५२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 140,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "निकुम्भप्रभृतीनां वधः-०८५"
    },
    {
      "verse": 53,
      "sanskrit": "निकुम्भमपि गोविन्दः प्रयतन्तं जयं प्रति। योधयामास भगवान्घोरमात्मरिपुं हरिः॥५३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 140,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "निकुम्भप्रभृतीनां वधः-०८५"
    },
    {
      "verse": 54,
      "sanskrit": "परिघेणाहतः कृष्णो निकुम्भेन भृशं विभो। गदया चापि कृष्णेन निकुम्भस्ताडितो भृशम्॥५४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 140,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "निकुम्भप्रभृतीनां वधः-०८५"
    },
    {
      "verse": 55,
      "sanskrit": "तावुभौ प्रोहमापन्नौ सुप्रहारहतौ तदा। ततः प्रव्यथितान्दृष्ट्वा पाण्डवांश्चाथ यादवान्॥५५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 140,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "निकुम्भप्रभृतीनां वधः-०८५"
    },
    {
      "verse": 56,
      "sanskrit": "जेपुर्मुनिगणास्तत्र कृष्णस्य हितकाम्यया। तुष्टुवुश्च महात्मानं वेदप्रोक्तैस्तथा स्तवैः॥५६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 140,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "निकुम्भप्रभृतीनां वधः-०८५"
    },
    {
      "verse": 57,
      "sanskrit": "ततः प्रत्यागतप्राणो भगवान्केशवस्तदा। दानवश्च पुनर्वीरावुद्यतौ समरं प्रति॥५७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 140,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "निकुम्भप्रभृतीनां वधः-०८५"
    },
    {
      "verse": 58,
      "sanskrit": "वृषभाविव नर्दन्तौ गजाविव च भारत। शालावृकाविव क्रुद्धौ प्रहरन्तौ रणोत्कटौ॥५८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 140,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "निकुम्भप्रभृतीनां वधः-०८५"
    },
    {
      "verse": 59,
      "sanskrit": "अथ कृष्णं तदोवाच नृपं वागशरीरिणी। चक्रेण शमयस्वैनं देवब्राह्मणकण्टकम्॥५९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 140,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "निकुम्भप्रभृतीनां वधः-०८५"
    },
    {
      "verse": 60,
      "sanskrit": "इति होवाच भगवान्देवो बिल्वोदकेश्वरः। धर्मं यशश्च विपुलं प्राप्नुहि त्वं महाबल॥६०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 140,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "निकुम्भप्रभृतीनां वधः-०८५"
    },
    {
      "verse": 61,
      "sanskrit": "तथेत्युक्त्वा नमस्कृत्वा लोकनाथः सतां गतिः। सुदर्शनं मुमोचाथ चक्रं दैत्यकुलान्तकम्॥६१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 140,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "निकुम्भप्रभृतीनां वधः-०८५"
    },
    {
      "verse": 62,
      "sanskrit": "तन्निकुम्भस्य चिच्छेद शिरः प्रवरकुण्डलम्। नारायणभुजोत्सृष्टं सूर्यमण्डलवर्चसम्॥६२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 140,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "निकुम्भप्रभृतीनां वधः-०८५"
    },
    {
      "verse": 63,
      "sanskrit": "उत्पपात शिरस्तस्य भूमौ ज्वलितकुण्डलम्। मेघमत्तो गिरेः शृङ्गान्मयूर इव भूतले॥६३॥",
      "english": null,
      "bhavadeepa": "सूर्यमण्डलवर्चसमिति सुदर्शनविशेषणत्वात्पुंस्त्वम्॥६२॥",
      "chapter": 140,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
