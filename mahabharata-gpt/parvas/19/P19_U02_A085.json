  "verse_count": 79,
  "verses": [
    {
      "verse": 1,
      "sanskrit": "वैशम्पायन उवाच।\n              रुद्धेषु भूमिपालेषु सानुगेषु विशाम्पते। आविवेशासुरांश्चाथ कश्मलं जनमेजय॥१॥",
      "english": null,
      "bhavadeepa": "निहिता निधानवद्रक्षिता॥६८॥",
      "chapter": 140,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "निकुम्भप्रभृतीनां वधः-०८५"
    },
    {
      "verse": 2,
      "sanskrit": "दिशः प्रतस्थुस्ते वीरा वध्यमानाः समन्ततः। कृष्णानन्तप्रभृतिभिर्यदुभिर्युद्धदुर्मदैः॥२॥",
      "english": null,
      "bhavadeepa": "पञ्चाधिकेऽशीतितमेऽध्यायेऽमुष्मिन्नथ स्फुट। निकुम्भप्रमुखानां च यदुभिर्वध उच्यते॥१॥ रुद्धेष्विति॥१॥",
      "chapter": 140,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "निकुम्भप्रभृतीनां वधः-०८५",
      "combined_translation": "2-2"
    },
    {
      "verse": 3,
      "sanskrit": "निकुम्भस्तानथोवाच रुषितो दानवोत्तमः। भित्त्वा प्रतिज्ञां किं मोहाद्भयार्ता यात विह्वलाः॥३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 140,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "निकुम्भप्रभृतीनां वधः-०८५",
      "combined_translation": "3-3"
    },
    {
      "verse": 4,
      "sanskrit": "हीनप्रतिज्ञाः काँल्लोकान्प्रयास्यत पलायिताः। अगत्वापचितिं युद्धे ज्ञातीनां कृतनिश्चयाः॥४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 140,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "निकुम्भप्रभृतीनां वधः-०८५",
      "combined_translation": "4-4"
    },
    {
      "verse": 5,
      "sanskrit": "फलं जित्वेह भोक्तव्यं रिपून्समरकर्कशान्। हतेन चापि शूरेण वस्तव्यं त्रिदिवे सुखम्॥५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 140,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "निकुम्भप्रभृतीनां वधः-०८५",
      "combined_translation": "5-5"
    },
    {
      "verse": 6,
      "sanskrit": "पलायित्वा गृहं गत्वा कस्य द्रक्ष्यथ हे मुखम्। दारान्वक्ष्यथ किं चापि धिग्धिक्किं किं न लज्जथ॥६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 140,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "निकुम्भप्रभृतीनां वधः-०८५",
      "combined_translation": "6-6"
    },
    {
      "verse": 7,
      "sanskrit": "एवमुक्ता निवृत्तास्ते लज्जमाना नृपासुराः। द्विगुणेन च वेगेन युयुधुर्यदुभिः सह॥७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 140,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "निकुम्भप्रभृतीनां वधः-०८५",
      "combined_translation": "7-7"
    },
    {
      "verse": 8,
      "sanskrit": "उत्सवे युद्धशौण्डानां नानाप्रहरणैर्नृप। ये यान्ति यज्ञवाटं तं तान्निहन्ति धनञ्जयः॥८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 140,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "निकुम्भप्रभृतीनां वधः-०८५",
      "combined_translation": "8-8"
    },
    {
      "verse": 9,
      "sanskrit": "यमौ भीमश्च राजा च धर्मपुत्रो युधिष्ठिरः। द्यां प्रयाताञ्जघानैन्द्रिः प्रवरश्च द्विजोत्तमः॥९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 140,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "निकुम्भप्रभृतीनां वधः-०८५",
      "combined_translation": "9-9"
    },
    {
      "verse": 10,
      "sanskrit": "अथासुरासृक्तोयाढ्या केशशैवलशाड्वला। चक्रकूर्मरथावर्ता गजशैलानुशोभिनी॥१०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 140,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "निकुम्भप्रभृतीनां वधः-०८५",
      "combined_translation": "10-10"
    },
    {
      "verse": 11,
      "sanskrit": "ध्वजकुन्ततरुच्छन्ना स्तनितोत्क्रुष्टनादिनी। गोविन्दशैलप्रभवा भीरुचित्तप्रमाथिनी॥११॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 140,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "निकुम्भप्रभृतीनां वधः-०८५",
      "combined_translation": "11-11"
    },
    {
      "verse": 12,
      "sanskrit": "असृग्बुद्बुदफेनाढ्या असिमत्स्यतरङ्गिणी। सुस्राव शोणितनदी नदीव जलदागमे॥१२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 140,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "निकुम्भप्रभृतीनां वधः-०८५",
      "combined_translation": "12-12"
    },
    {
      "verse": 13,
      "sanskrit": "तान्दृष्ट्वैव निकुम्भस्तु वर्द्धमानंश्च शात्रवान्। हतान्सर्वान्सहायांश्च वीर्यादेवोत्पपात ह॥१३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 140,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "निकुम्भप्रभृतीनां वधः-०८५",
      "combined_translation": "13-13"
    },
    {
      "verse": 14,
      "sanskrit": "स वारितो जयन्तेन प्रवरेण च भारत। शरैः कुलिशसङ्काशैर्निकुम्भो रणकर्कशः॥१४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 140,
      "parva_name": "हरिवंशः",
