      "combined_translation": "14-14"
    },
    {
      "verse": 15,
      "sanskrit": "सन्निवृत्याथ दष्टोष्ठः परिघेण दुरासदः। प्रवरं ताडयामास स पपात महीतले॥१५॥",
      "english": null,
      "bhavadeepa": null,
