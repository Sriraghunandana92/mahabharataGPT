      "combined_translation": "19-19"
    },
    {
      "verse": 20,
      "sanskrit": "विव्याध गरुडं वज्री दिव्यैः शरवरैस्तथा। बाणांश्चिच्छेद सहसा केशवस्य तरस्विनः॥२०॥",
      "english": null,
