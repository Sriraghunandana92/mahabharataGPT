      "combined_translation": "13-13"
    },
    {
      "verse": 14,
      "sanskrit": "अथैरावतमारुह्य निर्ययौ पाकशासनः। जयन्तेन रथस्थेन पृष्ठतोऽनुगतः प्रभुः॥१४॥",
      "english": null,
      "bhavadeepa": "ह्रियति ह्रियते॥१३॥",
      "chapter": 128,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "इन्द्रकृष्णयोर्युद्धं विष्णोरुत्कर्षश्च-०७३",
      "combined_translation": "14-14"
    },
    {
      "verse": 15,
      "sanskrit": "पूर्वमभ्यागतं द्वारं केशवं शत्रुनाशनम्। दृष्ट्वोवाच प्रवृत्तं भोः किमिदं मधुसूदन॥१५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 128,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
