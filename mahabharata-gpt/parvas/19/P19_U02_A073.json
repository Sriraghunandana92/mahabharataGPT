      "combined_translation": "21-21"
    },
    {
      "verse": 22,
      "sanskrit": "महेन्द्रस्य च शब्देन धनुषः कुरुनन्दन। शार्ङ्गस्य च निनादेन मुमुहुः स्वर्गवासिनः॥२२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 128,
