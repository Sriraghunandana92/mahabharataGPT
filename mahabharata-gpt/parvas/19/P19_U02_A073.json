      "adhyaya_name": "इन्द्रकृष्णयोर्युद्धं विष्णोरुत्कर्षश्च-०७३"
    },
    {
      "verse": 56,
      "sanskrit": "एवमुक्तो जयन्तश्च मुमोचास्त्रं महाबलः। तपसोपचितं तेन स्वयमेवातितेजसा॥५६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 128,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "इन्द्रकृष्णयोर्युद्धं विष्णोरुत्कर्षश्च-०७३"
    },
    {
      "verse": 57,
      "sanskrit": "तत्प्रद्युम्नो महादेवं शरजालैरवारयत्। चत्वार्यस्त्राणि दिव्यानि मुमुचे चापराणि सः॥५७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 128,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "इन्द्रकृष्णयोर्युद्धं विष्णोरुत्कर्षश्च-०७३"
    },
    {
      "verse": 58,
      "sanskrit": "दिक्षु सर्वासु रुरुधूस्तान्यस्त्राण्यथ भारत। रौक्मिणेयं महात्मानमन्तरिक्षे च पञ्चमम्॥५८॥",
      "english": null,
      "bhavadeepa": "स जयन्तः। अपराणि ततोऽप्यधिकानि॥५७॥",
      "chapter": 128,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "इन्द्रकृष्णयोर्युद्धं विष्णोरुत्कर्षश्च-०७३"
    },
    {
      "verse": 59,
      "sanskrit": "महोल्कासदृशान्बाणानस्त्राण्यमरसत्तमः। मुमोच यानि घोराणि प्रद्युम्नं प्रति सर्वतः॥५९॥",
      "english": null,
      "bhavadeepa": "पञ्चमं पश्चात्प्रयुक्तम्॥५८॥",
      "chapter": 128,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "इन्द्रकृष्णयोर्युद्धं विष्णोरुत्कर्षश्च-०७३"
    },
    {
      "verse": 60,
      "sanskrit": "तानि सर्वाणि बाणौघैः कार्ष्णिरस्त्राण्यवारयत्। जयन्तं चापरैर्बाणैर्विव्याध निशितैस्तदा॥६०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 128,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "इन्द्रकृष्णयोर्युद्धं विष्णोरुत्कर्षश्च-०७३"
    },
    {
      "verse": 61,
      "sanskrit": "ततो नादः समुत्सृष्टो ह्यमरैः पुण्यकर्मभिः। दृष्ट्वा स्थैर्यं च शैघ्र्यं च प्रद्युम्नस्य महात्मनः॥६१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 128,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "इन्द्रकृष्णयोर्युद्धं विष्णोरुत्कर्षश्च-०७३"
    },
    {
      "verse": 62,
      "sanskrit": "प्रवरस्यापि बाणेन शितेन शिनिपुङ्गवः। चिच्छेदेष्वासनं वीरो हस्तावापं च भारत॥६२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 128,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "इन्द्रकृष्णयोर्युद्धं विष्णोरुत्कर्षश्च-०७३"
    },
    {
      "verse": 63,
      "sanskrit": "ततोऽन्यत्स तु जग्राह महत्तद्धनुरुत्तमम्। महेन्द्रदत्तं प्रवरो महाशनिसमस्वनम्॥६३॥",
      "english": null,
      "bhavadeepa": "हस्तावापं हस्तत्राणं च॥६२॥",
      "chapter": 128,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "इन्द्रकृष्णयोर्युद्धं विष्णोरुत्कर्षश्च-०७३"
    },
    {
      "verse": 64,
      "sanskrit": "स तेन वीरो महता धनुषा विप्रसत्तमः। शरान्मुमोच विविधानर्करश्मिनिभांस्तदा॥६४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 128,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "इन्द्रकृष्णयोर्युद्धं विष्णोरुत्कर्षश्च-०७३"
    },
    {
      "verse": 65,
      "sanskrit": "चकर्त च धनुश्चित्रं शैनेयस्यामितौजसः। विव्याध सर्वगात्रेषु बाणैरपि स सात्यकिम्॥६५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 128,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "इन्द्रकृष्णयोर्युद्धं विष्णोरुत्कर्षश्च-०७३"
    },
    {
      "verse": 66,
      "sanskrit": "धनुरादाय शैनेयस्ततोऽन्यत्कुरुनन्दन। दृढं भारसहं धीमान्विव्याध प्रवरं रणे॥६६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 128,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "इन्द्रकृष्णयोर्युद्धं विष्णोरुत्कर्षश्च-०७३"
    },
    {
      "verse": 67,
      "sanskrit": "उच्चकर्ततुरन्योन्यवर्मणी तौ शितैः शरैः। गात्रेभ्यश्चैव मांसानि मर्मभिद्भिः शरोद्यमैः॥६७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 128,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "इन्द्रकृष्णयोर्युद्धं विष्णोरुत्कर्षश्च-०७३"
    },
    {
      "verse": 68,
      "sanskrit": "अथाष्टधारबाणेन पुनरिष्वासनं द्विधा। चिच्छेद प्रवरो वीरस्त्रिभिश्चैनमताडयत्॥६८॥",
      "english": null,
      "bhavadeepa": "मांसान्युच्चकर्ततुः॥६७॥",
      "chapter": 128,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "इन्द्रकृष्णयोर्युद्धं विष्णोरुत्कर्षश्च-०७३"
    },
    {
      "verse": 69,
      "sanskrit": "अन्यदिष्वासनं तं तु ग्रहितुमनसं द्विजः। गदया ताडयामास क्षेप्यया लघुहस्तवान्॥६९॥",
      "english": null,
      "bhavadeepa": "अथाष्टधारेत्यत्रास्त्रवरबाणेनेति पाठेऽस्त्रादपि वरो यो बाणस्तेन॥६८॥",
      "chapter": 128,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "इन्द्रकृष्णयोर्युद्धं विष्णोरुत्कर्षश्च-०७३"
    },
    {
      "verse": 70,
      "sanskrit": "सोऽसिं चर्म च जग्राह सात्यकिः प्रहसन्निव। न जग्राह धनुर्धीमान्गदयाभिहतो भृशम्। ततः शरशतान्येव मुमोच प्रवरस्तदा॥७०॥",
      "english": null,
      "bhavadeepa": "तं सात्यकिम्॥६९॥",
      "chapter": 128,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "इन्द्रकृष्णयोर्युद्धं विष्णोरुत्कर्षश्च-०७३"
    },
    {
      "verse": 71,
      "sanskrit": "विहस्तमिव विज्ञाय सात्यकिं यदुनन्दनम्। प्रद्युम्नोऽस्य ददौ खड्गं निर्मलाकाशसन्निभम्॥७१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 128,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "इन्द्रकृष्णयोर्युद्धं विष्णोरुत्कर्षश्च-०७३"
    },
    {
      "verse": 72,
      "sanskrit": "तस्य चिच्छेद भल्लेन निस्त्रिंशं प्रवरस्ततदा। त्सरुदेशेऽपातयच्च प्रवरः प्रहसन्निव॥७२॥",
      "english": null,
      "bhavadeepa": "विहस्तमिवेति विकलहस्तमिव॥७१॥",
      "chapter": 128,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "इन्द्रकृष्णयोर्युद्धं विष्णोरुत्कर्षश्च-०७३"
    },
    {
      "verse": 73,
      "sanskrit": "व्यधमच्च तथा चर्म शितैर्बाणैरजिह्मगैः। आजघान च शक्त्यैनं हृदि विप्रो ननाद च॥७३॥",
      "english": null,
      "bhavadeepa": "त्सरुदेशे मुष्टिदेशे शरशते नाशिते खड्गे रिक्तहस्तमित्यर्थः॥७२॥",
      "chapter": 128,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "इन्द्रकृष्णयोर्युद्धं विष्णोरुत्कर्षश्च-०७३"
    },
    {
      "verse": 74,
      "sanskrit": "तं विक्लवमिव ज्ञात्वा पारिजातजिहीर्षया। तार्क्ष्याभ्याशे रथेनैव स तस्थौ प्रवरस्तदा॥७४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 128,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "इन्द्रकृष्णयोर्युद्धं विष्णोरुत्कर्षश्च-०७३"
    },
    {
      "verse": 75,
      "sanskrit": "तं पक्षपुटवेगेन चिक्षेप गरुडस्तथा। गव्यूतिमेकां सरथः स पपात मुमोह च॥७५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 128,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "इन्द्रकृष्णयोर्युद्धं विष्णोरुत्कर्षश्च-०७३"
    },
    {
      "verse": 76,
      "sanskrit": "तं जयन्तो निपत्याथ पतितं ब्राह्मणं नृप। समाश्वास्य रथं शीघ्रं समारोपितवांस्तदा॥७६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 128,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "इन्द्रकृष्णयोर्युद्धं विष्णोरुत्कर्षश्च-०७३"
    },
    {
      "verse": 77,
      "sanskrit": "शैनेयमपि मुह्यन्तं पतन्तं च मुहुर्मुहुः। आश्वासयानः प्रद्युम्नः पितृव्यं परिषस्वजे॥७७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 128,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "इन्द्रकृष्णयोर्युद्धं विष्णोरुत्कर्षश्च-०७३"
    },
    {
      "verse": 78,
      "sanskrit": "तं हि पस्पर्श हस्तेन सव्येन मधुसूदनः। विरुजः स्पर्शमात्रेण सात्यकिः समपद्यत॥७८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 128,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "इन्द्रकृष्णयोर्युद्धं विष्णोरुत्कर्षश्च-०७३"
    },
    {
      "verse": 79,
      "sanskrit": "प्रद्युम्नो दक्षिणे पार्श्वे वामे तु शिनिपुङ्गवः। तस्थतुः पारिजातस्य युद्धशौण्डतरावुभौ॥७९॥",
      "english": null,
      "bhavadeepa": "विरुजः पीडाहीनः॥७८॥",
      "chapter": 128,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "इन्द्रकृष्णयोर्युद्धं विष्णोरुत्कर्षश्च-०७३"
    },
    {
      "verse": 80,
      "sanskrit": "जयन्तः प्रवर्श्चैव रथेनैकेन भारत। सम्पतन्तौ महेन्द्रेण प्रहस्योक्तौ महात्मना॥८०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 128,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "इन्द्रकृष्णयोर्युद्धं विष्णोरुत्कर्षश्च-०७३"
    },
    {
      "verse": 81,
      "sanskrit": "नासन्नमभिगन्तव्यं गरुडस्य कथञ्चन। बलवानेष पततां राजा च विनतासुतः॥८१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 128,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "इन्द्रकृष्णयोर्युद्धं विष्णोरुत्कर्षश्च-०७३"
    },
    {
      "verse": 82,
      "sanskrit": "दक्षिणे चैव सव्ये च पार्श्वे मम धृतायुधौ। उभौ स्थितौ युद्ध्यमानं मामेव हि प्रपश्यतम्॥८२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 128,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "इन्द्रकृष्णयोर्युद्धं विष्णोरुत्कर्षश्च-०७३"
    },
    {
      "verse": 83,
      "sanskrit": "एवमुक्तौ स्थितौ वीरौ ततः शक्रस्य पार्श्वयोः। ददृशाते युध्यमानौ देवराजजनार्दनौ॥८३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 128,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "इन्द्रकृष्णयोर्युद्धं विष्णोरुत्कर्षश्च-०७३"
    },
    {
      "verse": 84,
      "sanskrit": "अथेन्द्रो गरुडं बाणैर्महाशनिसमस्वनैः। विव्याध सर्वगात्रेषु महास्त्रप्रवरैस्तथा॥८४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 128,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "इन्द्रकृष्णयोर्युद्धं विष्णोरुत्कर्षश्च-०७३"
    },
    {
