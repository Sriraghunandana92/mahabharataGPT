      "combined_translation": "18-18"
    },
    {
      "verse": 19,
      "sanskrit": "ततः कृष्णः शरैस्तीक्ष्णैर्देवराजगजोत्तमम्। बिभेदाशनिसङ्काशैः प्रहसन्निव भारत॥१९॥",
      "english": null,
