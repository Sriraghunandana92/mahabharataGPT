      "combined_translation": "20-20"
    },
    {
      "verse": 21,
      "sanskrit": "यान्यान्मुमोच देवेन्द्रस्तांस्तांश्चिच्छेद माधवः। माधवेन प्रयुक्तांश्च चिच्छेद बलवृत्रहा॥२१॥",
      "english": null,
