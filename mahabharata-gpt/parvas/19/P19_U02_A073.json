  "adhyaya_name": "इन्द्रकृष्णयोर्युद्धं विष्णोरुत्कर्षश्च-०७३",
  "chapter": 128,
  "verse_count": 105,
  "verses": [
    {
      "verse": 1,
      "sanskrit": "वैशम्पायन उवाच।\n              अथ विष्णुर्महातेजा मुहूर्ताभ्युदिते  रवौ। मृगयाव्यपदेशेन ययौ रैवतकं गिरिम्॥१॥",
      "english": null,
      "bhavadeepa": "कमलभवात्मजस्य मरीचेः सूनुः सुमनौकसं सुमनसां देवानाम् ओकांसि यत्र तं देवलोकम्। सन्धिर्षः॥६६॥",
      "chapter": 128,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "इन्द्रकृष्णयोर्युद्धं विष्णोरुत्कर्षश्च-०७३",
      "combined_translation": "1-67"
    },
    {
      "verse": 2,
      "sanskrit": "आरोप्यैकरथे देवः सात्यकिं नरपुङ्गवम्। प्रद्युम्नमनुगच्छेति प्रोक्त्वा कुरुकुलोद्वह॥२॥",
      "english": null,
      "bhavadeepa": "अथ त्रिसप्ततितमेऽध्यायेऽस्मिन्निन्द्रकृष्णयोः। युद्धं तु वर्ण्यते तत्र विष्णोरुत्कर्ष उच्यते॥१॥ अथ विष्णुः मृगयाव्यपदेशेन मृगयाच्छलेन॥१॥",
      "chapter": 128,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "इन्द्रकृष्णयोर्युद्धं विष्णोरुत्कर्षश्च-०७३",
      "combined_translation": "2-2"
    },
    {
      "verse": 3,
      "sanskrit": "रैवतं च गिरिं देवो गत्वा दारुकमब्रवीत्। मदीयं रथमेनं त्वं ग्रहायेहैव दारुक॥३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 128,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "इन्द्रकृष्णयोर्युद्धं विष्णोरुत्कर्षश्च-०७३",
      "combined_translation": "3-3"
    },
    {
      "verse": 4,
      "sanskrit": "प्रतिपालय मां सौम्य दिनार्द्धं वारयन्हरीन्। रथेनैव प्रवेष्टाहं द्वारकां सूतसत्तम॥४॥",
      "english": null,
      "bhavadeepa": "ग्रहाय गृहीत्वा॥३॥",
      "chapter": 128,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "इन्द्रकृष्णयोर्युद्धं विष्णोरुत्कर्षश्च-०७३",
      "combined_translation": "4-4"
    },
    {
      "verse": 5,
      "sanskrit": "इति सन्दिश्य भगवानारुरोह जयोद्यतः। तार्क्ष्यं ससात्यको धीमानप्रमेयपराक्रमः॥५॥",
      "english": null,
      "bhavadeepa": "प्रतिपालय प्रतीक्षस्व। हरीन् अश्वान् प्रवेक्ष्यामि॥४॥",
      "chapter": 128,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "इन्द्रकृष्णयोर्युद्धं विष्णोरुत्कर्षश्च-०७३",
      "combined_translation": "5-5"
    },
    {
      "verse": 6,
      "sanskrit": "पृथग्रथेन कौरव्य प्रद्युम्नः शत्रुसूदनः। आकाशगामिना राजन्पृष्ठतः कृष्णमन्वयात्॥६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 128,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "इन्द्रकृष्णयोर्युद्धं विष्णोरुत्कर्षश्च-०७३",
      "combined_translation": "6-6"
    },
    {
      "verse": 7,
      "sanskrit": "निमेषान्तरमात्रेण नन्दनं काननं हरिः। देवोद्यानं ययौ धीमान्पारिजातजिहीर्षया॥७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 128,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "इन्द्रकृष्णयोर्युद्धं विष्णोरुत्कर्षश्च-०७३",
      "combined_translation": "7-7"
    },
    {
      "verse": 8,
      "sanskrit": "ददर्श तत्र भगवान्देवयोधान्दुरासदान्। नानायुधधरान्वीरान्नन्दनस्थानधोक्षजः॥८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 128,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "इन्द्रकृष्णयोर्युद्धं विष्णोरुत्कर्षश्च-०७३",
      "combined_translation": "8-8"
    },
    {
      "verse": 9,
      "sanskrit": "तेषां सम्पश्यतामेव पारिजातं महाबलः। उत्पाट्यारोपयामास पारिजातं सतां गतिः॥९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 128,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "इन्द्रकृष्णयोर्युद्धं विष्णोरुत्कर्षश्च-०७३",
      "combined_translation": "9-9"
    },
    {
      "verse": 10,
      "sanskrit": "गरुडं पक्षिराजानमयत्नेनैव भारत। उपस्थितो विग्रहवान्पारिजातः स केशवम्॥१०॥",
      "english": null,
      "bhavadeepa": "पारिजातं सम्पश्यतां पश्यतस्ताननादृत्येत्यर्थः। पारिजातम् आरोपयामासेति पृथगन्वयान्न पौनरुक्त्यम्॥९॥",
      "chapter": 128,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "इन्द्रकृष्णयोर्युद्धं विष्णोरुत्कर्षश्च-०७३",
      "combined_translation": "10-10"
    },
    {
      "verse": 11,
      "sanskrit": "सान्त्वितो वासुदेवेन पारिजातश्च भारत। उक्तश्च वृक्ष मा भैस्त्वं केशवेन महात्मना॥११॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 128,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "इन्द्रकृष्णयोर्युद्धं विष्णोरुत्कर्षश्च-०७३",
      "combined_translation": "11-11"
    },
    {
      "verse": 12,
      "sanskrit": "तं प्रस्थितं तरुं दृष्ट्वा पारिजातमधोक्षजः। अमरावतीं पुरीं श्रेष्ठां ततश्चक्रे प्रदक्षिणाम्॥१२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 128,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "इन्द्रकृष्णयोर्युद्धं विष्णोरुत्कर्षश्च-०७३",
      "combined_translation": "12-12"
    },
    {
      "verse": 13,
      "sanskrit": "ते तु नन्दनगोप्तारः पारिजातो द्रुमोत्तमः। ह्रियतीति महेन्द्राय गत्वा नृप शशंसिरे॥१३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 128,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
