  "adhyaya_name": "श्रीशिवकृता विष्णुस्तुतिः",
  "chapter": 271,
  "verse_count": 67,
  "verses": [
    {
      "verse": 1,
      "sanskrit": "वैशम्पायन उवाच।\n              ततो वृषध्वजो देवः शूली साक्षादुमापतिः। करं करेण संस्पृश्य विष्णोश्चक्रधरस्य ह॥१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 271,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीशिवकृता विष्णुस्तुतिः",
      "combined_translation": "1-39"
    },
    {
      "verse": 2,
      "sanskrit": "प्रोवाच भगवान्रुद्रः केशवं गरुडध्वजम्। शृण्वतां सर्वदेवानां मुनीनां भावितात्मनाम्॥२॥",
      "english": null,
      "bhavadeepa": "तत इति॥१॥",
      "chapter": 271,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीशिवकृता विष्णुस्तुतिः",
      "combined_translation": "2-2"
    },
    {
      "verse": 3,
      "sanskrit": "किमिदं देवदेवेश चक्रपाणे जनार्दन। तपश्चर्या किमर्थं ते प्रार्थना तव का विभो॥३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 271,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीशिवकृता विष्णुस्तुतिः",
      "combined_translation": "3-3"
    },
    {
      "verse": 4,
      "sanskrit": "स्वयं विष्णुर्भवान्नित्यस्तपस्त्वं तपसां हरे। पुत्रार्थं यदि ते देव तपश्चर्या जनार्दन॥४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 271,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीशिवकृता विष्णुस्तुतिः",
      "combined_translation": "4-4"
    },
    {
      "verse": 5,
      "sanskrit": "पुत्रो दत्तो मया देव पूर्वमेव जगत्पते। शृणु तत्रापि भगवन्कारणं कारणात्मक॥५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 271,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीशिवकृता विष्णुस्तुतिः",
      "combined_translation": "5-5"
    },
    {
      "verse": 6,
      "sanskrit": "तपश्चर्तुं प्रवृत्तोऽहं कुतश्चित्कारणाद्धरे। वर्षायुतं महाघोरं पुरा कृतयुगे तदा॥६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 271,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीशिवकृता विष्णुस्तुतिः",
      "combined_translation": "6-6"
    },
    {
      "verse": 7,
      "sanskrit": "भवानी तत्र मे देव परिचर्तुं तदाभवत्। पित्रा नियुक्ता देवेश उमैषा वरवर्णिनी॥७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 271,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीशिवकृता विष्णुस्तुतिः",
      "combined_translation": "7-7"
    },
    {
      "verse": 8,
      "sanskrit": "भीत इन्द्रस्तदा देव मारं मां प्रैषयत्तदा। मधुना सह संयुक्ते मारो मामागतस्तदा॥८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 271,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीशिवकृता विष्णुस्तुतिः",
      "combined_translation": "8-8"
    },
    {
      "verse": 9,
      "sanskrit": "लक्ष्यं मामकरोत्तत्र बाणस्य प्रेषितस्य ह। एषा मां सेवते तत्र दानात्पुष्पादिनां हरे॥९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 271,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीशिवकृता विष्णुस्तुतिः",
      "combined_translation": "9-9"
    },
    {
      "verse": 10,
      "sanskrit": "ततः क्रुद्धोऽहमभवं दृष्ट्वा मारं तथाविधम्। क्रुद्ध्यतो मम देवेश नेत्रादग्निः पपात ह॥१०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 271,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीशिवकृता विष्णुस्तुतिः",
      "combined_translation": "10-10"
    },
    {
      "verse": 11,
      "sanskrit": "सोऽयमग्निस्तदा मारं भस्मसात्कृतवान्हरे। अचिन्तयं तदा विष्णो शक्रस्यैतच्चिकीर्षितम्॥११॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 271,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीशिवकृता विष्णुस्तुतिः",
      "combined_translation": "11-11"
    },
    {
      "verse": 12,
      "sanskrit": "ततः प्रभृति देवेश दया तं प्रति वर्तते। ब्रह्मणा च नियुक्तोऽस्मि प्रीतस्तत्र जनार्दन॥१२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 271,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीशिवकृता विष्णुस्तुतिः",
      "combined_translation": "12-12"
    },
    {
      "verse": 13,
      "sanskrit": "नियुक्तः पुत्ररूपेण स ते देव जगत्पते। ज्येष्ठस्तव सुतो देव प्रद्युम्नेत्यभिविश्रुतः॥१३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 271,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीशिवकृता विष्णुस्तुतिः",
      "combined_translation": "13-13"
    },
    {
      "verse": 14,
      "sanskrit": "स्मरं तं विद्धि देवेश नात्र कार्या विचारणा। इत्युक्त्वा पुनराहेदं याथात्म्यं दर्शयन्निव॥१४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 271,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीशिवकृता विष्णुस्तुतिः",
      "combined_translation": "14-14"
    },
    {
      "verse": 15,
      "sanskrit": "मुनीनां श्रोतुकामानां यथात्म्यं तत्र सत्तमः। अञ्जलिं सम्पुटं कृत्वा विष्णुमुद्दिश्य शङ्करः॥१५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 271,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीशिवकृता विष्णुस्तुतिः",
      "combined_translation": "15-15"
    },
    {
      "verse": 16,
      "sanskrit": "उमया सार्धमीशानो यथात्म्यं वक्तुमैहत। हरे कुर्वति तत्रैवमञ्जलिं कुरुसत्तम॥१६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 271,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीशिवकृता विष्णुस्तुतिः",
      "combined_translation": "16-16"
    },
    {
      "verse": 17,
      "sanskrit": "मुनयो देवगन्धर्वाः सिद्धाश्च सहकिन्नराः। अञ्जलिं चक्रिरे विष्णोर्देवदेवेश्वरे हरौ॥१७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 271,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीशिवकृता विष्णुस्तुतिः",
      "combined_translation": "17-17"
    },
    {
      "verse": 18,
      "sanskrit": "महेश्वर उवाच।\n              यत्तत्कारणमाहुस्तत्साङ्ख्याः प्रकृतिसंज्ञकम्। ततो महान्समुत्पन्नः प्रकृतिर्यस्य कारणम्॥१८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 271,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीशिवकृता विष्णुस्तुतिः",
      "combined_translation": "18-18"
    },
    {
      "verse": 19,
      "sanskrit": "त्रिधा भूतं जगद्योनिं प्रधानं कारणात्मकम्। सत्त्वं रजस्तमो विष्णो जगदण्डं जनार्दनः॥१९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 271,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीशिवकृता विष्णुस्तुतिः",
      "combined_translation": "19-19"
    },
    {
      "verse": 20,
      "sanskrit": "तस्य कारणमाहुस्त्वं साङ्ख्यप्रकृतिसंज्ञकम्। तद्रूपेण भवान्विष्णो परिणम्याधितिष्ठति॥२०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 271,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीशिवकृता विष्णुस्तुतिः",
      "combined_translation": "20-20"
    },
    {
      "verse": 21,
      "sanskrit": "तस्मात्तु महतो घोरादहङ्कारो महानभूत्। स त्वमादौ जगन्नाथ परिणामस्तथा हि सः॥२१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 271,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीशिवकृता विष्णुस्तुतिः",
      "combined_translation": "21-21"
    },
    {
      "verse": 22,
      "sanskrit": "अहङ्कारात्प्रभो देव कारणानि महान्ति च। तन्मात्राणि तथा पञ्च भूतानि प्रभवन्त्युत॥२२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 271,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीशिवकृता विष्णुस्तुतिः",
      "combined_translation": "22-22"
    },
    {
      "verse": 23,
      "sanskrit": "तानि त्वामाहुरीशानं भूतानीह जगत्पते। पृथिवी वायुराकाशमापो ज्योतिश्च पञ्चमम्॥२३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 271,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीशिवकृता विष्णुस्तुतिः",
      "combined_translation": "23-23"
    },
    {
      "verse": 24,
      "sanskrit": "चक्षुर्घ्राणं तथा स्पर्शो रसनं श्रोत्रमेव च। मनः षष्ठं तथा देव प्रेरकं तत्र तत्र ह॥२४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 271,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीशिवकृता विष्णुस्तुतिः",
      "combined_translation": "24-24"
    },
    {
      "verse": 25,
      "sanskrit": "कर्मेन्द्रियाणि चान्यानि वागादीनि जनार्दन। त्वमेव तानि सर्वाणि करोषि नियतात्मवान्॥२५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 271,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीशिवकृता विष्णुस्तुतिः",
      "combined_translation": "25-25"
    },
    {
      "verse": 26,
      "sanskrit": "स्वेषु स्वेषु जगन्नाथ विषयेषु तथा हरे। निवेशयसि देवेश योग्यामिन्द्रियपद्धतिम्॥२६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 271,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीशिवकृता विष्णुस्तुतिः",
      "combined_translation": "26-26"
    },
    {
      "verse": 27,
      "sanskrit": "यदा त्वं रजसा युक्तस्तदा भूतानि सृष्टवान्। यदा च सत्त्वयुक्तोऽसि तदा पाता जगत्त्रयम्॥२७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 271,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीशिवकृता विष्णुस्तुतिः",
      "combined_translation": "27-27"
    },
    {
      "verse": 28,
      "sanskrit": "यदा त्वं तमसाऽऽकृष्टस्तदा संहरसे जगत्। त्रिभिरेव गुणैर्युक्तः सृष्टिरक्षाविनाशने॥२८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 271,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीशिवकृता विष्णुस्तुतिः",
      "combined_translation": "28-28"
    },
    {
      "verse": 29,
      "sanskrit": "वर्तसे त्रिविधां भूतिमादाय निततात्मवान्। इन्द्रियाणीन्द्रियार्थेषु नियोजयसि माधव॥२९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 271,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीशिवकृता विष्णुस्तुतिः",
      "combined_translation": "29-29"
    },
    {
      "verse": 30,
      "sanskrit": "प्राणिनामुपभोगार्थमन्तः स्थित्वा जगद्गुरो। तस्मात्सर्वत्र भूतेषु वर्तते सर्वभोगवान्॥३०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 271,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीशिवकृता विष्णुस्तुतिः",
      "combined_translation": "30-30"
    },
    {
      "verse": 31,
      "sanskrit": "ब्रह्मा त्वं सृष्टिकाले तु स्थितौ विष्णुरसि प्रभो। संहारे रुद्रनामासि त्रिधामा त्वमसि प्रभो॥३१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 271,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीशिवकृता विष्णुस्तुतिः",
      "combined_translation": "31-31"
    },
    {
      "verse": 32,
      "sanskrit": "भूमिरापोऽनलो वायुः खं मनो बुद्धिरेव च। एताः प्रकृतयो देव भिन्नाः सर्वत्र ते हरे॥३२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 271,
