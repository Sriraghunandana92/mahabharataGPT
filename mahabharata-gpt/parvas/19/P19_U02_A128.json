  "adhyaya_name": "उषया सहानिरुद्धस्य विवाहः उशाहरणसमाप्तिश्च-१२८",
  "chapter": 183,
  "verse_count": 41,
  "verses": [
    {
      "verse": 1,
      "sanskrit": "वैशम्पायन उवाच।\n              अथाहुको महाबाहुः कृष्णं प्राह महाद्युतिः। हर्षादुत्फुल्लनयनः श्रूयतां यदुनन्दन॥१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 183,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "उषया सहानिरुद्धस्य विवाहः उशाहरणसमाप्तिश्च-१२८"
    },
    {
      "verse": 2,
      "sanskrit": "एवं गतेऽनिरुद्धस्य क्रियतां महदुत्सवः। क्षेमात्प्रत्यागतं दृष्ट्वा सेव्यमानाः सहासते॥२॥",
      "english": null,
      "bhavadeepa": "अथाहुक इति॥१॥",
      "chapter": 183,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "उषया सहानिरुद्धस्य विवाहः उशाहरणसमाप्तिश्च-१२८",
      "combined_translation": "2-2"
    },
    {
      "verse": 3,
      "sanskrit": "उषापि च महाभागा सखीभिः परिवारिता। रमते परया प्रीत्या चानिरुद्धेन सङ्गता॥३॥",
      "english": null,
      "bhavadeepa": "यतोऽस्मदीयाः सर्वे सेव्यमानाः अप्सरः प्रभृतिभिः सह आसतेऽतोऽनिरुद्धस्य महदुत्सवः। क्रियतामिति योज्यम्॥२॥",
      "chapter": 183,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "उषया सहानिरुद्धस्य विवाहः उशाहरणसमाप्तिश्च-१२८",
      "combined_translation": "3-3"
    },
    {
      "verse": 4,
      "sanskrit": "कुम्भाण्डदुहिता रामा उषायाः सखिमण्डले। प्रवेश्यतां महाभागा वैदर्भीं वर्धयत्युत॥४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 183,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "उषया सहानिरुद्धस्य विवाहः उशाहरणसमाप्तिश्च-१२८",
      "combined_translation": "4-4"
    },
    {
      "verse": 5,
      "sanskrit": "साम्बाय दीयतां रामा कुम्भाण्डदुहिता शुभा। शेषाश्च कन्या न्यस्यन्तां कुमाराणां यथाक्रमम्॥५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 183,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "उषया सहानिरुद्धस्य विवाहः उशाहरणसमाप्तिश्च-१२८",
      "combined_translation": "5-5"
    },
    {
      "verse": 6,
      "sanskrit": "वर्तते सोत्सवस्तत्र अनिरुद्धस्य वेश्मनि। गृहे श्रीधन्वनश्चैव शुभस्तत्र प्रवर्तते॥६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 183,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "उषया सहानिरुद्धस्य विवाहः उशाहरणसमाप्तिश्च-१२८",
      "combined_translation": "6-6"
    },
    {
      "verse": 7,
      "sanskrit": "वादयन्ति पुरे तत्र नार्यो मदवशं गताः। नृत्यन्ते चाप्सरास्तत्र गायन्ति च तथापराः॥७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 183,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "उषया सहानिरुद्धस्य विवाहः उशाहरणसमाप्तिश्च-१२८",
      "combined_translation": "7-7"
    },
    {
      "verse": 8,
      "sanskrit": "काश्चित्प्रमुदितास्तत्र काश्चिदन्योन्यमब्रुवन्। नानावर्णाम्बरधराः क्रीडमानास्ततस्ततः॥८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 183,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "उषया सहानिरुद्धस्य विवाहः उशाहरणसमाप्तिश्च-१२८",
      "combined_translation": "8-8"
    },
    {
      "verse": 9,
      "sanskrit": "अभियान्ति ततोऽन्योन्यं काश्चिन्मदवशात्स्वयम्। क्रीडन्ति काश्चिदक्षैस्तु हर्षादुत्फुल्ललोचनाः॥९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 183,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "उषया सहानिरुद्धस्य विवाहः उशाहरणसमाप्तिश्च-१२८",
      "combined_translation": "9-9"
    },
    {
      "verse": 10,
      "sanskrit": "मायूरं रथमारुह्य सखीभिः परिवारिता। उषा सम्प्रेषिता देव्या रुद्राण्या प्रतिगृह्यताम्॥१०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 183,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "उषया सहानिरुद्धस्य विवाहः उशाहरणसमाप्तिश्च-१२८",
      "combined_translation": "10-10"
    },
    {
      "verse": 11,
      "sanskrit": "इयं चैव कुलश्लाघ्या नाम्नोषा सुन्दरी वरा। बाणपुत्री तव वधूः प्रतिगृह्णीष्व भामिनीम्॥११॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 183,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "उषया सहानिरुद्धस्य विवाहः उशाहरणसमाप्तिश्च-१२८",
      "combined_translation": "11-11"
    },
    {
      "verse": 12,
      "sanskrit": "ततः प्रतिगृहीता सा स्त्रीभिराचारमङ्गलैः। प्रवेशिता च सा वेश्म अनिरुद्धस्य शोभना॥१२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 183,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "उषया सहानिरुद्धस्य विवाहः उशाहरणसमाप्तिश्च-१२८",
      "combined_translation": "12-12"
    },
    {
      "verse": 13,
      "sanskrit": "देवकी रोहिणी चैव रुक्मिण्यथ विदर्भजा। दृष्ट्वानिरुद्धं रोदन्त्यः स्नेहहर्षसमन्विताः॥१३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 183,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "उषया सहानिरुद्धस्य विवाहः उशाहरणसमाप्तिश्च-१२८",
      "combined_translation": "13-13"
    },
    {
      "verse": 14,
      "sanskrit": "रेवती रुक्मिणी चैव गृहमुख्यं प्रवेशयत्। वधूर्वर्धसि दिष्ट्या त्वमनिरुद्धस्य दर्शनात्॥१४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 183,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "उषया सहानिरुद्धस्य विवाहः उशाहरणसमाप्तिश्च-१२८",
      "english_ref": 1,
      "combined_translation": "1-14"
    },
    {
      "verse": 15,
      "sanskrit": "ततस्तूर्यप्रणादैस्ता वरनार्यः शुभाननाः। क्रियामारेभिरे कर्तुमुषा च गृहसंस्थिता॥१५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 183,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "उषया सहानिरुद्धस्य विवाहः उशाहरणसमाप्तिश्च-१२८"
    },
    {
      "verse": 16,
      "sanskrit": "ततो हर्म्यतलस्था सा वृष्णिपुङ्गवसंस्थिता। रमते सर्वसदृशैरुपभोगैर्वरानना॥१६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 183,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "उषया सहानिरुद्धस्य विवाहः उशाहरणसमाप्तिश्च-१२८"
    },
    {
      "verse": 17,
      "sanskrit": "चित्रलेखा च सुश्रोणी अप्सरारूपधारिणी। आपृच्छ्य च सखीवर्गमुषां च त्रिदिवं गता॥१७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 183,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "उषया सहानिरुद्धस्य विवाहः उशाहरणसमाप्तिश्च-१२८"
    },
    {
      "verse": 18,
      "sanskrit": "गतासु तासु सर्वासु सखीष्वसुरसुन्दरी। मायावत्या गृहं नीता प्रथमं सा निमन्त्रिता॥१८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 183,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "उषया सहानिरुद्धस्य विवाहः उशाहरणसमाप्तिश्च-१२८"
    },
    {
      "verse": 19,
      "sanskrit": "सा तु प्रद्युम्नगृहिणी स्नुषां दृष्ट्वा सुमध्यमा। वासोभिरन्नपानैश्च पूजयामास सुन्दरीम्॥१९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 183,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "उषया सहानिरुद्धस्य विवाहः उशाहरणसमाप्तिश्च-१२८"
    },
    {
      "verse": 20,
      "sanskrit": "ततः क्रमेण सर्वास्ता वधूमूषां यदुस्त्रियः। आचारमनुपश्यन्त्यः स्वधर्ममुपचक्रिरे॥२०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 183,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "उषया सहानिरुद्धस्य विवाहः उशाहरणसमाप्तिश्च-१२८"
    },
    {
      "verse": 21,
      "sanskrit": "वैशम्पायन उवाच।\n              एतत्ते सर्वमाख्यातं मया कुरुकुलोद्वह। यथा बाणो जितः सङ्ख्ये जीवन्मुक्तश्च विष्णुना॥२१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 183,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "उषया सहानिरुद्धस्य विवाहः उशाहरणसमाप्तिश्च-१२८"
    },
    {
      "verse": 22,
      "sanskrit": "द्वारकायां ततः कृष्णो रेमे यदुगणैर्वृतः। अन्वशासन्महीं कृत्स्नां परया संयुतो मुदा॥२२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 183,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "उषया सहानिरुद्धस्य विवाहः उशाहरणसमाप्तिश्च-१२८"
    },
    {
      "verse": 23,
      "sanskrit": "एवमेषोऽवतीर्णो वै पृथिवीं पृथिवीपते। विष्णुर्यदुकुलश्रेष्ठो वासुदेवेति विश्रुतः॥२३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 183,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "उषया सहानिरुद्धस्य विवाहः उशाहरणसमाप्तिश्च-१२८"
    },
    {
      "verse": 24,
      "sanskrit": "एतैश्च कारणैः श्रीमान्वसुदेवकुले प्रभुः। जातो वृष्णिषु देवक्यां यन्मां त्वं परिपृच्छसि॥२४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 183,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "उषया सहानिरुद्धस्य विवाहः उशाहरणसमाप्तिश्च-१२८"
    },
    {
      "verse": 25,
      "sanskrit": "निवृत्ते नारदप्रश्ने यन्मयोक्तं समासतः। श्रुतास्ते विस्तराः सर्वे ये पूर्वं जनमेजय॥२५॥",
      "english": null,
      "bhavadeepa": "शकटभङ्गादिवरुणजयान्तैः॥२४॥",
      "chapter": 183,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "उषया सहानिरुद्धस्य विवाहः उशाहरणसमाप्तिश्च-१२८"
    },
    {
      "verse": 26,
      "sanskrit": "विष्णोस्तु माथुरे कल्पे यत्र ते संशयो महान्। वासुदेवगतिश्चैव सा मया समुदाहृता॥२६॥",
      "english": null,
      "bhavadeepa": "निवृत्ते दत्तोत्तरत्वेन समाहिते नारदप्रश्ने आश्चर्यं को धन्य इत्येवंरूपे पूर्वमुक्ते इति शेष॥२५॥",
      "chapter": 183,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "उषया सहानिरुद्धस्य विवाहः उशाहरणसमाप्तिश्च-१२८"
    },
    {
      "verse": 27,
      "sanskrit": "आश्चर्यं चैव नान्यद्वै कृष्णश्चाश्चर्यसन्निधिः। सर्वेष्वाश्चर्यकल्पेषु नास्त्याश्चर्यमवैष्णवम्॥२७॥",
      "english": null,
      "bhavadeepa": "माथुरे कल्पे यदुषु भवतोऽवतारे रुद्रजयेन निर्णीत इत्यर्थः। वासुदेवात्मिका गतिः परायणं वासुदेवगतिः सा प्रसिद्धा। “तद्विष्णोः परमं पदं, सा काष्ठा सा परा गतिः।” इत्याद्यागमेषु इत्यर्थः॥२६॥",
      "chapter": 183,
      "parva_name": "हरिवंशः",
      "upaparva_name": "विष्णुपर्व",
      "adhyaya_name": "उषया सहानिरुद्धस्य विवाहः उशाहरणसमाप्तिश्च-१२८"
    },
    {
      "verse": 28,
      "sanskrit": "एष धन्यो हि धन्यानां धन्यकृद्धन्यभावनः। देवेषु तु सदैत्येषु नास्ति धन्यतरोऽच्युतात्॥२८॥",
      "english": null,
