{
  "adhyaya_id": "P19_U03_A085",
  "book": 19,
  "parva_name": "हरिवंशः",
  "upaparva_name": "भविष्यपर्व",
  "adhyaya_name": "श्रीकृष्णसमीपे इन्द्रादिदेवानामागमनम्",
  "chapter": 268,
  "verse_count": 22,
  "verses": [
    {
      "verse": 1,
      "sanskrit": "वैशम्पायन उवाच।\n              तत इन्द्रः स्वयं तत्र आरुह्य गजमुत्तमम्। द्रष्टुं सर्वेश्वरं विष्णुं तपस्यन्तं समाययौ॥१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 268,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णसमीपे इन्द्रादिदेवानामागमनम्",
      "combined_translation": "1-29"
    },
    {
      "verse": 2,
      "sanskrit": "ततो यमस्तु भगवानारुह्य महिषं वरम्। किङ्करैश्च स्वयं साक्षादाययौ नगमुत्तमम्॥२॥",
      "english": null,
      "bhavadeepa": "तत इति॥१॥",
      "chapter": 268,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णसमीपे इन्द्रादिदेवानामागमनम्",
      "combined_translation": "2-2"
    },
    {
      "verse": 3,
      "sanskrit": "प्रचेता हंसमारुह्य वारुणैश्च समन्वितः। श्वेतच्छत्रसमायुक्तः श्वेतव्यजनवीजितः॥३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 268,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णसमीपे इन्द्रादिदेवानामागमनम्",
      "combined_translation": "3-3"
    },
    {
      "verse": 4,
      "sanskrit": "ययौ कैलासशिखरं द्रष्टुं केशवमञ्जसा। अन्ये चापि तथा देवा आदित्या वसवस्तथा॥४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 268,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णसमीपे इन्द्रादिदेवानामागमनम्",
      "combined_translation": "4-4"
    },
    {
      "verse": 5,
      "sanskrit": "रुद्राश्चैव तथा रजन्द्रष्टुं केशवमाययुः। सिद्धाश्च मुनयश्चैव गन्धर्वा यक्षकिन्नराः॥५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 268,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णसमीपे इन्द्रादिदेवानामागमनम्",
      "combined_translation": "5-5"
    },
    {
      "verse": 6,
      "sanskrit": "सर्वाश्चाप्सरसो राजन्नृत्यगीतविशारदाः। ततो देवगणाः सर्वे कैलासं समपद्यत॥६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 268,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णसमीपे इन्द्रादिदेवानामागमनम्",
      "combined_translation": "6-6"
    },
    {
      "verse": 7,
      "sanskrit": "पर्वतो नारदश्चैव तथान्ये मुनिसत्तमाः। विस्मयस्थितलोलाक्षाः सर्वदेवगणास्तथा॥७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 268,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णसमीपे इन्द्रादिदेवानामागमनम्",
      "combined_translation": "7-7"
    },
    {
      "verse": 8,
      "sanskrit": "आश्चर्यं खलु पश्यध्वं न भूतं न भविष्यति। योगिध्येयः स्वयं कृष्णो यत्तप्यति गुरुःस्वयम्। को न्वत्र समयो भूयादिति ते मेनिरे गणाः॥८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 268,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णसमीपे इन्द्रादिदेवानामागमनम्",
      "combined_translation": "8-8"
    },
    {
      "verse": 9,
      "sanskrit": "ततः समाप्ते सकले जगत्पतेर्व्रते समूले सकलेश्वरः शिवः। द्रष्टुं हरिं लोकहितैषिणं प्रभुं ययौ भवान्या सह भूतसङ्घैः॥९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 268,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णसमीपे इन्द्रादिदेवानामागमनम्",
      "combined_translation": "9-9"
    },
    {
      "verse": 10,
      "sanskrit": "सार्धं कुबेरेण सगुह्यकेन सख्या प्रियेण प्रभुरीश्वरः शिवः। स्वयं जटी भूतपिशाचसंवृताः शरी च खड्गी शशिखण्डशेखरः॥१०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 268,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णसमीपे इन्द्रादिदेवानामागमनम्",
      "combined_translation": "10-10"
    },
    {
      "verse": 11,
      "sanskrit": "करेण बिभ्रत्सह धर्भकुण्डिकां करेण साक्षादपरेण दीपिकाम्। अन्येन बिभ्रन्महतीं स डिण्डिमां शूलं च बिभ्रन्नपरेण बाहुना॥११॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 268,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णसमीपे इन्द्रादिदेवानामागमनम्",
      "combined_translation": "11-11"
    },
    {
      "verse": 12,
      "sanskrit": "गुणान्स रुद्राक्षकृतान्समुद्वहञ्जटाभिरापिङ्गलताम्रमूर्तिः। विराजमानः प्रभुरिन्दुशेखरो वृषेण युक्तः स सितेन शङ्करः॥१२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 268,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णसमीपे इन्द्रादिदेवानामागमनम्",
      "combined_translation": "12-12"
    },
    {
      "verse": 13,
      "sanskrit": "उमास्तनद्वन्द्वसमर्पिताननस्तथा समाश्लिष्य निपीडिताधरः। गङ्गाम्भुविक्षालितचन्द्रशेखरस्तां चापि वीक्षन्बहुशस्तदा शिवः॥१३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 268,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णसमीपे इन्द्रादिदेवानामागमनम्",
      "combined_translation": "13-13"
    },
    {
      "verse": 14,
      "sanskrit": "भस्माङ्गरागैरनुलेपिताननो महोरगैर्बद्धजटः सनातनः। शिरःकपालैः परिशोभितस्तदा द्रष्टुं हरिं केशवमभ्ययाच्छिवः॥१४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 268,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णसमीपे इन्द्रादिदेवानामागमनम्",
      "combined_translation": "14-14"
    },
    {
      "verse": 15,
      "sanskrit": "यमाहुरग्र्यं पुरुषं महान्तं पुरातनं साङ्ख्यनिबद्धदृष्टयः। यस्यापि देवस्य गुणान्समग्रांस्तत्त्वांश्चतुर्विंशतिमाहुरेके॥१५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 268,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णसमीपे इन्द्रादिदेवानामागमनम्",
      "combined_translation": "15-15"
    },
    {
      "verse": 16,
      "sanskrit": "यमाहुरेकं पुरुषं पुरातनं कणादनामानमजं महेश्वरम्। दक्षस्य यज्ञं विनिहत्य यो वै विनाश्य देवानसुरान्सनातनः॥१६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 268,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णसमीपे इन्द्रादिदेवानामागमनम्",
      "combined_translation": "16-16"
    },
    {
      "verse": 17,
      "sanskrit": "यं विधुर्भूततत्त्वज्ञं भूतेशं भूतभावनम्। वामदेवं विरूपाक्षमाहुस्तत्त्वविदो जनः॥१७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 268,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णसमीपे इन्द्रादिदेवानामागमनम्",
      "combined_translation": "17-17"
    },
    {
      "verse": 18,
      "sanskrit": "महादेवं सहस्राक्षं कालमूर्तिं चतुर्भुजम्। रुद्रं रोदननामानमाहुर्विश्वेश्वरं शिवम्॥१८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 268,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णसमीपे इन्द्रादिदेवानामागमनम्",
      "combined_translation": "18-18"
    },
    {
      "verse": 19,
      "sanskrit": "अप्रमेयमनाधारमाहुर्माहश्वरा जनाः। नग्नं नग्नपरीतं तु नागिनं त्वग्निवर्चसम्॥१९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 268,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णसमीपे इन्द्रादिदेवानामागमनम्",
      "combined_translation": "19-19"
    },
    {
      "verse": 20,
      "sanskrit": "आहुर्विश्वेश्वरं शान्तं शिवमादिं सनातनम्। तस्य मूर्तिरिमाः सर्वा धराद्याः सकला नृप॥२०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 268,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णसमीपे इन्द्रादिदेवानामागमनम्",
      "combined_translation": "20-20"
    },
    {
      "verse": 21,
      "sanskrit": "भूमिरापोऽनलो वायुः खं सूर्यश्च तथा शशी। अग्निश्च यजमानश्च प्रकृतिश्चैवमष्टधा॥२१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 268,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "श्रीकृष्णसमीपे इन्द्रादिदेवानामागमनम्",
      "combined_translation": "21-21"
    },
    {
      "verse": 22,
      "sanskrit": "महादेवो महायोगी गिरीशो नीललोहितः। आदिकर्ता महाभर्ता शूलपाणिरुमापतिः। द्रष्टुं विश्वेश्वरं विष्णुं भूतसङ्घैः समाययौ॥२२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 268,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
