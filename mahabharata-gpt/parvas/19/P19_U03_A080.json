{
  "adhyaya_id": "P19_U03_A080",
  "book": 19,
  "parva_name": "हरिवंशः",
  "upaparva_name": "भविष्यपर्व",
  "adhyaya_name": "घण्टाकर्णकृता विष्णुस्तवप्रार्थना तस्य समाधिलाभश्च",
  "chapter": 263,
  "verse_count": 89,
  "verses": [
    {
      "verse": 1,
      "sanskrit": "वैशम्पायन उवाच।\n              ततः स भगवान्विष्णुः पिशाचौ मांसभक्षकौ। ददर्शाथ महाघोरौ दीपिकाधारिणौ हरिः॥१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 263,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "घण्टाकर्णकृता विष्णुस्तवप्रार्थना तस्य समाधिलाभश्च",
      "combined_translation": "1-30"
    },
    {
      "verse": 2,
      "sanskrit": "विलोकयाञ्चक्रतुस्तौ पिशाचौ देवकीसुतम्। स्थितं सुखासने विष्णुं दृष्ट्वा लोकेश्वरेश्वरम्॥२॥",
      "english": null,
      "bhavadeepa": "तत इति। दीपिकाधरिणौ तदानीं रात्रे सत्वात्॥१॥",
      "chapter": 263,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "घण्टाकर्णकृता विष्णुस्तवप्रार्थना तस्य समाधिलाभश्च",
      "combined_translation": "2-2"
    },
    {
      "verse": 3,
      "sanskrit": "तौ च गत्वा समुद्देशं पिशाचौ केशवस्य ह। ततस्तावूचतुर्विष्णुमन्तरीकृत्य केशवम्॥३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 263,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "घण्टाकर्णकृता विष्णुस्तवप्रार्थना तस्य समाधिलाभश्च",
      "combined_translation": "3-3"
    },
    {
      "verse": 4,
      "sanskrit": "को भवान् कस्य वा मर्त्यः कुतश्चागम्यते त्वया। किमर्थमिह सम्प्राप्तो वने घोरे मृगाकुले॥४॥",
      "english": null,
      "bhavadeepa": "अन्तरीकृत्य केशवम् अप्यकेशवीकृत्य॥३॥",
      "chapter": 263,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "घण्टाकर्णकृता विष्णुस्तवप्रार्थना तस्य समाधिलाभश्च",
      "combined_translation": "4-4"
    },
    {
      "verse": 5,
      "sanskrit": "निर्मनुष्ये द्वीपिवृते पिशाचगणसेविते। श्वापदैः सेव्यमाने च विपिने व्याघ्रसङ्कुले॥५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 263,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "घण्टाकर्णकृता विष्णुस्तवप्रार्थना तस्य समाधिलाभश्च",
      "combined_translation": "5-5"
    },
    {
      "verse": 6,
      "sanskrit": "सुकुमारोऽनवद्याङ्गः साक्षाद्विष्णुरिवापरः। पद्मपत्रेक्षणः श्यामः पद्माभः श्रीपतिः स्वयम्॥६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 263,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "घण्टाकर्णकृता विष्णुस्तवप्रार्थना तस्य समाधिलाभश्च",
      "combined_translation": "6-6"
    },
    {
      "verse": 7,
      "sanskrit": "अस्मत्प्रीतिकरः साक्षात्प्राप्तो विष्णुरिवापरः। देवो वा यदि वा यक्षो गन्धर्वः किन्नरोऽपि वा॥७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 263,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "घण्टाकर्णकृता विष्णुस्तवप्रार्थना तस्य समाधिलाभश्च",
      "combined_translation": "7-7"
    },
    {
      "verse": 8,
      "sanskrit": "इन्द्रो वा धनदो वापि यमोऽथ वरुणोऽपि वा। एकाकी विपिने घोरे ध्यानार्पितमना इव॥८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 263,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "घण्टाकर्णकृता विष्णुस्तवप्रार्थना तस्य समाधिलाभश्च",
      "combined_translation": "8-8"
    },
    {
      "verse": 9,
      "sanskrit": "ब्रूहि मर्त्यं यथातत्त्वं ज्ञातुमिच्छामि मानद। एवं पृष्टः पिशाचाभ्यामाह विष्णुरुरुक्रमः॥९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 263,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "घण्टाकर्णकृता विष्णुस्तवप्रार्थना तस्य समाधिलाभश्च",
      "combined_translation": "9-9"
    },
    {
      "verse": 10,
      "sanskrit": "क्षत्रियोऽस्मीति मामाहुर्मनुष्याः प्रकृतिस्थिताः। यदुवंशे समुत्पन्नः क्षात्रं वृत्तमनुष्ठिताः॥१०॥",
      "english": null,
      "bhavadeepa": "हे मर्त्येति सम्बोधनम्। अन्तरीकृतत्वादेव॥९॥",
      "chapter": 263,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "घण्टाकर्णकृता विष्णुस्तवप्रार्थना तस्य समाधिलाभश्च",
      "combined_translation": "10-10"
    },
    {
      "verse": 11,
      "sanskrit": "लोकानामथ पातास्मि शास्ता दुष्टस्य सर्वदा। कैलासं गन्तुकामोऽस्मि द्रष्टुं देवमुमापतिम्॥११॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 263,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "घण्टाकर्णकृता विष्णुस्तवप्रार्थना तस्य समाधिलाभश्च",
      "combined_translation": "11-11"
    },
    {
      "verse": 12,
      "sanskrit": "इत्येवं मम वृत्तान्तः कथ्यतां कौ युवामिति। युवामिह समायातौ किमर्थं ब्राह्मणाश्रमम्॥१२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 263,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "घण्टाकर्णकृता विष्णुस्तवप्रार्थना तस्य समाधिलाभश्च",
      "combined_translation": "12-12"
    },
    {
      "verse": 13,
      "sanskrit": "एषा हि महती पुण्या नानाविप्रनिषेविता। बदरीयं समाख्याता न क्षुद्रैराश्रिता क्वचित्॥१३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 263,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "घण्टाकर्णकृता विष्णुस्तवप्रार्थना तस्य समाधिलाभश्च",
      "combined_translation": "13-13"
    },
    {
      "verse": 14,
      "sanskrit": "तपस्विभिस्तपोयुक्तैर्जुष्टा सिद्धनिषेविता। श्वगणा नात्र दृश्यन्ते पिशाचा मांसभोजनाः॥१४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 263,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "घण्टाकर्णकृता विष्णुस्तवप्रार्थना तस्य समाधिलाभश्च",
      "combined_translation": "14-14"
    },
    {
      "verse": 15,
      "sanskrit": "न हन्तव्या मृगाश्चात्र मृगया नात्र वर्तते। न तु क्षुद्रैः प्रवेष्टव्या न कृतघ्नैर्न नास्तिकैः॥१५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 263,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "घण्टाकर्णकृता विष्णुस्तवप्रार्थना तस्य समाधिलाभश्च",
      "combined_translation": "15-15"
    },
    {
      "verse": 16,
      "sanskrit": "अहमस्य तु देशस्य रक्षिता नात्र संशयः। व्यतिक्रमो यदि भवेत्तस्य शास्तास्मि यत्नतः॥१६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 263,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "घण्टाकर्णकृता विष्णुस्तवप्रार्थना तस्य समाधिलाभश्च",
      "combined_translation": "16-16"
    },
    {
      "verse": 17,
      "sanskrit": "कौ भवन्तौ क्व नु युवां कस्येयं महती चमूः। नातः परं प्रवेष्टव्यमृषयस्त्वत्र संस्थिताः॥१७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 263,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "घण्टाकर्णकृता विष्णुस्तवप्रार्थना तस्य समाधिलाभश्च",
      "combined_translation": "17-17"
    },
    {
      "verse": 18,
      "sanskrit": "विघ्नस्तत्र प्रवर्तेत तपःसु च तपस्विनाम्। इहैव स्थीयतां तावद्वक्तव्यं च ततः सुखम्॥१८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 263,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "घण्टाकर्णकृता विष्णुस्तवप्रार्थना तस्य समाधिलाभश्च",
      "combined_translation": "18-18"
    },
    {
      "verse": 19,
      "sanskrit": "अन्यथाहं निषेद्धा स्यां बलाद्वाक्यैस्तथैव च।\n              वैशम्पायन उवाच।\n              एवं पृष्टौ पिशाचौ तु वक्तुमेवोपचक्रतुः॥१९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 263,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "घण्टाकर्णकृता विष्णुस्तवप्रार्थना तस्य समाधिलाभश्च",
      "combined_translation": "19-19"
    },
    {
      "verse": 20,
      "sanskrit": "तयोरेको महाघोरः पिशाचो दीर्घबाहुकः। उवाच वचनं तत्र यथा हृदि समर्पितम्॥२०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 263,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "घण्टाकर्णकृता विष्णुस्तवप्रार्थना तस्य समाधिलाभश्च",
      "combined_translation": "20-20"
    },
    {
      "verse": 21,
      "sanskrit": "पिशाच उवाच।\n              श्रूयतामभिधास्यामि समाहितमना भव। नमस्कृत्य जगन्नाथं हरिं कृष्णं जगत्पतिम्॥२१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 263,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "घण्टाकर्णकृता विष्णुस्तवप्रार्थना तस्य समाधिलाभश्च",
      "combined_translation": "21-21"
    },
    {
      "verse": 22,
      "sanskrit": "आदिदेवमजं विष्णुं वरेण्यमनघं शुचिम्। वक्ष्यामि सकलं यद्वत्तया शृणु यदीच्छसि॥२२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 263,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "घण्टाकर्णकृता विष्णुस्तवप्रार्थना तस्य समाधिलाभश्च",
      "combined_translation": "22-22"
    },
    {
      "verse": 23,
      "sanskrit": "घण्टाकर्णोऽस्मि नाम्नाहं पिशाचो घोरदर्शनः। मांसादो विकृतो घोरः साक्षान्मृत्युरिवापरः॥२३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 263,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "घण्टाकर्णकृता विष्णुस्तवप्रार्थना तस्य समाधिलाभश्च",
      "combined_translation": "23-23"
    },
    {
      "verse": 24,
      "sanskrit": "धनदस्यानुगन्ताहं साक्षाद्रुद्रसखस्य च। ममायमनुजः साक्षादन्तकस्यान्तको ह्यहम्॥२४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 263,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "घण्टाकर्णकृता विष्णुस्तवप्रार्थना तस्य समाधिलाभश्च",
      "combined_translation": "24-24"
    },
    {
      "verse": 25,
      "sanskrit": "मृगयेयं सुमहती विष्णोः पूजार्थमित्युत। ममेयं वर्तते सेना श्वगणोऽपि ममैव तु॥२५॥",
      "english": null,
      "bhavadeepa": "अनुगता अनुचरः॥२४॥",
      "chapter": 263,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "घण्टाकर्णकृता विष्णुस्तवप्रार्थना तस्य समाधिलाभश्च",
      "combined_translation": "25-25"
    },
    {
      "verse": 26,
      "sanskrit": "आगतोऽहं महाशैलात्कैलासाद्भूतसेवितात्। अहं पिशाचवेषेण संविष्टः पापकर्मकृत्॥२६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 263,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "घण्टाकर्णकृता विष्णुस्तवप्रार्थना तस्य समाधिलाभश्च",
      "combined_translation": "26-26"
    },
    {
      "verse": 27,
      "sanskrit": "सततं दूषयन्विष्णुं घण्टामाबध्य कर्णयोः। मम न प्रविशेन्नाम विष्णोरिति विचिन्तयन्॥२७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 263,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "घण्टाकर्णकृता विष्णुस्तवप्रार्थना तस्य समाधिलाभश्च",
      "combined_translation": "27-27"
    },
    {
      "verse": 28,
      "sanskrit": "अहं कैलासनिलयमासाद्य वृषभध्वजम्। आराध्य तं महादेवमस्तुवं सततं शिवम्॥२८॥",
      "english": null,
