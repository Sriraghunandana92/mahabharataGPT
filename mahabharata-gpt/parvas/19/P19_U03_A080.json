      "adhyaya_name": "घण्टाकर्णकृता विष्णुस्तवप्रार्थना तस्य समाधिलाभश्च"
    },
    {
      "verse": 55,
      "sanskrit": "तस्मिन्नेव समे देशे पीत्वा च रुधिरं बहु। भक्षयित्वा यथाकामं मांसराशिं विचक्षणः॥५५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 263,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "घण्टाकर्णकृता विष्णुस्तवप्रार्थना तस्य समाधिलाभश्च"
    },
    {
      "verse": 56,
      "sanskrit": "अपः संस्पृश्य तत्रैव पार्श्वे संस्थाप्य साधनम्। अन्त्रपाशं  महाघोरं संस्थाप्य विपुलं महत्॥५६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 263,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "घण्टाकर्णकृता विष्णुस्तवप्रार्थना तस्य समाधिलाभश्च"
    },
    {
      "verse": 57,
      "sanskrit": "आसनं कुशसंयुक्तं कृत्वा चाभ्युक्ष्य वारिणा। उत्सार्य श्वगणान्सर्वान्यत्नेन महता तदा॥५७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 263,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "घण्टाकर्णकृता विष्णुस्तवप्रार्थना तस्य समाधिलाभश्च"
    },
    {
      "verse": 58,
      "sanskrit": "सुखासनं समास्थाय समधौ यतते श्वपः। एकचित्तस्तदा भूत्वा नमस्कृत्य च केशवम्। इमं मन्त्रं पठन्घोरः पिशाचो भक्तवत्सलम्॥५८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 263,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "घण्टाकर्णकृता विष्णुस्तवप्रार्थना तस्य समाधिलाभश्च"
    },
    {
      "verse": 59,
      "sanskrit": "नमो भगवते तस्मै वासुदेवाय चक्रिणे। नमस्ते गदिने तुभ्यं वासुदेवाय धीमते॥५९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 263,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "घण्टाकर्णकृता विष्णुस्तवप्रार्थना तस्य समाधिलाभश्च"
    },
    {
      "verse": 60,
      "sanskrit": "ओं नमो नारायणाय विष्णवे प्रभविष्णवे। मम भूयान्मनःशुद्धिः कीर्तनात्तव केशव॥६०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 263,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "घण्टाकर्णकृता विष्णुस्तवप्रार्थना तस्य समाधिलाभश्च"
    },
    {
      "verse": 61,
      "sanskrit": "जन्मेदमीदृशं घोरं मा भून्मम दुरासदम्। देवदूतो भविष्यामि स्मरणात्तव गोपते॥६१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 263,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "घण्टाकर्णकृता विष्णुस्तवप्रार्थना तस्य समाधिलाभश्च"
    },
    {
      "verse": 62,
      "sanskrit": "तव चक्रप्रहारेण कायो नश्यतु मामकः। मम भूयो भावो मा भूदेषा मे प्रार्थना विभो॥६२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 263,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "घण्टाकर्णकृता विष्णुस्तवप्रार्थना तस्य समाधिलाभश्च"
    },
    {
      "verse": 63,
      "sanskrit": "अर्थिनां कल्पवृक्षोऽसि दाता सर्वस्य सर्वदा। यत्र यत्र भवेज्जन्म तत्र तत्र भवान्हृदि॥६३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 263,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "घण्टाकर्णकृता विष्णुस्तवप्रार्थना तस्य समाधिलाभश्च"
    },
    {
      "verse": 64,
      "sanskrit": "वर्ततां मम देवेश प्रार्थनैषा ममापरा। नमस्तुभ्यं नमस्तुभ्यं भवत्वेवं सदा मम॥६४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 263,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "घण्टाकर्णकृता विष्णुस्तवप्रार्थना तस्य समाधिलाभश्च"
    },
    {
      "verse": 65,
      "sanskrit": "निर्विघ्ना प्रार्थना देव नमस्तेऽस्तु सदा मम। यदा मे मरणं भूयात्तद मा भूत्स्मृतिभ्रमः॥६५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 263,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "घण्टाकर्णकृता विष्णुस्तवप्रार्थना तस्य समाधिलाभश्च"
    },
    {
      "verse": 66,
      "sanskrit": "दिने दिने क्षणं चित्तं त्वयि संस्थं भविष्यति। एवं प्रेरय मां देव मा भूत्ते चित्तमीदृशम्॥६६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 263,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "घण्टाकर्णकृता विष्णुस्तवप्रार्थना तस्य समाधिलाभश्च"
    },
    {
      "verse": 67,
      "sanskrit": "नृशंसोऽयं पिशाचोऽयं दयास्मिन्का भवेदिति। एवं चिन्तय मां देव भृत्यो मह्यमिति प्रभो॥६७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 263,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "घण्टाकर्णकृता विष्णुस्तवप्रार्थना तस्य समाधिलाभश्च"
    },
    {
      "verse": 68,
      "sanskrit": "परपीडा न मत्तोऽस्तु नमस्ते भगवन्प्रभो। इन्द्रियाणीन्द्रियार्थेषु मा भूवन्साम्प्रतं हि मे॥६८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 263,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "घण्टाकर्णकृता विष्णुस्तवप्रार्थना तस्य समाधिलाभश्च"
    },
    {
      "verse": 69,
      "sanskrit": "अन्तकाले ममाप्येवं प्रसादात्तव केशव। पृथिवी यातु मे घ्राणं रसनां यातु मे पयः॥६९॥",
      "english": null,
      "bhavadeepa": "इन्द्रियार्थेषु शब्दादिषु प्रसक्तानीति शेषः॥६८॥",
      "chapter": 263,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "घण्टाकर्णकृता विष्णुस्तवप्रार्थना तस्य समाधिलाभश्च"
    },
    {
      "verse": 70,
      "sanskrit": "सूर्यश्च यातु मे चक्षुः स्पर्शं यातु च मारुतः। श्रोत्रमाकाशमप्येतु मनः प्राणं च गच्छतु॥७०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 263,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "घण्टाकर्णकृता विष्णुस्तवप्रार्थना तस्य समाधिलाभश्च"
    },
    {
      "verse": 71,
      "sanskrit": "जलं मां रक्षतां नित्यं पृथिवी रक्षतां हरे। सुर्यो मां रक्षतां विष्णो नमस्ते सूर्यतेजसे॥७१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 263,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "घण्टाकर्णकृता विष्णुस्तवप्रार्थना तस्य समाधिलाभश्च"
    },
    {
      "verse": 72,
      "sanskrit": "वायुर्मां रक्षतां दुःखादाकाशं च जनार्दन। न मनः सर्वगं देव रक्षतां विषयान्तरे॥७२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 263,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "घण्टाकर्णकृता विष्णुस्तवप्रार्थना तस्य समाधिलाभश्च"
    },
    {
      "verse": 73,
      "sanskrit": "मनो विपर्यये घोरे पुरुषान्हन्ति नित्यशः। पापेषु योजयेत्पुंसः परपीडात्मकेषु च॥७३॥",
      "english": null,
      "bhavadeepa": "सर्वगं परमात्मगतं मम मनः कर्तृ। विषयान्तरे विषयः शब्दादिः अन्तरः भेदः ते उभे कर्मणि न रक्षतां विषयप्रवणं भेदबुद्धिहरं च मनो मा भूदित्यर्थः॥७२॥",
      "chapter": 263,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "घण्टाकर्णकृता विष्णुस्तवप्रार्थना तस्य समाधिलाभश्च"
    },
    {
      "verse": 74,
      "sanskrit": "मनस्तद्रक्षतां देव भूयो भूयो जनार्दन। मा भून्मनसि कालुष्यं मनो मे निर्मलं भवेत्॥७४॥",
      "english": null,
      "bhavadeepa": "अन्यथा दोषमाह- मन इति। विपर्यये विषयादिप्रावण्ये॥७३॥",
      "chapter": 263,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "घण्टाकर्णकृता विष्णुस्तवप्रार्थना तस्य समाधिलाभश्च"
    },
    {
      "verse": 75,
      "sanskrit": "कलुषं तस्य यच्चित्तं नरके पातयत्यमुम्। बाह्यानि निर्मलान्येवमिन्द्रियाणि भवन्त्युत॥७५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 263,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "घण्टाकर्णकृता विष्णुस्तवप्रार्थना तस्य समाधिलाभश्च"
    },
    {
      "verse": 76,
      "sanskrit": "न तानि कार्यवन्तीह मनश्चेत्कलुशं भवेत्। नाङ्गानि मुष्टिनामेध्यं गृहीत्वा यो व्यवस्थितः॥७६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 263,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "घण्टाकर्णकृता विष्णुस्तवप्रार्थना तस्य समाधिलाभश्च"
    },
    {
      "verse": 77,
      "sanskrit": "बहिः प्रक्षालनं कुर्वन्किं भवेत्तस्य केशव। व्यर्थो हि केवलं तस्य प्रग्रहो बाह्यगोचरः॥७७॥",
      "english": null,
      "bhavadeepa": "नाङ्गनीति सार्धः॥७६॥",
      "chapter": 263,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "घण्टाकर्णकृता विष्णुस्तवप्रार्थना तस्य समाधिलाभश्च"
    },
    {
      "verse": 78,
      "sanskrit": "तस्मात्सर्वप्रयत्नेन चित्तं रक्ष जनार्दन। बलवानिन्द्रियग्रामो वारयैनं जनार्दन॥७८॥",
      "english": null,
      "bhavadeepa": "प्रग्रहः शुद्ध्यर्थमाग्रहः॥७७॥",
      "chapter": 263,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "घण्टाकर्णकृता विष्णुस्तवप्रार्थना तस्य समाधिलाभश्च"
    },
    {
      "verse": 79,
      "sanskrit": "परीवादाज्जगन्नाथ वाचं रक्ष दुरुद्वहाम्। परद्रव्यान्मनो रक्ष परदाराज्जनार्दन। सर्वत्र मे दया भूयात्प्रसादात्तव केशव॥७९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 263,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "घण्टाकर्णकृता विष्णुस्तवप्रार्थना तस्य समाधिलाभश्च"
    },
    {
      "verse": 80,
      "sanskrit": "त्वय्येव भक्तिरचला भूयाद्भूतेषु मे दया। बहुनात्र किमुक्तेन शृणुश्वेदं वचो मम॥८०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 263,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "घण्टाकर्णकृता विष्णुस्तवप्रार्थना तस्य समाधिलाभश्च"
    },
    {
      "verse": 81,
      "sanskrit": "सुखे दुःखे च रागे च भोजने गमने तथा। जाग्रत्स्वप्नेषु सर्वत्र त्वय्येव रमतां मनः॥८१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 263,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "घण्टाकर्णकृता विष्णुस्तवप्रार्थना तस्य समाधिलाभश्च"
    },
    {
      "verse": 82,
      "sanskrit": "मामकं देवदेवेश नमस्तेऽस्तु जनार्दन। इति ब्रुवन्घोरतमो जात्या हीनो न चित्ततः॥८२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 263,
      "parva_name": "हरिवंशः",
      "upaparva_name": "भविष्यपर्व",
      "adhyaya_name": "घण्टाकर्णकृता विष्णुस्तवप्रार्थना तस्य समाधिलाभश्च"
    },
    {
      "verse": 83,
      "sanskrit": "पिशाचो भगवद्भक्तः समाधिं समपद्यत। दृढं बद्ध्वात्मनः कायमान्त्रपाशेन मांसपः॥८३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 263,
