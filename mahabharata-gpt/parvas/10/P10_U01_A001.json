{
  "adhyaya_id": "P10_U01_A001",
  "book": 10,
  "parva_name": "सौप्तिकपर्व",
  "upaparva_name": "सौप्तिकपर्व",
  "adhyaya_name": "प्रथमोऽध्यायः",
  "chapter": 1,
  "verse_count": 69,
  "verses": [
    {
      "verse": 1,
      "sanskrit": "सञ्जय उवाच।\n              ततस्ते सहिता वीराः प्रयाता दक्षिणामुखाः। उपास्तमनवेलायां शिबिराभ्याशमागताः॥१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 1,
      "parva_name": "सौप्तिकपर्व",
      "upaparva_name": "सौप्तिकपर्व",
      "adhyaya_name": "प्रथमोऽध्यायः"
    },
    {
      "verse": 2,
      "sanskrit": "विमुच्य वाहांस्त्वरिता भीताः समभवंस्तदा। गहनं देशमासाद्य प्रच्छन्नान्यविशन्त ते॥२॥",
      "english": null,
      "bhavadeepa": "पूर्वस्मिन्पर्वणि अर्यार्थी कुटुम्बनाशमनु स्वयमपि नश्यतीत्युक्तम्। इदानीं परधर्मानुगो ब्राह्मणः तद्धर्मेष्वपि निन्द्यतमं कर्म करोतीत्युच्यते ततस्ते सहिता वीरा इत्यादिना सौप्तिकपर्वणि। ततः दुर्योधनेन सैनापत्येऽश्वत्थाम्नोऽभिषेकानन्तरं तेऽश्वत्थामकृपाचार्यकृतवर्माणः शिबिराभ्याशं शिबिरनिकटस्थं देशम् आसाद्य वाहान्विमुच्य न्यविशन्तेति योजना॥१॥",
      "chapter": 1,
      "parva_name": "सौप्तिकपर्व",
      "upaparva_name": "सौप्तिकपर्व",
      "adhyaya_name": "प्रथमोऽध्यायः"
    },
    {
      "verse": 3,
      "sanskrit": "सेनानिवेशमभितो नातिदूरमवस्थिताः। निकृत्ता निशितैः शस्त्रैः समन्तात्क्षतविक्षताः॥३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 1,
      "parva_name": "सौप्तिकपर्व",
      "upaparva_name": "सौप्तिकपर्व",
      "adhyaya_name": "प्रथमोऽध्यायः"
    },
    {
      "verse": 4,
      "sanskrit": "दीर्घमुष्णं च निःश्वस्य पाण्डवानेव चिन्तयन्। श्रुत्वा च निनदं घोरं पाण्डवानां जयैषिणाम्॥४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 1,
      "parva_name": "सौप्तिकपर्व",
      "upaparva_name": "सौप्तिकपर्व",
      "adhyaya_name": "प्रथमोऽध्यायः"
    },
    {
      "verse": 5,
      "sanskrit": "अनुसारभयाद्भीताः प्राङ्मुखाः प्राद्रवन्पुनः। ते मुहूर्त्तात्ततो गत्वा श्रान्तवाहाः पिपासिताः॥५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 1,
      "parva_name": "सौप्तिकपर्व",
      "upaparva_name": "सौप्तिकपर्व",
      "adhyaya_name": "प्रथमोऽध्यायः"
    },
    {
      "verse": 6,
      "sanskrit": "नामृष्यन्त महेष्वासाः क्रोधामर्षवशंगताः। राज्ञो वधेन सन्तप्ता मुहूर्त्तं समवस्थिताः॥६॥",
      "english": null,
      "bhavadeepa": "अनुसारः पृष्ठगमनम्। प्राद्रवन्निति पुनर्वाहान्योजयित्वेति गम्यते॥५॥",
      "chapter": 1,
      "parva_name": "सौप्तिकपर्व",
      "upaparva_name": "सौप्तिकपर्व",
      "adhyaya_name": "प्रथमोऽध्यायः"
    },
    {
      "verse": 7,
      "sanskrit": "धृतराष्ट्र उवाच।\n              अश्रद्धेयमिदं कर्म कृतं भीमेन सञ्जय। यत्स नागायुतप्राणः पुत्रो मम निपातितः॥७॥",
      "english": null,
      "bhavadeepa": "नामृष्यन्त पिपासामपि न परामृष्टवन्तः राज्ञो दुर्योधनस्य॥६॥",
      "chapter": 1,
      "parva_name": "सौप्तिकपर्व",
      "upaparva_name": "सौप्तिकपर्व",
      "adhyaya_name": "प्रथमोऽध्यायः"
    },
    {
      "verse": 8,
      "sanskrit": "अवध्यः सर्वभूतानां वज्रसंहननो युवा। पाण्डवैः समरे पुत्रो निहतो मम सञ्जय॥८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 1,
      "parva_name": "सौप्तिकपर्व",
      "upaparva_name": "सौप्तिकपर्व",
      "adhyaya_name": "प्रथमोऽध्यायः"
    },
    {
      "verse": 9,
      "sanskrit": "न दिष्टमभ्यतिक्रान्तुं शक्यं गावल्गणे नरैः। यत्समेत्य रणे पार्थः पुत्रो मम निपातितः॥९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 1,
      "parva_name": "सौप्तिकपर्व",
      "upaparva_name": "सौप्तिकपर्व",
      "adhyaya_name": "प्रथमोऽध्यायः"
    },
    {
      "verse": 10,
      "sanskrit": "अद्रिसारमयं नूनं हृदयं मम सञ्जय। हतं पुत्रशतं श्रुत्वा यन्न दीर्णं सहस्रधा॥१०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 1,
      "parva_name": "सौप्तिकपर्व",
      "upaparva_name": "सौप्तिकपर्व",
      "adhyaya_name": "प्रथमोऽध्यायः"
    },
    {
      "verse": 11,
      "sanskrit": "कथं हि वृद्धमिथुनं हतपुत्रं भविष्यति। न ह्यहं पाण्डवेयस्य विषये वस्तुमुत्सहे॥११॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 1,
      "parva_name": "सौप्तिकपर्व",
      "upaparva_name": "सौप्तिकपर्व",
      "adhyaya_name": "प्रथमोऽध्यायः"
    },
    {
      "verse": 12,
      "sanskrit": "कथं राज्ञः पिता भूत्वा स्वयं राजा च सञ्जय। प्रेष्यभूतः प्रवर्तेयं पाण्डवेयस्य शासनात्॥१२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 1,
      "parva_name": "सौप्तिकपर्व",
      "upaparva_name": "सौप्तिकपर्व",
      "adhyaya_name": "प्रथमोऽध्यायः"
    },
    {
      "verse": 13,
      "sanskrit": "आज्ञाप्य पृथिवीं सर्वां स्थित्वा मूर्द्धनि सञ्जय। येन पुत्रशतं पूर्णमेकेन निहतं मम॥१३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 1,
      "parva_name": "सौप्तिकपर्व",
      "upaparva_name": "सौप्तिकपर्व",
      "adhyaya_name": "प्रथमोऽध्यायः"
    },
    {
      "verse": 14,
      "sanskrit": "कृतं सत्यं वचस्तस्य विदुरस्य महात्मनः। अकुर्वता वचस्तेन मम पुत्रेण सञ्जय॥१४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 1,
      "parva_name": "सौप्तिकपर्व",
      "upaparva_name": "सौप्तिकपर्व",
      "adhyaya_name": "प्रथमोऽध्यायः"
    },
    {
      "verse": 15,
      "sanskrit": "कथमस्य भविष्यामि प्रेष्यभूतो दुरन्तकृत्। कथं भीमस्य वाक्यानि श्रोतुं शक्ष्यामि सञ्जय॥१५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 1,
      "parva_name": "सौप्तिकपर्व",
      "upaparva_name": "सौप्तिकपर्व",
      "adhyaya_name": "प्रथमोऽध्यायः"
    },
    {
      "verse": 16,
      "sanskrit": "अधर्मेण हते तात पुत्रे दुर्योधने मम। कृतवर्मा कृपो द्रौणिः किमकुर्वत सञ्जय॥१६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 1,
      "parva_name": "सौप्तिकपर्व",
      "upaparva_name": "सौप्तिकपर्व",
      "adhyaya_name": "प्रथमोऽध्यायः"
    },
    {
      "verse": 17,
      "sanskrit": "सञ्जय उवाच।\n              गत्वा तु तावका राजन्नातिदूरमवस्थिताः। अपश्यन्त वनं घोरं नानाद्रुमलतावृतम्॥१७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 1,
      "parva_name": "सौप्तिकपर्व",
      "upaparva_name": "सौप्तिकपर्व",
      "adhyaya_name": "प्रथमोऽध्यायः"
    },
    {
      "verse": 18,
      "sanskrit": "ते मुहूर्तं तु विश्रम्य लब्धतोयैर्हयोत्तमैः। सूर्यास्तमनवेलायां समासेदुर्महद्वनम्॥१८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 1,
      "parva_name": "सौप्तिकपर्व",
      "upaparva_name": "सौप्तिकपर्व",
      "adhyaya_name": "प्रथमोऽध्यायः"
    },
    {
      "verse": 19,
      "sanskrit": "नानामृगगणैर्जुष्टं नानापक्षिगणावृतम्। नानाद्रुमलताच्छन्नं नानाव्यालनिषेवितम्॥१९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 1,
      "parva_name": "सौप्तिकपर्व",
      "upaparva_name": "सौप्तिकपर्व",
      "adhyaya_name": "प्रथमोऽध्यायः"
    },
    {
      "verse": 20,
      "sanskrit": "नानातोयैः समाकीर्णं नानापुष्पोपशोभितम्। पद्मिनीशतसञ्च्छन्नं नीलोत्पलसमायुतम्॥२०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 1,
      "parva_name": "सौप्तिकपर्व",
      "upaparva_name": "सौप्तिकपर्व",
      "adhyaya_name": "प्रथमोऽध्यायः"
    },
    {
      "verse": 21,
      "sanskrit": "प्रविश्य तद्वनं घोरं वीक्षमाणाः समन्ततः। शाखासहस्रसञ्छन्नं न्यग्रोधं ददृशुस्ततः॥२१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 1,
      "parva_name": "सौप्तिकपर्व",
      "upaparva_name": "सौप्तिकपर्व",
      "adhyaya_name": "प्रथमोऽध्यायः"
    },
    {
      "verse": 22,
      "sanskrit": "उपेत्य तु तदा राजन् न्यग्रोधं ते महारथाः। ददृशुर्द्विपदां श्रेष्ठाः श्रेष्ठं तं वै वनस्पतिम्॥२२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 1,
      "parva_name": "सौप्तिकपर्व",
      "upaparva_name": "सौप्तिकपर्व",
      "adhyaya_name": "प्रथमोऽध्यायः"
    },
    {
      "verse": 23,
      "sanskrit": "तेऽवतीर्य रथेभ्यश्च विप्रमुच्य च वाजिनः। उपस्पृश्य यथान्यायं सन्ध्यामन्वासत प्रभो॥२३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 1,
      "parva_name": "सौप्तिकपर्व",
      "upaparva_name": "सौप्तिकपर्व",
      "adhyaya_name": "प्रथमोऽध्यायः"
    },
    {
      "verse": 24,
      "sanskrit": "ततोऽस्तं पर्वतश्रेष्ठमनुप्राप्ते दिवाकरे। सर्वस्य जगतो धात्री शर्वरी समपद्यत॥२४॥",
      "english": null,
      "bhavadeepa": "अन्वासत उपासितवन्तः॥२३॥",
      "chapter": 1,
      "parva_name": "सौप्तिकपर्व",
      "upaparva_name": "सौप्तिकपर्व",
      "adhyaya_name": "प्रथमोऽध्यायः"
    },
    {
      "verse": 25,
      "sanskrit": "ग्रहनक्षत्रताराभिः सम्पूर्णाभिरलङ्कृतम्। नभोंशुकमिवाभाति प्रेक्षणीयं समन्ततः॥२५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 1,
      "parva_name": "सौप्तिकपर्व",
      "upaparva_name": "सौप्तिकपर्व",
      "adhyaya_name": "प्रथमोऽध्यायः"
    },
    {
      "verse": 26,
      "sanskrit": "इच्छया ते प्रवल्गन्ति ये सत्त्वा रात्रिचारिणः। दिवाचराश्च ये सत्त्वास्ते निद्रावशमागताः॥२६॥",
      "english": null,
      "bhavadeepa": "अलङ्कृतं रजतबिन्दुचित्रितम् अंशुकं वस्रम्॥२५॥",
      "chapter": 1,
      "parva_name": "सौप्तिकपर्व",
      "upaparva_name": "सौप्तिकपर्व",
      "adhyaya_name": "प्रथमोऽध्यायः"
    },
    {
      "verse": 27,
      "sanskrit": "रात्रिञ्चराणां सत्वानां निर्घोषोऽभूत्सुदारुणः। क्रव्यादाश्च प्रमुदिता घोरा प्राप्ता च शर्वरी॥२७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 1,
      "parva_name": "सौप्तिकपर्व",
      "upaparva_name": "सौप्तिकपर्व",
      "adhyaya_name": "प्रथमोऽध्यायः"
    },
    {
      "verse": 28,
      "sanskrit": "तस्मिन् रात्रिमुखे घोरे दुःखशोकसमन्विताः। कृतवर्मा कृपो द्रौणिरुपोपविविशुः समम्॥२८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 1,
      "parva_name": "सौप्तिकपर्व",
      "upaparva_name": "सौप्तिकपर्व",
      "adhyaya_name": "प्रथमोऽध्यायः"
    },
    {
      "verse": 29,
      "sanskrit": "तत्रोपविष्टाः शोचन्तो न्यग्रोधस्य समीपतः। तमेवार्थमतिक्रान्तं कुरुपाण्डवयोः क्षयम्॥२९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 1,
      "parva_name": "सौप्तिकपर्व",
      "upaparva_name": "सौप्तिकपर्व",
      "adhyaya_name": "प्रथमोऽध्यायः"
    },
    {
      "verse": 30,
      "sanskrit": "निद्रया च परीताङ्गा निषेदुर्धरणीतले। श्रमेण सुदृढं युक्ता विक्षता विविधैः शरैः॥३०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 1,
      "parva_name": "सौप्तिकपर्व",
      "upaparva_name": "सौप्तिकपर्व",
      "adhyaya_name": "प्रथमोऽध्यायः"
    },
    {
      "verse": 31,
      "sanskrit": "ततो निद्रावशं प्राप्तौ कृपभोजौ महारथौ। सुखोचितावदुःखार्हौ निषण्णौ धरणीतले॥३१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 1,
      "parva_name": "सौप्तिकपर्व",
      "upaparva_name": "सौप्तिकपर्व",
      "adhyaya_name": "प्रथमोऽध्यायः"
    },
    {
      "verse": 32,
      "sanskrit": "तौ तु सुप्तौ महाराज श्रमशोकसमन्वितौ। महार्हशयनोपेतौ भूमावेव ह्यनाथवत्॥३२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 1,
      "parva_name": "सौप्तिकपर्व",
      "upaparva_name": "सौप्तिकपर्व",
      "adhyaya_name": "प्रथमोऽध्यायः"
    },
    {
      "verse": 33,
      "sanskrit": "क्रोधामर्षशतं प्राप्तो द्रोणपुत्रस्तु भारत। न वै स्म स जगामाथ निद्रां सर्प इव श्वसन्॥३३॥",
      "english": null,
