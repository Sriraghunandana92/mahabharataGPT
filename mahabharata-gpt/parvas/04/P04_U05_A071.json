  "verses": [
    {
      "verse": 1,
      "sanskrit": "विराट उवाच । यद्येष राजा कौरव्यः कुन्तीपुत्रो युधिष्ठिरः । कतमोऽस्यार्जुनो भ्राता भीमश्च कतमो बली ॥१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 71,
      "parva_name": "विराटपर्व",
      "upaparva_name": "वैवाहिकपर्व",
      "adhyaya_name": "एकसप्ततितमोऽध्यायः"
    },
    {
      "verse": 2,
      "sanskrit": "नकुलः सहदेवो वा द्रौपदी वा यशस्विनी । यदा द्यूतजिताः पार्था न प्राज्ञायन्त ते क्वचित् ॥२॥",
      "english": null,
      "bhavadeepa": "यदिति ॥१॥",
      "chapter": 71,
      "parva_name": "विराटपर्व",
      "upaparva_name": "वैवाहिकपर्व",
      "adhyaya_name": "एकसप्ततितमोऽध्यायः"
    },
    {
      "verse": 3,
      "sanskrit": "अर्जुन उवाच । य एष वल्लवो ब्रूते सूदस्तव नराधिप । एष भीमो महाराज भीमवेगपराक्रमः ॥३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 71,
      "parva_name": "विराटपर्व",
      "upaparva_name": "वैवाहिकपर्व",
      "adhyaya_name": "एकसप्ततितमोऽध्यायः"
    },
    {
      "verse": 4,
      "sanskrit": "एष क्रोधवशान् हत्वा पर्वते गन्धमादने । सौगन्धिकानि दिव्यानि कृष्णार्थे समुपाहरत् ॥४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 71,
      "parva_name": "विराटपर्व",
      "upaparva_name": "वैवाहिकपर्व",
      "adhyaya_name": "एकसप्ततितमोऽध्यायः"
    },
    {
      "verse": 5,
      "sanskrit": "गन्धर्व एष वै हन्ता कीचकानां दुरात्मनाम् । व्याघ्रानृक्षान् वराहांश्च हतवांस्त्रीपुरे तव ॥५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 71,
      "parva_name": "विराटपर्व",
      "upaparva_name": "वैवाहिकपर्व",
      "adhyaya_name": "एकसप्ततितमोऽध्यायः"
    },
    {
      "verse": 6,
      "sanskrit": "यश्चासीदश्वबन्धस्ते नकुलोऽयं परन्तपः । गोसङ्ख्यः सहदेवश्च माद्रीपुत्रौ महारथी ॥६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 71,
      "parva_name": "विराटपर्व",
      "upaparva_name": "वैवाहिकपर्व",
      "adhyaya_name": "एकसप्ततितमोऽध्यायः"
    },
    {
      "verse": 7,
      "sanskrit": "शृङ्गारवेषाभरणौ रूपवन्तौ यशस्विनौ । महारथसहस्राणां समर्थौ भरतर्षभौ ॥७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 71,
      "parva_name": "विराटपर्व",
      "upaparva_name": "वैवाहिकपर्व",
      "adhyaya_name": "एकसप्ततितमोऽध्यायः"
    },
    {
      "verse": 8,
      "sanskrit": "एषा पद्मपलाशाक्षी सुमध्या चारुहासिनी । सैरन्ध्री द्रौपदी राजन् यस्यार्थे कीचका हताः ॥८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 71,
      "parva_name": "विराटपर्व",
      "upaparva_name": "वैवाहिकपर्व",
      "adhyaya_name": "एकसप्ततितमोऽध्यायः"
    },
    {
      "verse": 9,
      "sanskrit": "अर्जुनोऽहं महाराज व्यक्तं ते श्रोत्रमागतः । भीमादवरजः पार्थो यमाभ्यां चापि पूर्वजः ॥९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 71,
      "parva_name": "विराटपर्व",
      "upaparva_name": "वैवाहिकपर्व",
      "adhyaya_name": "एकसप्ततितमोऽध्यायः"
    },
    {
      "verse": 10,
      "sanskrit": "ऊषिताः स्मो महाराज सुखं तव निवेशने । अज्ञातवासमुषिता गर्भवास इव प्रजाः ॥१०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 71,
      "parva_name": "विराटपर्व",
      "upaparva_name": "वैवाहिकपर्व",
      "adhyaya_name": "एकसप्ततितमोऽध्यायः"
    },
    {
      "verse": 11,
      "sanskrit": "वैशम्पायन उवाच । यदाऽर्जुनेन ते वीराः कथिताः पञ्च पाण्डवाः । तदाऽर्जुनस्य वैराटिः कथयामास विक्रमम् ॥११॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 71,
      "parva_name": "विराटपर्व",
      "upaparva_name": "वैवाहिकपर्व",
      "adhyaya_name": "एकसप्ततितमोऽध्यायः"
    },
    {
      "verse": 12,
      "sanskrit": "पुनरेव च तान् पार्थान् दर्शयामास चोत्तरः ॥१२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 71,
      "parva_name": "विराटपर्व",
      "upaparva_name": "वैवाहिकपर्व",
      "adhyaya_name": "एकसप्ततितमोऽध्यायः"
    },
    {
      "verse": 13,
      "sanskrit": "उत्तर उवाच । य एष जाम्बूनदशुद्धगौरतनुर्महान् सिंह इव प्रवृद्धः । प्रचण्डघोणः पृथुदीर्घनेत्रस्ताम्रायताक्षः कुरुराज एषः ॥१३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 71,
      "parva_name": "विराटपर्व",
      "upaparva_name": "वैवाहिकपर्व",
      "adhyaya_name": "एकसप्ततितमोऽध्यायः"
    },
    {
      "verse": 14,
      "sanskrit": "अयं पुनर्मत्तगजेन्द्रगामी प्रतप्तचामीकरशुद्धगौरः । पृथ्वायतांसो गुरुदीर्घबाहुर्वृकोदरः पश्यत पश्यतैनम् ॥१४॥",
      "english": null,
      "bhavadeepa": "प्रचण्डघोणः पृथुनासिकः घोणा कन्धरेत्यपि ॥१३॥",
      "chapter": 71,
      "parva_name": "विराटपर्व",
      "upaparva_name": "वैवाहिकपर्व",
      "adhyaya_name": "एकसप्ततितमोऽध्यायः"
    },
    {
      "verse": 15,
      "sanskrit": "यस्त्वेव पार्श्वेऽस्य महाधनुष्मान् श्यामो युवा वारणयूथपोपमः । सिंहोन्नतांसो गजराजगामी पद्मायताक्षोऽर्जुन एष वीरः ॥१५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 71,
      "parva_name": "विराटपर्व",
      "upaparva_name": "वैवाहिकपर्व",
      "adhyaya_name": "एकसप्ततितमोऽध्यायः"
    },
    {
      "verse": 16,
      "sanskrit": "राज्ञः समीपे पुरुषोत्तमौ तु यमाविमौ विष्णुमहेन्द्रकल्पौ । मनुष्यलोके सकले समोऽस्ति ययोर्न रूपे न बले न शीले ॥१६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 71,
      "parva_name": "विराटपर्व",
      "upaparva_name": "वैवाहिकपर्व",
      "adhyaya_name": "एकसप्ततितमोऽध्यायः"
    },
    {
      "verse": 17,
      "sanskrit": "आभ्यां तु पार्श्वे कनकोत्तमाङ्गी यैषा प्रभा मूर्तिमतीव गौरी । नीलोत्पलाभा सुरदेवतेव कृष्णा स्थिता मूर्तिमतीव लक्ष्मीः ॥१७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 71,
      "parva_name": "विराटपर्व",
      "upaparva_name": "वैवाहिकपर्व",
      "adhyaya_name": "एकसप्ततितमोऽध्यायः"
    },
    {
      "verse": 18,
      "sanskrit": "वैशम्पायन उवाच । एवं निवेद्य तान् पार्थान् पाण्डवान् पञ्च भूपतेः । ततोऽर्जुनस्य वैराटिः कथयामास विक्रमम् ॥१८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 71,
      "parva_name": "विराटपर्व",
      "upaparva_name": "वैवाहिकपर्व",
      "adhyaya_name": "एकसप्ततितमोऽध्यायः"
    },
    {
      "verse": 19,
      "sanskrit": "उत्तर उवाच । अयं स द्विषतां हन्ता मृगाणामिव केसरी । अचरद्रथवृन्देषु निघ्नंस्तांस्तान् वरान् रथान् ॥१९॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 71,
      "parva_name": "विराटपर्व",
      "upaparva_name": "वैवाहिकपर्व",
      "adhyaya_name": "एकसप्ततितमोऽध्यायः"
    },
    {
      "verse": 20,
      "sanskrit": "अनेन विद्धो मातङ्गो महानेकेषुणा हतः । सुवर्णकक्षः सङ्ग्रामे दन्ताभ्यामगमन्महीम् ॥२०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 71,
      "parva_name": "विराटपर्व",
      "upaparva_name": "वैवाहिकपर्व",
      "adhyaya_name": "एकसप्ततितमोऽध्यायः"
    },
    {
      "verse": 21,
      "sanskrit": "अनेन विजिता गावो जिताश्च कुरवो युधि । अस्य शङ्खप्रणादेन कर्णौ मे बधिरीकृतौ ॥२१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 71,
      "parva_name": "विराटपर्व",
      "upaparva_name": "वैवाहिकपर्व",
      "adhyaya_name": "एकसप्ततितमोऽध्यायः"
    },
    {
      "verse": 22,
      "sanskrit": "वैशम्पायन उवाच । तस्य तद्वचनं श्रुत्वा मत्स्यराजः प्रतापवान् । उत्तरं प्रत्युवाचेद‌मभिपन्नो युधिष्ठिरे ॥२२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 71,
      "parva_name": "विराटपर्व",
      "upaparva_name": "वैवाहिकपर्व",
      "adhyaya_name": "एकसप्ततितमोऽध्यायः",
      "english_ref": 3,
      "combined_translation": "3-22"
    },
    {
      "verse": 23,
      "sanskrit": "प्रसादनं पाण्डवस्य प्राप्तकालं हि रोचते । उत्तरां च प्रयच्छामि पार्थाय यदि मन्यसे ॥२३॥",
      "english": null,
      "bhavadeepa": "अभिपन्नोऽपराधं कृतवान् ॥२२॥",
      "chapter": 71,
      "parva_name": "विराटपर्व",
      "upaparva_name": "वैवाहिकपर्व",
      "adhyaya_name": "एकसप्ततितमोऽध्यायः"
    },
    {
      "verse": 24,
      "sanskrit": "उत्तर उवाच । आर्याः पूज्याश्च मान्याश्च प्राप्तकालं च मे मतम् । पूज्यन्तां पूजनार्हाश्च महाभागाश्च पाण्डवाः॥२४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 71,
      "parva_name": "विराटपर्व",
      "upaparva_name": "वैवाहिकपर्व",
      "adhyaya_name": "एकसप्ततितमोऽध्यायः"
    },
    {
      "verse": 25,
      "sanskrit": "विराट उवाच । अहं खल्वपि सङ्ग्रामे शत्रूणां वशमागतः । मोक्षितो भीमसेनेन गावश्चापि जितास्तथा ॥२५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 71,
      "parva_name": "विराटपर्व",
      "upaparva_name": "वैवाहिकपर्व",
      "adhyaya_name": "एकसप्ततितमोऽध्यायः"
    },
    {
      "verse": 26,
      "sanskrit": "एतेषां वाहुवीर्येण अस्माकं विजयो मृधे । एवं सर्वे सहामात्याः कुन्तीपुत्रं युधिष्ठिरम् । प्रसादयामो भद्रं ते सानुजं पाण्डवर्षभम् ॥२६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 71,
      "parva_name": "विराटपर्व",
      "upaparva_name": "वैवाहिकपर्व",
      "adhyaya_name": "एकसप्ततितमोऽध्यायः"
    },
    {
      "verse": 27,
      "sanskrit": "यदस्माभिरजानद्भिः किञ्चिदुक्तो नराधिपः । क्षन्तुमर्हति तत् सर्वं धर्मात्मा ह्येष पाण्डवः ॥२७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 71,
      "parva_name": "विराटपर्व",
      "upaparva_name": "वैवाहिकपर्व",
      "adhyaya_name": "एकसप्ततितमोऽध्यायः"
    },
    {
      "verse": 28,
      "sanskrit": "वैशम्पायन उवाच । ततो विराटः परमाभितुष्टः समेत्य राजा समयं चकार । राज्यं च सर्वं विससर्ज तस्मै सदण्डकोशं सपुरं महात्मा ॥२८॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 71,
      "parva_name": "विराटपर्व",
      "upaparva_name": "वैवाहिकपर्व",
      "adhyaya_name": "एकसप्ततितमोऽध्यायः"
    },
    {
      "verse": 29,
      "sanskrit": "पाण्डवांश्च ततः सर्वान् मत्स्यराजः प्रतापवान् । धनञ्जयं पुरस्कृत्य दिष्ट्या दिष्ट्येति चाब्रवीत् ॥२९॥",
      "english": null,
      "bhavadeepa": "समेत्य पुत्रेण सह समयं निश्चयं चकार विससर्ज ददौ ॥२८॥",
      "chapter": 71,
      "parva_name": "विराटपर्व",
      "upaparva_name": "वैवाहिकपर्व",
      "adhyaya_name": "एकसप्ततितमोऽध्यायः"
    },
    {
      "verse": 30,
      "sanskrit": "समुपाघ्राय मूर्धानं संश्लिष्य च पुनः पुनः । युधिष्ठिरं च भीमं च माद्रीपुत्रौ च पाण्डवौ ॥३०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 71,
      "parva_name": "विराटपर्व",
      "upaparva_name": "वैवाहिकपर्व",
      "adhyaya_name": "एकसप्ततितमोऽध्यायः"
    },
    {
      "verse": 31,
      "sanskrit": "नातृप्यद्दर्शने तेषां विराटो वाहिनीपतिः । स प्रीयमाणो राजानं युधिष्ठिरमथाब्रवीत् ॥३१॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 71,
      "parva_name": "विराटपर्व",
      "upaparva_name": "वैवाहिकपर्व",
      "adhyaya_name": "एकसप्ततितमोऽध्यायः"
    },
    {
      "verse": 32,
      "sanskrit": "दिष्ट्या भवन्तः संप्राप्ताः सर्वे कुशलिनो वनात् । दिष्ट्या संपालितं कृच्छ्रमज्ञातं वै दुरात्मभिः ॥३२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 71,
      "parva_name": "विराटपर्व",
      "upaparva_name": "वैवाहिकपर्व",
      "adhyaya_name": "एकसप्ततितमोऽध्यायः"
    },
