      "parva_name": "विराटपर्व",
      "upaparva_name": "वैवाहिकपर्व",
      "adhyaya_name": "सप्ततितमोऽध्यायः"
    },
    {
      "verse": 20,
      "sanskrit": "एनमष्टशताः सूताः सुमृष्टमणिकुण्डलाः । अब्रुवन् मागधैः सार्धं पुरा शक्रमिवर्षयः ॥२०॥",
      "english": null,
      "bhavadeepa": null,
