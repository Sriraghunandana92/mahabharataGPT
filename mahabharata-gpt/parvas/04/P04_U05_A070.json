  "verse_count": 28,
  "verses": [
    {
      "verse": 1,
      "sanskrit": "वैशम्पायन उवाच। ततस्तृतीये दिवसे भ्रातरः पञ्च पाण्डवाः । स्नाताः शुक्लाम्बरधराः समये चरितव्रताः ॥१॥",
      "english": null,
      "bhavadeepa": "प्रहृष्टा अभूवन्निति शेषः ॥१९॥",
      "chapter": 70,
      "parva_name": "विराटपर्व",
      "upaparva_name": "वैवाहिकपर्व",
      "adhyaya_name": "सप्ततितमोऽध्यायः"
    },
    {
      "verse": 2,
      "sanskrit": "युधिष्ठिरं पुरस्कृत्य सर्वाभरणभूषिताः । द्वारि मत्ता यथा नागा भ्राजमाना महारथाः ॥२॥",
      "english": null,
      "bhavadeepa": "तत इति ॥१॥",
      "chapter": 70,
      "parva_name": "विराटपर्व",
      "upaparva_name": "वैवाहिकपर्व",
      "adhyaya_name": "सप्ततितमोऽध्यायः"
    },
    {
      "verse": 3,
      "sanskrit": "विराटस्य सभां गत्वा भूमिपालासनेष्वथ । निषेदुः पावकप्रख्याः सर्वे धिष्ण्येष्विवाग्नयः ॥३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 70,
      "parva_name": "विराटपर्व",
      "upaparva_name": "वैवाहिकपर्व",
      "adhyaya_name": "सप्ततितमोऽध्यायः"
    },
    {
      "verse": 4,
      "sanskrit": "तेषु तत्रोपविष्टेषु बिराटः पृथिवीपतिः । आजगाम सभां कर्तुं राजकार्याणि सर्वशः ॥४॥",
      "english": null,
      "bhavadeepa": "धिष्ण्येषु आयतनेषु ॥३॥",
      "chapter": 70,
      "parva_name": "विराटपर्व",
      "upaparva_name": "वैवाहिकपर्व",
      "adhyaya_name": "सप्ततितमोऽध्यायः"
    },
    {
      "verse": 5,
      "sanskrit": "श्रीमतः पाण्डवान् दृष्ट्वा ज्वलतः पावकानिव । मुहूर्तमिव च ध्यात्वा सरोषः पृथिवीपतिः ॥५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 70,
      "parva_name": "विराटपर्व",
      "upaparva_name": "वैवाहिकपर्व",
      "adhyaya_name": "सप्ततितमोऽध्यायः"
    },
    {
      "verse": 6,
      "sanskrit": "अथ मत्स्योऽब्रवीत् कङ्कं देवरूपमिव स्थितम् । मरुद्गणैरुपासीनं त्रिदशानामिवेश्वरम् ॥६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 70,
      "parva_name": "विराटपर्व",
      "upaparva_name": "वैवाहिकपर्व",
      "adhyaya_name": "सप्ततितमोऽध्यायः"
    },
    {
      "verse": 7,
      "sanskrit": "स किलाक्षातिवापस्त्वं सभास्तारो मया वृतः । अथ राजासने कस्मादुपविष्टस्त्वलङ्कृतः ॥७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 70,
      "parva_name": "विराटपर्व",
      "upaparva_name": "वैवाहिकपर्व",
      "adhyaya_name": "सप्ततितमोऽध्यायः"
    },
    {
      "verse": 8,
      "sanskrit": "वैशम्पायन उवाच । परिहासेप्सया वाक्यं विराटस्य निशम्य तत् । स्मयमानोऽर्जुनो राजन्निदं वचनमब्रवीत् ॥८॥",
      "english": null,
      "bhavadeepa": "अक्षातिवापः अक्षान् अतिवपतीति तथा द्यूतकारी ॥७॥",
      "chapter": 70,
      "parva_name": "विराटपर्व",
      "upaparva_name": "वैवाहिकपर्व",
      "adhyaya_name": "सप्ततितमोऽध्यायः"
    },
    {
      "verse": 9,
      "sanskrit": "अर्जुन उवाच । इन्द्रस्यार्धासनं राजन्नयमारोढुमर्हति । ब्रह्मण्यः श्रुतवांस्त्यागी यज्ञशीलो दृढव्रतः ॥९॥",
      "english": null,
      "bhavadeepa": "परिहासेप्सया सनिन्दोपालम्भमपेक्ष्य यद्विराटस्य वाक्यं तन्निशम्य ॥८॥",
      "chapter": 70,
      "parva_name": "विराटपर्व",
      "upaparva_name": "वैवाहिकपर्व",
      "adhyaya_name": "सप्ततितमोऽध्यायः"
    },
    {
      "verse": 10,
      "sanskrit": "एष विग्रहवान् धर्म एष वीर्यवतां वरः । एष बुद्ध्याऽधिको लोके तपसां च परायणम् ॥१०॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 70,
      "parva_name": "विराटपर्व",
      "upaparva_name": "वैवाहिकपर्व",
      "adhyaya_name": "सप्ततितमोऽध्यायः"
    },
    {
      "verse": 11,
      "sanskrit": "एषोऽस्त्रं विविधं वेात्त त्रैलोक्ये सचराचरे । न चैवान्यः पुमान् वेत्ति न वेत्स्यति कदाचन ॥११॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 70,
      "parva_name": "विराटपर्व",
      "upaparva_name": "वैवाहिकपर्व",
      "adhyaya_name": "सप्ततितमोऽध्यायः"
    },
    {
      "verse": 12,
      "sanskrit": "न देवा नासुराः केचिन्न मनुष्या न राक्षसाः । गन्धर्वयक्षप्रवराः सकिंनरमहोरगाः ॥१२॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 70,
      "parva_name": "विराटपर्व",
      "upaparva_name": "वैवाहिकपर्व",
      "adhyaya_name": "सप्ततितमोऽध्यायः"
    },
    {
      "verse": 13,
      "sanskrit": "दीर्घदर्शी महातेजाः पौरजानपद‌प्रियः । पाण्डवानामतिरथो यज्ञधर्मपरो वशी ॥१३॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 70,
      "parva_name": "विराटपर्व",
      "upaparva_name": "वैवाहिकपर्व",
      "adhyaya_name": "सप्ततितमोऽध्यायः"
    },
    {
      "verse": 14,
      "sanskrit": "महर्षिकल्पो राजर्षिः सर्वलोकेषु विश्रुतः । बलवान् धृतिमान् दक्षः सत्यवादी जितेन्द्रियः । धनैश्च सञ्चयैश्चैव शक्रवैश्रवणोपमः ॥१४॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 70,
      "parva_name": "विराटपर्व",
      "upaparva_name": "वैवाहिकपर्व",
      "adhyaya_name": "सप्ततितमोऽध्यायः"
    },
    {
      "verse": 15,
      "sanskrit": "यथा मनुर्महातेजा लोकानां परिरक्षिता । एवमेष महातेजाः प्रजानुग्रहकारकः ॥१५॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 70,
      "parva_name": "विराटपर्व",
      "upaparva_name": "वैवाहिकपर्व",
      "adhyaya_name": "सप्ततितमोऽध्यायः"
    },
    {
      "verse": 16,
      "sanskrit": "अयं कुरूणामृषभो धर्मराजो युधिष्ठिरः । अस्य कीर्तिः स्थिता लोके सूर्यस्येवोद्यतः प्रभा ॥१६॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 70,
      "parva_name": "विराटपर्व",
      "upaparva_name": "वैवाहिकपर्व",
      "adhyaya_name": "सप्ततितमोऽध्यायः"
    },
    {
      "verse": 17,
      "sanskrit": "संसरन्ति दिशः सर्वा यशसोऽस्य इवांशवः । उदितस्येव सूर्यस्य तेजसोऽनु गभस्तयः ॥१७॥",
      "english": null,
      "bhavadeepa": null,
      "chapter": 70,
      "parva_name": "विराटपर्व",
      "upaparva_name": "वैवाहिकपर्व",
      "adhyaya_name": "सप्ततितमोऽध्यायः"
    },
    {
      "verse": 18,
      "sanskrit": "एनं दशसहस्राणि कुञ्जराणां तरस्विनाम् । अन्वयुः पृष्ठतो राजन् यावदध्यावसत् कुरून् ॥१८॥",
      "english": null,
      "bhavadeepa": "अस्य इवेत्यत्र सन्धिरविवक्षितः । उपमेयद्वयस्योपमाद्वयसूचनमेकेनापि इव शब्देन भवति तथाऽप्यत्र स्पष्टार्थं पुनरिवग्रहणम् ॥१७॥",
      "chapter": 70,
      "parva_name": "विराटपर्व",
      "upaparva_name": "वैवाहिकपर्व",
      "adhyaya_name": "सप्ततितमोऽध्यायः"
    },
    {
      "verse": 19,
      "sanskrit": "त्रिंशदेवं सहस्त्राणि रथाः काञ्चनमालिनः । सदश्वैरुपसम्पन्नाः पृष्ठतोऽनुययुस्तदा ॥१९॥",
      "english": null,
      "bhavadeepa": null,
