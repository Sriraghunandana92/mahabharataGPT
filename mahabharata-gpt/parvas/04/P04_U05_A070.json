      "upaparva_name": "वैवाहिकपर्व",
      "adhyaya_name": "सप्ततितमोऽध्यायः"
    },
    {
      "verse": 21,
      "sanskrit": "एनं नित्यमुपासन्त कुरवः किङ्करा यथा । सर्वे च राजन् राजानो धनेश्वरमिवामराः ॥२१॥",
      "english": null,
      "bhavadeepa": "अब्रुवन् अस्तुवन् ॥२०॥",
